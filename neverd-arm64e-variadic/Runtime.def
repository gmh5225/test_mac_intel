{
  "evidence": "variadic-evidence",
  "environment_report": "host.json",
  "result_report": "qualification.json",
  "repository_environment": "GITHUB_REPOSITORY",
  "download": ["gh", "release", "download", "{tag}", "-R", "{repository}", "-p", "{asset}", "-D", "{root}"],
  "test": ["{host}", "--gtest_filter={filter}", "--gtest_output=xml:{xml}"],
  "configure": ["cmake", "-S", "{project}", "-B", "{build}", "-DNEVERD_REPLAY_HOST={host}"],
  "qualify": ["python3", "{driver}", "{mode}", "--build-dir", "{build}", "--probe-report", "{probe}", "--output", "{output}", "--legacy-fixtures", "{legacy}"],
  "errors": {
    "missing_file": "Missing file {0}",
    "file_digest": "Unexpected file digest {0}",
    "execution": "Incomplete native execution {0}",
    "cases": "Missing test cases for {0}",
    "installation": "Incomplete native installation report for {0}",
    "archive_digest": "Unexpected archive digest"
  }
}
