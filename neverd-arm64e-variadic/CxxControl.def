{
  "args_source": "\n#include <cstdint>\n#include <cstdio>\nextern \"C\" void do_throw(int);\nextern \"C\" __attribute__((noinline)) int catch_args(int value) {\n  uintptr_t base, seen;\n  asm volatile(\"mov %0, sp\" : \"=r\"(base));\n  try {\n    asm volatile(\"sub sp, sp, #16\\n.cfi_escape 0x2e, \" RECORD_SIZE ::: \"memory\");\n    do_throw(value);\n    asm volatile(\"add sp, sp, #16\\n.cfi_escape 0x2e, 0\" ::: \"memory\");\n  } catch (int x) {\n    asm volatile(\"mov %0, sp\\nmov sp, %1\" : \"=&r\"(seen) : \"r\"(base) : \"memory\");\n    std::printf(\"%d %lld\\n\",x,(long long)(seen-base));\n    return x;\n  }\n  return value;\n}\n",
  "args_driver": "\nextern \"C\" int catch_args(int);\nextern \"C\" __attribute__((noinline)) void do_throw(int value) { if (value) throw value; }\nint main() { return catch_args(0) || catch_args(5)!=5; }\n",
  "single": "\n#include <signal.h>\n#include <sys/ucontext.h>\n#include <mach/arm/thread_status.h>\n#include <dlfcn.h>\n#include <cstdint>\n#include <cstdio>\n#include <cstdlib>\n#include <cstring>\nstatic void dump(const char *label,uintptr_t address) {\n  Dl_info info{};\n  dladdr((void*)address,&info);\n  std::fprintf(stderr,\"%s=%p %s + %zx %s\\n\",label,(void*)address,info.dli_fname?info.dli_fname:\"?\",address-(uintptr_t)info.dli_fbase, info.dli_sname?info.dli_sname:\"?\");\n  if(label[0]=='P') {\n    auto code=(const uint32_t*)address;\n    for(int i=-5;i<=2;++i) std::fprintf(stderr,\"%d:%08x \",i,code[i]);\n    std::fprintf(stderr,\"\\n\");\n  }\n}\nstatic void trap(int signo,siginfo_t*,void *raw) {\n  auto &s=((ucontext_t*)raw)->uc_mcontext->__ss;\n  dump(\"PC\",arm_thread_state64_get_pc(s));dump(\"LR\",arm_thread_state64_get_lr(s));std::fflush(stderr);_Exit(128+signo);\n}\n__attribute__((constructor)) static void install_trap() {\n  struct sigaction action{};\n  action.sa_sigaction=trap;action.sa_flags=SA_SIGINFO;\n  sigaction(SIGTRAP,&action,nullptr);\n}\n\n#include <cstdlib>\n#include <cstdio>\n#include <dlfcn.h>\n#include <exception>\nint main(int argc,char**argv) {\n  if(argc!=3) return 1;\n  auto *img=dlopen(argv[1],RTLD_NOW|RTLD_LOCAL);\n  if(!img){std::fprintf(stderr,\"dlopen %s\\n\",dlerror());return 2;}\n  auto f=reinterpret_cast<int(*)(int)>(dlsym(img,\"catcher\"));\n  if(!f)return 3;\n  int x=std::atoi(argv[2]);std::fprintf(stderr,\"calling %d\\n\",x);std::fflush(stderr);\n  try {int n=f(x);std::fprintf(stderr,\"returned %d\\n\",n);if(x>1||n!=(x?8:0))return 4;}\n  catch(long v){std::fprintf(stderr,\"caught long %ld\\n\",v);if(x<2||v!=(x==2?13:17))return 5;}\n  catch(...){std::fprintf(stderr,\"unexpected exception\\n\");return 6;}\n  if(std::current_exception())return 7;\n  return dlclose(img);\n}\n"
}
