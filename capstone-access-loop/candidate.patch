-	if (handle->mode == CS_MODE_64 && code[5] >= 0xc0 &&
-	    !X86_EVEX_REGISTER_PREFIX_REJECTS(code, code_len)
+	const unsigned pp = code[2] & 3;
+	if (handle->mode == CS_MODE_64 &&
+	    !X86_EVEX_PREFIX_REJECTS(code, code_len, pp)
