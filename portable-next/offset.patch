diff --git a/arch/X86/X86RegisterFallback32.c b/arch/X86/X86RegisterFallback32.c
index ee9b645b..3b100502 100644
--- a/arch/X86/X86RegisterFallback32.c
+++ b/arch/X86/X86RegisterFallback32.c
@@ -13,9 +13,48 @@
 	!defined(_WIN32_WCE)
 #include "X86OutputOptions.h"
 #include "X86RegisterImmediateOutput.h"
+struct X86OffsetSpelling {
+	uint8_t length;
+	char before[17], after[8];
+};
 #include "X86GenTest32Registers.inc"
 #include "../../cs_disasm_internal.h"
 
+/* A0 through A3 encode an unsigned absolute address without a ModR/M byte.
+ * The table holds the text on either side of that address. */
+static void writeOffsetMove32(const uint8_t *code, cs_insn *insn,
+			      uint16_t *insn_size)
+{
+	const uint8_t opcode = code[0];
+	const bool store = (opcode & 2) != 0;
+	const unsigned wide = opcode & 1;
+	const uint32_t address = (uint32_t)X86_readDisp32(code + 1);
+	const struct X86SimpleOutput *row = &offset32_mov_rows[wide];
+	const struct X86OffsetSpelling *text = &offset32_spelling[opcode & 3];
+	*insn_size = insn->size = 5;
+	insn->id = row->id;
+	memcpy(insn->bytes, code, 5);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, text->before, sizeof(text->before));
+	char *end = writeUnsignedImmediate(insn->op_str + text->length, address);
+	memcpy(end, text->after, sizeof(text->after));
+	if (insn->detail) {
+		const uint16_t acc = test32_regs[wide][0].reg;
+		X86_writeSimpleDetail(insn->detail, row, opcode, 0, 0,
+				      store ? 0 : acc, store ? acc : 0);
+		cs_x86 *x = &insn->detail->x86;
+		x->encoding.modrm_offset = 0;
+		x->encoding.disp_offset = 1;
+		x->encoding.disp_size = 4;
+		cs_x86_op *mem = &x->operands[store ? 0 : 1];
+		mem->type = X86_OP_MEM;
+		mem->mem.scale = 1;
+		mem->mem.disp = x->disp = address;
+	}
+}
+
 CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
 X86_decodeRegisterFallback32(cs_struct *handle, const uint8_t *code,
 			     size_t size, cs_insn *insn, uint16_t *insn_size,
@@ -34,6 +73,11 @@ X86_decodeRegisterFallback32(cs_struct *handle, const uint8_t *code,
 			return true;
 		}
 	}
+	if ((opcode & 0xfc) == 0xa0 && size >= 5 &&
+	    !X86_OUTPUT_UNSUPPORTED(handle, false)) {
+		writeOffsetMove32(code, insn, insn_size);
+		return true;
+	}
 	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
 }
 #endif
