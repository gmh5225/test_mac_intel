+void emit_offset32(Decoder &decoder, const PlanTable &plans,
+		   const std::vector<std::string> &rows)
+{
+	std::cout << "\nstatic const struct X86SimpleOutput offset32_mov_rows[2] = {\n";
+	for (unsigned opcode : { 0x88u, 0x89u })
+		std::cout << '\t' << rows.at(plans[0][0][opcode] >> 2) << ",\n";
+	std::cout << "};\n\nstatic const struct X86OffsetSpelling offset32_spelling[4] = {\n";
+	for (unsigned opcode = 0xa0; opcode <= 0xa3; ++opcode) {
+		uint8_t code[] = { static_cast<uint8_t>(opcode), 0, 0, 0, 0 };
+		decoder.decode(code, sizeof(code), sizeof(code), 0);
+		const std::string text(decoder.insn->op_str);
+		const auto address = text.find("[0]");
+		if (decoder.insn->id != X86_INS_MOV || address == std::string::npos)
+			throw std::runtime_error("unexpected i386 offset MOV");
+		const auto before = text.substr(0, address + 1);
+		const auto after = text.substr(address + 2);
+		if (before.size() > 16 || after.size() > 7)
+			throw std::runtime_error("offset MOV spelling does not fit");
+		std::cout << "\t{ " << before.size() << ", \"" << before
+			  << "\", \"" << after << "\" },\n";
+	}
+	std::cout << "};\n";
+}
