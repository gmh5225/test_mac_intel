+/* The MASM printer selects the sign and leading zero when it selects fmt.
+ * Keep the same format and argument for custom formatters and short streams. */
+void X86_printMasmHexToken(SStream *O, const char *fmt, uint64_t value)
+{
+#if !defined(CAPSTONE_DIET) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+	if (cs_vsnprintf == cs_default_vsnprintf && !O->is_closed &&
+	    !O->markup_stream && !O->prefixed_by_markup &&
+	    O->index <= SSTREAM_BUF_LEN - 20) {
+		char *out = O->buffer + O->index;
+		const char *prefix = fmt;
+		if (*prefix == '-') {
+			*out++ = '-';
+			++prefix;
+		}
+		if (*prefix == '0')
+			*out++ = '0';
+		const unsigned digits = 16U - CountLeadingZeros_64(value | 1) / 4U;
+		char *end = out + digits;
+		end[0] = 'h';
+		end[1] = '\0';
+		O->index = (size_t)(end + 1 - O->buffer);
+		do {
+			*--end = "0123456789abcdef"[value & 15];
+			value >>= 4;
+		} while (value);
+		return;
+	}
+#endif
+	SStream_concat(O, fmt, value);
+}
+
+/* An absolute A0-A3 address is already zero-extended by the decoder.
+ * Its high bit is independent of the size of the accumulator being moved. */
+void X86_printHighMemoryOffset(SStream *O, uint64_t address, bool masm)
+{
+	if (!masm)
+		SStream_concat_hex64(O, address, false);
+	else if (address == (UINT64_C(1) << 63))
+		SStream_concat0(O, "8000000000000000h");
+	else if ((address >> 60) >= 10)
+		X86_printMasmHexToken(O, "0%" PRIx64 "h", address);
+	else
+		X86_printMasmHexToken(O, "%" PRIx64 "h", address);
+}
