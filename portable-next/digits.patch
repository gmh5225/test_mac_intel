+/* MASM prints a negative signed immediate with the leading-zero convention
+ * of its original two's-complement value. Preserve that spelling for hooks. */
+static void printMasmHex(SStream *O, uint64_t value, bool negative)
+{
+	if (value == UINT64_C(0x8000000000000000)) {
+		SStream_concat0(O, "8000000000000000h");
+		return;
+	}
+#if !defined(CAPSTONE_DIET) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+	if (cs_vsnprintf == cs_default_vsnprintf && !O->is_closed &&
+	    !O->markup_stream && !O->prefixed_by_markup &&
+	    O->index <= SSTREAM_BUF_LEN - 20) {
+		const unsigned digits = 16U - CountLeadingZeros_64(value | 1) / 4U;
+		const bool prefix = negative ? ((0 - value) >> 60) >= 10 :
+					(value >> (4U * (digits - 1))) >= 10;
+		char *p = O->buffer + O->index;
+		if (negative)
+			*p++ = '-';
+		if (prefix)
+			*p++ = '0';
+		char *end = p + digits;
+		end[0] = 'h';
+		end[1] = '\0';
+		O->index = (size_t)(end + 1 - O->buffer);
+		do {
+			*--end = "0123456789abcdef"[value & 15];
+			value >>= 4;
+		} while (value);
+		return;
+	}
+#endif
+	const bool prefix = need_zero_prefix(negative ? 0 - value : value);
+	const char *fmt = negative ?
+		(prefix ? "-0%" PRIx64 "h" : "-%" PRIx64 "h") :
+		(prefix ? "0%" PRIx64 "h" : "%" PRIx64 "h");
+	SStream_concat(O, fmt, value);
+}
