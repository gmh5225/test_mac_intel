diff --git a/arch/X86/X86OutputIterator.c b/arch/X86/X86OutputIterator.c
index cec4bec6..9c1bba35 100644
--- a/arch/X86/X86OutputIterator.c
+++ b/arch/X86/X86OutputIterator.c
@@ -32,4 +32,19 @@ CAPSTONE_INTERNAL bool X86_disasmIter(csh ud, const uint8_t **code,
 #endif
 	return cs_disasm_iter(ud, code, size, address, insn);
 }
+
+#ifdef CAPSTONE_X86_BATCH_OUTPUT
+CS_PRESERVE_MOST bool
+X86_decodeBatchRecord(cs_struct *handle, const uint8_t *code, size_t size,
+		      cs_insn *insn, uint16_t *length, bool batch)
+{
+	/* The caller selected scan mode before allocating the detail slot.
+	 * An allocator which then disables detail leaves that slot owned by
+	 * the full decoder. */
+	if (batch && (!insn->detail || handle->detail_opt) &&
+	    X86_trySimpleOutput(handle, code, size, insn, length))
+		return true;
+	return cs_decode_full_insn(handle, code, size, insn, length, batch);
+}
+#endif
 #endif
