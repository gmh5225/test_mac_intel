+/* A single operand-size prefix selects 32-bit registers in real mode.
+ * Register-only operations keep their generated i386 effects. The address
+ * size and encoded offsets belong to the original prefixed instruction. */
+static bool writeOperandOverride16(cs_struct *handle, const uint8_t *code,
+				   size_t size, cs_insn *insn, uint16_t *length)
+{
+	if (size < 3 || code[0] != X86_PREFIX_OPSIZE)
+		return false;
+	const unsigned opcode = code[1];
+	const bool mov = (opcode & 0xf8) == 0xb8;
+	const bool pair = (opcode < 0x40 && (opcode & 7) <= 3) ||
+			  (opcode >= 0x84 && opcode <= 0x8b);
+	if (mov ? size < 6 : (!pair || code[2] < 0xc0))
+		return false;
+	if (X86_OUTPUT_UNSUPPORTED(handle, handle->mode != CS_MODE_16))
+		return false;
+	const unsigned plan = x86_simple_plans[0][0][mov ? 0x8b : opcode];
+	const struct X86SimpleOutput *row = &x86_simple_outputs[plan >> 2];
+	if (mov) {
+		writeUnsignedRegisterImmediate(insn, row,
+					       &x86_simple_registers[2][opcode & 7],
+					       code, 0, 0, 2, 4, length);
+	} else {
+		const unsigned mr = code[2], reg = (mr >> 3) & 7, rm = mr & 7;
+		const bool reg_first = (plan & 3) == X86_SIMPLE_REG_RM;
+		const struct X86SimpleRegister *regs =
+			x86_simple_registers[(opcode & 1) ? 2 : 0];
+		writeExtendRegisters(code, 3, insn, length, row,
+				     &regs[reg_first ? reg : rm],
+				     &regs[reg_first ? rm : reg], 0, opcode,
+				     mr, false);
+	}
+	if (insn->detail) {
+		cs_x86 *x = &insn->detail->x86;
+		x->addr_size = 2;
+		x->prefix[2] = X86_PREFIX_OPSIZE;
+		if (mov)
+			x->opcode[0] = opcode;
+		else
+			x->encoding.modrm_offset = 2;
+	}
+	return true;
+}
+
+/* Relative jumps use the existing mnemonic and flag records. The operand
+ * width of a real-mode target and the encoded displacement are distinct. */
+static bool writeLegacyOutput16(cs_struct *handle, const uint8_t *code,
+				size_t size, cs_insn *insn, uint16_t *length)
+{
+	if (code[0] == X86_PREFIX_OPSIZE)
+		return writeOperandOverride16(handle, code, size, insn, length);
+	if (size < 2)
+		return false;
+	const bool escaped = code[0] == 0x0f;
+	const unsigned opcode = code[escaped];
+	const bool short_jump = !escaped &&
+				((opcode & 0xf0) == 0x70 || opcode == 0xeb);
+	if (!short_jump && (escaped ? (opcode & 0xf0) != 0x80 : opcode != 0xe9))
+		return false;
+	const unsigned offset = 1 + escaped;
+	const unsigned disp_size = short_jump ? 1 : 2;
+	const unsigned len = offset + disp_size;
+	if (size < len || X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	const int32_t disp = short_jump ? (int8_t)code[offset] :
+			     (int16_t)((unsigned)code[offset] |
+				       ((unsigned)code[offset + 1] << 8));
+	const uint64_t target = X86_relativeBranchTarget(handle->mode,
+				insn->address, len, (uint64_t)disp, disp_size);
+	const unsigned plan = x86_simple_plans[0][escaped ? 3 : 0][opcode];
+	const struct X86SimpleOutput *row = &x86_simple_outputs[plan >> 2];
+	*length = insn->size = len;
+	insn->id = row->id;
+	memcpy(insn->bytes, code, len);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	writeUnsignedImmediate(insn->op_str, target);
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, code[0], 0, 0, 0, 0);
+		/* A jump reads its instruction pointer after any flags and
+		 * writes it first. The i386 records name the 32-bit view. */
+		assert(row->read_count && row->reads[row->read_count - 1] == X86_REG_EIP);
+		assert(row->write_count && row->writes[0] == X86_REG_EIP);
+		insn->detail->regs_read[row->read_count - 1] = X86_REG_IP;
+		insn->detail->regs_write[0] = X86_REG_IP;
+		cs_x86 *x = &insn->detail->x86;
+		x->addr_size = 2;
+		if (escaped)
+			x->opcode[1] = opcode;
+		x->encoding.imm_size = disp_size;
+		x->operands[0].type = X86_OP_IMM;
+		x->operands[0].size = 2;
+		x->operands[0].imm = (int64_t)target;
+	}
+	return true;
+}
