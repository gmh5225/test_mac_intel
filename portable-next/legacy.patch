+static bool check_register_overrides16(csh handles[2])
+{
+	for (unsigned opcode = 0; opcode < 256; ++opcode) {
+		bool pair = (opcode < 0x40 && (opcode & 7) <= 3) ||
+			    (opcode >= 0x84 && opcode <= 0x8b);
+		if (!pair && (opcode & 0xf8) != 0xb8)
+			continue;
+		for (unsigned reg = 0; reg < 8; ++reg) {
+			uint8_t bytes[] = { 0x66, (uint8_t)opcode,
+				(uint8_t)(0xc0 | (reg << 3) | (7 - reg)),
+				0x80, 0xff, 0xa5 };
+			for (size_t len = 1; len <= sizeof(bytes); ++len)
+				if (!compare(handles, bytes, len, reg))
+					return false;
+		}
+	}
+	return true;
+}
