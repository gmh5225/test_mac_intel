 	return X86_decodeRegisterFallback32(handle, code, size, insn, insn_size, batch);
 }
+CAPSTONE_INTERNAL bool X86_disasmIterLegacy(csh ud, const uint8_t **code, size_t *size,
+			 uint64_t *address, cs_insn *insn)
+{
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (handle && handle->arch == CS_ARCH_X86 && handle->mode == CS_MODE_16 &&
+	    !handle->no_text)
+		return cs_disasm_iter_core(ud, code, size, address, insn);
+	return X86_disasmIter(ud, code, size, address, insn);
+}
