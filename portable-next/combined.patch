+	const unsigned index = plain_evex_prefixes[prefix][key];
+	if (!index ||
+	    plain_evex_rows[index - 1].order != EVEX_REGISTERS_THREE ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
