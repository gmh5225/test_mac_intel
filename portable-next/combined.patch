+/* Only timestamp instructions and the implicit YMM bank have a
+ * different register-write record outside 64-bit mode. The mapping
+ * generator checks the register order and count for each tagged row. */
+static inline void set_mapping_writes(cs_detail *detail,
+				      const insn_map_x86 *mapping,
+				      unsigned counts, cs_mode mode)
+{
+	const uint8_t count = (counts >> 5) & 31;
+	if (!(counts & X86_MAPPING_LEGACY_WRITES) || mode == CS_MODE_64) {
+		memcpy(detail->regs_write, mapping->regs_mod,
+		       sizeof(mapping->regs_mod));
+		detail->regs_write_count = count;
+		return;
+	}
+	if (mapping->regs_mod[0] == X86_REG_YMM0) {
+		const size_t bytes = 8 * sizeof(detail->regs_write[0]);
+		memcpy(detail->regs_write, mapping->regs_mod, bytes);
+		memset(detail->regs_write + 8, 0,
+		       sizeof(mapping->regs_mod) - bytes);
+		detail->regs_write_count = 8;
+	} else {
+		detail->regs_write[0] = X86_REG_EAX;
+		if (count == 3)
+			detail->regs_write[1] = X86_REG_ECX;
+		detail->regs_write[count - 1] = X86_REG_EDX;
+		detail->regs_write_count = count;
+	}
+}
 #endif
 
