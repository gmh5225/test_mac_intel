+				const auto row = vex_register_row(
+					decoder, map, opcode, w, ll, 0, 3, 2, 1,
+					false, false, 0);
+				if (row.empty())
+					continue;
+				const auto same = [&](unsigned dst,
+						      unsigned src, unsigned xb,
+						      int32_t disp,
+						      const char *suffix) {
+					if (vex_rip_row(decoder, map, opcode, w,
+							ll, dst, src, xb, false,
+							disp, suffix) != row)
+						return false;
+					return map != 1 || w || xb ||
+					       vex_rip_row(decoder, map, opcode,
+							   0, ll, dst, src, 0,
+							   true, disp,
+							   suffix) == row;
+				};
+				if (!same(3, 2, 0, 0, "") ||
+				    !same(15, 8, 0, -9, " - 9") ||
+				    !same(8, 15, 0, 10, " + 0xa") ||
+				    !same(0, 1, 0, INT32_MIN,
+					  " - 0x80000000") ||
+				    !same(9, 0, 0, INT32_MAX, " + 0x7fffffff"))
+					continue;
+				bool uniform = true;
+				for (unsigned dst = 0; dst < 16 && uniform;
+				     ++dst)
+					for (unsigned src = 0;
+					     src < 16 && uniform; ++src)
+						for (unsigned xb = 0;
+						     xb < 4 && uniform; ++xb)
+							uniform = same(
+								dst, src, xb,
+								0x1234,
+								" + 0x1234");
+				if (uniform) {
+					forms[map - 1][opcode] |= 1u << wl;
+					++admitted;
+				}
+			}
+		}
+	}
+	if (!forms[0][0xfe] || !forms[1][0xa8])
+		throw std::runtime_error(
+			"missing VEX RIP-relative integer or packed FMA forms");
+	std::puts(
+		"/* Generated by suite/synctools/x86_vector_output.cpp --vex-rip-memory. */");
+	std::puts("static const uint8_t vex_rip_forms[3][256] = {");
+	for (const auto &map : forms) {
+		std::puts("\t{");
+		for (unsigned i = 0; i < map.size(); i += 16) {
+			std::printf("\t\t");
+			for (unsigned j = 0; j < 16; ++j)
+				std::printf("%u,%s", map[i + j],
+					    j == 15 ? "" : " ");
+			std::puts("");
+		}
+		std::puts("\t},");
+	}
+	std::puts("};");
+	std::fprintf(
+		stderr,
+		"%u RIP-relative VEX forms from %llu canonical observations\n",
+		admitted, static_cast<unsigned long long>(decoder.probes));
+}
