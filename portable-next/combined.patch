+void emit_vex_rip_memory(Decoder &decoder)
+{
+	std::array<std::array<unsigned, 256>, 3> forms{};
+	unsigned admitted = 0;
+	for (unsigned map = 1; map <= forms.size(); ++map) {
+		for (unsigned opcode = 0; opcode < 256; ++opcode) {
+			for (unsigned wl = 0; wl < 4; ++wl) {
