diff --git a/arch/X86/X86OutputIterator.c b/arch/X86/X86OutputIterator.c
index 8c6444ab..35a07c2c 100644
--- a/arch/X86/X86OutputIterator.c
+++ b/arch/X86/X86OutputIterator.c
@@ -30,6 +30,30 @@ CAPSTONE_INTERNAL bool X86_tryBatchOutput(cs_struct *handle, const uint8_t *code
 #endif
 #include "../../cs_disasm_internal.h"
 
+#ifdef CAPSTONE_X86_MIXED_PUBLIC_OUTPUT
+/* The public iterator has already tried the text-free scan and validated size.
+ * Its cursor and skipdata handling also own failed record attempts. */
+CS_PRESERVE_MOST bool X86_decodeMixedPublicRecord(
+	cs_struct *handle, const uint8_t *code, size_t size, cs_insn *insn,
+	uint16_t *length, bool batch)
+{
+	if (handle->arch == CS_ARCH_X86 && !batch && !handle->no_text) {
+#ifdef CAPSTONE_MIXED_X86_MODE_READERS
+		if (handle->mode == CS_MODE_32)
+			return X86_decodeFixedRecord32(handle, code, size, insn,
+						       length);
+		if (handle->mode == CS_MODE_64)
+			return X86_decodeFixedRecord64(handle, code, size, insn,
+						       length);
+#else
+		if (X86_trySimpleOutput(handle, code, size, insn, length))
+			return true;
+#endif
+	}
+	return cs_decode_full_insn(handle, code, size, insn, length, batch);
+}
+#endif
+
 CAPSTONE_INTERNAL bool X86_disasmIter(csh ud, const uint8_t **code,
 				      size_t *size, uint64_t *address,
 				      cs_insn *insn)
