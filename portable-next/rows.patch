+/* Absolute offsets and ModR/M disp32 addresses share the Intel spelling.
+ * The former has an unsigned public displacement and no ModR/M byte. */
+static bool writeAbsolute32(cs_struct *handle, const uint8_t *code,
+			    size_t size, cs_insn *insn, uint16_t *insn_size)
+{
+	const bool segmented = (code[0] & 0xfe) == 0x64;
+	const unsigned prefix = segmented ? 1 : 0;
+	if (size < prefix + 5)
+		return false;
+
+	const uint8_t opcode = code[prefix];
+	const bool moffs = (opcode & 0xfc) == 0xa0;
+	unsigned address_offset = prefix + 1;
+	uint8_t modrm = 0;
+	if (!moffs) {
+		/* Only FS/GS absolute ALU, TEST and MOV reach this writer. */
+		if (!segmented || size < address_offset + 5 ||
+		    ((opcode & 0xc4) != 0 && (opcode & 0xfe) != 0x84 &&
+		     (opcode & 0xfc) != 0x88))
+			return false;
+		modrm = code[address_offset++];
+		if ((modrm & 0xc7) != 5)
+			return false;
+	}
+	if (X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+
+	const bool load = moffs ? !(opcode & 2) : (opcode & 2) != 0;
+	const bool dword = (opcode & 1) != 0;
+	const unsigned pair = moffs ? ((load ? 0x8a : 0x88) | dword) : opcode;
+	const struct X86SimpleOutput *row =
+		&x86_simple_outputs[x86_simple_plans[0][0][pair] >> 2];
+	const struct X86SimpleRegister *reg =
+		&x86_simple_registers[dword ? 2 : 0][(modrm >> 3) & 7];
