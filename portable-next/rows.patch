+/* A register plan can serve a memory operand only when every opcode sharing
+ * the plan has the same verified public record at that width. */
+void emit_vex_memory_admission(Decoder &decoder)
+{
+	const auto regs = collect_vex_registers(decoder);
+	const auto mem = collect_vex_base_memory(decoder);
+	std::vector<unsigned> masks(regs.widths.size(), 15);
+	for (size_t m = 0; m < regs.plans.size(); ++m) {
+		for (size_t op = 0; op < regs.plans[m].size(); ++op) {
+			const auto plan = regs.plans[m][op];
+			for (unsigned wl = 0; wl < 4; ++wl) {
+				const auto r = regs.widths[plan][wl];
+				const auto s = mem.widths[mem.plans[m][op]][wl];
+				if (!r || !s || regs.rows[r - 1] != mem.rows[s - 1])
+					masks[plan] &= ~(1u << wl);
+			}
+		}
+	}
+	std::puts("/* Generated by suite/synctools/x86_vector_output.cpp --vex-memory-admission. */");
+	std::puts("static const uint8_t vex_memory_widths[] = {");
+	for (size_t i = 0; i < masks.size(); ++i) {
+		if (!(i % 16))
+			std::putchar('\t');
+		std::printf("%u,", masks[i]);
+		std::putchar(i % 16 == 15 || i + 1 == masks.size() ? '\n' : ' ');
+	}
+	std::puts("};");
 }
 
