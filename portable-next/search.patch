 #define X86_LEGACY_PACKED_MEMORY
@@ -212,6 +212,13 @@ X86_decodeOutputMiss64(cs_struct *handle, const uint8_t *code, size_t size,
 	if (size >= 10 && code[0] == 0x62 && (code[5] & 0xc7) == 5 &&
