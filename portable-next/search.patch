+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+/* Link against the matching full or reduced static x86 Capstone library.
+ * The canonical access query includes overrides for UD1, BOUND and CMPXCHG.
+ * Index zero denotes a missing instruction, which must leave flags untouched. */
+#include "../../arch/X86/X86Mapping.h"
+#include "../../arch/X86/X86InstPrinterCommon.h"
+#include "../../utils.h"
+#include <inttypes.h>
+#include <stdio.h>
+
+#define GET_INSTRINFO_ENUM
+#ifdef CAPSTONE_X86_REDUCE
+#include "../../arch/X86/X86GenInstrInfo_reduce.inc"
+#else
+#include "../../arch/X86/X86GenInstrInfo.inc"
+#endif
+
+struct ATTAccessRow {
+	uint64_t flags;
+	uint16_t permissions;
+};
+
+#ifdef X86_VERIFY_ATT_ACCESS
+#ifdef CAPSTONE_X86_REDUCE
+#include "../../arch/X86/X86GenATTAccess_reduce.inc"
+#else
+#include "../../arch/X86/X86GenATTAccess.inc"
+#endif
+#endif
+
+static struct ATTAccessRow rows[X86_INSTRUCTION_LIST_END + 1];
+static unsigned opcode_rows[X86_INSTRUCTION_LIST_END];
+
+static bool append_permissions(const uint8_t *access, uint16_t *permissions)
+{
+	unsigned ordered = 0;
+	for (unsigned i = 0; i < CS_X86_MAXIMUM_OPERAND_SIZE; ++i) {
+		if (!access[i]) {
+			*permissions = (uint16_t)ordered;
+			return true;
+		}
+		if (access[i] != CS_AC_IGNORE &&
+		    (access[i] & ~CS_AC_READ_WRITE))
+			return false;
+		ordered = (ordered << 2) | (access[i] & CS_AC_READ_WRITE);
+	}
+	return false;
+}
+
+int main(void)
+{
+	unsigned count = 1;
+	for (unsigned opcode = 0; opcode < X86_INSTRUCTION_LIST_END; ++opcode) {
+		uint64_t flags = 0;
+		const uint8_t *access = X86_get_op_access(NULL, opcode, &flags);
+		if (!access)
+			continue;
+		uint16_t permissions;
+		if (!append_permissions(access, &permissions)) {
+			fprintf(stderr, "Unsupported operand access at opcode %u\n", opcode);
+			return 1;
+		}
+		unsigned i = 1;
+		while (i < count && (flags != rows[i].flags ||
+				     permissions != rows[i].permissions))
+			++i;
+		if (i == count) {
+			rows[i].flags = flags;
+			rows[i].permissions = permissions;
+			++count;
+		}
+		opcode_rows[opcode] = i;
+	}
+
+#ifdef X86_VERIFY_ATT_ACCESS
+	if (count != ARR_SIZE(att_access_rows))
+		return 1;
+	for (unsigned i = 0; i < X86_INSTRUCTION_LIST_END; ++i) {
+		if (opcode_rows[i] != att_access_index[i]) {
+			fprintf(stderr, "AT&T opcode index differs at %u\n", i);
+			return 1;
+		}
+	}
+	for (unsigned i = 0; i < count; ++i) {
+		if (rows[i].flags != att_access_rows[i].flags ||
+		    rows[i].permissions != att_access_rows[i].permissions) {
+			fprintf(stderr, "AT&T access descriptor differs at %u\n", i);
+			return 1;
+		}
+	}
+	return 0;
+#else
+	puts("/* Generated by suite/synctools/x86_att_access.c. */");
+	puts("static const struct ATTAccessRow att_access_rows[] = {");
+	for (unsigned i = 0; i < count; ++i)
+		printf("\t{ UINT64_C(0x%" PRIx64 "), 0x%x },\n",
+		       rows[i].flags, (unsigned)rows[i].permissions);
+	puts("};");
+	printf("static const %s att_access_index[X86_INSTRUCTION_LIST_END] = {\n",
+	       count <= UINT8_MAX + 1u ? "uint8_t" :
+	       count <= UINT16_MAX + 1u ? "uint16_t" : "uint32_t");
+	for (unsigned i = 0; i < X86_INSTRUCTION_LIST_END; ++i) {
+		if (i % 16 == 0)
+			putchar('\t');
+		printf("%u,", opcode_rows[i]);
+		putchar(i % 16 == 15 || i + 1 == X86_INSTRUCTION_LIST_END ?
+			'\n' : ' ');
+	}
+	puts("};");
+	fprintf(stderr, "%u x86 opcodes, %u mapped AT&T descriptors\n",
+		(unsigned)X86_INSTRUCTION_LIST_END, count - 1);
+	return ferror(stdout) ? 1 : 0;
+#endif
+}
