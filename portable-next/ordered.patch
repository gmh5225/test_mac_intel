+						opcode == 0x6f ? reg : rm,
+						opcode == 0x6f ? rm : reg
+					};
+					const auto value =
+						checked_vex_registers(
+							decoder, bytes, 2, true,
+							0, ll, operands, 2,
+							false);
+					if (value.empty() ||
+					    (!row.empty() && row != value))
+						throw std::runtime_error(
+							"inconsistent i386 VEX2 register move");
+					row = value;
+				}
+			}
+		}
+		std::printf("\t%s,\n", row.c_str());
+	}
+	std::puts("};");
+}
