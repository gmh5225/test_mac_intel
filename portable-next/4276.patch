+// Both directions of a two-operand transfer use the same mnemonic, register
+// bank and memory width. Keep access in public operand order for each direction.
+void emit_vex_sib_transfers(Decoder &decoder)
+{
+	constexpr uint8_t flags[] = { 0x78, 0x79, 0xf8, 0xf9, 0x7a, 0x7b };
+	std::puts("/* Generated by x86_vector_output.cpp --vex-sib-transfers. */");
+	std::puts("static const struct VexSibTransfer vex_sib_transfers[] = {");
+	for (unsigned form = 0; form < sizeof(flags); ++form) {
+		const bool mask = form < 4;
+		unsigned public_id = 0, reg_size = 0, mem_size = 0, group_count = 0;
+		Bytes4 groups{};
+		std::array<std::array<unsigned, 2>, 2> accesses{};
+		std::string mnemonic, memory;
+		for (unsigned store = 0; store < 2; ++store) {
+			for (unsigned ext = 0; ext < (mask ? 4u : 8u); ++ext) {
+				for (unsigned field = 0; field < 8; ++field) {
+					const uint8_t bytes[] = {
+						0xc4, uint8_t(0xe1 ^ (ext << 5)), flags[form],
+						uint8_t((mask ? 0x90 : 0x10) | store),
+						uint8_t(4 | (field << 3)), 0x58,
+					};
+					unsigned id = decoder.decode(bytes, sizeof(bytes));
+					const auto &insn = *decoder.insn;
+					const cs_detail &detail = *insn.detail;
+					const cs_x86 &x = detail.x86;
+					const cs_x86_op &reg = x.operands[store], &mem = x.operands[!store];
+					const unsigned number = field | ((ext & 4) << 1);
+					if (!id || x.op_count != 2 || reg.type != X86_OP_REG ||
+					    reg.reg != unsigned(mask ? X86_REG_K0 : X86_REG_XMM0) + number ||
+					    mem.type != X86_OP_MEM || detail.groups_count > 4 ||
+					    detail.regs_read_count || detail.regs_write_count || x.eflags ||
+					    insn.illegal || insn.is_alias || insn.usesAliasDetails)
+						throw std::runtime_error("unexpected VEX SIB transfer record");
+					const std::string text(insn.op_str);
+					const auto begin = store ? 0 : text.find(", ") + 2;
+					const auto bracket = text.find('[', begin);
+					if (bracket == std::string::npos || bracket < begin || bracket - begin >= 11 ||
+					    std::strlen(insn.mnemonic) >= 8)
+						throw std::runtime_error("invalid VEX transfer operand prefix");
+					const auto prefix = text.substr(begin, bracket - begin + 1);
+					Bytes4 current{};
+					std::copy_n(detail.groups, detail.groups_count, current.begin());
+					if (!public_id) {
+						public_id = id;
+						reg_size = reg.size;
+						mem_size = mem.size;
+						mnemonic = insn.mnemonic;
+						memory = prefix;
+						group_count = detail.groups_count;
+						groups = current;
+					}
+					if (public_id != id || reg_size != reg.size || mem_size != mem.size ||
+					    mnemonic != insn.mnemonic || memory != prefix || groups != current ||
+					    group_count != detail.groups_count)
+						throw std::runtime_error("VEX transfer shape depends on register or direction");
+					std::array<unsigned, 2> access{ unsigned(x.operands[0].access), unsigned(x.operands[1].access) };
+					if (!ext && !field)
+						accesses[store] = access;
+					else if (accesses[store] != access)
+						throw std::runtime_error("VEX transfer access depends on register");
+				}
+			}
+		}
+		std::printf("\t{ %s, \"%s\", \"%s\", %u, %u, %u, %u, %s, { { %u, %u }, { %u, %u } } },\n",
+			    decoder.symbol(public_id).c_str(), mnemonic.c_str(), memory.c_str(),
+			    unsigned(memory.size()), reg_size, mem_size, group_count, fields(groups).c_str(),
+			    accesses[0][0], accesses[0][1], accesses[1][0], accesses[1][1]);
+	}
+	std::puts("};");
+}
