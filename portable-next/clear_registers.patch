diff --git a/arch/X86/X86VectorClearOutput.h b/arch/X86/X86VectorClearOutput.h
new file mode 100644
index 00000000..5b78b1d7
--- /dev/null
+++ b/arch/X86/X86VectorClearOutput.h
@@ -0,0 +1,43 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_VECTOR_CLEAR_OUTPUT_H
+#define CS_X86_VECTOR_CLEAR_OUTPUT_H
+
+#include <string.h>
+#include "X86Mapping.h"
+#define GET_INSTRINFO_ENUM
+#include "X86GenInstrInfo.inc"
+
+/* The caller has validated the Intel writer and the bare C5 prefix.
+ * X86_get_insn_id owns the mode-dependent implicit register set. */
+static inline bool writeVexClear(cs_struct *handle, const uint8_t *code,
+				 size_t size, cs_insn *insn,
+				 uint16_t *insn_size, bool wide)
+{
+	if (size < 3 || code[2] != 0x77 || (code[1] & 0xfb) != 0xf8)
+		return false;
+	const bool all = (code[1] & 4) != 0;
+	insn->size = *insn_size = 3;
+	memcpy(insn->bytes, code, 3);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	if (all)
+		memcpy(insn->mnemonic, "vzeroall", sizeof("vzeroall"));
+	else
+		memcpy(insn->mnemonic, "vzeroupper", sizeof("vzeroupper"));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	if (insn->detail) {
+		cs_detail *detail = insn->detail;
+		memset(detail, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		detail->x86.addr_size = wide ? 8 : 4;
+		detail->x86.rex = wide ? 0x40 : 0;
+		memcpy(detail->x86.opcode, code, 2);
+		X86_get_insn_id(handle, insn,
+				all ? X86_VZEROALL : X86_VZEROUPPER);
+	} else {
+		insn->id = all ? X86_INS_VZEROALL : X86_INS_VZEROUPPER;
+	}
+	return true;
+}
+
+#endif
