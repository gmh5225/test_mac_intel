+						(uint8_t)((wl >> 2) << 7 |
+							  ((~dst & 15) << 3) |
+							  5),
+						(uint8_t)((wl & 3) << 5 |
+							  ((~dst & 16) >> 1)),
+						(uint8_t)opcode,
+						(uint8_t)(0xc0 | group << 3 |
+							  (src & 7)),
+						(uint8_t)(pair * 37)
+					};
