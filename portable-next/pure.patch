+/* Mixed libraries can index a contiguous opcode range without the handle's
+ * lookup table. The generated rows have strictly increasing IDs. */
+static inline bool has_dense_insn_ids(void)
+{
+#ifdef CAPSTONE_X86_ONLY
+	return false;
+#else
+	return insns[ARR_SIZE(insns) - 1].id - insns[0].id ==
+	       ARR_SIZE(insns) - 1;
+#endif
+}
+
+static inline unsigned int dense_insn_index(unsigned int id)
+{
+	const unsigned int row = id - insns[0].id;
+	return row < ARR_SIZE(insns) ? row : (unsigned int)-1;
+}
+
 // look for @id in @insns
 // return -1 if not found
 unsigned int find_insn(unsigned int id)
 {
+	if (has_dense_insn_ids())
+		return dense_insn_index(id);
+
 	// binary searching since the IDs are sorted in order
 	unsigned int left, right, m;
 	unsigned int max = ARR_SIZE(insns);
@@ -10288,6 +10309,9 @@ unsigned int find_insn(unsigned int id)
 
 static inline unsigned int find_insn_h(cs_struct *h, unsigned int id)
 {
+	if (has_dense_insn_ids())
+		return dense_insn_index(id);
+
 	if (h && h->x86_insn_lut && id <= h->x86_insn_lut_max)
 		return (unsigned int)(int16_t)(uint16_t)h->x86_insn_lut[id];
 
