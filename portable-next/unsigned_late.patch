+#define X86_MEMORY_IMMEDIATE writeCompareMemory64
+#define X86_IMMEDIATE_WIDE 1
+#define X86_COMPARE_IMMEDIATE
+#include "X86MemoryOutputImpl.h"
+#undef X86_COMPARE_IMMEDIATE
+#undef X86_IMMEDIATE_WIDE
+#undef X86_MEMORY_IMMEDIATE
+
+/* Match only memory CMP /7 after the fixed iterator has tried its generated plans. */
+static bool tryCompareMemory64(cs_struct *handle, const uint8_t *code,
+			       size_t size, cs_insn *insn, uint16_t *length)
+{
+	const unsigned lead = (code[0] & 0xf0) == 0x40;
+	if (size < lead + 2)
+		return false;
+	const unsigned opcode = code[lead], modrm = code[lead + 1];
+	if ((opcode != 0x80 && opcode != 0x81 && opcode != 0x83) ||
+	    modrm >= 0xc0 || (modrm & 0x38) != 0x38 ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	const unsigned prefix = lead ? 1 + ((code[0] >> 3) & 1) : 0;
+	const unsigned plan = x86_simple_plans[1][prefix][0x38 | (opcode & 1)];
+	return writeCompareMemory64(code, size, insn, length,
+				    &x86_simple_outputs[plan >> 2],
+				    x86_simple_registers);
+}
