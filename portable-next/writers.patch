diff --git a/arch/X86/X86OutputIterator.c b/arch/X86/X86OutputIterator.c
index cec4bec6..197311ab 100644
--- a/arch/X86/X86OutputIterator.c
+++ b/arch/X86/X86OutputIterator.c
@@ -32,4 +32,28 @@ CAPSTONE_INTERNAL bool X86_disasmIter(csh ud, const uint8_t **code,
 #endif
 	return cs_disasm_iter(ud, code, size, address, insn);
 }
+#ifdef CAPSTONE_X86_PUBLIC_OUTPUT
+CS_PRESERVE_MOST bool X86_decodePublicRecord(cs_struct *handle,
+					    const uint8_t *code, size_t size,
+					    cs_insn *insn, uint16_t *length,
+					    bool batch)
+{
+	if (!handle->no_text) {
+		if (handle->mode == CS_MODE_32) {
+			if (X86_tryOutput32(handle, code, size, insn, length))
+				return true;
+			return X86_decodeOutputMiss32(handle, code, size, insn,
+						      length, batch);
+		}
+		if (handle->mode == CS_MODE_64) {
+			if (X86_tryOutput64(handle, code, size, insn, length))
+				return true;
+			return X86_decodeOutputMiss64(handle, code, size, insn,
+						      length, batch);
+		}
+	}
+	return cs_decode_full_insn(handle, code, size, insn, length, batch);
+}
+#endif
+
 #endif
