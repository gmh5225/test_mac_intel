index 00000000..002f969b
--- /dev/null
+++ b/arch/X86/X86RealModeOutput.c
@@ -0,0 +1,98 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include "../../cs_priv.h"
+#if defined(CAPSTONE_HAS_X86) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_real_mode_text" rodata = ".cs_x86_real_mode_rodata"
+#endif
+#include "X86OutputOptions.h"
+#include "X86RegisterImmediateOutput.h"
+#include "X86ScanAdapter.h"
+#include "X86GenTest32Registers.inc"
+
+static bool tryRealModeRegister(cs_struct *handle, const uint8_t *code,
+				size_t size, cs_insn *insn, uint16_t *length);
+#define CS_DECODE_TRY_OUTPUT tryRealModeRegister
+#include "../../cs_disasm_internal.h"
+
+#include "X86GenStack16Output.inc"
+
+/* A single operand-size prefix selects 32-bit registers in real mode. */
+static bool tryRealModeRegister(cs_struct *handle, const uint8_t *code,
+				size_t size, cs_insn *insn, uint16_t *length)
+{
+	if (handle->arch != CS_ARCH_X86 || size < 2 ||
+	    code[0] != X86_PREFIX_OPSIZE)
+		return false;
+	const uint8_t opcode = code[1];
+	const bool move = (opcode & 0xf8) == 0xb8 && size >= 6;
+	if ((!move && (opcode & 0xf0) != 0x50) || handle->skipdata ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	if (move) {
+		writeUnsignedRegisterImmediate(insn, &stack16_mov32,
+					       &test32_regs[1][opcode & 7],
+					       code, 0, 0, 2, 4, length);
+		if (insn->detail) {
+			insn->detail->x86.opcode[0] = opcode;
+			insn->detail->x86.addr_size = 2;
+			insn->detail->x86.prefix[2] = X86_PREFIX_OPSIZE;
+		}
+		return true;
+	}
+	const struct X86SimpleOutput *row = &stack16_rows[(opcode >> 3) & 1];
+	const struct X86SimpleRegister *reg = &test32_regs[1][opcode & 7];
+	insn->id = row->id;
+	insn->size = *length = 2;
+	insn->bytes[0] = X86_PREFIX_OPSIZE;
+	insn->bytes[1] = (uint8_t)opcode;
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, reg->name, sizeof(reg->name));
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, (uint8_t)opcode,
+				      0, 0, reg->reg, 0);
+		insn->detail->x86.prefix[2] = X86_PREFIX_OPSIZE;
+	}
+	return true;
+}
+
+/* The fixed i386 iterator has already declined the requested mode. */
+CAPSTONE_INTERNAL bool X86_disasmIterOtherMode(csh handle, const uint8_t **code,
+					       size_t *size, uint64_t *address,
+					       cs_insn *insn)
+{
+	cs_struct *state = (cs_struct *)(uintptr_t)handle;
+	if (state && state->arch == CS_ARCH_X86 && state->mode == CS_MODE_16 &&
+	    !state->no_text)
+		return cs_disasm_iter_core(handle, code, size, address, insn);
+	return X86_disasmIter(handle, code, size, address, insn);
+}
+
+#ifdef CAPSTONE_X86_LINKED_PUBLIC_ITERATOR
+/* This member is extracted by clients using the native x86 iterators. */
+CAPSTONE_EXPORT bool CAPSTONE_API cs_disasm_iter(csh ud, const uint8_t **code,
+						size_t *size, uint64_t *address,
+						cs_insn *insn)
+{
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (!*size || !handle)
+		return false;
+	if (handle->arch != CS_ARCH_X86)
+		return cs_disasm_iter_core(ud, code, size, address, insn);
+	if (!handle->no_text && !handle->skipdata &&
+	    (handle->syntax == CS_OPT_SYNTAX_DEFAULT ||
+	     handle->syntax == CS_OPT_SYNTAX_INTEL)) {
+		if (handle->mode == CS_MODE_64 || handle->mode == CS_MODE_32)
+			return X86_disasmIterText(ud, code, size, address, insn);
+		if (handle->mode == CS_MODE_16)
+			return X86_disasmIterOtherMode(ud, code, size, address, insn);
+	}
+	return cs_disasm_default_iter(ud, code, size, address, insn);
+}
+#endif
+#endif
