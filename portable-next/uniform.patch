+/* Intel metadata lists the destination first. Each shift puts the
+ * newest source in the low byte, which is the first AT&T operand. */
+static uint64_t get_att_access(cs_struct *h, unsigned int id, uint64_t *eflags)
 {
-	uint8_t count, i;
 	const uint8_t *arr = X86_get_op_access(h, id, eflags);
-
-	// initialize access
-	memset(access, 0, CS_X86_MAXIMUM_OPERAND_SIZE * sizeof(access[0]));
-	if (!arr) {
-		return;
+	uint64_t access = 0;
+	if (arr) {
+		for (; *arr; ++arr) {
+			const uint8_t value = *arr;
+			access = (access << 8) | (value == CS_AC_IGNORE ? 0 : value);
+		}
 	}
+	return access;
+}
 
-	// find the non-zero last entry
