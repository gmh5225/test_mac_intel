 #ifdef CAPSTONE_MIPS_SCAN_BY_OPTION
+/* The classic scan only needs the public opcode. Register jumps reserve
+ * rt, and JR also reserves rd. A zero shift leaves all hint encodings
+ * (SSNOP, EHB and PAUSE) to the ordinary decoder. */
+static inline unsigned classicScanOpcode(MCInst *instr, uint32_t word,
+					 cs_mode mode)
+{
+	const unsigned major = word >> 26;
+	if (major)
+		return major == 8 ? Mips_ADDi : standardScanOpcode(major, mode);
+
+	switch (word & 0x7ff) {
+	case 0x00:
+		return (word >> 21) == 0 ? Mips_SLL : 0;
+	case 0x08:
+		return (word & 0x001ff800) == 0 ? Mips_JR : 0;
+	case 0x09:
+		return (word & 0x001f0000) == 0 ? Mips_JALR : 0;
+	default:
+		return classicMappedOpcode(instr, word);
+	}
+}
+
 static bool getScanInstruction(csh handle, const uint8_t *code, size_t length,
 			       MCInst *instr, uint16_t *size, uint64_t address,
 			       void *info)
@@ -997,12 +1019,7 @@ static bool getScanInstruction(csh handle, const uint8_t *code, size_t length,
 	    h->disasm == getScanInstruction && h->insn_id == Mips_get_insn_id &&
 	    h->no_text && !instr->flat_insn->detail) {
 		const uint32_t word = readBytes32(instr, code);
-		const unsigned major = word >> 26;
-		/* SPECIAL needs the function and reserved shift bits. ADDI
-		 * and the register forms share the classic detail mapping. */
-		const unsigned opcode = major == 0 || major == 8 ?
-						classicMappedOpcode(instr, word) :
-						standardScanOpcode(major, mode);
