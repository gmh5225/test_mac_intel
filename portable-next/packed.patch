+		}
+		break;
+	case 0x80:
+	case 0x81:
+	case 0x83:
+		if (size >= 2 && code[1] < 0xc0 && (code[1] & 0x38) == 0x38 &&
+		    !X86_OUTPUT_UNSUPPORTED(handle, false)) {
+			const unsigned row =
