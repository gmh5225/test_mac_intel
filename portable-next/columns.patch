 """Project Intel x86 register-name lengths into the existing uint16 offsets.
 
 Run after regenerating X86GenRegisterName1.inc. The strings and original offsets
-remain authoritative; AT&T and public register-name tables are unchanged.
+remain authoritative for the bounded Intel register records.
 """
 
 import argparse
+import json
 from pathlib import Path
 import re
 
@@ -119,6 +120,29 @@ def generate(text, enum_text):
     return result
 
 
+def register_slots(text):
+    strings = string_bytes(text)
+    records = [int(x) for x in TABLE.search(text)[1].split(",") if x.strip()]
+    names = []
+    for record in records:
+        offset = record & MASK
+        length = record >> SHIFT
+        name = strings[offset : offset + length]
+        require(strings[offset + length] == 0 and b"\\0" not in name,
+                "Invalid register spelling")
+        names.append(name.decode("ascii"))
+    lines = [
+        "/* Generated by x86_register_name_sizes.py. */",
+        "static const char X86PrinterRegisterNames[][8] = {",
+    ]
+    lines.extend(f"\t{json.dumps(name)}," for name in names)
+    lines.extend(["};", "", "static const uint8_t X86PrinterRegisterLengths[] = {"])
+    for offset in range(0, len(names), 16):
+        lines.append("\t" + ", ".join(str(len(n)) for n in names[offset:offset+16]) + ",")
+    lines.append("};")
+    return "\n".join(lines) + "\n"
+
+
 def main():
     parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--check", action="store_true")
