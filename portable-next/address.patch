+/* Handle creation and later mode changes must select the same decoder width
+ * and register map. Reject incompatible vendors before updating the handle. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static bool select_mode(cs_struct *handle, cs_mode mode)
+{
+	if (x86_has_feature(mode, CS_MODE_X86_INTEL | CS_MODE_X86_AMD))
+		return false;
+	if (!(mode & (CS_MODE_16 | CS_MODE_32)))
+		mode = (cs_mode)(mode | CS_MODE_64);
+	handle->mode = mode;
+	handle->regsize_map = x86_has_feature(mode, CS_MODE_64) ?
+				      regsize_map_64 : regsize_map_32;
+	return true;
+}
