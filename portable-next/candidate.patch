diff --git a/tests/unit/riscv_op_count_iter.c b/tests/unit/riscv_op_count_iter.c
index 0984421a..bc123d80 100644
--- a/tests/unit/riscv_op_count_iter.c
+++ b/tests/unit/riscv_op_count_iter.c
@@ -1,6 +1,7 @@
 #include "unit_test.h"
 #include <capstone/capstone.h>
 #include <stdio.h>
+#include <string.h>
 #include <inttypes.h>
 
 // c.addi sp, -16 (2 ops) -> addi a0, a1, 1 (3 ops) -> c.addi sp, -16 (2 ops)
@@ -40,9 +41,50 @@ static bool test_riscv_op_count_no_stale()
 	return true;
 }
 
+/* Changing text syntax must preserve the requested operand view, including
+ * when a compressed instruction expands or an uncompressed alias is printed. */
+static bool check_detail_syntax(cs_opt_value detail, cs_opt_value reference)
+{
+	static const uint8_t code[] = {
+		0x41, 0x11,              /* c.addi sp, -16 */
+		0x13, 0x85, 0x15, 0x00,  /* addi a0, a1, 1 */
+		0x13, 0x85, 0x05, 0x00,  /* mv a0, a1 */
+	};
+	csh handle;
+	if (cs_open(CS_ARCH_RISCV, CS_MODE_RISCV64 | CS_MODE_RISCV_C,
+		    &handle) != CS_ERR_OK)
+		return false;
+	cs_insn *canonical = NULL;
+	bool ok = cs_option(handle, CS_OPT_DETAIL, CS_OPT_ON | detail) == CS_ERR_OK &&
+		  cs_option(handle, CS_OPT_SYNTAX, reference) == CS_ERR_OK;
+	size_t count = ok ? cs_disasm(handle, code, sizeof(code), 0, 0, &canonical) : 0;
+	ok = count == 3;
+	const cs_opt_value syntaxes[] = { CS_OPT_SYNTAX_ALIAS, CS_OPT_SYNTAX_REAL,
+					 CS_OPT_SYNTAX_UNCOMPRESSED_REAL };
+	for (size_t k = 0; ok && k < sizeof(syntaxes) / sizeof(syntaxes[0]); ++k) {
+		cs_insn *other = NULL;
+		ok = cs_option(handle, CS_OPT_SYNTAX, syntaxes[k]) == CS_ERR_OK;
+		size_t n = ok ? cs_disasm(handle, code, sizeof(code), 0, 0, &other) : 0;
+		ok = n == count;
+		for (size_t i = 0; ok && i < n; ++i) {
+			const cs_riscv *x = &canonical[i].detail->riscv;
+			const cs_riscv *y = &other[i].detail->riscv;
+			ok = x->op_count == y->op_count &&
+			     !memcmp(x->operands, y->operands, sizeof(x->operands));
+		}
+		cs_free(other, n);
+	}
+	cs_free(canonical, count);
+	cs_close(&handle);
+	return ok;
+}
+
 int main(void)
 {
 	bool ret = true;
 	ret &= test_riscv_op_count_no_stale();
+	ret &= check_detail_syntax(CS_OPT_DETAIL_REAL, CS_OPT_SYNTAX_REAL);
+	ret &= check_detail_syntax(CS_OPT_DETAIL_UNCOMPRESSED_REAL,
+				   CS_OPT_SYNTAX_UNCOMPRESSED_REAL);
 	return ret ? 0 : -1;
 }
