index a60d3d24..dc5f0331 100644
--- a/arch/RISCV/RISCVInstPrinter.c
+++ b/arch/RISCV/RISCVInstPrinter.c
@@ -142,7 +142,12 @@ bool haveRequiredFeatures(const RISCV_SysReg *Reg, MCInst *MI)
 
 static inline void printOperand(MCInst *MI, unsigned OpNo, SStream *O)
 {
+#ifdef CAPSTONE_RISCV_ONLY
+	if (detail_is_set(MI))
+		RISCV_add_operand_detail(MI, OpNo);
+#else
 	RISCV_add_cs_detail_0(MI, RISCV_OP_GROUP_Operand, OpNo);
+#endif
 
 	MCOperand *MO = MCInst_getOperand(MI, (OpNo));
 
diff --git a/arch/RISCV/RISCVMapping.c b/arch/RISCV/RISCVMapping.c
index 89cbda0c..0a848269 100644
--- a/arch/RISCV/RISCVMapping.c
+++ b/arch/RISCV/RISCVMapping.c
@@ -60,10 +60,17 @@ static const alias_trie_node riscv_alias_trie[] = {
 };
 #endif
 
+#ifdef CAPSTONE_RISCV_ONLY
+static inline void addOperandDetail(MCInst *MI, riscv_op_group opgroup,
+				    unsigned OpNum)
+#else
 void RISCV_add_cs_detail_0(MCInst *MI, riscv_op_group opgroup, unsigned OpNum)
+#endif
 {
+#ifndef CAPSTONE_RISCV_ONLY
 	if (!detail_is_set(MI))
 		return;
+#endif
 	// Rounding mode: store in detail, not as a regular operand.
 	if (opgroup == RISCV_OP_GROUP_FRMArg ||
 	    opgroup == RISCV_OP_GROUP_FRMArgLegacy) {
@@ -197,6 +204,19 @@ void RISCV_add_cs_detail_0(MCInst *MI, riscv_op_group opgroup, unsigned OpNum)
 	RISCV_inc_op_count(MI);
 }
 
+#ifdef CAPSTONE_RISCV_ONLY
+void RISCV_add_cs_detail_0(MCInst *MI, riscv_op_group opgroup, unsigned OpNum)
+{
+	if (detail_is_set(MI))
+		addOperandDetail(MI, opgroup, OpNum);
+}
+
+void RISCV_add_operand_detail(MCInst *MI, unsigned OpNum)
+{
+	addOperandDetail(MI, RISCV_OP_GROUP_Operand, OpNum);
+}
+#endif
+
 static inline void RISCV_add_adhoc_groups(MCInst *MI);
 
 void RISCV_add_groups(MCInst *MI)
