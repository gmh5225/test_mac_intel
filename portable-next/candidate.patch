diff --git a/arch/WASM/WASMTablePrinter.c b/arch/WASM/WASMTablePrinter.c
new file mode 100644
index 00000000..c45eabca
--- /dev/null
+++ b/arch/WASM/WASMTablePrinter.c
@@ -0,0 +1,34 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include "WASMInstPrinter.h"
+
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_wasm_table_text" rodata = ".cs_wasm_table_rodata"
+#endif
+
+void WASM_printTableOperands(SStream *out,
+			    const cs_wasm_brtable *table)
+{
+#if !defined(CAPSTONE_DIET) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+	/* Each original append can close a markup or truncate the stream. */
+	if (cs_vsnprintf == cs_default_vsnprintf && !out->is_closed &&
+	    !(out->markup_stream && out->prefixed_by_markup) &&
+	    out->index <= SSTREAM_BUF_LEN -
+			sizeof("\t0xffffffff, [0xffffffffffffffff], 0xffffffff")) {
+		SStream_concat(out, "\t0x%x, [0x%" PRIx64 "], 0x%x",
+			       (unsigned)table->length, table->address,
+			       (unsigned)table->default_target);
+		return;
+	}
+#endif
+	/* A registered formatter observes these three calls and their formats. */
+	SStream_concat(out, "\t0x%x, [", (unsigned)table->length);
+	if (table->address <= UINT32_MAX)
+		SStream_concat(out, "0x%x", (unsigned)table->address);
+	else
+		SStream_concat(out, "0x%" PRIx64, table->address);
+	SStream_concat(out, "], 0x%x", (unsigned)table->default_target);
+}
diff --git a/tests/unit/wasm_brtable_size.c b/tests/unit/wasm_brtable_size.c
index 5ae892b4..00821c17 100644
--- a/tests/unit/wasm_brtable_size.c
+++ b/tests/unit/wasm_brtable_size.c
@@ -120,6 +120,24 @@ static int check_i64_constant(csh handle)
 	return !ok;
 }
 
+static int check_table_address(csh handle)
+{
+	const uint8_t code[] = { 0x0e, 0x02, 0x00, 0x01, 0x02 };
+	const uint64_t address = UINT64_C(0xfffffffe);
+	cs_insn *insn = NULL;
+	if (cs_option(handle, CS_OPT_DETAIL, CS_OPT_ON) != CS_ERR_OK)
+		return 1;
+	size_t count = cs_disasm(handle, code, sizeof(code), address, 1, &insn);
+	bool ok = count == 1 && insn->id == WASM_INS_BR_TABLE &&
+		  insn->detail->wasm.operands[0].brtable.address == address + 2;
+	if (ok && !cs_support(CS_SUPPORT_DIET))
+		ok = strcmp(insn->op_str, "0x2, [0x100000000], 0x2") == 0;
+	cs_free(insn, count);
+	if (!ok)
+		fprintf(stderr, "WASM br_table target list address lost high bits\n");
+	return !ok;
+}
+
