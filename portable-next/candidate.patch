diff --git a/CMakeLists.txt b/CMakeLists.txt
index 602ae735..064cd696 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1088,6 +1088,12 @@ if(capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV"
    AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|aarch64|arm64|ARM64)$")
     target_compile_definitions(capstone_build_settings INTERFACE
         "$<$<CONFIG:Release>:CAPSTONE_X86_COMPACT_SCALAR_ROWS>")
+    # This code generator can reuse the AMD64 text iterator's entry checks
+    # without moving the subsequent ELF batch scan sections.
+    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
+        set_property(SOURCE arch/X86/X86Sse64Output.c APPEND PROPERTY
+            COMPILE_DEFINITIONS "$<$<CONFIG:Release>:X86_FIXED_OUTPUT_PRECHECKED>")
+    endif()
 endif()
 add_library(capstone OBJECT ${ALL_SOURCES} ${capstone_storage_source} ${capstone_arm_char_source} ${ALL_HEADERS})
 target_link_libraries(capstone PUBLIC capstone_build_settings)
diff --git a/arch/X86/X86OutputOptions.h b/arch/X86/X86OutputOptions.h
index 62d4288a..e6fbb1f5 100644
--- a/arch/X86/X86OutputOptions.h
+++ b/arch/X86/X86OutputOptions.h
@@ -27,10 +27,10 @@ CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
 X86_decodeOutputMiss64(cs_struct *handle, const uint8_t *code, size_t size,
 			cs_insn *insn, uint16_t *insn_size, bool batch);
 
-/* Keep the mode, option and callback checks in a single short-circuit chain
- * in both instantiations of the scalar writer. */
-#define X86_OUTPUT_UNSUPPORTED(handle, mode_mismatch) \
-	((mode_mismatch) || (handle)->no_text || (handle)->imm_unsigned || \
+/* Both wrappers expand the option checks in the original left-to-right
+ * chain. The fixed text reader has already checked its mode and text state. */
+#define X86_OUTPUT_OPTION_TERMS(handle) \
+	(handle)->imm_unsigned || \
 	 (handle)->mnem_list || (handle)->doing_mem || \
 	 ((handle)->syntax != CS_OPT_SYNTAX_INTEL && \
 	  (handle)->syntax != CS_OPT_SYNTAX_DEFAULT) || \
@@ -38,6 +38,12 @@ X86_decodeOutputMiss64(cs_struct *handle, const uint8_t *code, size_t size,
 	 (handle)->insn_id != X86_get_insn_id || \
 	 (handle)->printer != X86_Intel_printInst || \
 	 (handle)->post_printer != X86_postprinter || \
-	 cs_vsnprintf != cs_default_vsnprintf)
+	 cs_vsnprintf != cs_default_vsnprintf
+
+#define X86_OUTPUT_OPTIONS_UNSUPPORTED(handle) (X86_OUTPUT_OPTION_TERMS(handle))
+
+#define X86_OUTPUT_UNSUPPORTED(handle, mode_mismatch) \
+	((mode_mismatch) || (handle)->no_text || \
+	 X86_OUTPUT_OPTION_TERMS(handle))
 
 #endif
