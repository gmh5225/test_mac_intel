+// In i386, all register-direct byte pairs use six characters and all
+// dword pairs use eight. At byte four the second register is independent
+// of the first in both widths.
+void emit_register_fragments32(Decoder &decoder)
+{
+	std::cout << "/* Generated by suite/synctools/x86_simple_output.cpp --register-fragments32. */\n"
+		  << "static const struct X86RegisterFragment32 x86_register_fragments32[2][8] = {\n";
+	for (unsigned width = 0; width < 2; ++width) {
+		std::cout << "\t{\n";
+		for (unsigned i = 0; i < 8; ++i) {
+			decode_pair(decoder, 0, 0x88 + width, 0xc0 + i * 9);
+			const auto &x = decoder.insn->detail->x86;
+			if (x.op_count != 2 || x.operands[0].type != X86_OP_REG ||
+			    x.operands[1].type != X86_OP_REG ||
+			    x.operands[0].reg != x.operands[1].reg)
+				throw std::runtime_error("unexpected i386 register pair");
+			const auto reg = x.operands[0].reg;
+			const std::string name = cs_reg_name(decoder.handle, reg);
+			const std::string pair = name + ", " + name;
+			if (name.size() != 2 + width || pair != decoder.insn->op_str)
+				throw std::runtime_error("unexpected i386 pair spelling");
+			char first[4], second[4] = {};
+			std::memcpy(first, pair.data(), sizeof(first));
+			std::memcpy(second, pair.data() + 4, pair.size() - 4);
+			std::cout << "\t\t{ ";
+			emit_array(std::cout, first);
+			std::cout << ", ";
+			emit_array(std::cout, second);
+			std::cout << ", " << reg << " },\n";
+		}
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+}
+
 } // namespace
 
