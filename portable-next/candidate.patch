+static inline void writeRegisterPair32(char *out, unsigned opcode,
+				       uint8_t modrm, unsigned form,
+				       uint16_t *first, uint16_t *second)
+{
+	const struct X86RegisterFragment32 *bank =
+		x86_register_fragments32[opcode & 1];
+	const unsigned reg = (modrm >> 3) & 7, rm = modrm & 7;
+	const bool reg_first = form == X86_SIMPLE_REG_RM;
+	const struct X86RegisterFragment32 *a = &bank[reg_first ? reg : rm];
+	const struct X86RegisterFragment32 *b = &bank[reg_first ? rm : reg];
+	memcpy(out, a->first, sizeof(a->first));
+	memcpy(out + sizeof(a->first), b->second, sizeof(b->second));
+	*first = a->reg;
+	*second = b->reg;
+}
