+}
+
+static void add_literal_register(MCInst *MI, xcore_reg reg)
+{
+	cs_xcore *detail = &MI->flat_insn->detail->xcore;
+	cs_xcore_op *op = &detail->operands[detail->op_count++];
+	op->type = XCORE_OP_REG;
+	op->reg = reg;
+}
+
+/* The initial assembly fragment can contain complete operands, or end
+ * inside a memory operand that the encoded fields finish printing. */
+static void extract_literal_operands(MCInst *MI, const char *text)
+{
+	if (!MI->csh->detail_opt)
+		return;
+	const char *p = strchr(text, ' ');
+	if (!p)
+		return;
+
+	++p;
+	while (*p) {
+		const char *end = p + strcspn(p, ",[");
+		xcore_reg reg = XCore_reg_id(p, (size_t)(end - p));
+		if (*end == '[') {
+			set_mem_access(MI, true, reg);
+			p = end + 1;
+			end = strchr(p, ']');
+			if (!end)
+				return;
+			cs_xcore *detail = &MI->flat_insn->detail->xcore;
+			xcore_op_mem *mem = &detail->operands[detail->op_count].mem;
+			mem->index = (uint8_t)XCore_reg_id(p, (size_t)(end - p));
+			if (!mem->index)
+				mem->disp = (int32_t)strtol(p, NULL, 0);
+			set_mem_access(MI, false, 0);
+			++end;
+		} else if (reg) {
+			add_literal_register(MI, reg);
+		}
+		if (*end != ',')
+			return;
+		p = end + 1;
+		while (*p == ' ')
+			++p;
 	}
 }
 
