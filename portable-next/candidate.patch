 	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
 	!defined(_WIN32_WCE)
 #define CAPSTONE_X86_PUBLIC_OUTPUT
+/* The standalone Linux Clang iterators can enter the fixed record writer
+ * directly. Keep the established entry for the other code generators. */
+#if defined(__linux__) && defined(__clang__) && \
+	(defined(__x86_64__) || defined(__aarch64__))
