+		const unsigned row = x86_simple_plans[0][0][pair] >> 2;
+		writeUnsignedRegisterImmediate(
+			insn, &x86_simple_outputs[row],
+			&x86_simple_registers[form ? 2 : 0][0], code, 0, 0,
+			1, width, insn_size);
+		return true;
+	}
 	case 0xc4:
 		if (X86_writeVexRegisterImmediate(handle, code, size, insn,
 						  insn_size, x86_simple_registers, false))
