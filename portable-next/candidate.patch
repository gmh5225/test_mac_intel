+/* MOVSB can read the same segment through both memory operands, or
+ * through one memory operand and the implicit register list. */
+static bool check_unique_string_segments(csh handle, cs_insn *insn)
+{
+	static const uint8_t prefixes[] = { 0x26, 0x3e };
+	static const x86_reg segments[] = { X86_REG_ES, X86_REG_DS };
+	for (unsigned i = 0; i < sizeof(prefixes); ++i) {
+		const uint8_t code[] = { prefixes[i], 0xa4 };
+		const uint8_t *next = code;
+		size_t size = sizeof(code);
+		uint64_t address = 0x1000;
+		cs_regs reads, writes;
+		uint8_t nr = 0, nw = 0;
+		if (!cs_disasm_iter(handle, &next, &size, &address, insn) ||
+		    size != 0 || insn->id != X86_INS_MOVSB ||
+		    cs_regs_access(handle, insn, reads, &nr, writes, &nw) !=
+			    CS_ERR_OK)
+			return false;
+		unsigned count = 0;
+		for (unsigned j = 0; j < nr; ++j)
+			count += reads[j] == segments[i];
+		if (count != 1) {
+			fprintf(stderr, "MOVSB segment %#x occurs %u times\n",
+				prefixes[i], count);
+			return false;
+		}
+	}
+	return true;
+}
