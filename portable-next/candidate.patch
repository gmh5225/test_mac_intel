diff --git a/arch/RISCV/RISCVMapping.c b/arch/RISCV/RISCVMapping.c
index 89cbda0c..8925613a 100644
--- a/arch/RISCV/RISCVMapping.c
+++ b/arch/RISCV/RISCVMapping.c
@@ -547,6 +547,29 @@ void RISCV_reg_access(const cs_insn *insn, cs_regs regs_read,
 	*regs_write_count = write_count;
 }
 
+#ifdef RISCV_CHECK_DENSE_DETAIL
+/* Keep the dedicated detail path separate from the shared text and lookup
+ * functions. A dense prefix and a zero suffix already meet the public
+ * compaction contract, including the bytes beyond op_count. */
+__attribute__((section(".cs_riscv_detail_text")))
+void RISCV_finish_operand_detail(MCInst *MI)
+{
+	const cs_riscv *detail = RISCV_get_detail(MI);
+	const unsigned count = detail->op_count;
+	static const cs_riscv_op zero[NUM_RISCV_OPS]
+		__attribute__((section(".cs_riscv_detail_rodata")));
+	if (count <= NUM_RISCV_OPS) {
+		unsigned i = 0;
+		while (i < count && detail->operands[i].type != RISCV_OP_INVALID)
+			++i;
+		if (i == count && memcmp(detail->operands + count, zero,
+					 (NUM_RISCV_OPS - count) * sizeof(*zero)) == 0)
+			return;
+	}
+	RISCV_compact_operands(MI);
+}
+#endif
