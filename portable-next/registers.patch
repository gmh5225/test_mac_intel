+void emit_legacy16()
+{
+	Decoder decoder(CS_MODE_16);
+	RegisterTable regs{};
+	for (unsigned bank : { 0u, 2u }) {
+		for (unsigned i = 0; i < 8; ++i) {
+			decode_pair(decoder, 0, bank ? 0x89 : 0x88,
+				    static_cast<uint8_t>(0xc0 + 9 * i));
+			auto &reg = regs[bank][i];
+			const cs_x86 &x = decoder.insn->detail->x86;
+			if (x.op_count != 2 || x.operands[0].type != X86_OP_REG ||
+			    x.operands[1].type != X86_OP_REG ||
+			    x.operands[0].reg != x.operands[1].reg)
+				throw std::runtime_error("unexpected real-mode register move");
+			reg.reg = x.operands[0].reg;
+			const char *name = cs_reg_name(decoder.handle, reg.reg);
+			if (!name || strlen(name) >= sizeof(reg.name))
+				throw std::runtime_error("unexpected real-mode register name");
+			strcpy(reg.name, name);
+			reg.length = static_cast<uint8_t>(strlen(name));
+		}
+	}
+	uint16_t plans[256]{};
+	std::vector<std::string> rows;
+	unsigned encodings = 0;
+	for (unsigned op = 0; op < 256; ++op) {
+		X86SimpleForm form = X86_SIMPLE_FIXED;
+		CheckedRow row;
+		if (fixed_opcode(op, false))
+			row = check_fixed(decoder, op);
+		else if (pair_opcode(op))
+			row = check_pair(decoder, op, 0, regs, form);
+		else
+			continue;
+		auto it = std::find(rows.begin(), rows.end(), row.fields);
+		unsigned index = static_cast<unsigned>(it - rows.begin());
+		if (it == rows.end())
+			rows.push_back(row.fields);
+		plans[op] = static_cast<uint16_t>(((index + 1) << 2) | form);
+		encodings += row.encodings;
+	}
+	std::cout << "/* Generated by suite/synctools/x86_simple_output.cpp --legacy16. */\n"
+		  << "static const uint16_t legacy16_plans[256] = {\n";
+	for (unsigned i = 0; i < 256; i += 16) {
+		std::cout << '\t';
+		for (unsigned j = i; j < i + 16; ++j)
+			std::cout << plans[j] << (j == i + 15 ? "," : ", ");
+		std::cout << '\n';
+	}
+	std::cout << "};\nstatic const struct X86SimpleOutput legacy16_rows[] = {\n";
+	for (const auto &row : rows)
+		std::cout << '\t' << row << ",\n";
+	std::cout << "};\nstatic const struct X86SimpleRegister legacy16_regs[2][8] = {\n";
+	for (unsigned bank : { 0u, 2u }) {
+		std::cout << "\t{\n";
+		for (unsigned i = 0; i < 8; ++i)
+			emit_register(regs[bank][i]);
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+	std::cerr << encodings << " canonical encodings, " << rows.size() << " rows\n";
+}
