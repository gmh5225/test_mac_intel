+CAPSTONE_INTERNAL bool X86_writeLegacy16(cs_struct *handle, const uint8_t *code,
+					 size_t size, cs_insn *insn, uint16_t *insn_size)
+{
+	const uint8_t opcode = code[0];
+	const unsigned plan = legacy16_plans[opcode];
+	if (!plan || X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	const unsigned form = plan & 3;
+	const bool pair = form != X86_SIMPLE_FIXED;
+	if (pair && (size < 2 || code[1] < 0xc0))
+		return false;
+
+	const struct X86SimpleOutput *row = &legacy16_rows[(plan >> 2) - 1];
+	uint16_t first = row->ops[0].reg, second = row->ops[1].reg;
+	const uint8_t modrm = pair ? code[1] : 0;
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)(1 + pair);
+	insn->bytes[0] = opcode;
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	if (pair) {
+		const struct X86SimpleRegister *regs = legacy16_regs[opcode & 1];
+		const unsigned reg = (modrm >> 3) & 7, rm = modrm & 7;
+		const struct X86SimpleRegister *a = &regs[form == X86_SIMPLE_REG_RM ? reg : rm];
+		const struct X86SimpleRegister *b = &regs[form == X86_SIMPLE_REG_RM ? rm : reg];
+		insn->bytes[1] = modrm;
+		memcpy(insn->op_str, a->name, sizeof(a->name));
+		char *sep = insn->op_str + a->length;
+		memcpy(sep, ", ", 2);
+		memcpy(sep + 2, b->name, sizeof(b->name));
+		first = a->reg;
+		second = b->reg;
+	} else {
+		memcpy(insn->op_str, row->operands, sizeof(row->operands));
+	}
+	if (insn->detail)
+		X86_writeSimpleDetail(insn->detail, row, opcode, 0, modrm, first, second);
+	return true;
+}
