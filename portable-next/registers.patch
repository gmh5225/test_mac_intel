 }
 
+// A CMOV's condition selects its mnemonic and implicit flags. The REX.W bit
+// selects the size of both registers. Check both sizes before sharing a row.
+std::string describe_cmov_registers(Decoder &decoder, const RegisterTable &regs,
+				    uint8_t opcode)
+{
+	CheckedRow row;
+	for (unsigned prefix = 0; prefix <= 16; ++prefix) {
+		const uint8_t rex = prefix ? uint8_t(0x3f + prefix) : 0;
+		const bool wide = (rex & 8) != 0;
+		const auto &bank = regs[wide ? 3 : 2];
+		for (unsigned mr = 0xc0; mr <= 0xff; ++mr) {
+			const uint8_t code[] = { rex, 0x0f, opcode, uint8_t(mr) };
+			decoder.decode(code + !rex, 3 + !!rex, 3 + !!rex, 0);
+			cs_insn insn = *decoder.insn;
+			cs_detail detail = *insn.detail;
+			auto &x = detail.x86;
+			if (x.op_count != 2 || x.operands[0].size != (wide ? 8 : 4) ||
+			    x.operands[1].size != x.operands[0].size)
+				throw std::runtime_error("unexpected conditional move width");
+			x.operands[0].size = x.operands[1].size = 4;
+			insn.detail = &detail;
+			const auto &dst = bank[((rex & 4) << 1) | ((mr >> 3) & 7)];
+			const auto &src = bank[((rex & 1) << 3) | (mr & 7)];
+			row.observe(describe(insn, opcode, rex, uint8_t(mr),
+					     &dst, &src, false, false, true));
+		}
+	}
+	return row.fields;
+}
