+{
+	for (unsigned cc = 0; cc < 16; ++cc) {
+		for (unsigned prefix = 0; prefix <= 16; ++prefix) {
+			for (unsigned mr = 0xc0; mr <= 0xff; ++mr) {
+				const uint8_t bytes[] = { (uint8_t)(0x3f + prefix), 0x0f,
+							  (uint8_t)(0x40 + cc), (uint8_t)mr };
+				if (!compare(handles, bytes + !prefix, 3 + !!prefix, cc + mr))
+					return false;
+			}
+		}
+	}
+	return true;
+}
