diff --git a/arch/X86/X86IntelInstPrinter.c b/arch/X86/X86IntelInstPrinter.c
index 457485ab..98a89776 100644
--- a/arch/X86/X86IntelInstPrinter.c
+++ b/arch/X86/X86IntelInstPrinter.c
@@ -298,6 +298,26 @@ static void printf512mem(MCInst *MI, unsigned OpNo, SStream *O)
 
 static const char *getRegisterName(unsigned RegNo);
 static inline unsigned getRegisterNameLength(unsigned RegNo);
+#ifdef CAPSTONE_SSTREAM_PRECHECKED
+/* Generated register names have one to seven characters followed by NUL.
+ * The caller checked the stream extent before entering this printer. */
+static inline void appendRegisterName(SStream *OS, unsigned RegNo)
+{
+	const char *name = getRegisterName(RegNo);
+	const unsigned len = getRegisterNameLength(RegNo);
+	char *out = OS->buffer + OS->index;
+	assert(len > 0 && len < 8 && OS->index < SSTREAM_BUF_LEN - len);
+	if (len >= 3) {
+		memcpy(out, name, 4);
+		memcpy(out + (len - 3), name + (len - 3), 4);
+	} else {
+		memcpy(out, name, 2);
+		out[len] = '\0';
+	}
+	OS->index += len;
+}
+#endif
+
 static void printRegName(SStream *OS, unsigned RegNo)
 {
 	const char *extension_name =
@@ -308,8 +328,12 @@ static void printRegName(SStream *OS, unsigned RegNo)
 	if (extension_name)
 		(SStream_concat0)(OS, extension_name);
 	else
+#ifdef CAPSTONE_SSTREAM_PRECHECKED
+		appendRegisterName(OS, RegNo);
+#else
 		SStream_concat0_small(OS, getRegisterName(RegNo),
 				      getRegisterNameLength(RegNo));
+#endif
 }
 
