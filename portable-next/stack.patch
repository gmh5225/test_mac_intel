+static bool check_stack_address_size(void)
+{
+	static const struct {
+		cs_mode mode;
+		uint8_t bytes[5], length;
+		x86_reg sp, read_segment, write_segment, operand;
+	} cases[] = {
+		{ CS_MODE_16, { 0x66, 0x54 }, 2, X86_REG_SP, 0, 0, X86_REG_ESP },
+		{ CS_MODE_16, { 0x67, 0x58 }, 2, X86_REG_SP, 0, 0, X86_REG_AX },
+		{ CS_MODE_32, { 0x66, 0x58 }, 2, X86_REG_ESP, 0, 0, X86_REG_AX },
+		{ CS_MODE_32, { 0x67, 0x06 }, 2, X86_REG_ESP, X86_REG_ES, 0, X86_REG_ES },
+		{ CS_MODE_64, { 0x66, 0x67, 0x50 }, 3, X86_REG_RSP, 0, 0, X86_REG_AX },
+		{ CS_MODE_64, { 0x66, 0x0f, 0xa0 }, 3, X86_REG_RSP, X86_REG_FS, 0, X86_REG_FS },
+		{ CS_MODE_64, { 0x66, 0x0f, 0xa9 }, 3, X86_REG_RSP, 0, X86_REG_GS, X86_REG_GS },
+	};
+	for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i) {
+		csh h;
+		if (cs_open(CS_ARCH_X86, cases[i].mode, &h) != CS_ERR_OK)
+			return false;
+		bool ok = cs_option(h, CS_OPT_DETAIL, CS_OPT_ON) == CS_ERR_OK;
+		for (unsigned att = 0; ok && att < 2; ++att) {
+			cs_err err = cs_option(h, CS_OPT_SYNTAX,
+					       att ? CS_OPT_SYNTAX_ATT : CS_OPT_SYNTAX_INTEL);
+			if (att && err == CS_ERR_X86_ATT)
+				continue;
+			cs_insn *insn = NULL;
+			size_t n = cs_disasm(h, cases[i].bytes, cases[i].length, 0, 1, &insn);
+			ok = err == CS_ERR_OK && n == 1 && insn->size == cases[i].length;
+			if (ok) {
+				const cs_detail *d = insn->detail;
+				unsigned segment = cases[i].read_segment != X86_REG_INVALID;
+				ok = d->regs_read_count == 1 + segment &&
+				     d->regs_read[segment] == cases[i].sp &&
+				     (!segment || d->regs_read[0] == cases[i].read_segment) &&
+				     d->regs_write_count == 1 + (cases[i].write_segment != X86_REG_INVALID) &&
+				     d->regs_write[0] == cases[i].sp &&
+				     (!cases[i].write_segment || d->regs_write[1] == cases[i].write_segment) &&
+				     d->x86.op_count == 1 && d->x86.operands[0].type == X86_OP_REG &&
+				     d->x86.operands[0].reg == cases[i].operand;
+			}
+			if (!ok)
+				fprintf(stderr, "stack effects case %zu (AT&T %u)\n", i, att);
+			cs_free(insn, n);
+		}
+		cs_close(&h);
+		if (!ok)
+			return false;
+	}
+	return true;
+}
