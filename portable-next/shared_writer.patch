+
+/* An absolute displacement is an offset of the effective address width. */
+static uint64_t X86_absoluteAddress(const MCInst *mi, int64_t disp)
+{
+	const cs_mode mode = mi->csh->mode;
+	const bool address_override = mi->x86_prefix[3] == X86_PREFIX_ADDRSIZE;
+	if (x86_has_feature(mode, CS_MODE_16))
+		return address_override ? (uint32_t)disp : (uint16_t)disp;
+	if (x86_has_feature(mode, CS_MODE_32))
+		return address_override ? (uint16_t)disp : (uint32_t)disp;
+	return address_override ? (uint32_t)disp : (uint64_t)disp;
+}
+
+/* An absolute offset has no base or index. Use its address width while
+ * leaving the signed displacement and the following operand unchanged. */
+void X86_printNegativeAbsolute(const MCInst *mi, SStream *out,
+			      int64_t displacement, bool att)
+{
+	const uint64_t address = X86_absoluteAddress(mi, displacement);
+	if (att) {
+		SStream_concat(out, "0x%" PRIx64, address);
+	} else if (mi->csh->syntax == CS_OPT_SYNTAX_MASM) {
+		const char *format = X86_masmNeedsLeadingZero(address) ?
+					     "0%" PRIx64 "h" : "%" PRIx64 "h";
+		SStream_concat(out, format, address);
+	} else {
+		SStream_concat_hex64(out, address, false);
+	}
+}
