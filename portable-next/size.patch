 	return r;
 }
 
+#ifdef CS_DECODE_TRY_OUTPUT
+/* A single-record caller needs the consumed length, including the exact
+ * skip-data callback result, but does not expose iterator cursors. */
+CS_DECODE_INLINE size_t cs_disasm_one_core(csh ud, const uint8_t *code,
+					   size_t size, uint64_t address,
+					   cs_insn *insn)
+{
+	size_t remaining = size;
+	return cs_disasm_iter_core(ud, &code, &remaining, &address, insn) ?
+		       size - remaining :
+		       0;
+}
+#endif
+
 #endif
diff --git a/tests/unit/x86_simple_output.c b/tests/unit/x86_simple_output.c
index 19e16b16..23f5eb20 100644
--- a/tests/unit/x86_simple_output.c
+++ b/tests/unit/x86_simple_output.c
@@ -1702,8 +1702,23 @@ done:
 	return ok;
 }
 
+static bool one_text_iter(csh h, const uint8_t **code, size_t *size,
+			  uint64_t *address, cs_insn *insn)
+{
+	const size_t consumed = X86_disasmOneText(h, *code, *size, *address, insn);
+	if (!consumed)
+		return false;
+	*code += consumed;
+	*size -= consumed;
+	*address += consumed;
+	return true;
+}
+
 int main(void)
 {
+	private_iter = one_text_iter;
+	if (!check_mode(CS_MODE_32) || !check_mode(CS_MODE_64))
+		return 1;
 	private_iter = X86_disasmIter32;
 	if (!check_mode(CS_MODE_32))
 		return 1;
