+static inline bool X86_matchesTextMode(csh ud, cs_mode mode)
+{
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	return handle && handle->arch == CS_ARCH_X86 && handle->mode == mode &&
+	       !handle->no_text;
+}
