+/* Decode one text record at an address. Return the number of input bytes
+ * consumed, or zero on failure. Output, errors and callbacks follow the
+ * corresponding iterator, including when a skip exceeds sizeof(insn->bytes). */
+size_t X86_disasmOneText(csh handle, const uint8_t *code, size_t size,
+			 uint64_t address, cs_insn *insn);
+size_t X86_disasmOneText32(csh handle, const uint8_t *code, size_t size,
+			   uint64_t address, cs_insn *insn);
+
 /* Requires CAPSTONE_X86_SCAN_ADAPTER. Private static-link integration, not
