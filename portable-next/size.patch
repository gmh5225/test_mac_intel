@@ -206,11 +206,22 @@ CAPSTONE_INTERNAL bool X86_disasmIter32(csh ud, const uint8_t **code,
 					cs_insn *insn)
 {
 #ifdef CS_DECODE_TRY_OUTPUT
-	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
-	if (handle && handle->arch == CS_ARCH_X86 &&
-	    handle->mode == CS_MODE_32 && !handle->no_text)
+	if (X86_matchesTextMode(ud, CS_MODE_32))
 		return cs_disasm_iter_core(ud, code, size, address, insn);
 #endif
 	return X86_disasmIter(ud, code, size, address, insn);
 }
+
+CAPSTONE_INTERNAL size_t X86_disasmOneText32(csh ud, const uint8_t *code,
+				    size_t size, uint64_t address, cs_insn *insn)
+{
+#ifdef CS_DECODE_TRY_OUTPUT
+	if (X86_matchesTextMode(ud, CS_MODE_32))
+		return cs_disasm_one_core(ud, code, size, address, insn);
+#endif
+	size_t remaining = size;
+	return X86_disasmIter(ud, &code, &remaining, &address, insn) ?
+		       size - remaining :
+		       0;
+}
 #endif
diff --git a/cs_disasm_internal.h b/cs_disasm_internal.h
