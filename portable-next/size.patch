-	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
-	if (handle && handle->arch == CS_ARCH_X86 &&
-	    handle->mode == CS_MODE_64 && !handle->no_text)
+	if (X86_matchesTextMode(ud, CS_MODE_64))
 		return cs_disasm_iter_core(ud, code, size, address, insn);
 #endif
 	return X86_disasmIter32(ud, code, size, address, insn);
 }
+
+CAPSTONE_INTERNAL size_t X86_disasmOneText(csh ud, const uint8_t *code,
+				    size_t size, uint64_t address, cs_insn *insn)
+{
+#ifdef CS_DECODE_TRY_OUTPUT
+	if (X86_matchesTextMode(ud, CS_MODE_64))
+		return cs_disasm_one_core(ud, code, size, address, insn);
+#endif
+	return X86_disasmOneText32(ud, code, size, address, insn);
+}
 #endif
diff --git a/arch/X86/X86Vex32Output.c b/arch/X86/X86Vex32Output.c
