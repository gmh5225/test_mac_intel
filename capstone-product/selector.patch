diff --git a/arch/X86/X86OutputIterator.c b/arch/X86/X86OutputIterator.c
index 8c6444ab..c1160f37 100644
--- a/arch/X86/X86OutputIterator.c
+++ b/arch/X86/X86OutputIterator.c
@@ -13,7 +13,56 @@
 #include "X86SimpleOutput.h"
 #include "X86GenSimpleOutput.inc"
 
+#include "X86RegisterImmediateOutput.h"
+#include "X86ExtendRegisterOutput.h"
+
+/* A single operand-size prefix selects 32-bit registers in real mode.
+ * Register-only operations keep their generated i386 effects. The address
+ * size and encoded offsets belong to the original prefixed instruction. */
+static bool writeOperandOverride16(cs_struct *handle, const uint8_t *code,
+				   size_t size, cs_insn *insn, uint16_t *length)
+{
+	if (size < 3 || code[0] != X86_PREFIX_OPSIZE)
+		return false;
+	const unsigned opcode = code[1];
+	const bool mov = (opcode & 0xf8) == 0xb8;
+	const bool pair = (opcode < 0x40 && (opcode & 7) <= 3) ||
+			  (opcode >= 0x84 && opcode <= 0x8b);
+	if (mov ? size < 6 : (!pair || code[2] < 0xc0))
+		return false;
+	if (X86_OUTPUT_UNSUPPORTED(handle, handle->mode != CS_MODE_16))
+		return false;
+	const unsigned plan = x86_simple_plans[0][0][mov ? 0x8b : opcode];
+	const struct X86SimpleOutput *row = &x86_simple_outputs[plan >> 2];
+	if (mov) {
+		writeUnsignedRegisterImmediate(insn, row,
+					       &x86_simple_registers[2][opcode & 7],
+					       code, 0, 0, 2, 4, length);
+	} else {
+		const unsigned mr = code[2], reg = (mr >> 3) & 7, rm = mr & 7;
+		const bool reg_first = (plan & 3) == X86_SIMPLE_REG_RM;
+		const struct X86SimpleRegister *regs =
+			x86_simple_registers[(opcode & 1) ? 2 : 0];
+		writeExtendRegisters(code, 3, insn, length, row,
+				     &regs[reg_first ? reg : rm],
+				     &regs[reg_first ? rm : reg], 0, opcode,
+				     mr, false);
+	}
+	if (insn->detail) {
+		cs_x86 *x = &insn->detail->x86;
+		x->addr_size = 2;
+		x->prefix[2] = X86_PREFIX_OPSIZE;
+		if (mov)
+			x->opcode[0] = opcode;
+		else
+			x->encoding.modrm_offset = 2;
+	}
+	return true;
+}
+
+#define X86_OUTPUT_MISS writeOperandOverride16
 #include "X86SimpleOutputImpl.h"
+#undef X86_OUTPUT_MISS
 
