diff --git a/tests/unit/x86_legacy_address_size.c b/tests/unit/x86_legacy_address_size.c
index cfd13cba..3b436991 100644
--- a/tests/unit/x86_legacy_address_size.c
+++ b/tests/unit/x86_legacy_address_size.c
@@ -279,9 +279,56 @@ static bool check_other_opcodes(void)
 	return ok;
 }
 
+static bool check_absolute_offsets(void)
+{
+	static const struct {
+		cs_mode mode;
+		uint8_t code[8];
+		uint8_t size;
+		const char *intel, *att;
+	} cases[] = {
+		{ CS_MODE_16, { 0x67, 0x8b, 0x05, 0x34, 0x12, 0x00, 0x80 },
+		  7, "ax, word ptr [0x80001234]", "0x80001234, %ax" },
+		{ CS_MODE_32, { 0x67, 0x8b, 0x06, 0x34, 0x82 },
+		  5, "eax, dword ptr [0x8234]", "0x8234, %eax" },
+		{ CS_MODE_64, { 0x67, 0x8b, 0x04, 0x25, 0x34, 0x12, 0x00, 0x80 },
+		  8, "eax, dword ptr [0x80001234]", "0x80001234, %eax" },
+		{ CS_MODE_64, { 0x8b, 0x04, 0x25, 0x34, 0x12, 0x00, 0x80 },
+		  7, "eax, dword ptr [0xffffffff80001234]", "0xffffffff80001234, %eax" },
+	};
+	bool ok = true;
+	for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i) {
+		csh handle;
+		if (cs_open(CS_ARCH_X86, cases[i].mode, &handle) != CS_ERR_OK)
+			return false;
+		for (unsigned att = 0; att < 2; ++att) {
+			cs_err err = cs_option(handle, CS_OPT_SYNTAX,
+					       att ? CS_OPT_SYNTAX_ATT : CS_OPT_SYNTAX_INTEL);
+			if (att && err == CS_ERR_X86_ATT)
+				continue;
+			cs_insn *insn = NULL;
+			size_t count = cs_disasm(handle, cases[i].code, cases[i].size,
+						 0x1000, 1, &insn);
+			const char *expected = att ? cases[i].att : cases[i].intel;
+			if (err != CS_ERR_OK || count != 1 ||
+			    insn->size != cases[i].size ||
+			    strcmp(insn->op_str, expected) != 0) {
+				fprintf(stderr, "absolute offset mode %u: expected %s, got %s\n",
+					(unsigned)cases[i].mode, expected,
+					count == 1 ? insn->op_str : "(invalid)");
+				ok = false;
+			}
+			cs_free(insn, count);
+		}
+		cs_close(&handle);
+	}
+	return ok;
+}
+
 int main(void)
 {
 	bool ok = check_conversions();
 	ok &= check_other_opcodes();
+	ok &= check_absolute_offsets();
 	return ok ? 0 : 1;
 }
