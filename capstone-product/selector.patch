+def powerpc_name_index(directory):
+    _, names = alias_names(directory)
+    if not names or len(names) >= 1 << 16:
+        raise ValueError("PowerPC alias chains exceed 16-bit indices")
+    mask = (1 << (len(names).bit_length() - 1)) - 1
+    link_bits = len(names).bit_length()
+    if any(len(name) >= 1 << (16 - link_bits) for name, enum in names):
+        raise ValueError("PowerPC alias length and chain exceed one halfword")
+    heads = [0] * len(names)
+    successors = [0] * len(names)
+    # Insert in reverse order so duplicate spellings retain their first ID.
+    for index in reversed(range(len(names))):
+        value = 0
+        for byte in names[index][0]:
+            value = (value * 33 + byte) & mask
+        successors[index] = heads[value]
+        heads[value] = index + 1
+    lines = ["/* Generated by suite/synctools/alias_mnemonic_trie.py. */",
+             f"#define PPC_ALIAS_BUCKET_MASK {mask}",
+             f"#define PPC_ALIAS_CHAIN_BITS {link_bits}",
+             f"#define PPC_ALIAS_NEXT_MASK {(1 << link_bits) - 1}"]
+    for (name, enum), head, successor in zip(names, heads, successors):
+        lines.append(f'\t{{ PPC_INS_ALIAS_{enum}, {head}, {(len(name) << link_bits) | successor}, "{name.decode("ascii")}" }},')
+    lines.append("\t{ PPC_INS_ALIAS_END, 0, 0, NULL },")
+    return "\n".join(lines) + "\n"
+
