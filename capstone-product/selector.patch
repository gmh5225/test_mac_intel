diff --git a/arch/X86/X86ScanAdapter.h b/arch/X86/X86ScanAdapter.h
index 246ee26c..52c1b56d 100644
--- a/arch/X86/X86ScanAdapter.h
+++ b/arch/X86/X86ScanAdapter.h
@@ -10,6 +10,17 @@
 extern "C" {
 #endif
 
+#if defined(CAPSTONE_X86_ELF_ITERATOR) && defined(__ELF__) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && !defined(CAPSTONE_DIET) && \
+	!defined(CAPSTONE_X86_REDUCE) && !defined(CAPSTONE_HAS_OSXKERNEL) && \
+	!defined(_KERNEL_MODE) && !defined(_WIN32_WCE)
+#define X86_SHARED_ITERATOR_ENTRY
+/* The public symbol starts in the fixed reader. Its fallback must enter
+ * the generic iterator directly, including for foreign architectures. */
+bool X86_disasmIterGeneric(csh handle, const uint8_t **code, size_t *size,
+			   uint64_t *address, cs_insn *insn);
+#endif
+
 typedef struct X86ScanBatchResult {
