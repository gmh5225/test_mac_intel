diff --git a/arch/X86/X86Sse64Output.c b/arch/X86/X86Sse64Output.c
index 7afca7e4..3d424404 100644
--- a/arch/X86/X86Sse64Output.c
+++ b/arch/X86/X86Sse64Output.c
@@ -276,10 +276,22 @@ CAPSTONE_INTERNAL bool X86_disasmIterText(csh ud, const uint8_t **code,
 {
 #ifdef CS_DECODE_TRY_OUTPUT
 	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+#ifdef X86_SHARED_ITERATOR_ENTRY
+	if (!handle || handle->arch != CS_ARCH_X86 || handle->no_text)
+		return X86_disasmIterGeneric(ud, code, size, address, insn);
+	if (handle->mode == CS_MODE_64)
+#else
 	if (handle && handle->arch == CS_ARCH_X86 &&
 	    handle->mode == CS_MODE_64 && !handle->no_text)
+#endif
 		return cs_disasm_iter_core(ud, code, size, address, insn);
 #endif
 	return X86_disasmIter32(ud, code, size, address, insn);
 }
+#ifdef X86_SHARED_ITERATOR_ENTRY
+/* These two interfaces share cursor, skipdata and detail-pointer ownership. */
+extern __typeof__(X86_disasmIterText) cs_disasm_iter
+	__attribute__((alias("X86_disasmIterText"), visibility("default")));
+#endif
+
 #endif
