+def reuse_direct_slots(ids, maps):
+    """Reuse inlined UID slots for a trailing run of indexed decision rows.
+
+    Preserve the offsets of all earlier indexed rows. Their contents can be
+    looked up by other maps even when a direct decision overlaps a row.
+    """
+    lengths = {"MODRM_ONEENTRY": 1, "MODRM_SPLITRM": 2, "MODRM_SPLITREG": 16,
+               "MODRM_SPLITMISC": 72, "MODRM_FULL": 256}
+    direct = {"MODRM_ONEENTRY", "MODRM_SPLITRM"}
+    entries = {(kind, offset) for _, _, rows in maps for row in rows
+               for kind, offset in row}
+    end = max(offset + lengths[kind] for kind, offset in entries)
+    limit = max(offset + lengths[kind] for kind, offset in entries if kind in direct)
+    require(end <= len(ids), "Indexed UID row exceeds the source table")
+    if end == limit:
+        return ids, {}
+
+    occupied = bytearray(limit)
+    occupied[0] = 1
+    for kind, offset in entries:
+        if kind not in direct and offset < limit:
+            stop = offset + lengths[kind]
+            if stop > limit:
+                return ids, {}
+            occupied[offset:stop] = bytes([1]) * lengths[kind]
+
+    output = list(ids[:limit])
+    replacements = {}
+    for kind, offset in sorted(entries, key=lambda entry: (entry[1], entry[0])):
+        if offset < limit:
+            continue
+        size = lengths[kind]
+        start = occupied.find(bytes(size))
+        if start < 0:
+            return ids, {}
+        occupied[start:start + size] = bytes([1]) * size
+        output[start:start + size] = ids[offset:offset + size]
+        replacements[kind, offset] = start
+    output.extend(ids[end:])
+    return tuple(output), replacements
+
