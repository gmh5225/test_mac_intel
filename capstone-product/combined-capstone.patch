+		if (size < 4)
+			return 0;
+		const unsigned modrm = code[3];
+		end = 4;
+		if (modrm < 0xc0) {
+			const unsigned mod = modrm >> 6, rm = modrm & 7;
+			static const uint8_t extra[3][8] = {
+				{ 0, 0, 0, 0, 1, 4, 0, 0 },
+				{ 1, 1, 1, 1, 2, 1, 1, 1 },
+				{ 4, 4, 4, 4, 5, 4, 4, 4 }
+			};
+			if ((modrm & 0xc7) == 4) {
+				if (end >= size)
+					return 0;
+				if ((code[end] & 7) == 5)
+					end += 4;
+			}
+			end += extra[mod][rm];
+		}
+	}
+	end += plan & 1;
+	if (end > size)
+		return 0;
+	return ((plan >> 3) << 8) | end;
