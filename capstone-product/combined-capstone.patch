+static bool check_extend32(csh handles[2])
+{
+	for (unsigned op = 0xb6; op <= 0xbf; ++op) {
+		if ((op & 0xf6) != 0xb6)
+			continue;
+		for (unsigned mr = 0; mr <= 0xff; ++mr) {
+			for (unsigned sib = 0; sib < 256;
+			     sib += (mr & 7) == 4 ? 1 : 256) {
+				const uint8_t b[] = { 0x0f,	   (uint8_t)op,
+						      (uint8_t)mr, (uint8_t)sib,
+						      0x80,	   0x12,
