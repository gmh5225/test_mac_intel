+				unsigned seed = op + mr + sib;
+				if (!compare(handles, b, sizeof(b), seed) ||
+				    !compare(handles, b, seed % sizeof(b),
+					     seed))
+					return false;
+			}
+		}
+	}
+	return true;
+}
