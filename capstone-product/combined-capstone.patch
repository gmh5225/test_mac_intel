+static bool writeExtend32(const uint8_t *code, size_t size, cs_insn *insn,
+			  uint16_t *insn_size)
+{
+	const uint8_t opcode = code[1], mr = code[2];
+	const struct X86SimpleOutput *row =
+		&x86_extend32[(opcode & 1) | ((opcode & 8) >> 2)];
