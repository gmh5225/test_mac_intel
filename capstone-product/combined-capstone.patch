+void emit_extend32(Decoder &decoder, const RegisterTable &regs)
+{
+	X86SimpleRegister words[8]{};
+	std::cout
+		<< "/* Generated by x86_simple_output.cpp --extend32. */\n"
+		<< "static const struct X86SimpleRegister x86_extend32_words[8] = {\n";
+	for (unsigned i = 0; i < 8; ++i) {
+		const uint8_t code[] = { 0x0f, 0xb7, uint8_t(0xc0 + i) };
+		decoder.decode(code, sizeof(code), sizeof(code), 0);
+		const auto &src = decoder.insn->detail->x86.operands[1];
+		const char *name = cs_reg_name(decoder.handle, src.reg);
+		if (src.type != X86_OP_REG || src.size != 2 || !name ||
+		    strlen(name) >= sizeof(words[i].name))
+			throw std::runtime_error(
+				"invalid canonical 16-bit source");
+		words[i].reg = src.reg;
+		words[i].length = uint8_t(strlen(name));
+		strcpy(words[i].name, name);
+		std::cout << "\t{ " << unsigned(src.reg) << ", " << strlen(name)
+			  << ", \"" << name << "\" },\n";
+	}
+	std::cout
+		<< "};\nstatic const struct X86SimpleOutput x86_extend32[4] = {\n";
+	for (uint8_t opcode : { 0xb6, 0xb7, 0xbe, 0xbf }) {
+		CheckedRow row;
+		for (unsigned reg = 0; reg < 8; ++reg) {
+			for (unsigned rm = 0; rm < 8; ++rm) {
+				const uint8_t mr =
+					uint8_t(0xc0 | reg << 3 | rm);
+				const uint8_t code[] = { 0x0f, opcode, mr };
+				decoder.decode(code, sizeof(code), sizeof(code),
+					       0);
+				const auto &src =
+					(opcode & 1 ? words : regs[0])[rm];
+				row.observe(describe(*decoder.insn, opcode, 0,
+						     mr, &regs[2][reg], &src,
+						     false, false, true));
+			}
+			const uint8_t mr = uint8_t(reg << 3);
+			const uint8_t mem[] = { 0x0f, opcode, mr };
+			decoder.decode(mem, sizeof(mem), sizeof(mem), 0);
+			row.observe(describe(*decoder.insn, opcode, 0, mr,
+					     nullptr, nullptr, false, true,
+					     true));
+		}
+		if (row.encodings != 72)
+			throw std::runtime_error(
+				"inconsistent i386 extension operands");
+		std::cout << "\t" << row.fields << ",\n";
+	}
+	std::cout << "};\n";
+}
