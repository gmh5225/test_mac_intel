diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3df7e6d898..ed98892588 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -107,6 +107,11 @@ set(CAPSTONE_X86_SUPPORT       ON  CACHE BOOL "" FORCE)
 set(CAPSTONE_ARM_SUPPORT        ON  CACHE BOOL "" FORCE)
 set(CAPSTONE_AARCH64_SUPPORT    ON  CACHE BOOL "" FORCE)
 set(CAPSTONE_MIPS_SUPPORT       ON  CACHE BOOL "" FORCE)
+# In the static Linux Clang decoder, most MIPS mnemonics skip alias lookup.
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_C_COMPILER_ID STREQUAL "Clang"
+   AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
+    set(CAPSTONE_MIPS_PRECHECK_PRINTED_ALIAS ON)
+endif()
 add_subdirectory(third_party/capstone)
 
 # Capstone's decode DFA is the single hottest dependency in the front end, so
diff --git a/lib/decode/CMakeLists.txt b/lib/decode/CMakeLists.txt
index f0120e421c..678ea2a40f 100644
--- a/lib/decode/CMakeLists.txt
+++ b/lib/decode/CMakeLists.txt
@@ -27,7 +27,9 @@ target_include_directories(NeverDDecode PRIVATE
 
 # Resolve the ordinary x86 text fallback in the first static archive pass.
 if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
-  target_link_options(NeverDDecode INTERFACE "LINKER:--undefined=X86_disasmIter")
+  # Resolve both fallback and i386 before the amd64 member brings in its helpers.
+  target_link_options(NeverDDecode INTERFACE
+    "LINKER:--undefined=X86_disasmIter" "LINKER:--undefined=X86_disasmIter32")
 endif()
 
