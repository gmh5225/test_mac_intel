+				auto observe = [&](uint8_t mr,
+						   const X86SimpleRegister *src) {
+					uint8_t code[4];
+					unsigned n = 0;
+					if (rex)
+						code[n++] = rex;
+					if (escaped)
+						code[n++] = 0x0f;
+					code[n++] = opcode;
+					code[n++] = mr;
+					decoder.decode(code, n, n, 0);
+					const auto *dest =
+						src ? &regs[form >= 4 ? 3 : 2]
+							   [((rex & 4) << 1) |
+							    reg] :
+						      nullptr;
+					auto fields = describe(*decoder.insn,
+							       opcode, rex, mr,
+							       dest, src, false,
+							       !src, escaped);
+					if (fields.empty() ||
+					    (row.encodings &&
+					     fields != row.fields)) {
+						std::cerr
+							<< "unexpected widening record for form "
+							<< form << ", REX "
+							<< unsigned(rex)
+							<< ", ModRM "
+							<< unsigned(mr) << ": "
+							<< decoder.insn->mnemonic
+							<< " "
+							<< decoder.insn->op_str
+							<< " (canonical "
+							<< fields << ", prior "
+							<< row.fields << ")\n";
+					}
+					row.observe(fields);
+				};
+				for (unsigned rm = 0; rm < 8; ++rm) {
+					const unsigned i = ((rex & 1) << 3) |
+							   rm;
+					const auto *src =
+						!escaped     ? regs[2] :
+						(opcode & 1) ? words :
+							       regs[rex != 0];
+					observe(uint8_t(0xc0 | reg << 3 | rm),
+						&src[i]);
+				}
+				observe(uint8_t(reg << 3), nullptr);
+			}
+		}
+		if (row.encodings != (form < 4 ? 9u : 8u) * 72)
+			throw std::runtime_error(
+				"incomplete amd64 widening coverage");
+		std::cout << "\t" << row.fields << ",\n";
+	}
+	std::cout << "};\n";
+}
