+				bytes[n++] = (uint8_t)(mr & 8 ? 0x25 : 0xa3);
+				bytes[n++] = 0x80;
+				bytes[n++] = 0xfe;
+				bytes[n++] = 0xff;
+				bytes[n++] = 0xff;
