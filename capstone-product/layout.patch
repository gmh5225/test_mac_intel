diff --git a/suite/synctools/riscv_gpr_names.py b/suite/synctools/riscv_gpr_names.py
new file mode 100644
index 00000000..1ecd3d23
--- /dev/null
+++ b/suite/synctools/riscv_gpr_names.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""Project short integer-register spellings from the RISC-V assembly writer."""
+
+import argparse
+import json
+from pathlib import Path
+import re
+
+
+def table(source, declaration):
+    match = re.search(r"\b" + declaration + r"\[\]\s*=\s*\{([^}]+)\};", source)
+    if not match:
+        raise ValueError("Missing generated register table " + declaration)
+    return match[1]
+
+
+def register_names(writer, registers, suffix):
+    pool = bytearray()
+    for position, name in re.findall(r'/\*\s*(\d+)\s*\*/\s*"([^"\\]*)\\0"', table(writer, "AsmStrs" + suffix)):
+        if int(position) != len(pool):
+            raise ValueError("Unexpected generated string offset")
+        pool.extend(name.encode("ascii") + b"\0")
+    offsets = [int(x.strip()) for x in table(writer, "RegAsmOffset" + suffix).split(",") if x.strip()]
+    result = []
+    for reg in registers:
+        start = offsets[reg - 1]
+        result.append(pool[start:pool.index(0, start)].decode("ascii"))
+    return result
+
+
+def render(writer, enums):
+    registers = dict((int(n), int(v)) for n, v in re.findall(r"\bRISCV_X(\d+)\s*=\s*(\d+),", enums))
+    ids = [registers[i] for i in range(32)]
+    if ids != list(range(ids[0], ids[0] + 32)):
+        raise ValueError("Integer register IDs must be contiguous")
+    numeric = register_names(writer, ids, "NoRegAltName")
+    abi = [s or numeric[i] for i, s in enumerate(register_names(writer, ids, "ABIRegAltName"))]
+    width = 1 + max(map(len, numeric + abi))
+    if width > 8 or not all(abi) or not all(numeric):
+        raise ValueError("Expected short nonempty integer register names")
+    lines = [
+        "/* Generated by suite/synctools/riscv_gpr_names.py. */",
+        "struct RISCVGPRName {",
+        f"\tchar text[{width}];",
+        "\tuint8_t length;",
+        "};",
+        "static const struct RISCVGPRName riscv_gpr_names[2][32] = {",
+    ]
+    for names in (abi, numeric):
+        lines.append("\t{")
+        lines.extend(f"\t\t{{ {json.dumps(name)}, {len(name)} }}," for name in names)
+        lines.append("\t},")
+    return "\n".join([*lines, "};", ""])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    directory = Path(__file__).resolve().parents[2] / "arch" / "RISCV"
+    generated = render((directory / "RISCVGenAsmWriter.inc").read_text(),
+                       (directory / "RISCVGenRegisterInfo.inc").read_text())
+    output = directory / "RISCVGenGPRNames.inc"
+    if args.check:
+        if output.read_text() != generated:
+            parser.exit(1, f"Regenerate {output.name}\n")
+    else:
+        output.write_text(generated)
+
+
+if __name__ == "__main__":
+    main()
