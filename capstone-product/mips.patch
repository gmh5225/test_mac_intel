+			opcode = Mips_SLTi;
+			break;
+		case 11:
+			opcode = Mips_SLTiu;
+			break;
+		case 32:
+			opcode = Mips_LB;
+			break;
+		case 33:
+			opcode = Mips_LH;
+			break;
+		case 36:
+			opcode = Mips_LBu;
+			break;
+		case 37:
+			opcode = Mips_LHu;
+			break;
+		case 40:
+			opcode = Mips_SB;
+			break;
+		case 41:
+			opcode = Mips_SH;
+			break;
+#endif
 		case 9:
 			opcode = Mips_ADDiu;
 			break;
