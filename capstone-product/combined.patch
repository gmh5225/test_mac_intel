new file mode 100644
index 00000000..ccbbb254
--- /dev/null
+++ b/tests/unit/mips_nanomips_branch.c
@@ -0,0 +1,78 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include <stdio.h>
+#include <capstone/capstone.h>
+
+/* The 110110 pool encodes JRC/JALRC when u == 0, and BEQC/BNEC
+ * otherwise (nanoMIPS32 ISA, BEQC[16] and BNEC[16]). */
+static int check_pool(cs_mode mode, bool nms, bool big_endian, bool text,
+		      bool detail)
+{
+	csh handle;
+	if (cs_open(CS_ARCH_MIPS, mode, &handle) != CS_ERR_OK)
+		return 1;
+	cs_option(handle, CS_OPT_TEXT, text ? CS_OPT_ON : CS_OPT_OFF);
+	cs_option(handle, CS_OPT_DETAIL, detail ? CS_OPT_ON : CS_OPT_OFF);
+	cs_insn *insn = cs_malloc(handle);
+	if (!insn) {
+		cs_close(&handle);
+		return 1;
+	}
+
+	int failures = 0;
+	for (unsigned bits = 0; bits < 1024; ++bits) {
+		const unsigned word = 0xd800 | bits;
+		uint8_t bytes[2];
+		bytes[big_endian ? 0 : 1] = (uint8_t)(word >> 8);
+		bytes[big_endian ? 1 : 0] = (uint8_t)word;
+		const uint8_t *cursor = bytes;
+		size_t left = sizeof(bytes);
+		uint64_t ip = 0x1000;
+		const bool decoded =
+			cs_disasm_iter(handle, &cursor, &left, &ip, insn);
+		const unsigned offset = bits & 15;
+		const unsigned rs = (bits >> 4) & 7, rt = (bits >> 7) & 7;
+		const bool expected = !offset || !nms;
+		const unsigned id =
+			offset ? (rs < rt ? MIPS_INS_BEQC : MIPS_INS_BNEC) :
+				 (rs & 1 ? MIPS_INS_JALRC : MIPS_INS_JRC);
+		if (decoded != expected || left != (expected ? 0u : 2u) ||
+		    cursor != bytes + (expected ? 2 : 0) ||
+		    ip != (expected ? 0x1002u : 0x1000u) ||
+		    (decoded && (insn->size != 2 || insn->id != id))) {
+			if (!failures)
+				fprintf(stderr,
+					"nanoMIPS mode %x, word %04x, expected %s id %u, got %s id %u\n",
+					(unsigned)mode, word,
+					expected ? "decoded" : "invalid", id,
+					decoded ? "decoded" : "invalid",
+					decoded ? insn->id : 0);
+			++failures;
+		}
+	}
+	cs_free(insn, 1);
+	cs_close(&handle);
+	return failures;
+}
+
+int main(void)
+{
+	const cs_mode modes[] = { CS_MODE_NANOMIPS, CS_MODE_NMS1,
+				  CS_MODE_I7200 };
+	int failures = 0;
+	for (size_t i = 0; i < sizeof(modes) / sizeof(modes[0]); ++i) {
+		for (unsigned flags = 0; flags < 8; ++flags) {
+			const bool big = (flags & 1) != 0;
+			cs_mode mode =
+				(cs_mode)(modes[i] |
+					  (big ? CS_MODE_BIG_ENDIAN : 0));
+			failures += check_pool(mode, modes[i] == CS_MODE_NMS1,
+					       big, (flags & 2) != 0,
+					       (flags & 4) != 0);
+		}
+	}
+	printf("%d mismatches in 24576 nanoMIPS compact-branch observations\n",
+	       failures);
+	return failures != 0;
+}
