+/* A 66 prefix selects the XMM form of these legacy integer moves even
+ * when the default operand size is 16 bits. */
+X86_DECODE_INLINE bool hasIntegerMoveOpcodePrefix(
+	const struct InternalInstruction *insn)
+{
+	if (insn->opcodeType != TWOBYTE || insn->repeatPrefix)
+		return false;
+	switch (insn->opcode) {
+	case 0x6e: /* MOVD to XMM */
+	case 0x7e: /* MOVD from XMM */
+	case 0x6f: /* MOVDQA load */
+	case 0x7f: /* MOVDQA store */
+	case 0xd6: /* MOVQ from XMM */
+		return true;
+	default:
+		return false;
+	}
+}
