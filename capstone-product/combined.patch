diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 12428fff..e38dfd51 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3787,12 +3787,65 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 	return true;
 }
 
+#ifdef CAPSTONE_X86_PUBLIC_OUTPUT
+/* Only scan calls need the scan decoder's stack frame and mapping state. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static bool disasmScanIterator(cs_struct *handle, const uint8_t **code,
+			       size_t *size, uint64_t *address, cs_insn *insn)
+{
+	return cs_disasm_iter_valid(handle, code, size, address, insn, true);
+}
+#endif
+
 CAPSTONE_EXPORT
 X86_DECODE_ALIGN
 bool CAPSTONE_API cs_disasm_iter(csh ud, const uint8_t **code, size_t *size,
 				 uint64_t *address, cs_insn *insn)
 {
+#ifdef CAPSTONE_X86_PUBLIC_OUTPUT
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (*size == 0 || !handle)
+		return false;
+	if (handle->arch == CS_ARCH_X86) {
+		if (!handle->no_text) {
+			if (handle->mode == CS_MODE_64)
+				return X86_disasmIterText(ud, code, size, address, insn);
+			if (handle->mode == CS_MODE_32)
+				return X86_disasmIter32(ud, code, size, address, insn);
+#ifndef CAPSTONE_X86_DEDICATED_OUTPUT
+			return X86_disasmIter(ud, code, size, address, insn);
+#endif
+		} else if (!handle->detail_opt) {
+#ifndef CAPSTONE_X86_SCAN_ADAPTER
+			if ((handle->mode == CS_MODE_32 || handle->mode == CS_MODE_64) &&
+			    handle->insn_id == X86_get_insn_id &&
+			    handle->disasm == X86_getInstruction) {
+				const uint32_t word = X86_readScanWord(
+					*code, *size, handle->mode == CS_MODE_64);
+				if (word) {
+					const X86ScanResult result = {
+						0, word >> 8, (uint16_t)(word & 0xff), 0
+					};
+					handle->errnum = CS_ERR_OK;
+					insn->address = *address;
+					finish_x86_scan(handle, insn, &result,
+							*code, false, true);
+					advance_iter(code, size, address, result.length);
+					return true;
+				}
+			}
+#endif
+			return disasmScanIterator(handle, code, size, address, insn);
+		}
+	}
+	return cs_disasm_iter_valid(handle, code, size, address, insn, false);
+#else
 	return cs_disasm_iter_core(ud, code, size, address, insn);
+#endif
 }
 
 X86_DECODE_ALIGN
