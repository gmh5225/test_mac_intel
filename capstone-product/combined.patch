index 183605d1..27517fde 100644
--- a/suite/synctools/x86_vector_output.cpp
+++ b/suite/synctools/x86_vector_output.cpp
@@ -1157,6 +1157,226 @@ void emit_evex_memory(Decoder &decoder)
