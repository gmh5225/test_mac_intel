+				if (it == rows.end())
+					rows.push_back(row);
+			}
+			const auto it =
+				std::find(prefixes.begin(), prefixes.end(), p);
+			plans[wide][opcode] = unsigned(it - prefixes.begin());
+			if (it == prefixes.end())
