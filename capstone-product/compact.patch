+		const unsigned rxb = ((reg >> 3) << 2) | xbit | (rm >> 3);
+		const unsigned ids[] = { reg, src, rm };
+		VexRegisterOperand selected[3]{};
+		for (unsigned i = 0; i < reg_count; ++i) {
+			const unsigned bank = operands[i] & 3;
+			selected[i] = { banks[bank][ids[operands[i] >> 2]],
+					uint8_t(widths[bank]) };
+		}
