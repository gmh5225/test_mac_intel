     # Use cached access IDs and bounded masked-operand copies in the x86-64 static reader.
     if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
         set_property(SOURCE arch/X86/X86Mapping.c APPEND PROPERTY
diff --git a/SStream.c b/SStream.c
index 5d387fb0..582598e9 100644
--- a/SStream.c
+++ b/SStream.c
@@ -18,6 +18,10 @@
 #include "cs_priv.h"
 #include "utils.h"
 
+#ifdef CS_SSTREAM_PERCENT_STRING
+const char SStream_percent_string_format[] = "%%%s";
+#endif
+
 #ifndef CAPSTONE_DIET
 static size_t SStream_remaining(SStream *ss)
 {
@@ -327,6 +331,25 @@ void SStream_concat(SStream *ss, const char *fmt, ...)
 	}
 
 	va_start(ap, fmt);
+#if defined(CS_SSTREAM_PERCENT_STRING) && defined(CAPSTONE_USE_SYS_DYN_MEM) && !defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && !defined(_WIN32_WCE)
+	/* Use the same stream bounds and markup handling as the general formatter. */
+	if (fmt == SStream_percent_string_format && cs_vsnprintf == cs_default_vsnprintf) {
+		const char *name = va_arg(ap, const char *);
+		va_end(ap);
+		if (name) {
+			char *out = ss->buffer + ss->index;
+			const char *limit = out + remaining;
+			*out++ = '%';
+			while (out != limit && *name)
+				*out++ = *name++;
+			*out = '\0';
+			ss->index = (size_t)(out - ss->buffer);
+			SStream_close_markup(ss);
+			return;
+		}
+		va_start(ap, fmt);
+	}
+#endif
 	ret = cs_vsnprintf(ss->buffer + ss->index, remaining + 1, fmt, ap);
 	va_end(ap);
 	if (ret < 0) {
diff --git a/SStream.h b/SStream.h
