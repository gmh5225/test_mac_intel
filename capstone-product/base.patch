diff --git a/arch/ARM/ARMFormattedChar.c b/arch/ARM/ARMFormattedChar.c
new file mode 100644
index 00000000..588a22f2
--- /dev/null
+++ b/arch/ARM/ARMFormattedChar.c
@@ -0,0 +1,21 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include "ARMMapping.h"
+
+#ifdef ARM_FORMATTED_CHAR_CALL
+/* The printer supplies "%s" and one NUL-terminated, single-character
+ * string at every call. A custom formatter receives these same arguments. */
+__attribute__((section(".cs_arm_formatted_char")))
+void ARM_formatChar(SStream *O, const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	const char *literal = va_arg(args, const char *);
+	va_end(args);
+	if (cs_vsnprintf == cs_default_vsnprintf)
+		SStream_concat1(O, literal[0]);
+	else
+		SStream_concat(O, fmt, literal);
+}
+#endif
diff --git a/arch/ARM/ARMMapping.h b/arch/ARM/ARMMapping.h
index d6833e63..66d2fa9c 100644
--- a/arch/ARM/ARMMapping.h
+++ b/arch/ARM/ARMMapping.h
@@ -36,6 +36,13 @@ static inline void ARM_printFormattedChar(SStream *O, const char *literal)
 	}
 	SStream_concat(O, "%s", literal);
 }
+#elif defined(CAPSTONE_ARM_FORMAT_PUNCTUATION_X64) && !defined(CAPSTONE_DIET) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && !defined(CAPSTONE_HAS_OSXKERNEL) && \
+	!defined(_KERNEL_MODE) && !defined(_WIN32_WCE) && defined(__linux__) && \
+	defined(__clang__) && defined(__x86_64__)
+#define ARM_FORMATTED_CHAR_CALL
+CAPSTONE_INTERNAL void ARM_formatChar(SStream *O, const char *fmt, ...);
+#define ARM_printFormattedChar(O, literal) ARM_formatChar((O), "%s", (const char *)(literal))
 #else
 #define ARM_printFormattedChar(O, literal) SStream_concat((O), "%s", (literal))
 #endif
