+static void get_op_access(cs_struct *h, unsigned int id, uint8_t *access,
+			  uint64_t *eflags)
+{
+	uint64_t ordered = get_att_access(h, id, eflags);
+	for (unsigned i = 0; i < CS_X86_MAXIMUM_OPERAND_SIZE; ++i) {
+		access[i] = (uint8_t)ordered;
+		ordered >>= 8;
 	}
 }
 
