diff --git a/tests/unit/x86_vex_ifma.c b/tests/unit/x86_vex_ifma.c
new file mode 100644
index 00000000..d646f463
--- /dev/null
+++ b/tests/unit/x86_vex_ifma.c
@@ -0,0 +1,137 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include <capstone/capstone.h>
+#include <stdio.h>
+#include <string.h>
+
+static bool check_form(csh handle, cs_mode mode, bool att, bool high, bool wide,
+		       bool memory, bool scan)
+{
+	/* The memory form has an ordinary negative disp8, even for YMM. */
+	uint8_t bytes[] = { 0xc4, 0xe2, 0xf1, 0xb4, 0xd8, 0xfd };
+	const size_t length = memory ? sizeof(bytes) : sizeof(bytes) - 1;
+	const x86_reg first = wide ? X86_REG_YMM0 : X86_REG_XMM0;
+	const x86_insn id = high ? X86_INS_VPMADD52HUQ : X86_INS_VPMADD52LUQ;
+	const uint8_t *cursor = bytes;
+	size_t left = length;
+	uint64_t address = 0x1000;
+	cs_insn *insn = cs_malloc(handle);
+	if (!insn)
+		return false;
+	if (wide)
+		bytes[2] |= 4;
+	if (high)
+		++bytes[3];
+	if (memory)
+		bytes[4] = 0x5e; // [rsi/esi/bp - 3]
+	bool decoded = cs_disasm_iter(handle, &cursor, &left, &address, insn);
+	bool ok = decoded && insn->id == id && insn->size == length &&
+		  left == 0 && address == 0x1000 + length;
+	if (cs_support(CS_SUPPORT_X86_REDUCE)) {
+		ok = !decoded;
+	} else if (ok && !scan && !cs_support(CS_SUPPORT_DIET)) {
+		const cs_x86 *x = &insn->detail->x86;
+		const cs_x86_op *dst = &x->operands[att ? 2 : 0];
+		const cs_x86_op *src = &x->operands[1];
+		const cs_x86_op *rm = &x->operands[att ? 0 : 2];
+		const unsigned width = wide ? 32 : 16;
+		ok = !strcmp(insn->mnemonic,
+			     high ? "vpmadd52huq" : "vpmadd52luq") &&
+		     x->op_count == 3 && dst->type == X86_OP_REG &&
+		     dst->reg == first + 3 && dst->access == CS_AC_READ_WRITE &&
+		     src->type == X86_OP_REG && src->reg == first + 1 &&
+		     src->access == CS_AC_READ && rm->access == CS_AC_READ &&
+		     dst->size == width && src->size == width &&
+		     rm->size == width && x->encoding.modrm_offset == 4 &&
+		     x->eflags == 0;
+		if (memory) {
+			x86_reg base = mode == CS_MODE_64 ? X86_REG_RSI :
+				       mode == CS_MODE_32 ? X86_REG_ESI :
+							    X86_REG_BP;
+			ok = ok && rm->type == X86_OP_MEM &&
+			     rm->mem.base == base && rm->mem.disp == -3 &&
+			     x->disp == -3 && x->encoding.disp_offset == 5 &&
+			     x->encoding.disp_size == 1;
+		} else {
+			ok = ok && rm->type == X86_OP_REG && rm->reg == first &&
+			     x->encoding.disp_size == 0;
+		}
+		cs_regs read, written;
+		uint8_t nr, nw;
+		ok = ok &&
+		     cs_regs_access(handle, insn, read, &nr, written, &nw) ==
+			     CS_ERR_OK &&
+		     nr == 3 && nw == 1 && written[0] == dst->reg;
+	}
+	if (!ok)
+		fprintf(stderr,
+			"mode=%u att=%d high=%d wide=%d mem=%d scan=%d\n",
+			(unsigned)mode, att, high, wide, memory, scan);
+	cs_free(insn, 1);
+	return ok;
+}
+
+static bool check_invalid(csh handle)
+{
+	static const struct {
+		uint8_t bytes[6], length;
+	} invalid[] = {
+		{ { 0xc4, 0xe2, 0x75, 0xb4, 0x1e }, 5 }, // W=0
+		{ { 0xc4, 0xe2, 0xf6, 0xb5, 0xd8 }, 5 }, // pp=F3
+		{ { 0x66, 0xc4, 0xe2, 0xf5, 0xb4, 0x1e }, 6 },
+		{ { 0xc4, 0xe2, 0xf5, 0xb4 }, 4 }, // missing ModR/M
+		{ { 0xc4, 0xe2, 0xf1, 0xb4, 0x5e }, 5 }, // missing disp8
+	};
+	for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i) {
+		cs_insn *insn;
+		size_t count = cs_disasm(handle, invalid[i].bytes,
+					 invalid[i].length, 0x1000, 1, &insn);
+		if (count) {
+			cs_free(insn, count);
+			fprintf(stderr,
+				"unexpectedly decoded invalid IFMA case %zu\n",
+				i);
+			return false;
+		}
+	}
+	return true;
+}
+
+int main(void)
+{
+	const cs_mode modes[] = { CS_MODE_16, CS_MODE_32, CS_MODE_64 };
+	for (size_t m = 0; m < 3; ++m) {
+		csh handle;
+		if (cs_open(CS_ARCH_X86, modes[m], &handle) != CS_ERR_OK)
+			return 1;
+		for (unsigned pass = 0; pass < 3; ++pass) {
+			const bool scan = pass == 2, att = pass == 1;
+			cs_err err = cs_option(handle, CS_OPT_SYNTAX,
+					       att ? CS_OPT_SYNTAX_ATT :
+						     CS_OPT_SYNTAX_INTEL);
+			if (att && cs_support(CS_SUPPORT_DIET)) {
+				if (err != CS_ERR_DIET)
+					return 1;
+				continue;
+			}
+			if (att && err == CS_ERR_X86_ATT)
+				continue;
+			if (err ||
+			    cs_option(handle, CS_OPT_DETAIL,
+				      scan ? CS_OPT_OFF : CS_OPT_ON) ||
+			    cs_option(handle, CS_OPT_TEXT,
+				      scan ? CS_OPT_OFF : CS_OPT_ON))
+				return 1;
+			if (!check_invalid(handle))
+				return 1;
+			for (unsigned form = 0; form < 8; ++form) {
+				if (!check_form(handle, modes[m], att, form & 1,
+						form & 2, form & 4, scan))
+					return 1;
+			}
+		}
+		cs_close(&handle);
+	}
+	return 0;
+}
