+++ b/arch/Mips/MipsInstPrinter.c
@@ -270,8 +270,11 @@ void Mips_LLVM_printInst(MCInst *MI, uint64_t Address, SStream *O)
 {
 	bool useAliasDetails = map_use_alias_details(MI);
 	if (!useAliasDetails) {
-		SStream_Close(O);
-		printInstruction(MI, Address, O);
