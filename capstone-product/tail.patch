+static bool test_detail_modifiers(cs_arch arch, cs_mode mode,
+				  const uint8_t *code, size_t size,
+				  size_t detail_size)
+{
+	if (!cs_support(arch))
+		return true;
+	csh handle;
+	if (cs_open(arch, mode, &handle) != CS_ERR_OK)
+		return false;
+	bool ok = true;
+	for (unsigned flags = 2; ok && flags < 16; flags += 2) {
+		cs_option(handle, CS_OPT_DETAIL, CS_OPT_OFF);
+		cs_option(handle, CS_OPT_DETAIL, flags | CS_OPT_ON);
+		cs_insn *expected = NULL;
+		if (cs_disasm(handle, code, size, 0x1000, 1, &expected) != 1) {
+			ok = false;
+			break;
+		}
+		cs_option(handle, CS_OPT_DETAIL, CS_OPT_OFF);
+		cs_option(handle, CS_OPT_DETAIL, flags);
+		cs_insn *actual = cs_malloc(handle);
+		ok = actual && actual->detail && expected->detail;
+		if (ok) {
+			// Reusing a record must clear counts from its last instruction.
+			memset(actual->detail, 0, sizeof(*actual->detail));
+			actual->detail->groups_count = 1;
+			const uint8_t *cursor = code;
+			size_t left = size;
+			uint64_t address = 0x1000;
+			ok = cs_disasm_iter(handle, &cursor, &left, &address,
+					    actual) &&
+			     left == 0 && actual->id == expected->id &&
+			     actual->alias_id == expected->alias_id &&
+			     actual->usesAliasDetails ==
+				     expected->usesAliasDetails &&
+			     !memcmp(actual->detail, expected->detail,
+				     detail_size);
+		}
+		if (!ok)
+			fprintf(stderr,
+				"Detail modifiers: arch=%u flags=0x%x\n",
+				(unsigned)arch, flags);
+		if (actual)
+			cs_free(actual, 1);
+		cs_free(expected, 1);
+	}
+	cs_close(&handle);
+	return ok;
+}
+
 int main()
 {
 	bool result = true;
 	result &= test_cs_mem_setup_fail();
 	result &= test_iterator_allocation();
 	result &= test_iterator_results();
+	static const uint8_t bl[] = { 0x00, 0x00, 0x00, 0x94 };
+	static const uint8_t mov[] = { 0x01, 0x00, 0xa0, 0xe1 };
+	static const uint8_t addiu[] = { 0x01, 0x00, 0x82, 0x24 };
+	static const uint8_t c_nop[] = { 0x01, 0x00 };
+	result &= test_detail_modifiers(
+		CS_ARCH_AARCH64, CS_MODE_ARM, bl, sizeof(bl),
+		offsetof(cs_detail, aarch64) + sizeof(cs_aarch64));
+	result &= test_detail_modifiers(
+		CS_ARCH_ARM, CS_MODE_ARM, mov, sizeof(mov),
+		offsetof(cs_detail, arm) + sizeof(cs_arm));
+	result &= test_detail_modifiers(
+		CS_ARCH_MIPS, CS_MODE_MIPS32, addiu, sizeof(addiu),
+		offsetof(cs_detail, mips) + sizeof(cs_mips));
+	result &= test_detail_modifiers(
+		CS_ARCH_RISCV, CS_MODE_RISCV64 | CS_MODE_RISCV_C, c_nop,
+		sizeof(c_nop), offsetof(cs_detail, riscv) + sizeof(cs_riscv));
 
 	if (result) {
 		printf("All tests passed.\n");
