+static bool check_opcode_immediates(csh handles[2], cs_mode mode)
+{
+	static const uint8_t opcodes[] = { 0x3c, 0x3d, 0xa8, 0xa9, 0xb0, 0xb1,
+					   0xb2, 0xb3, 0xb4, 0xb5, 0xb6, 0xb7 };
+	for (unsigned p = 0; p < (mode == CS_MODE_64 ? 17u : 1u); ++p) {
+		for (unsigned i = 0; i < sizeof(opcodes); ++i) {
+			const uint8_t op = opcodes[i];
+			const unsigned width = op == 0x3d || op == 0xa9 ? 4 : 1;
+			for (unsigned v = 0; v < 256; ++v) {
+				uint8_t bytes[] = { (uint8_t)(0x3f + p), op,
+						    (uint8_t)v, (uint8_t)(v * 163),
+						    (uint8_t)(v * 57), (uint8_t)v };
+				const unsigned length = !!p + 1 + width;
+				if (!compare(handles, bytes + !p, length, v))
+					return false;
+				if (!v)
+					for (unsigned n = 0; n < length; ++n)
+						if (!compare(handles, bytes + !p, n, op))
+							return false;
+			}
+		}
+	}
+	return true;
+}
