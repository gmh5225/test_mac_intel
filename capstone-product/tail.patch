diff --git a/arch/X86/X86SingleRecord.c b/arch/X86/X86SingleRecord.c
new file mode 100644
index 00000000..16263c5a
--- /dev/null
+++ b/arch/X86/X86SingleRecord.c
@@ -0,0 +1,58 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "../../cs_priv.h"
+#include "X86ScanAdapter.h"
+
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#include "X86OutputOptions.h"
+
+static bool decodeTextRecord(cs_struct *handle, const uint8_t *code,
+			     size_t size, cs_insn *insn, uint16_t *insn_size,
+			     bool batch)
+{
+	if (handle->mode == CS_MODE_64)
+		return X86_tryOutput64(handle, code, size, insn, insn_size) ||
+		       X86_decodeOutputMiss64(handle, code, size, insn, insn_size,
+					      batch);
+	return X86_tryOutput32(handle, code, size, insn, insn_size) ||
+	       X86_decodeOutputMiss32(handle, code, size, insn, insn_size,
+				      batch);
+}
+
+static bool skipRecord(cs_struct *handle, const uint8_t *code, size_t size,
+		       uint64_t address, cs_insn *insn);
+#define CS_DECODE_SKIP_RECORD skipRecord
+#define CS_DECODE_OUTPUT_MISS decodeTextRecord
+#include "../../cs_disasm_internal.h"
+
+/* Materialize cursors only when skip-data needs them. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static bool skipRecord(cs_struct *handle, const uint8_t *code, size_t size,
+		       uint64_t address, cs_insn *insn)
+{
+	return cs_disasm_iter_skipdata(handle, &code, &size, &address, insn);
+}
+#endif
+
+CAPSTONE_INTERNAL bool X86_decodeOneText(csh ud, const uint8_t *code,
+					  size_t size, uint64_t address,
+					  cs_insn *insn)
+{
+#ifdef CS_DECODE_OUTPUT_MISS
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (handle && handle->arch == CS_ARCH_X86 && !handle->no_text &&
+	    (handle->mode == CS_MODE_32 || handle->mode == CS_MODE_64))
+		return cs_disasm_iter_core(ud, &code, &size, &address, insn);
+#endif
+	return X86_disasmIter(ud, &code, &size, &address, insn);
+}
+#endif
