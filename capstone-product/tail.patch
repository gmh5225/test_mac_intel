diff --git a/arch/X86/X86Vex3Operands.c b/arch/X86/X86Vex3Operands.c
new file mode 100644
index 00000000..9f6f46b5
--- /dev/null
+++ b/arch/X86/X86Vex3Operands.c
@@ -0,0 +1,29 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#if defined(CAPSTONE_HAS_X86) && defined(CAPSTONE_ARM_AARCH64_MIPS_X86)
+#include "../../cs_priv.h"
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_vex3_operands_text" rodata = ".cs_x86_vex3_operands_rodata"
+#endif
+#include "X86OutputOptions.h"
+#include "X86VexBaseMemory.h"
+
+bool X86_writeVex3Operands(cs_struct *handle, const uint8_t *code, size_t size,
+			   cs_insn *insn, uint16_t *insn_size,
+			   const struct X86SimpleRegister regs[4][16], bool wide)
+{
+	if (size >= 5 && code[4] < 0xc0 && wide) {
+		if (X86_OUTPUT_UNSUPPORTED(handle, false))
+			return false;
+		return writeVexBaseMemory(code, size, 3, insn, insn_size, regs[3]);
+	}
+	return X86_writeVexRegisterImmediate(handle, code, size, insn, insn_size,
+					     regs, wide);
+}
+#endif
+#endif
