+/* Predicate aliases and explicit immediates have the same family ID in
+ * the allocating API and in iterator records with printing disabled. */
+static bool test_family_ids(csh handle, const compare_family *family)
+{
+	uint8_t code[] = { 0x62, 0xf3, 0x6d, 0x28, 0x1f, 0xcb, 0 };
+	static const uint8_t predicates[] = { 0, 1, 2, 3,  4,  5,
+					      6, 7, 8, 31, 32, 255 };
+	bool success = true;
+	code[2] |= family->w ? 0x80 : 0;
+	code[4] = family->opcode;
+	for (unsigned flags = 0; flags < 4; ++flags) {
+		if (!check(cs_option(handle, CS_OPT_TEXT,
+				     flags & 1 ? CS_OPT_ON : CS_OPT_OFF) ==
+					   CS_ERR_OK &&
+				   cs_option(handle, CS_OPT_DETAIL,
+					     flags & 2 ?
+						     CS_OPT_ON :
+						     CS_OPT_OFF) == CS_ERR_OK,
+			   "select text and detail options"))
+			return false;
+		cs_insn *slot = cs_malloc(handle);
+		if (!check(slot != NULL, "allocate iterator instruction"))
+			return false;
+		for (size_t i = 0; i < sizeof(predicates); ++i) {
+			cs_insn *list = NULL;
+			const uint8_t *next = code;
+			size_t left = sizeof(code);
+			uint64_t pc = 0x1000;
+			code[6] = predicates[i];
+			size_t n = cs_disasm(handle, code, sizeof(code), pc, 1,
+					     &list);
+			success &= check(n == 1 && list[0].id ==
+							   family->instruction,
+					 "allocated integer compare family");
+			cs_free(list, n);
+			success &=
+				check(cs_disasm_iter(handle, &next, &left, &pc,
+						     slot) &&
+					      slot->id == family->instruction &&
+					      left == 0 &&
+					      pc == 0x1000 + sizeof(code),
+				      "iterator integer compare family");
+		}
+		cs_free(slot, 1);
+	}
+	success &= check(
+		cs_option(handle, CS_OPT_TEXT, CS_OPT_ON) == CS_ERR_OK &&
+			cs_option(handle, CS_OPT_DETAIL,
+				  CS_OPT_ON | CS_OPT_DETAIL_REAL) == CS_ERR_OK,
+		"restore formatted detail");
+	return success;
+}
