@@ -0,0 +1,25 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_ALIAS_PATTERN_LOOKUP_H
+#define CS_ALIAS_PATTERN_LOOKUP_H
