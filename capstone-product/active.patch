     MCInstrDesc.c
     MCInstPrinter.c
@@ -1055,26 +1056,30 @@ if(CAPSTONE_X86_SUPPORT AND (CAPSTONE_BUILD_STATIC_LIBS OR CAPSTONE_BUILD_CSTEST
         target_compile_definitions(capstone_x86_iter64 PRIVATE CAPSTONE_X86_NEAR_INDIRECT_OUTPUT)
     endif()
     set_target_properties(capstone_x86_iter64 PROPERTIES C_STANDARD 99 POSITION_INDEPENDENT_CODE ON)
-    add_library(capstone_x86_native OBJECT arch/X86/X86MemoryFallback32.c arch/X86/X86BatchScan.c arch/X86/X86VectorFallback64.c arch/X86/X86VexRegisterImmediate.c)
+    add_library(capstone_x86_native OBJECT arch/X86/X86MemoryFallback32.c arch/X86/X86BatchScan.c arch/X86/X86VectorFallback64.c arch/X86/X86VexRegisterImmediate.c arch/X86/X86PlainEvexOutput.c)
     target_link_libraries(capstone_x86_native PRIVATE capstone)
     set_target_properties(capstone_x86_native PROPERTIES C_STANDARD 99 POSITION_INDEPENDENT_CODE ON)
 endif()
 
 if(CAPSTONE_BUILD_STATIC_LIBS)
     set(capstone_static_objects $<TARGET_OBJECTS:capstone>)
+    set(capstone_alias_patterns_tail)
     if(TARGET capstone_x86_iter32)
         if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_C_COMPILER_ID STREQUAL "Clang"
            AND (CAPSTONE_AARCH64_SUPPORT OR CAPSTONE_MIPS_SUPPORT))
             # Backends reference the alias parser indirectly. Keep its hot code
             # ahead of the optional native readers even when all are linked.
+            # Keep the opcode rows after the native scanner when both are linked.
+            set(capstone_alias_patterns_tail
+                "$<FILTER:$<TARGET_OBJECTS:capstone>,INCLUDE,/AliasPatternLookup[.]c[.]o$>")
             set(capstone_static_objects
-                "$<FILTER:$<TARGET_OBJECTS:capstone>,EXCLUDE,/AliasMapping[.]c[.]o$>"
