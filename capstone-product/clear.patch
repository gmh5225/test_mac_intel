+		 uint8_t(((wlpp & 8) << 4) | ((15 ^ src) << 3) | (wlpp & 7)),
+		 uint8_t(opcode),
+		 uint8_t(0xc0 | ((reg & 7) << 3) | (rm & 7)),
+		 uint8_t(imm) };
