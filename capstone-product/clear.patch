+			    decoder.insn->detail->x86.operands[0].type !=
+				    X86_OP_REG)
+				throw std::runtime_error(
+					"missing immediate MOV register");
+			banks[2 + wide][reg] =
+				decoder.insn->detail->x86.operands[0].reg;
+		}
+	}
+	return banks;
