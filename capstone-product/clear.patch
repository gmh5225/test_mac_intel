+		for (unsigned source = 0; source < numbers.size(); ++source) {
+			for (unsigned bank = 0; bank < banks.size(); ++bank) {
+				if (banks[bank][numbers[source]] == op.reg &&
+				    widths[bank] == op.size) {
+					operands[i] = source * 4 + bank;
+					uses_vvvv |= source == 1;
+					found = true;
+				}
+			}
+		}
+		if (!found)
+			return {};
+	}
