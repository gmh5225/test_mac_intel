+bool X86_writeVexRegisterImmediate(cs_struct *handle, const uint8_t *code,
+				   size_t size, cs_insn *insn,
+				   uint16_t *insn_size,
+				   const struct X86SimpleRegister regs[4][16],
+				   bool wide)
+{
+	if (size < 6 || (code[1] & 31) != 3 || code[4] < 0xc0)
+		return false;
