+static bool check_evex_vector_loads(csh handles[2])
+{
+	for (unsigned pp = 0; pp < 4; ++pp)
+		for (unsigned ext = 0; ext < 16; ++ext)
+			for (unsigned wl = 0; wl < 8; ++wl)
+				for (unsigned mr = 0; mr < 256; ++mr) {
+					uint8_t b[] = {
+						0x62,
+						(uint8_t)(ext << 4 | 1),
+						(uint8_t)((wl >> 2) << 7 |
+							  0x7c | pp),
+						(uint8_t)(8 | (wl & 3) << 5),
+						0x6f,
+						(uint8_t)mr,
+						0x24,
+						0x80,
+						0xff,
+						0x7f,
+						0x80
+					};
+					for (unsigned variant = 0; variant < 3;
+					     ++variant) {
+						if (variant == 1) {
+							b[6] ^= mr * 13;
+							b[7] ^= mr * 17;
+						}
+						if (variant == 2) {
+							b[2] ^= 1u << (ext & 7);
+							b[3] ^= 1u << (mr & 7);
+						}
+						if (!compare(handles, b,
+							     sizeof(b),
+							     ext + mr) ||
+						    !compare(handles, b,
+							     (mr + wl +
+							      variant) %
+								     sizeof(b),
+							     wl + mr))
+							return false;
+					}
+				}
+	return true;
+}
