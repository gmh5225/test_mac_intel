+static bool check_mov_memory_immediate(csh handles[2], cs_mode mode)
+{
+	static const uint32_t values[] = { 0,	 9,	     10,	0x80,
+					   0xff, 0x80000000, 0xffffffff };
+	for (unsigned p = 0; p <= (mode == CS_MODE_64 ? 16u : 0u); ++p)
+		for (unsigned opcode = 0xc6; opcode <= 0xc7; ++opcode)
+			for (unsigned modrm = 0; modrm < 256; ++modrm)
+				for (unsigned i = 0;
+				     i < sizeof(values) / sizeof(values[0]);
+				     ++i) {
+					uint8_t bytes[12] = {
+						(uint8_t)(0x3f + p),
+						(uint8_t)opcode, (uint8_t)modrm
+					};
+					unsigned next = 3, mod = modrm >> 6,
+						 rm = modrm & 7;
+					uint8_t sib = (uint8_t)(i * 37 + modrm);
+					if (mod != 3 && rm == 4)
+						bytes[next++] = sib;
+					if (mod == 1)
+						bytes[next++] = 0x80;
+					if (mod == 2 ||
+					    (!mod &&
+					     (rm == 5 ||
+					      (rm == 4 && (sib & 7) == 5)))) {
+						bytes[next++] = 0x07;
+						bytes[next++] = 0xf0;
+						bytes[next++] = 0xff;
+						bytes[next++] = 0xff;
+					}
+					for (unsigned j = 0;
+					     j < (opcode == 0xc6 ? 1u : 4u);
+					     ++j)
+						bytes[next++] =
+							(uint8_t)(values[i] >>
+								  (8 * j));
+					const uint8_t *code = bytes + !p;
+					size_t length = next - !p;
+					if (!compare(handles, code, length,
+						     i) ||
+					    !compare(handles, code, length - 1,
+						     modrm))
+						return false;
+				}
+	return true;
+}
