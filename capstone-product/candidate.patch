+// EVEX.66.0F 73 /3 and /7 select the operation with ModR/M.reg. The
+// destination comes from vvvv/V' and the source comes from r/m, X and B.
+void emit_evex_byte_shifts(Decoder &decoder)
+{
+	std::puts(
+		"static const struct VectorOutputRow evex_byte_shifts[2][2][3] = {");
+	for (unsigned group : { 3u, 7u }) {
+		std::puts("\t{");
+		for (unsigned w = 0; w < 2; ++w) {
+			std::puts("\t\t{");
+			for (unsigned ll = 0; ll < 3; ++ll) {
+				std::string row;
+				for (unsigned pair = 0; pair < 1024; ++pair) {
+					const unsigned dst = pair >> 5,
+						       src = pair & 31;
+					const unsigned ext = ((src & 8) << 2) |
+							     ((src & 16) << 2);
+					const uint8_t bytes[] = {
+						0x62,
+						uint8_t(0xf1 ^ ext),
+						uint8_t(w << 7 |
+							((~dst & 15) << 3) | 5),
+						uint8_t(ll << 5 |
+							((~dst & 16) >> 1)),
+						0x73,
+						uint8_t(0xc0 | group << 3 |
+							(src & 7)),
+						uint8_t(pair * 37)
+					};
+					auto actual =
+						two_register_immediate_row(
+							decoder, bytes, ll, dst,
+							ll, src);
+					if (actual.empty() ||
+					    (pair && actual != row))
+						throw std::runtime_error(
+							"unexpected EVEX byte shift");
+					row = actual;
+				}
+				std::printf("\t\t\t%s,\n", row.c_str());
+			}
+			std::puts("\t\t},");
+		}
+		std::puts("\t},");
+	}
+	std::puts("};");
