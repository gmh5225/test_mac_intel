+#ifndef CAPSTONE_X86_REDUCE
+static bool check_evex_registers(csh handle)
+{
+	static const uint8_t opcodes[] = { 0xef, 0xdc, 0xdd, 0xde, 0xdf,
+					   0x44, 0x25, 0x19, 0x1b, 0x39,
+					   0x3b, 0xfe, 0x00 };
+	static const uint8_t maps[] = { 1, 2, 2, 2, 2, 3, 3, 3, 3, 3, 3, 1, 2 };
+	csh full;
+	CHECK(cs_open(CS_ARCH_X86, CS_MODE_64, &full) == CS_ERR_OK);
+	CHECK(cs_option(full, CS_OPT_DETAIL, CS_OPT_ON) == CS_ERR_OK);
+	cs_opt_mnem name = { X86_INS_UD2, "ud2" };
+	CHECK(cs_option(full, CS_OPT_MNEMONIC, (size_t)&name) == CS_ERR_OK);
+	cs_insn *insn = cs_malloc(full);
+	CHECK(insn);
+	for (size_t op = 0; op < sizeof(opcodes); ++op)
+		for (unsigned p = 0; p < 256; ++p) {
+			uint8_t bytes[] = {
+				0x62,
+				(uint8_t)((p & 0xf0) | maps[op]),
+				(uint8_t)((p & 1) ? 0xfd : ((p & 0xf8) | 5)),
+				(uint8_t)p,
+				opcodes[op],
+				(uint8_t)(0xc0 | (p & 63)),
+				(uint8_t)(p ^ 0x81)
+			};
+			for (size_t n = 5; n <= sizeof(bytes); ++n) {
+				uint32_t packed = 0;
+				X86ScanBatchResult got = X86_scanBatch(
+					handle, bytes, n, 0, &packed, 1);
+				const uint8_t *cursor = bytes;
+				size_t left = n;
+				uint64_t address = 0;
+				const bool ok = cs_disasm_iter(
+					full, &cursor, &left, &address, insn);
+				CHECK(got.count == (size_t)ok &&
+				      got.bytes == n - left);
+				if (ok)
+					CHECK(packed ==
+					      ((insn->id << 8) | insn->size));
+			}
+		}
+	cs_free(insn, 1);
+	cs_close(&full);
+	return true;
+}
