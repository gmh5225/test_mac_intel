+		/* MIPS32r2 enables 64-bit FPRs but only MIPS64 enables 64-bit GPRs.
+         * The generated tables still evaluate all feature predicates on the original mode. */
+		IsGP64 = isa == CS_MODE_MIPS64 || isa == CS_MODE_MIPS64R2;
+		IsFP64 = isa != CS_MODE_MIPS32;
 		goto DecodeStandard;
 	}
 #endif
