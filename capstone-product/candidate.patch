+#if X86_HAS_VEX3_PUBLIC_PLANS
+/* Unprefixed 64-bit C4 forms reach this after source extension selection. */
+X86_DECODE_INLINE int tryVex3PublicPlan(const uint8_t *code, size_t size,
+					X86ScanResult *result)
+{
+	if (size < 4)
+		return X86_SCAN_INVALID;
+	const unsigned map = code[1] & 0x1f;
+	if (map < 1 || map > 3)
+		return X86_SCAN_NOT_HANDLED;
+	const unsigned payload = code[2];
+	const unsigned selector = (payload & 7) | ((payload >> 4) & 8);
+	const unsigned row = x86Vex3PublicRows[map - 1][selector];
+	if (!row)
+		return X86_SCAN_NOT_HANDLED;
+	unsigned plan = x86Vex3PublicPlans[row - 1][code[3]];
+	if (!plan)
+		return X86_SCAN_NOT_HANDLED;
+	if (plan & 0x8000) {
+		if (size < 5)
+			return X86_SCAN_INVALID;
+		const unsigned modrm = code[4];
+		const unsigned key = ((modrm >= 0xc0) << 3) |
+				     ((modrm >> 3) & 7);
+		plan = x86Vex3GroupPlans[plan & 0x7fff][key];
+		if (!plan)
+			return X86_SCAN_NOT_HANDLED;
+	}
+	if ((plan & 2) && vvvvFromVEX3of3(payload))
+		return X86_SCAN_INVALID;
+	unsigned end = 4;
+	if (plan & 4) {
+		if (size == 4)
+			return X86_SCAN_INVALID;
+		const unsigned modrm = code[4];
+		end = 5;
+		if (modrm < 0xc0) {
+			const unsigned mod = modrm >> 6, rm = modrm & 7;
+			static const uint8_t extra[3][8] = {
+				{ 0, 0, 0, 0, 1, 4, 0, 0 },
+				{ 1, 1, 1, 1, 2, 1, 1, 1 },
+				{ 4, 4, 4, 4, 5, 4, 4, 4 }
+			};
+			if ((modrm & 0xc7) == 4) {
+				if (end >= size)
+					return X86_SCAN_INVALID;
+				if ((code[end] & 7) == 5)
+					end += 4;
+			}
+			end += extra[mod][rm];
+		}
+	}
+	end += plan & 1;
+	if (end > size)
+		return X86_SCAN_INVALID;
+	result->opcode = 0;
+	result->opcode_pub = plan >> 3;
+	result->length = (uint16_t)end;
+	result->popcode_adjust = 0;
+	return X86_SCAN_COMPLETE;
+}
+#endif
+
 X86_DECODE_INLINE int tryVexTerminalScan(const uint8_t *code, size_t code_len,
 					 uint8_t prefix, X86ScanResult *result)
 {
+#if X86_HAS_VEX3_PUBLIC_PLANS
+	if (prefix == 0xc4) {
+		const int status = tryVex3PublicPlan(code, code_len, result);
+		if (status != X86_SCAN_NOT_HANDLED)
+			return status;
+	}
+#endif
+
 	InternalInstruction insn = { 0 };
 	initializeInstructionHeader(&insn, code, code_len, CS_MODE_64);
 	insn.readerCursor = 1;
