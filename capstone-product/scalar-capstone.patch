+static bool check_group1_output(csh handles[2], cs_mode mode)
+{
+	const uint8_t opcodes[] = { 0x80, 0x81, 0x83 };
+	const uint8_t edges[] = { 0, 9, 10, 0x7f, 0x80, 0xff };
+	for (unsigned p = 0; p < (mode == CS_MODE_64 ? 17u : 1u); ++p) {
+		for (unsigned op = 0; op < sizeof(opcodes); ++op) {
+			for (unsigned mr = 0; mr <= 255; ++mr) {
+				unsigned count = (mr < 0xc0 && (mr & 7) == 4) ?
+							 256 :
+							 sizeof(edges);
+				for (unsigned n = 0; n < count; ++n) {
+					uint8_t code[12];
+					memset(code, edges[n % sizeof(edges)],
+					       sizeof(code));
+					code[0] = (uint8_t)(0x3f + p);
+					code[1] = opcodes[op];
+					code[2] = (uint8_t)mr;
+					if (count == 256)
+						code[3] = (uint8_t)n;
+					unsigned seed = mr + op + p + n;
+					const uint8_t *start = code + !p;
+					size_t size = sizeof(code) - !p;
+					if (!compare(handles, start, size,
+						     seed) ||
+					    !compare(handles, start,
+						     seed % size, seed))
+						return false;
+				}
+			}
+		}
+	}
+	return true;
+}
