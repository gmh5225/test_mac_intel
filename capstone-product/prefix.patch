+static bool check_legacy_vector_prefix(csh handle)
+{
+	static const struct {
+		uint8_t raw[6];
+		uint8_t size;
+		unsigned id;
+		x86_reg first, second;
+	} cases[] = {
+		{ { 0x0f, 0x60, 0xcd }, 3, X86_INS_PUNPCKLBW, X86_REG_MM1, X86_REG_MM5 },
+		{ { 0x66, 0x0f, 0x60, 0xcd }, 4, X86_INS_PUNPCKLBW, X86_REG_XMM1, X86_REG_XMM5 },
+		{ { 0x66, 0x0f, 0x38, 0x00, 0xcd }, 5, X86_INS_PSHUFB, X86_REG_XMM1, X86_REG_XMM5 },
+		{ { 0x66, 0x0f, 0x3a, 0x0f, 0xcd, 0xa5 }, 6, X86_INS_PALIGNR, X86_REG_XMM1, X86_REG_XMM5 },
+	};
+	for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i) {
+		cs_insn *insn;
+		size_t count = cs_disasm(handle, cases[i].raw, cases[i].size,
+					 0x1000, 1, &insn);
+		if (!count)
+			return false;
+		cs_x86 *x = &insn->detail->x86;
+		bool ok = insn->size == cases[i].size && insn->id == cases[i].id &&
+			  x->op_count >= 2 && x->operands[0].type == X86_OP_REG &&
+			  x->operands[1].type == X86_OP_REG &&
+			  x->operands[0].reg == cases[i].first &&
+			  x->operands[1].reg == cases[i].second;
+		cs_free(insn, count);
+		if (!ok)
+			return false;
+	}
+	return true;
+}
+
+static bool check_extrq_selector(csh handle)
+{
+	uint8_t code[] = { 0x66, 0x0f, 0x78, 0xc0, 0x04, 0x02 };
+	for (unsigned mr = 0xc0; mr <= 0xff; ++mr) {
+		code[3] = (uint8_t)mr;
+		cs_insn *insn;
+		size_t count = cs_disasm(handle, code, sizeof(code), 0, 1, &insn);
+		if (!count) {
+			if (mr < 0xc8)
+				return false;
+			continue;
+		}
+		bool ok = mr < 0xc8 && insn->id == X86_INS_EXTRQ &&
+			  insn->size == sizeof(code);
+		cs_free(insn, count);
+		if (!ok)
+			return false;
+	}
+	return true;
+}
