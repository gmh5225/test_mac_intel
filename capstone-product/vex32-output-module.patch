diff --git a/arch/X86/X86VexOutput32.c b/arch/X86/X86VexOutput32.c
new file mode 100644
index 00000000..37ba4199
--- /dev/null
+++ b/arch/X86/X86VexOutput32.c
@@ -0,0 +1,30 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "../../cs_priv.h"
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#include "X86SimpleOutput.h"
+
+/* Canonical generation checks every admitted register row in both modes.
+ * A bare C5 with the top payload bits set names only the low registers.
+ * Its 32-bit record differs only in address size and synthetic REX. */
+bool X86_writeVex32Output(const uint8_t *code, size_t size, cs_insn *insn,
+			  uint16_t *insn_size)
+{
+	if (size < 4 || (code[1] & 0xc0) != 0xc0 || code[3] < 0xc0)
+		return false;
+	/* The admitted register form never reads the memory-register table. */
+	if (!X86_writeVectorOutput(code, size, insn, insn_size, NULL, true))
+		return false;
+	if (insn->detail) {
+		insn->detail->x86.addr_size = 4;
+		insn->detail->x86.rex = 0;
+	}
+	return true;
+}
+#endif
+#endif
