+void emit_conditional_moves(Decoder &decoder, const RegisterTable &regs)
+{
+	std::cout << "/* Generated by x86_simple_output.cpp --cmov64. */\n"
+		  << "static const struct X86SimpleOutput x86_cmov[2][16] = {\n";
+	for (unsigned width = 0; width != 2; ++width) {
+		std::cout << "\t{\n";
+		for (unsigned cc = 0; cc != 16; ++cc) {
+			const uint8_t opcode = uint8_t(0x40 + cc);
+			CheckedRow row;
+			const auto *bank = regs[2 + width];
+			for (unsigned prefix = 0; prefix <= 16; ++prefix) {
+				const uint8_t rex = prefix ? uint8_t(0x3f + prefix) : 0;
+				if (unsigned(bool(rex & 8)) != width)
+					continue;
+				for (unsigned mr = 0xc0; mr != 0x100; ++mr) {
+					const uint8_t code[] = { rex, 0x0f, opcode, uint8_t(mr) };
+					const auto &dst = bank[((rex & 4) << 1) | ((mr >> 3) & 7)];
+					const auto &src = bank[((rex & 1) << 3) | (mr & 7)];
+					decoder.decode(code + !rex, 3 + !!rex, 3 + !!rex, 0);
+					row.observe(describe(*decoder.insn, opcode, rex, uint8_t(mr),
+							     &dst, &src, false, false, true));
+				}
+				const uint8_t memory[] = { rex, 0x0f, opcode, 0 };
+				decoder.decode(memory + !rex, 3 + !!rex, 3 + !!rex, 0);
+				row.observe(describe(*decoder.insn, opcode, rex, 0, nullptr,
+						     nullptr, false, true, true));
+			}
+			std::cout << "\t\t" << row.fields << ",\n";
+		}
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+}
