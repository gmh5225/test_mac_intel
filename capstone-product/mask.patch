diff --git a/CMakeLists.txt b/CMakeLists.txt
index 50da9212..e8a38826 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1101,6 +1101,9 @@ if(capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV"
             COMPILE_DEFINITIONS "$<$<CONFIG:Release>:X86_CACHED_OPERAND_ACCESS>")
         set_property(SOURCE arch/X86/X86Disassembler.c APPEND PROPERTY
             COMPILE_DEFINITIONS "$<$<CONFIG:Release>:X86_CHECK_EVEX_WRITEMASK>")
+        # The x86-64 batch scanner needs the instruction address only on fallback.
+        set_property(SOURCE arch/X86/X86BatchScan.c APPEND PROPERTY
+            COMPILE_DEFINITIONS "$<$<CONFIG:Release>:X86_BATCH_FALLBACK_ADDRESS>")
         set_property(SOURCE arch/X86/X86VectorFallback64.c APPEND PROPERTY
             COMPILE_DEFINITIONS "$<$<CONFIG:Release>:X86_FIXED_MASKED_SUFFIX>")
     endif()
diff --git a/arch/X86/X86BatchScan.c b/arch/X86/X86BatchScan.c
index b56826b0..65b9cbe8 100644
--- a/arch/X86/X86BatchScan.c
+++ b/arch/X86/X86BatchScan.c
@@ -280,7 +280,11 @@ CS_DECODE_INLINE X86ScanBatchResult scanBatch(csh ud, const uint8_t *code,
 		uint32_t packed = wide ? readFirst64(code, size) :
 					 readFirst32(code, size);
 		if (!packed) {
+#ifdef X86_BATCH_FALLBACK_ADDRESS
+			insn.address = address + batch.bytes;
+#else
 			insn.address = address;
+#endif
 			X86ScanResult result;
 			if (!X86_getInstructionScanResult(ud, code, size, &insn,
 							  &result))
@@ -294,7 +298,9 @@ CS_DECODE_INLINE X86ScanBatchResult scanBatch(csh ud, const uint8_t *code,
 		batch.bytes += length;
 		code += length;
 		size -= length;
+#ifndef X86_BATCH_FALLBACK_ADDRESS
 		address += length;
+#endif
 	}
 	return batch;
 }
