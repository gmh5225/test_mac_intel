+ifneq ($(strip $(capstone_dependency_archs)),)
+AUTODEPS := $(foreach arch,$(capstone_dependency_archs),$(LIBOBJ:.o=.$(arch).d))
+capstone_depflags = $(foreach arch,$(capstone_dependency_archs), \
