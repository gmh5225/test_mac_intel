diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 197453cb..1c7b5925 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -2302,8 +2302,10 @@ X86_DECODE_INLINE int fixupRMOperand(struct InternalInstruction *insn,
 			return -1;
 	}
 
-	// Apply the AVX512 compressed displacement scaling factor.
-	if (insn->eaDisplacement == EA_DISP_8)
+	/* VEX and EVEX IFMA share an operand descriptor. Only the EVEX
+	 * encoding scales its encoded disp8 by the tuple size. */
+	if (insn->eaDisplacement == EA_DISP_8 &&
+	    insn->vectorExtensionType == TYPE_EVEX)
 		insn->displacement *= 1 << (encoding - ENCODING_RM);
 	return 0;
 }
