+	-Xarch_$(arch) -MF$(@:.o=.$(arch).d) -Xarch_$(arch) -MT$@)
+else
+capstone_depflags = -MMD -MP -MF $(@:.o=.d) -MT $@
+endif
+endif
 
 # include by auto dependencies
 -include $(AUTODEPS)
