+void emit_vex_mixed_immediates(Decoder &decoder64)
+{
+	Decoder decoder32(CS_MODE_32);
+	const auto banks = vex_register_banks(decoder64);
+	constexpr unsigned opcodes[] = { 0x00, 0x01, 0x14, 0x15, 0x16, 0x17,
