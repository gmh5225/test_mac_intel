+			"unrepresentable VEX register-immediate plans");
+	std::puts(
+		"/* Generated by x86_vector_output.cpp --vex-register-immediates. */");
+	std::puts(
+		"static const struct VexRegisterImmediateRow vex_immediate_rows[] = {");
+	for (const auto &row : rows)
