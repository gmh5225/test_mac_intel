+static bool check_vector_suffixes(void)
+{
+	cs_struct handle = { 0 };
+	cs_insn insn = { 0 };
+	cs_detail detail = { 0 };
+	MCInst mi = { 0 };
+	handle.detail_opt = CS_OPT_ON;
+	mi.csh = &handle;
+	mi.flat_insn = &insn;
+	insn.detail = &detail;
+	static const struct {
+		const char *text;
+		unsigned vas[3];
+	} cases[] = {
+		{ "add v0.4s, v1.4s, v2.4s",
+		  { AARCH64LAYOUT_VL_4S, AARCH64LAYOUT_VL_4S,
+		    AARCH64LAYOUT_VL_4S } },
+		{ "t v0.16b, v1.h, v2.d",
+		  { AARCH64LAYOUT_VL_16B, AARCH64LAYOUT_VL_H,
+		    AARCH64LAYOUT_VL_D } },
+		{ "t v0.4s, v1, [x0, x1], v2.2d",
+		  { AARCH64LAYOUT_VL_4S, AARCH64LAYOUT_INVALID,
+		    AARCH64LAYOUT_VL_2D } },
+		{ "t v0, v1, v2.", { 0, 0, 0 } },
+		{ "t v0, v1, v2.16", { 0, 0, 0 } },
+	};
+	for (unsigned i = 0; i < ARR_SIZE(cases); ++i) {
+		SStream ss = { 0 };
+		strcpy(ss.buffer, cases[i].text);
+		memset(&detail, 0, sizeof(detail));
+		detail.aarch64.op_count = 3;
+		for (unsigned n = 0; n < 3; ++n)
+			detail.aarch64.operands[n].type = AARCH64_OP_REG;
+		AArch64_add_vas(&mi, &ss);
+		for (unsigned n = 0; n < 3; ++n)
+			if ((unsigned)detail.aarch64.operands[n].vas !=
+			    cases[i].vas[n]) {
+				fprintf(stderr,
+					"vector layout mismatch for %s operand %u\n",
+					cases[i].text, n);
+				return false;
+			}
+	}
+	return true;
+}
+
 /* Evaluate the real descriptor objects with native enum/constraint values,
  * independently of the generator's source parser. */
 int main(void)
