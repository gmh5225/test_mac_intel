@@ -891,6 +891,29 @@ void emit_vex_registers(Decoder &decoder)
 	std::fprintf(stderr, "%zu VEX register rows, %zu opcode plans\n",
 		     rows.size(), widths.size() - 1);
 }
+void emit_vector_register_names(Decoder &decoder)
+{
+	const x86_reg bases[] = { X86_REG_XMM0, X86_REG_YMM0, X86_REG_ZMM0 };
+	std::puts("static const char vector_register_names[3][32][8] = {");
+	for (unsigned width = 0; width < 3; ++width) {
+		std::puts("\t{");
+		for (unsigned number = 0; number < 32; ++number) {
+			const char *name = cs_reg_name(decoder.handle,
+						       bases[width] + number);
+			const std::string expected =
+				std::string(1, "xyz"[width]) + "mm" +
+				std::to_string(number);
+			if (!name || name != expected ||
+			    expected.size() != 4 + (number >= 10))
+				throw std::runtime_error(
+					"unexpected vector register name");
+			std::printf("\t\t\"%s\",\n", name);
+		}
+		std::puts("\t},");
+	}
+	std::puts("};");
+}
+
