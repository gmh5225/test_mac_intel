diff --git a/AliasPatternLookup.c b/AliasPatternLookup.c
new file mode 100644
index 00000000..2295f292
--- /dev/null
+++ b/AliasPatternLookup.c
@@ -0,0 +1,56 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include "AliasPatternLookup.h"
+
+#if !defined(CAPSTONE_DIET) && \
+	(defined(CAPSTONE_HAS_AARCH64) || defined(CAPSTONE_HAS_MIPS))
+#include "utils.h"
+
+#if defined(__ELF__) && defined(__GNUC__)
+#define ALIAS_PATTERN_CODE __attribute__((section(".cs_alias_pattern_lookup")))
+#define ALIAS_PATTERN_DATA __attribute__((section(".cs_alias_pattern_rows")))
+#else
+#define ALIAS_PATTERN_CODE
+#define ALIAS_PATTERN_DATA
+#endif
+
+/* A table suffix starts with the exact generated opcode record and retains the
+ * original sentinel. Its static address can be cached by the ordinary matcher. */
+static inline const char *
+matchKnownAliasOpcode(MCInst *MI, const AliasMatchingData *data, unsigned row)
+{
+	if (!row)
+		return NULL;
+	AliasMatchingData suffix = *data;
+	suffix.OpToPatterns += row - 1;
+	return matchAliasPatterns(MI, &suffix);
+}
+
+#ifdef CAPSTONE_HAS_AARCH64
+#include "arch/AArch64/AArch64GenAliasPatternRows.inc"
+ALIAS_PATTERN_CODE
+const char *matchAArch64AliasPatterns(MCInst *MI, const AliasMatchingData *data)
+{
+	const unsigned offset = MI->Opcode - AArch64_FIRST_ALIAS_OPCODE;
+	if (offset >= ARR_SIZE(AArch64_alias_rows))
+		return NULL;
+	const unsigned row = AArch64_alias_rows[offset];
+	return matchKnownAliasOpcode(MI, data, row);
+}
+#endif
+
+#ifdef CAPSTONE_HAS_MIPS
+#include "arch/Mips/MipsGenAliasPatternRows.inc"
+ALIAS_PATTERN_CODE
+const char *matchMipsAliasPatterns(MCInst *MI, const AliasMatchingData *data)
+{
+	const unsigned offset = MI->Opcode - Mips_FIRST_ALIAS_OPCODE;
+	if (offset >= ARR_SIZE(Mips_alias_rows))
+		return NULL;
+	const unsigned row = Mips_alias_rows[offset];
+	return matchKnownAliasOpcode(MI, data, row);
+}
+#endif
+
+#endif
