#!/bin/sh
triple=
previous=
for arg do
    case "$arg" in
        --sysroot|--sysroot=*|-isysroot) exec /usr/bin/clang "$@" ;;
    esac
    if [ "$previous" = -target ] || [ "$previous" = --target ]; then triple=$arg; fi
    case "$arg" in --target=*) triple=${arg#--target=} ;; esac
    previous=$arg
done
case "$triple" in
    aarch64*linux*) target=aarch64-linux-gnu ;;
    arm*linux*hf*) target=arm-linux-gnueabihf ;;
    arm*linux*|thumb*linux*) target=arm-linux-gnueabi ;;
    *) exec /usr/bin/clang "$@" ;;
esac
exec /usr/bin/clang --sysroot="$RUNNER_TEMP/grid-sysroots/$target" "$@"
