+static bool uniform_vex_registers(Decoder &decoder, Decoder &decoder32,
+				  unsigned opcode, unsigned w, unsigned ll,
+				  unsigned pp, bool imm, const std::string &row)
+{
+	for (unsigned dst = 0; dst < 16; ++dst) {
+		for (unsigned src = 0; src < 16; ++src) {
+			for (unsigned rm = 0; rm < 16; ++rm) {
+				const unsigned rxb = ((dst & 8) >> 1) |
+						     (rm >> 3);
+				const unsigned value = (src << 4) | rm;
+				auto matches = [&](Decoder &reader,
+						   unsigned extensions,
+						   bool short_prefix,
+						   bool mode32) {
+					return vex_register_row(
+						       reader, 1, opcode, w, ll,
+						       extensions, dst & 7, src,
+						       rm & 7, short_prefix,
+						       imm, value, false,
+						       mode32, pp) == row;
+				};
+				if (!matches(decoder, rxb, false, false) ||
+				    !matches(decoder, rxb | 2, false, false))
+					return false;
+				if (w || rm >= 8)
+					continue;
+				if (!matches(decoder, rxb, true, false))
+					return false;
+				if (dst < 8 && src < 8 &&
+				    (!matches(decoder32, 0, true, true) ||
+				     !matches(decoder32, 0, false, true)))
+					return false;
+			}
+		}
+	}
+	return true;
+}
