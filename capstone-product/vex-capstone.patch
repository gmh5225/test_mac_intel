+static bool check_vex_mandatory_prefixes(csh handles[2])
+{
+	const uint8_t opcodes[] = { 0x10, 0x14, 0x54, 0x58,
+				    0x59, 0x5c, 0x71, 0xc2 };
+	for (unsigned op = 0; op < sizeof(opcodes); ++op) {
+		for (unsigned n = 0; n < 8192; ++n) {
+			uint8_t b[] = { 0xc4,
+					(uint8_t)((n & 0xe0) | 1),
+					(uint8_t)(n >> 3),
+					opcodes[op],
+					(uint8_t)(0xc0 | ((n ^ (n >> 7)) & 63)),
+					(uint8_t)(n >> 5) };
+			if (!compare(handles, b, sizeof(b), n) ||
+			    !compare(handles, b, n % sizeof(b), n))
+				return false;
+			b[1] = 0xc5;
+			if (!compare(handles, b + 1, sizeof(b) - 1, n))
+				return false;
+		}
+	}
+	return true;
+}
