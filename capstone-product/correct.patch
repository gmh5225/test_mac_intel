+static void set_implicit_writes(cs_detail *detail, unsigned int i, cs_mode mode)
+{
+	const insn_map_x86 *mapping = &insns[i];
+	if (mode != CS_MODE_64) {
+		switch (mapping->mapid) {
+		case X86_INS_RDTSC:
+		case X86_INS_RDTSCP: {
+			const bool serial = mapping->mapid == X86_INS_RDTSCP;
+			detail->regs_write[0] = X86_REG_EAX;
+			if (serial)
+				detail->regs_write[1] = X86_REG_ECX;
+			detail->regs_write[1 + serial] = X86_REG_EDX;
+			detail->regs_write_count = 2 + serial;
+			return;
+		}
+		case X86_INS_VZEROALL:
+		case X86_INS_VZEROUPPER: {
+			/* Only YMM0 through YMM7 exist outside long mode. */
+			const size_t bytes = 8 * sizeof(detail->regs_write[0]);
+			memcpy(detail->regs_write, mapping->regs_mod, bytes);
+			memset(detail->regs_write + 8, 0,
+			       sizeof(mapping->regs_mod) - bytes);
+			detail->regs_write_count = 8;
+			return;
+		}
+		default:
+			break;
+		}
+	}
+	memcpy(detail->regs_write, mapping->regs_mod, sizeof(mapping->regs_mod));
+	detail->regs_write_count = (x86_mapping_counts[i] >> 5) & 31;
+}
 #endif
 
