+static bool check_timestamp_writes(csh handle)
+{
+	const cs_mode modes[] = { CS_MODE_16, CS_MODE_64, CS_MODE_32 };
+	const uint8_t bytes[] = { 0x0f, 0x31, 0x0f, 0x01, 0xf9 };
+	for (unsigned m = 0; m < sizeof(modes) / sizeof(modes[0]); ++m) {
+		if (cs_option(handle, CS_OPT_MODE, modes[m]) != CS_ERR_OK)
+			return false;
+		const bool wide = modes[m] == CS_MODE_64;
+		const uint16_t expected[] = { wide ? X86_REG_RAX : X86_REG_EAX,
+					      wide ? X86_REG_RCX : X86_REG_ECX,
+					      wide ? X86_REG_RDX : X86_REG_EDX };
+		cs_insn *insn = NULL;
+		size_t count = cs_disasm(handle, bytes, sizeof(bytes), 0, 0, &insn);
+		bool ok = count == 2;
+		for (unsigned n = 0; ok && n < count; ++n) {
+			const cs_detail *detail = insn[n].detail;
+			ok = detail && detail->regs_write_count == 2 + n &&
+			     detail->regs_write[0] == expected[0] &&
+			     detail->regs_write[1 + n] == expected[2] &&
+			     (!n || detail->regs_write[1] == expected[1]);
+		}
+		cs_free(insn, count);
+		if (!ok)
+			return false;
+	}
+	return cs_option(handle, CS_OPT_MODE, CS_MODE_64) == CS_ERR_OK;
+}
