+static bool check_opcode_immediates(csh handles[2], cs_mode mode)
+{
+	static const uint8_t values[] = { 0, 9, 10, 0x7f, 0x80, 0xff };
+	const unsigned prefixes = mode == CS_MODE_64 ? 17 : 1;
+	for (unsigned p = 0; p < prefixes; ++p) {
+		for (unsigned opcode = 0; opcode < 256; ++opcode) {
+			if ((opcode & 0xc6) != 4 && (opcode & 0xfe) != 0xa8 &&
+			    (opcode & 0xf8) != 0xb0)
+				continue;
+			for (unsigned i = 0; i < sizeof(values); ++i) {
+				uint8_t code[6];
+				memset(code, values[i], sizeof(code));
+				code[0] = (uint8_t)(0x3f + p);
+				code[1] = (uint8_t)opcode;
+				for (unsigned n = 1; n <= sizeof(code) - !p;
+				     ++n)
+					if (!compare(handles, code + !p, n,
+						     p + opcode + i))
+						return false;
+			}
+		}
+	}
+	return true;
+}
