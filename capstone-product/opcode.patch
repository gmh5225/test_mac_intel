+/* Accumulator and MOV r8 immediate opcodes use the flags and access of
+ * their ordinary register pair. They encode the destination in the opcode. */
+static bool writeOpcodeImmediate32(cs_struct *handle, const uint8_t *code,
+				   size_t size, cs_insn *insn,
+				   uint16_t *insn_size)
+{
+	const unsigned opcode = code[0];
+	const bool move = (opcode & 0xf8) == 0xb0;
+	const bool alu = (opcode & 0xc6) == 4;
+	if (!move && !alu && (opcode & 0xfe) != 0xa8)
+		return false;
+
+	const bool byte = move || !(opcode & 1);
+	const unsigned width = byte ? 1 : 4;
+	if (size < 1 + width || X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	const unsigned pair = move ? 0x8a :
+			      alu  ? opcode & 0x39 :
+				     0x84 | (opcode & 1);
+	const unsigned row = x86_simple_plans[0][0][pair] >> 2;
+	const struct X86SimpleRegister *reg =
+		&x86_simple_registers[byte ? 0 : 2][move ? opcode & 7 : 0];
+	writeUnsignedRegisterImmediate(insn, &x86_simple_outputs[row], reg,
+				       code, 0, 0, 1, width, insn_size);
+	return true;
+}
+
