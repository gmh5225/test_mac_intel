+static bool check_segment_lea32(csh handles[2])
+{
+	const uint8_t prefixes[] = { 0x26, 0x2e, 0x36, 0x3e, 0x64, 0x65 };
+	for (unsigned p = 0; p < sizeof(prefixes); ++p)
