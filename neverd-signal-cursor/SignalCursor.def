#include <execinfo.h>
#include <libunwind.h>
#include <string.h>
static int target_stage, framed_entry;
static void walk_signal(const arm_thread_state64_t *regs, uintptr_t interrupted,
                        uintptr_t caller, uintptr_t cfa) {
  unw_context_t context;
  unw_cursor_t cursor;
  if (unw_getcontext(&context) || unw_init_local(&cursor, &context)) _exit(40);
  for (unsigned i = 0; i != 24; ++i) {
    unw_word_t ip;
    if (unw_get_reg(&cursor, UNW_REG_IP, &ip)) _exit(41);
    const uintptr_t address = (uintptr_t)ptrauth_strip((void *)ip, ptrauth_key_return_address);
    Dl_info symbol;
    if (dladdr((void *)address, &symbol) && symbol.dli_sname &&
        !strcmp(symbol.dli_sname, "_sigtramp")) {
      write(2, "trampoline\n", 11);
      if (arm_thread_state64_get_pc(*regs) != interrupted || caller != expected_return) _exit(51);
      uintptr_t fp = arm_thread_state64_get_fp(*regs);
      if (framed_entry && target_stage == spill_stage)
        fp = *(const uintptr_t *)fp;
      const uintptr_t signed_parent = *(const uintptr_t *)(fp + sizeof(uintptr_t));
      const uintptr_t parent_cfa = fp + 2 * sizeof(uintptr_t);
      uintptr_t parent = signed_parent;
      __asm__ volatile("autib %0, %1" : "+r"(parent) : "r"(parent_cfa));
      void *frames[8];
      const int count = backtrace_from_fp((void *)fp, frames, 8);
      if (count <= 0) _exit(52);
      const uintptr_t first = (uintptr_t)ptrauth_strip(frames[0], ptrauth_key_function_pointer);
      if (!parent || first != parent) _exit(53);
      write(2, "interrupted/caller/parent\n", 26);
      return;
    }
    if (unw_step(&cursor) <= 0) _exit(43);
  }
  _exit(44);
}
