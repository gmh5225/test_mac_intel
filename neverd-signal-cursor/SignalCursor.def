#include <libunwind.h>
#include <string.h>
static int target_stage;
static void walk_signal(const arm_thread_state64_t *regs, uintptr_t interrupted) {
  unw_context_t context;
  unw_cursor_t cursor;
  if (unw_getcontext(&context) || unw_init_local(&cursor, &context))
    _exit(40);
  for (unsigned i = 0; i != 24; ++i) {
    unw_word_t ip;
    Dl_info symbol;
    if (unw_get_reg(&cursor, UNW_REG_IP, &ip))
      _exit(41);
    uintptr_t address = (uintptr_t)ptrauth_strip((void *)ip, ptrauth_key_return_address);
    if (dladdr((void *)address, &symbol) && symbol.dli_sname &&
        !strcmp(symbol.dli_sname, "_sigtramp")) {
      static const char trampoline[] = "trampoline\n";
      write(2, trampoline, sizeof(trampoline) - 1);
      for (unsigned r = 0; r < UNW_ARM64_FP; ++r)
        if (unw_set_reg(&cursor, UNW_ARM64_X0 + r, regs->__x[r])) _exit(51);
      if (unw_set_reg(&cursor, UNW_ARM64_FP, arm_thread_state64_get_fp(*regs)) ||
          unw_set_reg(&cursor, UNW_ARM64_LR, arm_thread_state64_get_lr(*regs)) ||
          unw_set_reg(&cursor, UNW_REG_SP, arm_thread_state64_get_sp(*regs)) ||
          unw_set_reg(&cursor, UNW_REG_IP, interrupted))
        _exit(52);
      if (unw_get_reg(&cursor, UNW_REG_IP, &ip) || ip != interrupted)
        _exit(53);
      static const char resumed[] = "interrupted\n";
      write(2, resumed, sizeof(resumed) - 1);
      if (unw_step(&cursor) <= 0 || unw_get_reg(&cursor, UNW_REG_IP, &ip))
        _exit(54);
      address = (uintptr_t)ptrauth_strip((void *)ip, ptrauth_key_return_address);
      if (address != expected_return) _exit(55);
      static const char returned[] = "caller\n";
      write(2, returned, sizeof(returned) - 1);
      return;
    }
    if (unw_step(&cursor) <= 0)
      _exit(43);
  }
  _exit(44);
}
