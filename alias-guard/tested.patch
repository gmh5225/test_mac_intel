+	std::puts(
+		"static const struct VectorOutputRow legacy_immediate_rows[] = {");
+	for (const auto &row : rows)
+		std::printf("\t%s,\n", row.c_str());
+	std::puts("};\nstatic const uint8_t legacy_immediate_plans[4][8] = {");
+	for (const auto &plan : plans) {
+		std::cout << "\t";
+		std::cout << "{ ";
