--- /dev/null
+++ b/arch/X86/X86RegisterFallback32.c
@@ -0,0 +1,40 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_register_fallback32_text" rodata = \
+	".cs_x86_register_fallback32_rodata"
+#endif
+#include "../../cs_priv.h"
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#include "X86OutputOptions.h"
+#include "X86RegisterImmediateOutput.h"
+#include "X86GenTest32Registers.inc"
+#include "../../cs_disasm_internal.h"
+
+CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
+X86_decodeRegisterFallback32(cs_struct *handle, const uint8_t *code,
+			     size_t size, cs_insn *insn, uint16_t *insn_size,
+			     bool batch)
+{
+	const unsigned opcode = code[0];
+	if ((opcode & 0xfe) == 0xf6) {
+		const unsigned form = opcode & 1;
+		const unsigned width = form ? 4 : 1;
+		if (size >= 2 + width && (code[1] & 0xf8) == 0xc0 &&
+		    !X86_OUTPUT_UNSUPPORTED(handle, false)) {
+			writeUnsignedRegisterImmediate(
+				insn, &test32_rows[form],
+				&test32_regs[form][code[1] & 7], code, 0,
+				code[1], 2, width, insn_size);
+			return true;
+		}
+	}
+	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
+}
+#endif
+#endif
diff --git a/arch/X86/X86RegisterImmediateOutput.h b/arch/X86/X86RegisterImmediateOutput.h
new file mode 100644
index 00000000..ac91ab9b
--- /dev/null
+++ b/arch/X86/X86RegisterImmediateOutput.h
@@ -0,0 +1,46 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_REGISTER_IMMEDIATE_OUTPUT_H
+#define CS_X86_REGISTER_IMMEDIATE_OUTPUT_H
+
+#include "X86SimpleOutput.h"
+#include "X86UnsignedImmediate.h"
+
+/* MOV opcode-register and TEST ModR/M-register forms have unsigned immediates.
+ * A register-direct ModR/M byte always has its top two bits set. */
+static inline void writeUnsignedRegisterImmediate(
+	cs_insn *insn, const struct X86SimpleOutput *row,
+	const struct X86SimpleRegister *reg, const uint8_t *code, uint8_t rex,
+	uint8_t modrm, unsigned offset, unsigned imm_size, uint16_t *insn_size)
+{
+	const uint8_t *raw = code + offset;
+	const uint32_t value =
+		imm_size == 1 ? raw[0] :
+				(uint32_t)raw[0] | ((uint32_t)raw[1] << 8) |
+					((uint32_t)raw[2] << 16) |
+					((uint32_t)raw[3] << 24);
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)(offset + imm_size);
+	memcpy(insn->bytes, code, insn->size);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, reg->name, sizeof(reg->name));
+	char *out = insn->op_str + reg->length;
+	memcpy(out, ", ", 2);
+	writeUnsignedImmediate(out + 2, value);
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, code[rex != 0], rex,
+				      modrm, reg->reg, 0);
+		cs_x86 *x = &insn->detail->x86;
+		x->encoding.modrm_offset = modrm ? (uint8_t)(offset - 1) : 0;
+		x->encoding.imm_offset = (uint8_t)offset;
+		x->encoding.imm_size = (uint8_t)imm_size;
+		x->operands[1].type = X86_OP_IMM;
+		x->operands[1].imm = value;
+		x->operands[1].access = 0;
+	}
+}
+
+#endif
diff --git a/arch/X86/X86VectorFallback64.c b/arch/X86/X86VectorFallback64.c
