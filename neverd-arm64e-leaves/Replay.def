    "AArch64PACMSemantics.NativePrefixModesAgreeWithBothCProjections",
    "AArch64OrderedMemoryNative.SIMDFamiliesExecuteBothSourcesAndLLVM"
  ],
  "oracle_xml": "pointer-oracles.xml",
  "oracle_log": "pointer-oracles.log",
  "swift_error_control": {
    "definition": "#define SWIFT __attribute__((swiftcall))\n#define SELF __attribute__((swift_context))\n#define ERROR __attribute__((swift_error_result))\nSWIFT void *read_error(void * SELF context, void ** ERROR error) { return *error; }\nSWIFT void *replace_error(void *new_error, void * SELF context, void ** ERROR error) { void *old=*error; *error=new_error; return old; }\n",
    "caller": "#define SWIFT __attribute__((swiftcall))\n#define SELF __attribute__((swift_context))\n#define ERROR __attribute__((swift_error_result))\nextern SWIFT void *read_error(void * SELF context, void ** ERROR error);\nextern SWIFT void *replace_error(void *next, void * SELF context, void ** ERROR error);\nint main(void) {\n  unsigned first = 73, second = 97;\n  void *error = &first;\n  if (read_error(&second, &error) != &first || error != &first) return 1;\n  if (replace_error(&second, &first, &error) != &first || error != &second) return 2;\n  if (replace_error(0, &first, &error) != &second || error) return 3;\n  return read_error(&first, &error) != 0 || error != 0;\n}\n",
    "compiler": "/usr/bin/clang",
    "target": "arm64e-apple-macosx15.0",
    "target_option": "-target",
    "optimizations": [
      "-O0",
      "-O2"
    ],
    "compile_options": [
      "-Werror",
      "-fomit-frame-pointer"
    ],
    "output_option": "-o",
    "caller_name": "error-caller.c",
    "definition_name": "error-callee.c",
    "binary_name": "error-control",
    "disassembly": [
      "/usr/bin/otool",
      "-tvV"
    ],
    "error_register": "x21"
  }
