{
  "directory": "unwind-control",
  "source": "control.cpp",
  "loader_source": "loader.cpp",
  "loader": "loader.out",
  "report": "report.json",
  "timeout": 30,
  "compile_args": ["-arch", "arm64e", "-O0", "-std=c++20", "-fno-omit-frame-pointer", "-fno-optimize-sibling-calls"],
  "library_args": ["-dynamiclib"],
  "output_option": "-o",
  "compile_suffix": "-compile",
  "sections_suffix": "-sections",
  "profiles": [
    {"name": "compact.dylib", "args": []},
    {"name": "no-index.dylib", "args": ["-Wl,-no_compact_unwind"]},
    {"name": "indexed-dwarf.dylib", "args": ["-DNEVERD_FORCE_DWARF"]}
  ],
  "source_text": "#ifdef NEVERD_FORCE_DWARF\n#define FORCE_DWARF() asm volatile(\".cfi_escape 0x2e, 0\")\n#else\n#define FORCE_DWARF() do {} while (false)\n#endif\nstatic int Cleanups;\nstruct Guard { ~Guard() { ++Cleanups; } };\n__attribute__((noinline)) static int throwing(int value) {\n  FORCE_DWARF();\n  Guard guard;\n  if (value == 31) throw value;\n  return value;\n}\nextern \"C\" int main(int, char **) {\n  FORCE_DWARF();\n  try { throwing(31); return 1; }\n  catch (int value) { if (value != 31 || Cleanups != 1) return 2; }\n  return throwing(23) == 23 && Cleanups == 2 ? 0 : 3;\n}\n"
}
