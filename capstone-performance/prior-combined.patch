diff --git a/suite/synctools/alias_mnemonic_index.py b/suite/synctools/alias_mnemonic_index.py
new file mode 100644
index 00000000..69a886ec
--- /dev/null
+++ b/suite/synctools/alias_mnemonic_index.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Index the first matching row in each indexed textual alias name map."""
+
+import argparse
+from pathlib import Path
+import re
+
+
+def generate(directory):
+    arch = directory.name
+    source = (directory / f"{arch}Mapping.c").read_text()
+    declaration = "static const name_map insn_alias_mnem_map[] = {"
+    body = source.split(declaration, 1)[1].split("};", 1)[0]
+    include = f"{arch}GenCSAliasMnemMap.inc"
+    body = body.replace(f'#include "{include}"', (directory / include).read_text())
+    body = re.sub(r"/\*.*?\*/|//[^\n]*", "", body, flags=re.S)
+    row = re.compile(
+        r'\s*\{\s*'
+        + arch.upper()
+        + r'_INS_ALIAS_(\w+)\s*,\s*(NULL|"[^"\\]*")\s*\},?'
+    )
+    names = []
+    cursor = 0
+    while body[cursor:].strip():
+        match = row.match(body, cursor)
+        if not match:
+            raise ValueError(f"Unexpected {arch} alias name-map initializer")
+        cursor = match.end()
+        if match[2] == "NULL":
+            if match[1] != "END" or body[cursor:].strip():
+                raise ValueError(f"Unexpected {arch} alias terminator")
+            break
+        names.append(match[2][1:-1].encode("ascii"))
+    else:
+        raise ValueError(f"Missing {arch} alias terminator")
+    if len(names) > 65535:
+        raise ValueError(f"{arch} alias rows exceed the index width")
+
+    first = {}
+    for i, name in enumerate(names, 1):
+        first.setdefault(name, i)
+    size = 1 << (max(2, 2 * len(first)) - 1).bit_length()
+    slots = [0] * size
+    for name, index in first.items():
+        h = 2166136261
+        for c in name:
+            h = ((h ^ c) * 16777619) & 0xffffffff
+        slot = h & (size - 1)
+        while slots[slot]:
+            slot = (slot + 1) & (size - 1)
+        slots[slot] = index
+    lines = ["/* Generated by suite/synctools/alias_mnemonic_index.py. */"]
+    for i in range(0, size, 16):
+        lines.append("\t" + ", ".join(map(str, slots[i : i + 16])) + ",")
+    return "\n".join(lines) + "\n"
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2] / "arch"
+    for arch in ("ARM", "AArch64", "Mips", "Sparc"):
+        directory = root / arch
+        target = directory / f"{arch}GenAliasIndex.inc"
+        content = generate(directory)
+        if args.check:
+            if target.read_text() != content:
+                raise SystemExit(f"Regenerate {target.name}")
+        else:
+            target.write_text(content)
