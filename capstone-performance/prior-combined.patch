+/* Use the same final stream and mnemonic delimiters for both lookup forms. */
+static const char *alias_mnemonic(const MCInst *MI, const SStream *O,
+				  size_t *length)
 {
-	if (!MCInst_isAlias(MI)) {
-		MI->flat_insn->alias_id = 0;
-		return;
-	}
-
+	if (!MCInst_isAlias(MI))
+		return NULL;
 	int i = 0, j = 0;
 	const char *asm_str_buf = O->buffer;
 	// Skip spaces and tabs
 	while (is_blank_char(asm_str_buf[i])) {
 		if (!asm_str_buf[i]) {
-			MI->flat_insn->alias_id = 0;
-			return;
+			return NULL;
 		}
 		++i;
 	}
@@ -498,9 +492,44 @@ void map_set_alias_id(MCInst *MI, const SStream *O,
 			break;
 	}
 
-	int alias_id = name2id_n(alias_mnem_id_map, map_size, alias_mnem, j);
-	MI->flat_insn->alias_id = alias_id < 0 ? 0 : alias_id;
+	*length = j;
+	return alias_mnem;
+}
+
+void map_set_alias_id(MCInst *MI, const SStream *O, const name_map *map,
+		      int map_size)
+{
+	size_t length;
+	const char *name = alias_mnemonic(MI, O, &length);
+	int id = name ? name2id_n(map, map_size, name, length) : -1;
+	MI->flat_insn->alias_id = id < 0 ? 0 : id;
+}
+
+#if defined(CAPSTONE_HAS_ARM) || defined(CAPSTONE_HAS_AARCH64) || \
+	((defined(CAPSTONE_HAS_MIPS) || defined(CAPSTONE_HAS_SPARC)) && \
+	 !defined(CAPSTONE_DIET))
+void map_set_alias_id_indexed(MCInst *MI, const SStream *O, const name_map *map,
+			      const uint16_t *rows, unsigned mask)
+{
+	size_t length;
+	const char *name = alias_mnemonic(MI, O, &length);
+	MI->flat_insn->alias_id = 0;
+	if (!name)
+		return;
+
+	uint32_t hash = 2166136261u;
+	for (size_t i = 0; i < length; ++i)
+		hash = (hash ^ (unsigned char)name[i]) * 16777619u;
+	for (unsigned slot = hash & mask; rows[slot]; slot = (slot + 1) & mask) {
+		const name_map *entry = &map[rows[slot] - 1];
+		if (strncmp(entry->name, name, length) == 0 &&
+		    entry->name[length] == '\0') {
+			MI->flat_insn->alias_id = entry->id;
+			return;
+		}
+	}
 }
+#endif
 
