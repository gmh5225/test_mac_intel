+/* Register-access queries usually start with just the implicit registers. */
+static inline bool x86_access_contains(uint16_t *regs, uint8_t count,
+				       unsigned int reg)
+{
+	switch (count) {
+	case 0:
+		return false;
+	case 1:
+		return regs[0] == reg;
+	case 2:
+		return regs[0] == reg || regs[1] == reg;
+	default:
+		return arr_exist_inline(regs, count, reg);
+	}
+}
