diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 90ef6e93..6f99ff43 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3757,4 +3757,123 @@ CAPSTONE_INTERNAL uint16_t X86_scanCallTarget(csh ud, const uint8_t *code,
 
 #undef X86_DECODE_INLINE
 
+#ifdef CS_X86_FORMAT_TERMINAL
+static bool formatTerminal(cs_struct *handle, const uint8_t *code,
+					 size_t length, cs_insn *insn, uint16_t *size)
+{
+	InternalInstruction header;
+	initializeInstructionHeader(&header, code, length, handle->mode);
+	const unsigned prefix = (code[0] & 0xf0) == 0x40;
+	if (prefix && header.mode != MODE_64BIT)
+		return false;
+	header.rexPrefix = prefix ? code[0] : 0;
+	const uint8_t *opcode_bytes = code + prefix;
+	setInstructionSizes(&header, false, false);
+	const bool move = (opcode_bytes[0] & 0xfc) == 0x88;
+	const bool stack_reg = (opcode_bytes[0] & 0xf0) == 0x50;
+	const bool escaped = opcode_bytes[0] == 0x0f;
+	const unsigned int offset = escaped ? 2 : 1;
+	const uint8_t opcode = opcode_bytes[offset - 1];
+	header.readerCursor = prefix + offset;
+	int64_t displacement = 0;
+	if (move) {
+		header.readerCursor++;
+	} else if (stack_reg) {
+		header.opcode = opcode;
+		readOpcodeRegister(&header, header.addressSize);
+	} else if (!escaped && ((opcode & 0xf0) == 0x70 || opcode == 0xeb)) {
+		int8_t rel8;
+		if (consumeInt8(&header, &rel8))
+			return false;
+		displacement = rel8;
+	} else if (header.mode == MODE_16BIT) {
+		int16_t rel16;
+		if (consumeInt16(&header, &rel16))
+			return false;
+		displacement = rel16;
+	} else {
+		int32_t rel32;
+		if (consumeInt32(&header, &rel32))
+			return false;
+		displacement = rel32;
+	}
+	header.opcode = opcode;
+	header.opcodeType = escaped ? TWOBYTE : ONEBYTE;
+	const uint64_t decision = legacyTerminalDecision(&header, false, !insn->detail);
+	if (decision & X86_TERMINAL_INDEXED)
+		return false;
+	const unsigned shift = move && (decision & X86_TERMINAL_SPLIT) ?
+				       X86_TERMINAL_REGISTER_SHIFT : 0;
+	const unsigned id = (decision >> shift) & X86_TERMINAL_UID_MASK;
+	if (!id)
+		return false;
+	*size = (uint16_t)header.readerCursor;
+	insn->size = *size;
+	if (insn->detail) {
+		cs_x86 *x86 = &insn->detail->x86;
+		memset(insn->detail, 0, offsetof(cs_detail, x86) + sizeof(*x86));
+		memcpy(x86->opcode, opcode_bytes, offset);
+		x86->rex = header.rexPrefix;
+		x86->addr_size = header.addressSize;
+		if (move) {
+			x86->modrm = opcode_bytes[1];
+			x86->encoding.modrm_offset = prefix + 1;
+		} else if (!stack_reg) {
+			x86->encoding.imm_offset = offset;
+			x86->encoding.imm_size = *size - offset;
+		}
+		X86_get_insn_id(handle, insn, id);
+	} else {
+		insn->id = id;
+	}
+	if (move) {
+		const uint8_t rm = rmFromModRM(opcode_bytes[1]) | (bFromREX(header.rexPrefix) << 3);
+		const uint8_t reg = regFromModRM(opcode_bytes[1]) | (rFromREX(header.rexPrefix) << 3);
+		const OperandType type = !(opcode & 1) ? TYPE_R8 :
+					 header.registerSize == 2 ? TYPE_R16 :
+					 header.registerSize == 4 ? TYPE_R32 : TYPE_R64;
+		uint8_t valid;
+		unsigned dst = llvmRegisterNumber((Reg)fixupRegValue(
+			&header, type, opcode & 2 ? reg : rm, &valid));
+		unsigned src = llvmRegisterNumber((Reg)fixupRegValue(
+			&header, type, opcode & 2 ? rm : reg, &valid));
+		X86_writeRegistersIntel(handle, insn, id, dst, src);
+	} else if (stack_reg) {
+		X86_writeRegistersIntel(handle, insn, id,
+					   llvmRegisterNumber(header.opcodeRegister), 0);
+	} else {
+		uint64_t target = X86_relativeBranchTarget(handle->mode, insn->address,
+							  *size, displacement, header.immSize);
+		X86_writeRelativeIntel(handle, insn, target, id, header.immSize);
+	}
+	return true;
+}
+
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
+X86_tryWriteTerminal(cs_struct *handle, const uint8_t *code, size_t size,
+	       cs_insn *insn, uint16_t *insn_size)
+{
+	/* The register and relative terminals below have fixed Intel operand layouts. */
+	if (!handle->no_text && size &&
+	    (insn->detail != NULL) == (handle->detail_opt != 0) &&
+	    (((code[0] & 0xf0) == 0x40 && size >= 3 && (code[1] & 0xfc) == 0x88 && code[2] >= 0xc0) ||
+	     ((code[0] & 0xfc) == 0x88 && size >= 2 && code[1] >= 0xc0) ||
+	     (code[0] & 0xf0) == 0x50 || (code[0] & 0xf0) == 0x70 ||
+	     (code[0] & 0xfe) == 0xe8 || code[0] == 0xeb ||
+	     (code[0] == 0x0f && size >= 2 && (code[1] & 0xf0) == 0x80)) &&
+	    handle->syntax == CS_OPT_SYNTAX_INTEL && !handle->mnem_list &&
+	    cs_vsnprintf == cs_default_vsnprintf &&
+	    formatTerminal(handle, code, size, insn, insn_size)) {
+		copy_insn_bytes(insn, code, true);
+		return true;
+	}
+	return false;
+}
+#endif
+
 #endif
