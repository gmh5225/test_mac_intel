+void X86_postprinter(csh handle, cs_insn *insn, SStream *mnem, MCInst *mci)
+{
+	if (!insn)
+		return;
+	if (insn->id != X86_INS_VPCMP) {
+		if (!insn->detail)
+			return;
+		cs_x86 *x86 = &insn->detail->x86;
+		/* Only vector prefixes, x87 and the rotate/shift group can
+		 * need the other repairs. A custom formatter can still supply
+		 * broadcast text for an ordinary memory operand. */
+		if ((x86->opcode[0] & 0xe0) != 0xc0 && x86->opcode[0] != 0x62) {
+			for (uint8_t i = 0; i < x86->op_count; ++i) {
+				cs_x86_op *operand = &x86->operands[i];
+				if (operand->type == X86_OP_MEM) {
+					repair_avx_broadcast(operand, mnem);
+					return;
+				}
+			}
+			return;
+		}
+	}
+	repair_extended_insn(handle, insn, mnem, mci);
+}
