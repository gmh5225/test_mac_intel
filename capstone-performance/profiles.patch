diff --git a/arch/X86/X86IntelInstPrinter.c b/arch/X86/X86IntelInstPrinter.c
index 457485ab..3b26e8bd 100644
--- a/arch/X86/X86IntelInstPrinter.c
+++ b/arch/X86/X86IntelInstPrinter.c
@@ -924,6 +924,84 @@ void X86_Intel_printInst(MCInst *MI, SStream *O, void *Info)
 
 #endif // CAPSTONE_SSTREAM_PRECHECKED
 
+static inline void setRelativeOperand(cs_x86 *x86, int64_t target, uint8_t table_size,
+				      uint8_t immediate_size)
+{
+	cs_x86_op *op = &x86->operands[x86->op_count];
+	op->type = X86_OP_IMM;
+	op->size = x86->op_count ? x86->operands[0].size :
+				   (table_size ? table_size : immediate_size);
+	op->imm = target;
+}
+
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_SSTREAM_PRECHECKED)
+static inline void writeIntelMnemonic(cs_struct *handle, cs_insn *insn)
+{
+	const char *mnemonic = X86_insn_name((csh)(uintptr_t)handle, insn->id);
+	strncpy(insn->mnemonic, mnemonic, sizeof(insn->mnemonic));
+}
+
+static inline void setRegisterOperand(cs_struct *handle, cs_x86_op *op,
+				      unsigned mc_reg, uint8_t access)
+{
+	op->type = X86_OP_REG;
+	op->reg = X86_register_map(mc_reg);
+	op->size = handle->regsize_map[op->reg];
+	op->access = access;
+}
+
+void X86_writeRegistersIntel(cs_struct *handle, cs_insn *insn, unsigned uid,
+			     unsigned first, unsigned second)
+{
+	if (insn->detail) {
+		cs_x86 *x86 = &insn->detail->x86;
+		uint8_t access[CS_X86_MAXIMUM_OPERAND_SIZE];
+		get_op_access(handle, uid, access, &x86->eflags);
+		setRegisterOperand(handle, &x86->operands[0], first, access[0]);
+		if (second)
+			setRegisterOperand(handle, &x86->operands[1], second, access[1]);
+		x86->op_count = second ? 2 : 1;
+	}
+	writeIntelMnemonic(handle, insn);
+	if (!second) {
+		strncpy(insn->op_str, getRegisterName(first), sizeof(insn->op_str));
+		return;
+	}
+	unsigned n = getRegisterNameLength(first);
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, getRegisterName(first), n);
+	insn->op_str[n] = ',';
+	insn->op_str[n + 1] = ' ';
+	memcpy(insn->op_str + n + 2, getRegisterName(second), getRegisterNameLength(second));
+}
+
+void X86_writeRelativeIntel(cs_struct *handle, cs_insn *insn, uint64_t target,
+			    unsigned uid, uint8_t immediate_size)
+{
+	if (insn->detail) {
+		cs_x86 *x86 = &insn->detail->x86;
+		uint8_t access[CS_X86_MAXIMUM_OPERAND_SIZE];
+		setRelativeOperand(x86, (int64_t)target, X86_immediate_size(uid, NULL),
+				   immediate_size);
+		get_op_access(handle, uid, access, &x86->eflags);
+		x86->operands[0].access = access[0];
+		x86->op_count = 1;
+	}
+	writeIntelMnemonic(handle, insn);
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	if (target <= HEX_THRESHOLD) {
+		insn->op_str[0] = (char)('0' + target);
+	} else {
+		char digits[16];
+		char *end = digits + sizeof(digits);
+		char *first = SStream_hex_digits(end, target);
+		insn->op_str[0] = '0';
+		insn->op_str[1] = 'x';
+		memcpy(insn->op_str + 2, first, (size_t)(end - first));
+	}
+}
+#endif
