+/* Write the digits backward so the caller can append or copy them as a span. */
+static inline char *SStream_hex_digits(char *end, uint64_t value)
+{
+	do {
+		*--end = "0123456789abcdef"[value & 15];
+		value >>= 4;
+	} while (value);
+	return end;
+}
+
 // Append a lowercase 0x-prefixed magnitude, optionally preceded by a minus sign.
