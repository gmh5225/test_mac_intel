+/* A public scan observes the terminal ID and length. The compact descriptor
+ * already rejects special ModR/M forms. Only a no-base SIB changes the
+ * ordinary 32/64-bit address length after the ModR/M byte has been read. */
+X86_DECODE_INLINE unsigned scanModRMEnd(const uint8_t *code, size_t size,
+					size_t offset, unsigned addressSize)
+{
+	if (offset >= 15 || offset >= size)
+		return 0;
+	const uint8_t modrm = code[offset];
+	const unsigned mod = modrm >> 6, rm = modrm & 7;
+	unsigned end = (unsigned)offset + 1;
+	if (addressSize == 2) {
+		static const uint8_t disp[4] = { 0, 1, 2, 0 };
+		return end + disp[mod] + ((modrm & 0xc7) == 6 ? 2 : 0);
+	}
+	static const uint8_t extra[4][8] = {
+		{ 0, 0, 0, 0, 1, 4, 0, 0 },
+		{ 1, 1, 1, 1, 2, 1, 1, 1 },
+		{ 4, 4, 4, 4, 5, 4, 4, 4 },
+		{ 0, 0, 0, 0, 0, 0, 0, 0 },
+	};
+	if ((modrm & 0xc7) == 4) {
+		if (end >= size)
+			return 0;
+		if ((code[end] & 7) == 5)
+			end += 4;
+	}
+	return end + extra[mod][rm];
+}
