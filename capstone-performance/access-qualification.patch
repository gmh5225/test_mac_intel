+#ifndef CAPSTONE_DIET
+static bool check_access_row(size_t i)
+{
+	uint8_t first = CS_AC_READ;
+	uint8_t second = CS_AC_READ;
+	bool preserve_flags = false;
+	switch (insns[i].mapid) {
+	case X86_INS_BOUND:
+	case X86_INS_UD1:
+		preserve_flags = true;
+		break;
+	case X86_INS_CMPXCHG:
+		first = CS_AC_READ_WRITE;
+		break;
+	case X86_INS_CMPXCHG8B:
+	case X86_INS_CMPXCHG16B:
+		first = CS_AC_READ_WRITE;
+		second = 0;
+		break;
+	default:
+		return true;
+	}
+
+	uint64_t flags = UINT64_MAX;
+	const uint8_t *access = X86_get_op_access(NULL, insns[i].id, &flags);
+	return access && access[0] == first && access[1] == second &&
+	       (!second || !access[2]) && (!preserve_flags || flags == 0);
+}
+#endif
