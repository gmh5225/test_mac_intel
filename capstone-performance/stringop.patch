+/* These fixed-size stores are on the per-instruction output path. */
+#if defined(_MSC_VER) && !defined(__clang__) && defined(_M_X64) && \
+	!defined(_M_ARM64EC) && !defined(_KERNEL_MODE)
+#include <intrin.h>
+#pragma intrinsic(__stosb)
+static __forceinline void cs_zero_fixed(void *buffer, size_t length)
+{
+	__stosb((unsigned char *)buffer, 0, length);
+}
+#else
+#define cs_zero_fixed(buffer, length) memset((buffer), 0, (length))
+#endif
