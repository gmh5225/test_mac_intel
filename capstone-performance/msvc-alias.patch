+def _register_writer(stream: Node, operands: list[Node], statement: Node, src: bytes):
+    """Lower a complete void register writer, including its callback fallback."""
+    body = statement.parent
+    if (
+        not body
+        or body.type != "compound_statement"
+        or body.named_child_count != 1
+        or not body.parent
+        or body.parent.type != "function_definition"
+        or body.parent.child_by_field_name("type") is None
+        or get_text_from_node(src, body.parent.child_by_field_name("type")) != b"void"
+    ):
+        return None
+    if len(operands) == 3:
+        if (
+            stream.type != "identifier"
+            or get_text_from_node(src, operands[0]) != b'markup("<reg:")'
+            or get_text_from_node(src, operands[2]) != b'markup(">")'
+        ):
+            return None
+        name = operands[1]
+    elif len(operands) == 1 and stream.type == "call_expression":
+        if get_text_from_node(src, stream.child_by_field_name("function")) != b"markup":
+            return None
+        args = stream.child_by_field_name("arguments").named_children
+        if (
+            len(args) != 2
+            or args[0].type != "identifier"
+            or get_text_from_node(src, args[1]) != b"Markup::Register"
+        ):
+            return None
+        stream, name = args[0], operands[0]
+    else:
+        return None
+    if (
+        name.type != "call_expression"
+        or get_text_from_node(src, name.child_by_field_name("function"))
+        != b"getRegisterName"
+    ):
+        return None
+    local = b"name"
+    function = get_text_from_node(src, body.parent)
+    while local in function:
+        local += b"_"
+    return (
+        REGISTER_WRITER.replace(b"$LOCAL", local)
+        .replace(b"$STREAM", get_text_from_node(src, stream))
+        .replace(b"$NAME", get_text_from_node(src, name))
+    )
+
+
+REGISTER_WRITER = br"""#if !defined(CAPSTONE_DIET) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+    !defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+    !defined(_WIN32_WCE)
+    const char *$LOCAL = $NAME;
+    /* With markup disabled the two empty tags contribute no bytes. The
+     * generic formatter still owns custom callbacks and full streams. */
+    if (cs_vsnprintf == cs_default_vsnprintf && !getUseMarkup() &&
+        $STREAM->index < SSTREAM_BUF_LEN - 1 && $LOCAL && $LOCAL[0]) {
+        SStream_concat0($STREAM, $LOCAL);
+        return;
+    }
+    SStream_concat2($STREAM, markup("<reg:"), $LOCAL);
+#else
+    SStream_concat2($STREAM, markup("<reg:"),
+            $NAME);
+#endif
+    SStream_concat0($STREAM, markup(">"));"""
+
