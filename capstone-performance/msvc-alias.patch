index 2332dac8..a6abbd69 100644
--- a/Mapping.c
+++ b/Mapping.c
@@ -477,6 +477,49 @@ static inline bool char_ends_mnem(const char c, cs_arch arch)
 	}
 }
 
+#if CS_MSVC_X64_NATIVE
+/* Use the same final stream and mnemonic delimiters for both lookup forms. */
+#if defined(_MSC_VER)
+static __forceinline
+#elif defined(__GNUC__)
+static inline __attribute__((always_inline))
+#else
+static inline
+#endif
+const char *alias_mnemonic(const MCInst *MI, const SStream *O, size_t *length,
+			   uint32_t *hash)
+{
+	if (!MCInst_isAlias(MI))
+		return NULL;
+	const char *name = O->buffer;
+	while (is_blank_char(*name))
+		++name;
+
+	/* The indexed reader hashes exactly the bytes consumed by the linear
+	 * reader, including the architecture's delimiter and length rules. */
+	uint32_t value = 2166136261u;
+	size_t n = 0;
+	while (n < 15 && !char_ends_mnem(name[n], MI->csh->arch)) {
+		if (hash)
+			value = (value ^ (unsigned char)name[n]) * 16777619u;
+		++n;
+	}
+	*length = n;
+	if (hash)
+		*hash = value;
+	return name;
+}
+
+void map_set_alias_id(MCInst *MI, const SStream *O, const name_map *map,
+		      int map_size)
+{
+	size_t length;
+	const char *name = alias_mnemonic(MI, O, &length, NULL);
+	int id = name ? name2id_n(map, map_size, name, length) : -1;
+	MI->flat_insn->alias_id = id < 0 ? 0 : id;
+}
+
+#else
 /// Sets an alternative id for some instruction.
 /// Or -1 if it fails.
 /// You must add (<ARCH>_INS_ALIAS_BEGIN + 1) to the id to get the real id.
@@ -509,6 +552,8 @@ void map_set_alias_id(MCInst *MI, const SStream *O,
 	MI->flat_insn->alias_id = alias_id < 0 ? 0 : alias_id;
 }
 
+#endif
+
 /// Does a binary search over the given map and searches for @id.
 /// If @id exists in @map, it sets @found to true and returns
 /// the value for the @id.
@@ -555,3 +600,29 @@ uint64_t enum_map_bin_search(const cs_enum_id_map *map, size_t map_len,
 	*found = false;
 	return UINT64_MAX;
 }
+
+#if CS_MSVC_X64_NATIVE
+#if defined(CAPSTONE_HAS_AARCH64) || \
+	((defined(CAPSTONE_HAS_MIPS) || defined(CAPSTONE_HAS_POWERPC) || \
+	  defined(CAPSTONE_HAS_SPARC)) && !defined(CAPSTONE_DIET))
+void map_set_alias_id_indexed(MCInst *MI, const SStream *O, const name_map *map,
+			      const uint16_t *rows, unsigned mask)
+{
+	size_t length;
+	uint32_t hash;
+	const char *name = alias_mnemonic(MI, O, &length, &hash);
+	MI->flat_insn->alias_id = 0;
+	if (!name)
+		return;
+
+	for (unsigned slot = hash & mask; rows[slot]; slot = (slot + 1) & mask) {
+		const name_map *entry = &map[rows[slot] - 1];
+		if (strncmp(entry->name, name, length) == 0 &&
+		    entry->name[length] == '\0') {
+			MI->flat_insn->alias_id = entry->id;
+			return;
+		}
+	}
+}
+#endif
+#endif
