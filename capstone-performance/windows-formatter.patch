+def simple_public_tail_size(calls, address_size):
+    # A plain 32/64-bit legacy header starts with a 4-byte immediate width.
+    # Evaluate the same ordered readers used by the generic public scan.
+    width = 4
+    length = 0
+    tables.require(len(calls) <= 2, "Too many immediate operands")
+    for call in calls:
+        if call == "readMemoryOffset(insn, false)":
+            length += address_size
+            width = 0
+        else:
+            match = re.fullmatch(r"readImmediateImpl\(insn, (1|2|4|8|insn->immediateSize), false\)", call)
+            tables.require(match is not None, "Unexpected immediate reader")
+            if match[1] != "insn->immediateSize":
+                width = int(match[1])
+            tables.require(width in (1, 2, 4, 8), "Unknown immediate width")
+            length += width
+    return length
+
