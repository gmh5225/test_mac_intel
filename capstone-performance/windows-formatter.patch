+        "\t\t\tbreak;",
+        "\t\tdefault:",
+        f"\t\t\treturn {invalid};",
+        "\t\t}",
+        f"\t\t{assign}{table};",
+        "\t} else {",
+        f"\t\tunsigned int shift = (decision & X86_TERMINAL_SPLIT) && {modrm} >= 0xc0 ?",
+        "\t\t\tX86_TERMINAL_REGISTER_SHIFT : 0;",
+        f"\t\t{assign}(decision >> shift) & X86_TERMINAL_MASK;",
+        "\t}",
