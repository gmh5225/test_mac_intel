+        "\t\tcase MODRM_SPLITMISC:",
+        f"\t\t\tindex += {modrm} >= 0xc0 ? ({modrm} & 0x3f) + 8 : regFromModRM({modrm});",
+        "\t\t\tbreak;",
+        "\t\tcase MODRM_FULL:",
