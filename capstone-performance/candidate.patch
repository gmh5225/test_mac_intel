diff --git a/arch/X86/X86ImplicitRegPair.h b/arch/X86/X86ImplicitRegPair.h
new file mode 100644
index 00000000..623d97d7
--- /dev/null
+++ b/arch/X86/X86ImplicitRegPair.h
@@ -0,0 +1,18 @@
+/* Capstone Disassembly Engine. SPDX-License-Identifier: BSD-3-Clause */
+#ifndef CS_X86_IMPLICIT_REG_PAIR_H
+#define CS_X86_IMPLICIT_REG_PAIR_H
+
+/* Most opcodes have no pair embedded in their assembly string. */
+static inline bool X86_hasImplicitRegPair(unsigned int opcode)
+{
+	switch (opcode) {
+#define X86_REG_PAIR(op, r1, r2, a1, a2) case X86_##op:
+#include "X86ImplicitRegPair.inc"
+#undef X86_REG_PAIR
+		return true;
+	default:
+		return false;
+	}
+}
+
+#endif
