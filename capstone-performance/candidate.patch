diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 90ef6e93..07405ab7 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3757,4 +3757,50 @@ CAPSTONE_INTERNAL uint16_t X86_scanCallTarget(csh ud, const uint8_t *code,
 
 #undef X86_DECODE_INLINE
 
+#ifndef CAPSTONE_DIET
+CAPSTONE_INTERNAL bool X86_formatRelative(cs_struct *handle, const uint8_t *code,
+					 size_t length, cs_insn *insn, uint16_t *size)
+{
+	InternalInstruction header;
+	initializeInstructionHeader(&header, code, length, handle->mode);
+	header.rexPrefix = 0;
+	setInstructionSizes(&header, false, false);
+	const bool escaped = code[0] == 0x0f;
+	const unsigned int offset = escaped ? 2 : 1;
+	const uint8_t opcode = code[offset - 1];
+	header.readerCursor = offset;
+	int64_t displacement;
+	if (!escaped && ((opcode & 0xf0) == 0x70 || opcode == 0xeb)) {
+		int8_t rel8;
+		if (consumeInt8(&header, &rel8))
+			return false;
+		displacement = rel8;
+	} else if (header.mode == MODE_16BIT) {
+		int16_t rel16;
+		if (consumeInt16(&header, &rel16))
+			return false;
+		displacement = rel16;
+	} else {
+		int32_t rel32;
+		if (consumeInt32(&header, &rel32))
+			return false;
+		displacement = rel32;
+	}
+	const unsigned row = header.mode == MODE_16BIT ? X86_TERMINAL_16 :
+			     header.mode == MODE_32BIT ? X86_TERMINAL_32 :
+							 X86_TERMINAL_64;
+	const unsigned public_id = x86LegacyPublicDecisions[row][escaped][opcode] &
+				   X86_TERMINAL_UID_MASK;
+	if (!public_id)
+		return false;
+	*size = (uint16_t)header.readerCursor;
+	insn->size = *size;
+	insn->id = public_id;
+	uint64_t target = X86_relativeBranchTarget(handle->mode, insn->address,
+						  *size, displacement, header.immSize);
+	X86_writeRelativeIntel(handle, insn, target);
+	return true;
+}
+#endif
+
 #endif
diff --git a/arch/X86/X86IntelInstPrinter.c b/arch/X86/X86IntelInstPrinter.c
index 457485ab..5d7bf0ac 100644
--- a/arch/X86/X86IntelInstPrinter.c
+++ b/arch/X86/X86IntelInstPrinter.c
@@ -924,6 +924,25 @@ void X86_Intel_printInst(MCInst *MI, SStream *O, void *Info)
 
 #endif // CAPSTONE_SSTREAM_PRECHECKED
 
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_SSTREAM_PRECHECKED)
+void X86_writeRelativeIntel(cs_struct *handle, cs_insn *insn, uint64_t target)
+{
+	const char *mnemonic = X86_insn_name((csh)(uintptr_t)handle, insn->id);
+	strncpy(insn->mnemonic, mnemonic, sizeof(insn->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	if (target <= HEX_THRESHOLD) {
+		insn->op_str[0] = (char)('0' + target);
+	} else {
+		char digits[16];
+		char *end = digits + sizeof(digits);
+		char *first = SStream_hex_digits(end, target);
+		insn->op_str[0] = '0';
+		insn->op_str[1] = 'x';
+		memcpy(insn->op_str + 2, first, (size_t)(end - first));
+	}
+}
+#endif
