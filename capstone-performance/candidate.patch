+    patterns = {}
+    indices = []
+    for (opcode, flags, access), mapped in zip(rows, mapping):
+        if opcode != mapped[1]:
+            raise ValueError(f"Operand-access row does not match {mapped[1]}")
+        operands = tuple(item.strip() for item in access.split(","))
+        if len(operands) > 6 or operands[-1] != "0":
+            raise ValueError(f"Invalid operand-access list for {opcode}")
+        key = (" ".join(flags.split()), operands)
+        indices.append(patterns.setdefault(key, len(patterns)))
+
+    lines = ["static const insn_op x86_access_patterns[] = {"]
+    for flags, operands in patterns:
+        lines.append("\t{ " + flags + ", { " + ", ".join(operands) + " } },")
+    index_type = "uint8_t" if len(patterns) <= 256 else "uint16_t"
+    lines += ["};", "", f"static const {index_type} x86_access_indices[] = {{"]
+    for start in range(0, len(indices), 16):
+        lines.append("\t" + ", ".join(map(str, indices[start : start + 16])) + ",")
+    lines.append("};")
+    return "\n".join(lines)
