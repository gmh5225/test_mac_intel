+static inline void SStream_init_options(SStream *ss, bool unsigned_num)
+{
+	assert(ss);
+	ss->index = 0;
+	memset(ss->buffer, 0, sizeof(ss->buffer));
+	ss->is_closed = false;
+	ss->markup_stream = false;
+	ss->prefixed_by_markup = false;
+	ss->unsigned_num = unsigned_num;
+}
