index ae1554b0..da53269e 100644
--- a/arch/X86/X86Disassembler.h
+++ b/arch/X86/X86Disassembler.h
@@ -47,6 +47,16 @@ typedef struct X86ScanResult {
 	uint8_t popcode_adjust;
 } X86ScanResult;
 
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#include "../../cs_priv.h"
+#define CAPSTONE_X86_VECTOR_OUTPUT
+CAPSTONE_INTERNAL bool X86_scanEvexOutputForm(const uint8_t *code, size_t size,
+					     X86ScanResult *result);
+#endif
+
 bool X86_getInstructionScanResult(csh handle, const uint8_t *code,
 				  size_t code_len, cs_insn *insn,
 				  X86ScanResult *result);
diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 76fdbcb7..1e978af3 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3365,6 +3365,15 @@ decodeScanResultFallback(csh ud, const uint8_t *code, size_t code_len,
 			return true;
 		}
 	}
+#endif
+#ifdef CAPSTONE_X86_VECTOR_OUTPUT
+	/* Only complete ordinary forms verified by the full decoder have rows.
+     * The adapter above still owns its callback and all misses use the
+     * feature decoder's original order, including malformed prefixes. */
+	if (opcode == 0x62 && handle->mode == CS_MODE_64 &&
+	    handle->insn_id == X86_get_insn_id &&
+	    X86_scanEvexOutputForm(code, code_len, result))
+		return true;
 #endif
 	if (tryExtension && (code_len >= 4 && code[0] == 0xc4 &&
 			     !(handle->mode & (CS_MODE_16 | CS_MODE_32)) &&
