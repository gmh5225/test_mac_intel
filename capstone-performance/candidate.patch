+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include "X86InstPrinter.h"
+#include "../../MathExtras.h"
+
+#if defined(CAPSTONE_HAS_X86) && defined(CAPSTONE_X86_PRECHECKED_PRINTER)
+#if defined(__GNUC__) && __SIZEOF_POINTER__ == 8 && \
+	__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+#define X86_HEX_WORD
+static inline uint64_t hexAsciiWord(uint32_t value)
+{
+	uint64_t spread = value;
+	spread = (spread | (spread << 16)) & UINT64_C(0x0000ffff0000ffff);
+	spread = (spread | (spread << 8)) & UINT64_C(0x00ff00ff00ff00ff);
+	spread = (spread | (spread << 4)) & UINT64_C(0x0f0f0f0f0f0f0f0f);
+	/* Adding six distinguishes the alphabetic nibbles in each byte. */
+	uint64_t letters = ((spread + UINT64_C(0x0606060606060606)) &
+			    UINT64_C(0x1010101010101010)) >>
+			   4;
+	uint64_t ascii = spread + UINT64_C(0x3030303030303030) + letters * 39;
+	return __builtin_bswap64(ascii);
+}
+#endif
+
+// The private printer entry proves a plain open stream, default formatter and
+// capacity for the complete generated output. A signed uint64 hexadecimal
+// spelling needs at most 19 bytes, already included in that generated bound.
+static void word_hex(SStream *OS, uint64_t value, bool negative)
+{
+#ifdef X86_HEX_WORD
+	if (value < 256) {
+		char *out = OS->buffer + OS->index;
+		uint32_t text = 0x7830;
+		if (negative)
+			*out++ = '-';
+		if (value >= 16) {
+			text |= (uint32_t)"0123456789abcdef"[value >> 4] << 16;
+			text |= (uint32_t)"0123456789abcdef"[value & 15] << 24;
+			memcpy(out, &text, 4);
+			out += 4;
+			*out = '\0';
+		} else {
+			text |= (uint32_t)"0123456789abcdef"[value] << 16;
+			memcpy(out, &text, 4);
+			out += 3;
+		}
+		OS->index = (size_t)(out - OS->buffer);
+		return;
+	}
+#endif
+	const unsigned digits =
+		value ? (64U - CountLeadingZeros_64(value) + 3U) / 4U : 1U;
+	char *out = OS->buffer + OS->index;
+	OS->index += digits + (negative ? 3U : 2U);
+	char *end = OS->buffer + OS->index;
+	if (negative)
+		*out++ = '-';
+	*out++ = '0';
+	*out = 'x';
+	*end = '\0';
+
+#ifdef X86_HEX_WORD
+	if (digits >= 5) {
+		unsigned head_digits = digits;
+		if (digits > 8) {
+			uint64_t tail = hexAsciiWord((uint32_t)value);
+			memcpy(end - 8, &tail, 8);
+			end -= 8;
+			value >>= 32;
+			head_digits -= 8;
+		}
+		uint64_t head = hexAsciiWord((uint32_t)value);
+		head >>= (8 - head_digits) * 8;
+		out = end - head_digits;
+		if (head_digits >= 4) {
+			memcpy(out, &head, 4);
+			head >>= (head_digits - 4) * 8;
+			memcpy(end - 4, &head, 4);
+		} else if (head_digits >= 2) {
+			memcpy(out, &head, 2);
+			head >>= (head_digits - 2) * 8;
+			memcpy(end - 2, &head, 2);
+		} else {
+			*out = (char)head;
+		}
+		return;
+	}
+#endif
+#ifdef X86_HEX_WORD
+	if (digits >= 4)
+		end[-4] = "0123456789abcdef"[(value >> 12) & 15];
+	if (digits >= 3)
+		end[-3] = "0123456789abcdef"[(value >> 8) & 15];
+	if (digits >= 2)
+		end[-2] = "0123456789abcdef"[(value >> 4) & 15];
+	end[-1] = "0123456789abcdef"[value & 15];
+#else
+	do {
+		*--end = "0123456789abcdef"[value & 15];
+		value >>= 4;
+	} while (value);
+#endif
+}
+#endif
+
+#if defined(CAPSTONE_HAS_X86) && defined(CAPSTONE_X86_PRECHECKED_PRINTER)
+static void (*hex_writer)(SStream *, uint64_t, bool) = scalar_hex;
+void benchmark_set_hex_variant(int variant)
+{
+    hex_writer = variant ? word_hex : scalar_hex;
+}
+void X86_Intel_printHexPrechecked(SStream *stream, uint64_t value, bool negative)
+{
+    hex_writer(stream, value, negative);
+}
+#endif
