new file mode 100644
index 00000000..69001b93
--- /dev/null
+++ b/arch/X86/X86ImplicitRegPair.inc
@@ -0,0 +1,10 @@
+/* Capstone Disassembly Engine. SPDX-License-Identifier: BSD-3-Clause */
+/* Instructions with both registers embedded in the assembly string. */
+X86_REG_PAIR(IN16rr, AX, DX, WRITE, READ)
+X86_REG_PAIR(IN32rr, EAX, DX, WRITE, READ)
+X86_REG_PAIR(IN8rr, AL, DX, WRITE, READ)
+X86_REG_PAIR(INVLPGA32, EAX, ECX, READ, READ)
+X86_REG_PAIR(INVLPGA64, RAX, ECX, READ, READ)
+X86_REG_PAIR(OUT16rr, DX, AX, READ, READ)
+X86_REG_PAIR(OUT32rr, DX, EAX, READ, READ)
+X86_REG_PAIR(OUT8rr, DX, AL, READ, READ)
