+		      size_t codeSize, cs_mode mode, size_t opcodeOffset)
 {
 	initializeInstructionHeader(insn, code, codeSize, mode);
 
+	/* The extension probe already walked these bytes. An ordinary
+	 * one-byte opcode after zero or one REX prefix needs no second walk. */
+	if (opcodeOffset < 2 && (!opcodeOffset || isREX(insn, code[0]))) {
+		uint8_t opcode = code[opcodeOffset];
+		if (feature_prefix_flags[opcode] == 0) {
+			readSimpleLegacyPrefix(insn, opcodeOffset);
+			++insn->readerCursor;
+			insn->firstByte = opcode;
+			insn->opcode = opcode;
+			insn->opcodeType = ONEBYTE;
+			return PREFIX_READ_SIMPLE_LEGACY;
+		}
+	}
