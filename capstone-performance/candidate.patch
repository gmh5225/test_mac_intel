+/* A single segment override on a 32-bit LEA changes the printed segment and
+ * the public offsets. The unprefixed writer owns address decoding. */
+bool X86_writeSegmentLea(const uint8_t *code, size_t size, cs_insn *insn,
+			 uint16_t *insn_size, const struct X86SimpleOutput *row,
+			 const struct X86SimpleRegister regs[4][16])
+{
+	if (size < 3 || code[1] != 0x8d || code[2] >= 0xc0)
+		return false;
+	if (!X86_writeMemoryOutput(code + 1, size - 1, insn, insn_size, row,
+				   regs))
+		return false;
+
+	static const struct {
+		x86_reg reg;
+		char name[3];
+	} segments[] = {
+		{ X86_REG_ES, "es" }, { X86_REG_CS, "cs" },
+		{ X86_REG_SS, "ss" }, { X86_REG_DS, "ds" },
+		{ X86_REG_FS, "fs" }, { X86_REG_GS, "gs" },
+	};
+	unsigned segment = code[0] >= 0x64 ? 4u + (code[0] & 1) :
+					     (code[0] >> 3) & 3;
+	char *memory = insn->op_str + regs[2][(code[2] >> 3) & 7].length + 2;
+	memmove(memory + 3, memory, strlen(memory) + 1);
+	memcpy(memory, segments[segment].name, 2);
+	memory[2] = ':';
+	*insn_size = ++insn->size;
+	memcpy(insn->bytes, code, *insn_size);
+	if (insn->detail) {
+		cs_x86 *x = &insn->detail->x86;
+		x->prefix[1] = code[0];
+		++x->encoding.modrm_offset;
+		if (x->encoding.disp_size)
+			++x->encoding.disp_offset;
+		x->operands[1].mem.segment = segments[segment].reg;
+	}
+	return true;
+}
+
 #endif
 #endif
