+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+// Build against full x86 Capstone and redirect stdout to X86GenVectorOutput.inc.
+#include <capstone/capstone.h>
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <stdexcept>
