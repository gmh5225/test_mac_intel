diff --git a/arch/X86/X86Mapping.c b/arch/X86/X86Mapping.c
index df60fd3f..f362b394 100644
--- a/arch/X86/X86Mapping.c
+++ b/arch/X86/X86Mapping.c
@@ -10227,6 +10227,15 @@ unsigned int find_insn(unsigned int id)
 
 static inline unsigned int find_insn_h(cs_struct *h, unsigned int id)
 {
+	/* The mapping is strictly sorted by internal ID. If its span equals
+	 * its row count, every ID in that interval has a row. */
+	const unsigned int first = insns[0].id;
+	const unsigned int last = insns[ARR_SIZE(insns) - 1].id;
+	if (last - first == ARR_SIZE(insns) - 1) {
+		const unsigned int index = id - first;
+		return index < ARR_SIZE(insns) ? index : (unsigned int)-1;
+	}
+
 	if (h && h->x86_insn_lut && id <= h->x86_insn_lut_max)
 		return (unsigned int)(int16_t)(uint16_t)h->x86_insn_lut[id];
 
