+#ifdef CS_X86_SHARED_LOOKUPS
+/* Publish only fully initialized tables. A concurrent first opener can use
+ * its private tables without waiting for the publishing thread. */
+static bool useSharedLookups(cs_struct *h, unsigned int id_max)
+{
+	static uint32_t insn_lookup[X86_INSTRUCTION_LIST_END];
+	static uint32_t reg_lookup[X86_INSTRUCTION_LIST_END];
+	enum { empty, building, ready };
+	static unsigned int state;
+	if (cs_mem_malloc != malloc || cs_mem_calloc != calloc ||
+	    cs_mem_realloc != realloc || cs_mem_free != free ||
+	    cs_vsnprintf != cs_default_vsnprintf)
+		return false;
+	if (__atomic_load_n(&state, __ATOMIC_ACQUIRE) != ready) {
+		unsigned int expected = empty;
+		if (!__atomic_compare_exchange_n(&state, &expected, building,
+						 false, __ATOMIC_RELAXED,
+						 __ATOMIC_RELAXED))
+			return false;
+		fillInsnLookup(insn_lookup, id_max);
+		fillImplicitRegLookup(reg_lookup, id_max);
+		__atomic_store_n(&state, ready, __ATOMIC_RELEASE);
+	}
+	h->x86_insn_lut = insn_lookup;
+	h->x86_insn_reg_lut = reg_lookup;
+	h->x86_shared_lookups = true;
+	return true;
+}
+#endif
+
+void X86_build_lookup_tables(cs_struct *h)
+{
+	unsigned int max = ARR_SIZE(insns);
+	unsigned int id_max;
+
+	CS_ASSERT_RET(h && !h->x86_insn_lut);
+	CS_ASSERT_RET(max <= INT16_MAX && X86_INS_ENDING < UINT16_MAX);
+
+	id_max = insns[max - 1].id;
+	h->x86_insn_lut_max = id_max;
+#ifdef CS_X86_SHARED_LOOKUPS
+	if (useSharedLookups(h, id_max))
+		return;
+#endif
+	h->x86_insn_lut =
+		(uint32_t *)cs_mem_malloc((id_max + 1) * sizeof(uint32_t));
+	CS_ASSERT_RET(h->x86_insn_lut);
+
+	fillInsnLookup(h->x86_insn_lut, id_max);
+
+	h->x86_insn_reg_lut =
+		(uint32_t *)cs_mem_calloc(id_max + 1, sizeof(uint32_t));
+	if (!h->x86_insn_reg_lut)
+		return;
+
+	fillImplicitRegLookup(h->x86_insn_reg_lut, id_max);
+}
