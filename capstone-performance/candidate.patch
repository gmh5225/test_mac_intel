-	cs_mem_free(ud->x86_insn_reg_lut);
+#ifdef CS_X86_SHARED_LOOKUPS
+	if (!ud->x86_shared_lookups)
+#endif
+	{
+		cs_mem_free(ud->x86_insn_lut);
+		cs_mem_free(ud->x86_insn_reg_lut);
+	}
 
 	memset(ud, 0, sizeof(*ud));
 	cs_mem_free(ud);
