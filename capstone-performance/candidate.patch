diff --git a/arch/X86/X86ImplicitRegPair.h b/arch/X86/X86ImplicitRegPair.h
new file mode 100644
index 00000000..09b417ba
--- /dev/null
+++ b/arch/X86/X86ImplicitRegPair.h
@@ -0,0 +1,38 @@
+/* Capstone Disassembly Engine. SPDX-License-Identifier: BSD-3-Clause */
+#ifndef CS_X86_IMPLICIT_REG_PAIR_H
+#define CS_X86_IMPLICIT_REG_PAIR_H
+
+/* These encodings embed both registers in the generated assembly string. */
+static inline bool X86_getImplicitRegPair(unsigned int opcode, bool att,
+					  x86_reg *reg1,
+					  enum cs_ac_type *access1,
+					  x86_reg *reg2,
+					  enum cs_ac_type *access2)
+{
+	x86_reg first, second;
+	enum cs_ac_type first_access, second_access;
+
+#define X86_REG_PAIR(op, r1, r2, a1, a2) \
+	case X86_##op: \
+		first = X86_REG_##r1; \
+		second = X86_REG_##r2; \
+		first_access = CS_AC_##a1; \
+		second_access = CS_AC_##a2; \
+		break;
+	switch (opcode) {
+#include "X86ImplicitRegPair.inc"
+	default:
+		return false;
+	}
+#undef X86_REG_PAIR
+
+	*reg1 = att ? second : first;
+	*reg2 = att ? first : second;
+	if (access1)
+		*access1 = att ? second_access : first_access;
+	if (access2)
+		*access2 = att ? first_access : second_access;
+	return true;
+}
+
+#endif
