diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 90ef6e93..bea50c6f 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -31,6 +31,7 @@
 #include "../../utils.h"
 
 #include "X86DisassemblerDecoder.h"
+#include "X86BaseInfo.h"
 #include "X86Disassembler.h"
 #include "X86Mapping.h"
 #include "X86FeatureExtension.h"
@@ -3757,4 +3758,58 @@ CAPSTONE_INTERNAL uint16_t X86_scanCallTarget(csh ud, const uint8_t *code,
 
 #undef X86_DECODE_INLINE
 
+CAPSTONE_INTERNAL bool X86_decodeRelativeBranch(cs_struct *handle, const uint8_t *code,
+					       size_t code_len, MCInst *instr, uint16_t *size)
+{
+	InternalInstruction header;
+	initializeInstructionHeader(&header, code, code_len, handle->mode);
+	header.rexPrefix = 0;
+	setInstructionSizes(&header, false, false);
+	const bool escaped = code[0] == 0x0f;
+	const unsigned int offset = escaped ? 2 : 1;
+	const uint8_t opcode = code[offset - 1];
+	header.readerCursor = offset;
+	int64_t displacement;
+	if (!escaped && ((opcode & 0xf0) == 0x70 || opcode == 0xeb)) {
+		int8_t rel8;
+		if (consumeInt8(&header, &rel8))
+			return false;
+		displacement = rel8;
+	} else if (header.mode == MODE_16BIT) {
+		int16_t rel16;
+		if (consumeInt16(&header, &rel16))
+			return false;
+		displacement = rel16;
+	} else {
+		int32_t rel32;
+		if (consumeInt32(&header, &rel32))
+			return false;
+		displacement = rel32;
+	}
+	const unsigned int row = header.mode == MODE_16BIT ? X86_TERMINAL_16 :
+				 header.mode == MODE_32BIT ? X86_TERMINAL_32 :
+							     X86_TERMINAL_64;
+	const unsigned int uid = x86LegacyDecisions[row][escaped][opcode] &
+				 X86_TERMINAL_UID_MASK;
+	if (!uid)
+		return false;
+	MCInst_clear(instr);
+	MCInst_setOpcode(instr, uid);
+	MCOperand_CreateImm0(instr, displacement);
+	instr->imm_size = header.immSize;
+	instr->flags = X86_IP_NO_PREFIX;
+	memset(instr->x86_prefix, 0, sizeof(instr->x86_prefix));
+	instr->xAcquireRelease = 0;
+	instr->x86Lock = false;
+	if (handle->detail_opt) {
+		cs_x86 *x86 = &instr->flat_insn->detail->x86;
+		memcpy(x86->opcode, code, offset);
+		x86->addr_size = header.addressSize;
+		x86->encoding.imm_offset = offset;
+		x86->encoding.imm_size = header.readerCursor - offset;
+	}
+	*size = (uint16_t)header.readerCursor;
+	return true;
+}
+
 #endif
