@@ -334,6 +334,19 @@ void map_cs_id(MCInst *MI, const insn_map *imap, unsigned int imap_size)
 	return;
 }
 
+// The common mapping order appends to any detail already produced by decoding.
+void map_insn_metadata(MCInst *MI, const insn_map *imap, unsigned int imap_size)
+{
+	map_cs_id(MI, imap, imap_size);
+#ifndef CAPSTONE_DIET
+	if (MI->flat_insn->detail) {
+		map_implicit_reads(MI, imap);
+		map_implicit_writes(MI, imap);
+		map_groups(MI, imap);
+	}
+#endif
+}
+
