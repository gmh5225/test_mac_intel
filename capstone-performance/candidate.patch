+def emit_operand_access(suffix):
+    """Keep one flags/access descriptor for all mapping rows that use it."""
+    source = (X86 / f"X86MappingInsnOp{suffix}.inc").read_text(encoding="utf-8")
+    records = re.compile(
+        r"\{\s*/\*\s*(X86_\w+),[^\n]*?\*/\s*"
+        r"([^,{}]+),\s*\{([^{}]*)\}\s*,?\s*\}\s*,"
+    )
+    rows = records.findall(source)
+    remaining = re.sub(r"/\*.*?\*/", "", records.sub("", source), flags=re.S)
+    mapping = x86_mapping_counts.entries(
+        (X86 / f"X86MappingInsn{suffix}.inc").read_text(encoding="utf-8")
+    )
+    if remaining.strip() or len(rows) != len(mapping):
+        raise ValueError("Unexpected x86 operand-access table syntax")
