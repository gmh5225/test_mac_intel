+#ifdef X86_COMPACT_VEX_SCAN
+X86_DECODE_INLINE unsigned vexMemoryEnd(const uint8_t *code, size_t size,
+					unsigned end, uint8_t modrm)
+{
+	const unsigned mod = modFromModRM(modrm);
+	const unsigned rm = rmFromModRM(modrm);
+	if (rm == 4) {
+		if (end >= size)
+			return 16;
+		const uint8_t sib = code[end++];
+		if (mod == 0 && baseFromSIB(sib) == 5)
+			return end + 4;
+	} else if (mod == 0 && rm == 5) {
+		return end + 4;
+	}
+	return end + (mod == 1 ? 1 : mod == 2 ? 4 : 0);
+}
+
+/* A bare VEX prefix in 64-bit mode fixes the address size. Only the end
+ * offset and the opcode IDs escape this scan. Extension and generic fixups
+ * continue to use their ordinary readers. */
+X86_DECODE_INLINE int tryVexTerminalScan(const uint8_t *code, size_t code_len,
+			      uint8_t prefix, X86ScanResult *result)
+{
+	const bool vex2 = prefix == 0xc5;
+	const unsigned opcode_offset = vex2 ? 2 : 3;
+	if (code_len <= opcode_offset)
+		return X86_SCAN_INVALID;
+	const unsigned map = vex2 ? VEX_LOB_0F : mmmmmFromVEX2of3(code[1]);
+	if (map < VEX_LOB_0F || map > VEX_LOB_0F3A)
+		return X86_SCAN_INVALID;
+	const uint8_t payload = code[opcode_offset - 1];
+	const uint8_t opcode = code[opcode_offset];
+	if ((map == VEX_LOB_0F &&
+	     (opcode == 0xae || (opcode >= 0x82 && opcode <= 0x8f))) ||
+	    (map == VEX_LOB_0F38 && opcode == 0xf8))
+		return X86_SCAN_NOT_HANDLED;
+	const unsigned row = (payload & 7) |
+			     (vex2 ? 0 : wFromVEX3of3(payload) << 3);
+	const struct ModRMDecision *decisions =
+		x86VexScanRows[map - VEX_LOB_0F][row];
+	if (!decisions)
+		return X86_SCAN_INVALID;
+	const uint32_t packed = decisions[opcode].packed;
+	const bool decision_modrm =
+		(packed & (X86_DECISION_INDEXED | X86_DECISION_SPLIT)) != 0;
+	unsigned end = opcode_offset + 1;
+	uint8_t modrm = 0;
+	if (decision_modrm) {
+		if (end >= code_len)
+			return X86_SCAN_INVALID;
+		modrm = code[end];
+	}
+	const unsigned id = decode(packed, modrm);
+	if (!id)
+		return X86_SCAN_INVALID;
+	if (id >= ARR_SIZE(x86VexScanMetadata))
+		return X86_SCAN_NOT_HANDLED;
+	const uint32_t metadata = x86VexScanMetadata[id];
+	const uint8_t flags = (uint8_t)metadata;
+	if (!flags)
+		return X86_SCAN_NOT_HANDLED;
+	if (decision_modrm || (flags & X86_VEX_SCAN_MODRM)) {
+		if (!decision_modrm) {
+			if (end >= code_len)
+				return X86_SCAN_INVALID;
+			modrm = code[end];
+		}
+		++end;
+		if (!(flags & (modrm >= 0xc0 ? X86_VEX_SCAN_REGISTER :
+					       X86_VEX_SCAN_MEMORY)))
+			return X86_SCAN_INVALID;
+		if (modrm < 0xc0)
+			end = vexMemoryEnd(code, code_len, end, modrm);
+	}
+	if (!(flags & X86_VEX_SCAN_VVVV) && vvvvFromVEX2of2(payload))
+		return X86_SCAN_INVALID;
+	const bool short_immediate = vex2 &&
+				     ppFromVEX2of2(payload) == VEX_PREFIX_66;
+	end += x86VexImmediateBytes[short_immediate]
+				   [flags >> X86_VEX_SCAN_PATTERN_SHIFT];
+	if (end > code_len || end > 15)
+		return X86_SCAN_INVALID;
+	result->opcode = id;
+	result->opcode_pub = metadata >> X86_VEX_SCAN_PUBLIC_SHIFT;
+	result->length = (uint16_t)end;
+	result->popcode_adjust = 0;
+	return X86_SCAN_COMPLETE;
+}
