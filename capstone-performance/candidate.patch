+def public_register_pair_writer(quick, paths, values, strings, sized, recipe_shift):
+    """Select only two calls to printOperand separated by the literal comma."""
+    offset_mask, length_shift, length_mask = map(int, sized.groups())
+    cases = []
+    for recipe, path in enumerate(quick, 1):
+        if len(path) != 4 or path[1] != 'SStream_concat0(O, ", ");' or path[3] != "return;":
+            continue
+        slots = [re.fullmatch(r"printOperand\(MI, (\d+), O\);", path[i]) for i in (0, 2)]
+        if not all(slots):
+            continue
+        # All rows sharing this handler must have a simple mnemonic followed
+        # by a single tab, with no literal part of an operand in the prefix.
+        rows = (value for value, row_path in zip(values, paths) if row_path == path)
+        for value in rows:
+            start = (value & offset_mask) - 1
+            length = (value >> length_shift) & length_mask
+            if start < 0 or not re.fullmatch(rb"[A-Za-z0-9_.]{1,31}\t", strings[start:start + length]):
+                break
+        else:
+            cases.append(f"  case {recipe}: first = {slots[0][1]}; second = {slots[1][1]}; break;")
+    require(cases, "No register-pair printer recipes")
+    return (
+        "\nbool X86_Intel_printPublicRegisterPair(MCInst *MI, const uint8_t *code)\n{\n"
+        "  unsigned opcode = MCInst_getOpcode(MI);\n"
+        "  if (opcode >= ARR_SIZE(X86RecipeRecords) || MI->assembly[0] || MI->OpcodePub ||\n"
+        "      MI->popcode_adjust || MI->xAcquireRelease || MI->x86Lock || MI->x86_prefix[0] || MI->x86_prefix[1])\n"
+        "    return false;\n"
+        "  uint32_t record = X86RecipeRecords[opcode];\n"
+        "  unsigned first, second;\n"
+        f"  switch (record >> {recipe_shift}) {{\n"
+        + "\n".join(cases) + "\n  default: return false;\n  }\n"
+        + f"  return writePublicRegisterPair(MI, code, AsmStrs + (record & {offset_mask}) - 1,\n"
+        + f"                                 ((record >> {offset_mask.bit_length()}) & {length_mask}) - 1, first, second);\n}}\n"
+    )
+
+
