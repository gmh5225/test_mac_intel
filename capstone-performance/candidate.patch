+/* Both callers have selected the unprefixed 64-bit EVEX register form. */
+static inline const struct VectorOutputRow *evexRegisterRow(const uint8_t *code,
+							    size_t size)
+{
+	if (size < 6 || (code[2] & 7) != 5 || (code[3] & 0x97) ||
+	    (code[3] & 0x60) == 0x60)
+		return NULL;
+	const unsigned ll = code[3] >> 5;
+	const unsigned w = code[2] >> 7;
+	const unsigned key = ((code[1] & 15) << 8) | code[4];
+	const struct VectorOutputRow *row = evexOutputRow(key, w, ll);
+	if (!row || (row->immediate && size < 7))
+		return NULL;
+	if ((key & ~0x22u) == 0x319 &&
+	    ((code[2] & 0x78) != 0x78 || !(code[3] & 8)))
+		return NULL;
+	return row;
+}
+
+static inline const struct VectorOutputRow *
+evexMemoryRow(const uint8_t *code, size_t size, unsigned *source_width,
+	      unsigned *instruction_length)
+{
+	if (size < 6 || (code[2] & 0x7c) != 0x7c || (code[3] & 0x9f) != 8)
+		return NULL;
+	const unsigned ll = code[3] >> 5, w = code[2] >> 7, pp = code[2] & 3;
+	const uint8_t modrm = code[5];
+	const unsigned mod = modrm >> 6, rm = modrm & 7;
+	if (ll >= 3 || mod >= 3 || (!mod && rm == 5))
+		return NULL;
+	const unsigned key = ((code[1] & 15) << 8) | code[4];
+	const struct VectorOutputRow *row;
+	unsigned memory_ll;
+	if (key == 0x16f && pp) {
+		row = &evex_load_rows[pp - 1][w][ll];
+		memory_ll = ll;
+	} else if (key == 0x21a && pp == 1 && mod < 2) {
+		row = &broadcast_rows[w][ll];
+		memory_ll = 0;
+	} else {
+		return NULL;
+	}
+	const bool sib = rm == 4;
+	const unsigned offset = 6 + sib, disp_size = mod == 2 ? 4 : mod;
+	const unsigned length = offset + disp_size;
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & 7;
+	if (!row->id || size < length ||
+	    (sib && ((rxb & 2) || code[6] != 0x24)))
+		return NULL;
+	*source_width = memory_ll;
+	*instruction_length = length;
+	return row;
+}
