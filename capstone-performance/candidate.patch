+/* Finish the public Intel operand list after the instruction was printed.
+ * Implicit registers precede the printed operands; access follows that order. */
+void X86_finalize_intel_operands(MCInst *mi)
+{
+	cs_struct *h = mi->csh;
+	cs_x86 *x86 = &mi->flat_insn->detail->x86;
+	unsigned int id = MCInst_getOpcode(mi);
+	enum cs_ac_type access1, access2;
+	x86_reg reg2;
+	x86_reg reg = X86_insn_reg_intel_h(h, id, &access1);
+	if (reg) {
+		memmove(x86->operands + 1, x86->operands,
+			(ARR_SIZE(x86->operands) - 1) * sizeof(x86->operands[0]));
+		memset(&x86->operands[0], 0, sizeof(x86->operands[0]));
+		x86->operands[0].type = X86_OP_REG;
+		x86->operands[0].reg = reg;
+		x86->operands[0].size = h->regsize_map[reg];
+		x86->operands[0].access = access1;
+		++x86->op_count;
+	} else if (X86_insn_reg_intel2(id, &reg, &access1, &reg2, &access2)) {
+		x86->operands[0].type = X86_OP_REG;
+		x86->operands[0].reg = reg;
+		x86->operands[0].size = h->regsize_map[reg];
+		x86->operands[0].access = access1;
+		x86->operands[1].type = X86_OP_REG;
+		x86->operands[1].reg = reg2;
+		x86->operands[1].size = h->regsize_map[reg2];
+		x86->operands[1].access = access2;
+		x86->op_count = 2;
+	}
+#ifndef CAPSTONE_DIET
+	const uint8_t *raw = X86_get_op_access(h, id, &x86->eflags);
+	for (unsigned i = 0; i < x86->op_count && i < ARR_SIZE(insn_ops[0].access); ++i) {
+		uint8_t access = raw && *raw ? *raw++ : 0;
+		x86->operands[i].access = access == CS_AC_IGNORE ? 0 : access;
+	}
+#endif
+	if (!mi->op1_size && reg)
+		mi->op1_size = h->regsize_map[reg];
+}
+
