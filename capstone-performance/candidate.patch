diff --git a/arch/X86/X86Module.c b/arch/X86/X86Module.c
index 6fcbe3f4..c2d02cd6 100644
--- a/arch/X86/X86Module.c
+++ b/arch/X86/X86Module.c
@@ -10,6 +10,10 @@
 #include "X86Mapping.h"
 #include "X86Module.h"
 
+#ifdef CS_X86_SHARED_LOOKUPS
+static bool initializeSharedLookups(cs_struct *handle);
+#endif
+
 cs_err X86_global_init(cs_struct *ud)
 {
 	MCRegisterInfo *mri;
@@ -42,7 +46,10 @@ cs_err X86_global_init(cs_struct *ud)
 	else
 		ud->regsize_map = regsize_map_32;
 
-	X86_build_lookup_tables(ud);
+#ifdef CS_X86_SHARED_LOOKUPS
+	if (!initializeSharedLookups(ud))
+#endif
+		X86_build_lookup_tables(ud);
 
 	return CS_ERR_OK;
 }
@@ -105,4 +112,43 @@ cs_err X86_option(cs_struct *handle, cs_opt_type type, size_t value)
 	return CS_ERR_OK;
 }
 
+#ifdef CS_X86_SHARED_LOOKUPS
+/* Keep the canonical lookup builder and all hot mapping functions unchanged.
+ * The initial owner publishes its ordinary heap tables for later handles. */
+static bool initializeSharedLookups(cs_struct *handle)
+{
+	static uint32_t *insn_lookup, *reg_lookup;
+	static unsigned int maximum;
+	enum { empty, building, ready };
+	static unsigned int state;
+
+	if (cs_mem_malloc != malloc || cs_mem_calloc != calloc ||
+	    cs_mem_realloc != realloc || cs_mem_free != free ||
+	    cs_vsnprintf != cs_default_vsnprintf)
+		return false;
+
+	if (__atomic_load_n(&state, __ATOMIC_ACQUIRE) != ready) {
+		unsigned int expected = empty;
+		if (!__atomic_compare_exchange_n(&state, &expected, building,
+						 false, __ATOMIC_RELAXED,
+						 __ATOMIC_RELAXED))
+			return false;
+		X86_build_lookup_tables(handle);
+		if (!handle->x86_insn_lut || !handle->x86_insn_reg_lut) {
+			__atomic_store_n(&state, empty, __ATOMIC_RELEASE);
+			return true;
+		}
+		insn_lookup = handle->x86_insn_lut;
+		reg_lookup = handle->x86_insn_reg_lut;
+		maximum = handle->x86_insn_lut_max;
+		__atomic_store_n(&state, ready, __ATOMIC_RELEASE);
+	}
+	handle->x86_insn_lut = insn_lookup;
+	handle->x86_insn_reg_lut = reg_lookup;
+	handle->x86_insn_lut_max = maximum;
+	handle->x86_shared_lookups = true;
+	return true;
+}
+#endif
+
 #endif
