+	const unsigned w = code[2] >> 7;
+	const unsigned key = ((code[1] & 15) << 8) | code[4];
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & 7;
+	const unsigned regs[] = { ((code[5] >> 3) & 7) | ((rxb & 4) << 1) |
+					  (~(unsigned)code[1] & 16),
+				  ((~(unsigned)code[2] >> 3) & 15) |
+					  ((~(unsigned)code[3] & 8) << 1),
+				  (code[5] & 7) | ((rxb & 3) << 3) };
