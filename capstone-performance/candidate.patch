@@ -197,6 +197,27 @@ void emit_vex_indexed(Decoder &decoder)
 	std::puts("};");
 }
 
+void emit_vector_registers(const Decoder &decoder)
+{
+	std::puts(
+		"struct VectorRegisterName { char name[6]; uint8_t length; };\nstatic const struct VectorRegisterName vector_register_names[3][32] = {");
+	for (unsigned base : { X86_REG_XMM0, X86_REG_YMM0, X86_REG_ZMM0 }) {
+		std::puts("\t{");
+		for (unsigned n = 0; n != 32; ++n) {
+			const char *name =
+				cs_reg_name(decoder.handle, base + n);
+			if (!name || std::strlen(name) < 4 ||
+			    std::strlen(name) > 5)
+				throw std::runtime_error(
+					"invalid vector register name");
+			std::printf("\t\t{ \"%s\", %zu },\n", name,
+				    std::strlen(name));
+		}
+		std::puts("\t},");
+	}
+	std::puts("};");
+}
+
