+			uint8_t code[] = { (uint8_t)op, (uint8_t)imm,
+					   (uint8_t)(imm >> 8),
+					   (uint8_t)(imm >> 16),
+					   (uint8_t)(imm >> 24) };
+			for (unsigned length = 0; length <= sizeof(code);
+			     ++length)
