+#ifdef CAPSTONE_SSTREAM_PRECHECKED
+/* The generated caller proves the mnemonic extent and both operand slots.
+ * Commit output only after proving that both decoded operands are registers. */
+static bool writePublicRegisterPair(MCInst *MI, const uint8_t *code,
+				    const char *mnemonic, size_t mnemonic_len,
+				    unsigned first, unsigned second)
+{
+	MCOperand *a = MCInst_getOperand(MI, first);
+	MCOperand *b = MCInst_getOperand(MI, second);
+	if (!MCOperand_isReg(a) || !MCOperand_isReg(b))
+		return false;
+	unsigned ra = MCOperand_getReg(a), rb = MCOperand_getReg(b);
+	if (!ra || !rb || ra >= X86_NUM_TARGET_REGS || rb >= X86_NUM_TARGET_REGS)
+		return false;
+
+	cs_insn *insn = MI->flat_insn;
+	fill_insn_without_text(insn, 0, code, false);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->mnemonic, mnemonic, mnemonic_len);
+	size_t alen = getRegisterNameLength(ra);
+	memcpy(insn->op_str, getRegisterName(ra), alen);
+	memcpy(insn->op_str + alen, ", ", 2);
+	memcpy(insn->op_str + alen + 2, getRegisterName(rb), getRegisterNameLength(rb));
+	return true;
+}
+#endif
+
