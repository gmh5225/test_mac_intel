 	!defined(_WIN32_WCE)
 #include "X86SimpleOutput.h"
 
+#include "../../MathExtras.h"
+
+char *X86_writeHexDigits(char *out, uint64_t value)
+{
+	static const char digits[] = "0123456789abcdef";
+	static const char pairs[] = "000102030405060708090a0b0c0d0e0f"
+				    "101112131415161718191a1b1c1d1e1f"
+				    "202122232425262728292a2b2c2d2e2f"
+				    "303132333435363738393a3b3c3d3e3f"
+				    "404142434445464748494a4b4c4d4e4f"
+				    "505152535455565758595a5b5c5d5e5f"
+				    "606162636465666768696a6b6c6d6e6f"
+				    "707172737475767778797a7b7c7d7e7f"
+				    "808182838485868788898a8b8c8d8e8f"
+				    "909192939495969798999a9b9c9d9e9f"
+				    "a0a1a2a3a4a5a6a7a8a9aaabacadaeaf"
+				    "b0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
+				    "c0c1c2c3c4c5c6c7c8c9cacbcccdcecf"
+				    "d0d1d2d3d4d5d6d7d8d9dadbdcdddedf"
+				    "e0e1e2e3e4e5e6e7e8e9eaebecedeeef"
+				    "f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff";
+	if (value < 16) {
+		*out++ = digits[value];
+		return out;
+	}
+	if (value < 256) {
+		memcpy(out, pairs + 2 * value, 2);
+		return out + 2;
+	}
+
+	unsigned shift = (63u - CountLeadingZeros_64(value)) & ~3u;
+	if (!(shift & 4)) {
+		*out++ = digits[value >> shift];
+	} else {
+		shift -= 4;
+		memcpy(out, pairs + 2 * (value >> shift), 2);
+		out += 2;
+	}
+	while (shift) {
+		shift -= 8;
+		memcpy(out, pairs + 2 * ((value >> shift) & 255), 2);
+		out += 2;
+	}
+	return out;
+}
+
 static void writeUnsignedImmediate(char *out, uint64_t value)
 {
 	if (value <= HEX_THRESHOLD) {
 		*out = (char)('0' + value);
 	} else {
-		static const char digits[] = "0123456789abcdef";
-		char temp[16], *end = temp + sizeof(temp), *start = end;
-		uint64_t n = value;
-		do {
-			*--start = digits[n & 15];
-			n >>= 4;
-		} while (n);
 		memcpy(out, "0x", 2);
-		memcpy(out + 2, start, end - start);
+		X86_writeHexDigits(out + 2, value);
 	}
 }
 
