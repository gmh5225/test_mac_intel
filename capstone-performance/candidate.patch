diff --git a/arch/X86/X86Disassembler.c b/arch/X86/X86Disassembler.c
index 8c3dea2e..30a7dd4a 100644
--- a/arch/X86/X86Disassembler.c
+++ b/arch/X86/X86Disassembler.c
@@ -635,7 +635,11 @@ getInstructionAfterExtensions(csh ud, const uint8_t *code, size_t code_len,
 	int ret;
 	bool result;
 
+	/* EVEX.aaa is three bits, including k0. Only a writemask operand
+	 * writes this field, so its initial value also records absence. */
+	const Reg noWritemask = (Reg)8;
 	InternalInstruction insn = { 0 };
+	insn.writemask = noWritemask;
 	if (extension_opcode == 0x62)
 		ret = decodeEVEXInstruction(&insn, code, code_len, handle->mode,
 					    &scalar_compare_p2_normalized,
@@ -699,13 +703,8 @@ getInstructionAfterExtensions(csh ud, const uint8_t *code, size_t code_len,
 			if (insn.hasLockPrefix)
 				Flags |= X86_IP_HAS_LOCK;
 
-			for (int i = 0; i < X86_MAX_OPERANDS; ++i) {
-				if (insn.operands[i].encoding ==
-				    ENCODING_WRITEMASK) {
-					Flags |= X86_IP_HAS_EVEX_OPMASK;
-					break;
-				}
-			}
+			if (insn.writemask != noWritemask)
+				Flags |= X86_IP_HAS_EVEX_OPMASK;
 
 			instr->flags = Flags;
 		}
