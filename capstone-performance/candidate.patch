diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 90ef6e93..852452f5 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3757,4 +3757,61 @@ CAPSTONE_INTERNAL uint16_t X86_scanCallTarget(csh ud, const uint8_t *code,
 
 #undef X86_DECODE_INLINE
 
+#ifndef CAPSTONE_DIET
+CAPSTONE_INTERNAL bool X86_formatRelative(cs_struct *handle, const uint8_t *code,
+					 size_t length, cs_insn *insn, uint16_t *size)
+{
+	InternalInstruction header;
+	initializeInstructionHeader(&header, code, length, handle->mode);
+	header.rexPrefix = 0;
+	setInstructionSizes(&header, false, false);
+	const bool escaped = code[0] == 0x0f;
+	const unsigned int offset = escaped ? 2 : 1;
+	const uint8_t opcode = code[offset - 1];
+	header.readerCursor = offset;
+	int64_t displacement;
+	if (!escaped && ((opcode & 0xf0) == 0x70 || opcode == 0xeb)) {
+		int8_t rel8;
+		if (consumeInt8(&header, &rel8))
+			return false;
+		displacement = rel8;
+	} else if (header.mode == MODE_16BIT) {
+		int16_t rel16;
+		if (consumeInt16(&header, &rel16))
+			return false;
+		displacement = rel16;
+	} else {
+		int32_t rel32;
+		if (consumeInt32(&header, &rel32))
+			return false;
+		displacement = rel32;
+	}
+	const unsigned row = header.mode == MODE_16BIT ? X86_TERMINAL_16 :
+			     header.mode == MODE_32BIT ? X86_TERMINAL_32 :
+							 X86_TERMINAL_64;
+	const uint64_t decision = insn->detail ? x86LegacyDecisions[row][escaped][opcode] :
+						 x86LegacyPublicDecisions[row][escaped][opcode];
+	const unsigned id = decision & X86_TERMINAL_UID_MASK;
+	if (!id)
+		return false;
+	*size = (uint16_t)header.readerCursor;
+	insn->size = *size;
+	if (insn->detail) {
+		cs_x86 *x86 = &insn->detail->x86;
+		memset(insn->detail, 0, offsetof(cs_detail, x86) + sizeof(*x86));
+		memcpy(x86->opcode, code, offset);
+		x86->addr_size = header.addressSize;
+		x86->encoding.imm_offset = offset;
+		x86->encoding.imm_size = *size - offset;
+		X86_get_insn_id(handle, insn, id);
+	} else {
+		insn->id = id;
+	}
+	uint64_t target = X86_relativeBranchTarget(handle->mode, insn->address,
+						  *size, displacement, header.immSize);
+	X86_writeRelativeIntel(handle, insn, target, id, header.immSize);
+	return true;
+}
+#endif
+
 #endif
