+
+bool X86_Intel_printPublicRegisterPair(MCInst *MI, const uint8_t *code)
+{
+  unsigned opcode = MCInst_getOpcode(MI);
+  if (opcode >= ARR_SIZE(X86RecipeRecords) || MI->assembly[0] || MI->OpcodePub ||
+      MI->popcode_adjust || MI->xAcquireRelease || MI->x86Lock || MI->x86_prefix[0] || MI->x86_prefix[1])
+    return false;
+  uint32_t record = X86RecipeRecords[opcode];
+  unsigned first, second;
+  switch (record >> 19) {
+  case 4: first = 1; second = 2; break;
+  case 5: first = 0; second = 2; break;
+  case 18: first = 0; second = 1; break;
+  default: return false;
+  }
+  return writePublicRegisterPair(MI, code, AsmStrs + (record & 16383) - 1,
+                                 ((record >> 14) & 31) - 1, first, second);
+}
 #else
   switch (QuickRecipe[opcode]) {
   default: break;
