+						(uint8_t)sib,
+						(uint8_t)(sib ^ reg_mod ^ p),
+						0xfe,
+						0xff,
+						0
+					};
+					const uint8_t *code = bytes + !p;
+					size_t len = sizeof(bytes) - !p;
+					if (!compare(handles, code, len, sib) ||
+					    !compare(handles, code,
+						     (reg_mod + sib + p) % len,
