+			    current == 0x3a)
+				return X86_SCAN_NOT_HANDLED;
+			insn.opcodeType = TWOBYTE;
+		}
+		insn.opcode = current;
+		insn.rexPrefix = opcodeOffset ? code[0] : 0;
