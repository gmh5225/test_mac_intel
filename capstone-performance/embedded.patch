+/* For an admitted plain 32/64-bit public terminal, only the ID and the
+ * total byte extent escape. Inspect only the bytes which determine either.
+ * The generated tail widths come from the ordered operand readers. */
+X86_DECODE_INLINE int scanSimplePublicExtent(const InternalInstruction *insn,
+					     uint64_t decision, unsigned *id,
+					     uint16_t *size)
+{
+	const uint8_t *code = insn->code;
+	size_t cursor = insn->readerCursor;
+	uint8_t modrm = 0;
+	const bool decisionModRM =
+		(decision & (X86_TERMINAL_INDEXED | X86_TERMINAL_SPLIT)) != 0;
+	if (decisionModRM) {
+		if (cursor >= insn->codeSize)
+			return X86_SCAN_INVALID;
+		modrm = code[cursor];
+	}
+	const uint32_t terminal = lookupLegacyTerminal(decision, modrm, true);
+	const unsigned publicID = terminal & X86_TERMINAL_UID_MASK;
+	if (!publicID)
+		return X86_SCAN_INVALID;
+	const unsigned pattern = (terminal >> X86_TERMINAL_OPERAND_SHIFT) &
+				 X86_TERMINAL_OPERAND_MASK;
+	if (decisionModRM || (pattern & 1)) {
+		if (!decisionModRM) {
+			if (cursor >= insn->codeSize)
+				return X86_SCAN_INVALID;
+			modrm = code[cursor];
+		}
+		++cursor;
+		const unsigned mod = modFromModRM(modrm);
+		if (mod != 3) {
+			unsigned base = rmFromModRM(modrm);
+			if (base == 4) {
+				if (cursor >= insn->codeSize)
+					return X86_SCAN_INVALID;
+				base = baseFromSIB(code[cursor]);
+				++cursor;
+			}
+			if (mod == 1)
+				++cursor;
+			else if (mod == 2 || base == 5)
+				cursor += 4;
+		}
+	}
+	cursor += (pattern >> X86_PUBLIC_WIDTH_SHIFT) & X86_PUBLIC_WIDTH_MASK;
+	if (insn->mode == MODE_64BIT && (pattern & X86_PUBLIC_WIDE_ADDRESS))
+		cursor += 4;
+	if (cursor > insn->codeSize || cursor > 15)
+		return X86_SCAN_INVALID;
+	*size = (uint16_t)cursor;
+	*id = publicID;
+	return X86_SCAN_COMPLETE;
+}
