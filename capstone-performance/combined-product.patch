diff --git a/suite/synctools/mips_alias_index.py b/suite/synctools/mips_alias_index.py
new file mode 100644
index 00000000..b8b9f2fc
--- /dev/null
+++ b/suite/synctools/mips_alias_index.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Index the first matching row in the MIPS textual alias name map."""
+
+import argparse
+from pathlib import Path
+import re
+
+
+def generate(directory):
+    source = (directory / "MipsMapping.c").read_text()
+    body = source.split("static const name_map insn_alias_mnem_map[] = {", 1)[1].split("};", 1)[0]
+    body = body.replace('#include "MipsGenCSAliasMnemMap.inc"',
+                        (directory / "MipsGenCSAliasMnemMap.inc").read_text())
+    body = re.sub(r"/\*.*?\*/|//[^\n]*", "", body, flags=re.S)
+    row = re.compile(r'\s*\{\s*MIPS_INS_ALIAS_(\w+)\s*,\s*(NULL|"[^"\\]*")\s*\},')
+    names = []
+    cursor = 0
+    while body[cursor:].strip():
+        match = row.match(body, cursor)
+        if not match:
+            raise ValueError("Unexpected MIPS alias name-map initializer")
+        cursor = match.end()
+        if match[2] == "NULL":
+            if match[1] != "END" or body[cursor:].strip():
+                raise ValueError("Unexpected MIPS alias terminator")
+            break
+        names.append(match[2][1:-1].encode("ascii"))
+    else:
+        raise ValueError("Missing MIPS alias terminator")
+    if len(names) > 65535:
+        raise ValueError("MIPS alias rows exceed the index width")
+
+    first = {}
+    for i, name in enumerate(names, 1):
+        first.setdefault(name, i)
+    size = 1 << (max(2, 2 * len(first)) - 1).bit_length()
+    slots = [0] * size
+    for name, index in first.items():
+        h = 2166136261
+        for c in name:
+            h = ((h ^ c) * 16777619) & 0xffffffff
+        slot = h & (size - 1)
+        while slots[slot]:
+            slot = (slot + 1) & (size - 1)
+        slots[slot] = index
+    return "/* Generated by suite/synctools/mips_alias_index.py. */\n" + "".join(
+        "\t" + ", ".join(map(str, slots[i:i + 16])) + ",\n" for i in range(0, size, 16)
+    )
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    directory = Path(__file__).resolve().parents[2] / "arch/Mips"
+    target = directory / "MipsGenAliasIndex.inc"
+    content = generate(directory)
+    if args.check:
+        if target.read_text() != content:
+            raise SystemExit("Regenerate MipsGenAliasIndex.inc")
+    else:
+        target.write_text(content)
