--- a/arch/LoongArch/LoongArchMapping.c
+++ b/arch/LoongArch/LoongArchMapping.c
@@ -374,12 +374,19 @@ void LoongArch_rewrite_address_operand(MCInst *MI)
 	}
 }
 
+#ifndef CAPSTONE_DIET
+static const uint32_t dense_ids[] = {
+#include "LoongArchGenDenseMapping.inc"
+};
+#endif
+
 void LoongArch_set_instr_map_data(MCInst *MI)
 {
+#ifdef CAPSTONE_DIET
 	map_cs_id(MI, loongarch_insns, ARR_SIZE(loongarch_insns));
-	map_implicit_reads(MI, loongarch_insns);
-	map_implicit_writes(MI, loongarch_insns);
-	map_groups(MI, loongarch_insns);
+#else
+	map_dense_metadata(MI, loongarch_insns, dense_ids, ARR_SIZE(dense_ids));
+#endif
 	const loongarch_suppl_info *suppl_info =
 		map_get_suppl_info(MI, loongarch_insns);
 	if (suppl_info) {
@@ -500,16 +507,16 @@ void LoongArch_setup_op(cs_loongarch_op *op)
 
 void LoongArch_init_cs_detail(MCInst *MI)
 {
-	if (detail_is_set(MI)) {
-		unsigned int i;
-
-		memset(get_detail(MI), 0,
-		       offsetof(cs_detail, loongarch) + sizeof(cs_loongarch));
-
-		for (i = 0; i < ARR_SIZE(LoongArch_get_detail(MI)->operands);
-		     i++)
-			LoongArch_setup_op(
-				&LoongArch_get_detail(MI)->operands[i]);
+	if (!detail_is_set(MI))
+		return;
+	cs_detail *detail = get_detail(MI);
+	memset(detail, 0,
+	       offsetof(cs_detail, loongarch) + sizeof(cs_loongarch));
+	if (LOONGARCH_OP_INVALID != 0) {
+		for (unsigned i = 0; i < ARR_SIZE(detail->loongarch.operands);
+		     ++i)
+			detail->loongarch.operands[i].type =
+				LOONGARCH_OP_INVALID;
 	}
 }
 
