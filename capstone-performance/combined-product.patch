diff --git a/CMakeLists.txt b/CMakeLists.txt
index fdd48518..1ddd25c1 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -150,6 +150,24 @@ foreach(i RANGE ${count})
     option("CAPSTONE_${supported_architecture}_SUPPORT" "${supported_architecture_label} support" ${CAPSTONE_ARCHITECTURE_DEFAULT})
 endforeach()
 
+# Dedicated builds of these backends use their generated mnemonic tries.
+set(alias_trie_architectures AARCH64 MIPS PPC SPARC)
+set(use_alias_trie ON)
+foreach(arch IN LISTS SUPPORTED_ARCHITECTURES)
+    if(CAPSTONE_${arch}_SUPPORT AND NOT arch IN_LIST alias_trie_architectures)
+        set(use_alias_trie OFF)
+        break()
+    endif()
+endforeach()
+if(use_alias_trie)
+    add_compile_definitions(CAPSTONE_USE_ALIAS_TRIE)
+endif()
+
+option(CAPSTONE_MSVC_NATIVE_DECODER "Use the native x64 MSVC dynamic CRT decoder profile" OFF)
+if(CAPSTONE_MSVC_NATIVE_DECODER AND MSVC)
+    add_compile_definitions(CAPSTONE_MSVC_NATIVE_DECODER)
+endif()
+
 option(CAPSTONE_X86_REDUCE "x86 with reduce instruction sets to minimize library" OFF)
 option(CAPSTONE_X86_ATT_DISABLE "Disable x86 AT&T syntax" OFF)
 option(CAPSTONE_X86_SCAN_ADAPTER "Build the private x86 scan adapter hook" OFF)
