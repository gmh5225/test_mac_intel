+	cs_opt_mem original = { cs_mem_malloc, cs_mem_calloc, cs_mem_realloc,
+				cs_mem_free, cs_vsnprintf };
+	cs_opt_mem hooks = original;
+	hooks.vsnprintf = write_broadcast;
+	csh handle = 0;
+	cs_insn *insn = NULL;
+	bool ok = cs_option(0, CS_OPT_MEM, (uintptr_t)&hooks) == CS_ERR_OK &&
+		  cs_open(CS_ARCH_X86, CS_MODE_32, &handle) == CS_ERR_OK &&
+		  cs_option(handle, CS_OPT_DETAIL, CS_OPT_ON) == CS_ERR_OK &&
+		  cs_disasm(handle, bytes, sizeof(bytes), 0, 1, &insn) == 1;
+	if (ok) {
+		const cs_x86 *x86 = &insn->detail->x86;
+		ok = strstr(insn->op_str, "{1to8}") && x86->op_count == 2 &&
+		     x86->operands[0].type == X86_OP_MEM &&
+		     x86->operands[0].avx_bcast == X86_AVX_BCAST_8;
+		cs_free(insn, 1);
+	}
+	if (handle)
+		cs_close(&handle);
+	return cs_option(0, CS_OPT_MEM, (uintptr_t)&original) == CS_ERR_OK &&
+	       ok;
+}
