--- a/Mapping.h
+++ b/Mapping.h
@@ -125,6 +125,11 @@ void map_groups(MCInst *MI, const insn_map *imap);
 
 void map_cs_id(MCInst *MI, const insn_map *imap, unsigned int imap_size);
 
+// Set the public ID and append implicit reads, writes and groups when a detail
+// buffer is present. Registers and groups already added by decoding are kept.
+CAPSTONE_INTERNAL void map_insn_metadata(MCInst *MI, const insn_map *imap,
+					 unsigned int imap_size);
+
 const void *map_get_suppl_info(MCInst *MI, const insn_map *imap);
 
 #define DECL_get_detail_op(arch, ARCH) \
@@ -319,4 +324,27 @@ typedef struct {
 uint64_t enum_map_bin_search(const cs_enum_id_map *map, size_t map_len,
 			     const char *id, bool *found);
 
+#ifndef CAPSTONE_DIET
+/* The low 16 bits match insn_map.mapid. Generated projections only describe
+ * tables whose opcode is its unique row index. */
+#define CS_MAP_HAS_IMPLICIT (1U << 16)
+static inline uint32_t map_dense_metadata(MCInst *MI, const insn_map *map,
+				      const uint32_t *ids, size_t count)
+{
+	unsigned int opcode = MCInst_getOpcode(MI);
+	if (opcode >= count) {
+		map_cs_id(MI, map, (unsigned int)count);
+		return 0;
+	}
+	uint32_t entry = ids[opcode];
+	MI->flat_insn->id = (uint16_t)entry;
+	if ((entry & CS_MAP_HAS_IMPLICIT) && MI->flat_insn->detail) {
+		map_implicit_reads(MI, map);
+		map_implicit_writes(MI, map);
+		map_groups(MI, map);
+	}
+	return entry;
+}
+#endif
+
 #endif // CS_MAPPING_H
