@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Project dense instruction IDs and nonempty implicit metadata from the LLVM maps."""
+import argparse
+from pathlib import Path
+import re
+
+from mapping_diet_types import Initializers, instruction_enum, require
+
+
+ARCHITECTURES = ("ARC", "LoongArch", "SystemZ")
+
+
+def project(directory, arch):
+    prefix = arch.upper() + "_INS_"
+    instructions = instruction_enum((directory / (arch + "GenInstrInfo.inc")).read_text(), arch)
+    source = (directory / (arch + "GenCSMappingInsn.inc")).read_text()
+    # Expose the full records, including the columns elided in DIET.
+    source = re.sub(r"(?m)^\s*#(?:ifndef CAPSTONE_DIET|endif)\s*$", "", source)
+    # The supplementary union can name its target-specific C99 member.
+    source = re.sub(r"(\{\s*)\." + arch.lower() + r"\s*=\s*(?=\{)", r"\1", source)
+    parser = Initializers(source)
+    result = ["/* Generated by suite/synctools/dense_mapping_ids.py. */"]
+    for opcode in instructions:
+        row = parser.aggregate()
+        parser.take(",")
+        require(len(row) == 8 and row[0] == opcode, "Expected a dense mapping for " + opcode)
+        public = row[1]
+        require(re.fullmatch(prefix + r"[A-Za-z0-9_]+", public), "Unexpected public ID for " + opcode)
+        banks = row[2:5]
+        require(all(isinstance(bank, list) and bank and bank[-1] == "0" for bank in banks),
+                "Missing metadata terminator for " + opcode)
+        populated = any(bank[0] != "0" for bank in banks)
+        mask = " | CS_MAP_HAS_IMPLICIT" if populated else ""
+        if arch == "SystemZ":
+            fields = row[7]
+            require(isinstance(fields, list) and len(fields) == 1 and
+                    isinstance(fields[0], list) and len(fields[0]) == 1,
+                    "Unexpected SystemZ supplementary data for " + opcode)
+            form = fields[0][0]
+            require(form == "0" or re.fullmatch(r"SYSTEMZ_INSN_FORM_[A-Z0-9_]+", form),
+                    "Unexpected SystemZ form for " + opcode)
+            if form != "0":
+                mask += " | SYSTEMZ_MAP_FORM(" + form + ")"
+        result.append("\t" + public + mask + ",")
+    require(parser.peek() is None, "Unexpected extra rows in " + arch)
+    return "\n".join(result) + "\n"
+
+
+def main():
+    args = argparse.ArgumentParser(description=__doc__)
+    args.add_argument("--check", action="store_true")
+    check = args.parse_args().check
+    root = Path(__file__).resolve().parents[2]
+    for arch in ARCHITECTURES:
+        directory = root / "arch" / arch
+        target = directory / (arch + "GenDenseMapping.inc")
+        content = project(directory, arch)
+        if check:
+            require(target.read_text() == content, "Regenerate " + target.name)
+        else:
+            target.write_text(content)
+
+
+if __name__ == "__main__":
+    main()
