+/* Validate the cache against the canonical instruction map, including holes
+ * and the unallocated suffix of the 16-bit opcode space. */
+static int check_lookup(void)
+{
+	csh handle, second;
+	cs_arch_register_x86();
+	if (!cs_mem_is_setup()) {
+		cs_opt_mem hooks = { malloc, calloc, realloc, free, vsnprintf };
+		if (cs_option(0, CS_OPT_MEM, (uintptr_t)&hooks) != CS_ERR_OK)
+			return 1;
+	}
+	if (cs_open(CS_ARCH_X86, CS_MODE_64, &handle) != CS_ERR_OK)
+		return 1;
+	cs_struct *h = (cs_struct *)handle;
+	if (cs_open(CS_ARCH_X86, CS_MODE_32, &second) != CS_ERR_OK) {
+		cs_close(&handle);
+		return 1;
+	}
+	cs_struct *h2 = (cs_struct *)second;
+	bool expect_shared = false;
+#if defined(CAPSTONE_USE_SYS_DYN_MEM) && !defined(CAPSTONE_HAS_OSXKERNEL) && \
+	!defined(_KERNEL_MODE) && !defined(_WIN32_WCE)
+	expect_shared = true;
+#endif
+	bool shared_ids = h->x86_insn_lut == h2->x86_insn_lut;
+	bool shared_regs = h->x86_insn_reg_lut == h2->x86_insn_reg_lut;
+	cs_close(&second);
+	if (shared_ids != expect_shared || shared_regs != expect_shared) {
+		fprintf(stderr,
+			"Expected shared=%d, got instruction=%d, register=%d\n",
+			expect_shared, shared_ids, shared_regs);
+		cs_close(&handle);
+		return 1;
+	}
+	int status = 0;
+	for (unsigned int id = 0; id <= UINT16_MAX; ++id) {
+		unsigned int row = find_insn(id);
+		uint32_t expected = row == (unsigned int)-1 ?
+					    UINT32_MAX :
+					    ((uint32_t)insns[row].mapid << 16) |
+						    row;
+		uint32_t actual = h->x86_insn_lut && id <= h->x86_insn_lut_max ?
+					  h->x86_insn_lut[id] :
+					  UINT32_MAX;
+		enum cs_ac_type intel_cached = 0, intel_fallback = 0;
+		enum cs_ac_type att_cached = 0, att_fallback = 0;
+		x86_reg intel = X86_insn_reg_intel_h(h, id, &intel_cached);
+		x86_reg att = X86_insn_reg_att_h(h, id, &att_cached);
+		if (intel != X86_insn_reg_intel(id, &intel_fallback) ||
+		    att != X86_insn_reg_att(id, &att_fallback) ||
+		    intel_cached != intel_fallback ||
+		    att_cached != att_fallback) {
+			fprintf(stderr,
+				"Implicit register lookup mismatch for opcode %u\n",
+				id);
+			status = 1;
+			break;
+		}
+		if (actual != expected) {
+			fprintf(stderr,
+				"Instruction lookup mismatch for opcode %u\n",
+				id);
+			status = 1;
+			break;
+		}
+	}
+	cs_close(&handle);
+	return status;
+}
