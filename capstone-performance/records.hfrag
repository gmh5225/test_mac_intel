/* Canonical single-byte instructions with register operands or no operands. */
struct X86FixedOperand {
	uint16_t reg;
	uint8_t size;
	uint8_t access;
};

struct X86FixedOutput {
	unsigned id;
	char mnemonic[12];
	char operands[20];
	uint64_t flags;
	uint16_t reads[4];
	uint16_t writes[4];
	uint8_t groups[4];
	uint8_t read_count, write_count, group_count, operand_count;
	uint8_t address_size;
	struct X86FixedOperand ops[2];
};

static inline void X86_writeFixedDetail(cs_detail *detail,
					const struct X86FixedOutput *row,
					uint8_t opcode)
{
	memset(detail, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
	memcpy(detail->regs_read, row->reads, sizeof(row->reads));
	memcpy(detail->regs_write, row->writes, sizeof(row->writes));
	memcpy(detail->groups, row->groups, sizeof(row->groups));
	detail->regs_read_count = row->read_count;
	detail->regs_write_count = row->write_count;
	detail->groups_count = row->group_count;
	cs_x86 *x86 = &detail->x86;
	x86->addr_size = row->address_size;
	x86->opcode[0] = opcode;
	x86->eflags = row->flags;
	x86->op_count = row->operand_count;
	for (unsigned i = 0; i < x86->op_count; ++i) {
		x86->operands[i].type = X86_OP_REG;
		x86->operands[i].reg = (x86_reg)row->ops[i].reg;
		x86->operands[i].size = row->ops[i].size;
		x86->operands[i].access = (cs_ac_type)row->ops[i].access;
	}
}
