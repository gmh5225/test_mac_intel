diff --git a/MCInstPrinter.c b/MCInstPrinter.c
index 97d26582..72b1d7a2 100644
--- a/MCInstPrinter.c
+++ b/MCInstPrinter.c
@@ -220,6 +220,23 @@ const char *markup(const char *s)
 		return no_markup;
 }
 
+void printMarkedRegName(SStream *OS, const char *name)
+{
+#if !defined(CAPSTONE_DIET) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+	/* Preserve the formatter callback and full-stream behavior of the
+	 * translated markup expression. */
+	if (cs_vsnprintf == cs_default_vsnprintf && !getUseMarkup() &&
+	    OS->index < SSTREAM_BUF_LEN - 1 && name && name[0]) {
+		SStream_concat0(OS, name);
+		return;
+	}
+#endif
+	SStream_concat2(OS, markup("<reg:"), name);
+	SStream_concat0(OS, markup(">"));
+}
+
 // binary search for encoding in IndexType array
 // return -1 if not found, or index if found
 unsigned int binsearch_IndexTypeEncoding(const struct IndexType *index,
