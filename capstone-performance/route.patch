 	// detail after detail is turned off.  Much of the decoder tests only
@@ -211,9 +207,19 @@ CS_DECODE_INLINE bool cs_disasm_iter_core(csh ud, const uint8_t **code,
 	detail = insn->detail;
 	if (CS_DECODE_LIKELY(!handle->detail_opt))
 		insn->detail = NULL;
