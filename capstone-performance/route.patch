diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 952b6025..416abb3c 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3078,6 +3078,19 @@ int decodeInstructionFull(struct InternalInstruction *insn, const uint8_t *code,
 
 enum { X86_SCAN_NOT_HANDLED = 3 };
 
+/* Compact terminals return an ID and length. The generic fallback starts
+ * with its own fully initialized raw instruction. */
+X86_DECODE_INLINE void initializeTerminalScan(InternalInstruction *insn,
+					      const uint8_t *code, size_t size,
+					      cs_mode mode)
+{
+	memset(insn, 0, offsetof(InternalInstruction, code));
+	/* The 16-bit register form calls the displacement reader with the
+	 * initial EA_DISP_NONE. */
+	insn->eaDisplacement = EA_DISP_NONE;
+	initializeInstructionHeader(insn, code, size, mode);
+}
+
 /* Only the compact readers see this state. Generic/raw decoding starts its
  * own state if the generated table has no terminal for this header. */
 X86_DECODE_INLINE int trySimpleLegacyScan(const uint8_t *code, size_t codeSize,
@@ -3089,8 +3102,8 @@ X86_DECODE_INLINE int trySimpleLegacyScan(const uint8_t *code, size_t codeSize,
 {
 	if (opcodeOffset >= 2)
 		return X86_SCAN_NOT_HANDLED;
-	InternalInstruction insn = { 0 };
-	initializeInstructionHeader(&insn, code, codeSize, mode);
+	InternalInstruction insn;
+	initializeTerminalScan(&insn, code, codeSize, mode);
 	const uint8_t prefixMask =
 		FEATURE_LEGACY_PREFIX | FEATURE_ESCAPE | FEATURE_VEX2_XOP |
 		(insn.mode == MODE_64BIT ? FEATURE_REX_PREFIX : 0);
@@ -3141,9 +3154,9 @@ tryLegacyPrefixedScan(const uint8_t *code, size_t code_len, cs_mode mode,
 		      unsigned *instructionID, uint16_t *size, bool publicID,
 		      bool guardExtensions, bool readerFlags)
 {
-	InternalInstruction insn = { 0 };
+	InternalInstruction insn;
 	/* Retain the decoder's bitness priority for mixed mode flags. */
-	initializeInstructionHeader(&insn, code, code_len, mode);
+	initializeTerminalScan(&insn, code, code_len, mode);
 	size_t offset = 0;
 	/* Keep the 16-bit size-prefix loop small; other prefixes use the full reader. */
 	while (offset < code_len && (insn.mode == MODE_16BIT || offset < 15)) {
@@ -3415,8 +3428,8 @@ decodeLegacyPrefixedResult(csh ud, const uint8_t *code, size_t code_len,
 X86_DECODE_INLINE int tryVexTerminalScan(const uint8_t *code, size_t code_len,
 					 uint8_t prefix, X86ScanResult *result)
 {
-	InternalInstruction insn = { 0 };
-	initializeInstructionHeader(&insn, code, code_len, CS_MODE_64);
+	InternalInstruction insn;
+	initializeTerminalScan(&insn, code, code_len, CS_MODE_64);
 	insn.readerCursor = 1;
 	if (readVexPrefix(&insn, prefix))
 		return X86_SCAN_INVALID;
@@ -3669,12 +3682,30 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 	return true;
 }
 
+#if defined(_MSC_VER) && !defined(__clang__)
+static __declspec(noinline) bool scanPublicIterator(cs_struct *handle, const uint8_t **code,
+                                                    size_t *size, uint64_t *address,
+                                                    cs_insn *insn)
+{
+    return cs_disasm_iter_mode(handle, code, size, address, insn, true);
+}
+#endif
+
 CAPSTONE_EXPORT
 X86_DECODE_ALIGN
 bool CAPSTONE_API cs_disasm_iter(csh ud, const uint8_t **code, size_t *size,
 				 uint64_t *address, cs_insn *insn)
 {
+#if defined(_MSC_VER) && !defined(__clang__)
+    cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+    if (*size == 0 || !handle)
+        return false;
+    if (use_x86_scan(handle))
+        return scanPublicIterator(handle, code, size, address, insn);
+    return cs_disasm_iter_mode(handle, code, size, address, insn, false);
+#else
 	return cs_disasm_iter_core(ud, code, size, address, insn);
+#endif
 }
 
 X86_DECODE_ALIGN
