+X86_DECODE_INLINE bool advanceModRMExtent(const uint8_t *code, size_t codeSize,
+					  uint8_t modrm, size_t *cursor)
+{
+	size_t end = *cursor + 1;
+	const unsigned mod = modFromModRM(modrm);
+	if (mod != 3) {
+		unsigned base = rmFromModRM(modrm);
+		if (base == 4) {
+			if (end >= codeSize)
+				return false;
+			base = baseFromSIB(code[end]);
+			++end;
+		}
+		if (mod == 1)
+			++end;
+		else if (mod == 2 || base == 5)
+			end += 4;
