static inline void printDecimalDigit(SStream *OS, uint64_t digit, bool negative)
{
#if defined(CAPSTONE_SSTREAM_PRECHECKED) && HEX_THRESHOLD <= 9
	/* printImm has selected a single digit and the generated path has room
	 * for the entire instruction, including the optional sign. */
	assert(digit < 10 && !OS->is_closed && !OS->markup_stream &&
	       !OS->prefixed_by_markup);
	assert(OS->index < SSTREAM_BUF_LEN - (negative ? 2U : 1U));
	char *out = OS->buffer + OS->index;
	if (negative)
		*out++ = '-';
	*out++ = (char)('0' + digit);
	*out = '\0';
	OS->index += negative ? 2U : 1U;
#else
	SStream_concat_dec64(OS, digit, negative);
#endif
}
