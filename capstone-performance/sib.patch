+/* The caller has classified a 32- or 64-bit SIB address and selected its
+ * displacement width. Only mod=0 with SIB base 5 changes that width. */
+X86_DECODE_INLINE int readSIBAndDisplacement(struct InternalInstruction *insn,
+					     bool materialize, uint8_t mod)
+{
+	if (materialize && insn->consumedSIB)
+		return readDisplacement(insn, materialize);
+	if (materialize) {
+		insn->consumedSIB = true;
+		insn->sibIndexBase = insn->addressSize == 4 ? SIB_INDEX_EAX :
+							      SIB_INDEX_RAX;
+	}
+
+	/* A complete SIB + disp8 can be consumed with one bounds check. If
+	 * only the SIB is present, leave the cursor and raw fields exactly
+	 * where the ordered byte and displacement readers would leave them. */
+	uint16_t pair;
+	bool have_pair = mod == 1 &&
+			 !(materialize && insn->consumedDisplacement) &&
+			 consumeUInt16(insn, &pair) == 0;
+	if (have_pair)
+		insn->sib = (uint8_t)pair;
+	else if (consumeByte(insn, &insn->sib))
+		return -1;
+
+	if (materialize) {
+		uint8_t index = indexFromSIB(insn->sib) |
+				(xFromREX(insn->rexPrefix) << 3);
+		insn->sibIndex = index == 4 ?
+					 SIB_INDEX_NONE :
+					 (SIBIndex)(insn->sibIndexBase + index);
+		insn->sibScale = 1 << scaleFromSIB(insn->sib);
+	}
+
+	uint8_t base = baseFromSIB(insn->sib);
+	if (mod == 0 && base == 5) {
+		insn->eaDisplacement = EA_DISP_32;
+		if (materialize)
+			insn->sibBase = SIB_BASE_NONE;
+	} else if (materialize) {
+		SIBBase first = insn->addressSize == 4 ? SIB_BASE_EAX :
+							 SIB_BASE_RAX;
+		base |= bFromREX(insn->rexPrefix) << 3;
+		insn->sibBase = (SIBBase)(first + base);
+	}
+
+	if (!have_pair)
+		return readDisplacement(insn, materialize);
+	if (materialize) {
+		insn->consumedDisplacement = true;
+		insn->displacementOffset = insn->readerCursor - 1;
+		insn->displacementSize = 1;
+		insn->displacement = (int8_t)(pair >> 8);
+	}
+	return 0;
+}
