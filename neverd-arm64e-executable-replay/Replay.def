  "download": [
    "gh",
    "release",
    "download",
    "{release}",
    "--repo",
    "{repository}",
    "--pattern",
    "{asset}"
  ],
  "ctest_registry": "CTestTestfile.cmake",
  "test_definition": "add_test([=[{case}]=] [=[{binary}]=] [=[--gtest_filter={case}]=])\n",
  "report": "replay-report.json",
  "probe": "startup",
  "installation": "installation",
  "build": "build",
  "source_mismatch": "Replay source does not match the pinned source",
  "asset_mismatch": "Replay asset hash mismatch",
  "binary_mismatch": "Replay test host does not match the build manifest",
  "probe_failed": "Native startup preflight did not qualify",
  "installation_failed": "Native executable cases did not qualify",
  "runners": [
    "macos-26",
    "xcode-27"
  ],
  "legacy_runner": "macos-15",
  "replay_timeout": 25,
  "legacy_timeout": 10,
  "preflight": "probe",
  "legacy_fixtures": "legacy-fixtures",
  "dylib_installation": "dylib-installation",
  "test_timeout": 120,
  "test_properties": "set_tests_properties([=[{case}]=] PROPERTIES SKIP_REGULAR_EXPRESSION [==[\\[  SKIPPED \\]]==] TIMEOUT {test_timeout})\n",
  "default_installation": "default-installation",
  "generated_installation": "generated",
  "generated_executable_installation": "generated-executable",
  "ir_tools": [
    "brew",
    "install",
    "llvm@22"
  ],
  "ir_prefix": [
    "brew",
    "--prefix",
    "llvm@22"
  ],
  "ir_compiler_suffix": "bin/clang++",
  "ir_tools_timeout": 900,
  "diagnostic": {
    "directory": "producer-control",
    "case": "AppleClang/MachOArm64eNativeObjectInstallation.GeneratedIREntriesExecute/0",
    "fixture_glob": "neverd-auth-object-*",
    "timeout": 120,
    "compile_ir": [
      "{compiler}",
      "-target",
      "arm64e-apple-macosx14.0.0",
      "-c",
      "{fixture}/native-object.ll",
      "-o",
      "{fixture}/clang22-object.o"
    ],
    "objects": [
      "native-object.o",
      "clang22-object.o",
      "apple-assembled.o",
      "darwin-cfi.o"
    ],
    "link": [
      "/usr/bin/clang++",
      "-arch",
      "arm64e",
      "-std=c++20",
      "-fno-omit-frame-pointer",
      "-fno-optimize-sibling-calls",
      "-dynamiclib",
      "-O0",
      "-DNEVERD_AUTH_CONTROL",
      "{fixture}/fixture.cpp",
      "{fixture}/{object}",
      "{fixture}/provider.cpp",
      "{fixture}/native-runtime.cpp",
      "-o",
      "{fixture}/{object}.dylib"
    ],
    "run": [
      "{fixture}/native-loader.out",
      "{fixture}/{object}.dylib"
    ],
    "debug": [
      "/usr/bin/xcrun",
      "lldb",
      "--batch",
      "-o",
      "settings set target.disable-aslr false",
      "-o",
      "run",
      "-k",
      "bt",
      "-k",
      "register read pc lr sp fp",
      "--",
      "{fixture}/native-loader.out",
      "{fixture}/{object}.dylib"
    ],
    "inspect": [
      "native-object.o",
      "clang22-object.o",
      "native-object.o.dylib",
      "clang22-object.o.dylib",
      "installed.dylib",
      "apple-assembled.o",
      "darwin-cfi.o",
      "darwin-cfi.o.dylib"
    ],
    "dumps": [
      [
        "/usr/bin/xcrun",
        "dwarfdump",
        "--eh-frame"
      ],
      [
        "/usr/bin/xcrun",
        "otool",
        "-l"
      ],
      [
        "/usr/bin/xcrun",
        "otool",
        "-tvV"
      ]
    ],
    "test_log": "test.json",
    "compile_log": "compile-ir.json",
    "record_suffix": ".json",
    "run_suffix": "-run",
    "debug_suffix": "-debug",
    "compile_asm": [
      "{compiler}",
      "-target",
      "arm64e-apple-macosx14.0.0",
      "-S",
      "{fixture}/native-object.ll",
      "-o",
      "{fixture}/clang22-object.s"
    ],
    "assemble": [
      "/usr/bin/clang++",
      "-target",
      "arm64e-apple-macosx14.0.0",
      "-c",
      "{fixture}/{assembly}",
      "-o",
      "{fixture}/{object}"
    ],
    "assembly": "clang22-object.s",
    "darwin_assembly": "darwin-cfi.s",
    "directive": ".cfi_negate_ra_state",
    "ablation_log": "cfi-ablation.json",
    "compile_asm_log": "compile-asm.json",
    "assembly_controls": [
      [
        "clang22-object.s",
        "apple-assembled.o"
      ],
      [
        "darwin-cfi.s",
        "darwin-cfi.o"
      ]
    ]
  }
