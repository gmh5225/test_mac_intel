{
  "source_revision": "eabb96c44b7abaac2f628851968c05a090de5b5d",
  "llvm_revision": "8b74c310a8140953b96df2464b8d091b46bd4fd8",
  "source_repository": "NeverSight/NeverD",
  "source": "neverd",
  "runners": [
    "macos-26",
    "xcode-27"
  ],
  "repository": "gmh5225/test_mac_intel",
  "release": "neverd-arm64e-generated-image-20261110",
  "asset": "native-cfi-fork-control.tar.gz",
  "asset_sha256": "2e92f9fb3496fe128f1b21a975a232e471281dfeab899769bd277bc3fea3c33d",
  "download": [
    "gh",
    "release",
    "download",
    "{release}",
    "--repo",
    "{repository}",
    "--pattern",
    "{asset}"
  ],
  "output": "cfi-control-evidence",
  "manifest": "manifest.json",
  "report": "report.json",
  "products": "products.json",
  "preflight": "probe",
  "timeout": 120,
  "log_suffix": ".json",
  "link": [
    "/usr/bin/clang++",
    "-arch",
    "arm64e",
    "-std=c++20",
    "-fno-omit-frame-pointer",
    "-fno-optimize-sibling-calls",
    "-dynamiclib",
    "-O0",
    "-DNEVERD_AUTH_CONTROL",
    "{fixture}/fixture.cpp",
    "{fixture}/{object}",
    "{fixture}/provider.cpp",
    "{fixture}/native-runtime.cpp",
    "-o",
    "{fixture}/{object}.dylib"
  ],
  "loader": [
    "/usr/bin/clang++",
    "-arch",
    "arm64e",
    "{fixture}/native-loader.cpp",
    "-o",
    "{fixture}/native-loader.out"
  ],
  "run": [
    "{fixture}/native-loader.out",
    "{fixture}/{object}.dylib"
  ],
  "inspect": [
    "/usr/bin/xcrun",
    "dwarfdump",
    "--eh-frame",
    "{fixture}/{object}.dylib"
  ],
  "marker": "native-auth-call-unwind-ok",
  "cases": [
    {
      "object": "O0-compact.o"
    },
    {
      "object": "O0-dwarf.o"
    },
    {
      "object": "O2-compact.o"
    },
    {
      "object": "O2-dwarf.o"
    }
  ],
  "errors": {
    "identity": "Fixed-fork control input identity mismatch",
    "preflight": "Native PAC/unwind preflight failed",
    "execution": "Fixed-fork signed call/catch/cleanup control failed"
  },
  "cleanup_patterns": [
    "*.o",
    "*.dylib",
    "*.out"
  ],
  "loader_log": "loader",
  "link_suffix": "-link",
  "unwind_suffix": "-unwind",
  "execute_suffix": "-execute",
  "image_suffix": ".dylib"
}
