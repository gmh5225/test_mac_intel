+		throw std::runtime_error("missing SSE2 register forms");
+	std::puts(
+		"static const struct VectorOutputRow legacy_register_rows[] = {\n\t{ 0 },");
+	for (const auto &row : rows)
+		std::printf("\t%s,\n", row.c_str());
