diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 90ef6e93..fa0a0714 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3276,6 +3276,11 @@ CAPSTONE_INTERNAL bool X86_setScanAdapter(csh ud, cs_mode mode,
 X86_DECODE_INLINE int tryVexTerminalScan(const uint8_t *code, size_t code_len,
 					 uint8_t prefix, X86ScanResult *result);
 
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE)
+static bool tryEvexTerminalScan(const uint8_t *code, size_t size,
+				X86ScanResult *result);
+#endif
+
 /* Only generic and extension decoding need an MCInst in the core scan path. */
 #if defined(_MSC_VER)
 __declspec(noinline)
@@ -3312,13 +3317,20 @@ decodeScanResultGeneric(csh ud, const uint8_t *code, size_t code_len,
 			if (status != X86_SCAN_NOT_HANDLED)
 				return status == X86_SCAN_COMPLETE;
 		}
-		bool decoded = opcode == 0x62 ?
-				       X86_getInstructionAfterExtensions(
-					       ud, code, code_len, &instr,
-					       &size, opcode) :
-				       decodeGenericScan(code, code_len,
-							 handle->mode, &instr,
-							 &size);
+		bool decoded;
+		if (opcode == 0x62) {
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE)
+			if (handle->mode == CS_MODE_64 &&
+			    handle->insn_id == X86_get_insn_id &&
+			    tryEvexTerminalScan(code, code_len, result))
+				return true;
+#endif
+			decoded = X86_getInstructionAfterExtensions(
+				ud, code, code_len, &instr, &size, opcode);
+		} else {
+			decoded = decodeGenericScan(
+				code, code_len, handle->mode, &instr, &size);
+		}
 		if (!decoded)
 			return false;
 	}
@@ -3751,6 +3763,51 @@ CAPSTONE_INTERNAL uint16_t X86_scanCallTarget(csh ud, const uint8_t *code,
 	return (uint16_t)insn.length;
 }
 
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE)
+#include "X86GenEvexScan.inc"
+/* An unprefixed EVEX packet has its ModR/M at byte five. Only immutable
+ * public IDs of ordinary vector register or base/index addresses are used. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static bool tryEvexTerminalScan(const uint8_t *code, size_t size,
+				X86ScanResult *result)
+{
+	if (size < 6 || code[0] != 0x62 || !(code[2] & 4) || (code[3] & 0x97) ||
+	    (code[3] & 0x60) == 0x60)
+		return false;
+	unsigned key = ((code[1] & 15) << 10) | ((code[2] & 3) << 8) | code[4];
+	const struct X86EvexScanForm *form = evex_scan_form(key);
+	if (!form ||
+	    (form->reserved_v && ((code[2] & 0x78) != 0x78 || !(code[3] & 8))))
+		return false;
+	bool reg = code[5] >= 0xc0;
+	unsigned id = form->ids[code[2] >> 7][code[3] >> 5][reg];
+	if (!id)
+		return false;
+	size_t length = 6;
+	if (!reg) {
+		InternalInstruction insn = { 0 };
+		initializeInstructionHeader(&insn, code, size, CS_MODE_64);
+		insn.readerCursor = 5;
+		insn.addressSize = 8;
+		if (readModRMScan(&insn))
+			return false;
+		length = insn.readerCursor;
+	}
+	length += form->immediate;
+	if (length > size)
+		return false;
+	result->opcode = 0;
+	result->opcode_pub = id;
+	result->length = (uint16_t)length;
+	result->popcode_adjust = 0;
+	return true;
+}
+#endif
+
 #undef CS_DECODE_INLINE
 #undef CS_DECODE_LIKELY
 #undef CS_DECODE_UNLIKELY
