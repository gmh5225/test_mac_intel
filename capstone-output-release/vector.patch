+#include "X86GenEvexOutput.inc"
+static char *writeVectorRegister(char *out, unsigned length_code,
+				 unsigned number)
+{
+	*out++ = "xyz"[length_code];
+	*out++ = 'm';
+	*out++ = 'm';
+	if (number >= 10)
+		*out++ = (char)('0' + number / 10);
+	*out++ = (char)('0' + number % 10);
+	return out;
+}
+
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static bool writeEvexRegisterOutput(const uint8_t *code, size_t size,
+				    cs_insn *insn, uint16_t *insn_size)
+{
+	if (size < 6 || (code[2] & 7) != 5 || (code[3] & 0x97) ||
+	    (code[3] & 0x60) == 0x60 || code[5] < 0xc0)
+		return false;
+	const unsigned ll = code[3] >> 5;
+	const unsigned w = code[2] >> 7;
+	const struct EvexOutputRow *row =
+		evexOutputRow(((code[1] & 15) << 8) | code[4], w, ll);
+	if (!row || (row->immediate && size < 7))
+		return false;
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & 7;
+	const unsigned regs[] = { ((code[5] >> 3) & 7) | ((rxb & 4) << 1) |
+					  (~(unsigned)code[1] & 16),
+				  ((~(unsigned)code[2] >> 3) & 15) |
+					  ((~(unsigned)code[3] & 8) << 1),
+				  (code[5] & 7) | ((rxb & 3) << 3) };
+	const unsigned len = 6 + row->immediate;
+	*insn_size = insn->size = (uint16_t)len;
+	insn->id = row->id;
+	memcpy(insn->bytes, code, len);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = writeVectorRegister(insn->op_str, ll, regs[0]);
+	for (unsigned n = 1; n != 3; ++n) {
+		memcpy(out, ", ", 2);
+		out = writeVectorRegister(out + 2, ll, regs[n]);
+	}
+	if (row->immediate) {
+		const unsigned value = code[6];
+		memcpy(out, ", ", 2);
+		out += 2;
+		if (value <= HEX_THRESHOLD) {
+			*out = (char)('0' + value);
+		} else {
+			static const char digits[] = "0123456789abcdef";
+			memcpy(out, "0x", 2);
+			out += 2;
+			if (value >= 16)
+				*out++ = digits[value >> 4];
+			*out = digits[value & 15];
+		}
+	}
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		memcpy(d->groups, row->groups, sizeof(row->groups));
+		d->groups_count = row->group_count;
+		cs_x86 *x = &d->x86;
+		memcpy(x->opcode, code, sizeof(x->opcode));
+		x->addr_size = 8;
+		x->rex = (uint8_t)(0x40 | (w << 3) | rxb);
+		x->modrm = code[5];
+		x->encoding.modrm_offset = 5;
+		x->op_count = 3 + row->immediate;
+		static const x86_reg bases[] = { X86_REG_XMM0, X86_REG_YMM0,
+						 X86_REG_ZMM0 };
+		for (unsigned n = 0; n != 3; ++n) {
+			cs_x86_op *op = &x->operands[n];
+			op->type = X86_OP_REG;
+			op->reg = (x86_reg)(bases[ll] + regs[n]);
+			op->access = (cs_ac_type)row->access[n];
+			op->size = (uint8_t)(16 << ll);
+		}
+		if (row->immediate) {
+			x->operands[3].type = X86_OP_IMM;
+			x->operands[3].imm = code[6];
+			x->operands[3].access = (cs_ac_type)row->access[3];
+			x->operands[3].size = 1;
+			x->encoding.imm_offset = 6;
+			x->encoding.imm_size = 1;
+		}
+	}
+	return true;
+}
+
+/* The /digit selects the same flags and register access as the corresponding
+ * ALU register pair. The immediate's public width follows the destination. */
+static void writeGroup1Immediate(cs_insn *insn,
+				 const struct X86SimpleOutput *row,
+				 const uint8_t *code, uint8_t rex,
+				 uint8_t modrm, uint16_t *insn_size)
+{
+	const unsigned offset = 2 + (rex != 0);
+	const int immediate = (int8_t)code[offset];
+	const unsigned group = (modrm >> 3) & 7;
+	const bool logical = group == 1 || group == 4 || group == 6;
+	const bool wide = (rex & 8) != 0;
+	const bool negative = !logical && immediate < 0;
+	const uint64_t value =
+		logical ? (wide ? (uint64_t)(int64_t)immediate :
+				  (uint32_t)immediate) :
+			  (uint64_t)(negative ? -immediate : immediate);
+	const unsigned id = ((rex & 1) << 3) | (modrm & 7);
+	const struct X86SimpleRegister *reg =
+		&x86_simple_registers[wide ? 3 : 2][id];
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)(offset + 1);
+	memcpy(insn->bytes, code, insn->size);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, reg->name, sizeof(reg->name));
+	char *out = insn->op_str + reg->length;
+	memcpy(out, ", ", 2);
+	out += 2;
+	if (negative)
+		*out++ = '-';
+	if (value <= HEX_THRESHOLD) {
+		*out = (char)('0' + value);
+	} else {
+		static const char digits[] = "0123456789abcdef";
+		char temp[16], *end = temp + sizeof(temp), *start = end;
+		uint64_t n = value;
+		do {
+			*--start = digits[n & 15];
+			n >>= 4;
+		} while (n);
+		memcpy(out, "0x", 2);
+		memcpy(out + 2, start, end - start);
+	}
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, 0x83, rex, modrm,
+				      reg->reg, 0);
+		cs_x86 *x = &insn->detail->x86;
+		x->operands[1].type = X86_OP_IMM;
+		x->operands[1].imm = logical && !wide ?
+					     (int64_t)(uint32_t)immediate :
+					     immediate;
+		x->operands[1].access = 0;
+		x->encoding.imm_offset = (uint8_t)offset;
+		x->encoding.imm_size = 1;
+	}
+}
