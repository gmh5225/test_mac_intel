+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+// Build against a full x86 Capstone library. Run with --scan or --output
+// and redirect stdout to X86GenEvexScan.inc or X86GenEvexOutput.inc.
+#include <capstone/capstone.h>
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace
+{
+struct Form {
+	unsigned map, prefix, opcode;
+	bool immediate, reserved_v;
+	bool register_output;
+};
+
+// These are ordinary packed-vector forms with a GPR address (no VSIB).
+// Some W, length and ModR/M combinations are unassigned. The full decoder
+// below decides which combinations can have a terminal row.
+constexpr Form forms[] = {
+	{ 1, 1, 0xef, false, false, true },
+	{ 2, 1, 0xdc, false, false, true },
+	{ 2, 1, 0xdd, false, false, true },
+	{ 2, 1, 0xde, false, false, true },
+	{ 2, 1, 0xdf, false, false, true },
+	{ 3, 1, 0x44, true, false, true },
+	{ 3, 1, 0x25, true, false, true },
+	{ 2, 1, 0x1a, false, true, false },
+	{ 2, 1, 0x5a, false, true, false },
+	{ 1, 1, 0x6f, false, true, false },
+	{ 1, 2, 0x6f, false, true, false },
+	{ 1, 3, 0x6f, false, true, false },
+	{ 1, 1, 0x7f, false, true, false },
+	{ 1, 2, 0x7f, false, true, false },
+	{ 1, 3, 0x7f, false, true, false },
+	{ 3, 1, 0x39, true, true, false },
+	{ 3, 1, 0x3b, true, true, false },
+	{ 2, 1, 0x00, false, false, true },
+	{ 1, 1, 0xfe, false, false, true },
+	{ 1, 1, 0xd4, false, false, false },
+	{ 3, 1, 0x43, true, false, false },
+	{ 2, 1, 0xb4, false, false, false },
+	{ 2, 1, 0xb5, false, false, false },
+	{ 3, 1, 0x38, true, false, false },
+	{ 3, 1, 0x03, true, false, false },
+	{ 1, 1, 0xdb, false, false, false },
+};
+
+struct Decoder {
+	csh handle = 0;
+	cs_insn *insn = nullptr;
+	uint64_t probes = 0;
+	Decoder()
+	{
+		// Text, detail and a custom name make regeneration independent of
+		// both the compact scan reader and the optimized output records.
+		cs_opt_mnem name = { X86_INS_UD2, "ud2" };
+		if (cs_open(CS_ARCH_X86, CS_MODE_64, &handle) ||
+		    cs_option(handle, CS_OPT_DETAIL, CS_OPT_ON) ||
+		    cs_option(handle, CS_OPT_MNEMONIC,
+			      reinterpret_cast<size_t>(&name)) ||
+		    !(insn = cs_malloc(handle)))
+			throw std::runtime_error(
+				"cannot initialize the full x86 decoder");
+	}
+	~Decoder()
+	{
+		cs_free(insn, 1);
+		cs_close(&handle);
+	}
+	unsigned decode(const uint8_t *bytes, unsigned length)
+	{
+		const uint8_t *cursor = bytes;
+		uint64_t ip = 0x100000012;
+		size_t left = length;
+		++probes;
+		if (!cs_disasm_iter(handle, &cursor, &left, &ip, insn) ||
+		    left || cursor != bytes + length)
+			return 0;
+		return insn->id;
+	}
+	std::string symbol(unsigned id) const
+	{
+		if (!id)
+			return "0";
+		const char *name = cs_insn_name(handle, id);
+		if (!name)
+			throw std::runtime_error("missing instruction name");
+		std::string result(name);
+		for (char &c : result) {
+			if (c >= 'a' && c <= 'z')
+				c = char(c - 'a' + 'A');
+		}
+		return "X86_INS_" + result;
+	}
+};
+
+unsigned scan_id(Decoder &decoder, const Form &form, unsigned w, unsigned ll,
+		 bool reg)
+{
+	unsigned expected = 0;
+	const unsigned first_v = form.reserved_v ? 31 : 0;
+	for (unsigned high = 0; high < 16; ++high) {
+		for (unsigned v = first_v; v < 32; ++v) {
+			for (unsigned modrm = reg ? 192 : 0;
+			     modrm < (reg ? 256u : 192u); ++modrm) {
+				const unsigned mod = modrm >> 6, rm = modrm & 7;
+				const bool sib = mod != 3 && rm == 4;
+				// Sweep every SIB and immediate at least once per ModR/M.
+				// R/X/B and vvvv only select registers for these opcodes.
+				const unsigned sib_count =
+					!sib			  ? 1 :
+					high == 0 && v == first_v ? 256 :
+								    2;
+				for (unsigned index = 0; index < sib_count;
+				     ++index) {
+					const unsigned sib_byte =
+						sib_count == 2 ?
+							(index ? 0x25 : 0x08) :
+							index;
+					const unsigned base =
+						sib ? sib_byte & 7 : rm;
+					const unsigned disp =
+						mod == 2 || (mod == 0 &&
+							     base == 5) ?
+							4 :
+						mod == 1 ? 1 :
+							   0;
+					const unsigned tail = 6 + sib + disp;
+					uint8_t bytes[15] = {
+						0x62,
+						uint8_t(high << 4 | form.map),
+						uint8_t(w << 7 | (v & 15) << 3 |
+							4 | form.prefix),
+						uint8_t(ll << 5 | (v >> 4)
+									  << 3),
+						uint8_t(form.opcode),
+						uint8_t(modrm),
+						uint8_t(sib_byte),
+						0x19,
+						0xed,
+						0xa5,
+						0xaa,
+						0x81
+					};
+					const unsigned immediates =
+						form.immediate && high == 0 &&
+								v == first_v &&
+								index == 0 ?
+							256 :
+							1;
+					for (unsigned value = 0;
+					     value < immediates; ++value) {
+						if (form.immediate)
+							bytes[tail] =
+								immediates == 256 ?
+									uint8_t(value) :
+									uint8_t(high +
+										v +
+										modrm +
+										sib_byte);
+						const unsigned id = decoder.decode(
+							bytes,
+							tail + form.immediate);
+						if (!id || (expected &&
+							    id != expected))
+							return 0;
+						expected = id;
+					}
+				}
+			}
+		}
+	}
+	return expected;
+}
+
+void emit_scan(Decoder &decoder)
+{
+	std::puts(
+		"struct X86EvexScanForm {\n\tuint16_t ids[2][3][2];\n\tbool immediate;\n\tbool reserved_v;\n};\nstatic const struct X86EvexScanForm x86_evex_scan_forms[] = {");
+	for (const auto &form : forms) {
+		std::printf("\t{ { ");
+		for (unsigned w = 0; w < 2; ++w) {
+			std::printf("{ ");
+			for (unsigned ll = 0; ll < 3; ++ll) {
+				const auto mem = decoder.symbol(
+					scan_id(decoder, form, w, ll, false));
+				const auto reg = decoder.symbol(
+					scan_id(decoder, form, w, ll, true));
+				std::printf("{ %s, %s }%s", mem.c_str(),
+					    reg.c_str(), ll == 2 ? " }" : ", ");
+			}
+			std::printf("%s", w ? " }" : ", ");
+		}
+		std::printf(", %s, %s },\n", form.immediate ? "true" : "false",
+			    form.reserved_v ? "true" : "false");
+	}
+	std::puts(
+		"};\nstatic const struct X86EvexScanForm *evex_scan_form(unsigned key)\n{\n\tswitch (key) {");
+	unsigned index = 0;
+	for (const auto &form : forms)
+		std::printf("\tcase 0x%x: return &x86_evex_scan_forms[%u];\n",
+			    form.map << 10 | form.prefix << 8 | form.opcode,
+			    index++);
+	std::puts("\tdefault: return NULL;\n\t}\n}");
+}
+
+using Bytes4 = std::array<unsigned, 4>;
+using WidthRows = std::array<std::array<unsigned, 3>, 2>;
+std::string fields(const Bytes4 &array)
+{
+	return "{ " + std::to_string(array[0]) + ", " +
+	       std::to_string(array[1]) + ", " + std::to_string(array[2]) +
+	       ", " + std::to_string(array[3]) + " }";
+}
+
+std::string output_record(Decoder &decoder, const Form &form, unsigned w,
+			  unsigned ll)
+{
+	uint8_t bytes[] = { 0x62,
+			    uint8_t(0xf0 | form.map),
+			    uint8_t(w << 7 | 0x6d),
+			    uint8_t(ll << 5 | 8),
+			    uint8_t(form.opcode),
+			    0xd9,
+			    0x80 };
+	const unsigned size = 6 + form.immediate;
+	const unsigned id = decoder.decode(bytes, size);
+	if (!id)
+		return {};
+	const cs_insn &insn = *decoder.insn;
+	const auto &detail = *insn.detail;
+	const auto &x = detail.x86;
+	const x86_reg bases[] = { X86_REG_XMM0, X86_REG_YMM0, X86_REG_ZMM0 };
+	const std::string prefix[] = { "xmm", "ymm", "zmm" };
+	const std::string &vec = prefix[ll];
+	const std::string rendered = vec + "3, " + vec + "2, " + vec + "1" +
+				     (form.immediate ? ", 0x80" : "");
+	if (rendered != insn.op_str || std::strlen(insn.mnemonic) >= 16 ||
+	    std::strcmp(cs_insn_name(decoder.handle, id), insn.mnemonic) ||
+	    detail.regs_read_count || detail.regs_write_count ||
+	    detail.groups_count > 4 || x.op_count != 3 + form.immediate ||
+	    x.eflags || x.addr_size != 8 || std::memcmp(x.opcode, bytes, 4) ||
+	    x.rex != (0x40 | w << 3) || x.modrm != bytes[5] ||
+	    x.encoding.modrm_offset != 5)
+		throw std::runtime_error("unexpected EVEX register output");
+	Bytes4 groups{}, access{};
+	for (unsigned i = 0; i < detail.groups_count; ++i)
+		groups[i] = detail.groups[i];
+	for (unsigned i = 0; i < 3; ++i) {
+		const auto &op = x.operands[i];
+		if (op.type != X86_OP_REG ||
+		    unsigned(op.reg) != unsigned(bases[ll]) + 3 - i ||
+		    op.size != (16u << ll))
+			throw std::runtime_error(
+				"unexpected EVEX register operand");
+		access[i] = op.access;
+	}
+	if (form.immediate) {
+		const auto &op = x.operands[3];
+		if (op.type != X86_OP_IMM || op.imm != 0x80 || op.size != 1 ||
+		    x.encoding.imm_offset != 6 || x.encoding.imm_size != 1)
+			throw std::runtime_error("unexpected EVEX immediate");
+		access[3] = op.access;
+	}
+	return "{ " + decoder.symbol(id) + ", \"" + insn.mnemonic + "\", " +
+	       std::to_string(detail.groups_count) + ", " + fields(groups) +
+	       ", " + fields(access) + ", " + std::to_string(form.immediate) +
+	       " }";
+}
+
+void emit_output(Decoder &decoder)
+{
+	std::vector<std::string> records;
+	std::map<unsigned, WidthRows> plans;
+	for (const auto &form : forms) {
+		if (!form.register_output)
+			continue;
+		auto &rows = plans[form.map << 8 | form.opcode];
+		for (unsigned ll = 0; ll < 3; ++ll) {
+			for (unsigned w = 0; w < 2; ++w) {
+				auto row = output_record(decoder, form, w, ll);
+				if (row.empty()) {
+					rows[w][ll] = UINT8_MAX;
+					continue;
+				}
+				const auto i = std::find(records.begin(),
+							 records.end(), row);
+				const auto index = static_cast<size_t>(
+					i - records.begin());
+				if (index >= UINT8_MAX)
+					throw std::runtime_error(
+						"too many EVEX output rows");
+				rows[w][ll] = unsigned(index);
+				if (i == records.end())
+					records.push_back(row);
+			}
+		}
+	}
+	std::puts(
+		"struct EvexOutputRow {\n\tuint16_t id;\n\tchar mnemonic[16];\n\tuint8_t group_count, groups[4], access[4], immediate;\n};\nstatic const struct EvexOutputRow evex_output_rows[] = {");
+	for (const auto &row : records)
+		std::printf("\t%s,\n", row.c_str());
+	std::puts(
+		"};\nstatic const struct EvexOutputRow *evexOutputRow(unsigned key, unsigned w, unsigned ll)\n{\n\tswitch (key) {");
+	for (auto &[key, rows] : plans) {
+		std::printf(
+			"\tcase 0x%x: {\n\t\tstatic const uint8_t rows[2][3] = { { %u, %u, %u }, { %u, %u, %u } };\n",
+			key, rows[0][0], rows[0][1], rows[0][2], rows[1][0],
+			rows[1][1], rows[1][2]);
+		std::puts(
+			"\t\treturn rows[w][ll] == UINT8_MAX ? NULL : &evex_output_rows[rows[w][ll]];\n\t}");
+	}
+	std::puts("\tdefault: return NULL;\n\t}\n}");
+}
+}
+
+int main(int argc, char **argv)
+{
+	if (argc != 2 || (std::strcmp(argv[1], "--scan") &&
+			  std::strcmp(argv[1], "--output"))) {
+		std::fputs("usage: x86_evex_tables --scan | --output\n",
+			   stderr);
+		return 2;
+	}
+	Decoder decoder;
+	std::puts("/* Generated by suite/synctools/x86_evex_tables.cpp. */");
+	if (!std::strcmp(argv[1], "--scan"))
+		emit_scan(decoder);
+	else
+		emit_output(decoder);
+	std::fprintf(stderr, "%llu ordinary decoder probes\n",
+		     static_cast<unsigned long long>(decoder.probes));
+}
