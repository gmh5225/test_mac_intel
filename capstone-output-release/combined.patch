+				fprintf(stderr,
+					"broadcast access mismatch %s %s mode=%u AT&T=%d mask=%u\n",
+					insn->mnemonic, insn->op_str,
+					(unsigned)mode, att, pred);
+			}
+			cs_free(insn, 1);
+			if (!ok)
+				return false;
+		}
+	}
+	return true;
+}
