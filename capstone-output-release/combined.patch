+/* Keep the tag stores at their construction sites. */
+#if defined(_MSC_VER)
+#define CS_MCOPERAND_INIT_INLINE static __forceinline
+#elif defined(__GNUC__) || defined(__clang__)
+#define CS_MCOPERAND_INIT_INLINE static inline __attribute__((always_inline))
+#else
+#define CS_MCOPERAND_INIT_INLINE static inline
+#endif
+
+/* Initialize both compatibility tags together; the union keeps its type. */
+CS_MCOPERAND_INIT_INLINE void MCOperand_initReg(MCOperand *op, unsigned Reg)
+{
+#ifdef __cplusplus
+	static const MCOperand tag = { MCOperand::kRegister,
+				       MCOperand::kRegister,
+				       { 0 } };
+#else
+	static const MCOperand tag = { kRegister, kRegister, { 0 } };
+#endif
+	memcpy(op, &tag, offsetof(MCOperand, RegVal));
+	op->RegVal = Reg;
+}
+
+CS_MCOPERAND_INIT_INLINE void MCOperand_initImm(MCOperand *op, int64_t Val)
+{
+#ifdef __cplusplus
+	static const MCOperand tag = { MCOperand::kImmediate,
+				       MCOperand::kImmediate,
+				       { 0 } };
+#else
+	static const MCOperand tag = { kImmediate, kImmediate, { 0 } };
+#endif
+	memcpy(op, &tag, offsetof(MCOperand, ImmVal));
+	op->ImmVal = Val;
+}
+
+#undef CS_MCOPERAND_INIT_INLINE
+
