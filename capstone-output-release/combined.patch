diff --git a/CMakeLists.txt b/CMakeLists.txt
index 88676e41..4b245eaa 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -450,6 +450,14 @@ if(CAPSTONE_X86_SUPPORT)
         arch/X86/X86Module.c
         arch/X86/X86OutputIterator.c
     )
+    # Use scalar/vector stores or libc for the fixed public output buffers.
+    # Generic x64 GCC otherwise emits REP STOS even for the short clears.
+    if(capstone_enabled_architectures STREQUAL "X86" AND CMAKE_C_COMPILER_ID STREQUAL "GNU"
+       AND CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SIZEOF_VOID_P EQUAL 8
+       AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
+        set_property(SOURCE arch/X86/X86OutputIterator.c
+            APPEND PROPERTY COMPILE_OPTIONS "$<$<CONFIG:Release>:-mstringop-strategy=libcall>")
+    endif()
     # MSVC can inline the decoder into the public iterator under LTCG, giving
     # even a compact scan a very large probed stack frame.
     if(CMAKE_C_COMPILER_ID STREQUAL "MSVC" AND MSVC_C_ARCHITECTURE_ID STREQUAL "x64")
diff --git a/Makefile b/Makefile
index c60287ce..bcaf30f1 100644
--- a/Makefile
+++ b/Makefile
@@ -646,6 +646,18 @@ else
 	@echo "Skipping tests on whole corpus"
 endif
 
+# Match the Release x86-only formatter tuning for the compiler's target.
+ifeq ($(sort $(CAPSTONE_ARCHS)),x86)
+ifneq (,$(filter -O2 -O3,$(CFLAGS)))
+X86_OUTPUT_STORE_FLAG := $(shell $(CC) $(CFLAGS) -dM -E -x c - < /dev/null 2>/dev/null | \
+    awk '$$2 == "__linux__" { linux_target=1 } $$2 == "__x86_64__" { x64=1 } \
+         $$2 == "__GNUC__" { gcc=1 } $$2 == "__clang__" { clang_cc=1 } \
+         $$2 == "__SIZEOF_POINTER__" { ptr=$$3 } \
+         END { if (linux_target && x64 && gcc && !clang_cc && ptr==8) print "-mstringop-strategy=libcall" }')
+$(OBJDIR)/arch/X86/X86OutputIterator.o: CFLAGS += $(X86_OUTPUT_STORE_FLAG)
+endif
+endif
+
 $(OBJDIR)/%.o: %.c
 	@mkdir -p $(@D)
 ifeq ($(V),0)
diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 903529a8..76fdbcb7 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -2942,10 +2942,10 @@ X86_DECODE_INLINE int finishDecodedInstruction(struct InternalInstruction *insn,
 	return 0;
 }
 
-/* AArch64 GCC materializes the general legacy reader state even when
- * scanning only for the public ID and length. */
-#if defined(CAPSTONE_X86_ONLY) && defined(__linux__) && defined(__aarch64__) && \
-    defined(__GNUC__) && !defined(__clang__)
+/* GCC materializes the general legacy reader state on these Linux hosts.
+ * The generated terminal row already provides the public ID and extent. */
+#if defined(CAPSTONE_X86_ONLY) && defined(__linux__) && defined(__GNUC__) && \
+    !defined(__clang__) && (defined(__x86_64__) || defined(__aarch64__))
 #define X86_COMPACT_PUBLIC_HEADER
 #endif
 
