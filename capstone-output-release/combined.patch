+bool X86_writeImmediateOutput(const uint8_t *code, size_t size, cs_insn *insn,
+			      uint16_t *insn_size, unsigned plan, uint8_t rex,
+			      bool wide, const uint16_t *plans,
+			      const struct X86SimpleOutput *rows,
+			      const struct X86SimpleRegister (*regs)[16],
+			      const uint16_t *push_rows,
+			      const uint16_t *shift_rows)
