diff --git a/Mapping.c b/Mapping.c
index b2be73de..aa1c5b85 100644
--- a/Mapping.c
+++ b/Mapping.c
@@ -583,3 +583,22 @@ uint64_t enum_map_bin_search(const cs_enum_id_map *map, size_t map_len,
 	*found = false;
 	return UINT64_MAX;
 }
+
+#if !defined(CAPSTONE_USE_ALIAS_TRIE) && \
+	(defined(CAPSTONE_HAS_AARCH64) || defined(CAPSTONE_HAS_MIPS))
+void map_set_alias_id_grouped(MCInst *MI, const SStream *O, const name_map *map,
+			      const uint16_t *offsets)
+{
+	if (!MCInst_isAlias(MI)) {
+		MI->flat_insn->alias_id = 0;
+		return;
+	}
+	const char *name = O->buffer;
+	while (is_blank_char(*name))
+		++name;
+	unsigned prefix = (unsigned char)*name;
+	unsigned first = offsets[prefix];
+	// The existing reader owns mnemonic delimiters and the 15-byte limit.
+	map_set_alias_id(MI, O, map + first, offsets[prefix + 1] - first);
+}
+#endif
