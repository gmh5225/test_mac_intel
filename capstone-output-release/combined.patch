+						 writes, &nw) == CS_ERR_OK &&
+				  nw == 1 && writes[0] == dest &&
+				  nr == 1 + masked + merging &&
+				  arr_exist_inline(reads, nr, base) &&
+				  arr_exist_inline(reads, nr, dest) ==
+					  merging &&
+				  arr_exist_inline(reads, nr, X86_REG_K3) ==
+					  masked;
