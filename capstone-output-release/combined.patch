+CAPSTONE_INTERNAL bool X86_tryEvexScan(const uint8_t *code, size_t size,
+				       X86ScanResult *result)
+{
+	if (size < 6 || code[0] != 0x62 || !(code[2] & 4) || (code[3] & 0x97) ||
+	    (code[3] & 0x60) == 0x60)
+		return false;
+	unsigned key = ((code[1] & 15) << 10) | ((code[2] & 3) << 8) | code[4];
+	const struct X86EvexScanForm *form = evex_scan_form(key);
+	if (!form ||
+	    (form->reserved_v && ((code[2] & 0x78) != 0x78 || !(code[3] & 8))))
+		return false;
+	bool reg = code[5] >= 0xc0;
+	unsigned id = form->ids[code[2] >> 7][code[3] >> 5][reg];
+	if (!id)
+		return false;
+	/* In 64-bit address mode the ModR/M mod and r/m fields determine the
+	 * extent, except for a no-base SIB with mod=0. Only that SIB is read. */
+	static const uint8_t extra[4][8] = {
+		{ 0, 0, 0, 0, 1, 4, 0, 0 },
+		{ 1, 1, 1, 1, 2, 1, 1, 1 },
+		{ 4, 4, 4, 4, 5, 4, 4, 4 },
+		{ 0, 0, 0, 0, 0, 0, 0, 0 },
+	};
+	unsigned length =
+		6 + extra[code[5] >> 6][code[5] & 7] + form->immediate;
+	if ((code[5] & 0xc7) == 4) {
+		if (size <= 6)
+			return false;
+		if ((code[6] & 7) == 5)
+			length += 4;
+	}
+	if (length > size)
+		return false;
+	result->opcode = 0;
+	result->opcode_pub = id;
+	result->length = (uint16_t)length;
+	result->popcode_adjust = 0;
+	return true;
