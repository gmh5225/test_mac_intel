+			bool ok = insn->id == forms[f].id &&
+				  x->op_count == 2 + masked &&
+				  dst->type == X86_OP_REG && dst->reg == dest &&
+				  dst->access == (merging ? CS_AC_READ_WRITE :
+							    CS_AC_WRITE) &&
+				  mem->type == X86_OP_MEM &&
+				  mem->access == CS_AC_READ &&
+				  (!masked || (mask->type == X86_OP_REG &&
+					       mask->reg == X86_REG_K3 &&
+					       mask->access == CS_AC_READ)) &&
