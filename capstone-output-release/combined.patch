diff --git a/cs.c b/cs.c
index b2db69da..a50dcf14 100644
--- a/cs.c
+++ b/cs.c
@@ -1034,6 +1034,39 @@ static inline void fill_insn(struct cs_struct *handle, cs_insn *insn,
 #endif
 }
 
+#if defined(CAPSTONE_ARM_PRIVATE_STREAM) && !defined(CAPSTONE_DIET) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#define CS_ARM_PRIVATE_PRINTER
+/* Keep output stream storage and formatting outside the ARM scan caller. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static void print_arm_insn(cs_struct *handle, cs_insn *insn,
+			   const uint8_t *code, MCInst *mci)
+{
+	SStream ss;
+	/* Alias allocation hooks can install a formatter while printing. */
+	if (cs_mem_malloc == malloc && cs_mem_free == free &&
+	    cs_vsnprintf == vsnprintf) {
+		ss.buffer[0] = '\0';
+		ss.index = 0;
+		ss.is_closed = false;
+		ss.markup_stream = false;
+		ss.prefixed_by_markup = false;
+		ss.unsigned_num = false;
+	} else {
+		SStream_Init(&ss);
+	}
+	SStream_opt_unum(&ss, handle->imm_unsigned);
+	handle->printer(mci, &ss, handle->printer_info);
+	fill_insn(handle, insn, &ss, mci, handle->post_printer, code, false);
+}
+#endif
+
 /* Keep the full decoder's stack frame off generated-output hits, while
  * retaining the public iterator's scan code and private calling convention. */
 #if defined(CAPSTONE_X86_DEDICATED_OUTPUT) && defined(__clang__) && defined(__x86_64__)
@@ -1106,6 +1139,9 @@ cs_decode_full_insn(cs_struct *handle, const uint8_t *code, size_t size,
 		fill_insn_without_text(insn, MCInst_getOpcodePub(&mci), code,
 				       false);
 	} else {
+#ifdef CS_ARM_PRIVATE_PRINTER
+		print_arm_insn(handle, insn, code, &mci);
+#else
 		SStream ss;
 #if defined(CAPSTONE_HAS_X86) && !defined(CAPSTONE_DIET) && \
 	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
@@ -1136,6 +1172,7 @@ cs_decode_full_insn(cs_struct *handle, const uint8_t *code, size_t size,
 			fill_insn(handle, insn, &ss, &mci, handle->post_printer,
 				  code, false);
 		}
+#endif
 	}
 	if (handle->arch == CS_ARCH_X86 && (!batch || insn->id != X86_INS_VCMP))
 		insn->id += mci.popcode_adjust;
