+	const unsigned lead = rex != 0;
+	const uint8_t opcode = code[lead];
+	if (plan == X86_PLAN_PUSH_IMMEDIATE)
+		return writePushImmediate(insn, code, size,
+					  &rows[push_rows[opcode == 0x6a]],
+					  wide, insn_size);
