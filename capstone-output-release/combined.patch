 ### Component 2 - Mapping logic
 
+The private `cs_struct.insn_id` callback is optional. Backends that already map
+public IDs during decoding leave it `NULL`; the core invokes a non-null mapper
+after successful decoding and before printing, in both iterator and batch APIs.
+
 The mapping component has three different task:
 
 1. Serving as programmable interface for the Capstone core to the LLVM code.
diff --git a/tests/unit/mapping.c b/tests/unit/mapping.c
index 7f588c14..f42dacc2 100644
--- a/tests/unit/mapping.c
+++ b/tests/unit/mapping.c
@@ -255,6 +255,136 @@ static bool test_full_group_map(void)
 	return true;
 }
 
+static unsigned callback_stage;
+static unsigned callback_id;
+static bool callback_order;
+
+static bool callback_decode(csh handle, const uint8_t *code, size_t length,
+			    MCInst *mi, uint16_t *size, uint64_t address,
+			    void *info)
+{
+	(void)handle;
+	(void)address;
+	(void)info;
+	callback_order &= callback_stage == 0;
+	callback_stage = 1;
+	if (!length || !code[0])
+		return false;
+	mi->flat_insn->id = 42;
+	MCInst_setOpcode(mi, 17);
+	*size = 1;
+	return true;
+}
+
+static void callback_map(cs_struct *handle, cs_insn *insn, unsigned id)
+{
+	(void)handle;
+	callback_order &= callback_stage == 1 && id == 17 && insn->id == 42 &&
+			  insn->size == 1;
+	callback_stage = 2;
+	insn->id = 57;
+}
+
+static void callback_print(MCInst *mi, SStream *stream, void *info)
+{
+	(void)info;
+	callback_order &= callback_stage == (callback_id == 57 ? 2u : 1u) &&
+			  mi->flat_insn->id == callback_id;
+	callback_stage = 3;
+	SStream_concat0(stream, "mapped\tvalue");
+}
+
+static bool test_mapper_callbacks(void)
+{
+	static const struct {
+		cs_arch arch;
+		cs_mode mode;
+	} cases[] = {
+		{ CS_ARCH_AARCH64, CS_MODE_LITTLE_ENDIAN },
+		{ CS_ARCH_ARM, CS_MODE_ARM },
+		{ CS_ARCH_MIPS, CS_MODE_MIPS32 },
+		{ CS_ARCH_ARC, CS_MODE_LITTLE_ENDIAN },
+		{ CS_ARCH_BPF, CS_MODE_BPF_EXTENDED },
+		{ CS_ARCH_LOONGARCH, CS_MODE_LOONGARCH64 },
+		{ CS_ARCH_PPC, (cs_mode)(CS_MODE_32 | CS_MODE_BIG_ENDIAN) },
+		{ CS_ARCH_SPARC, CS_MODE_BIG_ENDIAN },
+		{ CS_ARCH_SYSTEMZ, CS_MODE_BIG_ENDIAN },
+		{ CS_ARCH_TRICORE, CS_MODE_TRICORE_162 },
+		{ CS_ARCH_XTENSA, CS_MODE_XTENSA_ESP32 },
+	};
+	for (size_t i = 0; i < ARR_SIZE(cases); ++i) {
+		if (!cs_support(cases[i].arch))
+			continue;
+		csh handle;
+		if (cs_open(cases[i].arch, cases[i].mode, &handle) != CS_ERR_OK)
+			return false;
+		cs_struct *state = (cs_struct *)(uintptr_t)handle;
+		GetID_t original = state->insn_id;
+		state->disasm = callback_decode;
+		state->printer = callback_print;
+		state->post_printer = NULL;
+		bool ok = true;
+		/* Reuse the handle while replacing and restoring the callback. */
+		for (unsigned flags = 0; flags < 32 && ok; ++flags) {
+			bool custom = flags & 1, text = flags & 2;
+			bool detail = flags & 4, batch = flags & 8;
+			bool valid = !(flags & 16);
+			uint8_t byte = valid ? 1 : 0;
+			state->insn_id = custom ? callback_map : original;
+			callback_id = custom ? 57 : 42;
+			callback_stage = 0;
+			callback_order = true;
+			ok = cs_option(handle, CS_OPT_TEXT,
+				       text ? CS_OPT_ON : CS_OPT_OFF) ==
+				     CS_ERR_OK &&
+			     cs_option(handle, CS_OPT_DETAIL,
+				       detail ? CS_OPT_ON : CS_OPT_OFF) ==
+				     CS_ERR_OK;
+			if (batch) {
+				cs_insn *insn = NULL;
+				size_t count = cs_disasm(handle, &byte, 1,
+							 0x1000, 1, &insn);
+				ok &= count == (size_t)valid;
+				if (count)
+					ok &= insn->id == callback_id &&
+					      insn->size == 1;
+				cs_free(insn, count);
+			} else {
+				cs_insn *insn = cs_malloc(handle);
+				if (!insn) {
+					ok = false;
+					break;
+				}
+				const uint8_t *cursor = &byte;
+				size_t left = 1;
+				uint64_t address = 0x1000;
+				ok &= cs_disasm_iter(handle, &cursor, &left,
+						     &address, insn) == valid;
+				ok &= cursor == &byte + valid &&
+				      left == 1u - valid &&
+				      address == 0x1000u + valid;
+				if (valid)
+					ok &= insn->id == callback_id &&
+					      insn->size == 1;
+				cs_free(insn, 1);
+			}
+			ok &= callback_order &&
+			      callback_stage ==
+				      (valid ? (text ? 3u :
+						       (custom ? 2u : 1u)) :
+					       1u);
+		}
+		cs_close(&handle);
+		if (!ok) {
+			fprintf(stderr,
+				"Mapper callback ordering failed: arch=%u\n",
+				(unsigned)cases[i].arch);
+			return false;
+		}
+	}
+	return true;
+}
