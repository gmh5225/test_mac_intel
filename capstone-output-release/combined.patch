@@ -245,3 +245,10 @@ After updating an AArch64, Mips, PowerPC or Sparc alias mnemonic map, run
 `python3 suite/synctools/alias_mnemonic_trie.py` to regenerate the recognition
 table used in builds containing only these backends. The first map row for each
 spelling supplies its public alias ID.
+
+After updating AArch64 or Mips alias maps, also run
+`python3 suite/synctools/alias_mnemonic_groups.py`. Mixed-backend builds use
+these lookup rows grouped by first byte. Row order within each group remains
+unchanged, so duplicate spellings retain their first public ID. Public name
+queries keep the original ID-indexed map. The generated lookup requires
+nonempty spellings; mnemonic delimiter and length rules remain in the reader.
diff --git a/suite/synctools/alias_mnemonic_groups.py b/suite/synctools/alias_mnemonic_groups.py
new file mode 100644
index 00000000..e12ea570
--- /dev/null
+++ b/suite/synctools/alias_mnemonic_groups.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Group alias lookup rows while preserving the public ID-indexed name map."""
+
+import argparse
+from pathlib import Path
+
+from alias_mnemonic_trie import read_names
+
+
+def generate(directory):
+    names = read_names(directory)
+    if len(names) > 65535 or any(not name for name, _ in names):
+        raise ValueError("Alias groups require nonempty names and 16-bit offsets")
+    groups = [[] for _ in range(256)]
+    for name, enum in names:
+        groups[name[0]].append((name, enum))
+    offsets = [0]
+    rows = []
+    for group in groups:
+        rows.extend(group)
+        offsets.append(len(rows))
+    arch = directory.name.upper()
+    lines = [
+        "/* Generated by suite/synctools/alias_mnemonic_groups.py. */",
+        "static const name_map alias_grouped_names[] = {",
+    ]
+    for name, enum in rows:
+        lines.append(f'\t{{ {arch}_INS_ALIAS_{enum}, "{name.decode("ascii")}" }},')
+    lines.extend(["};", "", "static const uint16_t alias_group_offsets[] = {"])
+    for i in range(0, len(offsets), 16):
+        lines.append("\t" + ", ".join(map(str, offsets[i : i + 16])) + ",")
+    return "\n".join(lines + ["};", ""])
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2] / "arch"
+    for arch in ("AArch64", "Mips"):
+        target = root / arch / f"{arch}GenAliasGroups.inc"
