+/* Scratch construction must not alter the operand count or neighboring state. */
+static bool check_scratch_operands(void)
+{
+	for (unsigned pattern = 0; pattern <= UINT8_MAX; ++pattern) {
+		MCInst inst, expected;
+		memset(&inst, pattern, sizeof(inst));
+		inst.size = pattern % MAX_MC_OPS;
+		memcpy(&expected, &inst, sizeof(inst));
+		MCOperand *last = &inst.Operands[MAX_MC_OPS - 1];
+		MCOperand *op = MCOperand_CreateReg1(&inst, UINT_MAX - pattern);
+		if (op != last || op->MachineOperandType != kRegister ||
+		    op->Kind != kRegister || op->RegVal != UINT_MAX - pattern)
+			return false;
+		memcpy(&expected.Operands[MAX_MC_OPS - 1], op, sizeof(*op));
+		if (memcmp(&expected, &inst, sizeof(inst)))
+			return false;
+		op = MCOperand_CreateImm1(&inst, INT64_MIN + pattern);
+		if (op != last || op->MachineOperandType != kImmediate ||
+		    op->Kind != kImmediate || op->ImmVal != INT64_MIN + pattern)
+			return false;
+		memcpy(&expected.Operands[MAX_MC_OPS - 1], op, sizeof(*op));
+		if (memcmp(&expected, &inst, sizeof(inst)))
+			return false;
+	}
+	return true;
+}
