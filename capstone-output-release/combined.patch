+static char *writeVectorRegister(char *out, unsigned length_code,
+				 unsigned number)
+{
+	*out++ = "xyz"[length_code];
+	*out++ = 'm';
+	*out++ = 'm';
+	if (number >= 10)
+		*out++ = (char)('0' + number / 10);
+	*out++ = (char)('0' + number % 10);
