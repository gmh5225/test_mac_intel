--- a/arch/X86/X86SimpleOutput.h
+++ b/arch/X86/X86SimpleOutput.h
@@ -44,15 +44,16 @@ enum X86SimpleForm {
 	X86_SIMPLE_RELATIVE,
 };
 
-/* This plan gets its ALU row from ModR/M.reg. Its low bits select the
- * same register-only operand check as a register pair. */
-#define X86_PLAN_GROUP1_IMMEDIATE ((UINT16_MAX & ~3u) | X86_SIMPLE_REG_RM)
-
-/* The vector escape uses the next reserved plan and has no register-pair ModR/M. */
-#define X86_PLAN_PUSH_IMMEDIATE ((UINT16_MAX & ~7u) | X86_SIMPLE_FIXED)
-#define X86_PLAN_VECTOR UINT16_MAX
-#define X86_PLAN_SHIFT_IMM8 ((UINT16_MAX & ~3u) | X86_SIMPLE_RM_REG)
-#define X86_PLAN_MOV_REG_IMM32 ((UINT16_MAX & ~3u) | X86_SIMPLE_FIXED)
+/* Ordinary plans carry memory admission beside their form and row index.
+ * Reserved writers retain the same low-bit ModR/M form. */
+#define X86_PLAN_ROW_MASK 0x1fffu
+#define X86_PLAN_MEMORY 0x2000u
+#define X86_PLAN_MEMORY_ONLY 0x4000u
+#define X86_PLAN_PUSH_IMMEDIATE 0x8000u
+#define X86_PLAN_SHIFT_IMM8 (0x8000u | X86_SIMPLE_RM_REG)
+#define X86_PLAN_GROUP1_IMMEDIATE (0x8000u | X86_SIMPLE_REG_RM)
+#define X86_PLAN_MOV_REG_IMM32 0x8004u
+#define X86_PLAN_VECTOR 0x8007u
 
 CAPSTONE_INTERNAL bool
 X86_writeMemoryOutput(const uint8_t *code, size_t size, cs_insn *insn,
