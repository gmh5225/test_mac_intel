+/* Shared register/memory entries can provide the public ID, VEX.vvvv
+ * policy and immediate extent without another lookup by internal opcode. */
+X86_DECODE_INLINE int scanVexPublicRow(const uint8_t *code, size_t size,
+				       X86ScanResult *result)
+{
+	const bool vex2 = code[0] == 0xc5;
+	const unsigned off = vex2 ? 2 : 3;
+	if (size <= off + 1)
+		return X86_SCAN_NOT_HANDLED;
+	const unsigned map = vex2 ? 1 : mmmmmFromVEX2of3(code[1]);
+	if (map < 1 || map > 3)
+		return X86_SCAN_NOT_HANDLED;
+	const uint8_t payload = code[off - 1];
+	const unsigned key = (payload & 7) | (vex2 ? 0 : (payload >> 4) & 8);
+	const unsigned table = vex2 ? 1 : map == 1 ? 0 : map;
+	const uint32_t *row = x86VexPublicRows[table][key];
+	const uint32_t word = row ? row[code[off]] : 0;
+	if (!word)
+		return X86_SCAN_NOT_HANDLED;
+	if (!(word & 0x10000) && vvvvFromVEX2of2(payload))
+		return X86_SCAN_INVALID;
+
+	const uint8_t modrm = code[off + 1];
+	unsigned end = off + 2;
+	if (modrm < 0xc0) {
+		const unsigned mod = modFromModRM(modrm),
+			       rm = rmFromModRM(modrm);
+		unsigned base = rm;
+		if (rm == 4) {
+			if (end >= size)
+				return X86_SCAN_INVALID;
+			base = baseFromSIB(code[end++]);
+		}
+		if (mod == 1)
+			++end;
+		else if (mod == 2 || base == 5)
+			end += 4;
+	}
+	end += (word >> 12) & 15;
+	if (end > size)
+		return X86_SCAN_INVALID;
+	result->opcode = 0;
+	result->opcode_pub = word & 0xfff;
+	result->length = (uint16_t)end;
+	result->popcode_adjust = 0;
+	return X86_SCAN_COMPLETE;
+}
+
 X86_DECODE_INLINE int tryVexTerminalScan(const uint8_t *code, size_t code_len,
 					 uint8_t prefix, X86ScanResult *result)
 {
+	const int direct = scanVexPublicRow(code, code_len, result);
+	if (direct != X86_SCAN_NOT_HANDLED)
+		return direct;
 	InternalInstruction insn = { 0 };
 	initializeInstructionHeader(&insn, code, code_len, CS_MODE_64);
 	insn.readerCursor = 1;
