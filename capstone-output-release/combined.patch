 endif()
 
 if(capstone_enabled_architectures STREQUAL "ARM")
-    add_compile_definitions(CAPSTONE_ARM_COPY_OPERAND_DEFAULTS)
+    add_compile_definitions(CAPSTONE_ARM_COPY_OPERAND_DEFAULTS CAPSTONE_ARM_PRIVATE_STREAM)
