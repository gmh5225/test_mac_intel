diff --git a/arch/X86/X86EvexMemoryOutput.c b/arch/X86/X86EvexMemoryOutput.c
new file mode 100644
index 00000000..e079a0a7
--- /dev/null
+++ b/arch/X86/X86EvexMemoryOutput.c
@@ -0,0 +1,187 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "../../cs_priv.h"
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#include "X86SimpleOutput.h"
+#include "X86Disassembler.h"
+#include "X86GenEvexMemoryOutput.inc"
+static char *writeVectorRegister(char *out, unsigned length_code,
+				 unsigned number)
+{
+	*out++ = "xyz"[length_code];
+	*out++ = 'm';
+	*out++ = 'm';
+	if (number >= 10)
+		*out++ = (char)('0' + number / 10);
+	*out++ = (char)('0' + number % 10);
+	return out;
+}
+
+static inline const struct EvexMemoryOutputRow *
+evexMemoryRow(const uint8_t *code, size_t size, unsigned *source_width,
+	      unsigned *instruction_length)
+{
+	if (size < 6 || (code[2] & 0x7c) != 0x7c || (code[3] & 0x9f) != 8)
+		return NULL;
+	const unsigned ll = code[3] >> 5, w = code[2] >> 7, pp = code[2] & 3;
+	const uint8_t modrm = code[5];
+	const unsigned mod = modrm >> 6, rm = modrm & 7;
+	if (ll >= 3 || mod >= 3)
+		return NULL;
+	const unsigned key = ((code[1] & 15) << 8) | code[4];
+	const struct EvexMemoryOutputRow *row;
+	unsigned memory_ll;
+	if (key == 0x16f && pp) {
+		row = &evex_load_rows[pp - 1][w][ll];
+		memory_ll = ll;
+	} else {
+		return NULL;
+	}
+	const bool sib = rm == 4, rip = !mod && rm == 5;
+	const unsigned offset = 6 + sib, disp_size = mod == 2 || rip ? 4 : mod;
+	const unsigned length = offset + disp_size;
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & 7;
+	if (!row->id || size < length)
+		return NULL;
+	if (sib) {
+		const uint8_t encoding = code[6];
+		const unsigned index = ((rxb & 2) << 2) | ((encoding >> 3) & 7);
+		/* Keep no-base and explicit RIZ spellings on the general path. */
+		if ((!mod && (encoding & 7) == 5) ||
+		    (index == 4 && encoding != 0x24))
+			return NULL;
+	}
+	*source_width = memory_ll;
+	*instruction_length = length;
+	return row;
+}
+
+/* The output path and scan path use the same checked row and byte extent.
+ * Unsupported encodings still go through the complete source decoder. */
+bool X86_scanEvexMemoryOutput(const uint8_t *code, size_t size,
+			      X86ScanResult *result)
+{
+	if (!size || code[0] != 0x62)
+		return false;
+	unsigned width, length;
+	const struct EvexMemoryOutputRow *row =
+		evexMemoryRow(code, size, &width, &length);
+	if (!row)
+		return false;
+	result->opcode = 0;
+	result->opcode_pub = row->id;
+	result->length = (uint16_t)length;
+	result->popcode_adjust = 0;
+	return true;
+}
+
+bool X86_writeEvexMemoryOutput(const uint8_t *code, size_t size, cs_insn *insn,
+			       uint16_t *insn_size,
+			       const struct X86SimpleRegister *regs)
+{
+	unsigned memory_ll, length;
+	const struct EvexMemoryOutputRow *row =
+		evexMemoryRow(code, size, &memory_ll, &length);
+	if (!row)
+		return false;
+	const unsigned ll = code[3] >> 5, w = code[2] >> 7;
+	const uint8_t modrm = code[5];
+	const unsigned mod = modrm >> 6, rm = modrm & 7;
+	const bool sib = rm == 4, rip = !mod && rm == 5;
+	const unsigned offset = 6 + sib, disp_size = mod == 2 || rip ? 4 : mod;
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & 7;
+	const unsigned dst = ((modrm >> 3) & 7) | ((rxb & 4) << 1) |
+			     (~(unsigned)code[1] & 16);
+	const unsigned base_number = sib ? (code[6] & 7) : rm;
+	const struct X86SimpleRegister *base =
+		&regs[base_number | ((rxb & 1) << 3)];
+	const unsigned index_number =
+		sib ? (((rxb & 2) << 2) | ((code[6] >> 3) & 7)) : 4;
+	const struct X86SimpleRegister *index =
+		index_number == 4 ? NULL : &regs[index_number];
+	const unsigned scale = sib ? 1u << (code[6] >> 6) : 1;
+	const unsigned width = 16u << memory_ll;
+	const int32_t displacement =
+		disp_size == 4 ? X86_readDisp32(code + offset) :
+		mod	       ? (int8_t)code[offset] * (int32_t)width :
+				 0;
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)length;
+	memcpy(insn->bytes, code, length);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = writeVectorRegister(insn->op_str, ll, dst);
+	memcpy(out, ", xmmword ptr [", 15);
+	out[2] = "xyz"[memory_ll];
+	out += 15;
+	if (rip) {
+		memcpy(out, "rip", 3);
+		out += 3;
+	} else {
+		memcpy(out, base->name, sizeof(base->name));
+		out += base->length;
+	}
+	if (index) {
+		memcpy(out, " + ", 3);
+		out += 3;
+		memcpy(out, index->name, sizeof(index->name));
+		out += index->length;
+		if (scale != 1) {
+			*out++ = '*';
+			*out++ = (char)('0' + scale);
+		}
+	}
+	out = X86_writeDisplacement(out, displacement);
+	*out = ']';
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		d->groups_count = row->group_count;
+		memcpy(d->groups, row->groups, sizeof(row->groups));
+		cs_x86 *x = &d->x86;
+		memcpy(x->opcode, code, sizeof(x->opcode));
+		x->rex = (uint8_t)(0x40 | w << 3 | rxb);
+		x->addr_size = 8;
+		x->modrm = modrm;
+		x->encoding.modrm_offset = 5;
+		if (disp_size) {
+			x->encoding.disp_offset = (uint8_t)offset;
+			x->encoding.disp_size = (uint8_t)disp_size;
+		}
+		if (sib) {
+			x->sib = code[6];
+			x->sib_scale = (int8_t)scale;
+			if (index)
+				x->sib_index = (x86_reg)index->reg;
+			x->sib_base = (x86_reg)base->reg;
+		}
+		x->op_count = 2;
+		cs_x86_op *op = &x->operands[0];
+		op->type = X86_OP_REG;
+		op->size = (uint8_t)(16u << ll);
+		static const x86_reg vector_bases[] = { X86_REG_XMM0,
+							X86_REG_YMM0,
+							X86_REG_ZMM0 };
+		op->reg = (x86_reg)(vector_bases[ll] + dst);
+		op->access = (cs_ac_type)row->access[0];
+		op = &x->operands[1];
+		op->type = X86_OP_MEM;
+		op->size = (uint8_t)width;
+		op->mem.base = rip ? X86_REG_RIP : (x86_reg)base->reg;
+		op->mem.scale = (int32_t)scale;
+		if (index)
+			op->mem.index = (x86_reg)index->reg;
+		op->mem.disp = x->disp = displacement;
+		op->access = (cs_ac_type)row->access[1];
+	}
+	return true;
+}
+
+#endif
+#endif
