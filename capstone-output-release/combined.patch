+		writeMovRegImm32(insn, &rows[plans[0x8b] >> 2], regs, code,
+				 opcode, rex, insn_size);
+		return true;
+	}
+	if (size < 3 + lead)
+		return false;
+	const uint8_t modrm = code[lead + 1];
+	const unsigned group = (modrm >> 3) & 7;
+	const bool shift = plan == X86_PLAN_SHIFT_IMM8;
+	const unsigned row = shift ? shift_rows[group] :
+				     plans[(group << 3) | 1] >> 2;
+	writeRegisterImmediate(insn, &rows[row], regs, code, rex, modrm, shift,
+			       insn_size);
+	return true;
+}
