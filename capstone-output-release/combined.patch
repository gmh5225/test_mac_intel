+static bool check_evex_memory(csh handles[2])
+{
+	for (unsigned n = 0; n < 32768; ++n) {
+		uint32_t value = n * UINT32_C(2654435761);
+		uint8_t bytes[] = { 0x62,
+				    (uint8_t)((n & 0xf0) | (n & 1 ? 1 : 2)),
+				    (uint8_t)((n >> 8 & 0x80) | 0x7c |
+					      (n >> 4 & 3)),
+				    (uint8_t)((n >> 2 & 0x60) | 8),
+				    (uint8_t)(n & 1 ? 0x6f : 0x1a),
+				    (uint8_t)(n >> 7),
+				    (uint8_t)value,
+				    (uint8_t)(value >> 8),
+				    (uint8_t)(value >> 16),
+				    (uint8_t)(value >> 24),
+				    0x80 };
+		if (!compare(handles, bytes, sizeof(bytes), value) ||
+		    !compare(handles, bytes, n % sizeof(bytes), value))
+			return false;
+	}
+	return true;
+}
