+static void *allocate_nonzero(size_t size)
+{
+	void *p = malloc(size);
+	if (p)
+		memset(p, 1, size);
+	return p;
+}
+
+static bool check_iterator_status(cs_arch arch, cs_mode mode)
+{
+	const uint8_t x86[] = { 0x90 };
+	/* These are the ARM SoftFail and legal UDF from issues #2703 and #1991. */
+	const uint8_t arm[] = { 0x07, 0xb0, 0xbd, 0xe8, 0xf0, 0x00, 0xf0, 0xe7 };
+	if (!cs_support(arch))
+		return true;
+	csh handle;
+	if (cs_open(arch, mode, &handle) != CS_ERR_OK)
+		return false;
+	bool ok = true;
+	for (unsigned detail = 0; detail < 2; ++detail) {
+		if (cs_option(handle, CS_OPT_DETAIL,
+			      detail ? CS_OPT_ON : CS_OPT_OFF) != CS_ERR_OK) {
+			ok = false;
+			break;
+		}
+		cs_insn *record = cs_malloc(handle);
+		if (!record) {
+			ok = false;
+			break;
+		}
+		if (record->illegal || record->is_alias ||
+		    record->usesAliasDetails || record->alias_id)
+			ok = false;
+		for (unsigned text = 0; text < 2; ++text) {
+			if (cs_option(handle, CS_OPT_TEXT,
+				      text ? CS_OPT_ON : CS_OPT_OFF) !=
+			    CS_ERR_OK) {
+				ok = false;
+				break;
+			}
+			const uint8_t *cursor = arch == CS_ARCH_ARM ? arm : x86;
+			size_t left = arch == CS_ARCH_ARM ? sizeof(arm) :
+							    sizeof(x86);
+			uint64_t ip = 0x1000;
+			record->illegal = true;
+			if (!cs_disasm_iter(handle, &cursor, &left, &ip,
+					    record)) {
+				ok = false;
+				break;
+			}
+			if (arch == CS_ARCH_ARM) {
+				if (!record->illegal ||
+				    !cs_disasm_iter(handle, &cursor, &left, &ip,
+						    record) ||
+				    record->illegal)
+					ok = false;
+			} else if (record->is_alias ||
+				   record->usesAliasDetails ||
+				   record->illegal || record->alias_id) {
+				ok = false;
+			}
+			if (left)
+				ok = false;
+		}
+		cs_free(record, 1);
+	}
+	cs_close(&handle);
+	return ok;
+}
+
+static bool test_iterator_status(void)
+{
+	cs_opt_mem mem = { allocate_nonzero, calloc, realloc, free, vsnprintf };
+	if (cs_option(0, CS_OPT_MEM, (size_t)&mem) != CS_ERR_OK)
+		return false;
+	const bool x86 = check_iterator_status(CS_ARCH_X86, CS_MODE_64);
+	const bool arm = check_iterator_status(CS_ARCH_ARM, CS_MODE_ARM);
+	mem.malloc = malloc;
+	if (cs_option(0, CS_OPT_MEM, (size_t)&mem) != CS_ERR_OK)
+		return false;
+	if (!x86 || !arm)
+		printf("iterator status mismatch (x86=%d ARM=%d)\n", x86, arm);
+	return x86 && arm;
+}
+
 int main()
 {
 	bool result = true;
 	result &= test_cs_mem_setup_fail();
+	result &= test_iterator_status();
 
