+		{ 0x5a, 1, 2, X86_INS_VBROADCASTI64X2 },
+		{ 0x5b, 0, 2, X86_INS_VBROADCASTI32X8 },
+		{ 0x5b, 1, 2, X86_INS_VBROADCASTI64X4 },
