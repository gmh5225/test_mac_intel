+#define CAPSTONE_X86_PUBLIC_OUTPUT
+/* Input and handle were checked by the public iterator. These readers
+ * construct one record; its caller owns cursor advancement and skipdata. */
+CAPSTONE_INTERNAL bool X86_decodeTextRecord32(struct cs_struct *handle,
+					      const uint8_t *code, size_t size,
+					      cs_insn *insn, uint16_t *length,
+					      bool batch);
