diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 12428fff..3c62ba94 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3753,9 +3753,34 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 					  cs_insn *insn, uint16_t *insn_size,
 					  bool batch);
 
+#ifdef CAPSTONE_X86_PUBLIC_OUTPUT
+X86_DECODE_INLINE bool decodeIteratorOutput(cs_struct *handle,
+					    const uint8_t *code, size_t size,
+					    cs_insn *insn, uint16_t *length,
+					    bool batch);
+#define CS_DECODE_OUTPUT_MISS decodeIteratorOutput
+#endif
 #define CS_DECODE_SCAN_IMPL decodeIteratorScan
 #include "../../cs_disasm_internal.h"
 #undef CS_DECODE_SCAN_IMPL
+#ifdef CS_DECODE_OUTPUT_MISS
+#undef CS_DECODE_OUTPUT_MISS
+X86_DECODE_INLINE bool decodeIteratorOutput(cs_struct *handle,
+					    const uint8_t *code, size_t size,
+					    cs_insn *insn, uint16_t *length,
+					    bool batch)
+{
+	if (handle->arch == CS_ARCH_X86 && !handle->no_text) {
+		if (handle->mode == CS_MODE_64)
+			return X86_decodeTextRecord64(handle, code, size, insn,
+						      length, batch);
+		if (handle->mode == CS_MODE_32)
+			return X86_decodeTextRecord32(handle, code, size, insn,
+						      length, batch);
+	}
+	return cs_decode_full_insn(handle, code, size, insn, length, batch);
+}
+#endif
 
