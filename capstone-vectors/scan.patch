+/* Register rows have two operands (shifts and extracts) or three
+ * operands. Keep their fixed detail fields independent of loop induction. */
+static inline void writeVectorOperand(cs_x86_op *op, unsigned width,
+				      unsigned number, uint8_t access)
+{
+	static const x86_reg bases[] = { X86_REG_XMM0, X86_REG_YMM0,
+					 X86_REG_ZMM0 };
+	op->type = X86_OP_REG;
+	op->reg = (x86_reg)(bases[width] + number);
+	op->access = (cs_ac_type)access;
+	op->size = (uint8_t)(16 << width);
+}
