+				     ++base) {
+					if (base == 4 || (!mod && base == 5))
+						continue;
+					const std::vector<int32_t> disps =
+						!mod ?
+							std::vector<int32_t>{
+								0
+							} :
+						mod == 1 ?
+							std::vector<int32_t>{
+								0, 9, -1, -128,
+								127
+							} :
+							std::vector<int32_t>{
+								0,
+								9,
+								-1,
+								0x12345678,
+								INT32_MIN,
+								INT32_MAX
+							};
+					for (unsigned dst = 0;
+					     dst < 8 && uniform; ++dst)
+						for (unsigned src = 0;
+						     src < sources && uniform;
+						     ++src)
+							for (int32_t disp :
+							     disps)
+								if (vex32_memory_record(
+									    decoder,
+									    opcode,
+									    pp,
+									    ll,
+									    dst,
+									    src,
+									    base,
+									    mod,
+									    disp) !=
+								    row) {
+									uniform =
