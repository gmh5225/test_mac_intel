+		op.type = X86_OP_REG;
+		op.reg = x86_reg((ll ? X86_REG_YMM0 : X86_REG_XMM0) +
+				 numbers[i]);
+		op.size = uint8_t(16u << ll);
+		op.access = actual.operands[i].access;
+		access[i] = unsigned(op.access);
+		if (i)
