+/* Resolve attributes and opcode map for general instruction encodings. */
+X86_DECODE_INLINE int getIDWithAttrMask(uint16_t *instructionID,
+					struct InternalInstruction *insn,
+					uint16_t attrMask)
+{
+	const struct ModRMDecision *decision = getModRMDecision(
+		insn->opcodeType, contextForAttrs(attrMask), insn->opcode);
+	bool hasModRMExtension = false;
+#ifndef CAPSTONE_X86_REDUCE
+	/* The trailing 3DNow opcode always follows a ModR/M byte. */
+	hasModRMExtension |= insn->opcodeType == THREEDNOW_MAP;
+#endif
+	return getIDWithDecision(instructionID, insn, decision,
+				 hasModRMExtension);
+}
