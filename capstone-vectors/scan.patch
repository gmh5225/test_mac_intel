diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 63dcc538..af3ba9ca 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -36,6 +36,7 @@
 #include "X86FeatureExtension.h"
 #include "X86DisassemblerTranslator.h"
 #include "X86ScanAdapter.h"
+#include "X86VexScan.h"
 #include "X86InstPrinterCommon.h"
 
 #if defined(_MSC_VER)
@@ -3654,10 +3655,27 @@ X86_DECODE_INLINE int tryInitialScanResult(cs_struct *handle,
 		initial = tryInitialLegacyScan(code, code_len, CS_MODE_16,
 					       feature64, instructionID, length,
 					       readerFlags);
-	else
+	else {
+#if X86_HAS_VEX2_PUBLIC_PLANS && !defined(CAPSTONE_X86_SCAN_ADAPTER)
+		/* Enter the existing 32-bit arm before the legacy probes. The
+         * packed scalar result keeps the caller's output addresses local. */
+		if (handle->mode == CS_MODE_32 && code_len >= 2 &&
+		    code[0] == 0xc5 && (code[1] & 0xc0) == 0xc0) {
+			const uint32_t packed =
+				X86_readVex32PublicPlan(code, code_len);
+			if (packed) {
+				if (packed == UINT32_MAX)
+					return X86_SCAN_INVALID;
+				*instructionID = packed >> 8;
+				*length = (uint16_t)(packed & 0xff);
+				return X86_SCAN_COMPLETE;
+			}
+		}
+#endif
 		initial = tryInitialLegacyScan(code, code_len, CS_MODE_32,
 					       feature64, instructionID, length,
 					       readerFlags);
+	}
 	return initial;
 }
 
