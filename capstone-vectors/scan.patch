diff --git a/utils.h b/utils.h
index 75cdc0e7..c870a352 100644
--- a/utils.h
+++ b/utils.h
@@ -13,6 +13,18 @@
 #endif
 #include "cs_priv.h"
 
+/* Fixed public records can be cleared without a general libc dispatch.
+ * The length is a compile-time constant; every byte is still initialized. */
+#if defined(__clang__)
+#if __has_builtin(__builtin_memset_inline)
+#define cs_zero_fixed(buffer, length) \
+	__builtin_memset_inline((buffer), 0, (length))
+#endif
+#endif
+#ifndef cs_zero_fixed
+#define cs_zero_fixed(buffer, length) memset((buffer), 0, (length))
+#endif
+
 // threshold number, so above this number will be printed in hexa mode
 #define HEX_THRESHOLD 9
 
