+/* Reuse the output rows without constructing text or operand records. */
+uint32_t X86_scanEvexRegisters(const uint8_t *code, size_t size)
+{
+	if (!validEvexRegisterPrefix(code, size) || code[5] < 0xc0)
+		return 0;
+	const unsigned key = ((code[1] & 15) << 8) | code[4];
+	const struct VectorOutputRow *row =
+		evexOutputRow(key, code[2] >> 7, code[3] >> 5);
+	if (!row || (row->immediate && size < 7))
+		return 0;
+	if (isEvexRegisterExtract(key) && !validEvexExtractSource(code))
+		return 0;
+	return (row->id << 8) | (6u + row->immediate);
+}
