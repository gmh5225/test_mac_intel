diff --git a/tests/unit/x86_prefix_limit.c b/tests/unit/x86_prefix_limit.c
new file mode 100644
index 00000000..7be9e132
--- /dev/null
+++ b/tests/unit/x86_prefix_limit.c
@@ -0,0 +1,127 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include <capstone/capstone.h>
+#include "../../arch/X86/X86FeatureExtension.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#define CHECK(condition) \
+	do { \
+		if (!(condition)) { \
+			fprintf(stderr, "prefix limit: line %d\n", __LINE__); \
+			return false; \
+		} \
+	} while (0)
+
+static bool check_classifier(void)
+{
+	static const uint8_t prefixes[] = { 0x26, 0x2e, 0x36, 0x3e, 0x64,
+					    0x65, 0x66, 0x67, 0xf0, 0xf2,
+					    0xf3, 0x40, 0x4f };
+	uint8_t code[4097];
+	for (unsigned wide = 0; wide != 2; ++wide) {
+		for (unsigned p = 0; p < sizeof(prefixes); ++p) {
+			memset(code, prefixes[p], sizeof(code));
+			for (size_t count = 0; count <= 16; ++count) {
+				uint8_t opcode = 0xff;
+				size_t offset = 0;
+				code[count] = 0x90;
+				CHECK(!X86_mayDecodeFeatureExtensionImpl(
+					code, count + 1, wide, &opcode,
+					&offset));
+				if (!wide && count &&
+				    (prefixes[p] & 0xf0) == 0x40) {
+					CHECK(opcode == prefixes[p] &&
+					      offset == 0);
+				} else if (count < 15) {
+					CHECK(opcode == 0x90 &&
+					      offset == count);
+				} else {
+					CHECK(opcode == 0 &&
+					      offset == SIZE_MAX);
+				}
+				code[count] = prefixes[p];
+			}
+		}
+	}
+	memset(code, 0x66, sizeof(code));
+	code[4096] = 0x90;
+	uint8_t opcode = 0xff;
+	size_t offset = 0;
+	CHECK(!X86_mayDecodeFeatureExtensionImpl(code, sizeof(code), true,
+						 &opcode, &offset));
+	CHECK(opcode == 0 && offset == SIZE_MAX);
+	return true;
+}
+
+static bool check_public(csh handle, cs_insn *insn)
+{
+	uint8_t code[4097];
+	for (size_t count = 0; count <= 16; ++count) {
+		memset(code, 0x66, count);
+		code[count] = 0x90;
+		const uint8_t *cursor = code;
+		size_t left = count + 1;
+		uint64_t address = 0x1000;
+		bool decoded =
+			cs_disasm_iter(handle, &cursor, &left, &address, insn);
+		CHECK(decoded == (count < 15));
+		if (decoded) {
+			CHECK(insn->size == count + 1 && !left);
+			CHECK(cursor == code + count + 1);
+		} else {
+			CHECK(cursor == code && left == count + 1 &&
+			      address == 0x1000);
+		}
+		CHECK(cs_errno(handle) == CS_ERR_OK);
+	}
+	memset(code, 0x66, sizeof(code));
+	code[4096] = 0x90;
+	const uint8_t *cursor = code;
+	size_t left = sizeof(code);
+	uint64_t address = 0x1000;
+	CHECK(!cs_disasm_iter(handle, &cursor, &left, &address, insn));
+	CHECK(cursor == code && left == sizeof(code) && address == 0x1000);
+	CHECK(cs_option(handle, CS_OPT_SKIPDATA, CS_OPT_ON) == CS_ERR_OK);
+	size_t count = 0;
+	while (cs_disasm_iter(handle, &cursor, &left, &address, insn)) {
+		CHECK(insn->size == (left ? 1 : 15));
+		++count;
+	}
+	CHECK(!left && count == sizeof(code) - 14);
+	CHECK(cursor == code + sizeof(code) &&
+	      address == 0x1000 + sizeof(code));
+	CHECK(cs_option(handle, CS_OPT_SKIPDATA, CS_OPT_OFF) == CS_ERR_OK);
+	return true;
+}
+
+int main(void)
+{
+	static const cs_mode modes[] = { CS_MODE_16, CS_MODE_32, CS_MODE_64 };
+	if (!check_classifier())
+		return 1;
+	for (unsigned m = 0; m < sizeof(modes) / sizeof(modes[0]); ++m) {
+		for (unsigned detail = 0; detail != 2; ++detail) {
+			for (unsigned text = 0; text != 2; ++text) {
+				csh handle = 0;
+				if (cs_open(CS_ARCH_X86, modes[m], &handle) !=
+				    CS_ERR_OK)
+					return 1;
+				cs_option(handle, CS_OPT_DETAIL,
+					  detail ? CS_OPT_ON : CS_OPT_OFF);
+				cs_option(handle, CS_OPT_TEXT,
+					  text ? CS_OPT_ON : CS_OPT_OFF);
+				cs_insn *insn = cs_malloc(handle);
+				bool ok = insn && check_public(handle, insn);
+				cs_free(insn, 1);
+				cs_close(&handle);
+				if (!ok)
+					return 1;
+			}
+		}
+	}
+	puts("bounded prefix classification and public recovery passed");
+	return 0;
+}
