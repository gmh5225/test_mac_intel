+# Keep the new EVEX scan leaf free of compiler-created ELF switch tables.
+ifneq (,$(filter x86,$(CAPSTONE_ARCHS)))
+X86_EVEX_SCAN_FLAGS := $(shell $(CC) $(CFLAGS) -dM -E -x c - < /dev/null 2>/dev/null | \
