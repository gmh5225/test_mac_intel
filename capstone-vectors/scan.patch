+					disp < 0 ? -int64_t(disp) : disp);
+				char digits[16];
+				std::snprintf(digits, sizeof(digits),
+					      magnitude <= 9 ? "%u" : "0x%x",
+					      magnitude);
+				text += disp < 0 ? " - " : " + ";
+				text += digits;
+			}
+			text += ']';
+		} else {
+			const unsigned number = form == 0 && i == 1 ? src : dst;
+			op.type = X86_OP_REG;
+			op.reg = x86_reg((ll ? X86_REG_YMM0 : X86_REG_XMM0) +
