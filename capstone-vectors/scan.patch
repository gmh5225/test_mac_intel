diff --git a/arch/X86/X86EvexAdmission.h b/arch/X86/X86EvexAdmission.h
new file mode 100644
index 00000000..7c161aba
--- /dev/null
+++ b/arch/X86/X86EvexAdmission.h
@@ -0,0 +1,16 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_EVEX_ADMISSION_H
+#define CS_X86_EVEX_ADMISSION_H
+
+/* Shared register-row admission. Arguments are local values, not expressions
+ * with side effects. Keep the extent check first for page-ended input. */
+#define X86_EVEX_REGISTER_PREFIX_REJECTS(code, size) \
+	((size) < 6 || ((code)[2] & 7) != 5 || ((code)[3] & 0x97) || \
+	 ((code)[3] & 0x60) == 0x60)
+#define X86_EVEX_REGISTER_EXTRACT(key) (((key) & ~0x22u) == 0x319)
+#define X86_EVEX_EXTRACT_SOURCE_REJECTS(code) \
+	(((code)[2] & 0x78) != 0x78 || !((code)[3] & 8))
+
+#endif
diff --git a/arch/X86/X86EvexScan.c b/arch/X86/X86EvexScan.c
new file mode 100644
index 00000000..3a5f4ced
--- /dev/null
+++ b/arch/X86/X86EvexScan.c
@@ -0,0 +1,45 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "../../cs_priv.h"
+#include "X86FeatureExtension.h"
+#ifdef X86_EVEX_REGISTER_SCAN
+#include "X86EvexAdmission.h"
+#define CAPSTONE_X86_EVEX_ROWS_ONLY
+#include "X86GenVectorOutput.inc"
+#undef CAPSTONE_X86_EVEX_ROWS_ONLY
+
+/* Reuse ordinary register rows before extension rejection. Other encodings
+ * and installed adapters retain the original extension and fallback order.
+ * Keep this leaf outside the hot decoder and text writer. */
+x86_feature_decode_result
+X86_decodeScanFeatureExtension(csh ud, const uint8_t *code, size_t code_len,
+			       MCInst *instr, uint16_t *size,
+			       uint8_t extension_opcode)
+{
+	const cs_struct *handle = (const cs_struct *)(uintptr_t)ud;
+	if (handle->mode == CS_MODE_64 && code_len >= 6 && code[0] == 0x62
+#ifdef CAPSTONE_X86_SCAN_ADAPTER
+	    && !handle->x86_scan_adapter
+#endif
+	    && !X86_EVEX_REGISTER_PREFIX_REJECTS(code, code_len) &&
+	    code[5] >= 0xc0) {
+		const unsigned key = ((code[1] & 15) << 8) | code[4];
+		const struct VectorOutputRow *row =
+			evexOutputRow(key, code[2] >> 7, code[3] >> 5);
+		if (row && (!row->immediate || code_len >= 7) &&
+		    (!X86_EVEX_REGISTER_EXTRACT(key) ||
+		     !X86_EVEX_EXTRACT_SOURCE_REJECTS(code))) {
+			instr->Opcode = 0;
+			instr->OpcodePub = row->id;
+			instr->popcode_adjust = 0;
+			*size = (uint16_t)(6u + row->immediate);
+			return X86_FEATURE_DECODED;
+		}
+	}
+	return X86_decodeFeatureExtension(ud, code, code_len, instr, size,
+					  extension_opcode);
+}
+#endif
+#endif
