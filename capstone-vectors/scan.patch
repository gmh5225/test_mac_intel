diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 63dcc538..4e948755 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -1630,6 +1630,25 @@ X86_DECODE_INLINE int getID(struct InternalInstruction *insn, cs_mode mode)
 		return 0;
 	}
 
+	/* C5 fixes the opcode map and has no W bit. Keep address-dependent and
+	 * relative-branch size repairs in the general path. */
+	if (insn->mode != MODE_16BIT &&
+	    insn->vectorExtensionType == TYPE_VEX_2B && insn->opcode != 0xae &&
+	    (insn->opcode < 0x82 || insn->opcode > 0x8f)) {
+		const uint8_t payload = insn->vectorExtensionPrefix[1];
+		attrMask = ATTR_VEX |
+			   mandatoryPrefixAttributes(ppFromVEX2of2(payload));
+		if (insn->mode == MODE_64BIT)
+			attrMask |= ATTR_64BIT;
+		if (lFromVEX2of2(payload))
+			attrMask |= ATTR_VEXL;
+		if (getIDWithAttrMask(&instructionID, insn, attrMask))
+			return -1;
+		insn->instructionID = instructionID;
+		insn->spec = specifierForUID(instructionID);
+		return 0;
+	}
+
 	return getIDSlow(insn, mode);
 }
 
