+		{ X86_INS_NOP, NULL },
+		{ X86_INS_PUSH, NULL },
+		{ X86_INS_PUSH, NULL },
+		{ 0, "unused" },
+	};
+	for (unsigned i = 0; i < sizeof(mnemonics) / sizeof(mnemonics[0]);
