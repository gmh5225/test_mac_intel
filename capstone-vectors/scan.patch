+/* The generator checks that C5 selects these rows in both 32- and 64-bit
+ * contexts. Operand readers still enforce the selected mode's register rules. */
+X86_DECODE_INLINE const struct ModRMDecision *getVex2Decision(uint8_t payload,
+							      uint8_t opcode)
+{
+	const struct ModRMDecision *row = x86VexScanRows[0][payload & 7];
+	return row ? &row[opcode] : NULL;
+}
