+
+static char *writeVex32Register(char *out, unsigned ll, unsigned number)
+{
+	out[0] = ll ? 'y' : 'x';
+	out[1] = out[2] = 'm';
+	out[3] = (char)('0' + number);
+	return out + 4;
+}
+
+/* Only rows whose complete canonical 32-bit record was reproduced for every
+ * low-register combination reach this writer. */
+static bool writeVex32Registers(const uint8_t *code, cs_insn *insn,
+				uint16_t *insn_size,
+				const struct Vex32OutputRow *row)
+{
+	const unsigned flags = code[1], modrm = code[3];
+	const unsigned src = (~flags >> 3) & 7;
+	const unsigned ll = (flags >> 2) & 1;
+	const unsigned dst = (modrm >> 3) & 7, rm = modrm & 7;
+	const unsigned numbers[] = { row->form == 2 ? rm : dst,
+				     !row->form	    ? src :
+				     row->form == 2 ? dst :
+						      rm,
+				     rm };
+	const unsigned count = 2 + !row->form;
+	insn->id = row->id;
+	*insn_size = insn->size = 4;
+	memcpy(insn->bytes, code, 4);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = writeVex32Register(insn->op_str, ll, numbers[0]);
+	for (unsigned i = 1; i < count; ++i) {
+		memcpy(out, ", ", 2);
+		out = writeVex32Register(out + 2, ll, numbers[i]);
+	}
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		memcpy(d->groups, row->groups, sizeof(row->groups));
+		d->groups_count = row->group_count;
+		cs_x86 *x = &d->x86;
+		memcpy(x->opcode, code, 2);
+		x->addr_size = 4;
+		x->modrm = (uint8_t)modrm;
+		x->encoding.modrm_offset = 3;
+		x->op_count = (uint8_t)count;
+		for (unsigned i = 0; i < count; ++i) {
+			cs_x86_op *op = &x->operands[i];
+			op->type = X86_OP_REG;
+			op->reg = (x86_reg)((ll ? X86_REG_YMM0 : X86_REG_XMM0) +
+					    numbers[i]);
+			op->size = (uint8_t)(16u << ll);
+			op->access = (cs_ac_type)row->access[i];
+		}
+	}
+	return true;
+}
+
+/* Bare VEX2, ordinary 32-bit base and a generated full-width memory record. */
+static bool writeVex32Memory(const uint8_t *code, size_t size, cs_insn *insn,
+			     uint16_t *insn_size,
+			     const struct X86SimpleRegister *regs,
+			     const struct Vex32OutputRow *row)
