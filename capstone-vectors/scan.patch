+		{ CS_OPT_UNSIGNED, CS_OPT_OFF, CS_ERR_OK },
+		{ CS_OPT_TEXT, CS_OPT_OFF, CS_ERR_OK },
+		{ CS_OPT_UNSIGNED, CS_OPT_ON, CS_ERR_OK },
+		{ CS_OPT_TEXT, CS_OPT_ON, CS_ERR_OK },
+		{ CS_OPT_UNSIGNED, CS_OPT_OFF, CS_ERR_OK },
+		{ CS_OPT_SYNTAX, CS_OPT_SYNTAX_MASM, CS_ERR_OK },
+		{ CS_OPT_SYNTAX, CS_OPT_SYNTAX_DEFAULT, CS_ERR_OK },
+		{ CS_OPT_SYNTAX, 0xffff, CS_ERR_OPTION },
+		{ CS_OPT_MODE, CS_MODE_16, CS_ERR_OK },
+		{ CS_OPT_MODE, CS_MODE_32, CS_ERR_OK },
+		{ CS_OPT_MODE, CS_MODE_64, CS_ERR_OK },
+		{ CS_OPT_MODE, CS_MODE_32 | CS_MODE_X86_INTEL, CS_ERR_OK },
+		{ CS_OPT_MODE, CS_MODE_64 | CS_MODE_X86_AMD, CS_ERR_OK },
+		{ CS_OPT_MODE, CS_MODE_32 | CS_MODE_X86_INTEL | CS_MODE_X86_AMD,
+		  CS_ERR_OPTION },
+		{ CS_OPT_MODE, CS_MODE_BIG_ENDIAN, CS_ERR_OPTION },
+		{ CS_OPT_MODE, mode, CS_ERR_OK },
