+		{ 0x50 },
+		{ 0x6a, 0x80 },
+		{ 0x83, 0xc0, 0x80 },
+		{ 0xeb, 0xfc },
+		{ 0x8b, 0xc1 },
+		{ 0x8b, 0x44, 0x24, 0x80 },
+		{ 0x66, 0x0f, 0xef, 0xc1 },
+	};
+	for (unsigned i = 0; i < sizeof(inputs) / sizeof(inputs[0]); ++i)
+		for (size_t length = 1; length <= sizeof(inputs[i]); ++length)
+			if (!compare(handles, inputs[i], length, 0x80 + i))
+				return false;
+	return true;
+}
