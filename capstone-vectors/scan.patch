+		op.size = uint8_t(16u << ll);
+		op.access = actual.operands[i].access;
+		access[i] = unsigned(op.access);
+		if (i == memory) {
+			op.type = X86_OP_MEM;
+			op.mem.base = gprs[base];
+			op.mem.scale = 1;
+			op.mem.disp = disp;
+			text += ll ? "ymmword ptr [" : "xmmword ptr [";
+			text += cs_reg_name(decoder.handle, gprs[base]);
+			if (disp) {
