index e374be5e..5ea3fe4c 100644
--- a/docs/ARCHITECTURE.md
+++ b/docs/ARCHITECTURE.md
@@ -841,3 +841,16 @@ to populate the `cs_insn` with the operand information and details.
 
 Again the `InstPrinter` and `AsmWriter` are translated code from LLVM,
 so they mirror the behavior of `llvm-objdump`.
+
+PowerPC's generated alias patterns store the first matching alias-name row in
+the existing two padding bytes of `AliasPattern`. The matcher can return either
+the selected pattern or its assembly string through two specializations of the
+same matching logic. Other printers retain the string-result entry point.
+PowerPC carries the row hint locally until operand printing completes, then
+validates the completed mnemonic with the shared delimiter and 15-byte policy.
+Unknown or modified text uses the existing alias mapper. Formatter callbacks
+therefore observe the same public instruction state.
+
+Run `python3 suite/synctools/ppc_alias_hints.py` after updating the PowerPC alias
+name map, generated assembly writer, or translated printer. Its `--check` mode
+validates the complete projection and rejects stale output.
diff --git a/suite/synctools/ppc_alias_hints.py b/suite/synctools/ppc_alias_hints.py
new file mode 100644
index 00000000..4713305d
--- /dev/null
+++ b/suite/synctools/ppc_alias_hints.py
@@ -0,0 +1,166 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Project PowerPC alias map rows into the selected generated pattern."""
+
+import argparse
+import ast
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def require(test, message):
+    if not test:
+        raise ValueError(message)
+
+
+def project_writer(text, mapping):
+    begin = text.index(
+        "static ",
+        (
+            text.index("static bool printAliasInstr(")
+            if "static bool printAliasInstr(" in text
+            else text.index("static const AliasPattern *printAliasInstr(")
+        ),
+    )
+    end = text.index("\n#endif // CAPSTONE_DIET\n}", begin) + len(
+        "\n#endif // CAPSTONE_DIET\n}"
+    )
+    body = text[begin:end]
+    start = body.index("static const char AsmStrings[] =")
+    stop = body.index(";", start)
+    strings = [
+        (int(offset), ast.literal_eval('b"' + raw + '"'))
+        for offset, raw in re.findall(
+            r'/\* (\d+) \*/ "((?:\\.|[^"\\])*)"', body[start:stop]
+        )
+    ]
+    require(strings, "Missing PowerPC alias strings")
+    next_offset = 0
+    for offset, value in strings:
+        require(
+            offset == next_offset and value.endswith(b"\0") and b"\0" not in value[:-1],
+            "Invalid PowerPC alias string extent",
+        )
+        next_offset += len(value)
+    entries = re.findall(r'\{ (PPC_INS_ALIAS_\w+), "([^"\n]+)" \}', mapping)
+    meaningful = re.sub(r"/\*.*?\*/|//[^\n]*", "", mapping, flags=re.S)
+    require(len(entries) == meaningful.count("{"), "Unknown alias map row")
+    first = {}
+    for row, (_, name) in enumerate(entries, 1):
+        require(row < 65536, "PowerPC alias map exceeds uint16_t")
+        first.setdefault(name.encode("ascii"), row)
+    hints = {}
+    for offset, value in strings:
+        name = re.split(rb"[ \t$\x00]", value, maxsplit=1)[0]
+        hints[offset] = (
+            first.get(name, 0)
+            if len(name) <= 15 and value[len(name) : len(name) + 1] != b"$"
+            else 0
+        )
+    start = body.index("static const AliasPattern Patterns[] = {")
+    stop = body.index("};", start)
+    region = body[start:stop]
+    pattern = re.compile(r"\{(\d+),\s*(\d+),\s*(\d+),\s*(\d+)(?:,\s*\d+)?\s*\}")
+    rows = list(pattern.finditer(region))
+    require(
+        rows and len(rows) + len(re.findall(r"\{0\}", region)) == region.count("{") - 1,
+        "Unknown PowerPC alias pattern",
+    )
+    require(
+        all(int(row[1]) in hints for row in rows),
+        "Pattern does not start at an alias string",
+    )
+    region = pattern.sub(
+        lambda row: "{" + ", ".join([*row.groups(), str(hints[int(row[1])])]) + " }",
+        region,
+    )
+    body = body[:start] + region + body[stop:]
+    original = "  const char *AsmString = matchAliasPatterns(MI, &M);\n  if (!AsmString) return false;"
+    projected = "  const AliasPattern *Pattern = matchAliasPattern(MI, &M);\n  if (!Pattern) return NULL;\n  const char *AsmString = AsmStrings + Pattern->AsmStrOffset;"
+    if original in body:
+        require(body.count(original) == 1, "Duplicate alias match boundary")
+        body = body.replace(original, projected)
+    else:
+        require(body.count(projected) == 1, "Changed alias match boundary")
+    body = body.replace(
+        "static bool printAliasInstr(", "static const AliasPattern *printAliasInstr("
+    )
+    body = body.replace(
+        "  return true;\n#else\n  return false;",
+        "  return Pattern;\n#else\n  return NULL;",
+    )
+    require(
+        "return true" not in body and "return false" not in body,
+        "Unexpected alias return",
+    )
+    return text[:begin] + body + text[end:]
+
+
+def project_printer(text):
+    start = (
+        text.index("static unsigned printInst(")
+        if "static unsigned printInst(" in text
+        else text.index("static void printInst(")
+    )
+    end = text.index("\nconst char *PPC_LLVM_getRegisterName", start)
+    body = text[start:end]
+    old = "\tisAlias |= printAliasInstr(MI, Address, O);"
+    new = "\tconst AliasPattern *aliasPattern = printAliasInstr(MI, Address, O);\n\tisAlias |= aliasPattern != NULL;"
+    if old in body:
+        body = body.replace(old, new)
+    require(body.count(new) == 1, "Changed PowerPC alias selection")
+    body = body.replace("static void printInst(", "static unsigned printInst(")
+    body = body.replace("\treturn;", "\treturn 0;")
+    body = body.replace(
+        'CS_ASSERT_RET(0 && "Expressions not supported.");',
+        'CS_ASSERT_RET_VAL(0 && "Expressions not supported.", 0);',
+    )
+    require("CS_ASSERT_RET(" not in body, "Void assertion in PowerPC alias return")
+    result = "\treturn aliasPattern ? aliasPattern->AliasMapIndex : 0;\n"
+    require(body.endswith("}\n"), "Changed PowerPC printer end")
+    if result not in body:
+        body = body[:-2] + result + "}\n"
+    text = text[:start] + body + text[end:]
+    text = text.replace("void PPC_LLVM_printInst(", "unsigned PPC_LLVM_printInst(")
+    return text.replace(
+        "\tprintInst(MI, Address, Annot, O);",
+        "\treturn printInst(MI, Address, Annot, O);",
+    )
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, default=ROOT)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    arch = args.root / "arch/PowerPC"
+    writer = arch / "PPCGenAsmWriter.inc"
+    printer = arch / "PPCInstPrinter.c"
+    linkage = arch / "PPCLinkage.h"
+    mapping = (arch / "PPCGenCSAliasMnemMap.inc").read_text()
+    outputs = {
+        writer: project_writer(writer.read_text(), mapping),
+        printer: project_printer(printer.read_text()),
+        linkage: linkage.read_text().replace(
+            "void PPC_LLVM_printInst(", "unsigned PPC_LLVM_printInst("
+        ),
+    }
+    require(
+        project_writer(outputs[writer], mapping) == outputs[writer],
+        "Non-idempotent pattern projection",
+    )
+    require(
+        project_printer(outputs[printer]) == outputs[printer],
+        "Non-idempotent printer projection",
+    )
+    for path, generated in outputs.items():
+        if args.check:
+            require(path.read_text() == generated, "Regenerate " + str(path))
+        elif path.read_text() != generated:
+            path.write_text(generated)
+
+
+if __name__ == "__main__":
+    main()
