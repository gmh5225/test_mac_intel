+/* Scan and text output share the same complete register-row admission. */
+static inline const struct VectorOutputRow *
+selectEvexRegisterRow(const uint8_t *code, size_t size)
+{
+	if (size < 6 || code[5] < 0xc0 || (code[2] & 7) != 5 ||
+	    (code[3] & 0x97) || (code[3] & 0x60) == 0x60)
+		return NULL;
+	const unsigned key = ((code[1] & 15) << 8) | code[4];
+	const struct VectorOutputRow *row =
+		evexOutputRow(key, code[2] >> 7, code[3] >> 5);
+	if (!row || (row->immediate && size < 7))
+		return NULL;
+	/* Narrow extracts reserve vvvv/V'. */
+	if ((key & ~0x22u) == 0x319 &&
+	    ((code[2] & 0x78) != 0x78 || !(code[3] & 8)))
+		return NULL;
+	return row;
+}
+
+uint32_t X86_scanEvexRegisters(const uint8_t *code, size_t size)
+{
+	const struct VectorOutputRow *row = selectEvexRegisterRow(code, size);
+	return row ? (row->id << 8) | (6u + row->immediate) : 0;
+}
