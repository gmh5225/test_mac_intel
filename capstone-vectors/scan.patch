diff --git a/arch/X86/X86Mapping.c b/arch/X86/X86Mapping.c
index 16e68cf4..2aed1577 100644
--- a/arch/X86/X86Mapping.c
+++ b/arch/X86/X86Mapping.c
@@ -11918,6 +11918,18 @@ const uint8_t *X86_get_op_access(cs_struct *h, unsigned int id,
 	return NULL;
 }
 
+#if CS_HAS_PRESERVE_MOST
+/* Keep long implicit-list copies from spilling the common zero/one path. */
+static __attribute__((noinline)) CS_PRESERVE_MOST void
+copyImplicitRegisters(uint16_t *destination, const uint16_t *source,
+		      size_t size)
+{
+	memcpy(destination, source, size);
+}
+#else
+#define copyImplicitRegisters memcpy
+#endif
+
 void X86_reg_access(const cs_insn *insn, cs_regs regs_read,
 		    uint8_t *regs_read_count, cs_regs regs_write,
 		    uint8_t *regs_write_count)
@@ -11933,13 +11945,15 @@ void X86_reg_access(const cs_insn *insn, cs_regs regs_read,
 	if (read_count == 1)
 		regs_read[0] = insn->detail->regs_read[0];
 	else if (read_count != 0)
-		memcpy(regs_read, insn->detail->regs_read,
-		       read_count * sizeof(insn->detail->regs_read[0]));
+		copyImplicitRegisters(
+			regs_read, insn->detail->regs_read,
+			read_count * sizeof(insn->detail->regs_read[0]));
 	if (write_count == 1)
 		regs_write[0] = insn->detail->regs_write[0];
 	else if (write_count != 0)
-		memcpy(regs_write, insn->detail->regs_write,
-		       write_count * sizeof(insn->detail->regs_write[0]));
+		copyImplicitRegisters(
+			regs_write, insn->detail->regs_write,
+			write_count * sizeof(insn->detail->regs_write[0]));
 
 	// explicit registers
 	for (i = 0; i < x86->op_count; i++) {
@@ -11984,6 +11998,10 @@ void X86_reg_access(const cs_insn *insn, cs_regs regs_read,
 	*regs_read_count = read_count;
 	*regs_write_count = write_count;
 }
+#if !CS_HAS_PRESERVE_MOST
+#undef copyImplicitRegisters
+#endif
+
 #endif
 
 // Generated from X86ImmSize.inc for the full and reduced instruction enums.
diff --git a/cs_priv.h b/cs_priv.h
index 95d36ef5..85695463 100644
--- a/cs_priv.h
+++ b/cs_priv.h
@@ -19,10 +19,12 @@
     (defined(__aarch64__) || (defined(__x86_64__) && __clang_major__ >= 17))
 #if __has_attribute(preserve_most)
 #define CS_PRESERVE_MOST __attribute__((preserve_most))
+#define CS_HAS_PRESERVE_MOST 1
 #endif
 #endif
 #ifndef CS_PRESERVE_MOST
 #define CS_PRESERVE_MOST
+#define CS_HAS_PRESERVE_MOST 0
 #endif
 
 #include "cs_assert.h"
