diff --git a/arch/X86/X86ATTMemoryAddress.h b/arch/X86/X86ATTMemoryAddress.h
new file mode 100644
index 00000000..469b5ff3
--- /dev/null
+++ b/arch/X86/X86ATTMemoryAddress.h
@@ -0,0 +1,52 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_ATT_MEMORY_ADDRESS_H
+#define CS_X86_ATT_MEMORY_ADDRESS_H
+
+#include "X86SimpleOutput.h"
+#include "X86UnsignedImmediate.h"
+
+static inline char *writeATTMemoryRegister(char *out, const struct X86SimpleRegister *reg)
+{
+	*out++ = '%';
+	memcpy(out, reg->name, reg->length);
+	return out + reg->length;
+}
+
+/* Non-absolute ModR/M addresses with a base or RIP. The caller has
+ * already decoded the displacement and scale, including EVEX tuples. */
+static inline char *writeATTMemoryAddress(
+	char *out, int32_t displacement, bool rip,
+	const struct X86SimpleRegister *base,
+	const struct X86SimpleRegister *index, unsigned scale_bits)
+{
+	if (displacement) {
+		int64_t value = displacement;
+		if (value < 0) {
+			*out++ = '-';
+			value = -value;
+		}
+		out = writeUnsignedImmediate(out, (uint64_t)value);
+	}
+	*out++ = '(';
+	if (rip) {
+		memcpy(out, "%rip", 4);
+		out += 4;
+	} else {
+		out = writeATTMemoryRegister(out, base);
+	}
+	if (index) {
+		memcpy(out, ", ", 2);
+		out = writeATTMemoryRegister(out + 2, index);
+		if (scale_bits) {
+			memcpy(out, ", ", 2);
+			out += 2;
+			*out++ = (char)('0' + (1 << scale_bits));
+		}
+	}
+	*out++ = ')';
+	return out;
+}
+
+#endif
