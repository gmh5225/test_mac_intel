+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_VEX32_REGISTER_MOVE_H
+#define CS_X86_VEX32_REGISTER_MOVE_H
+
+#include "X86VectorRegisterOutput.h"
+#define X86_VEX32_REGISTER_MOVES
+#include "X86GenVex32MemoryOutput.inc"
+#undef X86_VEX32_REGISTER_MOVES
+
+/* The caller has four bytes starting with a two-byte VEX prefix. */
+static inline bool isVex32RegisterMove(const uint8_t *code)
+{
+	return (code[1] & 0xf8) == 0xf8 && code[3] >= 0xc0 &&
+	       (code[2] == 0x6f || code[2] == 0x7f) &&
+	       ((code[1] & 3) == 1 || (code[1] & 3) == 2);
+}
+
+static inline void writeVex32RegisterMove(const uint8_t *code, cs_insn *insn,
+					  uint16_t *insn_size, bool att)
+{
+	const unsigned ll = (code[1] >> 2) & 1;
+	const unsigned reg = (code[3] >> 3) & 7,
+		       rm = code[3] & 7;
+	const bool load = code[2] == 0x6f;
+	const unsigned operands[] = { load ? reg : rm,
+				      load ? rm : reg };
+	writeVectorRegistersDialect(
+		code, insn, insn_size,
+		&vex32_move_rows[(code[1] & 3) - 1], 2, ll, 0,
+		ll, operands, 2, att);
+	if (insn->detail)
+		insn->detail->x86.addr_size = 4;
+}
