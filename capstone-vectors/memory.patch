diff --git a/arch/X86/X86PackedDialectOutput.inc b/arch/X86/X86PackedDialectOutput.inc
new file mode 100644
index 00000000..58303aca
--- /dev/null
+++ b/arch/X86/X86PackedDialectOutput.inc
@@ -0,0 +1,113 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+/* Each caller selects its syntax before decoding a record. */
+#include "X86PackedMemoryOutput.h"
+
+CAPSTONE_INTERNAL bool X86_PACKED_WRITE(LegacyPacked64)(
+	const uint8_t *code, size_t size, cs_insn *insn, uint16_t *insn_size,
+	unsigned offset, uint8_t rex, const struct X86SimpleRegister *base_regs)
+{
+	const unsigned bank = code[0] == 0x66 ? 0 : 1 + (code[0] & 1);
+	const unsigned plan = legacy_packed_plans[bank][code[offset - 2]];
+	if (!plan)
+		return false;
+	const struct X86SseRegisterOutput *entry = &legacy_packed_rows[plan];
+	return X86_PACKED_WRITE(PackedMemoryOperand)(code, insn, insn_size, entry, rex, offset,
+					 size, false, base_regs, entry->output.mnemonic, true);
+}
+
+CAPSTONE_INTERNAL bool X86_PACKED_WRITE(PackedVex64)(
+	const uint8_t *code, size_t size, cs_insn *insn, uint16_t *insn_size,
+	const struct X86SimpleRegister *base_regs)
+{
+	if (size < 4 || (code[1] & 0x78) != 0x78 || code[3] >= 0xc0)
+		return false;
+	const unsigned plan = vex64_packed_plans[code[1] & 7][code[2]];
+	if (!plan)
+		return false;
+	const struct X86SseRegisterOutput *entry = &vex64_packed_rows[plan];
+	const char *mnemonic = entry->output.mnemonic;
+#ifndef CAPSTONE_X86_ATT_DISABLE
+	if (X86_PACKED_ATT) {
+		mnemonic = vex64PackedATTMnemonic(plan);
+		if (!mnemonic)
+			return false;
+	}
+#endif
+	const uint8_t rex = (uint8_t)(0x40 | ((~(unsigned)code[1] >> 5) & 4));
+	return X86_PACKED_WRITE(PackedMemoryOperand)(code, insn, insn_size, entry, rex, 4, size,
+					 true, base_regs, mnemonic, false);
+}
+
+CAPSTONE_INTERNAL bool X86_PACKED_WRITE(BareSse64)(
+	const uint8_t *code, size_t size, cs_insn *insn, uint16_t *insn_size,
+	unsigned length, uint8_t rex, const struct X86SimpleRegister *base_regs)
+{
+	const uint8_t opcode = code[length - 2];
+	const unsigned index = opcode - X86_SSE_REGISTER_FIRST;
+	if (index >= sizeof(x86_sse_register_outputs) /
+			     sizeof(x86_sse_register_outputs[0]))
+		return false;
+	const struct X86SseRegisterOutput *entry =
+		&x86_sse_register_outputs[index];
+	const struct X86SimpleOutput *row = &entry->output;
+	if (!row->id)
+		return false;
+
+	const uint8_t mr = code[length - 1];
+	if (mr < 0xc0)
+		return entry->base_memory &&
+		       X86_PACKED_WRITE(PackedMemoryOperand)(code, insn, insn_size, entry,
+					 rex, length, size, false, base_regs,
+					 entry->output.mnemonic, false);
+	const unsigned reg = ((mr >> 3) & 7) | ((rex & 4) << 1);
+	const unsigned rm = (mr & 7) | ((rex & 1) << 3);
+	const unsigned first = entry->reverse ? rm : reg,
+		       second = entry->reverse ? reg : rm;
+	*insn_size = insn->size = (uint16_t)length;
+	insn->id = row->id;
+	memcpy(insn->bytes, code, length);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	if (X86_PACKED_ATT) {
+		insn->op_str[0] = '%';
