+static bool check_i386_register_pairs(csh handles[2])
+{
+	for (unsigned opcode = 0; opcode < 256; ++opcode) {
+		for (unsigned mr = 0xc0; mr < 256; ++mr) {
+			const uint8_t code[] = { 0x0f, (uint8_t)opcode,
+						 (uint8_t)mr };
+			if (!compare(handles, code, sizeof(code),
+				     mr ^ opcode) ||
+			    !compare(handles, code, mr % sizeof(code), opcode))
+				return false;
+		}
+	}
+	return true;
+}
