+// These 0F opcodes write ModR/M.reg and read ModR/M.r/m in the
+// register form. Project the access flags and implicit effects from every
+// encoding, including AH through BH for an eight-bit source.
+void emit_i386_register_pairs(Decoder &decoder, const RegisterTable &regs)
+{
+	uint8_t plans[256]{};
+	std::vector<std::string> rows{ initializer(X86SimpleOutput{}) };
+	for (unsigned opcode = 0; opcode < 256; ++opcode) {
+		const bool byte_source = opcode == 0xb6 || opcode == 0xbe;
+		const bool cmov = opcode >= 0x40 && opcode <= 0x4f;
+		if (!cmov && !byte_source && opcode != 0xaf && opcode != 0xbc &&
+		    opcode != 0xbd)
+			continue;
+		std::string fields;
+		for (unsigned mr = 0xc0; mr < 256; ++mr) {
+			const uint8_t code[] = { 0x0f, uint8_t(opcode),
+						 uint8_t(mr) };
+			decoder.decode(code, sizeof(code), sizeof(code), 0);
+			const auto &dst = regs[2][(mr >> 3) & 7];
+			const auto &src = regs[byte_source ? 0 : 2][mr & 7];
+			const auto row = describe(*decoder.insn,
+						  uint8_t(opcode), 0,
+						  uint8_t(mr), &dst, &src,
+						  false, false, true);
+			if (row.empty() || (mr != 0xc0 && row != fields))
+				throw std::runtime_error(
+					"inconsistent i386 register pair at opcode " +
+					std::to_string(opcode));
+			fields = row;
+		}
+		plans[opcode] = static_cast<uint8_t>(rows.size());
+		rows.push_back(fields);
+	}
+	std::cout
+		<< "/* Generated by x86_simple_output.cpp --i386-register-pairs. */\n"
+		   "static const uint8_t i386_register_plans[256] = {\n";
+	for (unsigned i = 0; i < 256; i += 16) {
+		std::cout << '\t';
+		for (unsigned j = 0; j < 16; ++j)
+			std::cout << unsigned(plans[i + j])
+				  << (j == 15 ? ",\n" : ", ");
+	}
+	std::cout
+		<< "};\nstatic const struct X86SimpleOutput i386_register_rows[] = {\n";
+	for (const auto &row : rows)
+		std::cout << '\t' << row << ",\n";
+	std::cout << "};\n";
+}
+
 } // namespace
 
