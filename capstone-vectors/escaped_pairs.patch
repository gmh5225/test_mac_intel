-			"expected no arguments, --sse64-registers, --vex64-packed-memory or --indirect-memory");
+			"expected no arguments, --sse64-registers, --vex64-packed-memory, --indirect-memory or --i386-register-pairs");
 	Decoder x86(CS_MODE_32), x64(CS_MODE_64);
 	RegisterTable regs{};
