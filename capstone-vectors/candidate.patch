diff --git a/arch/X86/X86PublicIterator.c b/arch/X86/X86PublicIterator.c
new file mode 100644
index 00000000..7d00b9fe
--- /dev/null
+++ b/arch/X86/X86PublicIterator.c
@@ -0,0 +1,31 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include "../../cs_priv.h"
+#include "X86Disassembler.h"
+#include "X86ScanAdapter.h"
+
+#ifdef CAPSTONE_X86_STATIC_ITERATOR
+/* In a mixed static library the two private text readers already implement
+ * the entire public iterator contract for their respective address sizes. */
+#if defined(__ELF__) && defined(__clang__)
+__attribute__((section(".cs_x86_public_iterator_text")))
+#elif defined(__APPLE__) && defined(__clang__)
+__attribute__((section("__TEXT,__cs_x86_iter,regular,pure_instructions")))
+#endif
+CAPSTONE_EXPORT
+bool CAPSTONE_API cs_disasm_iter(csh ud, const uint8_t **code, size_t *size,
+				 uint64_t *address, cs_insn *insn)
+{
+	if (!*size || !ud)
+		return false;
+	const cs_struct *handle = (const cs_struct *)(uintptr_t)ud;
+	if (handle->arch == CS_ARCH_X86 && !handle->no_text) {
+		if (handle->mode == CS_MODE_32)
+			return X86_disasmIter32(ud, code, size, address, insn);
+		if (handle->mode == CS_MODE_64)
+			return X86_disasmIterText(ud, code, size, address, insn);
+	}
+	return cs_disasm_iter_generic(ud, code, size, address, insn);
+}
+#endif
