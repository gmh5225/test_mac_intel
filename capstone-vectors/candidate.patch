diff --git a/suite/synctools/alias_pattern_rows.py b/suite/synctools/alias_pattern_rows.py
old mode 100755
new mode 100644
index 118fa9d3..30b65870
--- a/suite/synctools/alias_pattern_rows.py
+++ b/suite/synctools/alias_pattern_rows.py
@@ -24,12 +24,41 @@ def entries(directory):
     return opcodes
 
 
+def mips_row_pages(opcodes):
+    # A zero page is shared by all empty opcode blocks. Nonempty entries
+    # contain the one-based row in the generated OpToPatterns table.
+    first = opcodes[0]
+    page_ids = [0] * ((opcodes[-1] - first) // 16 + 1)
+    pages = [[0] * 16]
+    for row, opcode in enumerate(opcodes, 1):
+        block, slot = divmod(opcode - first, 16)
+        if not page_ids[block]:
+            page_ids[block] = len(pages)
+            pages.append([0] * 16)
+        pages[page_ids[block]][slot] = row
+
+    index_type = "uint8_t" if len(opcodes) <= 255 else "uint16_t"
+    lines = [
+        "/* Generated by suite/synctools/alias_pattern_rows.py. */",
+        f"#define Mips_FIRST_ALIAS_OPCODE {first}u",
+        f"static const {index_type} Mips_alias_pages[] ALIAS_PATTERN_DATA = {{",
+    ]
+    for start in range(0, len(page_ids), 16):
+        lines.append("\t" + ", ".join(map(str, page_ids[start:start + 16])) + ",")
+    lines += ["};", f"static const {index_type} Mips_alias_rows[][16] ALIAS_PATTERN_DATA = {{"]
+    for page in pages:
+        lines.append("\t{ " + ", ".join(map(str, page)) + " },")
+    return "\n".join(lines + ["};", ""])
+
+
 def generate(directory):
     opcodes = entries(directory)
     arch = "PPC" if directory.name == "PowerPC" else directory.name
     first = opcodes[0]
     if len(opcodes) > 65535:
         raise ValueError("Alias row index exceeds uint16_t")
+    if arch == "Mips":
+        return mips_row_pages(opcodes)
     # Each entry records the table row of its first opcode and which of the
     # next sixteen instruction IDs have a pattern.
     masks = [0] * ((opcodes[-1] - first) // 16 + 1)
