diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 197453cb..6bee973d 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3753,7 +3753,9 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 					  cs_insn *insn, uint16_t *insn_size,
 					  bool batch);
 
-#ifdef CAPSTONE_X86_PUBLIC_OUTPUT
+#ifdef CAPSTONE_X86_MIXED_PUBLIC_RECORD
+#define CS_DECODE_OUTPUT_MISS X86_decodeMixedPublicRecord
+#elif defined(CAPSTONE_X86_PUBLIC_OUTPUT)
 #define CS_DECODE_OUTPUT_MISS X86_decodePublicRecord
 #elif defined(CAPSTONE_X86_PUBLIC_FIXED_RECORD)
 #define CS_PUBLIC_FIXED_RECORD
diff --git a/arch/X86/X86Sse64Output.c b/arch/X86/X86Sse64Output.c
index 324fc05d..0f8f97f8 100644
--- a/arch/X86/X86Sse64Output.c
+++ b/arch/X86/X86Sse64Output.c
@@ -282,4 +282,24 @@ CAPSTONE_INTERNAL bool X86_disasmIterText(csh ud, const uint8_t **code,
 #endif
 	return X86_disasmIter32(ud, code, size, address, insn);
 }
+
+/* The public iterator owns the caller's cursors and skip-data callbacks. */
+#ifdef CAPSTONE_X86_MIXED_PUBLIC_RECORD
+__attribute__((section(".cs_x86_public_output_text")))
+CS_PRESERVE_MOST bool X86_decodeMixedPublicRecord(cs_struct *handle,
+						 const uint8_t *code, size_t size,
+						 cs_insn *insn, uint16_t *length,
+						 bool batch)
+{
+	if (handle->arch == CS_ARCH_X86 && !batch && !handle->no_text &&
+	    !handle->skipdata && (handle->syntax == CS_OPT_SYNTAX_DEFAULT ||
+				  handle->syntax == CS_OPT_SYNTAX_INTEL)) {
+		if (handle->mode == CS_MODE_64)
+			return decode_insn(handle, code, size, insn, length, false, false);
+		if (handle->mode == CS_MODE_32)
+			return X86_decodeMixedRecord32(handle, code, size, insn, length);
+	}
+	return cs_decode_full_insn(handle, code, size, insn, length, batch);
+}
+#endif
 #endif
diff --git a/arch/X86/X86Vex32Output.c b/arch/X86/X86Vex32Output.c
index d6f533e0..ffdf5864 100644
--- a/arch/X86/X86Vex32Output.c
+++ b/arch/X86/X86Vex32Output.c
@@ -223,4 +223,13 @@ CAPSTONE_INTERNAL bool X86_disasmIter32(csh ud, const uint8_t **code,
 #endif
 	return X86_disasmIter(ud, code, size, address, insn);
 }
+
+#ifdef CAPSTONE_X86_MIXED_PUBLIC_RECORD
+__attribute__((section(".cs_x86_public_record32_text")))
+bool X86_decodeMixedRecord32(cs_struct *handle, const uint8_t *code, size_t size,
+			     cs_insn *insn, uint16_t *length)
+{
+	return decode_insn(handle, code, size, insn, length, false, false);
+}
+#endif
 #endif
