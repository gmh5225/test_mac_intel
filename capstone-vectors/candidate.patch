+/* Condition-code bits in x86 encoding order. */
+#define X86_CONDITION_IDS(prefix)                                              \
+	{ prefix##O, prefix##NO, prefix##B, prefix##AE, prefix##E, prefix##NE, \
+	  prefix##BE, prefix##A, prefix##S, prefix##NS, prefix##P, prefix##NP, \
+	  prefix##L, prefix##GE, prefix##LE, prefix##G }
+
+#endif
