diff --git a/arch/X86/X86Mapping.h b/arch/X86/X86Mapping.h
index a2677cb8..1d271200 100644
--- a/arch/X86/X86Mapping.h
+++ b/arch/X86/X86Mapping.h
@@ -122,6 +122,19 @@ void X86_build_lookup_tables(cs_struct *h);
 
 void X86_postprinter(csh handle, cs_insn *insn, SStream *mnem, MCInst *mci);
 
+#if defined(CAPSTONE_X86_SHARED_POSTPRINTER) && defined(__ELF__) && defined(__GNUC__)
+#define X86_SEPARATE_POSTPRINTER
+CAPSTONE_INTERNAL void X86_postprinter_full(csh handle, cs_insn *insn,
+					    SStream *mnem, MCInst *mci);
+#endif
+
+/* These opcodes can only need the printed broadcast decorator repaired.
+ * VEX/EVEX, x87 environment and rotate forms take the full repair path. */
+static inline bool X86_onlyRepairsBroadcast(uint8_t opcode)
+{
+	return (opcode & 0xe0) != 0xc0 && opcode != 0x62;
+}
+
 static inline bool x86_has_feature(cs_mode mode, int flag)
 {
 	return (mode & flag) == flag;
diff --git a/arch/X86/X86PostPrinter.c b/arch/X86/X86PostPrinter.c
new file mode 100644
index 00000000..bca09178
--- /dev/null
+++ b/arch/X86/X86PostPrinter.c
@@ -0,0 +1,24 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "X86Mapping.h"
+
+#ifdef X86_SEPARATE_POSTPRINTER
+#include <string.h>
+
+/* Preserve custom broadcast spellings, which may appear on a scalar operand. */
+__attribute__((section(".cs_x86_postprinter_text")))
+void X86_postprinter(csh handle, cs_insn *insn, SStream *mnem, MCInst *mci)
+{
+	if (insn && insn->id != X86_INS_VPCMP) {
+		if (!insn->detail)
+			return;
+		if (X86_onlyRepairsBroadcast(insn->detail->x86.opcode[0]) &&
+		    !strchr(mnem->buffer, '{'))
+			return;
+	}
+	X86_postprinter_full(handle, insn, mnem, mci);
+}
+#endif
+#endif
