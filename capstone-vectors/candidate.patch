 fallback:
+	/* The ordinary memory writer already builds the address and implicit
+	 * effects for a single FF operand. Reuse it for bare near targets. */
+	if (size >= 2 && code[0] == 0xff && code[1] < 0xc0) {
+		const unsigned group = (code[1] >> 3) & 7;
+		if ((group == 2 || group == 4) &&
+		    !X86_OUTPUT_UNSUPPORTED(handle, false) &&
+		    X86_writeMemoryOutput(code, size, insn, insn_size,
