+		if (size >= 3 && (code[1] == 0x8d || code[1] == 0x2b ||
+		     code[1] == 0x89 || code[1] == 0x8b) && code[2] < 0xc0 &&
 		    !X86_OUTPUT_UNSUPPORTED(handle, false)) {
-			const unsigned row = x86_simple_plans[0][0][0x8d] >> 2;
-			if (writeSegmentLea32(code, size, insn, insn_size,
+			const unsigned row = x86_simple_plans[0][0][code[1]] >> 2;
+			if (writeSegmentMemory32(code, size, insn, insn_size,
 					      &x86_simple_outputs[row],
