+void emit_legacy_gpr_moves(Decoder &decoder)
+{
+	RegisterTable regs{};
+	describe_registers(decoder, regs);
+	X86SimpleRegister xmm[16]{};
+	std::cout << "static const struct X86SimpleRegister legacy_move_xmm[16] = {\n";
+	for (unsigned i = 0; i < 16; ++i) {
+		auto &reg = xmm[i];
+		reg.reg = uint16_t(X86_REG_XMM0 + i);
+		const char *name = cs_reg_name(decoder.handle, reg.reg);
+		if (!name || strlen(name) >= sizeof(reg.name))
+			throw std::runtime_error("invalid XMM register name");
+		strcpy(reg.name, name);
+		reg.length = uint8_t(strlen(name));
+		std::cout << "\t{ " << reg.reg << ", " << unsigned(reg.length)
+			  << ", \"" << name << "\" },\n";
+	}
+	std::cout << "};\nstatic const struct X86SimpleOutput legacy_gpr_moves[2][2] = {\n";
+	for (unsigned wide = 0; wide < 2; ++wide) {
+		std::cout << "\t{\n";
+		for (unsigned store = 0; store < 2; ++store) {
+			const uint8_t opcode = store ? 0x7e : 0x6e;
+			CheckedRow row;
+			for (unsigned p = 0; p <= 16; ++p) {
+				const uint8_t rex = p ? uint8_t(0x3f + p) : 0;
+				if (bool(rex & 8) != bool(wide))
+					continue;
+				for (unsigned mr = 0xc0; mr <= 0xff; ++mr) {
+					uint8_t code[5] = { 0x66 };
+					unsigned pos = 1;
+					if (rex)
+						code[pos++] = rex;
+					code[pos++] = 0x0f;
+					code[pos++] = opcode;
+					code[pos++] = uint8_t(mr);
+					decoder.decode(code, pos, pos, 0);
+					const auto *vec = &xmm[((rex & 4) << 1) | ((mr >> 3) & 7)];
+					const auto *gpr = &regs[2 + wide][((rex & 1) << 3) | (mr & 7)];
+					row.observe(describe(*decoder.insn, opcode, rex, uint8_t(mr),
+							     store ? gpr : vec, store ? vec : gpr,
+							     false, false, true, 0, 0x66));
+				}
+			}
+			std::cout << "\t\t" << row.fields << ",\n";
+		}
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+}
