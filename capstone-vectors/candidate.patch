 	return banks;
 }
 
+// VEX register transfers select ModR/M.reg and ModR/M.r/m. Validate the
+// operand order and register classes against the complete canonical record.
+std::string vex_transfer_row(Decoder &decoder, const VexRegisterBanks &banks,
+			     unsigned prefix, unsigned opcode, unsigned key)
+{
+	const unsigned w = key >> 3, ll = (key >> 2) & 1, pp = key & 3;
+	if (prefix == 2 && w)
+		return {};
+	const auto encoding = [&](unsigned reg, unsigned rm, unsigned xb) {
+		std::array<uint8_t, 5> bytes{};
+		const unsigned rxb = ((reg >> 3) << 2) | xb | (rm >> 3);
+		bytes[0] = prefix == 2 ? 0xc5 : 0xc4;
+		if (prefix == 3)
+			bytes[1] = uint8_t(((7 ^ rxb) << 5) | 1);
+		bytes[prefix - 1] = uint8_t((prefix == 2 ? (~rxb & 4) << 5 :
+							 w << 7) |
+					     0x78 | (ll << 2) | pp);
+		bytes[prefix] = uint8_t(opcode);
+		bytes[prefix + 1] = uint8_t(0xc0 | ((reg & 7) << 3) | (rm & 7));
+		return bytes;
+	};
+	const auto sample = encoding(3, 1, 0);
+	if (!decoder.decode(sample.data(), prefix + 2))
+		return {};
+	const cs_x86 &x = decoder.insn->detail->x86;
+	if (x.op_count != 2)
+		return {};
+	constexpr unsigned widths[] = { 16, 32, 4, 8 };
+	unsigned bank[2]{}, source[2]{};
+	for (unsigned i = 0; i != 2; ++i) {
+		const cs_x86_op &op = x.operands[i];
+		if (op.type != X86_OP_REG)
+			return {};
+		bool found = false;
+		for (unsigned b = 0; b != banks.size(); ++b) {
+			for (unsigned s = 0; s != 2; ++s) {
+				if (op.reg == banks[b][s ? 1 : 3] &&
+				    op.size == widths[b]) {
+					source[i] = s;
+					bank[i] = b;
+					found = true;
+				}
+			}
+		}
+		if (!found)
+			return {};
+	}
+	if (source[0] == source[1])
+		return {};
+	std::string reference;
+	for (unsigned reg = 0; reg != 16; ++reg) {
+		for (unsigned rm = 0; rm != (prefix == 2 ? 8 : 16); ++rm) {
+			for (unsigned xb = 0; xb < (prefix == 2 ? 1 : 3); xb += 2) {
+				const auto bytes = encoding(reg, rm, xb);
+				const unsigned rxb = ((reg >> 3) << 2) | xb | (rm >> 3);
+				VexRegisterOperand operands[2]{};
+				for (unsigned i = 0; i != 2; ++i) {
+					operands[i] = { banks[bank[i]][source[i] ? rm : reg],
+							uint8_t(widths[bank[i]]) };
+				}
+				const auto row = checked_vex_registers(
+					decoder, bytes.data(), prefix, false, w * 8 + rxb,
+					ll, nullptr, 2, false, operands);
+				if (row.empty() || (!reference.empty() && row != reference))
+					return {};
+				reference = row;
+			}
+		}
+	}
+	return "{ " + reference + ", { " + std::to_string(bank[0]) + ", " +
+	       std::to_string(bank[1]) + " }, " + (source[0] ? "true" : "false") + " }";
+}
+
+void emit_vex_transfers(Decoder &decoder)
+{
+	const auto banks = vex_register_banks(decoder);
+	constexpr unsigned opcodes[] = { 0x28, 0x29, 0x50 };
+	std::vector<std::string> rows;
+	std::puts("/* Generated by suite/synctools/x86_vector_output.cpp --vex-register-transfers. */");
+	std::puts("static const uint8_t vex_transfer_plans[3][16] = {");
+	for (unsigned opcode : opcodes) {
+		std::printf("\t{");
+		for (unsigned key = 0; key < 16; ++key) {
+			auto row = vex_transfer_row(decoder, banks, 3, opcode, key);
+			if (key < 8 && row != vex_transfer_row(decoder, banks, 2, opcode, key))
+				throw std::runtime_error("different VEX register transfer records");
+			unsigned index = 0;
+			if (!row.empty()) {
+				auto it = std::find(rows.begin(), rows.end(), row);
+				index = unsigned(it - rows.begin()) + 1;
+				if (it == rows.end())
+					rows.push_back(row);
+			}
+			std::printf(" %u,", index);
+		}
+		std::puts(" },");
+	}
+	if (rows.empty() || rows.size() > UINT8_MAX)
+		throw std::runtime_error("invalid VEX register transfer row count");
+	std::puts("};\nstatic const struct VexTransferRow vex_transfer_rows[] = {");
+	for (const auto &row : rows)
+		std::printf("\t%s,\n", row.c_str());
+	std::puts("};");
+	std::fprintf(stderr, "%zu register transfer rows, %llu canonical probes\n",
+		     rows.size(), static_cast<unsigned long long>(decoder.probes));
+}
+
