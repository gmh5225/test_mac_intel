diff --git a/CMakeLists.txt b/CMakeLists.txt
index bd513f27..37e3b956 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -513,7 +513,8 @@ if(CAPSTONE_X86_SUPPORT)
     # Use scalar/vector stores or libc for the fixed public output buffers.
     # Generic x64 GCC otherwise emits REP STOS even for the short clears.
     if((capstone_enabled_architectures STREQUAL "X86" OR capstone_enabled_architectures STREQUAL "MIPS;X86"
-        OR capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;X86")
+        OR capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;X86"
+        OR capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV")
        AND CMAKE_C_COMPILER_ID STREQUAL "GNU"
        AND CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SIZEOF_VOID_P EQUAL 8
        AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
diff --git a/Makefile b/Makefile
index 2720955e..da9772cd 100644
--- a/Makefile
+++ b/Makefile
@@ -698,7 +698,11 @@ $(OBJDIR)/arch/TriCore/TriCoreDisassembler.o: CFLAGS += -DCAPSTONE_TRICORE_DIREC
 endif
 
 # Match the Release x86 formatter tuning for the compiler's target.
-ifneq (,$(filter -DCAPSTONE_X86_ONLY -DCAPSTONE_X86_MIPS_ONLY -DCAPSTONE_ARM_AARCH64_MIPS_X86,$(CFLAGS)))
+x86_output_store_profile := $(filter -DCAPSTONE_X86_ONLY -DCAPSTONE_X86_MIPS_ONLY -DCAPSTONE_ARM_AARCH64_MIPS_X86,$(CFLAGS))
+ifeq ($(sort $(CAPSTONE_ARCHS)),aarch64 arm mips powerpc riscv x86)
+x86_output_store_profile := 1
+endif
+ifneq (,$(x86_output_store_profile))
 ifneq (,$(filter -O2 -O3,$(CFLAGS)))
 X86_OUTPUT_STORE_FLAG := $(shell $(CC) $(CFLAGS) -dM -E -x c - < /dev/null 2>/dev/null | \
     awk '$$2 == "__linux__" { linux_target=1 } $$2 == "__x86_64__" { x64=1 } \
