diff --git a/arch/Mips/MipsInstPrinter.c b/arch/Mips/MipsInstPrinter.c
index 40bf05b4..5642b8aa 100644
--- a/arch/Mips/MipsInstPrinter.c
+++ b/arch/Mips/MipsInstPrinter.c
@@ -117,6 +117,33 @@ static const char *MipsFCCToString(Mips_CondCode CC)
 
 const char *Mips_LLVM_getRegisterName(unsigned RegNo, bool noRegName);
 
+#if defined(__linux__) && defined(__x86_64__) && defined(__clang__) && \
+    defined(CAPSTONE_MIPS_ONLY) && !defined(CAPSTONE_DIET)
+#define MIPS_DIRECT_NUMERIC_NAMES
+
+/* The printed numeric spelling comes from the generated LLVM register table. */
+static bool appendNumericRegister(SStream *OS, MCRegister reg, bool dollar)
+{
+	const char *name = Mips_LLVM_getRegisterName(reg, true);
+	if (!name || OS->is_closed || OS->markup_stream || OS->prefixed_by_markup)
+		return false;
+	if (name[0] < '0' || name[0] > '9' || OS->index >= SSTREAM_BUF_LEN - 3)
+		return false;
+	const bool pair = name[1] != '\0';
+	if (pair && (name[1] < '0' || name[1] > '9' || name[2] != '\0'))
+		return false;
+	char *out = OS->buffer + OS->index;
+	if (dollar)
+		*out++ = '$';
+	*out++ = name[0];
+	if (pair)
+		*out++ = name[1];
+	*out = '\0';
+	OS->index += dollar + 1 + pair;
+	return true;
+}
+#endif
+
 /* Use the numeric and ABI register tables in the dedicated Linux arm64 printer. */
 #if defined(__linux__) && defined(__aarch64__) && defined(__clang__) && \
     defined(CAPSTONE_MIPS_ONLY)
@@ -157,6 +184,11 @@ static void printRegName(MCInst *MI, SStream *OS, MCRegister Reg)
 			return;
 		}
 	}
+#endif
+#ifdef MIPS_DIRECT_NUMERIC_NAMES
+	if ((syntax_opt & CS_OPT_SYNTAX_NOREGNAME) &&
+	    appendNumericRegister(OS, Reg, !(syntax_opt & CS_OPT_SYNTAX_NO_DOLLAR)))
+		return;
 #endif
 	if (!(syntax_opt & CS_OPT_SYNTAX_NO_DOLLAR)) {
 		SStream_concat1(OS, '$');
