+/* CMP and TEST with imm8, and near indirect CALL/JMP, share the address
+ * reader. The opcode extension selects a generated operand and effects row. */
+static bool writeGroupMemory64(cs_struct *handle, const uint8_t *code,
+			       size_t size, cs_insn *insn, uint16_t *length)
+{
+	const unsigned lead = (code[0] & 0xf0) == 0x40;
+	if (size <= lead)
+		return false;
+	const uint8_t opcode = code[lead];
+	if ((opcode != 0x80 && opcode != 0xf6 && opcode != 0xff) ||
+	    size < lead + 2)
+		return false;
+	const uint8_t mr = code[lead + 1];
+	const unsigned group = (mr >> 3) & 7;
+	if (mr >= 0xc0 || (opcode == 0x80 && group != 7) ||
+	    (opcode == 0xf6 && group != 0) ||
+	    (opcode == 0xff && group != 2 && group != 4))
+		return false;
+	if (X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	if (opcode == 0xff)
+		return X86_writeMemoryOutput(code, size, insn, length,
+					     &x86_indirect64[lead][group == 4],
+					     x86_simple_registers);
+	const struct X86SimpleOutput *row = &x86_group_byte_memory[lead][opcode == 0xf6];
+	return writeGroupByteImmediate64(code, size, insn, length, row,
+					 x86_simple_registers);
+}
