diff --git a/arch/X86/X86Sse64Output.c b/arch/X86/X86Sse64Output.c
index 7afca7e4..fa2407b3 100644
--- a/arch/X86/X86Sse64Output.c
+++ b/arch/X86/X86Sse64Output.c
@@ -72,6 +72,33 @@ static bool writeIndirect64(const uint8_t *code, size_t size, cs_insn *insn,
 {
 	const struct X86SimpleOutput *row =
 		&x86_indirect64[rex != 0][(modrm & 0x20) != 0];
+	/* A bare RIP-relative target is always a six-byte memory record. */
+	if (!rex && (modrm == 0x15 || modrm == 0x25)) {
+		if (size < 6)
+			return false;
+		const int32_t displacement = X86_readDisp32(code + 2);
+		insn->id = row->id;
+		*insn_size = insn->size = 6;
+		memcpy(insn->bytes, code, 6);
+		memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+		memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+		memset(insn->op_str, 0, sizeof(insn->op_str));
+		memcpy(insn->op_str, "qword ptr [rip", 14);
+		*X86_writeDisplacement(insn->op_str + 14, displacement) = ']';
+		if (insn->detail) {
+			X86_writeSimpleDetail(insn->detail, row, 0xff, 0,
+					      code[1], 0, 0);
+			cs_x86 *x = &insn->detail->x86;
+			cs_x86_op *mem = &x->operands[0];
+			mem->type = X86_OP_MEM;
+			mem->mem.base = X86_REG_RIP;
+			mem->mem.scale = 1;
+			mem->mem.disp = x->disp = displacement;
+			x->encoding.disp_offset = 2;
+			x->encoding.disp_size = 4;
+		}
+		return true;
+	}
 	if (modrm < 0xc0)
 		return X86_writeMemoryOutput(code, size, insn, insn_size, row,
 					     x86_simple_registers);
