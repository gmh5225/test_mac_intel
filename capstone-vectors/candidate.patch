+def att_spellings(text, enum_text):
+    """Emit one printable AT&T token for each register in enum order."""
+    import json
+
+    strings = string_bytes(text)
+    checked = generate(text, enum_text)
+    records = [int(x) for x in re.findall(r"\d+", TABLE.search(checked)[1])]
+    tokens = []
+    for record in records:
+        start, length = record & MASK, record >> SHIFT
+        name = strings[start : start + length].decode("ascii")
+        tokens.append("%" + name)
+    width = max(map(len, tokens)) + 1
+    rows = [
+        "/* Generated by suite/synctools/x86_register_name_sizes.py. */",
+        "struct X86ATTRegisterSpelling {",
+        f"\tchar text[{width}];",
+        "\tuint8_t length;",
+        "};",
+        "static const struct X86ATTRegisterSpelling x86_att_registers[] = {",
+    ]
+    rows.extend(f"\t{{ {json.dumps(token)}, {len(token)} }}," for token in tokens)
+    return "\n".join([*rows, "};", ""])
+
+
