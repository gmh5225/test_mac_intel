+/* VPMADD52LUQ/HUQ use a full vector memory source in this unmasked,
+ * non-broadcast form. Compressed disp8 therefore scales with vector width. */
+bool X86_writeIfmaMemory(cs_struct *handle, const uint8_t *code, size_t size,
+			 cs_insn *insn, uint16_t *insn_size,
+			 const struct X86SimpleRegister *regs)
+{
+	const unsigned flags = code[2], control = code[3], mr = code[5];
+	const unsigned mod = mr >> 6, rm = mr & 7;
+	if ((code[1] & 15) != 2 || (flags & 0x87) != 0x85 ||
+	    (control & 0x97) || (control & 0x60) == 0x60 ||
+	    mod == 3 || rm == 4 || (!mod && rm == 5))
+		return false;
+	const unsigned disp_size = mod == 2 ? 4 : mod;
+	if (size < 6 + disp_size || X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	const unsigned ll = control >> 5;
+	const unsigned prefix = plain_evex_opcodes[1][code[4]];
+	const unsigned index = plain_evex_prefixes[prefix][15 + ll] - 1;
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & 7;
+	const unsigned dst = ((mr >> 3) & 7) | ((rxb & 4) << 1) |
+			     (~(unsigned)code[1] & 16);
+	const unsigned src = ((~flags >> 3) & 15) | ((~control & 8) << 1);
+	const int32_t disp = disp_size == 1 ? (int8_t)code[6] * (16 << ll) :
+			     disp_size == 4 ? X86_readDisp32(code + 6) : 0;
+	return writeVectorMemory(code, insn, insn_size,
+				 &plain_evex_rows[index].instruction, 4, ll,
+				 0x48 | rxb, dst, src, &regs[rm | ((rxb & 1) << 3)],
+				 disp_size, disp);
+}
+
