+static void printUnsignedHex(const MCInst *MI, SStream *O, uint64_t value)
+{
+	if (MI->csh->syntax != CS_OPT_SYNTAX_MASM)
+		SStream_concat_hex64(O, value, false);
+	else if (value == (UINT64_C(1) << 63))
+		SStream_concat0(O, "8000000000000000h");
+	else if (need_zero_prefix(value))
+		SStream_concat(O, "0%" PRIx64 "h", value);
+	else
+		SStream_concat(O, "%" PRIx64 "h", value);
+}
