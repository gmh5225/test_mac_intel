diff --git a/arch/X86/X86PackedMemoryOutput.h b/arch/X86/X86PackedMemoryOutput.h
new file mode 100644
index 00000000..688c2b27
--- /dev/null
+++ b/arch/X86/X86PackedMemoryOutput.h
@@ -0,0 +1,113 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_PACKED_MEMORY_OUTPUT_H
+#define CS_X86_PACKED_MEMORY_OUTPUT_H
+
+struct X86SseRegisterOutput {
+	struct X86SimpleOutput output;
+	bool reverse;
+	bool base_memory;
+};
+static bool writePackedMemory(const uint8_t *code, cs_insn *insn,
+			      uint16_t *insn_size,
+			      const struct X86SseRegisterOutput *entry,
+			      uint8_t rex, unsigned offset, size_t size,
+			      bool vex)
+{
+	const uint8_t mr = code[offset - 1], opcode = code[offset - 2];
+	const unsigned number = ((mr >> 3) & 7) | ((rex & 4) << 1);
+	const unsigned mod = mr >> 6, rm = mr & 7;
+	const bool rip = !mod && rm == 5, sib = rm == 4;
+	const unsigned disp_size = mod == 2 || rip ? 4 : mod;
+	const unsigned disp_offset = offset + sib,
+		       length = disp_offset + disp_size;
+	if (size < length || (sib && ((rex & 2) || code[offset] != 0x24)))
+		return false;
+	const int32_t disp = disp_size == 4 ?
+				     X86_readDisp32(code + disp_offset) :
+			     disp_size == 1 ? (int8_t)code[disp_offset] :
+					      0;
+	const struct X86SimpleRegister *base =
+		&x86_simple_registers[3][((rex & 1) << 3) | rm];
+	const struct X86SimpleOutput *row = &entry->output;
+	insn->size = *insn_size = (uint16_t)length;
+	insn->id = row->id;
+	memcpy(insn->bytes, code, insn->size);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	const unsigned ll = vex && (code[1] & 4);
+	char *out = insn->op_str;
+	if (!entry->reverse) {
+		out = writeVectorRegister(out, ll, number);
+		memcpy(out, ", ", 2);
+		out += 2;
+	}
+#ifdef X86_LEGACY_PACKED_MEMORY
+	const unsigned width = row->ops[entry->reverse ? 0 : 1].size;
+	if (width < 16) {
+		memcpy(out, "dword ptr [", 11);
+		if (width == 8)
+			*out = 'q';
+		out += 11;
+	} else {
+		memcpy(out, "xmmword ptr [", 13);
+		out += 13;
+	}
+#else
+	memcpy(out, "xmmword ptr [", 13);
+	if (ll)
+		*out = 'y';
+	out += 13;
+#endif
+	if (rip) {
+		memcpy(out, "rip", 3);
+		out += 3;
+	} else {
+		memcpy(out, base->name, base->length);
+		out += base->length;
+	}
+	out = X86_writeDisplacement(out, disp);
+	*out++ = ']';
+	if (entry->reverse) {
+		memcpy(out, ", ", 2);
+		writeVectorRegister(out + 2, ll, number);
+	}
+	if (insn->detail) {
+		const uint16_t reg =
+			(uint16_t)((ll ? X86_REG_YMM0 : X86_REG_XMM0) + number);
+		X86_writeSimpleDetail(insn->detail, row, 0x0f, rex, mr,
+				      entry->reverse ? 0 : reg,
+				      entry->reverse ? reg : 0);
+		cs_x86 *x = &insn->detail->x86;
+		if (vex) {
+			memcpy(x->opcode, code, 2);
+		} else {
+			x->opcode[1] = opcode;
+#ifdef X86_LEGACY_PACKED_MEMORY
+			if (code[0] == 0x66)
+				x->prefix[2] = 0x66;
+#endif
+		}
+		x->encoding.modrm_offset = (uint8_t)(offset - 1);
+		if (disp_size) {
+			x->encoding.disp_offset = (uint8_t)disp_offset;
+			x->encoding.disp_size = (uint8_t)disp_size;
+		}
+		if (sib) {
+			x->sib = 0x24;
+			x->sib_base = (x86_reg)base->reg;
+			x->sib_scale = 1;
+		}
+		x->disp = disp;
+		cs_x86_op *op = &x->operands[entry->reverse ? 0 : 1];
+		op->type = X86_OP_MEM;
+		op->mem.base = rip ? X86_REG_RIP : (x86_reg)base->reg;
+		op->mem.scale = 1;
+		op->mem.disp = disp;
+	}
+	return true;
+}
+
+#endif
diff --git a/arch/X86/X86RegisterImmediateOutput.h b/arch/X86/X86RegisterImmediateOutput.h
new file mode 100644
index 00000000..f06c42e9
--- /dev/null
+++ b/arch/X86/X86RegisterImmediateOutput.h
@@ -0,0 +1,80 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_REGISTER_IMMEDIATE_OUTPUT_H
+#define CS_X86_REGISTER_IMMEDIATE_OUTPUT_H
+
+#include "X86SimpleOutput.h"
+#include "X86OutputOptions.h"
+#include "X86UnsignedImmediate.h"
+
+/* MOV opcode-register and TEST ModR/M-register forms have unsigned immediates.
+ * A register-direct ModR/M byte always has its top two bits set. */
+static inline void writeUnsignedRegisterImmediate(
+	cs_insn *insn, const struct X86SimpleOutput *row,
+	const struct X86SimpleRegister *reg, const uint8_t *code, uint8_t rex,
+	uint8_t modrm, unsigned offset, unsigned imm_size, uint16_t *insn_size)
+{
+	const uint32_t value = imm_size == 1 ?
+				       code[offset] :
+				       (uint32_t)X86_readDisp32(code + offset);
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)(offset + imm_size);
+	memcpy(insn->bytes, code, insn->size);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, reg->name, sizeof(reg->name));
+	char *out = insn->op_str + reg->length;
+	memcpy(out, ", ", 2);
+	writeUnsignedImmediate(out + 2, value);
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, code[rex != 0], rex,
+				      modrm, reg->reg, 0);
+		cs_x86 *x = &insn->detail->x86;
+		x->encoding.modrm_offset = modrm ? (uint8_t)(offset - 1) : 0;
+		x->encoding.imm_offset = (uint8_t)offset;
+		x->encoding.imm_size = (uint8_t)imm_size;
+		x->operands[1].type = X86_OP_IMM;
+		x->operands[1].imm = value;
+		x->operands[1].access = 0;
+	}
+}
+
+/* The accumulator opcodes and MOV r8, imm8 have no ModR/M. Their operand
+ * widths, register access and flags come from the corresponding ordinary row.
+ * A word or qword immediate has different extension and printing rules. */
+static inline bool
+writeOpcodeRegisterImmediate(cs_struct *handle, const uint8_t *code,
+			     size_t size, cs_insn *insn, uint16_t *insn_size,
+			     bool wide, const uint16_t plans[4][256],
+			     const struct X86SimpleOutput *rows,
+			     const struct X86SimpleRegister regs[4][16])
+{
+	const uint8_t rex = wide && (code[0] & 0xf0) == 0x40 ? code[0] : 0;
+	const unsigned lead = rex != 0;
+	if (size < lead + 2)
+		return false;
+	const uint8_t opcode = code[lead];
+	const bool mov = (opcode & 0xf8) == 0xb0;
+	const bool accumulator = (opcode & 0xc6) == 4;
+	if (!mov && !accumulator && (opcode & 0xfe) != 0xa8)
+		return false;
+	const bool byte = mov || !(opcode & 1);
+	if ((!byte && ((rex & 8) || size < lead + 5)) ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	const unsigned reg_opcode = mov		? 0x8a :
+				    accumulator ? opcode & 0x39 :
+						  0x84 | (opcode & 1);
+	const unsigned prefix = lead ? 1 + ((rex >> 3) & 1) : 0;
+	const unsigned number = mov ? ((rex & 1) << 3) | (opcode & 7) : 0;
+	const struct X86SimpleRegister *reg = &regs[byte ? lead : 2][number];
+	writeUnsignedRegisterImmediate(insn,
+				       &rows[plans[prefix][reg_opcode] >> 2],
+				       reg, code, rex, 0, lead + 1,
+				       byte ? 1 : 4, insn_size);
+	return true;
+}
+
+#endif
diff --git a/arch/X86/X86RoundedRegisterPlan.h b/arch/X86/X86RoundedRegisterPlan.h
new file mode 100644
index 00000000..bef63a97
--- /dev/null
+++ b/arch/X86/X86RoundedRegisterPlan.h
@@ -0,0 +1,19 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_ROUNDED_REGISTER_PLAN_H
+#define CS_X86_ROUNDED_REGISTER_PLAN_H
+#include "X86GenRoundedRegister64.inc"
+
+/* Bare EVEX.b, a register ModR/M and six input bytes were checked by the
+ * caller. The ordinary decoder verifies every register and rounding mode
+ * represented by the generated row. */
+static inline unsigned X86_roundedRegisterRow(const uint8_t *code)
+{
+	const unsigned map = code[1] & 15, flags = code[2];
+	if (map < 1 || map > 3 || !(flags & 4) || (code[3] & 0x87))
+		return 0;
+	const unsigned prefix = evex_rounded_plans[map - 1][code[4]];
+	return evex_rounded_prefixes[prefix][(flags >> 7) * 4 + (flags & 3)];
+}
+#endif
