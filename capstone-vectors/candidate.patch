+// Packed FMA3 has six operations in each operand order. VEX.W selects the
+// element type. Both vector widths must have the same public instruction row.
+void print_vex_fma_memory(
+	const std::vector<std::string> &rows, const std::vector<Bytes4> &widths,
+	const std::array<std::array<unsigned, 256>, 3> &plans)
+{
+	std::array<unsigned, 256> opcodes{};
+	unsigned index = 0;
+	std::puts("static const struct VectorOutputRow vex_fma_rows[][2] = {");
+	for (unsigned order : { 0x90u, 0xa0u, 0xb0u }) {
+		for (unsigned operation : { 6u, 7u, 8u, 10u, 12u, 14u }) {
+			const unsigned opcode = order | operation;
+			const auto &w = widths.at(plans[1][opcode]);
+			if (!w[0] || !w[2] || w[0] != w[1] || w[2] != w[3])
+				throw std::runtime_error("nonuniform packed FMA memory row");
+			opcodes[opcode] = ++index;
+			std::printf("\t{ %s, %s },\n", rows.at(w[0] - 1).c_str(),
+				    rows.at(w[2] - 1).c_str());
+		}
+	}
+	std::puts("};\nstatic const uint8_t vex_fma_opcodes[256] = {");
+	for (unsigned i = 0; i < opcodes.size(); i += 16) {
+		std::putchar('\t');
+		for (unsigned j = 0; j < 16; ++j)
+			std::printf("%s%u,", j ? " " : "", opcodes[i + j]);
+		std::putchar('\n');
+	}
+	std::puts("};");
+}
+
 void emit_vex_base_memory(Decoder &decoder)
 {
 	std::vector<std::string> rows;
@@ -2241,7 +2271,11 @@ void emit_vex_base_memory(Decoder &decoder)
 	if (!plans[0][0xfe] || !plans[1][0xa8])
 		throw std::runtime_error("missing VEX integer or FMA memory form");
 	std::puts("/* Generated by suite/synctools/x86_vector_output.cpp --vex-base-memory. */");
+	std::puts("#ifdef X86_PACKED_FMA_MEMORY");
+	print_vex_fma_memory(rows, widths, plans);
+	std::puts("#else");
 	print_vex_tables("vex_base", rows, widths, plans);
+	std::puts("#endif");
 	std::fprintf(stderr, "%u VEX memory forms, %zu rows and %zu prefix plans\n",
 		     admitted, rows.size(), widths.size() - 1);
 }
