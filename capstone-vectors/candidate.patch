+#if defined(CAPSTONE_HAS_X86) && !defined(CAPSTONE_DIET) && defined(__GNUC__) && \
+	defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+#define CS_X86_WORD_MNEMONIC
+/* For a complete short Intel mnemonic, copy the bytes before the first
+ * separator and clear the remainder of the word in the same store. */
+static inline bool copy_short_x86_mnemonic(char *dst, const SStream *stream,
+					  size_t *end)
+{
+	if (stream->index < sizeof(uint32_t) - 1)
+		return false;
+	uint32_t text;
+	memcpy(&text, stream->buffer, sizeof(text));
+	const uint32_t lanes = UINT32_C(0x01010101);
+	const uint32_t high = lanes * 0x80;
+	/* The least set lane is the first byte below 33. Later lanes may
+	 * also be set by a borrow, which cannot change that position. */
+	const uint32_t separators = (text - lanes * 33) & ~text & high;
+	if (!separators)
+		return false;
+	const unsigned pos = __builtin_ctz(separators) / 8;
+	const char separator = stream->buffer[pos];
+	if (separator && separator != ' ' && separator != '\t')
+		return false;
+	const uint32_t mask = ((separators & -separators) >> 7) - 1;
+	const uint32_t bars = text ^ (lanes * '|');
+	if (((bars - lanes) & ~bars & high) & mask)
+		return false;
+	text &= mask;
+	memcpy(dst, &text, sizeof(text));
+	*end = pos;
+	return true;
+}
+#endif
