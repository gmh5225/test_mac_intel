diff --git a/arch/X86/X86Vex32Output.c b/arch/X86/X86Vex32Output.c
new file mode 100644
index 00000000..1a445604
--- /dev/null
+++ b/arch/X86/X86Vex32Output.c
@@ -0,0 +1,68 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#if defined(CAPSTONE_HAS_X86) && defined(__clang__)
+#include "../../cs_priv.h"
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#include "X86SimpleOutput.h"
+
+#if defined(__ELF__)
+#define X86_VEX32_OUTPUT_CODE \
+	__attribute__((noinline, section(".cs_x86_vex32_output")))
+#elif defined(__APPLE__)
+#define X86_VEX32_OUTPUT_CODE \
+	__attribute__(( \
+		noinline, \
+		section("__TEXT,__x86_vex32,regular,pure_instructions")))
+#else
+#define X86_VEX32_OUTPUT_CODE __attribute__((noinline))
+#endif
+
+X86_VEX32_OUTPUT_CODE
+static bool writeVex32Output(const uint8_t *code, size_t size, cs_insn *insn,
+			     uint16_t *insn_size,
+			     const struct X86SimpleRegister *regs, bool wide)
+{
+	(void)regs;
+	(void)wide;
+	const unsigned prefix = code[0] == 0xc5 ? 2 : 3;
+	/* LDS/LES, memory forms, extended registers and W=1 retain the
+     * canonical reader. The admitted rows use only XMM/YMM0..7. */
+	if (size < prefix + 2 || code[prefix + 1] < 0xc0 ||
+	    (prefix == 2 ?
+		     (code[1] & 0xc0) != 0xc0 :
+		     (code[1] & 0xe0) != 0xe0 || (code[2] & 0xc0) != 0x40))
+		return false;
+	if (!X86_writeVectorOutput(code, size, insn, insn_size, NULL, true))
+		return false;
+	if (insn->detail) {
+		insn->detail->x86.rex = 0;
+		insn->detail->x86.addr_size = 4;
+	}
+	return true;
+}
+
+/* Options and exact 32/64-bit mode were checked by the original plan entry. */
+X86_VEX32_OUTPUT_CODE
+bool X86_writeVectorOutputDispatch(const uint8_t *code, size_t size,
+				   cs_insn *insn, uint16_t *insn_size,
+				   const struct X86SimpleRegister *regs,
+				   bool wide)
+{
+	if (wide || (code[0] & 0xfe) != 0xc4) {
+#if __has_attribute(musttail)
+		__attribute__((musttail))
+#endif
+		return X86_writeVectorOutput(code, size, insn, insn_size, regs,
+					     wide);
+	}
+#if __has_attribute(musttail)
+	__attribute__((musttail))
+#endif
+	return writeVex32Output(code, size, insn, insn_size, regs, wide);
+}
+#endif
+#endif
