+#ifdef X86_EVEX_REGISTER_SCAN
+/* Keep projection state out of the shared C4 and legacy fallback frame. */
+__attribute__((noinline,
+	       section(".cs_x86_evex_result_text"))) static CS_PRESERVE_MOST bool
+decodeEvexScanResult(csh ud, const uint8_t *code, size_t code_len,
+		     cs_insn *insn, X86ScanResult *result, uint8_t opcode,
+		     bool tryExtension)
+{
+	const cs_struct *handle = (const cs_struct *)(uintptr_t)ud;
