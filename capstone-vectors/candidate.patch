+	    count == x86->op_count) {
+		x86->operands[count - 2].access = access[0];
+		x86->operands[count - 1].access = access[1];
 	}
-	x86->operands[access_index++].access = arr[0];
-	x86->operands[access_index].access = arr[1];
 }
 
