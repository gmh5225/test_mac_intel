+	std::cout << "/* Generated by x86_simple_output.cpp --inc-dec64. */\n"
+		     "static const struct X86SimpleOutput x86_inc_dec64[3][4] = {\n";
+	for (unsigned prefix = 0; prefix < 3; ++prefix) {
+		std::cout << "\t{\n";
+		const unsigned first = prefix == 2 ? 0x48 : prefix == 1 ? 0x40 : 0;
+		const unsigned last = prefix ? first + 7 : 0;
+		for (uint8_t opcode : { 0xfe, 0xff }) {
+			for (unsigned group : { 0u, 1u }) {
+				CheckedRow row;
