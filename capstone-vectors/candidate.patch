+
+/* The caller has identified a single segment prefix on a dword memory form. */
+bool X86_writeSegmentMemory32(cs_struct *handle,
+			const uint8_t *code, size_t size, cs_insn *insn,
+			uint16_t *insn_size)
+{
+	if (!tryOutput32(handle, code + 1, size - 1, insn, insn_size))
+		return false;
+	static const struct {
+		x86_reg reg;
+		char prefix[3];
+	} segments[] = {
+		{ X86_REG_ES, "es:" }, { X86_REG_CS, "cs:" },
+		{ X86_REG_SS, "ss:" }, { X86_REG_DS, "ds:" },
+		{ X86_REG_FS, "fs:" }, { X86_REG_GS, "gs:" },
+	};
+	const unsigned segment = code[0] >= 0x64 ? 4 + (code[0] & 1) :
+						   (code[0] >> 3) & 3;
+	/* A memory record always has one bracketed address. */
+	char *address = strchr(insn->op_str, '[');
+	memmove(address + 3, address, strlen(address) + 1);
+	memcpy(address, segments[segment].prefix, 3);
+	*insn_size = ++insn->size;
+	memcpy(insn->bytes, code, *insn_size);
+	if (insn->detail) {
+		cs_x86 *x = &insn->detail->x86;
+		x->prefix[1] = code[0];
+		++x->encoding.modrm_offset;
+		if (x->encoding.disp_size)
+			++x->encoding.disp_offset;
+		x->operands[code[1] != 0x89].mem.segment = segments[segment].reg;
+	}
+	return true;
+}
 #endif
 
