diff --git a/arch/X86/X86MemoryFallback32.c b/arch/X86/X86MemoryFallback32.c
index cffc4e81..05b7fb5d 100644
--- a/arch/X86/X86MemoryFallback32.c
+++ b/arch/X86/X86MemoryFallback32.c
@@ -13,6 +13,7 @@
 	!defined(_WIN32_WCE)
 #include "X86OutputOptions.h"
 #include "X86SimpleOutput.h"
+#include "X86RegisterImmediateOutput.h"
 #include "X86VectorRegisterOutput.h"
 #define X86_VEX32_REGISTER_MOVES
 #include "X86GenVex32MemoryOutput.inc"
@@ -97,5 +98,32 @@ X86_decodeOutputMiss32(cs_struct *handle, const uint8_t *code, size_t size,
 	}
 	return X86_decodeRegisterFallback32(handle, code, size, insn, insn_size, batch);
 }
+
+/* A bare ALU accumulator opcode names AL or EAX itself. Its register-pair
+ * row supplies the effect on the destination, flags and implicit registers. */
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_accumulator32_text"
+#endif
+CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
+X86_decodeAccumulatorFallback32(cs_struct *handle, const uint8_t *code, size_t size,
+				cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+	const unsigned opcode = code[0];
+	if (opcode == 0x05 || opcode == 0x25 || (opcode & 0xfe) == 0x3c) {
+		const unsigned wide = opcode & 1;
+		const unsigned width = wide ? 4 : 1;
+		if (size >= 1 + width && !X86_OUTPUT_UNSUPPORTED(handle, false)) {
+			const unsigned pair = opcode & 0x39;
+			const unsigned row = x86_simple_plans[0][0][pair] >> 2;
+			writeUnsignedRegisterImmediate(
+				insn, &x86_simple_outputs[row],
+				&x86_simple_registers[wide ? 2 : 0][0], code,
+				0, 0, 1, width, insn_size);
+			return true;
+		}
+	}
+	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
+}
+
 #endif
 #endif
