@@ -12045,6 +12028,59 @@ void X86_reg_access(const cs_insn *insn, cs_regs regs_read,
 	*regs_read_count = read_count;
 	*regs_write_count = write_count;
 }
+
+void X86_reg_access(const cs_insn *insn, cs_regs regs_read,
+		    uint8_t *regs_read_count, cs_regs regs_write,
+		    uint8_t *regs_write_count)
+{
+	uint8_t read_count, write_count;
+	cs_x86 *x86 = &(insn->detail->x86);
+
+	read_count = insn->detail->regs_read_count;
+	write_count = insn->detail->regs_write_count;
+
+	// implicit registers
+	if (read_count == 1)
+		regs_read[0] = insn->detail->regs_read[0];
+	else if (read_count != 0)
+		memcpy(regs_read, insn->detail->regs_read,
+		       read_count * sizeof(insn->detail->regs_read[0]));
+	if (write_count == 1)
+		regs_write[0] = insn->detail->regs_write[0];
+	else if (write_count != 0)
+		memcpy(regs_write, insn->detail->regs_write,
+		       write_count * sizeof(insn->detail->regs_write[0]));
+
+	appendExplicitRegisters(x86, regs_read, read_count, regs_read_count,
+				regs_write, write_count, regs_write_count);
+}
+
+#ifdef CAPSTONE_X86_SHORT_REG_LISTS
+/* Keep the uncommon variable-length copies outside the short-list callback. */
+#if defined(__ELF__) && defined(__clang__)
+__attribute__((section(".cs_x86_short_reg_access")))
+#endif
+void X86_reg_access_short(const cs_insn *insn, cs_regs regs_read,
+		    uint8_t *regs_read_count, cs_regs regs_write,
+		    uint8_t *regs_write_count)
+{
+	const cs_detail *d = insn->detail;
+	const uint8_t read_count = d->regs_read_count;
+	const uint8_t write_count = d->regs_write_count;
+	if (read_count > 1 || write_count > 1) {
+		X86_reg_access(insn, regs_read, regs_read_count, regs_write,
+			       regs_write_count);
+		return;
+	}
+	if (read_count)
+		regs_read[0] = d->regs_read[0];
+	if (write_count)
+		regs_write[0] = d->regs_write[0];
+	appendExplicitRegisters(&d->x86, regs_read, read_count, regs_read_count,
+				regs_write, write_count, regs_write_count);
+}
+#endif
+
 #endif
 
