+					   unsigned prefix, cs_insn *insn,
+					   uint16_t *insn_size,
+					   const struct X86SimpleRegister *regs)
+{
+	const unsigned map = prefix == 2 ? 1 : code[1] & 31;
+	const unsigned flags = code[prefix - 1];
+	if (map < 1 || map > 3 || (flags & 3) != 1)
