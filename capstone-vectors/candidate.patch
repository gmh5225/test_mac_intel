+					const auto &names = regs[register_class(opcode, rex)];
+					for (unsigned rm = 0; rm < 8; ++rm) {
+						const uint8_t mr = uint8_t(0xc0 | group << 3 | rm);
+						observe_group_register(decoder, row, opcode, uint8_t(rex), mr,
+							group ? X86_INS_DEC : X86_INS_INC,
+							names[(rex & 1) << 3 | rm]);
+					}
+				}
+				std::cout << "\t\t" << row.fields << ",\n";
+			}
+		}
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+}
