+/* An absolute displacement is an offset of the effective address width. */
+uint64_t X86_absoluteAddress(const MCInst *mi, int64_t disp)
+{
+	const cs_mode mode = mi->csh->mode;
+	const bool address_override = mi->x86_prefix[3] == X86_PREFIX_ADDRSIZE;
+	if (x86_has_feature(mode, CS_MODE_16))
+		return address_override ? (uint32_t)disp : (uint16_t)disp;
+	if (x86_has_feature(mode, CS_MODE_32))
+		return address_override ? (uint16_t)disp : (uint32_t)disp;
+	return address_override ? (uint32_t)disp : (uint64_t)disp;
+}
