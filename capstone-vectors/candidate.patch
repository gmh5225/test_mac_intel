+// Ordinary packed single-precision register operations share one record across
+// both vector lengths. Verify register order, operand sizes, groups and text
+// with the full decoder before admitting an opcode.
+void emit_vex_packed_single(Decoder &decoder)
+{
+	Decoder decoder32(CS_MODE_32);
+	std::puts("/* Generated by x86_vector_output.cpp --vex-packed-single. */");
+	std::puts("static const struct VectorOutputRow vex_packed_single_rows[] = {");
+	for (unsigned opcode = 0x54; opcode <= 0x5f; ++opcode) {
+		// 5A and 5B convert data between types and have two operands.
+		if (opcode == 0x5a || opcode == 0x5b) {
+			std::puts("\t{ 0 },");
+			continue;
+		}
+		const auto row = vex_register_row(decoder, 1, opcode, 0, 0, 0,
+						  0, 0, 0, false, false, 0,
+						  false, false, 0);
+		if (row.empty())
+			throw std::runtime_error("missing VEX packed single record");
+		for (unsigned encoding = 0; encoding < 32768; ++encoding) {
+			const unsigned rm = encoding & 7, src = (encoding >> 3) & 15;
+			const unsigned dst = (encoding >> 7) & 7;
+			const unsigned rxb = (encoding >> 10) & 7;
+			const unsigned ll = (encoding >> 13) & 1, w = encoding >> 14;
+			auto check = [&](Decoder &d, bool short_prefix, bool mode32) {
+				if (vex_register_row(d, 1, opcode, w, ll, rxb, dst,
+						     src, rm, short_prefix, false, 0,
+						     false, mode32, 0) != row)
+					throw std::runtime_error("inconsistent VEX packed single record");
+			};
+			check(decoder, false, false);
+			if (!w && !(rxb & 3))
+				check(decoder, true, false);
+			if (!w && !rxb && src < 8) {
+				check(decoder32, false, true);
+				check(decoder32, true, true);
+			}
+		}
+		std::printf("\t%s,\n", row.c_str());
+	}
+	std::puts("};");
+}
