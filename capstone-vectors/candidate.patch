diff --git a/arch/X86/X86OutputOptions.h b/arch/X86/X86OutputOptions.h
index 62d4288a..97a7cb20 100644
--- a/arch/X86/X86OutputOptions.h
+++ b/arch/X86/X86OutputOptions.h
@@ -27,6 +27,13 @@ CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
 X86_decodeOutputMiss64(cs_struct *handle, const uint8_t *code, size_t size,
 			cs_insn *insn, uint16_t *insn_size, bool batch);
 
+/* The AMD64 iterator exhausted its vector writers and has one input byte. */
+#ifdef CAPSTONE_X86_ONLY
+CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
+X86_decodeScalarMemory64(cs_struct *handle, const uint8_t *code, size_t size,
+			 cs_insn *insn, uint16_t *insn_size, bool batch);
+#endif
+
 /* Keep the mode, option and callback checks in a single short-circuit chain
  * in both instantiations of the scalar writer. */
 #define X86_OUTPUT_UNSUPPORTED(handle, mode_mismatch) \
diff --git a/arch/X86/X86VectorFallback64.c b/arch/X86/X86VectorFallback64.c
index 504682a4..0370f13c 100644
--- a/arch/X86/X86VectorFallback64.c
+++ b/arch/X86/X86VectorFallback64.c
@@ -248,10 +248,68 @@ fallback:
 	 * EVEX register-rounding override can decline before that writer. */
 	if (!(size >= 6 && code[0] == 0x62 && code[5] >= 0xc0 &&
 	      (code[3] & 0x10)))
+#ifdef CAPSTONE_X86_ONLY
+		return X86_decodeScalarMemory64(handle, code, size, insn,
+						insn_size, batch);
+#else
 		return cs_decode_full_insn_body(handle, code, size, insn,
 						insn_size, batch);
+#endif
+#elif defined(CAPSTONE_X86_ONLY)
+	return X86_decodeScalarMemory64(handle, code, size, insn, insn_size,
+					batch);
 #endif
 	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
 }
+#ifdef CAPSTONE_X86_ONLY
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_scalar_memory64_text" rodata = \
+	".cs_x86_scalar_memory64_rodata"
+#endif
+#include "X86GenIndirect64Output.inc"
+#define X86_MEMORY_IMMEDIATE writeMemoryImmediate64
+#define X86_IMMEDIATE_WIDE 1
+#include "X86MemoryOutputImpl.h"
+#undef X86_IMMEDIATE_WIDE
+#undef X86_MEMORY_IMMEDIATE
+
+/* Byte CMP/TEST and near indirect CALL/JMP use the same ModRM address
+ * and detail writers as the other scalar memory forms. */
+CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
+X86_decodeScalarMemory64(cs_struct *handle, const uint8_t *code, size_t size,
+			 cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+	const unsigned lead = (code[0] & 0xf0) == 0x40;
+	if (size >= lead + 2) {
+		const uint8_t opcode = code[lead];
+		const uint8_t mr = code[lead + 1];
+		const unsigned group = (mr >> 3) & 7;
+		if (mr < 0xc0 && ((opcode == 0x80 && group == 7) ||
+				  (opcode == 0xf6 && group == 0))) {
+			const unsigned form = opcode == 0x80 ? 0x38 : 0x84;
+			const unsigned row = x86_simple_plans[1][lead][form] >> 2;
+			if (!X86_OUTPUT_UNSUPPORTED(handle, false) &&
+			    writeMemoryImmediate64(code, size, insn, insn_size,
+						   &x86_simple_outputs[row],
+						   x86_simple_registers))
+				return true;
+		} else if (mr < 0xc0 && opcode == 0xff &&
+			   (group == 2 || group == 4) &&
+			   !X86_OUTPUT_UNSUPPORTED(handle, false) &&
+			   X86_writeMemoryOutput(code, size, insn, insn_size,
+						 &x86_indirect64[lead][group == 4],
+						 x86_simple_registers)) {
+			return true;
+		}
+	}
+#if defined(CAPSTONE_X86_DEDICATED_OUTPUT) && defined(__clang__) && \
+	defined(__x86_64__)
+	return cs_decode_full_insn_body(handle, code, size, insn, insn_size,
+					batch);
+#else
+	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
+#endif
+}
+#endif
 #endif
 #endif
