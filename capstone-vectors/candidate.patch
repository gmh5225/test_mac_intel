diff --git a/CMakeLists.txt b/CMakeLists.txt
index a2a27faf..f338b97a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1088,10 +1088,11 @@ if(capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV"
    AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|aarch64|arm64|ARM64)$")
     target_compile_definitions(capstone_build_settings INTERFACE
         "$<$<CONFIG:Release>:CAPSTONE_X86_COMPACT_SCALAR_ROWS>")
-    # Use the bounded masked-operand copies in the measured x86-64 static reader.
+    # Enable the measured masked and VEX3 memory writers in the x86-64 static reader.
     if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
         set_property(SOURCE arch/X86/X86VectorFallback64.c APPEND PROPERTY
-            COMPILE_DEFINITIONS "$<$<CONFIG:Release>:X86_FIXED_MASKED_SUFFIX>")
+            COMPILE_DEFINITIONS "$<$<CONFIG:Release>:X86_FIXED_MASKED_SUFFIX>"
+                                "$<$<CONFIG:Release>:X86_FIXED_VEX3_MEMORY>")
     endif()
 endif()
 add_library(capstone OBJECT ${ALL_SOURCES} ${capstone_storage_source} ${capstone_arm_char_source} ${ALL_HEADERS})
diff --git a/arch/X86/X86VectorFallback64.c b/arch/X86/X86VectorFallback64.c
index bc67e4c3..9a589082 100644
--- a/arch/X86/X86VectorFallback64.c
+++ b/arch/X86/X86VectorFallback64.c
@@ -168,6 +168,11 @@ static bool writeMaskedByteMove(cs_struct *handle, const uint8_t *code,
 }
 #endif
 
+#ifdef X86_FIXED_VEX3_MEMORY
+static bool writeVex3Output64(cs_struct *handle, const uint8_t *code,
+			      size_t size, cs_insn *insn, uint16_t *insn_size);
+#endif
+
 /* The fixed-width AMD64 iterator has already tried its common records. */
 CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
 X86_decodeOutputMiss64(cs_struct *handle, const uint8_t *code, size_t size,
@@ -212,9 +217,14 @@ X86_decodeOutputMiss64(cs_struct *handle, const uint8_t *code, size_t size,
 	if (size >= 10 && code[0] == 0x62 && (code[5] & 0xc7) == 5 &&
 	    X86_writeEvexRipMemory(handle, code, insn, insn_size))
 		return true;
+#ifdef X86_FIXED_VEX3_MEMORY
+	if (code[0] == 0xc4 &&
+	    writeVex3Output64(handle, code, size, insn, insn_size))
+#else
 	if (code[0] == 0xc4 &&
 	    X86_writeVexRegisterImmediate(handle, code, size, insn, insn_size,
 					  x86_simple_registers, true))
+#endif
 		return true;
 	if (size >= 4 && (code[0] == 0x66 || (code[0] & 0xfe) == 0xf2)) {
 		const uint8_t rex = (code[1] & 0xf0) == 0x40 ? code[1] : 0;
@@ -269,5 +279,27 @@ fallback:
 #endif
 	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
 }
+
+#ifdef X86_FIXED_VEX3_MEMORY
+/* Keep the memory tables in the fixed AMD64 fallback, outside the shared
+ * register-immediate handler used by the 32-bit iterator. */
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_vex64_memory_text" rodata = \
+	".cs_x86_vex64_memory_rodata"
+#endif
+#include "X86VexBaseMemory.h"
+
+static bool writeVex3Output64(cs_struct *handle, const uint8_t *code,
+			      size_t size, cs_insn *insn, uint16_t *insn_size)
+{
+	if (size >= 5 && code[4] < 0xc0)
+		return !X86_OUTPUT_UNSUPPORTED(handle, false) &&
+		       writeVexBaseMemory(code, size, 3, insn, insn_size,
+					  x86_simple_registers[3]);
+	return X86_writeVexRegisterImmediate(handle, code, size, insn, insn_size,
+					     x86_simple_registers, true);
+}
+#endif
+
 #endif
 #endif
