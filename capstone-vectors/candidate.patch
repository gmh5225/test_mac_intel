diff --git a/arch/X86/X86VectorFallback64.c b/arch/X86/X86VectorFallback64.c
index bc67e4c3..dd476f2e 100644
--- a/arch/X86/X86VectorFallback64.c
+++ b/arch/X86/X86VectorFallback64.c
@@ -212,9 +212,15 @@ X86_decodeOutputMiss64(cs_struct *handle, const uint8_t *code, size_t size,
 	if (size >= 10 && code[0] == 0x62 && (code[5] & 0xc7) == 5 &&
 	    X86_writeEvexRipMemory(handle, code, insn, insn_size))
 		return true;
+#ifdef X86_FIXED_VEX3_MEMORY
+	if (code[0] == 0xc4 &&
+	    X86_writeVex3MemoryOrImmediate64(handle, code, size, insn, insn_size,
+					     x86_simple_registers, true))
+#else
 	if (code[0] == 0xc4 &&
 	    X86_writeVexRegisterImmediate(handle, code, size, insn, insn_size,
 					  x86_simple_registers, true))
+#endif
 		return true;
 	if (size >= 4 && (code[0] == 0x66 || (code[0] & 0xfe) == 0xf2)) {
 		const uint8_t rex = (code[1] & 0xf0) == 0x40 ? code[1] : 0;
@@ -269,5 +275,25 @@ fallback:
 #endif
 	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
 }
+#ifdef X86_FIXED_VEX3_MEMORY
+#pragma clang section text = ".cs_x86_vex64_memory_text" rodata = \
+	".cs_x86_vex64_memory_rodata"
+#include "X86VexBaseMemory.h"
+
+/* The fixed AMD64 caller forwards its register table to either writer. */
+CAPSTONE_INTERNAL __attribute__((noinline)) bool
+X86_writeVex3MemoryOrImmediate64(cs_struct *handle, const uint8_t *code,
+			      size_t size, cs_insn *insn, uint16_t *insn_size,
+			      const struct X86SimpleRegister regs[4][16],
+			      bool wide)
+{
+	if (size >= 5 && code[4] < 0xc0)
+		return !X86_OUTPUT_UNSUPPORTED(handle, false) &&
+		       writeVexBaseMemory(code, size, 3, insn, insn_size, regs[3]);
+	return X86_writeVexRegisterImmediate(handle, code, size, insn, insn_size,
+					     regs, wide);
+}
+#endif
+
 #endif
 #endif
