 						 unsigned int instruction_id)
 {
@@ -12800,7 +12743,6 @@ void X86_postprinter(csh handle, cs_insn *insn, SStream *mnem, MCInst *mci)
 
 	if (!insn)
 		return;
-	repair_vpcmp_id(insn, mnem, mci);
 	if (!insn->detail)
 		return;
 
