+// A group opcode supplies every field except the explicit register.
+void observe_group_register(Decoder &decoder, CheckedRow &row,
+                            uint8_t opcode, uint8_t rex, uint8_t modrm,
+                            unsigned id, const X86SimpleRegister &reg)
+{
+	decode_pair(decoder, rex, opcode, modrm);
+	cs_insn insn = *decoder.insn;
+	cs_detail detail = *insn.detail;
+	insn.detail = &detail;
+	auto &op = detail.x86.operands[0];
+	if (insn.id != id || detail.x86.op_count != 1 || op.type != X86_OP_REG ||
+	    unsigned(op.reg) != reg.reg || std::strcmp(insn.op_str, reg.name))
+		throw std::runtime_error("unexpected group register operand");
+	op.reg = X86_REG_INVALID;
+	insn.op_str[0] = 0;
+	row.observe(describe(insn, opcode, rex, modrm, nullptr, nullptr));
+}
+
+void emit_inc_dec64(Decoder &decoder, const RegisterTable &regs)
