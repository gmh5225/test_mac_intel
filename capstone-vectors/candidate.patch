diff --git a/arch/X86/X86Sse64Output.c b/arch/X86/X86Sse64Output.c
index 7afca7e4..8f27e8d9 100644
--- a/arch/X86/X86Sse64Output.c
+++ b/arch/X86/X86Sse64Output.c
@@ -159,6 +159,20 @@ static bool writeExtraOutput64(cs_struct *handle, const uint8_t *code,
 	}
 	if (primary != 0x0f) {
 		const uint8_t mr = code[has_rex + 1];
+#ifdef CAPSTONE_X86_ONLY
+		if ((primary == 0x80 && (mr & 0x38) == 0x38) ||
+		    (primary == 0xf6 && !(mr & 0x38))) {
+			if (mr >= 0xc0 || X86_OUTPUT_UNSUPPORTED(handle, false))
+				return false;
+			/* Byte CMP and TEST ignore REX.W. Any REX shifts the
+			 * ModRM offset by one, as in the register/memory row. */
+			const unsigned form = primary == 0x80 ? 0x38 : 0x84;
+			const unsigned row = x86_simple_plans[1][has_rex][form] >> 2;
+			return writeMemoryImmediate64(code, size, insn, insn_size,
+						      &x86_simple_outputs[row],
+						      x86_simple_registers);
+		}
+#endif
 		if ((primary & 0xfe) != 0xc6 || mr >= 0xc0 || (mr & 0x38) ||
 		    X86_OUTPUT_UNSUPPORTED(handle, false))
 			return false;
