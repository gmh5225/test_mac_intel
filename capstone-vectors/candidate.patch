diff --git a/arch/X86/X86VectorModeOutput.c b/arch/X86/X86VectorModeOutput.c
new file mode 100644
index 00000000..bec7c6cb
--- /dev/null
+++ b/arch/X86/X86VectorModeOutput.c
@@ -0,0 +1,40 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "../../cs_priv.h"
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#include "X86SimpleOutput.h"
+
+/* Keep mode selection outside the existing vector reader and its helpers. */
+#if defined(__ELF__) && defined(__GNUC__)
+__attribute__((section(".cs_x86_vector_mode")))
+#endif
+bool X86_writeVectorOutput(const uint8_t *code, size_t size, cs_insn *insn,
+			   uint16_t *insn_size,
+			   const struct X86SimpleRegister *regs, bool wide)
+{
+	if (wide || (code[0] & 0xfe) != 0xc4)
+		return X86_writeVectorOutputBase(code, size, insn, insn_size,
+						 regs, wide);
+	const unsigned prefix = code[0] == 0xc5 ? 2 : 3;
+	/* Keep LDS/LES, memory forms, extended registers and W=1
+     * in the canonical reader. These rows use only XMM/YMM0..7. */
+	if (size < prefix + 2 || code[prefix + 1] < 0xc0 ||
+	    (prefix == 2 ?
+		     (code[1] & 0xc0) != 0xc0 :
+		     (code[1] & 0xe0) != 0xe0 || (code[2] & 0xc0) != 0x40))
+		return false;
+	if (!X86_writeVectorOutputBase(code, size, insn, insn_size, regs, true))
+		return false;
+	if (insn->detail) {
+		insn->detail->x86.rex = 0;
+		insn->detail->x86.addr_size = 4;
+	}
+	return true;
+}
+#endif
+#endif
