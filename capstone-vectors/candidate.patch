--- a/arch/X86/X86OutputIterator.c
+++ b/arch/X86/X86OutputIterator.c
@@ -15,6 +15,53 @@
 
 #include "X86SimpleOutputImpl.h"
 
+static bool tryOperandOverride16(cs_struct *handle, const uint8_t *code, size_t size,
+			     cs_insn *insn, uint16_t *insn_size)
+{
+	if (size < 2 || code[0] != 0x66)
+		return false;
+	const uint8_t opcode = code[1];
+	const bool mov_imm32 = (opcode & 0xf8) == 0xb8;
+	const bool pair = (opcode < 0x40 && (opcode & 7) <= 3) ||
+			  (opcode >= 0x84 && opcode <= 0x8b);
+	if (!mov_imm32 && !(pair && size >= 3 && code[2] >= 0xc0))
+		return false;
+
+	/* These non-stack register forms have the same operands and implicit registers
+	 * as their unprefixed 32-bit records. Keep the original handle for
+	 * syntax, callbacks, custom names, and detail policy. */
+	if (!trySimpleOutputForMode(handle, code + 1, size - 1, insn,
+				    insn_size, CS_MODE_32))
+		return false;
+	++*insn_size;
+	insn->size = *insn_size;
+	memcpy(insn->bytes, code, insn->size);
+	if (insn->detail) {
+		cs_x86 *x = &insn->detail->x86;
+		x->prefix[2] = X86_PREFIX_OPSIZE;
+		x->addr_size = 2;
+		if (pair)
+			++x->encoding.modrm_offset;
+		if (mov_imm32)
+			++x->encoding.imm_offset;
+	}
+	return true;
+}
+
+#ifdef CAPSTONE_X86_DEDICATED_OUTPUT
+CAPSTONE_INTERNAL
+#else
+static
+#endif
+bool X86_trySimpleOutput(cs_struct *handle, const uint8_t *code, size_t size,
+			 cs_insn *insn, uint16_t *insn_size)
+{
+	if (handle->mode == CS_MODE_16)
+		return tryOperandOverride16(handle, code, size, insn, insn_size);
+	return trySimpleOutputForMode(handle, code, size, insn, insn_size,
+				      handle->mode);
+}
