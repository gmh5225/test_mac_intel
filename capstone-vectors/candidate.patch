+/* Small scalar immediates and byte displacements use the same spelling. */
+static inline char *X86_writeByteMagnitude(char *out, unsigned magnitude)
+{
+	if (magnitude <= HEX_THRESHOLD) {
+		*out++ = (char)('0' + magnitude);
+	} else {
+		static const char digits[] = "0123456789abcdef";
+		memcpy(out, "0x", 2);
+		out += 2;
+		if (magnitude >= 16)
+			*out++ = digits[magnitude >> 4];
+		*out++ = digits[magnitude & 15];
+	}
+	return out;
+}
+
 static inline char *X86_writeDisp8(char *out, int displacement)
 {
 	if (displacement) {
 		const unsigned magnitude = displacement < 0 ? -displacement :
 							      displacement;
 		memcpy(out, displacement < 0 ? " - " : " + ", 3);
-		out += 3;
-		if (magnitude <= HEX_THRESHOLD) {
-			*out++ = (char)('0' + magnitude);
-		} else {
-			static const char digits[] = "0123456789abcdef";
-			memcpy(out, "0x", 2);
-			out += 2;
-			if (magnitude >= 16)
-				*out++ = digits[magnitude >> 4];
-			*out++ = digits[magnitude & 15];
-		}
+		return X86_writeByteMagnitude(out + 3, magnitude);
 	}
 	return out;
 }
