+static bool check_byte_memory_test(csh handles[2], cs_mode mode)
+{
+	/* Include no-base SIB, relative/absolute disp32, and /1 as controls. */
+	static const uint8_t tails[][7] = {
+		{ 0x00, 0xff }, { 0x40, 0x80, 0x80 },
+		{ 0x44, 0xb3, 0xf8, 0xfe }, { 0x08, 0xaa },
+		{ 0x05, 0xf0, 0xff, 0xff, 0xff, 0x80 },
+		{ 0x04, 0x25, 0x01, 0x00, 0x00, 0x80, 0xff },
+	};
+	for (unsigned i = 0; i < sizeof(tails) / sizeof(tails[0]); ++i) {
+		uint8_t code[9] = { 0x4f, 0xf6 };
+		memcpy(code + 2, tails[i], sizeof(tails[i]));
+		for (unsigned offset = mode == CS_MODE_64 ? 0 : 1; offset <= 1;
+		     ++offset) {
+			for (size_t n = 1; n <= sizeof(code) - offset; ++n)
+				if (!compare(handles, code + offset, n, i))
+					return false;
+		}
+	}
+	return true;
+}
+
 static bool check_mode(cs_mode mode)
 {
 	csh handles[2] = { 0 };
@@ -1673,6 +1695,7 @@ static bool check_mode(cs_mode mode)
 		    !check_lea(handles, mode) ||
 		    !check_mov_disp32(handles, mode) ||
 		    !check_group1(handles, mode) ||
+		    !check_byte_memory_test(handles, mode) ||
 		    !check_push_immediates(handles) ||
 		    !check_shift_immediate(handles, mode) ||
 		    !check_mov_imm32(handles, mode) ||
