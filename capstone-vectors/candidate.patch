diff --git a/cs_disasm_internal.h b/cs_disasm_internal.h
index 4c4c34f2..307ec6fc 100644
--- a/cs_disasm_internal.h
+++ b/cs_disasm_internal.h
@@ -26,8 +26,12 @@ X86_decodePublicRecord(cs_struct *handle, const uint8_t *code, size_t size,
 /* The public iterator can enter a fixed x86 reader once. Misses from that
  * reader call the same full decoder with the ordinary iterator request. */
 #ifdef CAPSTONE_X86_PUBLIC_FIXED_RECORD
+#ifdef CAPSTONE_X86_ITERATOR_READERS
+typedef bool cs_record_request;
+#else
 typedef uint8_t cs_record_request;
 enum { CS_RECORD_PUBLIC_ITER = 2 };
+#endif
 CAPSTONE_INTERNAL bool X86_decodeFixedRecord32(cs_struct *handle,
 		const uint8_t *code, size_t size, cs_insn *insn, uint16_t *length);
 CAPSTONE_INTERNAL bool X86_decodeFixedRecord64(cs_struct *handle,
@@ -186,9 +190,22 @@ CS_DECODE_INLINE bool decode_insn(cs_struct *handle, const uint8_t *code,
 	if (CS_DECODE_TRY_OUTPUT(handle, code, size, insn, insn_size))
 		return true;
 #endif
+#if defined(CS_PUBLIC_FIXED_RECORD) && defined(CAPSTONE_X86_ITERATOR_READERS)
+	/* This public iterator owns cursor advancement and skipdata. Dispatch
+	 * its formatted record once, leaving scan and internal calls intact. */
+	extern uint8_t cs_diagnostic_public_text;
+	if (handle->arch == CS_ARCH_X86 && !handle->no_text && cs_diagnostic_public_text == 2) {
+		if (handle->mode == CS_MODE_32)
+			return X86_decodeFixedRecord32(handle, code, size, insn,
+						       insn_size);
+		if (handle->mode == CS_MODE_64)
+			return X86_decodeFixedRecord64(handle, code, size, insn,
+						       insn_size);
+	}
+#endif
 #ifdef CS_DECODE_OUTPUT_MISS
 	return CS_DECODE_OUTPUT_MISS(handle, code, size, insn, insn_size, batch);
-#elif defined(CS_PUBLIC_FIXED_RECORD)
+#elif defined(CS_PUBLIC_FIXED_RECORD) && !defined(CAPSTONE_X86_ITERATOR_READERS)
 	return cs_decode_full_insn(handle, code, size, insn, insn_size,
 				   batch ? true : CS_RECORD_PUBLIC_ITER);
 #else
