diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 197453cb..261e366e 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3800,7 +3800,23 @@ X86_DECODE_ALIGN
 bool CAPSTONE_API cs_disasm_iter(csh ud, const uint8_t **code, size_t *size,
 				 uint64_t *address, cs_insn *insn)
 {
+#ifdef CS_X86_SELECTED_ITERATOR
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (!*size || !handle)
+		return false;
+	switch (handle->iterator_kind) {
+	case CS_ITER_TEXT32:
+		return X86_disasmIter32(ud, code, size, address, insn);
+	case CS_ITER_TEXT64:
+		return X86_disasmIterText(ud, code, size, address, insn);
+	case CS_ITER_SCAN:
+		return cs_disasm_iter_selected(handle, code, size, address, insn, true);
+	default:
+		return cs_disasm_iter_selected(handle, code, size, address, insn, false);
+	}
+#else
 	return cs_disasm_iter_core(ud, code, size, address, insn);
+#endif
 }
 
 X86_DECODE_ALIGN
diff --git a/cs.c b/cs.c
index d0b8b045..ea02b4ee 100644
--- a/cs.c
+++ b/cs.c
@@ -856,6 +856,26 @@ const char *CAPSTONE_API cs_strerror(cs_err code)
 	}
 }
 
+#ifdef CS_X86_SELECTED_ITERATOR
+/* Text, detail and bitness are handle options. The callback and syntax checks
+ * inside each reader still observe their current values on every decode. */
+static void select_public_iterator(cs_struct *handle)
+{
+	handle->iterator_kind = CS_ITER_FULL;
+	if (handle->arch != CS_ARCH_X86)
+		return;
+	if (handle->no_text) {
+		if (handle->detail_opt)
+			return;
+		handle->iterator_kind = CS_ITER_SCAN;
+	} else if (handle->mode == CS_MODE_32) {
+		handle->iterator_kind = CS_ITER_TEXT32;
+	} else if (handle->mode == CS_MODE_64) {
+		handle->iterator_kind = CS_ITER_TEXT64;
+	}
+}
+#endif
+
 CAPSTONE_EXPORT
 cs_err CAPSTONE_API cs_open(cs_arch arch, cs_mode mode, csh *handle)
 {
@@ -902,6 +922,9 @@ cs_err CAPSTONE_API cs_open(cs_arch arch, cs_mode mode, csh *handle)
 	if ((err = populate_insn_map_cache(ud)))
 		goto fail;
 
+#ifdef CS_X86_SELECTED_ITERATOR
+	select_public_iterator(ud);
+#endif
 	*handle = (uintptr_t)ud;
 	return CS_ERR_OK;
 
@@ -1404,6 +1427,9 @@ cs_err CAPSTONE_API cs_option(csh ud, cs_opt_type type, uintptr_t value)
 
 	case CS_OPT_TEXT:
 		handle->no_text = value == CS_OPT_OFF;
+#ifdef CS_X86_SELECTED_ITERATOR
+		select_public_iterator(handle);
+#endif
 #ifdef CAPSTONE_MIPS_SCAN_BY_OPTION
 		Mips_selectScanDecoder(handle);
 #endif
@@ -1419,6 +1445,9 @@ cs_err CAPSTONE_API cs_option(csh ud, cs_opt_type type, uintptr_t value)
 			handle->detail_opt = CS_OPT_OFF;
 		else
 			handle->detail_opt |= (cs_opt_value)value;
+#ifdef CS_X86_SELECTED_ITERATOR
+		select_public_iterator(handle);
+#endif
 #ifdef CAPSTONE_MIPS_SCAN_BY_OPTION
 		Mips_selectScanDecoder(handle);
 #endif
@@ -1535,7 +1564,12 @@ cs_err CAPSTONE_API cs_option(csh ud, cs_opt_type type, uintptr_t value)
 	if (!arch_configs[handle->arch].arch_option)
 		return CS_ERR_ARCH;
 
-	return arch_configs[handle->arch].arch_option(handle, type, value);
+	cs_err err = arch_configs[handle->arch].arch_option(handle, type, value);
+#ifdef CS_X86_SELECTED_ITERATOR
+	if (err == CS_ERR_OK && type == CS_OPT_MODE)
+		select_public_iterator(handle);
+#endif
+	return err;
 }
 
