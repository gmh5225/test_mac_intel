+
+/* Absolute offsets and ModR/M disp32 addresses share the Intel spelling.
+ * The former has an unsigned public displacement and no ModR/M byte. */
+static bool writeAbsolute32(cs_struct *handle, const uint8_t *code,
+			    size_t size, cs_insn *insn, uint16_t *insn_size)
+{
+	const bool segmented = (code[0] & 0xfe) == 0x64;
+	const unsigned prefix = segmented ? 1 : 0;
+	if (size < prefix + 5)
+		return false;
+
+	const uint8_t opcode = code[prefix];
+	const bool moffs = (opcode & 0xfc) == 0xa0;
+	unsigned address_offset = prefix + 1;
+	uint8_t modrm = 0;
+	if (!moffs) {
+		/* Only FS/GS absolute ALU, TEST and MOV reach this writer. */
+		if (!segmented || size < address_offset + 5 ||
+		    ((opcode & 0xc4) != 0 && (opcode & 0xfe) != 0x84 &&
+		     (opcode & 0xfc) != 0x88))
+			return false;
+		modrm = code[address_offset++];
+		if ((modrm & 0xc7) != 5)
+			return false;
+	}
+	if (X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+
+	const bool load = moffs ? !(opcode & 2) : (opcode & 2) != 0;
+	const bool dword = (opcode & 1) != 0;
+	const unsigned pair = moffs ? ((load ? 0x8a : 0x88) | dword) : opcode;
+	const struct X86SimpleOutput *row =
+		&x86_simple_outputs[x86_simple_plans[0][0][pair] >> 2];
+	const struct X86SimpleRegister *reg =
+		&x86_simple_registers[dword ? 2 : 0][(modrm >> 3) & 7];
+	const int32_t disp = X86_readDisp32(code + address_offset);
+	const unsigned length = address_offset + 4;
+
+	insn->id = row->id;
+	insn->size = *insn_size = (uint16_t)length;
+	memcpy(insn->bytes, code, length);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = insn->op_str;
+	if (load) {
+		memcpy(out, reg->name, sizeof(reg->name));
+		out += reg->length;
+		memcpy(out, ", ", 2);
+		out += 2;
+	}
+	if (dword) {
+		memcpy(out, "dword ptr ", 10);
+		out += 10;
+	} else {
+		memcpy(out, "byte ptr ", 9);
+		out += 9;
+	}
+	if (segmented) {
+		memcpy(out, code[0] == 0x64 ? "fs:" : "gs:", 3);
+		out += 3;
+	}
+	*out++ = '[';
+	out = writeUnsignedImmediate(out, (uint32_t)disp);
+	*out++ = ']';
+	if (!load) {
+		memcpy(out, ", ", 2);
+		memcpy(out + 2, reg->name, sizeof(reg->name));
+	}
+
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, opcode, 0, modrm,
+				      load ? reg->reg : 0, load ? 0 : reg->reg);
+		cs_x86 *x = &insn->detail->x86;
+		x->encoding.modrm_offset = moffs ? 0 : (uint8_t)(prefix + 1);
+		x->encoding.disp_offset = (uint8_t)address_offset;
+		x->encoding.disp_size = 4;
+		cs_x86_op *mem = &x->operands[load ? 1 : 0];
+		mem->type = X86_OP_MEM;
+		mem->mem.scale = 1;
+		mem->mem.disp = x->disp = moffs ? (int64_t)(uint32_t)disp : disp;
+		if (segmented) {
+			x->prefix[1] = code[0];
+			mem->mem.segment = code[0] == 0x64 ? X86_REG_FS : X86_REG_GS;
+		}
+	}
+	return true;
+}
+
+CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
+X86_decodeAbsoluteMiss32(cs_struct *handle, const uint8_t *code, size_t size,
+			 cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+	if (writeAbsolute32(handle, code, size, insn, insn_size))
+		return true;
+	__attribute__((musttail)) return cs_decode_full_insn(
+		handle, code, size, insn, insn_size, batch);
+}
+#endif
+
 #endif
 #endif
