diff --git a/cs_disasm_internal.h b/cs_disasm_internal.h
index 08677417..3d59bdad 100644
--- a/cs_disasm_internal.h
+++ b/cs_disasm_internal.h
@@ -18,7 +18,7 @@
  * the compiler can combine scan and output state without an extra boundary.
  * Otherwise cs.c instantiates the same iterator. Input validation, option
  * selection and callbacks keep their original order. */
-#ifdef CAPSTONE_X86_PUBLIC_OUTPUT
+#if defined(CAPSTONE_X86_PUBLIC_OUTPUT) && !defined(CAPSTONE_X86_DIRECT_PUBLIC_RECORD)
 CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
 X86_decodePublicRecord(cs_struct *handle, const uint8_t *code, size_t size,
 		       cs_insn *insn, uint16_t *insn_size, bool batch);
@@ -188,6 +188,18 @@ CS_DECODE_INLINE bool decode_insn(cs_struct *handle, const uint8_t *code,
 	if (CS_DECODE_TRY_OUTPUT(handle, code, size, insn, insn_size))
 		return true;
 #endif
+#ifdef CS_PUBLIC_DIRECT_RECORD
+	/* The outer iterator owns detail visibility, skipdata and cursor updates.
+	 * Its fixed text path only needs the decoded record and its length. */
+	if (!batch && !handle->skipdata && !handle->no_text) {
+		if (handle->mode == CS_MODE_32)
+			return X86_decodeFixedRecord32(handle, code, size, insn,
+						       insn_size);
+		if (handle->mode == CS_MODE_64)
+			return X86_decodeFixedRecord64(handle, code, size, insn,
+						       insn_size);
+	}
+#endif
 #ifdef CS_DECODE_OUTPUT_MISS
 	return CS_DECODE_OUTPUT_MISS(handle, code, size, insn, insn_size, batch);
 #elif defined(CS_PUBLIC_FIXED_RECORD)
