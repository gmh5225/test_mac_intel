diff --git a/CMakeLists.txt b/CMakeLists.txt
index 72004759..fdcc44a8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1088,6 +1088,10 @@ if(capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV"
    AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|aarch64|arm64|ARM64)$")
     target_compile_definitions(capstone_build_settings INTERFACE
         "$<$<CONFIG:Release>:CAPSTONE_X86_COMPACT_SCALAR_ROWS>")
+    # The public record enters the same archive member as the static x86 text iterator.
+    set_property(SOURCE arch/X86/X86DisassemblerDecoder.c arch/X86/X86Sse64Output.c
+        arch/X86/X86Vex32Output.c APPEND PROPERTY
+        COMPILE_DEFINITIONS "$<$<CONFIG:Release>:X86_MIXED_PUBLIC_RECORD>")
     # Use cached access IDs and bounded masked-operand copies in the x86-64 static reader.
     if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
         set_property(SOURCE arch/X86/X86Mapping.c APPEND PROPERTY
diff --git a/arch/X86/X86Disassembler.h b/arch/X86/X86Disassembler.h
