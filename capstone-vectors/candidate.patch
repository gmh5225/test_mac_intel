+static void set_mode(cs_struct *handle, cs_mode mode)
+{
+	/* The decoder defaults to 64-bit when no operand mode was specified. */
+	if (!x86_get_bit_mode(mode))
+		mode = (cs_mode)(mode | CS_MODE_64);
+	handle->mode = mode;
+	handle->regsize_map = x86_has_feature(mode, CS_MODE_64) ?
+				      regsize_map_64 : regsize_map_32;
+}
