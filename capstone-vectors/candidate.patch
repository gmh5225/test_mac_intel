 		return readPrimary(code, size, plan);
+	/* C4 also encodes LES in i386 mode. E3 selects the unextended 0F3A
+	 * map; the payload selects W=0 and a source in registers 0..7. */
+	if (code[0] == 0xc4 && size >= 4 && code[1] == 0xe3 &&
+	    (code[2] & 0xc0) == 0x40 &&
