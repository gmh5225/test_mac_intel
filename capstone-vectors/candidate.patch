diff --git a/suite/synctools/x86_register_name_sizes.py b/suite/synctools/x86_register_name_sizes.py
index d735f83c..0753073b 100644
--- a/suite/synctools/x86_register_name_sizes.py
+++ b/suite/synctools/x86_register_name_sizes.py
@@ -119,6 +119,36 @@ def generate(text, enum_text):
     return result
 
 
+def register_slots(text):
+    strings = string_bytes(text)
+    records = [int(x) for x in TABLE.search(text)[1].split(",") if x.strip()]
+    names = []
+    for record in records:
+        offset = record & MASK
+        length = record >> SHIFT
+        name = strings[offset : offset + length]
+        require(strings[offset + length] == 0 and b"\\0" not in name,
+                "Invalid register spelling")
+        names.append(name.decode("ascii"))
+    lines = [
+        "/* Generated by x86_register_name_sizes.py. */",
+        "static const char X86PrinterRegisterNames[][8] = {",
+    ]
+    for name in names:
+        spelling = name.encode("ascii")
+        unused = 7 - len(spelling)
+        require(0 <= unused < 7, "Invalid packed register-name width")
+        row = spelling + bytes(unused) + bytes([unused])
+        require(len(row) == 8 and row[len(spelling)] == 0, "Missing name terminator")
+        fields = [repr(chr(c)) if 32 <= c < 127 and c not in (39, 92) else str(c)
+                  for c in spelling]
+        fields.extend(["0"] * unused)
+        fields.append(str(unused))
+        lines.append("\t{ " + ", ".join(fields) + " },")
+    lines.append("};")
+    return "\n".join(lines) + "\n"
+
