diff --git a/arch/X86/X86Mapping.c b/arch/X86/X86Mapping.c
index 79adee8d..70a0b67c 100644
--- a/arch/X86/X86Mapping.c
+++ b/arch/X86/X86Mapping.c
@@ -11990,6 +11990,20 @@ void X86_reg_access(const cs_insn *insn, cs_regs regs_read,
 	read_count = insn->detail->regs_read_count;
 	write_count = insn->detail->regs_write_count;
 
+	/* A register load with a single address register has one write
+	 * followed by one read. The output arrays may overlap. */
+	const cs_x86_op *ops = x86->operands;
+	if (!read_count && !write_count && x86->op_count == 2 &&
+	    ops[0].type == X86_OP_REG && ops[0].access == CS_AC_WRITE &&
+	    ops[1].type == X86_OP_MEM && ops[1].mem.segment == X86_REG_INVALID &&
+	    ops[1].mem.index == X86_REG_INVALID && ops[1].mem.base != X86_REG_INVALID) {
+		regs_write[0] = (uint16_t)ops[0].reg;
+		regs_read[0] = (uint16_t)ops[1].mem.base;
+		*regs_read_count = 1;
+		*regs_write_count = 1;
+		return;
+	}
+
 	// implicit registers
 	if (read_count == 1)
 		regs_read[0] = insn->detail->regs_read[0];
