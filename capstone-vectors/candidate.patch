+/* MOV moffs encodes an unsigned offset directly, without ModR/M or SIB. */
+static void writeAccumulatorOffset32(const uint8_t *code, unsigned lead,
+				     cs_insn *insn, uint16_t *insn_size)
+{
+	const unsigned op = code[lead], width = op & 1;
+	const bool load = !(op & 2);
+	const unsigned pair = (load ? 0x8a : 0x88) | width;
+	const struct X86SimpleOutput *row =
+		&x86_simple_outputs[x86_simple_plans[0][0][pair] >> 2];
+	const struct X86SimpleRegister *acc = &x86_simple_registers[width ? 2 : 0][0];
+	const struct X86SimpleRegister *segment = lead ? segmentRegister32(code[0]) : NULL;
+	const uint32_t address = (uint32_t)X86_readDisp32(code + lead + 1);
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)(lead + 5);
+	memcpy(insn->bytes, code, insn->size);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = insn->op_str;
+	if (load) {
+		memcpy(out, acc->name, acc->length);
+		out += acc->length;
+		memcpy(out, ", ", 2);
+		out += 2;
+	}
+	if (width) {
+		memcpy(out, "dword ptr ", 10);
+		out += 10;
+	} else {
+		memcpy(out, "byte ptr ", 9);
+		out += 9;
+	}
+	if (segment) {
+		memcpy(out, segment->name, 2);
+		out[2] = ':';
+		out += 3;
+	}
+	*out++ = '[';
+	out = writeUnsignedImmediate(out, address);
+	*out++ = ']';
+	if (!load) {
+		memcpy(out, ", ", 2);
+		memcpy(out + 2, acc->name, acc->length);
+	}
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, (uint8_t)op, 0, 0,
+				      load ? acc->reg : 0, load ? 0 : acc->reg);
+		cs_x86 *x = &insn->detail->x86;
+		x->encoding.modrm_offset = 0;
+		x->encoding.disp_offset = (uint8_t)(lead + 1);
+		x->encoding.disp_size = 4;
+		cs_x86_op *mem = &x->operands[load ? 1 : 0];
+		mem->type = X86_OP_MEM;
+		mem->mem.scale = 1;
+		mem->mem.disp = x->disp = address;
+		if (segment) {
+			x->prefix[1] = code[0];
+			mem->mem.segment = (x86_reg)segment->reg;
+		}
+	}
+}
