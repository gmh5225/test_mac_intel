diff --git a/arch/X86/X86ATTInstPrinter.c b/arch/X86/X86ATTInstPrinter.c
index 1cc3d3a9..f8d8658f 100644
--- a/arch/X86/X86ATTInstPrinter.c
+++ b/arch/X86/X86ATTInstPrinter.c
@@ -1034,6 +1034,27 @@ static void printRegName(SStream *OS, unsigned RegNo)
 			X86_featureExtensionMCRegisterName(RegNo) :
 			NULL;
 
+#if defined(CAPSTONE_X86_ONLY) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+	static const volatile unsigned char att_register_token_enabled
+		__attribute__((used, section(".rodata.att_register_trial"))) = 104;
+	if (att_register_token_enabled == 104 &&
+	    cs_vsnprintf == cs_default_vsnprintf && !OS->is_closed &&
+	    !(OS->markup_stream && OS->prefixed_by_markup)) {
+		const char *name = extension_name ? extension_name :
+						    getRegisterName(RegNo);
+		size_t len = strlen(name);
+		if (len < sizeof(OS->buffer) - 1 &&
+		    OS->index < sizeof(OS->buffer) - len - 1) {
+			char *out = OS->buffer + OS->index;
+			out[0] = '%';
+			memcpy(out + 1, name, len + 1);
+			OS->index += len + 1;
+			return;
+		}
+	}
+#endif
 	SStream_concat(OS, "%%%s",
 		       extension_name ? extension_name :
 					getRegisterName(RegNo));
