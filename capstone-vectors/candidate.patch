-					Flags |= X86_IP_HAS_EVEX_OPMASK;
-					break;
-				}
-			}
+			if (insn.writemask)
+				Flags |= X86_IP_HAS_EVEX_OPMASK;
 #endif
 
 			instr->flags = Flags;
diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 0d9b1a76..468f0938 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -2272,8 +2272,7 @@ static int readMaskRegister(struct InternalInstruction *insn)
 	if (insn->vectorExtensionType != TYPE_EVEX)
 		return -1;
 
-	insn->writemask =
-		(Reg)(aaaFromEVEX4of4(insn->vectorExtensionPrefix[3]));
+	insn->writemask = X86_K0 + aaaFromEVEX4of4(insn->vectorExtensionPrefix[3]);
 
 	return 0;
 }
