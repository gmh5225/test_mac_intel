+/* Groups 4 and 5 share their INC/DEC register forms. The group selects
+ * the effects row; REX.B and the operand width select the register. */
+static bool writeIncDec64(cs_struct *handle, const uint8_t *code, size_t size,
+			  cs_insn *insn, uint16_t *insn_size)
+{
+	const uint8_t rex = (code[0] & 0xf0) == 0x40 ? code[0] : 0;
+	const unsigned prefix = rex != 0;
+	if (size < 2 + prefix)
+		return false;
+	const uint8_t opcode = code[prefix], mr = code[prefix + 1];
+	if ((opcode & 0xfe) != 0xfe || (mr & 0xf0) != 0xc0 ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+
+	const unsigned bank = prefix + ((rex & 8) != 0);
+	const unsigned width = (opcode & 1) ? (rex & 8 ? 3 : 2) : prefix;
+	const struct X86SimpleOutput *row =
+		&x86_inc_dec64[bank][((opcode & 1) << 1) | ((mr >> 3) & 1)];
+	const struct X86SimpleRegister *reg =
+		&x86_simple_registers[width][((rex & 1) << 3) | (mr & 7)];
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)(2 + prefix);
+	memcpy(insn->bytes, code, insn->size);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, reg->name, sizeof(reg->name));
+	if (insn->detail)
+		X86_writeSimpleDetail(insn->detail, row, opcode, rex, mr,
+				      reg->reg, 0);
+	return true;
+}
