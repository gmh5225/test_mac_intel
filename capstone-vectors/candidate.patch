+/* Both APIs keep the public VCMP alias while the immediate selects the
+ * condition in the instruction text and operand details. */
+static bool test_floating_compare(csh handle)
+{
+	static const uint8_t bytes[][7] = {
+		{ 0xc5, 0xfb, 0xc2, 0xda, 0x06 },
+		{ 0x62, 0xf1, 0x4c, 0x0b, 0xc2, 0xd0, 0xa5 },
+	};
+	static const size_t sizes[] = { 5, 7 };
+	cs_insn *slot = cs_malloc(handle);
+	if (!check(slot != NULL, "allocate compare iterator"))
+		return false;
+	bool ok = true;
+	for (size_t i = 0; i < sizeof(sizes) / sizeof(sizes[0]); ++i) {
+		const uint8_t *cursor = bytes[i];
+		size_t left = sizes[i];
+		uint64_t address = 0x1000;
+		cs_insn *array = NULL;
+		size_t count = cs_disasm(handle, cursor, left, address, 1, &array);
+		bool decoded = cs_disasm_iter(handle, &cursor, &left,
+					      &address, slot);
+		ok &= check(count == 1 && decoded && left == 0 &&
+				    address == 0x1000 + sizes[i],
+			    "both floating compare decoders consume the instruction");
+		if (count && decoded) {
+			ok &= check(array[0].id == X86_INS_VCMP &&
+					    slot->id == array[0].id,
+				    "floating predicate keeps its public alias ID");
+			ok &= check(strcmp(slot->mnemonic, array[0].mnemonic) == 0 &&
+					    strcmp(slot->op_str, array[0].op_str) == 0,
+				    "floating predicate text agrees across APIs");
+			if (slot->detail && array[0].detail)
+				ok &= check(slot->detail->x86.avx_cc ==
+						    array[0].detail->x86.avx_cc,
+					    "floating predicate detail agrees across APIs");
+		}
+		cs_free(array, count);
+	}
+	cs_free(slot, 1);
+	return ok;
+}
+
 int main(void)
 {
 	csh handle = 0;
@@ -64,6 +106,7 @@ int main(void)
 		   "open 64-bit mode"))
 		return 1;
 	success &= test_vpcmp(handle, false);
+	success &= test_floating_compare(handle);
 	if (!check(cs_option(handle, CS_OPT_DETAIL,
 			    CS_OPT_ON | CS_OPT_DETAIL_REAL) == CS_ERR_OK,
 		   "enable detail")) {
@@ -71,6 +114,7 @@ int main(void)
