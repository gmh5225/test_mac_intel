index 7afca7e4..de21fb5c 100644
--- a/arch/X86/X86Sse64Output.c
+++ b/arch/X86/X86Sse64Output.c
@@ -261,7 +261,7 @@ static bool writeRoundedRegisters(const uint8_t *code, cs_insn *insn,
 #include "../../cs_disasm_internal.h"
 #undef CS_DECODE_OUTPUT_MISS
 
-#ifdef CAPSTONE_X86_PUBLIC_FIXED_RECORD
+#if defined(CAPSTONE_X86_PUBLIC_FIXED_RECORD) || defined(CAPSTONE_X86_SHARED_FIXED_RECORD)
 bool X86_decodeFixedRecord64(cs_struct *handle, const uint8_t *code, size_t size,
 			     cs_insn *insn, uint16_t *length)
 {
@@ -282,4 +282,44 @@ CAPSTONE_INTERNAL bool X86_disasmIterText(csh ud, const uint8_t **code,
 #endif
 	return X86_disasmIter32(ud, code, size, address, insn);
 }
+
+#ifdef CAPSTONE_X86_SHARED_FIXED_RECORD
+/* The ordinary decoder has the same calling convention as the public
+ * record entry. Keep the frame needed by the fixed readers on their path. */
+static __attribute__((noinline)) CS_PRESERVE_MOST bool
+decodeSharedIntelRecord(cs_struct *handle, const uint8_t *code, size_t size,
+			cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+	if (handle->mode == CS_MODE_32)
+		return X86_decodeFixedRecord32(handle, code, size, insn,
+					       insn_size);
+	if (handle->mode == CS_MODE_64)
+		return X86_decodeFixedRecord64(handle, code, size, insn,
+					       insn_size);
+	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
+}
+
+#if __has_attribute(musttail)
+#define X86_RECORD_TAIL __attribute__((musttail))
+#else
+#define X86_RECORD_TAIL
+#endif
+
+CS_PRESERVE_MOST bool X86_decodeSharedRecord(cs_struct *handle,
+		const uint8_t *code, size_t size, cs_insn *insn,
+		uint16_t *insn_size, bool batch)
+{
+	if (handle->arch == CS_ARCH_X86 && !batch && !handle->no_text &&
+	    (handle->syntax == CS_OPT_SYNTAX_DEFAULT ||
+	     handle->syntax == CS_OPT_SYNTAX_INTEL)) {
+		X86_RECORD_TAIL
+		return decodeSharedIntelRecord(handle, code, size, insn,
+					      insn_size, batch);
+	}
+	X86_RECORD_TAIL
+	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
+}
+
+#undef X86_RECORD_TAIL
+#endif
 #endif
