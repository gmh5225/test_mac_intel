+/* The caller has checked the prefix, ModR/M, options and input extent. */
+static bool writeVexTransfer64(const uint8_t *code, unsigned prefix, cs_insn *insn,
+			       uint16_t *insn_size)
+{
+	const unsigned opcode = code[prefix], flags = code[prefix - 1];
+	if (opcode != 0x50 ||
+	    (flags & 0x78) != 0x78 || (prefix == 3 && (code[1] & 31) != 1))
+		return false;
+	const unsigned w = prefix == 3 && (flags & 0x80);
+	const unsigned plan = opcode == 0x50 ? 2 : opcode & 1;
+	const unsigned index = vex_transfer_plans[plan][(w << 3) | (flags & 7)];
+	if (!index)
+		return false;
+	const struct VexTransferRow *row = &vex_transfer_rows[index - 1];
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & (prefix == 2 ? 4 : 7);
+	const unsigned mr = code[prefix + 1];
+	const unsigned numbers[] = { ((mr >> 3) & 7) | ((rxb & 4) << 1),
+				     (mr & 7) | ((rxb & 1) << 3) };
+	*insn_size = insn->size = (uint16_t)(prefix + 2);
+	insn->id = row->instruction.id;
+	memcpy(insn->bytes, code, prefix + 2);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->instruction.mnemonic,
+	       sizeof(row->instruction.mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	cs_x86 *x = NULL;
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		d->groups_count = row->instruction.group_count;
+		memcpy(d->groups, row->instruction.groups, sizeof(row->instruction.groups));
+		x = &d->x86;
+		memcpy(x->opcode, code, prefix);
+		x->addr_size = 8;
+		x->rex = (uint8_t)(0x40 | (w << 3) | rxb);
+		x->modrm = (uint8_t)mr;
+		x->encoding.modrm_offset = (uint8_t)(prefix + 1);
+		x->op_count = 2;
+	}
+	char *out = insn->op_str;
+	for (unsigned i = 0; i < 2; ++i) {
+		const unsigned number = numbers[i ^ row->reverse], bank = row->banks[i];
+		x86_reg reg;
+		if (i) {
+			memcpy(out, ", ", 2);
+			out += 2;
+		}
+		if (bank < 2) {
+			out = writeVectorRegister(out, bank, number);
+			reg = (x86_reg)((bank ? X86_REG_YMM0 : X86_REG_XMM0) + number);
+		} else {
+			const struct X86SimpleRegister *gpr = &x86_simple_registers[bank][number];
+			memcpy(out, gpr->name, sizeof(gpr->name));
+			out += gpr->length;
+			reg = (x86_reg)gpr->reg;
+		}
+		if (x) {
+			static const uint8_t widths[] = { 16, 32, 4, 8 };
+			x->operands[i].type = X86_OP_REG;
+			x->operands[i].reg = reg;
+			x->operands[i].size = widths[bank];
+			x->operands[i].access = (cs_ac_type)row->instruction.access[i];
+		}
+	}
+	return true;
+}
