diff --git a/arch/X86/X86Vex32Output.c b/arch/X86/X86Vex32Output.c
index 7bbf1c0d..0a44bf87 100644
--- a/arch/X86/X86Vex32Output.c
+++ b/arch/X86/X86Vex32Output.c
@@ -223,4 +223,17 @@ CAPSTONE_INTERNAL bool X86_disasmIter32(csh ud, const uint8_t **code,
 #endif
 	return X86_disasmIter(ud, code, size, address, insn);
 }
+
+CAPSTONE_INTERNAL bool X86_disasmIterText(csh ud, const uint8_t **code,
+					  size_t *size, uint64_t *address,
+					  cs_insn *insn)
+{
+#ifdef CS_DECODE_TRY_OUTPUT
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (handle && handle->arch == CS_ARCH_X86 &&
+	    handle->mode == CS_MODE_64 && !handle->no_text)
+		return X86_disasmIter64(ud, code, size, address, insn);
+#endif
+	return X86_disasmIter32(ud, code, size, address, insn);
+}
 #endif
