+#ifdef CAPSTONE_SSTREAM_PRECHECKED
+/* Emit the opening bracket and an ordinary base-register name into the
+ * already bounded stream. The two copies stay within the name's extent. */
+static bool printBaseRegister(SStream *stream, const MCOperand *operand)
+{
+	if (!MCOperand_isReg(operand))
+		return false;
+	const unsigned reg = MCOperand_getReg(operand);
+	if (!reg || reg >= X86_FEATURE_MC_GPR_BASE)
+		return false;
+	const unsigned length = getRegisterNameLength(reg);
+	if (length < 2 || length > 4)
+		return false;
+	const char *name = getRegisterName(reg);
+	char *out = stream->buffer + stream->index;
+	out[0] = '[';
+	memcpy(out + 1, name, 2);
+	memcpy(out + length - 1, name + length - 2, 2);
+	out[length + 1] = 0;
+	stream->index += length + 1;
+	return true;
+}
+#endif
