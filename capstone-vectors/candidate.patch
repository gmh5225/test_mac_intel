+X86_DECODE_INLINE uint32_t X86_readVex32PublicPlan(const uint8_t *code,
+						   size_t size)
+{
+	if (size < 3)
+		return UINT32_MAX;
+	const unsigned payload = code[1];
+	unsigned plan = x86Vex2PublicPlans[payload & 3][code[2]];
+	if (plan & (X86_VEX2_PUBLIC_LENGTH | X86_VEX2_PUBLIC_GROUP)) {
+#if X86_HAS_VEX2_LENGTH_PLANS
+		if (plan & X86_VEX2_PUBLIC_LENGTH)
+			plan = x86Vex2LengthPlans[plan &
+						  (X86_VEX2_PUBLIC_LENGTH - 1)]
+						 [(payload >> 2) & 1];
+#endif
+#if X86_HAS_VEX2_PUBLIC_GROUPS
+		if (plan & X86_VEX2_PUBLIC_GROUP) {
+			if (size < 4)
+				return UINT32_MAX;
+			const unsigned modrm = code[3];
+			plan = x86Vex2PublicGroups[plan &
+						   (X86_VEX2_PUBLIC_GROUP - 1)]
+						  [((modrm >> 3) & 7) +
+						   (modrm >= 0xc0 ? 8 : 0)];
+		}
+#endif
+	}
+	if (!plan)
+		return 0;
+	if ((plan & 2) && vvvvFromVEX2of2(payload))
+		return UINT32_MAX;
+	unsigned end = 3;
+	if (plan & 4) {
+		if (size < 4)
+			return UINT32_MAX;
+		const unsigned modrm = code[3];
+		end = 4;
+		if (modrm < 0xc0) {
+			const unsigned mod = modrm >> 6, rm = modrm & 7;
+			static const uint8_t extra[3][8] X86_VEX2_PLAN_DATA = {
+				{ 0, 0, 0, 0, 1, 4, 0, 0 },
+				{ 1, 1, 1, 1, 2, 1, 1, 1 },
+				{ 4, 4, 4, 4, 5, 4, 4, 4 }
+			};
+			if ((modrm & 0xc7) == 4) {
+				if (end >= size)
+					return UINT32_MAX;
+				if ((code[end] & 7) == 5)
+					end += 4;
+			}
+			end += extra[mod][rm];
+		}
+	}
+	end += plan & 1;
+	if (end > size)
+		return UINT32_MAX;
+	return ((plan >> 3) << 8) | end;
