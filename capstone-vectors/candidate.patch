+X86_decodeMixedPublicRecord(cs_struct *handle, const uint8_t *code, size_t size,
+			    cs_insn *insn, uint16_t *length, bool batch);
 #endif
 /* The public iterator can enter a fixed x86 reader once. Misses from that
