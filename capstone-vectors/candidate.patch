+static CS_PRESERVE_MOST bool
+decodeVex32PlanOrGeneric(csh ud, const uint8_t *code, size_t code_len,
+			 cs_insn *insn, X86ScanResult *result, uint8_t opcode,
+			 bool tryExtension) X86_VEX32_SCAN_CODE;
+
+static CS_PRESERVE_MOST bool
+decodeVex32PlanOrGeneric(csh ud, const uint8_t *code, size_t code_len,
+			 cs_insn *insn, X86ScanResult *result, uint8_t opcode,
+			 bool tryExtension)
+{
+	const uint32_t packed = X86_readVex32PublicPlan(code, code_len);
+	if (packed) {
+		if (packed == UINT32_MAX)
+			return false;
+		result->opcode = 0;
+		result->opcode_pub = packed >> 8;
+		result->length = (uint16_t)(packed & 0xff);
+		result->popcode_adjust = 0;
+		return true;
+	}
+	return decodeScanResultGeneric(ud, code, code_len, insn, result, opcode,
+				       tryExtension);
+}
+
+static CS_PRESERVE_MOST bool
+decodeVex32OrGeneric(csh ud, const uint8_t *code, size_t code_len,
+		     cs_insn *insn, X86ScanResult *result, uint8_t opcode,
+		     bool tryExtension)
+{
+	const cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (!tryExtension && handle->mode == CS_MODE_32 && code_len >= 2 &&
+	    code[0] == 0xc5 && (code[1] & 0xc0) == 0xc0)
+		return decodeVex32PlanOrGeneric(ud, code, code_len, insn,
+						result, opcode, tryExtension);
+	return decodeScanResultGeneric(ud, code, code_len, insn, result, opcode,
+				       tryExtension);
+}
