+def project_integer_compare_ids(directory, suffix, check):
+    mapping_path = directory / f"X86MappingInsn{suffix}.inc"
+    access_path = directory / f"X86MappingInsnOp{suffix}.inc"
+    mapping = mapping_path.read_text()
+    ids = {row[1]: row[2] for row in entries(mapping)}
+    families = {}
+    for opcode, current in ids.items():
+        match = re.fullmatch(r"X86_(VPCMPU?[BWDQ])Z\w+", opcode)
+        if not match or opcode.endswith("_alt"):
+            require(current != "X86_INS_VPCMP", f"Unknown compare family for {opcode}")
+            continue
+        family = ids.get(opcode + "_alt")
+        require(family == "X86_INS_" + match[1], f"Missing typed alternate for {opcode}")
+        require(current in ("X86_INS_VPCMP", family), f"Unexpected ID for {opcode}")
+        families[opcode] = family
+
+    # Both rows describe the same instruction. The alias hides the immediate
+    # in its mnemonic, and the alternate spells it as an explicit operand.
+    mapping = re.sub(
+        r"\b(X86_\w+), X86_INS_VPCMP,",
+        lambda match: f"{match[1]}, {families[match[1]]},",
+        mapping,
+    )
+    access = re.sub(
+        r"/\* (X86_\w+), X86_INS_VPCMP: vpcmp \*/",
+        lambda match: f"/* {match[1]}, {families[match[1]]}: "
+        f"{families[match[1]][len('X86_INS_'):].lower()} */",
+        access_path.read_text(),
+    )
+    for path, text in ((mapping_path, mapping), (access_path, access)):
+        if text != path.read_text():
+            require(not check, f"Stale integer compare ID in {path.name}")
+            path.write_text(text)
+
