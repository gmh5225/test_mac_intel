diff --git a/arch/X86/X86VectorOutput.c b/arch/X86/X86VectorOutput.c
index 8a606f4e..902be7a6 100644
--- a/arch/X86/X86VectorOutput.c
+++ b/arch/X86/X86VectorOutput.c
@@ -515,6 +515,23 @@ bool X86_writeVectorOutput(const uint8_t *code, size_t size, cs_insn *insn,
 						 wide);
 	if (code[0] == 0x62)
 		return writeEvexOutput(code, size, insn, insn_size, regs);
+	if (!wide) {
+		const unsigned prefix = code[0] == 0xc5 ? 2 : 3;
+		/* Keep LDS/LES, memory forms, extended registers and W=1
+		 * in the canonical reader. These rows use only XMM/YMM0..7. */
+		if (size < prefix + 2 || code[prefix + 1] < 0xc0 ||
+		    (prefix == 2 ? (code[1] & 0xc0) != 0xc0 :
+				   (code[1] & 0xe0) != 0xe0 ||
+				   (code[2] & 0xc0) != 0x40))
+			return false;
+		if (!writeVexRegisterOutput(code, size, insn, insn_size, prefix))
+			return false;
+		if (insn->detail) {
+			insn->detail->x86.rex = 0;
+			insn->detail->x86.addr_size = 4;
+		}
+		return true;
+	}
 	if (code[0] == 0xc5 && size >= 4 && (code[3] & 0xc7) == 5)
 		return writeVexRipLoad(code, size, insn, insn_size);
 	const unsigned prefix = code[0] == 0xc5 ? 2 : 3;
