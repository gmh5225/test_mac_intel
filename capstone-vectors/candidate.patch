+/* A SIB index encoded as 4 can denote an extended GPR even when the
+ * legacy decoder has no index. A missing base remains missing. */
+static void updateSIBRegisters(cs_x86 *x86, const InternalInstruction *inter)
+{
+	const bool rex2 = inter->hasRex2;
+	const uint8_t prefix = rex2 ? inter->rex2Prefix :
+				      inter->vectorExtensionPrefix[1];
+	if (inter->sibBase != SIB_BASE_NONE &&
+	    (rex2 ? b4FromREX2(prefix) : inter->apxEvexB4)) {
+		const unsigned number = 16 | ((rex2 ? b3FromREX2(prefix) :
+						     bFromEVEX2of4(prefix)) << 3) |
+					(inter->sib & 7);
+		x86->sib_base = X86_register_map((unsigned short)
+			X86_featureExtensionMCGPR(number, inter->addressSize));
+	} else {
+		x86->sib_base = x86_map_sib_base(inter->sibBase);
+	}
+
+	if (rex2 ? x4FromREX2(prefix) : inter->apxEvexGprIndex) {
+		const unsigned number = 16 | ((rex2 ? x3FromREX2(prefix) :
+						     xFromEVEX2of4(prefix)) << 3) |
+					((inter->sib >> 3) & 7);
+		x86->sib_index = X86_register_map((unsigned short)
+			X86_featureExtensionMCGPR(number, inter->addressSize));
+	} else {
+		x86->sib_index = x86_map_sib_index(inter->sibIndex);
+	}
+}
