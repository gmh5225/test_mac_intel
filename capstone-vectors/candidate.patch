+			break;
 		default:
 			break;
 		}
 	}
 
-	*regs_read_count = read_count;
-	*regs_write_count = write_count;
+	*regs_read_count = (uint8_t)(read_end - regs_read);
+	*regs_write_count = (uint8_t)(write_end - regs_write);
 }
