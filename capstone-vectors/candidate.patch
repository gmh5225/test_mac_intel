 		}
 
-		if (is16BitEquivalent(instructionID, instructionIDWithOpsize) &&
-		    (decoderMode == MODE_16BIT) ^ insn->hasOpSize) {
+		/* A size-equivalent pair follows the default operand size.
+		 * A different legacy XMM form selected by 66 instead uses
+		 * that byte as part of its opcode, also in 16-bit mode. */
+		const bool sizeEquivalent = is16BitEquivalent(
+			instructionID, instructionIDWithOpsize);
+		bool useOpSize = sizeEquivalent &&
+				 ((decoderMode == MODE_16BIT) ^ insn->hasOpSize);
+		if (!sizeEquivalent && decoderMode == MODE_16BIT &&
+		    insn->hasOpSize && !insn->repeatPrefix &&
+		    insn->opcodeType != ONEBYTE &&
+		    instructionIDWithOpsize != instructionID) {
+			const struct InstructionSpecifier *alt =
+				specifierForUID(instructionIDWithOpsize);
+			useOpSize = hasLegacyXmmOperand(alt->operands);
+#ifndef CAPSTONE_X86_REDUCE
+			/* For 66 0F 78 a reserved EXTRQ selector must not
+			 * fall back to the unprefixed register VMREAD form. */
+			if (!instructionIDWithOpsize &&
+			    instructionID == X86_VMREAD32rr)
+				return -1;
+#endif
+		}
+		if (useOpSize) {
 			insn->instructionID = instructionIDWithOpsize;
 			insn->spec = specifierForUID(instructionIDWithOpsize);
 		} else {
@@ -1598,11 +1622,23 @@ getIDForMode(struct InternalInstruction *insn, cs_mode mode,
 	return 0;
 }
 
+/* The 16-bit compatibility path performs its own operand-size and mandatory
+ * prefix selection. Keep one copy outside the scan and full decode loops. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static int getID16(struct InternalInstruction *insn, cs_mode mode)
+{
+	return getIDForMode(insn, mode, MODE_16BIT);
+}
+
 X86_DECODE_INLINE int getIDSlow(struct InternalInstruction *insn, cs_mode mode)
 {
 	switch (insn->mode) {
 	case MODE_16BIT:
-		return getIDForMode(insn, mode, MODE_16BIT);
+		return getID16(insn, mode);
 	case MODE_32BIT:
 		return getIDForMode(insn, mode, MODE_32BIT);
 	default:
