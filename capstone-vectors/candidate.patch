diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1c3fc1e2..b71e1e23 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1087,8 +1087,22 @@ target_include_directories(capstone_build_settings INTERFACE
 )
 set_property(TARGET capstone PROPERTY POSITION_INDEPENDENT_CODE ON)
 
+# The mixed fixed-record path needs both address-mode readers at link time.
+set(capstone_mixed_x86_readers "")
+if(capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV"
+   AND CMAKE_C_COMPILER_ID MATCHES "Clang" AND CMAKE_SIZEOF_VOID_P EQUAL 8
+   AND NOT CAPSTONE_BUILD_DIET AND NOT CAPSTONE_X86_REDUCE)
+    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CAPSTONE_BUILD_STATIC_LIBS AND NOT CAPSTONE_BUILD_SHARED_LIBS)
+        set(capstone_mixed_x86_readers CAPSTONE_STATIC_X86_READERS)
+    elseif(CAPSTONE_BUILD_SHARED_LIBS AND NOT CAPSTONE_BUILD_STATIC_LIBS
+           AND (CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR
+                (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|arm64|aarch64)$")))
+        set(capstone_mixed_x86_readers CAPSTONE_SHARED_X86_READERS)
+    endif()
+endif()
+
 # The x86-only public iterator uses the fixed-mode readers in both library forms.
-if(CAPSTONE_X86_SUPPORT AND (CAPSTONE_BUILD_STATIC_LIBS OR CAPSTONE_BUILD_CSTEST OR capstone_enabled_architectures STREQUAL "X86"))
+if(CAPSTONE_X86_SUPPORT AND (CAPSTONE_BUILD_STATIC_LIBS OR CAPSTONE_BUILD_CSTEST OR capstone_enabled_architectures STREQUAL "X86" OR capstone_mixed_x86_readers))
     add_library(capstone_x86_iter32 OBJECT arch/X86/X86Vex32Output.c)
     target_link_libraries(capstone_x86_iter32 PRIVATE capstone_build_settings)
     set_target_properties(capstone_x86_iter32 PROPERTIES C_STANDARD 99 POSITION_INDEPENDENT_CODE ON)
@@ -1101,15 +1115,11 @@ if(CAPSTONE_X86_SUPPORT AND (CAPSTONE_BUILD_STATIC_LIBS OR CAPSTONE_BUILD_CSTEST
     add_library(capstone_x86_native OBJECT arch/X86/X86MemoryFallback32.c arch/X86/X86BatchScan.c arch/X86/X86VectorFallback64.c arch/X86/X86VexRegisterImmediate.c arch/X86/X86PlainEvexOutput.c arch/X86/X86RegisterFallback32.c)
     target_link_libraries(capstone_x86_native PRIVATE capstone_build_settings)
     set_target_properties(capstone_x86_native PROPERTIES C_STANDARD 99 POSITION_INDEPENDENT_CODE ON)
-    if(capstone_enabled_architectures STREQUAL "X86" OR
-       (capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV"
-        AND CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_C_COMPILER_ID MATCHES "Clang"
-        AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CAPSTONE_BUILD_STATIC_LIBS AND NOT CAPSTONE_BUILD_SHARED_LIBS
-        AND NOT CAPSTONE_BUILD_DIET AND NOT CAPSTONE_X86_REDUCE))
+    if(capstone_enabled_architectures STREQUAL "X86" OR capstone_mixed_x86_readers)
         if(capstone_enabled_architectures STREQUAL "X86")
             target_sources(capstone_x86_native PRIVATE arch/X86/X86PublicOutput.c)
         else()
-            target_compile_definitions(capstone_build_settings INTERFACE CAPSTONE_STATIC_X86_READERS)
+            target_compile_definitions(capstone_build_settings INTERFACE ${capstone_mixed_x86_readers})
         endif()
         set(capstone_x86_objects
             $<TARGET_OBJECTS:capstone_x86_iter32> $<TARGET_OBJECTS:capstone_x86_iter64>
diff --git a/Makefile b/Makefile
index fafc61bf..b74b5222 100644
--- a/Makefile
+++ b/Makefile
@@ -315,6 +315,11 @@ ifeq ($(sort $(CAPSTONE_ARCHS)),x86)
 	LIBOBJ_X86_STATIC_OUTPUT += $(OBJDIR)/arch/X86/X86PublicOutput.o
 else ifeq ($(MIXED_STORAGE_TARGET):$(CAPSTONE_STATIC):$(CAPSTONE_SHARED):$(CAPSTONE_DIET):$(CAPSTONE_X86_REDUCE),macos:yes:no:no:no)
 	CFLAGS += -DCAPSTONE_STATIC_X86_READERS
+else ifeq ($(CAPSTONE_STATIC):$(CAPSTONE_SHARED):$(CAPSTONE_DIET):$(CAPSTONE_X86_REDUCE),no:yes:no:no)
+ifneq ($(filter macos linux-arm64 linux-amd64,$(MIXED_STORAGE_TARGET)),)
+	CFLAGS += -DCAPSTONE_SHARED_X86_READERS
+	MIXED_SHARED_X86_READERS := yes
+endif
 endif
 	LIBOBJ_X86_NUMBERS += $(OBJDIR)/arch/X86/X86IntelInstPrinterNumbers.o
 endif
@@ -475,6 +480,8 @@ LIBOBJ_SHARED := $(LIBOBJ) $(OBJDIR)/AliasPatternLookup.o $(MCINST_STORAGE_OBJ)
 LIBOBJ += $(LIBOBJ_X86_STATIC_OUTPUT) $(OBJDIR)/AliasPatternLookup.o $(MCINST_STORAGE_OBJ) $(ARM_FORMAT_CHAR_OBJ)
 ifeq ($(sort $(CAPSTONE_ARCHS)),x86)
 LIBOBJ_SHARED := $(LIBOBJ)
+else ifeq ($(MIXED_SHARED_X86_READERS),yes)
+LIBOBJ_SHARED := $(LIBOBJ)
 endif
 
 
