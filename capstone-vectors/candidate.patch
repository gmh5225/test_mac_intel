+	for (unsigned index = names[hash & mask].first; index;) {
+		const ppc_alias_name *entry = &names[index - 1];
+		size_t matched = 0;
+		while (matched < length && entry->name[matched] == name[matched])
+			++matched;
+		if (matched == length && !entry->name[matched]) {
