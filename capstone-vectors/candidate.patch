diff --git a/arch/X86/X86SimpleOutputImpl.h b/arch/X86/X86SimpleOutputImpl.h
index 21414e7a..8973ae44 100644
--- a/arch/X86/X86SimpleOutputImpl.h
+++ b/arch/X86/X86SimpleOutputImpl.h
@@ -54,6 +54,22 @@ bool X86_trySimpleOutput(cs_struct *handle, const uint8_t *code, size_t size,
 #else
 	const bool wide = handle->mode == CS_MODE_64;
 #endif
+#if defined(X86_FIXED_OUTPUT) && X86_FIXED_WIDE
+	/* Start with the unprefixed row. REX and 0F occupy empty slots in
+	 * that row and need a second byte to select their opcode map. */
+	uint8_t opcode = code[0], rex = 0;
+	unsigned prefix_class = 0;
+	unsigned plan = x86_simple_plans[1][0][opcode];
+	if (!plan && ((opcode & 0xf0) == 0x40 || opcode == 0x0f)) {
+		if (size < 2)
+			return false;
+		rex = opcode == 0x0f ? 0 : opcode;
+		prefix_class = rex ? 1 + ((rex >> 3) & 1) : 3;
+		opcode = code[1];
+		plan = x86_simple_plans[1][prefix_class][opcode];
+	}
+	const bool has_rex = rex != 0;
+#else
 	const bool has_rex = wide && (code[0] & 0xf0) == 0x40;
 	const uint8_t rex = has_rex ? code[0] : 0;
 	const bool escaped = code[0] == 0x0f;
@@ -65,6 +81,7 @@ bool X86_trySimpleOutput(cs_struct *handle, const uint8_t *code, size_t size,
 				      has_rex ? ((rex & 8) ? 2 : 1) :
 						0;
 	const unsigned plan = x86_simple_plans[wide][prefix_class][opcode];
+#endif
 	if (!plan) {
 #ifdef X86_OUTPUT_MISS
 		return X86_OUTPUT_MISS(handle, code, size, insn, insn_size);
@@ -256,7 +273,7 @@ bool X86_trySimpleOutput(cs_struct *handle, const uint8_t *code, size_t size,
 				      first, second);
 		if (relative) {
 			cs_x86 *x = &insn->detail->x86;
-			if (escaped) {
+			if (prefix_class == 3) {
 				x->opcode[0] = 0x0f;
 				x->opcode[1] = opcode;
 			}
diff --git a/suite/synctools/x86_simple_output.cpp b/suite/synctools/x86_simple_output.cpp
index b202bca4..385eeda8 100644
--- a/suite/synctools/x86_simple_output.cpp
+++ b/suite/synctools/x86_simple_output.cpp
@@ -1356,6 +1356,11 @@ int main(int argc, char **argv)
 		}
 	}
 	add_rex_stack(x64, regs, plans, rows, checked, admitted);
+	// The AMD64 first-byte lookup reserves the escape and REX opcodes.
+	for (unsigned first = 0; first < 256; ++first) {
+		if ((first == 0x0f || (first & 0xf0) == 0x40) && plans[1][0][first] != 0)
+			throw std::runtime_error("AMD64 prefix has an unprefixed output plan");
+	}
 	if (test32) {
 		emit_test32(plans, regs, rows);
 		return 0;
