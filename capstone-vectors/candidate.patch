diff --git a/CMakeLists.txt b/CMakeLists.txt
index cea06480..e899be96 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1092,6 +1092,8 @@ if(capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV"
     if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
         set_property(SOURCE arch/X86/X86VectorFallback64.c APPEND PROPERTY
             COMPILE_DEFINITIONS "$<$<CONFIG:Release>:X86_FIXED_MASKED_SUFFIX>")
+        set_property(SOURCE arch/X86/X86DisassemblerDecoder.c APPEND PROPERTY
+            COMPILE_DEFINITIONS "$<$<CONFIG:Release>:X86_LINKED_PUBLIC_READER>")
     endif()
 endif()
 add_library(capstone OBJECT ${ALL_SOURCES} ${capstone_storage_source} ${capstone_arm_char_source} ${ALL_HEADERS})
diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 197453cb..1c13d889 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3753,6 +3753,23 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 					  cs_insn *insn, uint16_t *insn_size,
 					  bool batch);
 
+#if defined(X86_LINKED_PUBLIC_READER) && !defined(CAPSTONE_DIET) && \
+	!defined(CAPSTONE_X86_REDUCE) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#define X86_HAS_LINKED_READER
+/* A caller using only the public API need not extract the native readers. */
+#pragma weak X86_disasmIterText
+static inline bool hasLinkedIntelReader(const cs_struct *handle)
+{
+	return handle->arch == CS_ARCH_X86 && !handle->no_text &&
+	       (handle->mode == CS_MODE_32 || handle->mode == CS_MODE_64) &&
+	       (handle->syntax == CS_OPT_SYNTAX_DEFAULT ||
+		handle->syntax == CS_OPT_SYNTAX_INTEL) &&
+	       X86_disasmIterText != NULL;
+}
+#endif
+
 #ifdef CAPSTONE_X86_PUBLIC_OUTPUT
 #define CS_DECODE_OUTPUT_MISS X86_decodePublicRecord
 #elif defined(CAPSTONE_X86_PUBLIC_FIXED_RECORD)
@@ -3800,6 +3817,11 @@ X86_DECODE_ALIGN
 bool CAPSTONE_API cs_disasm_iter(csh ud, const uint8_t **code, size_t *size,
 				 uint64_t *address, cs_insn *insn)
 {
+#ifdef X86_HAS_LINKED_READER
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (*size && handle && hasLinkedIntelReader(handle))
+		return X86_disasmIterText(ud, code, size, address, insn);
+#endif
 	return cs_disasm_iter_core(ud, code, size, address, insn);
 }
 
