+/* Copy just the active registers without a variable-length library call. */
+static inline void copyImplicitRegisters(uint16_t *dst, const uint16_t *src,
+					 unsigned count)
+{
+	while (count) {
+		--count;
+		dst[count] = src[count];
+	}
+}
