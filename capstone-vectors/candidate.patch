+// Group 3 register forms differ in their implicit effects. Verify each
+// row against all eight explicit registers before sharing it.
+void emit_group3_registers(Decoder &decoder, const RegisterTable &regs)
+{
+	std::cout << "/* Generated by x86_simple_output.cpp --group3-registers32. */\n"
+		     "static const struct X86SimpleOutput group3_registers[2][6] = {\n";
+	for (uint8_t opcode : { 0xf6, 0xf7 }) {
+		std::cout << "\t{\n";
+		for (unsigned digit = 2; digit < 8; ++digit) {
+			CheckedRow row;
+			for (unsigned rm = 0; rm < 8; ++rm) {
+				const uint8_t modrm = uint8_t(0xc0 | digit << 3 | rm);
+				decode_pair(decoder, 0, opcode, modrm);
+				cs_insn insn = *decoder.insn;
+				cs_detail detail = *insn.detail;
+				const auto &reg = regs[(opcode & 1) ? 2 : 0][rm];
+				auto &x = detail.x86;
+				if (x.op_count != 1 || x.operands[0].type != X86_OP_REG ||
+				    unsigned(x.operands[0].reg) != reg.reg ||
+				    std::strcmp(insn.op_str, reg.name))
+					throw std::runtime_error("unexpected group 3 operand");
+				// The runtime register table supplies this operand's ID and name.
+				insn.detail = &detail;
+				insn.op_str[0] = '\0';
+				x.operands[0].reg = X86_REG_INVALID;
+				row.observe(describe(insn, opcode, 0, modrm, nullptr, nullptr));
+			}
+			std::cout << "\t\t" << row.fields << ",\n";
+		}
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+}
+
 CheckedRow check_fixed(Decoder &decoder, unsigned opcode)
 {
 	CheckedRow row;
