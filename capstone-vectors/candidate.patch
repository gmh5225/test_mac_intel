+{
+	uint64_t cached_flags = UINT64_MAX, fallback_flags = UINT64_MAX;
+	const uint8_t *cached = X86_get_op_access(arch, id, &cached_flags);
+	const uint8_t *fallback = X86_get_op_access(NULL, id, &fallback_flags);
