diff --git a/arch/X86/X86MemoryFallback32.c b/arch/X86/X86MemoryFallback32.c
index cffc4e81..349f4c5b 100644
--- a/arch/X86/X86MemoryFallback32.c
+++ b/arch/X86/X86MemoryFallback32.c
@@ -33,6 +33,50 @@
 #undef X86_SEGMENT_LEA32
 #undef X86_MEMORY32_OUTPUT
 
+#ifdef X86_I386_CONDITION_OUTPUT
+#include "X86ConditionIDs.h"
+
+/* Short Jcc already has the same condition suffix and EFLAGS mask. Only
+ * the assigned instruction ID and the register operands differ by family. */
+static __attribute__((noinline)) void writeConditionRegisters32(
+	const uint8_t *code, cs_insn *insn, uint16_t *insn_size)
+{
+	static const uint16_t set_ids[] = X86_CONDITION_IDS(X86_INS_SET);
+	const unsigned opcode = code[1], cc = opcode & 15, mr = code[2];
+	const unsigned plan = x86_simple_plans[0][0][0x70 + cc];
+	const struct X86SimpleOutput *condition = &x86_simple_outputs[plan >> 2];
+	const struct X86SimpleRegister *reg = &x86_simple_registers[0][mr & 7];
+
+	insn->id = set_ids[cc];
+	*insn_size = insn->size = 3;
+	memcpy(insn->bytes, code, 3);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, "set", 3);
+	memcpy(insn->mnemonic + 3, condition->mnemonic + 1,
+	       sizeof(condition->mnemonic) - 1);
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, reg->name, sizeof(reg->name));
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		d->regs_read[0] = X86_REG_EFLAGS;
+		d->regs_read_count = 1;
+		cs_x86 *x = &d->x86;
+		x->opcode[0] = 0x0f;
+		x->opcode[1] = (uint8_t)opcode;
+		x->addr_size = 4;
+		x->modrm = (uint8_t)mr;
+		x->encoding.modrm_offset = 2;
+		x->eflags = condition->flags;
+		x->op_count = 1;
+		x->operands[0].type = X86_OP_REG;
+		x->operands[0].reg = (x86_reg)reg->reg;
+		x->operands[0].size = 1;
+		x->operands[0].access = CS_AC_WRITE;
+	}
+}
+#endif
+
 /* The fixed-width iterator delegates uncommon encodings here. */
 CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
 X86_decodeOutputMiss32(cs_struct *handle, const uint8_t *code, size_t size,
@@ -40,6 +84,16 @@ X86_decodeOutputMiss32(cs_struct *handle, const uint8_t *code, size_t size,
 {
 	const unsigned opcode = code[0];
 	switch (opcode) {
+#ifdef X86_I386_CONDITION_OUTPUT
+	case 0x0f:
+		if (size >= 3 && code[2] >= 0xc0 &&
+		    (code[1] & 0xf0) == 0x90 &&
+		    !X86_OUTPUT_UNSUPPORTED(handle, false)) {
+			writeConditionRegisters32(code, insn, insn_size);
+			return true;
+		}
+		break;
+#endif
 	case 0xc4:
 		if (X86_writeVexRegisterImmediate(handle, code, size, insn,
 						  insn_size, x86_simple_registers, false))
diff --git a/tests/unit/x86_simple_output.c b/tests/unit/x86_simple_output.c
index 24af6a88..77f5fda3 100644
--- a/tests/unit/x86_simple_output.c
+++ b/tests/unit/x86_simple_output.c
@@ -1114,6 +1114,21 @@ static bool check_vex_register_immediates(csh handles[2], cs_mode mode)
 	return true;
 }
 
+static bool check_condition_registers32(csh handles[2])
+{
+	const uint8_t starts[] = { 0x40, 0x90 };
+	for (unsigned i = 0; i < sizeof(starts); ++i)
+		for (unsigned cc = 0; cc < 16; ++cc)
+			for (unsigned mr = 0xc0; mr <= 0xff; ++mr) {
+				const uint8_t bytes[] = { 0x0f,
+					(uint8_t)(starts[i] + cc), (uint8_t)mr };
+				if (!compare(handles, bytes, sizeof(bytes), mr) ||
+				    !compare(handles, bytes, cc % 3, mr))
+					return false;
+			}
+	return true;
+}
+
 static bool check_vex32_register_moves(csh handles[2])
 {
 	for (unsigned flags = 0; flags < 256; ++flags)
@@ -1671,6 +1686,7 @@ static bool check_mode(cs_mode mode)
