+static bool check_inc_dec_registers(csh handles[2])
+{
+	for (unsigned rex = 0; rex <= 16; ++rex) {
+		for (unsigned mr = 0xc0; mr < 0xd0; ++mr) {
+			for (unsigned opcode = 0xfe; opcode <= 0xff; ++opcode) {
+				uint8_t code[] = { rex ? (uint8_t)(0x3f + rex) : 0,
+						   (uint8_t)opcode, (uint8_t)mr };
+				const unsigned skip = !rex;
+				if (!compare(handles, code + skip, sizeof(code) - skip, 0x8000))
+					return false;
+			}
+		}
+	}
+	return true;
+}
+
+static bool check_group1_memory_immediates(csh handles[2])
+{
+	for (unsigned group = 0; group < 8; ++group) {
+		const uint8_t opcodes[] = { 0x80, 0x81, 0x83 };
+		for (unsigned i = 0; i < sizeof(opcodes); ++i) {
+			uint8_t code[] = { opcodes[i], (uint8_t)(0x44 | group << 3),
+					   0x8b, 0xf8, 0x80, 0xff, 0xff, 0xff };
+			for (size_t n = 1; n <= sizeof(code); ++n)
+				if (!compare(handles, code, n, 0x8000u + group))
+					return false;
+		}
+	}
+	return true;
+}
