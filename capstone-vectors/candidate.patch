+#ifdef X86_MEMORY32_OUTPUT
+/* A fixed i386 form has one opcode byte. The generated row owns the complete
+ * Intel spelling and implicit effects, including those of INT3 and RET. */
+static bool writeFixed32(cs_insn *insn, uint16_t *insn_size,
+			 const struct X86SimpleOutput *row,
+			 uint8_t first_byte, uint8_t opcode)
+{
+	insn->id = row->id;
+	insn->bytes[0] = first_byte;
+	*insn_size = insn->size = 1;
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->mnemonic + sizeof(row->mnemonic), 0,
+	       sizeof(insn->mnemonic) - sizeof(row->mnemonic));
+	memcpy(insn->op_str, row->operands, sizeof(row->operands));
+	memset(insn->op_str + sizeof(row->operands), 0,
+	       sizeof(insn->op_str) - sizeof(row->operands));
+	if (insn->detail)
+		X86_writeSimpleDetail(insn->detail, row, opcode, 0, 0,
+				      row->ops[0].reg, row->ops[1].reg);
+	return true;
+}
+#endif
