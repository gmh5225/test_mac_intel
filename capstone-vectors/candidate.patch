diff --git a/arch/X86/X86FeatureExtension.h b/arch/X86/X86FeatureExtension.h
index 4d34d8ac..a37d6bd6 100644
--- a/arch/X86/X86FeatureExtension.h
+++ b/arch/X86/X86FeatureExtension.h
@@ -317,6 +317,17 @@ X86_decodeFeatureExtensionSlow(csh handle, const uint8_t *code,
 	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
 	!defined(_WIN32_WCE)
 #define X86_EVEX_REGISTER_SCAN
+/* The raw caller supplies flat_insn. Canonical projections write every
+ * returned scan field directly; only the original reader needs this state. */
+static inline void X86_initScanMCInst(csh ud, MCInst *instr)
+{
+	instr->Opcode = 0;
+	instr->OpcodePub = 0;
+	instr->size = 0;
+	instr->popcode_adjust = 0;
+	instr->csh = (cs_struct *)(uintptr_t)ud;
+	instr->address = instr->flat_insn->address;
+}
 CAPSTONE_INTERNAL x86_feature_decode_result
 X86_decodeScanFeatureExtension(csh handle, const uint8_t *code, size_t code_len,
 			       MCInst *instr, uint16_t *size, uint8_t opcode);
