+void emit_bit_test_registers(Decoder &x32, Decoder &x64, const RegisterTable &regs)
+{
+	std::cout << "/* Generated by x86_simple_output.cpp --bit-test-registers. */\n"
+		     "static const struct X86SimpleOutput x86_bit_test_registers[3][4] = {\n";
+	unsigned encodings = 0;
+	for (unsigned bank = 0; bank < 3; ++bank) {
+		std::cout << "\t{\n";
+		for (unsigned opcode : { 0xa3, 0xab, 0xb3, 0xbb }) {
+			CheckedRow row;
+			const unsigned first = bank == 2 ? 0x48 : 0;
+			const unsigned last = bank == 0 ? 0 : bank == 1 ? 0x47 : 0x4f;
+			for (unsigned rex = first; rex <= last; ++rex) {
+				if (rex && rex < 0x40)
+					continue;
+				for (unsigned mr = 0xc0; mr <= 0xff; ++mr) {
+					const uint8_t bytes[] = { uint8_t(rex), 0x0f, uint8_t(opcode), uint8_t(mr) };
+					Decoder &decoder = bank ? x64 : x32;
+					const unsigned length = 3 + (rex != 0);
+					decoder.decode(bytes + !rex, length, length, 0x4000);
+					const auto *names = regs[bank == 2 ? 3 : 2];
+					const auto &dest = names[(mr & 7) | ((rex & 1) << 3)];
+					const auto &index = names[((mr >> 3) & 7) | ((rex & 4) << 1)];
+					row.observe(describe(*decoder.insn, uint8_t(opcode), uint8_t(rex),
+							     uint8_t(mr), &dest, &index, false, false, true));
+				}
+			}
+			encodings += row.encodings;
+			std::cout << "\t\t" << row.fields << ",\n";
+		}
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+	std::cerr << encodings << " canonical bit-test register encodings\n";
+}
+
