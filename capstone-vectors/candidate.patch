+#ifndef CAPSTONE_DIET
+/* Implicit operands occupy their final slots after printing. The mapping
+ * ends at the first zero; CS_AC_IGNORE denotes a real slot with no access. */
+static void set_final_operand_access(MCInst *MI)
+{
+	cs_x86 *x86 = &MI->flat_insn->detail->x86;
+	const uint8_t *access =
+		X86_get_op_access(MI->csh, MCInst_getOpcode(MI), &x86->eflags);
+	const unsigned int count = MIN(x86->op_count, CS_X86_MAXIMUM_OPERAND_SIZE);
+	unsigned int i = 0;
+	if (access) {
+		for (; i < count && access[i]; ++i)
+			x86->operands[i].access =
+				access[i] == CS_AC_IGNORE ? 0 : access[i];
+	}
+	for (; i < count; ++i)
+		x86->operands[i].access = 0;
+}
+#endif
+
