diff --git a/arch/X86/X86DoubleShiftOutput.h b/arch/X86/X86DoubleShiftOutput.h
new file mode 100644
index 00000000..1bf0ddde
--- /dev/null
+++ b/arch/X86/X86DoubleShiftOutput.h
@@ -0,0 +1,93 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_DOUBLE_SHIFT_OUTPUT_H
+#define CS_X86_DOUBLE_SHIFT_OUTPUT_H
+
+#include "X86OutputOptions.h"
+#include "X86SimpleOutput.h"
+#include "X86UnsignedImmediate.h"
+
+/* SHLD and SHRD have the same register operands and flag effects. The
+ * low opcode bit selects CL in place of the immediate shift count. */
+static inline bool writeDoubleShift(cs_struct *handle, const uint8_t *code,
+				    size_t size, cs_insn *insn,
+				    uint16_t *insn_size, uint8_t rex,
+				    uint8_t address_size,
+				    const struct X86SimpleRegister *regs)
+{
+	const unsigned prefix = rex != 0;
+	if (size < prefix + 3 || code[prefix] != 0x0f ||
+	    (code[prefix + 1] & 0xf6) != 0xa4)
+		return false;
+	const uint8_t opcode = code[prefix + 1], modrm = code[prefix + 2];
+	const bool immediate = !(opcode & 1);
+	const unsigned length = prefix + 3 + immediate;
+	if (modrm < 0xc0 || size < length ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+
+	const struct X86SimpleRegister *dest =
+		&regs[(modrm & 7) | ((rex & 1) << 3)];
+	const struct X86SimpleRegister *src =
+		&regs[((modrm >> 3) & 7) | ((rex & 4) << 1)];
+	const bool right = (opcode & 8) != 0;
+	insn->id = right ? X86_INS_SHRD : X86_INS_SHLD;
+	insn->size = *insn_size = (uint16_t)length;
+	memcpy(insn->bytes, code, length);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, right ? "shrd" : "shld", 4);
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = insn->op_str;
+	memcpy(out, dest->name, sizeof(dest->name));
+	out += dest->length;
+	memcpy(out, ", ", 2);
+	memcpy(out + 2, src->name, sizeof(src->name));
+	out += 2 + src->length;
+	memcpy(out, ", ", 2);
+	if (immediate)
+		writeUnsignedImmediate(out + 2, code[length - 1]);
+	else
+		memcpy(out + 2, "cl", 2);
+
+	if (insn->detail) {
+		cs_detail *detail = insn->detail;
+		memset(detail, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		detail->regs_write[0] = X86_REG_EFLAGS;
+		detail->regs_write_count = 1;
+		cs_x86 *x = &detail->x86;
+		x->opcode[0] = 0x0f;
+		x->opcode[1] = opcode;
+		x->rex = rex;
+		x->addr_size = address_size;
+		x->modrm = modrm;
+		x->encoding.modrm_offset = (uint8_t)(prefix + 2);
+		x->eflags = X86_EFLAGS_UNDEFINED_OF | X86_EFLAGS_MODIFY_SF |
+			    X86_EFLAGS_MODIFY_ZF | X86_EFLAGS_UNDEFINED_AF |
+			    X86_EFLAGS_MODIFY_PF | X86_EFLAGS_MODIFY_CF;
+		x->op_count = 3;
+		cs_x86_op *ops = x->operands;
+		ops[0].type = ops[1].type = X86_OP_REG;
+		ops[0].reg = (x86_reg)dest->reg;
+		ops[1].reg = (x86_reg)src->reg;
+		ops[0].size = ops[1].size = (rex & 8) ? 8 : 4;
+		ops[0].access = (cs_ac_type)(CS_AC_READ | CS_AC_WRITE);
+		ops[1].access = CS_AC_READ;
+		ops[2].size = 1;
+		if (immediate) {
+			x->encoding.imm_offset = (uint8_t)(length - 1);
+			x->encoding.imm_size = 1;
+			ops[2].type = X86_OP_IMM;
+			ops[2].imm = code[length - 1];
+		} else {
+			detail->regs_read[0] = X86_REG_CL;
+			detail->regs_read_count = 1;
+			ops[2].type = X86_OP_REG;
+			ops[2].reg = X86_REG_CL;
+			ops[2].access = CS_AC_READ;
+		}
+	}
+	return true;
+}
+
+#endif
