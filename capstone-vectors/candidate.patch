--- a/AliasPatternLookup.c
+++ b/AliasPatternLookup.c
@@ -26,6 +26,14 @@ typedef struct {
 
 /* The matcher accepts a suffix of its sorted table and owns all operand,
  * feature and alias-printing decisions. */
+static inline const char *matchAliasRow(MCInst *MI, const AliasMatchingData *data,
+					unsigned row)
+{
+	AliasMatchingData suffix = *data;
+	suffix.OpToPatterns += row;
+	return matchAliasPatterns(MI, &suffix);
+}
+
 static inline const char *matchAliasBlock(MCInst *MI, const AliasMatchingData *data,
 					  unsigned offset, const AliasOpcodeBlock *blocks,
 					  size_t block_count)
@@ -37,9 +45,8 @@ static inline const char *matchAliasBlock(MCInst *MI, const AliasMatchingData *d
 	const AliasOpcodeBlock block = blocks[index];
 	if (!(block.mask & bit))
 		return NULL;
-	AliasMatchingData suffix = *data;
-	suffix.OpToPatterns += block.first_row + CountPopulation_32(block.mask & (bit - 1));
-	return matchAliasPatterns(MI, &suffix);
+	return matchAliasRow(MI, data, block.first_row +
+					      CountPopulation_32(block.mask & (bit - 1)));
 }
 
 #ifdef CAPSTONE_HAS_AARCH64
@@ -57,8 +64,12 @@ const char *matchAArch64AliasPatterns(MCInst *MI, const AliasMatchingData *data)
 ALIAS_PATTERN_CODE
 const char *matchMipsAliasPatterns(MCInst *MI, const AliasMatchingData *data)
 {
-	return matchAliasBlock(MI, data, MI->Opcode - Mips_FIRST_ALIAS_OPCODE,
-			       Mips_alias_blocks, ARR_SIZE(Mips_alias_blocks));
+	const unsigned offset = MI->Opcode - Mips_FIRST_ALIAS_OPCODE;
+	const unsigned block = offset / 16;
+	if (block >= ARR_SIZE(Mips_alias_pages))
+		return NULL;
+	const unsigned row = Mips_alias_rows[Mips_alias_pages[block]][offset % 16];
+	return row ? matchAliasRow(MI, data, row - 1) : NULL;
 }
 #endif
 
