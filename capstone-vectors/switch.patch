+		uint8_t((ll << 5) | ((src & 16) ? 0 : 8)),
+		uint8_t(opcode),
+		uint8_t(((dst & 7) << 3) | 5),
+		uint8_t(disp),
+		uint8_t(disp >> 8),
+		uint8_t(disp >> 16),
+		uint8_t(disp >> 24)
+	};
