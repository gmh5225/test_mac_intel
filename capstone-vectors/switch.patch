+		return false;
+	return matches_vector_memory_record(*decoder.insn, code, 4, ll, dst, src,
+			  0x40 | (w << 3) | ((~unsigned(code[1]) >> 5) & 7),
+			  displacement, suffix, row, X86_REG_RIP, "rip", 4);
