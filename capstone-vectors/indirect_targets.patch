 	std::cout << "};\n";
 }
 
+// Near indirect register and memory targets have the same access and implicit
+// effects. Check the whole row for every REX and every register, including
+// cases where the extension bits do not participate in operand selection.
+void emit_indirect64(Decoder &decoder, const RegisterTable &regs)
+{
+	std::cout
+		<< "/* Generated by x86_simple_output.cpp --indirect64. */\n"
+		<< "static const struct X86SimpleOutput x86_indirect64[2][2] = {\n";
+	for (unsigned prefix = 0; prefix < 2; ++prefix) {
+		std::cout << "\t{\n";
+		for (unsigned group : { 2u, 4u }) {
+			const unsigned id = group == 2 ? X86_INS_CALL :
+							 X86_INS_JMP;
+			auto row = check_ff_memory(decoder, prefix, regs, true,
+						   group, id);
+			if (prefix)
+				row.observe(check_ff_memory(decoder, 2, regs,
+							    true, group, id)
+						    .fields);
+			const unsigned first = prefix ? 0x40 : 0;
+			const unsigned last = prefix ? 0x4f : 0;
+			for (unsigned rex = first; rex <= last; ++rex) {
+				for (unsigned rm = 0; rm < 8; ++rm) {
+					const uint8_t mr =
+						uint8_t(0xc0 | group << 3 | rm);
+					decode_pair(decoder, rex, 0xff, mr);
+					cs_insn projected = *decoder.insn;
+					cs_detail detail = *projected.detail;
+					projected.detail = &detail;
+					auto &op = detail.x86.operands[0];
+					const auto &reg =
+						regs[3][(rex & 1) << 3 | rm];
+					if (projected.id != id ||
+					    detail.x86.op_count != 1 ||
+					    op.type != X86_OP_REG ||
+					    unsigned(op.reg) != reg.reg ||
+					    std::strcmp(projected.op_str,
+							reg.name))
+						throw std::runtime_error(
+							"unexpected near indirect register target");
+					op.reg = X86_REG_INVALID;
+					projected.op_str[0] = 0;
+					row.observe(describe(projected, 0xff,
+							     uint8_t(rex), mr,
+							     nullptr, nullptr));
+				}
+			}
+			std::cout << "\t\t" << row.fields << ",\n";
+		}
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+}
+
 } // namespace
 
