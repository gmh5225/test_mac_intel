+#ifdef X86_COMPARE_MEMORY
+static bool writeCompareMemory(cs_struct *handle, const uint8_t *code,
+			       size_t size, cs_insn *insn, uint16_t *insn_size,
+			       unsigned prefix_class)
+{
+	const unsigned lead = prefix_class != 0;
+	if (size < lead + 2 || code[lead + 1] >= 0xc0 ||
+	    (code[lead + 1] & 0x38) != 0x38 ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
