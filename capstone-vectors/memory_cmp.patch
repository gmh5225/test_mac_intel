+	const unsigned row = x86_simple_plans[X86_FIXED_WIDE][prefix_class]
+					     [0x38 | (code[lead] & 1)] >>
+			     2;
+	return X86_COMPARE_MEMORY(code, size, insn, insn_size,
+				  &x86_simple_outputs[row],
+				  x86_simple_registers);
+}
