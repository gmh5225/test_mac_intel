+// Derive the table from complete ordinary records for all four rounding modes.
+void emit_rounded_fma(Decoder &decoder)
+{
+	const char *const suffix[] = { "{rn-sae}", "{rd-sae}", "{ru-sae}",
+				       "{rz-sae}" };
+	const x86_avx_rm modes[] = { X86_AVX_RM_RN, X86_AVX_RM_RD,
+				     X86_AVX_RM_RU, X86_AVX_RM_RZ };
+	std::puts(
+		"/* Generated by suite/synctools/x86_vector_output.cpp --evex64-rounded-fma. */\n"
+		"struct X86RoundedFma { uint16_t id; char mnemonic[16]; };\n"
+		"static const struct X86RoundedFma evex64_rounded_fma[3][4][2] = {");
+	for (unsigned first : { 0x98u, 0xa8u, 0xb8u }) {
+		std::puts("\t{");
+		for (unsigned opcode = first; opcode <= first + 6;
+		     opcode += 2) {
+			std::puts("\t\t{");
+			for (unsigned w = 0; w < 2; ++w) {
+				if (output_record(decoder, { 2, opcode, false },
+						  w, 2)
+					    .empty())
+					throw std::runtime_error(
+						"missing packed EVEX FMA");
+				const unsigned id = decoder.insn->id;
+				const std::string mnemonic =
+					decoder.insn->mnemonic;
+				for (unsigned rc = 0; rc < 4; ++rc) {
+					const uint8_t code[] = {
+						0x62,
+						0xf2,
+						uint8_t(w << 7 | 0x6d),
+						uint8_t(rc << 5 | 0x18),
+						uint8_t(opcode),
+						0xd9
+					};
+					cs_detail expected{};
+					cs_x86 &x = expected.x86;
+					std::memcpy(x.opcode, code, 4);
+					x.addr_size = 8;
+					x.rex = uint8_t(0x40 | w << 3);
+					x.modrm = code[5];
+					x.encoding.modrm_offset = 5;
+					x.avx_sae = true;
+					x.avx_rm = modes[rc];
+					x.op_count = 3;
+					for (unsigned n = 0; n < 3; ++n) {
+						auto &op = x.operands[n];
+						op.type = X86_OP_REG;
+						op.reg = x86_reg(X86_REG_ZMM3 -
+								 n);
+						op.size = 64;
+						op.access =
+							n ? CS_AC_READ :
+							    cs_ac_type(
+								    CS_AC_READ |
+								    CS_AC_WRITE);
+					}
+					if (decoder.decode(
+						    code, sizeof(code)) != id ||
+					    decoder.insn->mnemonic !=
+						    mnemonic ||
+					    decoder.insn->op_str !=
+						    std::string(
+							    "zmm3, zmm2, zmm1, ") +
+							    suffix[rc] ||
+					    std::memcmp(&expected,
+							decoder.insn->detail,
+							offsetof(cs_detail,
+								 x86) +
+								sizeof(cs_x86)))
+						throw std::runtime_error(
+							"unexpected rounded FMA record");
+				}
+				std::printf("\t\t\t{ %s, \"%s\" },\n",
+					    decoder.symbol(id).c_str(),
+					    mnemonic.c_str());
+			}
+			std::puts("\t\t},");
+		}
+		std::puts("\t},");
+	}
+	std::puts("};");
+}
