+static bool check_rounded_fma(csh handles[2])
+{
+	/* Exercise the private writer and the ordinary decoder on neighbouring
+	 * opcodes, extended registers, every rounding mode and prefix misses. */
+	for (unsigned op = 0x97; op <= 0xbf; ++op) {
+		for (unsigned rc = 0; rc < 4; ++rc) {
+			for (unsigned ext = 0; ext < 32; ++ext) {
+				for (unsigned tail = 0; tail < 8; ++tail) {
+					uint8_t code[] = {
+						0x62,
+						(uint8_t)((ext << 4) | 2),
+						(uint8_t)(((ext ^ tail) << 3) |
+							  5),
+						(uint8_t)(0x10 | (rc << 5) |
+							  ((ext >> 1) & 8)),
+						(uint8_t)op,
+						(uint8_t)(0xc0 | (tail << 3) |
+							  (ext & 7))
+					};
+					const uint8_t p2 = code[3],
+						      mr = code[5];
+					if (!compare(handles, code, 5, op) ||
+					    !compare(handles, code,
+						     sizeof(code), ext))
+						return false;
+					code[3] = p2 | 1;
+					if (!compare(handles, code,
+						     sizeof(code), tail))
+						return false;
+					code[3] |= 0x80;
+					if (!compare(handles, code,
+						     sizeof(code), rc))
+						return false;
+					code[3] = p2;
+					code[5] = mr & 0x3f;
+					if (!compare(handles, code,
+						     sizeof(code), ext ^ op))
+						return false;
+				}
+			}
