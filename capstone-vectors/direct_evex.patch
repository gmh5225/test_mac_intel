+/* In the register form EVEX.b selects embedded rounding. L'L supplies the
+ * rounding mode and the operands are always three ZMM registers. */
+static bool writeRoundedFma64(const uint8_t *code, cs_insn *insn,
+			      uint16_t *insn_size)
+{
+	const unsigned opcode = code[4];
+	if ((code[1] & 15) != 2 || (code[2] & 7) != 5 || (code[3] & 0x87) ||
+	    opcode < 0x98 || opcode > 0xbe || (opcode & 9) != 8)
+		return false;
+	const unsigned w = code[2] >> 7, rc = (code[3] >> 5) & 3;
+	const struct X86RoundedFma *row =
+		&evex64_rounded_fma[(opcode >> 4) - 9][(opcode & 6) >> 1][w];
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & 7;
+	unsigned regs[3];
+	evexVectorRegisters(code, rxb, regs);
+	*insn_size = insn->size = 6;
+	insn->id = row->id;
+	memcpy(insn->bytes, code, 6);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = writeVectorRegister(insn->op_str, 2, regs[0]);
+	for (unsigned i = 1; i < 3; ++i) {
+		memcpy(out, ", ", 2);
+		out = writeVectorRegister(out + 2, 2, regs[i]);
+	}
+	static const char suffix[][11] = { ", {rn-sae}", ", {rd-sae}",
+					   ", {ru-sae}", ", {rz-sae}" };
+	memcpy(out, suffix[rc], sizeof(suffix[rc]));
+	if (insn->detail) {
+		static const x86_avx_rm modes[] = { X86_AVX_RM_RN,
+						    X86_AVX_RM_RD,
+						    X86_AVX_RM_RU,
+						    X86_AVX_RM_RZ };
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		cs_x86 *x = &d->x86;
+		memcpy(x->opcode, code, 4);
+		x->addr_size = 8;
+		x->rex = (uint8_t)(0x40 | (w << 3) | rxb);
+		x->modrm = code[5];
+		x->encoding.modrm_offset = 5;
+		x->avx_sae = true;
+		x->avx_rm = modes[rc];
+		x->op_count = 3;
+		for (unsigned i = 0; i < 3; ++i) {
+			cs_x86_op *op = &x->operands[i];
+			op->type = X86_OP_REG;
+			op->reg = (x86_reg)(X86_REG_ZMM0 + regs[i]);
+			op->size = 64;
+			op->access = i ? CS_AC_READ :
+					 (cs_ac_type)(CS_AC_READ | CS_AC_WRITE);
+		}
+	}
+	return true;
+}
+
+/* The private opcode plan already recognized a bare EVEX lead byte. */
+static bool writeEvex64(const uint8_t *code, size_t size, cs_insn *insn,
+			uint16_t *insn_size)
+{
+	if (size < 6)
+		return false;
+	if (code[5] >= 0xc0) {
+		/* The ordinary register writer rejects EVEX.b; only the
+		 * generated embedded-rounding rows can accept it here. */
+		if (code[3] & 0x10)
+			return writeRoundedFma64(code, insn, insn_size);
+	}
+#ifdef CAPSTONE_X86_EVEX_MEMORY_OUTPUT
+	else
+		return X86_writeEvexMemoryDispatch(code, size, insn, insn_size,
+						   x86_simple_registers[3]);
+#endif
+	return X86_writeEvexOutput(code, size, insn, insn_size,
+				   x86_simple_registers[3]);
+}
