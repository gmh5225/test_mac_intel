diff --git a/tests/unit/x86_evex_vpcmp_id.c b/tests/unit/x86_evex_vpcmp_id.c
index dfa9b451..fb1ac515 100644
--- a/tests/unit/x86_evex_vpcmp_id.c
+++ b/tests/unit/x86_evex_vpcmp_id.c
@@ -52,6 +52,16 @@ static bool test_vpcmp(csh handle, bool expect_detail)
 	}
 
 	cs_free(insn, count);
+	if (!check(cs_option(handle, CS_OPT_TEXT, CS_OPT_OFF) == CS_ERR_OK,
+		   "disable text for the same predicate"))
+		return false;
+	insn = NULL;
+	count = cs_disasm(handle, code, sizeof(code), 0x1000, 1, &insn);
+	success &= check(count == 1 && insn[0].id == X86_INS_VPCMPD,
+			 "unformatted predicate keeps its element-family ID");
+	cs_free(insn, count);
+	success &= check(cs_option(handle, CS_OPT_TEXT, CS_OPT_ON) == CS_ERR_OK,
+			 "restore text");
 	return success;
 }
 
