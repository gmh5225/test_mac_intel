diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6050d7c2..38c9127c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -238,7 +238,15 @@ option(CAPSTONE_MIPS_FINAL_OUTPUT_TRIM "Remove leading whitespace once at the MI
 option(CAPSTONE_MIPS_PRECHECK_PRINTED_ALIAS "Check the MIPS printer alias flag before calling the isolated mnemonic lookup" OFF)
 option(CAPSTONE_X86_REDUCE "x86 with reduce instruction sets to minimize library" OFF)
 option(CAPSTONE_X86_ATT_DISABLE "Disable x86 AT&T syntax" OFF)
-option(CAPSTONE_X86_NEAR_INDIRECT_OUTPUT "Enable near CALL/JMP output in the static x86-64 iterator" OFF)
+set(capstone_default_near_indirect OFF)
+if(capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV"
+   AND CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_C_COMPILER_ID STREQUAL "Clang"
+   AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$"
+   AND CAPSTONE_BUILD_STATIC_LIBS AND NOT CAPSTONE_BUILD_SHARED_LIBS
+   AND NOT CAPSTONE_BUILD_DIET AND NOT CAPSTONE_X86_REDUCE)
+    set(capstone_default_near_indirect ON)
+endif()
+option(CAPSTONE_X86_NEAR_INDIRECT_OUTPUT "Enable near CALL/JMP output in the static x86-64 iterator" ${capstone_default_near_indirect})
 option(CAPSTONE_X86_SCAN_ADAPTER "Build the private x86 scan adapter hook" OFF)
 option(CAPSTONE_OSXKERNEL_SUPPORT "Support to embed Capstone into OS X Kernel extensions" OFF)
 
diff --git a/Makefile b/Makefile
index 06b05013..c02c8c3d 100644
--- a/Makefile
+++ b/Makefile
@@ -133,6 +133,9 @@ ifneq ($(filter macos linux-arm64,$(MIXED_STORAGE_TARGET)),)
 CFLAGS += -DCAPSTONE_MIXED_CONSTRUCTED_OPERANDS
 MCINST_STORAGE_OBJ = $(OBJDIR)/MCInstStorage.o
 endif
+ifeq ($(MIXED_STORAGE_TARGET):$(CAPSTONE_STATIC):$(CAPSTONE_SHARED):$(CAPSTONE_DIET):$(CAPSTONE_X86_REDUCE),linux-arm64:yes:no:no:no)
+CAPSTONE_X86_NEAR_INDIRECT_OUTPUT ?= yes
+endif
 ifeq ($(MIXED_STORAGE_TARGET):$(CAPSTONE_DIET),linux-amd64:no)
 CFLAGS += -DCAPSTONE_ARM_FORMAT_PUNCTUATION_X64
 ARM_FORMAT_CHAR_OBJ = $(OBJDIR)/arch/ARM/ARMFormattedChar.o
@@ -727,6 +730,10 @@ $(OBJDIR)/arch/X86/X86ImmediateOutput.o $(OBJDIR)/arch/X86/X86MemoryOutput.o $(O
 endif
 endif
 
+ifeq ($(CAPSTONE_X86_NEAR_INDIRECT_OUTPUT),yes)
+$(OBJDIR)/arch/X86/X86Sse64Output.o: CFLAGS += -DCAPSTONE_X86_NEAR_INDIRECT_OUTPUT
+endif
+
 $(OBJDIR)/%.o: %.c
 	@mkdir -p $(@D)
 ifeq ($(V),0)
diff --git a/arch/X86/X86MemoryOutputImpl.h b/arch/X86/X86MemoryOutputImpl.h
index 11582041..4aa1c79a 100644
--- a/arch/X86/X86MemoryOutputImpl.h
+++ b/arch/X86/X86MemoryOutputImpl.h
@@ -4,7 +4,9 @@
 /* Instantiated for the ordinary address writer and the private mode-specific writers. */
 
 /* No-base SIB and encodings exposing EIZ/RIZ retain the general printer. */
-#ifdef X86_MEMORY_IMMEDIATE
+#ifdef X86_RIP_INDIRECT64
+static bool X86_RIP_INDIRECT64(
+#elif defined(X86_MEMORY_IMMEDIATE)
 #include "X86UnsignedImmediate.h"
 static bool X86_MEMORY_IMMEDIATE(
 #elif defined(X86_SEGMENT_LEA32)
@@ -22,6 +24,12 @@ bool X86_writeMemoryOutput(
 	const struct X86SimpleOutput *row,
 	const struct X86SimpleRegister regs[4][16])
 {
+#ifdef X86_RIP_INDIRECT64
+	/* Bare FF /2 and /4 with mod=00 and r/m=101 have a disp32 tail. */
+	const bool wide = true;
+	const uint8_t rex = 0, opcode = 0xff, modrm = code[1];
+	const unsigned lead = 0, mod = 0, rm = 5;
+#else
 #ifdef X86_MEMORY_IMMEDIATE
 	const bool wide = X86_IMMEDIATE_WIDE;
 #elif defined(X86_EXTEND64_MEMORY)
@@ -41,6 +49,7 @@ bool X86_writeMemoryOutput(
 #endif
 	const uint8_t opcode = code[lead], modrm = code[lead + 1];
 	const unsigned mod = modrm >> 6, rm = modrm & 7;
+#endif
 	const bool sib = rm == 4, disp32_only = !mod && rm == 5;
 	const unsigned offset = lead + 2 + sib;
 	const unsigned disp_size = mod == 2 || disp32_only ? 4 : mod;
diff --git a/arch/X86/X86Sse64Output.c b/arch/X86/X86Sse64Output.c
index 7afca7e4..44681b27 100644
--- a/arch/X86/X86Sse64Output.c
+++ b/arch/X86/X86Sse64Output.c
@@ -64,6 +64,9 @@ static bool writeExtend64(const uint8_t *code, size_t size, cs_insn *insn,
 
 #ifdef CAPSTONE_X86_NEAR_INDIRECT_OUTPUT
 #include "X86GenIndirect64Output.inc"
+#define X86_RIP_INDIRECT64 writeRipIndirect64
+#include "X86MemoryOutputImpl.h"
+#undef X86_RIP_INDIRECT64
 
 /* FF /2 and /4 have one explicit 64-bit target. The register and memory
  * forms share their generated access, implicit register and group records. */
@@ -72,6 +75,9 @@ static bool writeIndirect64(const uint8_t *code, size_t size, cs_insn *insn,
 {
 	const struct X86SimpleOutput *row =
 		&x86_indirect64[rex != 0][(modrm & 0x20) != 0];
+	if (!rex && (modrm == 0x15 || modrm == 0x25))
+		return writeRipIndirect64(code, size, insn, insn_size, row,
+					  x86_simple_registers);
 	if (modrm < 0xc0)
 		return X86_writeMemoryOutput(code, size, insn, insn_size, row,
 					     x86_simple_registers);
