 	return true;
 }
 
+#ifdef CAPSTONE_X86_MIXED_PUBLIC_RECORD
+__attribute__((section(".cs_x86_public_output_text")))
+CS_PRESERVE_MOST bool
+X86_decodeMixedPublicRecord(cs_struct *handle, const uint8_t *code, size_t size,
+			    cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+	if (handle->arch == CS_ARCH_X86) {
+		if (!batch && !handle->no_text && !handle->skipdata &&
+		    (handle->syntax == CS_OPT_SYNTAX_DEFAULT ||
+		     handle->syntax == CS_OPT_SYNTAX_INTEL)) {
+			if (handle->mode == CS_MODE_32)
+				return X86_decodeFixedRecord32(handle, code, size,
+							       insn, insn_size);
+			if (handle->mode == CS_MODE_64)
+				return X86_decodeFixedRecord64(handle, code, size,
+							       insn, insn_size);
+		}
+	}
+	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
+}
+#endif
