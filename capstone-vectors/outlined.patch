-			      &MI->flat_insn->detail->x86.eflags);
-		for (uint8_t i = 0; i < MI->flat_insn->detail->x86.op_count &&
-				    i < ARR_SIZE(access);
-		     i++) {
-			MI->flat_insn->detail->x86.operands[i].access =
-				access[i];
-		}
+		set_final_operand_access(MI);
 #endif
