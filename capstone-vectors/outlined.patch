+#define X86_FIXED_INDIRECT_MEMORY64
 #endif
 
 /* Only the bare VEX2 opcode plan enters here. Packed base-relative
@@ -159,6 +163,20 @@ static bool writeExtraOutput64(cs_struct *handle, const uint8_t *code,
 	}
 	if (primary != 0x0f) {
 		const uint8_t mr = code[has_rex + 1];
+#ifdef CAPSTONE_X86_ONLY
