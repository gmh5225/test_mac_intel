 /* The generated records describe the same register operands and implicit
  * effects as the ordinary Intel printer. Only the public x86 prefix of the
@@ -163,14 +164,21 @@ static inline char *X86_writeDisplacement(char *out, int32_t displacement)
 	out += 5;
 	uint32_t magnitude = displacement < 0 ? 0u - (uint32_t)displacement :
 						(uint32_t)displacement;
-	char digits[8], *start = digits + sizeof(digits);
-	do {
-		*--start = "0123456789abcdef"[magnitude & 15];
-		magnitude >>= 4;
-	} while (magnitude);
-	const size_t length = (size_t)(digits + sizeof(digits) - start);
-	memcpy(out, start, length);
-	return out + length;
+	static const char digits[] = "0123456789abcdef";
+	/* The magnitude is nonzero. Write exactly its significant nibbles so
+	 * the caller can append the next part at the returned position. */
+	char *const end = out + (8 - CountLeadingZeros_32(magnitude) / 4);
+	char *p = end;
+	while (magnitude >= 256) {
+		p -= 2;
+		p[0] = digits[(magnitude >> 4) & 15];
+		p[1] = digits[magnitude & 15];
+		magnitude >>= 8;
+	}
+	if (magnitude >= 16)
+		*out++ = digits[magnitude >> 4];
+	*out = digits[magnitude & 15];
+	return end;
 }
 
