diff --git a/CMakeLists.txt b/CMakeLists.txt
index 396ab047..7f9695f0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1088,7 +1088,9 @@ if(CAPSTONE_X86_SUPPORT AND (CAPSTONE_BUILD_STATIC_LIBS OR CAPSTONE_BUILD_CSTEST
     set_target_properties(capstone_x86_native PROPERTIES C_STANDARD 99 POSITION_INDEPENDENT_CODE ON)
     if(capstone_enabled_architectures STREQUAL "X86" OR
        (capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV"
-        AND CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_C_COMPILER_ID MATCHES "Clang"
+        AND (CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR
+             (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|aarch64|arm64)$"))
+        AND CMAKE_C_COMPILER_ID MATCHES "Clang"
         AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CAPSTONE_BUILD_STATIC_LIBS AND NOT CAPSTONE_BUILD_SHARED_LIBS
         AND NOT CAPSTONE_BUILD_DIET AND NOT CAPSTONE_X86_REDUCE))
         if(capstone_enabled_architectures STREQUAL "X86")
diff --git a/Makefile b/Makefile
index fb13d941..8fe7c4fa 100644
--- a/Makefile
+++ b/Makefile
@@ -127,8 +127,9 @@ MIXED_STORAGE_TARGET := $(shell $(CC) $(CPPFLAGS) $(CFLAGS) -dM -E -x c - < /dev
 	awk '$$2 == "__clang__" { clang_cc=1 } $$2 == "__SIZEOF_POINTER__" { ptr=$$3 } \
 	     $$2 == "__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__" { macos=1 } \
 	     $$2 == "__linux__" { linux_target=1 } $$2 == "__aarch64__" { arm64=1 } \
-	     END { if (clang_cc && ptr==8 && (macos || (linux_target && arm64))) print macos ? "macos" : "linux-arm64" }')
-ifneq ($(MIXED_STORAGE_TARGET),)
+	     $$2 == "__x86_64__" { amd64=1 } \
+	     END { if (clang_cc && ptr==8) { if (macos) print "macos"; else if (linux_target && arm64) print "linux-arm64"; else if (linux_target && amd64) print "linux-amd64" } }')
+ifneq ($(filter macos linux-arm64,$(MIXED_STORAGE_TARGET)),)
 CFLAGS += -DCAPSTONE_MIXED_CONSTRUCTED_OPERANDS
 MCINST_STORAGE_OBJ = $(OBJDIR)/MCInstStorage.o
 endif
@@ -304,8 +305,10 @@ endif
 	LIBOBJ_X86_STATIC_OUTPUT = $(OBJDIR)/arch/X86/X86Vex32Output.o $(OBJDIR)/arch/X86/X86Sse64Output.o $(OBJDIR)/arch/X86/X86MemoryFallback32.o $(OBJDIR)/arch/X86/X86BatchScan.o $(OBJDIR)/arch/X86/X86VectorFallback64.o $(OBJDIR)/arch/X86/X86VexRegisterImmediate.o $(OBJDIR)/arch/X86/X86PlainEvexOutput.o $(OBJDIR)/arch/X86/X86RegisterFallback32.o
 ifeq ($(sort $(CAPSTONE_ARCHS)),x86)
 	LIBOBJ_X86_STATIC_OUTPUT += $(OBJDIR)/arch/X86/X86PublicOutput.o
-else ifeq ($(MIXED_STORAGE_TARGET):$(CAPSTONE_STATIC):$(CAPSTONE_SHARED):$(CAPSTONE_DIET):$(CAPSTONE_X86_REDUCE),macos:yes:no:no:no)
+else ifeq ($(CAPSTONE_STATIC):$(CAPSTONE_SHARED):$(CAPSTONE_DIET):$(CAPSTONE_X86_REDUCE),yes:no:no:no)
+ifneq ($(filter macos linux-arm64 linux-amd64,$(MIXED_STORAGE_TARGET)),)
 	CFLAGS += -DCAPSTONE_STATIC_X86_READERS
+endif
 endif
 	LIBOBJ_X86_NUMBERS += $(OBJDIR)/arch/X86/X86IntelInstPrinterNumbers.o
 endif
