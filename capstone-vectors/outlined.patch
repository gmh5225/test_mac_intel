diff --git a/arch/X86/X86SimpleOutputImpl.h b/arch/X86/X86SimpleOutputImpl.h
index 21414e7a..930fa43d 100644
--- a/arch/X86/X86SimpleOutputImpl.h
+++ b/arch/X86/X86SimpleOutputImpl.h
@@ -54,6 +54,20 @@ bool X86_trySimpleOutput(cs_struct *handle, const uint8_t *code, size_t size,
 #else
 	const bool wide = handle->mode == CS_MODE_64;
 #endif
+#ifdef X86_FIXED_PRIMARY_CURSOR
+	uint8_t opcode = code[0], rex = 0;
+	unsigned prefix_class = 0;
+	if ((opcode & 0xf0) == 0x40 || opcode == 0x0f) {
+		if (size < 2)
+			return false;
+		rex = opcode == 0x0f ? 0 : opcode;
+		prefix_class = rex ? 1 + ((rex >> 3) & 1) : 3;
+		opcode = code[1];
+	}
+	const bool has_rex = rex != 0;
+	const bool escaped = prefix_class == 3;
+	const unsigned plan = x86_simple_plans[1][prefix_class][opcode];
+#else
 	const bool has_rex = wide && (code[0] & 0xf0) == 0x40;
 	const uint8_t rex = has_rex ? code[0] : 0;
 	const bool escaped = code[0] == 0x0f;
@@ -65,6 +79,7 @@ bool X86_trySimpleOutput(cs_struct *handle, const uint8_t *code, size_t size,
 				      has_rex ? ((rex & 8) ? 2 : 1) :
 						0;
 	const unsigned plan = x86_simple_plans[wide][prefix_class][opcode];
+#endif
 	if (!plan) {
 #ifdef X86_OUTPUT_MISS
 		return X86_OUTPUT_MISS(handle, code, size, insn, insn_size);
