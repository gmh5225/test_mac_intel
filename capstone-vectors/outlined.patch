+static int getID16(struct InternalInstruction *insn, cs_mode mode)
+{
+	if (insn->opcodeType == ONEBYTE && !insn->repeatPrefix &&
+	    insn->vectorExtensionType == TYPE_NO_VEX_XOP) {
+		const uint8_t context = oneByteContext16(insn->opcode);
+		if (context) {
