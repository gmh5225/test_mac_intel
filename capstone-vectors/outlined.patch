@@ -2238,6 +2238,13 @@ void emit_vex_base_memory(Decoder &decoder)
 			plans[map - 1][opcode] = plan;
 		}
 	}
+	/* Mixed readers reuse the register rows for packed FMA3 memory sources.
+	 * Each selected W/L pair must pass the memory comparisons above. */
+	for (unsigned opcode : { 0x98u, 0xa8u, 0xb8u }) {
+		const auto &forms = widths[plans[1][opcode]];
+		if (std::find(forms.begin(), forms.end(), 0u) != forms.end())
+			throw std::runtime_error("missing packed FMA3 memory form");
+	}
 	if (!plans[0][0xfe] || !plans[1][0xa8])
 		throw std::runtime_error("missing VEX integer or FMA memory form");
