+#ifdef CAPSTONE_SSTREAM_PRECHECKED
+/* A bounded Intel stream can emit the separator, register and scale before
+ * publishing its new cursor. Extension names retain their usual writer. */
+static bool printIndexExpression(SStream *stream, const MCOperand *index,
+				 uint64_t scale, bool has_base)
+{
+	const unsigned reg = MCOperand_getReg(index);
+	if (!MCOperand_isReg(index) || reg >= X86_FEATURE_MC_GPR_BASE || scale >= 10)
+		return false;
+
+	const unsigned length = getRegisterNameLength(reg);
+	const char *name = getRegisterName(reg);
+	char *next = stream->buffer + stream->index;
+	if (has_base) {
+		memcpy(next, " + ", 3);
+		next += 3;
+	}
+	memcpy(next, name, length);
+	next += length;
+	if (scale != 1) {
+		*next++ = '*';
+		*next++ = (char)('0' + scale);
+	}
+	*next = '\0';
+	stream->index = (size_t)(next - stream->buffer);
+	return true;
+}
+#endif
