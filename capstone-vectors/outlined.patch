+def emit_equivalent16(suffix):
+    specifiers = instruction_specifiers(
+        (X86 / f"X86GenDisassemblerTables{suffix}.inc").read_text()
+    )
+    targets = defaultdict(set)
+    for original, alternate in equivalents16(suffix):
+        targets[original].add(alternate)
+
+    # The common entry is the alternate UID itself. Only instructions with
+    # multiple size equivalents use a second lookup.
+    indirect = 1 << 15
+    tables.require(len(specifiers) < indirect, "16-bit equivalent UID exceeds storage")
+    direct = [0] * len(specifiers)
+    groups = []
+    for uid, values in sorted(targets.items()):
+        row = sorted(values)
+        tables.require(0 < row[0] <= row[-1] < len(direct), "Invalid size equivalent")
+        if len(row) == 1:
+            direct[uid] = row[0]
+        else:
+            direct[uid] = indirect + len(groups)
+            groups.append(row)
+    tables.require(len(groups) < indirect, "Too many equivalent groups")
+    lines = [
+        "X86_DECODE_INLINE bool is16BitEquivalent(unsigned orig, unsigned equiv)",
+        "{",
+        "\tstatic const uint16_t targets[] = {",
+    ]
+    for start in range(0, len(direct), 16):
+        lines.append("\t\t" + ", ".join(str(v) for v in direct[start : start + 16]) + ",")
+    lines.append("\t};")
+    if groups:
+        width = max(map(len, groups))
+        lines.append(f"\tstatic const uint16_t alternatives[][{width}] = {{")
+        for row in groups:
+            # Repeat a valid target so zero never matches the last slot.
+            padded = row + [row[-1]] * (width - len(row))
+            lines.append("\t\t{ " + ", ".join(map(str, padded)) + " },")
+        lines.extend([
