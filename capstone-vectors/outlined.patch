--- a/arch/X86/X86IntelInstPrinter.c
+++ b/arch/X86/X86IntelInstPrinter.c
@@ -818,6 +818,27 @@ void X86_Intel_printInstructionGeneral(MCInst *MI, SStream *O)
 }
 #endif
 
+#ifndef CAPSTONE_DIET
+/* Implicit operands occupy their final slots after printing. The mapping
+ * ends at the first zero; CS_AC_IGNORE denotes a real slot with no access. */
+static void set_final_operand_access(MCInst *MI)
+{
+	cs_x86 *x86 = &MI->flat_insn->detail->x86;
+	const uint8_t *access =
+		X86_get_op_access(MI->csh, MCInst_getOpcode(MI), &x86->eflags);
+	const unsigned int count = MIN(x86->op_count, CS_X86_MAXIMUM_OPERAND_SIZE);
+	static const uint8_t end = 0;
+	if (!access)
+		access = &end;
+	for (unsigned int i = 0; i < count; ++i) {
+		const uint8_t right = *access;
+		x86->operands[i].access = right == CS_AC_IGNORE ? 0 : right;
+		if (right)
+			++access;
+	}
+}
+#endif
+
 void X86_Intel_printInst(MCInst *MI, SStream *O, void *Info)
 {
 	x86_reg reg = X86_REG_INVALID, reg2;
