index 79adee8d..85936f58 100644
--- a/arch/X86/X86Mapping.c
+++ b/arch/X86/X86Mapping.c
@@ -11990,17 +11990,22 @@ void X86_reg_access(const cs_insn *insn, cs_regs regs_read,
 	read_count = insn->detail->regs_read_count;
 	write_count = insn->detail->regs_write_count;
 
-	// implicit registers
-	if (read_count == 1)
