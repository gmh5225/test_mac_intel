diff --git a/arch/X86/X86IntelInstPrinter.c b/arch/X86/X86IntelInstPrinter.c
index 457485ab..fd4f2ccd 100644
--- a/arch/X86/X86IntelInstPrinter.c
+++ b/arch/X86/X86IntelInstPrinter.c
@@ -1144,6 +1144,52 @@ static void printOperand(MCInst *MI, unsigned OpNo, SStream *O)
 	}
 }
 
+#ifdef CAPSTONE_SSTREAM_PRECHECKED
+/* Both register spellings precede a vector memory operand. This bounded
+ * printer runs with the built-in formatter. Early operand-access callbacks
+ * are inactive and the Intel postprinter supplies the final access flags. */
+static void printRegisterPairBeforeMemory(MCInst *MI, unsigned second, SStream *O)
+{
+	const MCOperand *a = MCInst_getOperand(MI, 0);
+	const MCOperand *b = MCInst_getOperand(MI, second);
+	if (MI->csh->doing_mem) {
+		printOperand(MI, 0, O);
+		SStream_concat0(O, ", ");
+		printOperand(MI, second, O);
+		SStream_concat0(O, ", ");
+		return;
+	}
+	const unsigned first_reg = MCOperand_getReg(a);
+	const unsigned second_reg = MCOperand_getReg(b);
+	printRegName(O, first_reg);
+	SStream_concat0(O, ", ");
+	printRegName(O, second_reg);
+	SStream_concat0(O, ", ");
+	if (!MI->csh->detail_opt && MI->op1_size)
+		return;
+	const unsigned first_public = X86_register_map(first_reg);
+	const uint8_t first_size = MI->csh->regsize_map[first_public];
+	if (!MI->op1_size)
+		MI->op1_size = first_size;
+	if (!MI->csh->detail_opt && MI->op1_size)
+		return;
+	const unsigned second_public = X86_register_map(second_reg);
+	const uint8_t second_size = MI->csh->regsize_map[second_public];
+	if (!MI->op1_size)
+		MI->op1_size = second_size;
+	if (MI->csh->detail_opt) {
+		cs_x86 *x = &MI->flat_insn->detail->x86;
+		cs_x86_op *out = &x->operands[x->op_count];
+		out[0].type = out[1].type = X86_OP_REG;
+		out[0].reg = (x86_reg)first_public;
+		out[0].size = first_size;
+		out[1].reg = (x86_reg)second_public;
+		out[1].size = second_size;
+		x->op_count += 2;
+	}
+}
+#endif
+
