+            "\tconst unsigned target = targets[orig];",
+            "\tif (target & 0x8000u) {",
+            "\t\tconst uint16_t *row = alternatives[target & 0x7fffu];",
+            "\t\tfor (unsigned i = 0; i < ARR_SIZE(alternatives[0]); ++i)",
+            "\t\t\tif (equiv == row[i])",
+            "\t\t\t\treturn true;",
+            "\t\treturn false;",
+            "\t}",
+            "\treturn equiv && target == equiv;",
+        ])
+    else:
+        lines.append("\treturn equiv && targets[orig] == equiv;")
+    return [*lines, "}", ""]
