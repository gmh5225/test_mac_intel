diff --git a/tests/unit/x86_legacy_address_size.c b/tests/unit/x86_legacy_address_size.c
index cfd13cba..c6e087c9 100644
--- a/tests/unit/x86_legacy_address_size.c
+++ b/tests/unit/x86_legacy_address_size.c
@@ -279,9 +279,68 @@ static bool check_other_opcodes(void)
 	return ok;
 }
 
+static bool check_moffs_address(cs_mode mode, cs_opt_value syntax,
+				const char *expected)
+{
+	const uint8_t code[] = { 0xa0, 0x34, 0x82, 0x00, 0x80,
+				 0xec, 0xcd, 0xbc, 0xbc };
+	csh handle;
+	cs_insn *insn = NULL;
+	bool ok = false;
+	if (cs_open(CS_ARCH_X86, mode, &handle) != CS_ERR_OK)
+		return false;
+	cs_err err = cs_option(handle, CS_OPT_SYNTAX, syntax);
+	if (err == CS_ERR_X86_ATT && syntax == CS_OPT_SYNTAX_ATT) {
+		cs_close(&handle);
+		return true;
+	}
+	if (err == CS_ERR_OK) {
+		size_t count = cs_disasm(handle, code, sizeof(code), 0, 1, &insn);
+		ok = count == 1 && insn->size == sizeof(code) &&
+		     strcmp(insn->op_str, expected) == 0;
+		if (!ok)
+			fprintf(stderr, "expected %s, got %s\n", expected,
+				count ? insn->op_str : "(decode failed)");
+		cs_free(insn, count);
+	}
+	cs_close(&handle);
+	return ok;
+}
+
+/* The register map, x87 image size and decoder must agree on the default
+ * bitness both for a new handle and after changing its mode. */
+static bool check_default_bitness(cs_mode vendor, bool change_mode)
+{
+	const uint8_t code[] = { 0x66, 0x48, 0xd9, 0x30 };
+	csh handle;
+	cs_insn *insn = NULL;
+	if (cs_open(CS_ARCH_X86, change_mode ? CS_MODE_32 : vendor, &handle) != CS_ERR_OK)
+		return false;
+	bool ok = (!change_mode || cs_option(handle, CS_OPT_MODE, vendor) == CS_ERR_OK) &&
+		  cs_option(handle, CS_OPT_DETAIL, CS_OPT_ON) == CS_ERR_OK;
+	size_t count = ok ? cs_disasm(handle, code, sizeof(code), 0, 1, &insn) : 0;
+	ok = count == 1 && insn->size == sizeof(code) && insn->id == X86_INS_FNSTENV &&
+	     insn->detail->x86.op_count == 1 && insn->detail->x86.operands[0].size == 28;
+	if (!ok)
+		fprintf(stderr, "wrong default x87 image, vendor=%u changed=%d\n",
+			(unsigned)vendor, change_mode);
+	cs_free(insn, count);
+	cs_close(&handle);
+	return ok;
+}
+
 int main(void)
 {
 	bool ok = check_conversions();
+	ok &= check_default_bitness((cs_mode)0, false);
+	ok &= check_default_bitness(CS_MODE_X86_INTEL, true);
+	ok &= check_default_bitness(CS_MODE_X86_AMD, false);
 	ok &= check_other_opcodes();
+	ok &= check_moffs_address(CS_MODE_64, CS_OPT_SYNTAX_INTEL,
+				  "al, byte ptr [0xbcbccdec80008234]");
+	ok &= check_moffs_address(CS_MODE_64, CS_OPT_SYNTAX_MASM,
+				  "al, byte ptr [0bcbccdec80008234h]");
+	ok &= check_moffs_address((cs_mode)0, CS_OPT_SYNTAX_ATT,
+				  "0xbcbccdec80008234, %al");
 	return ok ? 0 : 1;
 }
