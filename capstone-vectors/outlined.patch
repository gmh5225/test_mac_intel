diff --git a/arch/X86/X86VectorRegisterOutput.h b/arch/X86/X86VectorRegisterOutput.h
index 1f238c20..cb4b1f4e 100644
--- a/arch/X86/X86VectorRegisterOutput.h
+++ b/arch/X86/X86VectorRegisterOutput.h
@@ -16,7 +16,15 @@ static bool writeVectorRegisters(const uint8_t *code, cs_insn *insn,
 	const unsigned len = prefix + 2 + row->immediate;
 	*insn_size = insn->size = (uint16_t)len;
 	insn->id = row->id;
+#ifdef X86_VECTOR_VARIABLE_PREFIX
+	/* The validated register form has a 2-4 byte prefix, opcode and
+	 * ModR/M, and at most one immediate byte. Both copies stay inside
+	 * the resulting 4-7 byte instruction, including at a page boundary. */
+	memcpy(insn->bytes, code, 4);
+	memcpy(insn->bytes + (len - 4), code + (len - 4), 4);
+#else
 	memcpy(insn->bytes, code, len);
+#endif
 	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
 	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
 	memset(insn->op_str, 0, sizeof(insn->op_str));
