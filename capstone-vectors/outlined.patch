diff --git a/suite/synctools/x86_register_name_sizes.py b/suite/synctools/x86_register_name_sizes.py
index d735f83c..b974f073 100644
--- a/suite/synctools/x86_register_name_sizes.py
+++ b/suite/synctools/x86_register_name_sizes.py
@@ -7,6 +7,7 @@ remain authoritative; AT&T and public register-name tables are unchanged.
 """
 
 import argparse
+import json
 from pathlib import Path
 import re
 
@@ -119,6 +120,29 @@ def generate(text, enum_text):
     return result
 
 
+def register_slots(text):
+    strings = string_bytes(text)
+    records = [int(x) for x in TABLE.search(text)[1].split(",") if x.strip()]
+    names = []
+    for record in records:
+        offset = record & MASK
+        length = record >> SHIFT
+        name = strings[offset : offset + length]
+        require(strings[offset + length] == 0 and b"\\0" not in name,
+                "Invalid register spelling")
+        names.append(name.decode("ascii"))
+    lines = [
+        "/* Generated by x86_register_name_sizes.py. */",
+        "static const struct {",
+        "\tchar name[8];",
+        "\tuint8_t length;",
+        "} X86PrinterRegisterNames[] = {",
+    ]
+    lines.extend(f"\t{{ {json.dumps(name)}, {len(name)} }}," for name in names)
+    lines.append("};")
+    return "\n".join(lines) + "\n"
+
+
 def main():
     parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--check", action="store_true")
@@ -134,6 +158,14 @@ def main():
     elif original != expected:
         path.write_text(expected)
 
+    slots = directory / "X86GenPrinterRegisterNames.inc"
+    spelling = register_slots(expected)
+    if args.check:
+        require(slots.is_file() and slots.read_text() == spelling,
+                f"Stale {slots}; rerun {Path(__file__).name}")
+    elif not slots.is_file() or slots.read_text() != spelling:
+        slots.write_text(spelling)
+
 
 if __name__ == "__main__":
     main()
