+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_BIT_TEST_REGISTER_OUTPUT_H
+#define CS_X86_BIT_TEST_REGISTER_OUTPUT_H
+
+#include "X86ExtendRegisterOutput.h"
+#include "X86GenBitTestRegisters.inc"
+
+/* 0F A3/AB/B3/BB share the two-register encoding and operand order.
+ * The generated row owns each instruction's flags and register access. */
+static inline bool writeBitTestRegisters(
+	cs_struct *handle, const uint8_t *code, unsigned length,
+	cs_insn *insn, uint16_t *insn_size, uint8_t rex, unsigned bank,
+	const struct X86SimpleRegister *regs)
+{
+	const uint8_t opcode = code[length - 2], mr = code[length - 1];
+	if ((opcode & 0xe7) != 0xa3 || mr < 0xc0 ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	const unsigned rm = (mr & 7) | ((rex & 1) << 3);
+	const unsigned reg = ((mr >> 3) & 7) | ((rex & 4) << 1);
+	writeExtendRegisters(code, length, insn, insn_size,
+			     &x86_bit_test_registers[bank][(opcode >> 3) & 3],
+			     &regs[rm], &regs[reg], rex, opcode, mr, true);
+	return true;
+}
+
+#endif
