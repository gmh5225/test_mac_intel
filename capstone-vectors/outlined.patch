+	/* Each two-register list fits in one fixed-width copy. */
+	if (read_count == 2 && write_count == 2) {
+		memcpy(regs_read, insn->detail->regs_read, 2 * sizeof(regs_read[0]));
+		memcpy(regs_write, insn->detail->regs_write, 2 * sizeof(regs_write[0]));
+	} else {
+		if (read_count == 1)
+			regs_read[0] = insn->detail->regs_read[0];
+		else if (read_count != 0)
+			memcpy(regs_read, insn->detail->regs_read,
+			       read_count * sizeof(insn->detail->regs_read[0]));
+		if (write_count == 1)
+			regs_write[0] = insn->detail->regs_write[0];
