index 37cb0735..aa62ca83 100644
--- a/suite/synctools/x86_simple_output.cpp
+++ b/suite/synctools/x86_simple_output.cpp
@@ -577,6 +577,36 @@ void emit_register(const X86SimpleRegister &v)
 		  << v.name << "\" },\n";
 }
 
+void emit_stack16(Decoder &real, const RegisterTable &regs)
+{
+	std::cout << "/* Generated by x86_simple_output.cpp --stack16-registers. */\n\n"
+		     "static const struct X86SimpleOutput stack16_rows[2] = {\n";
+	for (unsigned pop = 0; pop < 2; ++pop) {
+		std::string canonical;
+		for (unsigned reg = 0; reg < 8; ++reg) {
+			const uint8_t bytes[] = { 0x66, uint8_t(0x50 + 8 * pop + reg) };
+			real.decode(bytes, 2, 2, 0xfffe);
+			auto &x = real.insn->detail->x86;
+			if (real.insn->id != (pop ? X86_INS_POP : X86_INS_PUSH) ||
+			    x.op_count != 1 || x.operands[0].type != X86_OP_REG ||
+			    x.operands[0].reg != regs[2][reg].reg ||
+			    std::strcmp(real.insn->op_str, regs[2][reg].name) ||
+			    x.prefix[2] != 0x66 || x.addr_size != 2)
+				throw std::runtime_error("unexpected real-mode stack record");
+			// The writer supplies the prefix and encoded register.
+			x.prefix[2] = 0;
+			x.operands[0].reg = X86_REG_INVALID;
+			real.insn->op_str[0] = '\0';
+			const auto row = describe(*real.insn, bytes[1], 0, 0, nullptr, nullptr);
+			if (row.empty() || (reg && row != canonical))
+				throw std::runtime_error("real-mode stack effects differ by register");
+			canonical = row;
+		}
+		std::cout << '\t' << canonical << ",\n";
+	}
+	std::cout << "};\n";
+}
