diff --git a/arch/X86/X86IndirectFallback64.c b/arch/X86/X86IndirectFallback64.c
new file mode 100644
index 00000000..0d81c7aa
--- /dev/null
+++ b/arch/X86/X86IndirectFallback64.c
@@ -0,0 +1,49 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include "../../cs_priv.h"
+#if defined(CAPSTONE_X86_INDIRECT_FALLBACK64) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && !defined(_WIN32_WCE)
+#pragma clang section text = ".cs_x86_indirect64_text" rodata = ".cs_x86_indirect64_rodata"
+#include "../../cs_disasm_internal.h"
+#include "X86OutputOptions.h"
+#include "X86SimpleOutput.h"
+#include "X86GenIndirect64Output.inc"
+
+/* The fixed AMD64 reader has tried the scalar and vector records. */
+CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
+X86_decodeIndirectFallback64(cs_struct *handle, const uint8_t *code,
+			     size_t size, cs_insn *insn, uint16_t *insn_size,
+			     bool batch)
+{
+	if (size >= 6 && code[0] == 0xff &&
+	    (code[1] == 0x15 || code[1] == 0x25) &&
+	    !X86_OUTPUT_UNSUPPORTED(handle, false)) {
+		const struct X86SimpleOutput *row =
+			&x86_indirect64[0][code[1] == 0x25];
+		const int32_t displacement = X86_readDisp32(code + 2);
+		insn->id = row->id;
+		*insn_size = insn->size = 6;
+		memcpy(insn->bytes, code, 6);
+		memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+		memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+		memset(insn->op_str, 0, sizeof(insn->op_str));
+		memcpy(insn->op_str, "qword ptr [rip", 14);
+		*X86_writeDisplacement(insn->op_str + 14, displacement) = ']';
+		if (insn->detail) {
+			X86_writeSimpleDetail(insn->detail, row, 0xff, 0,
+					      code[1], 0, 0);
+			cs_x86 *x = &insn->detail->x86;
+			cs_x86_op *mem = &x->operands[0];
+			mem->type = X86_OP_MEM;
+			mem->mem.base = X86_REG_RIP;
+			mem->mem.scale = 1;
+			mem->mem.disp = x->disp = displacement;
+			x->encoding.disp_offset = 2;
+			x->encoding.disp_size = 4;
+		}
+		return true;
+	}
+	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
+}
+#endif
