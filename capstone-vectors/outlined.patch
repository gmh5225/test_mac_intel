+            if row and context.startswith("IC_VEX"):
+                decisions.update(rows[row - 1])
+    uids = {tables.source_id(ids, kind, offset, modrm)
+            for kind, offset in decisions for modrm in range(256)}
+    return {uid for uid in uids if uid and any(
+        encoding in RM_ENCODINGS and encoding != "ENCODING_RM"
+        for encoding, _ in operand_sets[specifiers[uid]]
+    )}
