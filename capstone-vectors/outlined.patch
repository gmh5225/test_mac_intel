diff --git a/arch/X86/X86VexMemoryFallback64.c b/arch/X86/X86VexMemoryFallback64.c
new file mode 100644
index 00000000..5ff12dbe
--- /dev/null
+++ b/arch/X86/X86VexMemoryFallback64.c
@@ -0,0 +1,163 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifdef CAPSTONE_HAS_X86
+#include "../../cs_priv.h"
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_vex_memory_miss_text" rodata = \
+	".cs_x86_vex_memory_miss_rodata"
+#endif
+#include "../../cs_disasm_internal.h"
+#include "X86OutputOptions.h"
+#include "X86VexBaseMemory.h"
+#include "X86GenSimpleOutput.inc"
+
+struct VexSibTransfer {
+	uint16_t id;
+	char mnemonic[8], memory[12];
+	uint8_t memory_length, reg_size, mem_size, group_count, groups[4];
+	uint8_t access[2][2];
+};
+#include "X86GenVexSibTransfers.inc"
+
+static char *writeTransferRegister(char *out, bool mask, unsigned number)
+{
+	if (!mask)
+		return writeVectorRegister(out, 0, number);
+	*out++ = 'k';
+	*out++ = (char)('0' + number);
+	return out;
+}
+
+/* The caller checked the VEX map and the complete bytes through SIB. */
+static bool writeVexSibTransfer(cs_struct *handle, const uint8_t *code,
+				size_t size, unsigned prefix, cs_insn *insn,
+				uint16_t *insn_size,
+				const struct X86SimpleRegister *regs)
+{
+	/* VEX2 encodes inverted R in bit 7. Its W, X and B bits are zero. */
+	const bool short_prefix = prefix == 2;
+	const unsigned flags = code[prefix - 1] & (short_prefix ? 0x7f : 0xff);
+	const unsigned opcode = code[prefix], mr = code[prefix + 1];
+	const unsigned offset = prefix + 3;
+	if ((flags & 0x7c) != 0x78 ||
+	    (mr & 7) != 4 || mr >= 0xc0)
+		return false;
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & (short_prefix ? 4 : 7);
+	const bool mask = (opcode & 0xfe) == 0x90;
+	unsigned form;
+	if (mask) {
+		/* ModR/M.reg names K0..K7. */
+		if ((flags & 2) || (rxb & 4))
+			return false;
+		form = ((flags >> 6) & 2) | (flags & 1);
+	} else if ((opcode & 0xef) == 0x6e && (flags & 0x83) == 1) {
+		form = 6;
+	} else {
+		if ((opcode & 0xfe) != 0x10 || (flags & 0x82) != 2)
+			return false;
+		form = 4 + (flags & 1);
+	}
+	const unsigned mod = mr >> 6, sib = code[prefix + 2];
+	const unsigned base_number = (sib & 7) | ((rxb & 1) << 3);
+	const unsigned index_number = ((sib >> 3) & 7) | ((rxb & 2) << 2);
+	const unsigned disp_size = mod == 2 ? 4 : mod;
+	/* Leave base-less and pseudo-index spellings to the full printer. */
+	if ((!mod && (sib & 7) == 5) || (index_number == 4 && sib != 0x24) ||
+	    size < offset + disp_size || X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+
+	const int32_t disp = disp_size == 4 ? X86_readDisp32(code + offset) :
+			     disp_size == 1 ? (int8_t)code[offset] : 0;
+	const struct X86SimpleRegister *base = &regs[base_number];
+	const unsigned number = ((mr >> 3) & 7) | ((rxb & 4) << 1);
+	const unsigned store = form == 6 ? (opcode >> 4) & 1 : opcode & 1;
+	const unsigned scale_bits = sib >> 6;
+	const struct VexSibTransfer *row = &vex_sib_transfers[form];
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)(offset + disp_size);
+	memcpy(insn->bytes, code, insn->size);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = insn->op_str;
+	if (!store) {
+		out = writeTransferRegister(out, mask, number);
+		memcpy(out, ", ", 2);
+		out += 2;
+	}
+	memcpy(out, row->memory, sizeof(row->memory));
+	out += row->memory_length;
+	memcpy(out, base->name, sizeof(base->name));
+	out += base->length;
+	if (index_number != 4)
+		out = X86_writeScaledIndex(out, &regs[index_number], scale_bits);
+	out = X86_writeDisplacement(out, disp);
+	*out++ = ']';
+	if (store) {
+		memcpy(out, ", ", 2);
+		writeTransferRegister(out + 2, mask, number);
+	}
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		d->groups_count = row->group_count;
+		memcpy(d->groups, row->groups, sizeof(row->groups));
+		cs_x86 *x = &d->x86;
+		memcpy(x->opcode, code, prefix);
+		x->addr_size = 8;
+		x->rex = (uint8_t)(0x40 | ((flags >> 4) & 8) | rxb);
+		x->modrm = (uint8_t)mr;
+		x->encoding.modrm_offset = (uint8_t)(prefix + 1);
+		x->sib = (uint8_t)sib;
+		x->sib_base = (x86_reg)base->reg;
+		if (index_number != 4)
+			x->sib_index = (x86_reg)regs[index_number].reg;
+		x->sib_scale = (int8_t)(1u << scale_bits);
+		if (disp_size) {
+			x->encoding.disp_offset = (uint8_t)offset;
+			x->encoding.disp_size = (uint8_t)disp_size;
+		}
+		x->op_count = 2;
+		cs_x86_op *reg = &x->operands[store], *mem = &x->operands[!store];
+		reg->type = X86_OP_REG;
+		reg->reg = (x86_reg)((mask ? X86_REG_K0 : X86_REG_XMM0) + number);
+		reg->size = row->reg_size;
+		reg->access = (cs_ac_type)row->access[store][store];
+		mem->type = X86_OP_MEM;
+		mem->mem.base = x->sib_base;
+		mem->mem.index = x->sib_index;
+		mem->mem.scale = x->sib_scale;
+		mem->mem.disp = x->disp = disp;
+		mem->size = row->mem_size;
+		mem->access = (cs_ac_type)row->access[store][!store];
+	}
+	return true;
+}
+
+/* This optional reader only sees misses from the fixed AMD64 path. */
+CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
+X86_decodeVexMemoryFallback64(cs_struct *handle, const uint8_t *code,
+			      size_t size, cs_insn *insn, uint16_t *insn_size,
+			      bool batch)
+{
+	if ((code[0] & 0xfe) == 0xc4) {
+		const unsigned prefix = code[0] == 0xc5 ? 2 : 3;
+		if (size >= prefix + 3 && (prefix == 2 || (code[1] & 31) == 1) &&
+		    writeVexSibTransfer(handle, code, size, prefix, insn, insn_size,
+					x86_simple_registers[3]))
+			return true;
+		if (size >= prefix + 2 && code[prefix + 1] < 0xc0 &&
+		    !X86_OUTPUT_UNSUPPORTED(handle, false) &&
+		    writeVexBaseMemory(code, size, prefix, insn, insn_size,
+				       x86_simple_registers[3]))
+			return true;
+	}
+	__attribute__((musttail)) return cs_decode_full_insn(
+		handle, code, size, insn, insn_size, batch);
+}
+#endif
+#endif
diff --git a/suite/synctools/x86_vector_output.cpp b/suite/synctools/x86_vector_output.cpp
index f0312e90..50321d7a 100644
--- a/suite/synctools/x86_vector_output.cpp
+++ b/suite/synctools/x86_vector_output.cpp
@@ -1367,6 +1367,78 @@ void emit_evex_scan(Decoder &decoder, const std::map<unsigned, WidthRows> &ids)
 	std::puts("static const uint8_t evex_transfer_lengths[32]\n\tX86_EVEX_SECTION(X86_EVEX_TRANSFER_RODATA) = {\n\t6, 6, 6, 6, 0, 10, 6, 6,\n\t7, 7, 7, 7, 8, 7, 7, 7,\n\t10, 10, 10, 10, 11, 10, 10, 10,\n\t6, 6, 6, 6, 6, 6, 6, 6,\n};");
 }
 
+// Both directions of a two-operand transfer use the same mnemonic, register
+// bank and memory width. Keep access in public operand order for each direction.
+void emit_vex_sib_transfers(Decoder &decoder)
+{
+	constexpr uint8_t flags[] = { 0x78, 0x79, 0xf8, 0xf9, 0x7a, 0x7b, 0x79 };
+	std::puts("/* Generated by x86_vector_output.cpp --vex-sib-transfers. */");
+	std::puts("static const struct VexSibTransfer vex_sib_transfers[] = {");
+	for (unsigned form = 0; form < sizeof(flags); ++form) {
+		const bool mask = form < 4;
+		unsigned public_id = 0, reg_size = 0, mem_size = 0, group_count = 0;
+		Bytes4 groups{};
+		std::array<std::array<unsigned, 2>, 2> accesses{};
+		std::string mnemonic, memory;
+		for (unsigned store = 0; store < 2; ++store) {
+			for (unsigned ext = 0; ext < (mask ? 4u : 8u); ++ext) {
+				for (unsigned field = 0; field < 8; ++field) {
+					const uint8_t bytes[] = {
+						0xc4, uint8_t(0xe1 ^ (ext << 5)), flags[form],
+						uint8_t(form == 6 ? 0x6e | (store << 4) :
+							(mask ? 0x90 : 0x10) | store),
+						uint8_t(4 | (field << 3)), 0x58,
+					};
+					unsigned id = decoder.decode(bytes, sizeof(bytes));
+					const auto &insn = *decoder.insn;
+					const cs_detail &detail = *insn.detail;
+					const cs_x86 &x = detail.x86;
+					const cs_x86_op &reg = x.operands[store], &mem = x.operands[!store];
+					const unsigned number = field | ((ext & 4) << 1);
+					if (!id || x.op_count != 2 || reg.type != X86_OP_REG ||
+					    reg.reg != unsigned(mask ? X86_REG_K0 : X86_REG_XMM0) + number ||
+					    mem.type != X86_OP_MEM || detail.groups_count > 4 ||
+					    detail.regs_read_count || detail.regs_write_count || x.eflags ||
+					    insn.illegal || insn.is_alias || insn.usesAliasDetails)
+						throw std::runtime_error("unexpected VEX SIB transfer record");
+					const std::string text(insn.op_str);
+					const auto begin = store ? 0 : text.find(", ") + 2;
+					const auto bracket = text.find('[', begin);
+					if (bracket == std::string::npos || bracket < begin || bracket - begin >= 11 ||
+					    std::strlen(insn.mnemonic) >= 8)
+						throw std::runtime_error("invalid VEX transfer operand prefix");
+					const auto prefix = text.substr(begin, bracket - begin + 1);
+					Bytes4 current{};
+					std::copy_n(detail.groups, detail.groups_count, current.begin());
+					if (!public_id) {
+						public_id = id;
+						reg_size = reg.size;
+						mem_size = mem.size;
+						mnemonic = insn.mnemonic;
+						memory = prefix;
+						group_count = detail.groups_count;
+						groups = current;
+					}
+					if (public_id != id || reg_size != reg.size || mem_size != mem.size ||
+					    mnemonic != insn.mnemonic || memory != prefix || groups != current ||
+					    group_count != detail.groups_count)
+						throw std::runtime_error("VEX transfer shape depends on register or direction");
