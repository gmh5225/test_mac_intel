diff --git a/arch/X86/X86PublicOutputImpl.h b/arch/X86/X86PublicOutputImpl.h
new file mode 100644
index 00000000..f2510463
--- /dev/null
+++ b/arch/X86/X86PublicOutputImpl.h
@@ -0,0 +1,115 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+/* The outer public iterator owns cursor updates and skipdata handling. */
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_public_output_text"
+#endif
+#ifdef CAPSTONE_X86_ARCHIVE_PUBLIC_RECORD
+static __attribute__((noinline)) CS_PRESERVE_MOST bool
+decodePublicTextRecord(cs_struct *handle,
+#else
+CS_PRESERVE_MOST bool X86_decodePublicRecord(cs_struct *handle,
+#endif
+					    const uint8_t *code, size_t size,
+					    cs_insn *insn, uint16_t *length,
+					    bool batch)
+{
+#ifdef CAPSTONE_X86_ARCHIVE_PUBLIC_RECORD
+	if (handle->arch != CS_ARCH_X86 ||
+	    (handle->syntax != CS_OPT_SYNTAX_DEFAULT &&
+	     handle->syntax != CS_OPT_SYNTAX_INTEL))
+		return cs_decode_full_insn(handle, code, size, insn, length, batch);
+#endif
+#ifdef CAPSTONE_X86_DIRECT_PUBLIC_RECORD
+	/* The outer iterator owns detail visibility, skipdata and cursor updates.
+	 * Its fixed text path only needs the decoded record and its length. */
+	if (!batch && !handle->skipdata && !handle->no_text) {
+		if (handle->mode == CS_MODE_32)
+			return X86_decodeFixedRecord32(handle, code, size, insn,
+						       length);
+		if (handle->mode == CS_MODE_64)
+			return X86_decodeFixedRecord64(handle, code, size, insn,
+						       length);
+	}
+#else
+	/* The caller owns skipdata callbacks, bulk boundaries and the public
+	 * cursors. A fixed iterator can fill this one record using local cursors. */
+	if (!batch && !handle->skipdata && !handle->no_text &&
+	    (handle->mode == CS_MODE_32 || handle->mode == CS_MODE_64)) {
+		uint64_t address = insn->address;
+		bool ok = X86_disasmIterText((csh)(uintptr_t)handle, &code,
+					     &size, &address, insn);
+		if (ok)
+			*length = insn->size;
+		return ok;
+	}
+#endif
+	return cs_decode_full_insn(handle, code, size, insn, length, batch);
+}
+
+#ifdef CAPSTONE_X86_ARCHIVE_PUBLIC_RECORD
+#ifdef __clang__
+#define X86_RECORD_TAIL __attribute__((musttail))
+#else
+#define X86_RECORD_TAIL
+#endif
+#include "X86GenStack16Output.inc"
+
+/* The mode gate selected a 16-bit request. One 66 prefix chooses the
+ * 32-bit register bank, while stack effects and address size stay in the row. */
+static __attribute__((noinline)) CS_PRESERVE_MOST bool
+decodePublicRecord16(cs_struct *handle, const uint8_t *code, size_t size,
+		     cs_insn *insn, uint16_t *length, bool batch)
+{
+	if (size >= 6 && code[0] == X86_PREFIX_OPSIZE &&
+	    (code[1] & 0xf8) == 0xb8 && !batch && !handle->skipdata &&
+	    !X86_OUTPUT_UNSUPPORTED(handle, handle->arch != CS_ARCH_X86)) {
+		const uint8_t opcode = code[1];
+		writeUnsignedRegisterImmediate(insn, &stack16_mov32,
+					       &test32_regs[1][opcode & 7],
+					       code, 0, 0, 2, 4, length);
+		if (insn->detail) {
+			insn->detail->x86.opcode[0] = opcode;
+			insn->detail->x86.addr_size = 2;
+			insn->detail->x86.prefix[2] = X86_PREFIX_OPSIZE;
+		}
+		return true;
+	}
+	if (size >= 2 && code[0] == X86_PREFIX_OPSIZE &&
+	    (code[1] & 0xf0) == 0x50 && !batch && !handle->skipdata &&
+	    !X86_OUTPUT_UNSUPPORTED(handle, handle->arch != CS_ARCH_X86)) {
+		const unsigned opcode = code[1];
+		const struct X86SimpleOutput *row = &stack16_rows[(opcode >> 3) & 1];
+		const struct X86SimpleRegister *reg = &test32_regs[1][opcode & 7];
+		insn->id = row->id;
+		insn->size = *length = 2;
+		insn->bytes[0] = X86_PREFIX_OPSIZE;
+		insn->bytes[1] = (uint8_t)opcode;
+		memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+		memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+		memset(insn->op_str, 0, sizeof(insn->op_str));
+		memcpy(insn->op_str, reg->name, sizeof(reg->name));
+		if (insn->detail) {
+			X86_writeSimpleDetail(insn->detail, row, (uint8_t)opcode,
+					      0, 0, reg->reg, 0);
+			insn->detail->x86.prefix[2] = X86_PREFIX_OPSIZE;
+		}
+		return true;
+	}
+	X86_RECORD_TAIL return cs_decode_full_insn(handle, code, size, insn, length, batch);
+}
+
+/* Forward the six arguments without an additional return frame. */
+CS_PRESERVE_MOST bool X86_decodePublicRecord(cs_struct *handle,
+					    const uint8_t *code, size_t size,
+					    cs_insn *insn, uint16_t *length,
+					    bool batch)
+{
+	if (handle->mode == CS_MODE_16)
+		X86_RECORD_TAIL return decodePublicRecord16(handle, code, size, insn, length,
+					   batch);
+	X86_RECORD_TAIL return decodePublicTextRecord(handle, code, size, insn, length, batch);
+}
+#undef X86_RECORD_TAIL
+#endif
