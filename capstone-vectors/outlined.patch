diff --git a/arch/X86/X86Mapping.h b/arch/X86/X86Mapping.h
index 380faa79..0b6a776a 100644
--- a/arch/X86/X86Mapping.h
+++ b/arch/X86/X86Mapping.h
@@ -154,13 +154,22 @@ static inline uint8_t x86_x87_environment_size(cs_mode mode,
 	return (short_environment ? 14 : 28) + (registers ? 80 : 0);
 }
 
-static inline uint64_t x86_get_address_mask(cs_mode mode)
+/* Address-size override affects rendering of a displacement used as the
+ * entire address. Keep the signed displacement in operand detail. */
+static inline uint64_t x86_absolute_address(const MCInst *mi, int64_t disp)
 {
-	if (x86_has_feature(mode, CS_MODE_16))
-		return UINT16_MAX;
-	if (x86_has_feature(mode, CS_MODE_32))
-		return UINT32_MAX;
-	return UINT64_MAX;
+	/* Index with the 16/32 mode bits. If both are set, the decoder
+	 * gives 16-bit mode precedence. The second column is the 67 form. */
+	static const uint8_t shift[][2] = {
+		{ 0, 64 - 32 },       /* 64-bit */
+		{ 64 - 16, 64 - 32 }, /* 16-bit */
+		{ 64 - 32, 64 - 16 }, /* 32-bit */
+		{ 64 - 16, 64 - 32 }, /* 16-bit */
+	};
+	const unsigned mode =
+		(mi->csh->mode & (CS_MODE_16 | CS_MODE_32)) / CS_MODE_16;
+	const unsigned has_override = mi->x86_prefix[3] == X86_PREFIX_ADDRSIZE;
+	return (uint64_t)disp & (UINT64_MAX >> shift[mode][has_override]);
 }
 
 #endif
diff --git a/tests/unit/x86_legacy_address_size.c b/tests/unit/x86_legacy_address_size.c
index cfd13cba..fe231be4 100644
--- a/tests/unit/x86_legacy_address_size.c
+++ b/tests/unit/x86_legacy_address_size.c
@@ -279,9 +279,59 @@ static bool check_other_opcodes(void)
 	return ok;
 }
 
+static bool check_absolute_offsets(void)
+{
+	static const struct {
+		cs_mode mode;
+		uint8_t code[8];
+		uint8_t size;
+		const char *intel, *att;
+	} cases[] = {
+		{ CS_MODE_16, { 0x67, 0x8b, 0x05, 0x34, 0x12, 0x00, 0x80 },
+		  7, "ax, word ptr [0x80001234]", "0x80001234, %ax" },
+		{ CS_MODE_32, { 0x67, 0x8b, 0x06, 0x34, 0x82 },
+		  5, "eax, dword ptr [0x8234]", "0x8234, %eax" },
+		{ CS_MODE_64, { 0x67, 0x8b, 0x04, 0x25, 0x34, 0x12, 0x00, 0x80 },
+		  8, "eax, dword ptr [0x80001234]", "0x80001234, %eax" },
+		/* With no bitness flag the decoder selects 64-bit addressing. */
+		{ (cs_mode)0, { 0x8b, 0x04, 0x25, 0x34, 0x12, 0x00, 0x80 },
+		  7, "eax, dword ptr [0xffffffff80001234]", "0xffffffff80001234, %eax" },
+		{ CS_MODE_64, { 0x8b, 0x04, 0x25, 0x34, 0x12, 0x00, 0x80 },
+		  7, "eax, dword ptr [0xffffffff80001234]", "0xffffffff80001234, %eax" },
+	};
+	bool ok = true;
+	for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i) {
+		csh handle;
+		if (cs_open(CS_ARCH_X86, cases[i].mode, &handle) != CS_ERR_OK)
+			return false;
+		for (unsigned att = 0; att < 2; ++att) {
+			cs_err err = cs_option(handle, CS_OPT_SYNTAX,
+					       att ? CS_OPT_SYNTAX_ATT : CS_OPT_SYNTAX_INTEL);
+			if (att && err == CS_ERR_X86_ATT)
+				continue;
+			cs_insn *insn = NULL;
+			size_t count = cs_disasm(handle, cases[i].code, cases[i].size,
+						 0x1000, 1, &insn);
+			const char *expected = att ? cases[i].att : cases[i].intel;
+			if (err != CS_ERR_OK || count != 1 ||
+			    insn->size != cases[i].size ||
+			    strcmp(insn->op_str, expected) != 0) {
+				fprintf(stderr, "absolute offset mode %u: expected %s, got %s\n",
+					(unsigned)cases[i].mode, expected,
+					count == 1 ? insn->op_str : "(invalid)");
+				ok = false;
+			}
+			cs_free(insn, count);
+		}
+		cs_close(&handle);
+	}
+	return ok;
+}
+
 int main(void)
 {
 	bool ok = check_conversions();
 	ok &= check_other_opcodes();
+	ok &= check_absolute_offsets();
 	return ok ? 0 : 1;
 }
