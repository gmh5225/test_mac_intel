+static bool isVexIFMA(const struct InternalInstruction *insn)
+{
+#ifndef CAPSTONE_X86_REDUCE
+	if (insn->vectorExtensionType != TYPE_VEX_3B ||
+	    insn->opcodeType != THREEBYTE_38 || (insn->opcode & 0xfe) != 0xb4)
+		return false;
+	const uint8_t vex = insn->vectorExtensionPrefix[2];
+	return ppFromVEX3of3(vex) == VEX_PREFIX_66 && wFromVEX3of3(vex);
+#else
+	return false;
+#endif
+}
+
+/* The generated tables predate AVX-IFMA. Its unmasked VEX and EVEX
+ * forms share the operation, printer and access metadata. Only VEX uses
+ * an ordinary disp8, as in the tied three-operand VEX FMA layout. */
+static bool readVexIFMA(struct InternalInstruction *insn)
+{
+#ifndef CAPSTONE_X86_REDUCE
+	static const struct {
+		uint16_t operation[2];
+		uint16_t vexOperands;
+	} forms[2][2] = {
+		{
+			{ { X86_VPMADD52LUQZ128m, X86_VPMADD52HUQZ128m },
+			  X86_VFMADD132PDm },
+			{ { X86_VPMADD52LUQZ128r, X86_VPMADD52HUQZ128r },
+			  X86_VFMADD132PDr },
+		},
+		{
+			{ { X86_VPMADD52LUQZ256m, X86_VPMADD52HUQZ256m },
+			  X86_VFMADD132PDYm },
+			{ { X86_VPMADD52LUQZ256r, X86_VPMADD52HUQZ256r },
+			  X86_VFMADD132PDYr },
+		},
+	};
+	if (readModRM(insn))
+		return false;
+	const unsigned width = lFromVEX3of3(insn->vectorExtensionPrefix[2]);
+	const bool reg = modFromModRM(insn->modRM) == 3;
+	insn->instructionID = forms[width][reg].operation[insn->opcode & 1];
+	insn->spec = specifierForUID(forms[width][reg].vexOperands);
+	return true;
+#else
+	return false;
+#endif
+}
