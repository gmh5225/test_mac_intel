diff --git a/arch/X86/X86EvexMemoryRecord.h b/arch/X86/X86EvexMemoryRecord.h
index 8ce47244..f1a597eb 100644
--- a/arch/X86/X86EvexMemoryRecord.h
+++ b/arch/X86/X86EvexMemoryRecord.h
@@ -73,7 +73,13 @@ bool X86_writeEvexMemoryOutput(const uint8_t *code, size_t size, cs_insn *insn,
 				 0;
 	insn->id = row->id;
 	*insn_size = insn->size = (uint16_t)length;
-	memcpy(insn->bytes, code, length);
+	/* The encoded instruction is 6-11 bytes. The trailing four bytes
+	 * overlap the first word for short forms and follow it for long forms. */
+	if (length <= 8)
+		memcpy(insn->bytes, code, 4);
+	else
+		memcpy(insn->bytes, code, 8);
+	memcpy(insn->bytes + length - 4, code + length - 4, 4);
 	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
 	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
 	memset(insn->op_str, 0, sizeof(insn->op_str));
