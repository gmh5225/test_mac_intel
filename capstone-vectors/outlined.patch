diff --git a/arch/X86/X86ATTRegisterOutput.c b/arch/X86/X86ATTRegisterOutput.c
new file mode 100644
index 00000000..7301dacd
--- /dev/null
+++ b/arch/X86/X86ATTRegisterOutput.c
@@ -0,0 +1,36 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include "../../utils.h"
+#include "X86InstPrinter.h"
+
+#ifdef CAPSTONE_X86_ATT_REGISTER_OUTPUT
+/* The AT&T printer passes one register name with "%%%s". Keeping the
+ * formatted call lets a custom formatter receive the original arguments. */
+#ifdef __ELF__
+__attribute__((section(".cs_x86_att_register_output")))
+#endif
+void X86_ATT_formatRegister(SStream *OS, const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	const char *name = va_arg(args, const char *);
+	va_end(args);
+#if defined(CAPSTONE_USE_SYS_DYN_MEM) && !defined(CAPSTONE_HAS_OSXKERNEL) && \
+	!defined(_KERNEL_MODE) && !defined(_WIN32_WCE)
+	if (cs_vsnprintf == cs_default_vsnprintf && name) {
+		const size_t length = strlen(name);
+		if (length && length < 8 && !OS->is_closed &&
+		    OS->index < SSTREAM_BUF_LEN - 1 - length &&
+		    !(OS->markup_stream && OS->prefixed_by_markup)) {
+			OS->buffer[OS->index++] = '%';
+			SStream_concat0_small(OS, name, length);
+			return;
+		}
+		SStream_concat2(OS, "%", name);
+		return;
+	}
+#endif
+	SStream_concat(OS, fmt, name);
+}
+#endif
