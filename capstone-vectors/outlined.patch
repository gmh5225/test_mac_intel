diff --git a/arch/X86/X86BatchScan.c b/arch/X86/X86BatchScan.c
index b56826b0..408ba90e 100644
--- a/arch/X86/X86BatchScan.c
+++ b/arch/X86/X86BatchScan.c
@@ -158,16 +158,32 @@ static uint32_t readVex3Plan(const uint8_t *code, size_t size)
 	return finishVexPlan(code, size, 4, payload, plan);
 }
 
-static uint32_t readFirst32(const uint8_t *code, size_t size)
+/* Keep the primary loop small. Only escapes and two-byte VEX need a
+ * secondary dispatch in the i386 batch reader. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static uint32_t readEscape32(const uint8_t *code, size_t size)
 {
-	const unsigned plan = x86Batch32Primary[code[0]];
-	if (plan)
-		return readPrimary(code, size, plan);
+	if (code[0] == 0x0f && size >= 2) {
+		const unsigned secondary = x86Batch32Secondary[code[1]];
+		const uint32_t word = secondary ?
+			readPrimary(code + 1, size - 1, secondary) : 0;
+		return word ? word + 1 : 0;
+	}
 	if (code[0] == 0xc5 && size >= 3 && (code[1] & 0xc0) == 0xc0)
 		return readVex2Plan(code, size);
 	return 0;
 }
 
+static uint32_t readFirst32(const uint8_t *code, size_t size)
+{
+	const unsigned plan = x86Batch32Primary[code[0]];
+	return plan ? readPrimary(code, size, plan) : readEscape32(code, size);
+}
+
 /* The offset includes the 0F escape. All extents in the projected
  * descriptors start at the secondary opcode, just as readPrimary expects. */
 static uint32_t readSecondary64(const uint8_t *code, size_t size,
