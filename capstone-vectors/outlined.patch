diff --git a/arch/X86/X86SimpleOutputImpl.h b/arch/X86/X86SimpleOutputImpl.h
index 21414e7a..8cb0409d 100644
--- a/arch/X86/X86SimpleOutputImpl.h
+++ b/arch/X86/X86SimpleOutputImpl.h
@@ -89,6 +89,18 @@ bool X86_trySimpleOutput(cs_struct *handle, const uint8_t *code, size_t size,
 		}
 #endif
 		if (modrm < 0xc0) {
+#ifdef X86_FIXED_RIP_INDIRECT
+			/* FF /2 and /4 with RIP + disp32 have one memory operand. */
+			if (opcode == 0xff && !has_rex &&
+			    (modrm == 0x15 || modrm == 0x25)) {
+				if (X86_OUTPUT_UNSUPPORTED(handle, false))
+					return false;
+				return X86_writeMemoryOutput(
+					code, size, insn, insn_size,
+					&x86_indirect64[0][modrm == 0x25],
+					x86_simple_registers);
+			}
+#endif
 			/* The generated ALU, TEST and MOV register rows also
              * describe their memory forms. XCHG and immediates
              * require different memory records. */
