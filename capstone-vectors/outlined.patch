+/* The decoder tables accept LL=0 for scalar LLIG forms. Select the
+ * architectural exception by opcode map before changing bytes for lookup.
+ * A scalar compare also needs the original LL for its encoding detail. */
+static enum EVEXLengthAction evexLengthAction(const uint8_t *p, size_t size,
+					      bool invalid_prefix)
+{
+	const unsigned opcode = p[4];
+	const unsigned pp = p[2] & 3;
+	const unsigned ll = (p[3] >> 5) & 3;
+	const bool b = (p[3] & 0x10) != 0;
+	const bool memory = p[5] < 0xc0;
+	const unsigned map = p[1] & 7;
+	switch (opcode) {
+	case 0xc2: /* VCMPPS/PD/SS/SD has a trailing predicate. */
+		if (map != 1 || size < 7)
+			return EVEX_KEEP_LENGTH;
+		switch (p[2] & 0x83) {
+		case 0x00:
+		case 0x81:
+			return invalid_prefix || (ll == 3 && !(b && !memory)) ?
+				       EVEX_REJECT_LENGTH :
+				       EVEX_KEEP_LENGTH;
+		case 0x02:
+		case 0x83:
+			if (invalid_prefix || (memory && b) || (!b && ll == 3))
+				return EVEX_REJECT_LENGTH;
+			return !b && ll ? EVEX_CLEAR_COMPARE_LENGTH :
+					  EVEX_KEEP_LENGTH;
+		default:
+			return EVEX_KEEP_LENGTH;
+		}
+	case 0xc8: /* AVX512ER packed and scalar forms. */
+	case 0xca:
+	case 0xcb:
+	case 0xcc:
+	case 0xcd:
+		if (map != 2 || pp != 1)
+			return EVEX_KEEP_LENGTH;
+		if (invalid_prefix)
+			return EVEX_REJECT_LENGTH;
+		if (opcode != 0xcb && opcode != 0xcd)
+			return (b && !memory) || ll == 2 ? EVEX_KEEP_LENGTH :
+							   EVEX_REJECT_LENGTH;
+		if ((memory && b) || (!b && ll == 3))
+			return EVEX_REJECT_LENGTH;
+		return !b && ll ? EVEX_CLEAR_LENGTH : EVEX_KEEP_LENGTH;
+	case 0x4c: /* VRCP14 and VRSQRT14. */
+	case 0x4d:
+	case 0x4e:
+	case 0x4f:
+		if (map != 2 || pp != 1)
+			return EVEX_KEEP_LENGTH;
+		if (invalid_prefix || ll == 3 ||
+		    (b && (!memory || (opcode & 1))))
+			return EVEX_REJECT_LENGTH;
+		return (opcode & 1) && ll ? EVEX_CLEAR_LENGTH :
+					    EVEX_KEEP_LENGTH;
+	case 0x67: /* Scalar VFPCLASS has a trailing immediate. */
+		if (map != 3 || pp != 1 || size < 7)
+			return EVEX_KEEP_LENGTH;
+		if (invalid_prefix || b || ll == 3)
+			return EVEX_REJECT_LENGTH;
+		return ll ? EVEX_CLEAR_LENGTH : EVEX_KEEP_LENGTH;
+	case 0x9b: /* Scalar AVX512_4FMAPS. */
+	case 0xab:
+		if (map != 2 || pp != 3)
+			return EVEX_KEEP_LENGTH;
+		if (invalid_prefix || b || ll == 3 ||
+		    ((p[3] & 0x80) && !(p[3] & 7)))
+			return EVEX_REJECT_LENGTH;
+		return ll ? EVEX_CLEAR_LENGTH : EVEX_KEEP_LENGTH;
+	default:
+		return EVEX_KEEP_LENGTH;
+	}
+}
