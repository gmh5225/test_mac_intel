diff --git a/arch/X86/X86OutputOptions.h b/arch/X86/X86OutputOptions.h
index 62d4288a..524d147a 100644
--- a/arch/X86/X86OutputOptions.h
+++ b/arch/X86/X86OutputOptions.h
@@ -29,15 +29,19 @@ X86_decodeOutputMiss64(cs_struct *handle, const uint8_t *code, size_t size,
 
 /* Keep the mode, option and callback checks in a single short-circuit chain
  * in both instantiations of the scalar writer. */
-#define X86_OUTPUT_UNSUPPORTED(handle, mode_mismatch) \
+#define X86_OUTPUT_UNSUPPORTED_FOR(handle, mode_mismatch, syntax_mismatch, expected_printer) \
 	((mode_mismatch) || (handle)->no_text || (handle)->imm_unsigned || \
 	 (handle)->mnem_list || (handle)->doing_mem || \
-	 ((handle)->syntax != CS_OPT_SYNTAX_INTEL && \
-	  (handle)->syntax != CS_OPT_SYNTAX_DEFAULT) || \
+	 (syntax_mismatch) || \
 	 (handle)->disasm != X86_getInstruction || \
 	 (handle)->insn_id != X86_get_insn_id || \
-	 (handle)->printer != X86_Intel_printInst || \
+	 (handle)->printer != (expected_printer) || \
 	 (handle)->post_printer != X86_postprinter || \
 	 cs_vsnprintf != cs_default_vsnprintf)
 
+#define X86_OUTPUT_UNSUPPORTED(handle, mode_mismatch) \
+	X86_OUTPUT_UNSUPPORTED_FOR(handle, mode_mismatch, \
+		(handle)->syntax != CS_OPT_SYNTAX_INTEL && \
+		(handle)->syntax != CS_OPT_SYNTAX_DEFAULT, X86_Intel_printInst)
+
 #endif
