+#ifdef MIPS_NATIVE_COMMENT_SEARCH
+static void stripMipsComment(SStream *O)
+{
+	/* Stop at the first terminator, including one preceding a later '#'. */
+	const __m128i text = _mm_loadu_si128((const __m128i *)O->buffer);
+	const __m128i end = _mm_cmpeq_epi8(text, _mm_setzero_si128());
+	const __m128i hash = _mm_cmpeq_epi8(text, _mm_set1_epi8('#'));
+	const unsigned stops = (unsigned)_mm_movemask_epi8(_mm_or_si128(end, hash));
+	if (stops) {
+		const unsigned offset = (unsigned)__builtin_ctz(stops);
+		if (O->buffer[offset] == '#')
+			O->buffer[offset] = '\0';
+		return;
+	}
+	char *comment = strchr(O->buffer + 16, '#');
+	if (comment && comment != O->buffer + sizeof(O->buffer) - 1)
+		*comment = '\0';
+}
+#endif
+
 static void patch_cs_printer(MCInst *MI, SStream *O)
 {
-	// replace '# 16 bit inst' to empty.
+	/* MIPS16 and nanoMIPS writers can append an assembly comment. */
+#ifdef MIPS_NATIVE_COMMENT_SEARCH
+	stripMipsComment(O);
+#else
 	SStream_replc(O, '#', 0);
+#endif
 
 #ifndef CAPSTONE_MIPS_FINAL_OUTPUT_TRIM
 	SStream_trimls(O);
