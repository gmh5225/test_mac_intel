+#endif
+	/* Segment PUSH lists its source before the implicit stack read.
+	 * POP lists the stack pointer before any written segment. */
+	if (d->regs_read[0] != d->regs_write[0])
+		d->regs_read[d->regs_read_count++] = sp;
