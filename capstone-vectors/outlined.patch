diff --git a/cs_disasm_internal.h b/cs_disasm_internal.h
index 4c4c34f2..a601258f 100644
--- a/cs_disasm_internal.h
+++ b/cs_disasm_internal.h
@@ -27,14 +27,26 @@ X86_decodePublicRecord(cs_struct *handle, const uint8_t *code, size_t size,
  * reader call the same full decoder with the ordinary iterator request. */
 #ifdef CAPSTONE_X86_PUBLIC_FIXED_RECORD
 typedef uint8_t cs_record_request;
-enum { CS_RECORD_PUBLIC_ITER = 2 };
+#ifdef CAPSTONE_MIXED_X86_MODE_READERS
+enum { CS_RECORD_PUBLIC_ITER = 0, CS_RECORD_ITER_MISS = 2 };
+#else
+enum { CS_RECORD_PUBLIC_ITER = 2, CS_RECORD_ITER_MISS = 0 };
+#endif
 CAPSTONE_INTERNAL bool X86_decodeFixedRecord32(cs_struct *handle,
 		const uint8_t *code, size_t size, cs_insn *insn, uint16_t *length);
 CAPSTONE_INTERNAL bool X86_decodeFixedRecord64(cs_struct *handle,
 		const uint8_t *code, size_t size, cs_insn *insn, uint16_t *length);
 #else
 typedef bool cs_record_request;
+enum { CS_RECORD_ITER_MISS = 0 };
 #endif
+/* A private reader that has already tried its output records falls through
+ * to the full decoder, including when it shares the public iterator's mode. */
+static inline cs_record_request cs_record_after_output(bool batch)
+{
+	return batch ? true : CS_RECORD_ITER_MISS;
+}
+
 CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
 cs_decode_full_insn(cs_struct *handle, const uint8_t *code, size_t size,
 		    cs_insn *insn, uint16_t *insn_size, cs_record_request request);
