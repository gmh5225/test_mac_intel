+/* Keep the memory tables in the fixed AMD64 fallback, outside the shared
+ * register-immediate handler used by the 32-bit iterator. */
+#ifndef CAPSTONE_X86_ONLY
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_vex64_memory_text" rodata = \
+	".cs_x86_vex64_memory_rodata"
+#endif
+#include "X86VexBaseMemory.h"
+#endif
+
+static bool writeVex3Output64(cs_struct *handle, const uint8_t *code,
+			      size_t size, cs_insn *insn, uint16_t *insn_size)
+{
+#ifndef CAPSTONE_X86_ONLY
+	if (size >= 5 && code[4] < 0xc0)
+		return !X86_OUTPUT_UNSUPPORTED(handle, false) &&
+		       writeVexBaseMemory(code, size, 3, insn, insn_size,
+					  x86_simple_registers[3]);
+#endif
+	return X86_writeVexRegisterImmediate(handle, code, size, insn, insn_size,
+					     x86_simple_registers, true);
+}
+
+#ifndef CAPSTONE_X86_ONLY
+bool X86_writeVex2BaseMemory64(const uint8_t *code, size_t size, cs_insn *insn,
+			      uint16_t *insn_size)
+{
+	return writeVexBaseMemory(code, size, 2, insn, insn_size,
+				  x86_simple_registers[3]);
+}
+#endif
+
 #endif
 #endif
