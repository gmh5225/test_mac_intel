+static bool check_group1_memory64(csh handles[2])
+{
+	for (unsigned rex = 0x40; rex < 0x50; ++rex)
+		for (unsigned group = 0; group < 8; ++group) {
+			const uint8_t opcodes[] = { 0x80, 0x81, 0x83 };
+			for (unsigned i = 0; i < sizeof(opcodes); ++i) {
+				uint8_t code[] = { (uint8_t)rex, opcodes[i],
+						   (uint8_t)(0x05 | group << 3),
+						   0xff, 0xff, 0xff, 0xff,
+						   0x80, 0xff, 0xff, 0xff };
+				for (size_t n = 1; n <= sizeof(code); ++n)
+					if (!compare(handles, code, n, 0xffff))
+						return false;
+			}
+		}
+	return true;
+}
