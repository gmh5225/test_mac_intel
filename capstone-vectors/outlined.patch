+static bool check_real_mode_registers(csh handles[2])
+{
+	for (unsigned reg = 0; reg < 8; ++reg) {
+		for (unsigned opcode = 0x50; opcode <= 0x58; opcode += 8) {
+			const uint8_t bytes[] = { 0x66, (uint8_t)(opcode + reg) };
+			for (size_t length = 1; length <= sizeof(bytes); ++length)
+				if (!compare(handles, bytes, length, 0xa5))
+					return false;
+		}
+		const uint8_t move[] = {
+			0x66, (uint8_t)(0xb8 + reg), 0xff, 0xff, 0xff, 0xff
+		};
+		for (size_t length = 1; length <= sizeof(move); ++length)
+			if (!compare(handles, move, length, 0x5a))
+				return false;
+	}
+	for (unsigned op = 0; op != 256; ++op) {
+		if (!((op < 0x40 && (op & 5) == 1) || op == 0x85 ||
+		      op == 0x89 || op == 0x8b))
+			continue;
+		for (unsigned mr = 0xc0; mr <= 0xff; ++mr) {
+			const uint8_t bytes[] = { 0x66, (uint8_t)op, (uint8_t)mr };
+			if (!compare(handles, bytes, sizeof(bytes), mr))
+				return false;
+		}
+	}
+	return true;
+}
