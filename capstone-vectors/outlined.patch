 #include "X86SimpleOutput.h"
 #include "X86GenSimpleOutput.inc"
 
+#ifdef X86_REAL_MODE_REGISTER_OUTPUT
+/* A single 66 prefix selects 32-bit registers without changing address size.
+ * These register-only encodings share the unprefixed i386 text and operand rows. */
+static __attribute__((noinline, minsize)) bool writePrefixedRegisters16(
+	cs_struct *handle, const uint8_t *code, size_t size, cs_insn *insn,
+	uint16_t *insn_size)
+{
+	if (size < 2 || handle->skipdata || X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	const unsigned opcode = code[1];
+	const bool move = (opcode & 0xf8) == 0xb8;
+	if (move) {
+		if (size < 6)
+			return false;
+		const unsigned row = x86_simple_plans[0][0][0x8b] >> 2;
+		X86_writeImmediateOutput(code + 1, insn, insn_size, 0,
+					 &x86_simple_outputs[row],
+					 &x86_simple_registers[2][opcode & 7]);
+		memcpy(insn->bytes, code, 6);
+		*insn_size = insn->size = 6;
+		if (insn->detail)
+			insn->detail->x86.encoding.imm_offset = 2;
+	} else if ((opcode & 0xf0) == 0x50) {
+		const unsigned plan = x86_simple_plans[0][0][opcode];
+		const struct X86SimpleOutput *row = &x86_simple_outputs[plan >> 2];
+		insn->id = row->id;
+		*insn_size = insn->size = 2;
+		memcpy(insn->bytes, code, 2);
+		memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+		memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+		memset(insn->op_str, 0, sizeof(insn->op_str));
+		memcpy(insn->op_str, row->operands, sizeof(row->operands));
+		if (insn->detail)
+			X86_writeSimpleDetail(insn->detail, row, (uint8_t)opcode,
+					      0, 0, row->ops[0].reg, 0);
+	} else if (size >= 3 && code[2] >= 0xc0 &&
+		   ((opcode < 0x40 && (opcode & 5) == 1) ||
+		    opcode == 0x85 || opcode == 0x89 || opcode == 0x8b)) {
+		const unsigned plan = x86_simple_plans[0][0][opcode];
+		const struct X86SimpleOutput *row = &x86_simple_outputs[plan >> 2];
+		const unsigned rm = code[2] & 7, reg = (code[2] >> 3) & 7;
+		const bool reverse = (plan & 3) == X86_SIMPLE_REG_RM;
+		const struct X86SimpleRegister *first =
+			&x86_simple_registers[2][reverse ? reg : rm];
+		const struct X86SimpleRegister *second =
+			&x86_simple_registers[2][reverse ? rm : reg];
+		insn->id = row->id;
+		*insn_size = insn->size = 3;
+		memcpy(insn->bytes, code, 3);
+		memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+		memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+		memset(insn->op_str, 0, sizeof(insn->op_str));
+		memcpy(insn->op_str, first->name, sizeof(first->name));
+		char *out = insn->op_str + first->length;
+		memcpy(out, ", ", 2);
+		memcpy(out + 2, second->name, sizeof(second->name));
+		if (insn->detail) {
+			X86_writeSimpleDetail(insn->detail, row, (uint8_t)opcode,
+					      0, code[2], first->reg, second->reg);
+			insn->detail->x86.encoding.modrm_offset = 2;
+		}
+	} else {
+		return false;
+	}
+	if (insn->detail) {
+		insn->detail->x86.prefix[2] = X86_PREFIX_OPSIZE;
+		insn->detail->x86.addr_size = 2;
+	}
+	return true;
+}
+#endif
