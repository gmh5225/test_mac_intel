diff --git a/arch/X86/X86RegisterAccessImpl.h b/arch/X86/X86RegisterAccessImpl.h
new file mode 100644
index 00000000..29da6d65
--- /dev/null
+++ b/arch/X86/X86RegisterAccessImpl.h
@@ -0,0 +1,86 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+/* Instantiated twice in X86Mapping.c when the short-list callback is enabled.
+ * Both entries use the same operand walk and update the public counts last. */
+#if defined(X86_SHORT_REG_ACCESS) && defined(__ELF__) && defined(__clang__)
+__attribute__((section(".cs_x86_short_reg_access")))
+#endif
+void X86_REG_ACCESS_NAME(const cs_insn *insn, cs_regs regs_read,
+		    uint8_t *regs_read_count, cs_regs regs_write,
+		    uint8_t *regs_write_count)
+{
+	uint8_t i;
+	uint8_t read_count, write_count;
+	cs_x86 *x86 = &(insn->detail->x86);
+
+	read_count = insn->detail->regs_read_count;
+	write_count = insn->detail->regs_write_count;
+
+#ifdef X86_SHORT_REG_ACCESS
+	if (read_count > 1 || write_count > 1) {
+		X86_reg_access(insn, regs_read, regs_read_count, regs_write,
+			       regs_write_count);
+		return;
+	}
+	if (read_count)
+		regs_read[0] = insn->detail->regs_read[0];
+	if (write_count)
+		regs_write[0] = insn->detail->regs_write[0];
+#else
+	// implicit registers
+	if (read_count == 1)
+		regs_read[0] = insn->detail->regs_read[0];
+	else if (read_count != 0)
+		memcpy(regs_read, insn->detail->regs_read,
+		       read_count * sizeof(insn->detail->regs_read[0]));
+	if (write_count == 1)
+		regs_write[0] = insn->detail->regs_write[0];
+	else if (write_count != 0)
+		memcpy(regs_write, insn->detail->regs_write,
+		       write_count * sizeof(insn->detail->regs_write[0]));
+#endif
+
+	// explicit registers
+	for (i = 0; i < x86->op_count; i++) {
+		cs_x86_op *op = &(x86->operands[i]);
+		switch ((int)op->type) {
+		case X86_OP_REG:
+			if ((op->access & CS_AC_READ) &&
+			    !arr_exist_inline(regs_read, read_count, op->reg)) {
+				regs_read[read_count] = op->reg;
+				read_count++;
+			}
+			if ((op->access & CS_AC_WRITE) &&
+			    !arr_exist_inline(regs_write, write_count,
+					      op->reg)) {
+				regs_write[write_count] = op->reg;
+				write_count++;
+			}
+			break;
+		case X86_OP_MEM:
+			// registers appeared in memory references always being read
+			if ((op->mem.segment != X86_REG_INVALID)) {
+				regs_read[read_count] = op->mem.segment;
+				read_count++;
+			}
+			if ((op->mem.base != X86_REG_INVALID) &&
+			    !arr_exist_inline(regs_read, read_count,
+					      op->mem.base)) {
+				regs_read[read_count] = op->mem.base;
+				read_count++;
+			}
+			if ((op->mem.index != X86_REG_INVALID) &&
+			    !arr_exist_inline(regs_read, read_count,
+					      op->mem.index)) {
+				regs_read[read_count] = op->mem.index;
+				read_count++;
+			}
+		default:
+			break;
+		}
+	}
+
+	*regs_read_count = read_count;
+	*regs_write_count = write_count;
+}
