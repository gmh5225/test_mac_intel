diff --git a/CMakeLists.txt b/CMakeLists.txt
index d8f51cb9..933c26d1 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1086,6 +1086,7 @@ set_property(GLOBAL PROPERTY VERSION ${PROJECT_VERSION})
 
 ## targets
 add_library(capstone_build_settings INTERFACE)
+set(capstone_linux_public_records OFF)
 # The compact x86 records improve 32-bit detail in the six-backend static build.
 if(capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV"
    AND CAPSTONE_BUILD_STATIC_LIBS AND NOT CAPSTONE_BUILD_SHARED_LIBS
@@ -1095,6 +1096,9 @@ if(capstone_enabled_architectures STREQUAL "ARM;AARCH64;MIPS;PPC;X86;RISCV"
    AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|aarch64|arm64|ARM64)$")
     target_compile_definitions(capstone_build_settings INTERFACE
         "$<$<CONFIG:Release>:CAPSTONE_X86_COMPACT_SCALAR_ROWS>")
+    set(capstone_linux_public_records ON)
+    target_compile_definitions(capstone_build_settings INTERFACE
+        "$<$<CONFIG:Release>:CAPSTONE_STATIC_X86_READERS;CAPSTONE_X86_DEFAULT_PUBLIC_REQUEST>")
     # Use cached access IDs and bounded masked-operand copies in the x86-64 static reader.
     if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
         set_property(SOURCE arch/X86/X86Mapping.c APPEND PROPERTY
@@ -1139,6 +1143,12 @@ if(CAPSTONE_X86_SUPPORT AND (CAPSTONE_BUILD_STATIC_LIBS OR CAPSTONE_BUILD_CSTEST
             $<TARGET_OBJECTS:capstone_x86_iter32> $<TARGET_OBJECTS:capstone_x86_iter64>
             $<TARGET_OBJECTS:capstone_x86_native>)
         target_sources(capstone INTERFACE ${capstone_x86_objects})
+    elseif(capstone_linux_public_records)
+        # Direct users of the object library need the same readers as the archive.
+        target_sources(capstone INTERFACE
+            "$<$<CONFIG:Release>:$<TARGET_OBJECTS:capstone_x86_iter32>>"
+            "$<$<CONFIG:Release>:$<TARGET_OBJECTS:capstone_x86_iter64>>"
+            "$<$<CONFIG:Release>:$<TARGET_OBJECTS:capstone_x86_native>>")
     endif()
 endif()
 
