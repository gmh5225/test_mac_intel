diff --git a/arch/X86/X86Mapping.c b/arch/X86/X86Mapping.c
index 79adee8d..b2019362 100644
--- a/arch/X86/X86Mapping.c
+++ b/arch/X86/X86Mapping.c
@@ -10296,6 +10296,32 @@ static inline unsigned int find_insn_h(cs_struct *h, unsigned int id)
 
 #ifndef CAPSTONE_DIET
 #include "X86GenMappingCounts.inc"
+
+/* In the flat model the stack-address size follows the mode. 66 changes
+ * the transfer size and 67 affects an explicit memory operand. */
+static void set_stack_registers(cs_struct *h, unsigned int id, cs_detail *d)
+{
+	const uint16_t sp = (h->mode & CS_MODE_16) ? X86_REG_SP :
+			    (h->mode & CS_MODE_32) ? X86_REG_ESP : X86_REG_RSP;
+#ifdef CAPSTONE_X86_REDUCE
+	/* Reduced segment PUSH rows omit both banks. The implied operand
+	 * table retains the source segment. */
+	if (!d->regs_read_count) {
+		d->regs_read[0] = X86_insn_reg_intel_h(h, id, NULL);
+		d->regs_read_count = 1;
+		d->regs_write_count = 1;
+	}
+#else
+	(void)id;
+#endif
+	/* Segment PUSH lists its source before the implicit stack read.
+	 * POP lists the stack pointer before any written segment. */
+	if (d->regs_read[0] != d->regs_write[0])
+		d->regs_read[d->regs_read_count++] = sp;
+	else
+		d->regs_read[0] = sp;
+	d->regs_write[0] = sp;
+}
 #endif
 
 // given internal insn id, return public instruction info
@@ -10374,6 +10400,10 @@ void X86_get_insn_id(cs_struct *h, cs_insn *insn, unsigned int id)
 			switch (insn->id) {
 			default:
 				break;
+			case X86_INS_PUSH:
+			case X86_INS_POP:
+				set_stack_registers(h, id, insn->detail);
+				break;
 			case X86_INS_XADD:
 				insn->detail->regs_write[0] = X86_REG_EFLAGS;
 				insn->detail->regs_write_count = 1;
diff --git a/tests/unit/x86_reg_access.c b/tests/unit/x86_reg_access.c
index d9dd18e2..8406e966 100644
--- a/tests/unit/x86_reg_access.c
+++ b/tests/unit/x86_reg_access.c
@@ -772,6 +772,57 @@ static bool check_scalar_segment_reads(void)
 	return true;
 }
 
+static bool check_stack_address_size(void)
+{
+	static const struct {
+		cs_mode mode;
+		uint8_t bytes[5], length;
+		x86_reg sp, read_segment, write_segment, operand;
+	} cases[] = {
+		{ CS_MODE_16, { 0x66, 0x54 }, 2, X86_REG_SP, 0, 0, X86_REG_ESP },
+		{ CS_MODE_16, { 0x67, 0x58 }, 2, X86_REG_SP, 0, 0, X86_REG_AX },
+		{ CS_MODE_32, { 0x66, 0x58 }, 2, X86_REG_ESP, 0, 0, X86_REG_AX },
+		{ CS_MODE_32, { 0x67, 0x06 }, 2, X86_REG_ESP, X86_REG_ES, 0, X86_REG_ES },
+		{ CS_MODE_64, { 0x66, 0x67, 0x50 }, 3, X86_REG_RSP, 0, 0, X86_REG_AX },
+		{ CS_MODE_64, { 0x66, 0x0f, 0xa0 }, 3, X86_REG_RSP, X86_REG_FS, 0, X86_REG_FS },
+		{ CS_MODE_64, { 0x66, 0x0f, 0xa9 }, 3, X86_REG_RSP, 0, X86_REG_GS, X86_REG_GS },
+	};
+	for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i) {
+		csh h;
+		if (cs_open(CS_ARCH_X86, cases[i].mode, &h) != CS_ERR_OK)
+			return false;
+		bool ok = cs_option(h, CS_OPT_DETAIL, CS_OPT_ON) == CS_ERR_OK;
+		for (unsigned att = 0; ok && att < 2; ++att) {
+			cs_err err = cs_option(h, CS_OPT_SYNTAX,
+					       att ? CS_OPT_SYNTAX_ATT : CS_OPT_SYNTAX_INTEL);
+			if (att && err == CS_ERR_X86_ATT)
+				continue;
+			cs_insn *insn = NULL;
+			size_t n = cs_disasm(h, cases[i].bytes, cases[i].length, 0, 1, &insn);
+			ok = err == CS_ERR_OK && n == 1 && insn->size == cases[i].length;
+			if (ok) {
+				const cs_detail *d = insn->detail;
+				unsigned segment = cases[i].read_segment != X86_REG_INVALID;
+				ok = d->regs_read_count == 1 + segment &&
+				     d->regs_read[segment] == cases[i].sp &&
+				     (!segment || d->regs_read[0] == cases[i].read_segment) &&
+				     d->regs_write_count == 1 + (cases[i].write_segment != X86_REG_INVALID) &&
+				     d->regs_write[0] == cases[i].sp &&
+				     (!cases[i].write_segment || d->regs_write[1] == cases[i].write_segment) &&
+				     d->x86.op_count == 1 && d->x86.operands[0].type == X86_OP_REG &&
+				     d->x86.operands[0].reg == cases[i].operand;
+			}
+			if (!ok)
+				fprintf(stderr, "stack effects case %zu (AT&T %u)\n", i, att);
+			cs_free(insn, n);
+		}
+		cs_close(&h);
+		if (!ok)
+			return false;
+	}
+	return true;
+}
+
 int main(void)
 {
 	if (cs_support(CS_SUPPORT_DIET))
@@ -783,7 +834,7 @@ int main(void)
 		cs_close(&handle);
 		return 1;
 	}
-	bool success = check_implicit_copies(handle) && check_test_operands() &&
+	bool success = check_stack_address_size() && check_implicit_copies(handle) && check_test_operands() &&
 		       check_scalar_move_flags() &&
 		       check_scalar_segment_reads() &&
 		       check_vector_compare_flags();
