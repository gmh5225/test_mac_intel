diff --git a/arch/X86/X86BatchSecondary32.c b/arch/X86/X86BatchSecondary32.c
new file mode 100644
index 00000000..63b0d6dd
--- /dev/null
+++ b/arch/X86/X86BatchSecondary32.c
@@ -0,0 +1,44 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#if defined(CAPSTONE_HAS_X86) && !defined(CAPSTONE_X86_REDUCE) && \
+	!defined(CAPSTONE_X86_SCAN_ADAPTER)
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_batch32_secondary_text" rodata = \
+	".cs_x86_batch32_secondary_rodata"
+#endif
+#include "../../cs_disasm_internal.h"
+#include "X86FeatureExtension.h"
+#include "X86BatchModRM.h"
+#define X86_DEFINE_I386_MAP3_PLANS
+#include "X86GenVexPublicPlans.inc"
+#undef X86_DEFINE_I386_MAP3_PLANS
+
+static inline uint32_t readSecondary32(const uint8_t *code, size_t size)
+{
+	/* E3 disambiguates VEX from LES. With W=0, 66 and registers 0..7,
+	 * one generated cell contains the ID, operand checks and tail size. */
+	if (code[0] == 0xc4 && size >= 5 && code[1] == 0xe3 &&
+	    (code[2] & 0xc3) == 0x41 &&
+	    X86_vexFeatureFamily(3, code[3]) == X86_VEX_FEATURE_NONE) {
+		const unsigned form = ((code[2] >> 1) & 2) | (code[4] >= 0xc0);
+		return finishVexPlan(code, size, 4, code[2],
+				     x86Vex32Map3OperandPlan[code[3]][form]);
+	}
+	return 0;
+}
+
+bool X86_getBatchSecondary32(csh handle, const uint8_t *code, size_t size,
+			     cs_insn *insn, X86ScanResult *result)
+{
+	const uint32_t packed = readSecondary32(code, size);
+	if (!packed)
+		return X86_getInstructionScanResult(handle, code, size, insn,
+						    result);
+	result->opcode = 0;
+	result->opcode_pub = packed >> 8;
+	result->length = (uint16_t)(packed & 0xff);
+	result->popcode_adjust = 0;
+	return true;
+}
+#endif
