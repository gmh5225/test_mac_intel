diff --git a/arch/X86/X86Mapping.h b/arch/X86/X86Mapping.h
index 380faa79..dddcf76f 100644
--- a/arch/X86/X86Mapping.h
+++ b/arch/X86/X86Mapping.h
@@ -60,15 +60,24 @@ const char *X86_insn_name(csh handle, unsigned int id);
 // return group name, given group id
 const char *X86_group_name(csh handle, unsigned int id);
 
+/* A nonzero access with register zero cannot represent an embedded register.
+ * It requests the existing two-register lookup, also used without a cache. */
+#define X86_CHECK_EMBEDDED_PAIR 0x1000u
+
+static inline x86_reg X86_unpackEmbeddedRegister(uint16_t value, enum cs_ac_type *access)
+{
+	if (access)
+		*access = (enum cs_ac_type)(value >> 12);
+	return (x86_reg)(value & 0x0fff);
+}
+
 // return register of given instruction id
 // return 0 if not found
 // this is to handle instructions embedding accumulate registers into AsmStrs[]
 x86_reg X86_insn_reg_intel(unsigned int id, enum cs_ac_type *access);
