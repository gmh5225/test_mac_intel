@@ -1755,11 +1755,15 @@ X86_DECODE_INLINE int readDisplacement(struct InternalInstruction *insn,
 			insn->consumedDisplacement = false;
 		break;
 	case EA_DISP_8:
+	case EA_DISP_8_EVEX:
 		if (consumeInt8(insn, &d8))
 			return -1;
 		if (materialize) {
 			insn->displacementSize = 1;
 			insn->displacement = d8;
+			/* Only EVEX tuples can scale an encoded disp8. */
+			if (insn->vectorExtensionType == TYPE_EVEX)
+				insn->eaDisplacement = EA_DISP_8_EVEX;
 		}
 		break;
 	case EA_DISP_16:
@@ -2303,7 +2307,7 @@ X86_DECODE_INLINE int fixupRMOperand(struct InternalInstruction *insn,
 	}
 
 	// Apply the AVX512 compressed displacement scaling factor.
-	if (insn->eaDisplacement == EA_DISP_8)
+	if (insn->eaDisplacement == EA_DISP_8_EVEX)
 		insn->displacement *= 1 << (encoding - ENCODING_RM);
 	return 0;
 }
@@ -2357,7 +2361,7 @@ X86_DECODE_INLINE int readVSIBOperand(struct InternalInstruction *insn,
 	}
 
 	// Apply the AVX512 compressed displacement scaling factor.
-	if (encoding != ENCODING_REG && insn->eaDisplacement == EA_DISP_8)
+	if (encoding != ENCODING_REG && insn->eaDisplacement == EA_DISP_8_EVEX)
 		insn->displacement *= 1 << (encoding - ENCODING_VSIB);
 
 	return 0;
