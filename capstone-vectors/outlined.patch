diff --git a/arch/X86/X86OutputIterator.c b/arch/X86/X86OutputIterator.c
index 8c6444ab..90178f1a 100644
--- a/arch/X86/X86OutputIterator.c
+++ b/arch/X86/X86OutputIterator.c
@@ -41,4 +41,17 @@ CAPSTONE_INTERNAL bool X86_disasmIter(csh ud, const uint8_t **code,
 #endif
 	return cs_disasm_iter(ud, code, size, address, insn);
 }
+#ifdef CAPSTONE_X86_ARCHIVE_PUBLIC_RECORD
+#pragma clang section text = ".cs_x86_other_mode_text"
+/* The calling fixed-width iterator already declined this mode. */
+CAPSTONE_INTERNAL bool X86_disasmIterOtherMode(csh handle, const uint8_t **code,
+			     size_t *size, uint64_t *address, cs_insn *insn)
+{
+	cs_struct *state = (cs_struct *)(uintptr_t)handle;
+	if (state && state->mode == CS_MODE_16)
+		return cs_disasm_iter(handle, code, size, address, insn);
+	return X86_disasmIter(handle, code, size, address, insn);
+}
+#endif
+
 #endif
