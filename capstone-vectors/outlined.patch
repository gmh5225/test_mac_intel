 	}
 	return X86_decodeRegisterFallback32(handle, code, size, insn, insn_size, batch);
 }
+#ifdef X86_ACCUMULATOR_OUTPUT32
+/* The register-pair form supplies the accumulator ALU instruction's
+ * destination access, flags and implicit registers. */
+CAPSTONE_INTERNAL CS_PRESERVE_MOST const struct X86SimpleOutput *
+X86_accumulatorRow32(unsigned opcode)
+{
+	const unsigned pair = opcode & 0x39;
+	return &x86_simple_outputs[x86_simple_plans[0][0][pair] >> 2];
+}
+#endif
+
 #endif
 #endif
