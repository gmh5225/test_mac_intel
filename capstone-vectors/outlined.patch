+def legacy_vector66_maps(suffix):
+    """Identify legacy vector opcode groups whose 66 byte selects an instruction."""
+    common = (X86 / "X86DisassemblerDecoderCommon.h").read_text()
+    contexts, _, names = tables.parse_common(common)
+    source = (X86 / f"X86GenDisassemblerTables{suffix}.inc").read_text()
+    ids = tables.parse_ids(source, contexts)
+    maps = tables.parse_maps(
+        (X86 / f"X86GenDisassemblerTables{suffix}2.inc").read_text(),
+        names[:4] if suffix else names,
+        len(contexts),
+    )
+    specifiers = instruction_specifiers(source)
+    vector = {
+        i for i, operands in enumerate(read_sets(X86 / f"X86GenDisassemblerTables{suffix}.inc"))
+        if any(kind == "TYPE_XMM" for _, kind in operands)
+    }
+    equivalent = equivalents16(suffix)
+    groups = {}
+    invalid = (("MODRM_ONEENTRY", 0),) * 256
+    for name, indices, rows in maps[1:4]:
+        selected = groups[name] = set()
+        for first, second in (("IC", "IC_OPSIZE"), ("IC_ADSIZE", "IC_OPSIZE_ADSIZE")):
+            a = indices[contexts.index(first)]
+            b = indices[contexts.index(second)]
+            ordinary = rows[a - 1] if a else invalid
+            prefixed = rows[b - 1] if b else invalid
+            for opcode, (left, right) in enumerate(zip(ordinary, prefixed)):
+                if left == right or opcode in selected:
+                    continue
+                for modrm in range(256):
+                    unprefixed = tables.source_id(ids, *left, modrm)
+                    with_66 = tables.source_id(ids, *right, modrm)
+                    if (unprefixed != with_66 and specifiers[with_66] in vector
+                            and (unprefixed, with_66) not in equivalent):
+                        selected.add(opcode)
+                        break
+    return groups
+
+
+def emit_real_mode_onebyte_context(suffix):
+    """Select one table only when it consumes exactly the ordinary ModR/M bytes."""
+    common = (X86 / "X86DisassemblerDecoderCommon.h").read_text()
+    contexts, _, names = tables.parse_common(common)
+    source = (X86 / f"X86GenDisassemblerTables{suffix}.inc").read_text()
+    ids = tables.parse_ids(source, contexts)
+    maps = tables.parse_maps(
+        (X86 / f"X86GenDisassemblerTables{suffix}2.inc").read_text(),
+        names[:4] if suffix else names, len(contexts),
+    )
+    _, indices, rows = maps[0]
+    equivalent = equivalents16(suffix)
+    def decision(context, opcode):
+        row = indices[contexts.index(context)]
+        return rows[row - 1][opcode] if row else ("MODRM_ONEENTRY", 0)
+
+    plans = []
+    for opcode in range(256):
+        use = {1, 2}
+        # Moffs and JCXZ perform their own address-size inversion.
+        if opcode in (0xa0, 0xa1, 0xa2, 0xa3, 0xe3):
+            use.clear()
+        for normal, sized in (("IC", "IC_OPSIZE"), ("IC_ADSIZE", "IC_OPSIZE_ADSIZE")):
+            a = decision(normal, opcode)
+            b = decision(sized, opcode)
+            if (a[0] == "MODRM_ONEENTRY") != (b[0] == "MODRM_ONEENTRY"):
+                use.clear()
+                break
+            for modrm in range(256):
+                orig = tables.source_id(ids, *a, modrm)
+                alt = tables.source_id(ids, *b, modrm)
+                selected = alt if (orig, alt) in equivalent else orig
+                if selected != orig:
+                    use.discard(1)
+                if selected != alt:
+                    use.discard(2)
+        plans.append(min(use) if use else 0)
+    lines = ["X86_DECODE_INLINE uint8_t oneByteContext16(uint8_t opcode)", "{",
+             "\t/* 0 needs both contexts, 1 uses the primary, 2 selects operand size. */",
+             "\tstatic const uint8_t plans[256] = {"]
+    for offset in range(0, 256, 16):
+        lines.append("\t\t" + ", ".join(map(str, plans[offset:offset + 16])) + ",")
+    return lines + ["\t};", "\treturn plans[opcode];", "}"]
+
+
+def emit_legacy_vector66(suffix):
+    groups = legacy_vector66_maps(suffix)
+    lines = [
+        "X86_DECODE_INLINE bool hasMandatoryVector66(OpcodeType map, uint8_t opcode)",
+        "{",
+    ]
+    if any(groups.values()):
+        lines += ["\tstatic const uint32_t opcodes[3][8] = {"]
+        for name, selected in groups.items():
+            words = [
+                sum(1 << (op & 31) for op in selected if op >> 5 == i)
+                for i in range(8)
+            ]
+            lines.append(f"\t\t/* {name} */")
+            lines.append("\t\t{ " + ", ".join(f"0x{w:08x}u" for w in words) + " },")
+        lines += [
+            "\t};",
+            "\tconst unsigned row = (unsigned)map - TWOBYTE;",
+            "\treturn row < 3 && ((opcodes[row][opcode >> 5] >> (opcode & 31)) & 1);",
+        ]
+    else:
+        lines += ["\t(void)map;", "\t(void)opcode;", "\treturn false;"]
+    return lines + ["}"]
+
