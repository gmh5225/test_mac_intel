diff --git a/cs.c b/cs.c
index d0b8b045..1e1f4278 100644
--- a/cs.c
+++ b/cs.c
@@ -1242,6 +1242,13 @@ cs_decode_full_insn(cs_struct *handle, const uint8_t *code, size_t size,
 	return true;
 }
 
+#ifdef CAPSTONE_X86_ARCHIVE_PUBLIC_RECORD
+/* A public-only static link uses the generic decoder at the same address.
+ * Extracting the native reader supplies its strong internal implementation. */
+CAPSTONE_INTERNAL __typeof__(cs_decode_full_insn) X86_decodePublicRecord
+	__attribute__((weak, alias("cs_decode_full_insn")));
+#endif
+
 #if defined(_MSC_VER)
 __declspec(noinline)
 #elif defined(__GNUC__)
