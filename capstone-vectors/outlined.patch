+/* KMOV with an indexed 64-bit address reads or writes a mask register.
+ * The mapping tables own its groups, implicit registers and operand access. */
+#define GET_INSTRINFO_ENUM
+#include "X86GenInstrInfo.inc"
+
+static bool writeMaskMemory(cs_struct *handle, const uint8_t *code, size_t size,
+			    unsigned prefix, cs_insn *insn, uint16_t *insn_size)
+{
+	if (size < prefix + 3 || (code[prefix] & 0xfe) != 0x90)
+		return false;
+	const unsigned flags = prefix == 3 ? code[2] : code[1] & 0x7f;
+	const unsigned mr = code[prefix + 1], mod = mr >> 6;
+	if ((flags & 0x7e) != 0x78 || (mr & 7) != 4 || mod == 3 ||
+	    (prefix == 3 ? (code[1] & 0x9f) != 0x81 : !(code[1] & 0x80)))
+		return false;
+	const unsigned rxb = prefix == 3 ? (~(unsigned)code[1] >> 5) & 3 : 0;
+	const unsigned sib = code[prefix + 2];
+	const unsigned base_num = (sib & 7) | ((rxb & 1) << 3);
+	const unsigned index = ((sib >> 3) & 7) | ((rxb & 2) << 2);
+	const unsigned offset = prefix + 3;
+	const unsigned disp_size = mod == 2 ? 4 : mod;
+	if ((!mod && (sib & 7) == 5) || (index == 4 && sib != 0x24) ||
+	    size < offset + disp_size || X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+
+	static const struct {
+		uint16_t ids[2], public_id;
+		uint8_t size;
+		char mnemonic[6], memory[12];
+	} forms[] = {
+		{ { X86_KMOVWkm, X86_KMOVWmk }, X86_INS_KMOVW, 2, "kmovw", "word ptr [" },
+		{ { X86_KMOVBkm, X86_KMOVBmk }, X86_INS_KMOVB, 1, "kmovb", "byte ptr [" },
+		{ { X86_KMOVQkm, X86_KMOVQmk }, X86_INS_KMOVQ, 8, "kmovq", "qword ptr [" },
+		{ { X86_KMOVDkm, X86_KMOVDmk }, X86_INS_KMOVD, 4, "kmovd", "dword ptr [" },
+	};
+	const unsigned form = ((flags >> 6) & 2) | (flags & 1);
+	const unsigned store = code[prefix] & 1;
+	const unsigned id = forms[form].ids[store], mask = (mr >> 3) & 7;
+	const struct X86SimpleRegister *base = &x86_simple_registers[3][base_num];
+	const int32_t disp = disp_size == 4 ? X86_readDisp32(code + offset) :
+			     disp_size == 1 ? (int8_t)code[offset] : 0;
+	*insn_size = insn->size = (uint16_t)(offset + disp_size);
+	memcpy(insn->bytes, code, insn->size);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, forms[form].mnemonic, sizeof(forms[form].mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = insn->op_str;
+	if (!store) {
+		out[0] = 'k';
+		out[1] = (char)('0' + mask);
+		memcpy(out + 2, ", ", 2);
+		out += 4;
+	}
+	memcpy(out, forms[form].memory, sizeof(forms[form].memory));
+	out += forms[form].size <= 2 ? 10 : 11;
+	memcpy(out, base->name, sizeof(base->name));
+	out += base->length;
+	const unsigned scale_bits = sib >> 6;
+	if (index != 4)
+		out = X86_writeScaledIndex(out, &x86_simple_registers[3][index], scale_bits);
+	out = X86_writeDisplacement(out, disp);
+	*out++ = ']';
+	if (store) {
+		memcpy(out, ", k", 3);
+		out[3] = (char)('0' + mask);
+	}
+
+	if (insn->detail) {
+		memset(insn->detail, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		X86_get_insn_id(handle, insn, id);
+		cs_x86 *x = &insn->detail->x86;
+		const uint8_t *access = X86_get_op_access(handle, id, &x->eflags);
+		memcpy(x->opcode, code, prefix);
+		x->addr_size = 8;
+		x->rex = (uint8_t)(0x40 | ((flags >> 4) & 8) | rxb);
+		x->modrm = (uint8_t)mr;
+		x->encoding.modrm_offset = (uint8_t)(prefix + 1);
+		x->sib = (uint8_t)sib;
+		x->sib_base = (x86_reg)base->reg;
+		x->sib_scale = (int8_t)(1u << scale_bits);
+		if (index != 4)
+			x->sib_index = (x86_reg)x86_simple_registers[3][index].reg;
+		if (disp_size) {
+			x->encoding.disp_size = (uint8_t)disp_size;
+			x->encoding.disp_offset = (uint8_t)offset;
+		}
+		x->op_count = 2;
+		cs_x86_op *reg = &x->operands[store], *mem = &x->operands[!store];
+		reg->type = X86_OP_REG;
+		reg->reg = (x86_reg)(X86_REG_K0 + mask);
+		mem->type = X86_OP_MEM;
+		mem->mem.base = x->sib_base;
+		mem->mem.index = x->sib_index;
+		mem->mem.scale = x->sib_scale;
+		mem->mem.disp = x->disp = disp;
+		reg->size = mem->size = forms[form].size;
+		reg->access = (cs_ac_type)access[store];
+		mem->access = (cs_ac_type)access[!store];
+	} else {
+		insn->id = forms[form].public_id;
+	}
+	return true;
+}
