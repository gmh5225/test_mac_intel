--- a/arch/X86/X86VectorRegisterOutput.h
+++ b/arch/X86/X86VectorRegisterOutput.h
@@ -6,6 +6,17 @@
 
 #include "X86VectorRegisterWriter.h"
 
+static inline void setVectorRegisterOperand(cs_x86_op *op, unsigned width,
+					    unsigned number, uint8_t access)
+{
+	static const x86_reg first[] = { X86_REG_XMM0, X86_REG_YMM0,
+					 X86_REG_ZMM0 };
+	op->type = X86_OP_REG;
+	op->reg = (x86_reg)(first[width] + number);
+	op->access = (cs_ac_type)access;
+	op->size = (uint8_t)(16 << width);
+}
+
 static bool writeVectorRegisters(const uint8_t *code, cs_insn *insn,
 				 uint16_t *insn_size,
 				 const struct VectorOutputRow *row,
@@ -21,25 +32,6 @@ static bool writeVectorRegisters(const uint8_t *code, cs_insn *insn,
 	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
 	memset(insn->op_str, 0, sizeof(insn->op_str));
 	char *out = writeVectorRegister(insn->op_str, first_ll, regs[0]);
-	for (unsigned n = 1; n != reg_count; ++n) {
-		memcpy(out, ", ", 2);
-		out = writeVectorRegister(out + 2, ll, regs[n]);
-	}
-	if (row->immediate) {
-		const unsigned value = code[prefix + 2];
-		memcpy(out, ", ", 2);
-		out += 2;
-		if (value <= HEX_THRESHOLD) {
-			*out = (char)('0' + value);
-		} else {
-			static const char digits[] = "0123456789abcdef";
-			memcpy(out, "0x", 2);
-			out += 2;
-			if (value >= 16)
-				*out++ = digits[value >> 4];
-			*out = digits[value & 15];
-		}
-	}
 	if (insn->detail) {
 		cs_detail *d = insn->detail;
 		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
@@ -52,15 +44,14 @@ static bool writeVectorRegisters(const uint8_t *code, cs_insn *insn,
 		x->modrm = code[prefix + 1];
 		x->encoding.modrm_offset = (uint8_t)(prefix + 1);
 		x->op_count = (uint8_t)(reg_count + row->immediate);
-		static const x86_reg bases[] = { X86_REG_XMM0, X86_REG_YMM0,
-						 X86_REG_ZMM0 };
-		for (unsigned n = 0; n != reg_count; ++n) {
-			cs_x86_op *op = &x->operands[n];
-			op->type = X86_OP_REG;
-			const unsigned width = n == 0 ? first_ll : ll;
-			op->reg = (x86_reg)(bases[width] + regs[n]);
-			op->access = (cs_ac_type)row->access[n];
-			op->size = (uint8_t)(16 << width);
+		setVectorRegisterOperand(&x->operands[0], first_ll, regs[0],
+					 row->access[0]);
+		for (unsigned n = 1; n != reg_count; ++n) {
+			const unsigned number = regs[n];
+			memcpy(out, ", ", 2);
+			out = writeVectorRegister(out + 2, ll, number);
+			setVectorRegisterOperand(&x->operands[n], ll, number,
+						 row->access[n]);
 		}
 		if (row->immediate) {
 			x->operands[reg_count].type = X86_OP_IMM;
@@ -71,6 +62,26 @@ static bool writeVectorRegisters(const uint8_t *code, cs_insn *insn,
 			x->encoding.imm_offset = (uint8_t)(prefix + 2);
 			x->encoding.imm_size = 1;
 		}
+	} else {
+		for (unsigned n = 1; n != reg_count; ++n) {
+			memcpy(out, ", ", 2);
+			out = writeVectorRegister(out + 2, ll, regs[n]);
+		}
+	}
+	if (row->immediate) {
+		const unsigned value = code[prefix + 2];
+		memcpy(out, ", ", 2);
+		out += 2;
+		if (value <= HEX_THRESHOLD) {
