diff --git a/cs_disasm_internal.h b/cs_disasm_internal.h
index 08677417..126fd6b7 100644
--- a/cs_disasm_internal.h
+++ b/cs_disasm_internal.h
@@ -27,10 +27,22 @@ X86_decodePublicRecord(cs_struct *handle, const uint8_t *code, size_t size,
  * reader call the same full decoder with the ordinary iterator request. */
 #ifdef CAPSTONE_X86_PUBLIC_FIXED_RECORD
 typedef uint8_t cs_record_request;
-enum { CS_RECORD_PUBLIC_ITER = 2 };
+#ifdef CAPSTONE_X86_DEFAULT_PUBLIC_REQUEST
+/* The public iterator already passes zero. Mark a private writer's miss
+ * explicitly so it can enter the ordinary decoder exactly once. */
+enum { CS_RECORD_PUBLIC_ITER = 0, CS_RECORD_CANONICAL_ITER = 2 };
+#else
+enum { CS_RECORD_PUBLIC_ITER = 2, CS_RECORD_CANONICAL_ITER = 0 };
+#endif
 #else
 typedef bool cs_record_request;
+enum { CS_RECORD_CANONICAL_ITER = 0 };
 #endif
+
+static inline cs_record_request canonical_record_request(bool batch)
+{
+	return batch ? true : CS_RECORD_CANONICAL_ITER;
+}
 #if defined(CAPSTONE_X86_PUBLIC_FIXED_RECORD) || defined(CAPSTONE_X86_DIRECT_PUBLIC_RECORD)
 CAPSTONE_INTERNAL bool X86_decodeFixedRecord32(cs_struct *handle,
 		const uint8_t *code, size_t size, cs_insn *insn, uint16_t *length);
@@ -194,7 +206,8 @@ CS_DECODE_INLINE bool decode_insn(cs_struct *handle, const uint8_t *code,
 	return cs_decode_full_insn(handle, code, size, insn, insn_size,
 				   batch ? true : CS_RECORD_PUBLIC_ITER);
 #else
-	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
+	return cs_decode_full_insn(handle, code, size, insn, insn_size,
+				   canonical_record_request(batch));
 #endif
 }
 #undef CS_DECODE_SCAN
