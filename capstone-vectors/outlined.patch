diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 197453cb..3a70c8d8 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3753,10 +3753,32 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 					  cs_insn *insn, uint16_t *insn_size,
 					  bool batch);
 
+#if defined(X86_LINKED_PUBLIC_READER) && !defined(CAPSTONE_DIET) && \
+	!defined(CAPSTONE_X86_REDUCE) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#define X86_HAS_LINKED_READER
+/* A caller using only the public API need not extract the native readers. */
+#pragma weak X86_disasmIterText
+static inline bool hasLinkedIntelReader(const cs_struct *handle)
+{
+	return handle->arch == CS_ARCH_X86 && !handle->no_text &&
+	       (handle->mode == CS_MODE_32 || handle->mode == CS_MODE_64) &&
+	       (handle->syntax == CS_OPT_SYNTAX_DEFAULT ||
+		handle->syntax == CS_OPT_SYNTAX_INTEL) &&
+	       X86_disasmIterText != NULL;
+}
+#endif
+
 #ifdef CAPSTONE_X86_PUBLIC_OUTPUT
 #define CS_DECODE_OUTPUT_MISS X86_decodePublicRecord
 #elif defined(CAPSTONE_X86_PUBLIC_FIXED_RECORD)
 #define CS_PUBLIC_FIXED_RECORD
+#elif defined(X86_HAS_LINKED_READER)
+static inline bool decodeLinkedPublicRecord(cs_struct *handle,
+		const uint8_t *code, size_t size, cs_insn *insn,
+		uint16_t *length, bool batch);
+#define CS_DECODE_OUTPUT_MISS decodeLinkedPublicRecord
 #endif
 #define CS_DECODE_SCAN_IMPL decodeIteratorScan
 #include "../../cs_disasm_internal.h"
@@ -3765,6 +3787,23 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 #undef CS_DECODE_OUTPUT_MISS
 #endif
 
+#ifdef X86_HAS_LINKED_READER
+static inline bool decodeLinkedPublicRecord(cs_struct *handle,
+		const uint8_t *code, size_t size, cs_insn *insn,
+		uint16_t *length, bool batch)
+{
+	if (!batch && !handle->skipdata && hasLinkedIntelReader(handle)) {
+		uint64_t address = insn->address;
+		if (!X86_disasmIterText((csh)(uintptr_t)handle, &code, &size,
+					&address, insn))
+			return false;
+		*length = insn->size;
+		return true;
+	}
+	return cs_decode_full_insn(handle, code, size, insn, length, batch);
+}
+#endif
+
 /* Keep the admitted terminal's public ID and zero alias adjustment visible
  * through output completion. Cold helpers can take the fallback result's
  * address without forcing terminal output through that escaped object. */
