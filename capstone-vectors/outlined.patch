+/* Keep the buffer move and cursor recovery off the common return path. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static void trimLeadingSpace(SStream *ss)
+{
+	size_t offset = 1;
+	while (ss->buffer[offset] == ' ' || ss->buffer[offset] == '\t')
+		++offset;
+	// Keep an overreported cursor, but do not let an underreported
+	// count move the next write into the visible suffix.
+	if (ss->index < offset ||
+	    (ss->index < sizeof(ss->buffer) && ss->buffer[ss->index])) {
+		size_t written = offset + strlen(ss->buffer + offset);
+		if (ss->index < written)
+			ss->index = written;
+	}
+	memmove(ss->buffer, ss->buffer + offset,
+		SSTREAM_BUF_LEN - offset);
+	ss->index -= offset;
+}
