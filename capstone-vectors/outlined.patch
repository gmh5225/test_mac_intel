+/* The caller has checked the VEX header and selected a memory ModR/M. */
+static inline bool writeVexMappedMemory(const uint8_t *code, size_t size,
+					unsigned prefix, cs_insn *insn,
+					uint16_t *insn_size,
+					const struct X86SimpleRegister *regs,
