diff --git a/arch/WASM/WASMInstPrinter.c b/arch/WASM/WASMInstPrinter.c
index 466543c3..2efea686 100644
--- a/arch/WASM/WASMInstPrinter.c
+++ b/arch/WASM/WASMInstPrinter.c
@@ -4,6 +4,23 @@
 #include "WASMInstPrinter.h"
 #include "WASMMapping.h"
 
+/* A custom formatter can observe the order and format of each call. */
+#if defined(__GNUC__)
+__attribute__((cold, noinline))
+#endif
+static void printBranchTableFields(SStream *O, const cs_wasm_brtable *table)
+{
+	SStream_concat(O, "\t0x%x, [", table->length);
+	if (table->address <= UINT32_MAX)
+		SStream_concat(O, "0x%x",
+			       (unsigned)table->address);
+	else
+		SStream_concat(O, "0x%" PRIx64,
+			       table->address);
+	SStream_concat(O, "], 0x%x",
+		       table->default_target);
+}
+
 void WASM_printInst(MCInst *MI, struct SStream *O, void *PrinterInfo)
 {
 #ifdef WASM_LITERAL_NAMES
@@ -47,12 +64,23 @@ void WASM_printInst(MCInst *MI, struct SStream *O, void *PrinterInfo)
 		SStream_concat(O, "\t%d", MI->wasm_data.int7);
 		break;
 
-	case WASM_OP_BRTABLE:
-		SStream_concat(O, "\t0x%x, [", MI->wasm_data.brtable.length);
-		SStream_concat(O, "0x%x", MI->wasm_data.brtable.address);
-		SStream_concat(O, "], 0x%x",
-			       MI->wasm_data.brtable.default_target);
-
+	case WASM_OP_BRTABLE: {
+		const cs_wasm_brtable *table = &MI->wasm_data.brtable;
+#if !defined(CAPSTONE_DIET) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+		/* With the default formatter, these three fields are one string.
+		 * Markup and custom callbacks retain the individual appends. */
+		if (cs_vsnprintf == cs_default_vsnprintf &&
+		    !(O->markup_stream && O->prefixed_by_markup)) {
+			SStream_concat(O, "\t0x%x, [0x%" PRIx64 "], 0x%x",
+				       table->length, table->address,
+				       table->default_target);
+			break;
+		}
+#endif
+		printBranchTableFields(O, table);
 		break;
 	}
+	}
 }
diff --git a/tests/unit/wasm_brtable_size.c b/tests/unit/wasm_brtable_size.c
index 52130880..f1d5ac2f 100644
--- a/tests/unit/wasm_brtable_size.c
+++ b/tests/unit/wasm_brtable_size.c
@@ -120,6 +120,24 @@ static int check_i64_constant(csh handle)
 	return !ok;
 }
 
+static int check_table_address(csh handle)
+{
+	const uint8_t code[] = { 0x0e, 0x02, 0x00, 0x01, 0x02 };
+	const uint64_t address = UINT64_C(0xfffffffe);
+	cs_insn *insn = NULL;
+	if (cs_option(handle, CS_OPT_DETAIL, CS_OPT_ON) != CS_ERR_OK)
+		return 1;
+	size_t count = cs_disasm(handle, code, sizeof(code), address, 1, &insn);
+	bool ok = count == 1 && insn->id == WASM_INS_BR_TABLE &&
+		  insn->detail->wasm.operands[0].brtable.address == address + 2;
+	if (ok && !cs_support(CS_SUPPORT_DIET))
+		ok = strcmp(insn->op_str, "0x2, [0x100000000], 0x2") == 0;
+	cs_free(insn, count);
+	if (!ok)
+		fprintf(stderr, "WASM br_table target list address lost high bits\n");
+	return !ok;
+}
+
 int main(void)
 {
 	csh h;
@@ -127,7 +145,8 @@ int main(void)
 		return 1;
 
 	if (check_copy_sizes(h) || run_count_case(h, 10, 5) ||
-	    run_count_case(h, 65531, 5) || check_i64_constant(h)) {
+	    run_count_case(h, 65531, 5) || check_i64_constant(h) ||
+	    check_table_address(h)) {
 		cs_close(&h);
 		return 1;
 	}
