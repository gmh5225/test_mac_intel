+/* A displacement used as an absolute address has the effective address
+ * width even if the memory operand or a following immediate is narrower. */
+static inline unsigned X86_effectiveAddressSize(const MCInst *mi)
 {
+	const bool address_override = mi->x86_prefix[3] == X86_PREFIX_ADDRSIZE;
+	const cs_mode mode = mi->csh->mode;
 	if (x86_has_feature(mode, CS_MODE_16))
-		return UINT16_MAX;
+		return address_override ? 4 : 2;
 	if (x86_has_feature(mode, CS_MODE_32))
-		return UINT32_MAX;
-	return UINT64_MAX;
+		return address_override ? 2 : 4;
+	return address_override ? 4 : 8;
 }
 
