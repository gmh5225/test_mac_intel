diff --git a/suite/synctools/x86_printer_dispatch.py b/suite/synctools/x86_printer_dispatch.py
index 3e163ec6..67e0003b 100644
--- a/suite/synctools/x86_printer_dispatch.py
+++ b/suite/synctools/x86_printer_dispatch.py
@@ -178,6 +178,40 @@ def path_extent(path, prefix_length):
     return length
 
 
+def vector_memory_register_pair(path):
+    separator = 'SStream_concat0(O, ", ");'
+    if (len(path) != 6 or path[0] != "printOperand(MI, 0, O);" or
+            path[1] != separator or path[3] != separator or path[5] != "return;"):
+        return None
+    second = re.fullmatch(r"printOperand\(MI, (\d+), O\);", path[2])
+    memory = re.fullmatch(r"print[if](?:128|256|512)mem\(MI, (\d+), O\);", path[4])
+    if second and memory and int(second[1]) + 1 == int(memory[1]):
+        return int(second[1])
+    return None
+
+
+def typed_vector_pairs(paths):
+    import x86_operand_specializations as operands
+
+    table = ROOT / "arch/X86/X86GenDisassemblerTables.inc"
+    sets = operands.read_sets(table, include_duplicates=True)
+    specs = operands.instruction_specifiers(table.read_text())
+    require(len(specs) == len(paths), "Decoder and printer opcode counts differ")
+    eligible = {path for path in paths if vector_memory_register_pair(path) is not None}
+    for path, index in zip(paths, specs):
+        if path not in eligible:
+            continue
+        memory = vector_memory_register_pair(path) + 1
+        fields = operands.resolve_duplicates(sets[index])
+        if (len(fields) <= memory or fields[memory][0] not in operands.RM_ENCODINGS
+                or fields[memory][1] != "TYPE_M"
+                or any(e not in {"ENCODING_REG", "ENCODING_VVVV"} or
+                       t not in {"TYPE_XMM", "TYPE_YMM", "TYPE_ZMM", "TYPE_VK"}
+                       for e, t in fields[:memory])):
+            eligible.remove(path)
+    return eligible
+
