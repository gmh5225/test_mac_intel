diff --git a/arch/X86/X86Vex32Output.c b/arch/X86/X86Vex32Output.c
index d6f533e0..73c29fd5 100644
--- a/arch/X86/X86Vex32Output.c
+++ b/arch/X86/X86Vex32Output.c
@@ -150,6 +150,72 @@ static bool writeExtend32(const uint8_t *code, size_t size, cs_insn *insn,
 	return true;
 }
 
+#ifdef X86_I386_CONDITION_OUTPUT
+#include "X86ConditionIDs.h"
+
+/* Short Jcc already has the same condition suffix and EFLAGS mask. Only
+ * the assigned instruction ID and the register operands differ by family. */
+static __attribute__((noinline)) void writeConditionRegisters32(
+	const uint8_t *code, cs_insn *insn, uint16_t *insn_size)
+{
+	static const uint16_t set_ids[] = X86_CONDITION_IDS(X86_INS_SET);
+	static const uint16_t move_ids[] = X86_CONDITION_IDS(X86_INS_CMOV);
+	const unsigned opcode = code[1], cc = opcode & 15, mr = code[2];
+	const unsigned plan = x86_simple_plans[0][0][0x70 + cc];
+	const struct X86SimpleOutput *condition = &x86_simple_outputs[plan >> 2];
+	const bool move = opcode < 0x50;
+	const struct X86SimpleRegister *reg = move ?
+		&x86_simple_registers[2][(mr >> 3) & 7] :
+		&x86_simple_registers[0][mr & 7];
+	const struct X86SimpleRegister *source = &x86_simple_registers[2][mr & 7];
+
+	insn->id = move ? move_ids[cc] : set_ids[cc];
+	*insn_size = insn->size = 3;
+	memcpy(insn->bytes, code, 3);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	if (move)
+		memcpy(insn->mnemonic, "cmov", 4);
+	else
+		memcpy(insn->mnemonic, "set", 3);
+	memcpy(insn->mnemonic + (move ? 4 : 3), condition->mnemonic + 1,
+	       sizeof(condition->mnemonic) - 1);
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, reg->name, sizeof(reg->name));
+	if (move) {
+		char *end = insn->op_str + reg->length;
+		memcpy(end, ", ", 2);
+		memcpy(end + 2, source->name, sizeof(source->name));
+	}
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		d->regs_read[0] = X86_REG_EFLAGS;
+		d->regs_read_count = 1;
+		cs_x86 *x = &d->x86;
+		x->opcode[0] = 0x0f;
+		x->opcode[1] = (uint8_t)opcode;
+		x->addr_size = 4;
+		x->modrm = (uint8_t)mr;
+		x->encoding.modrm_offset = 2;
+		x->eflags = condition->flags;
+		x->op_count = 1;
+		x->operands[0].type = X86_OP_REG;
+		x->operands[0].reg = (x86_reg)reg->reg;
+		x->operands[0].size = move ? 4 : 1;
+		x->operands[0].access = CS_AC_WRITE;
+		if (move) {
+			d->groups[0] = X86_GRP_CMOV;
+			d->groups_count = 1;
+			x->op_count = 2;
+			x->operands[1].type = X86_OP_REG;
+			x->operands[1].reg = (x86_reg)source->reg;
+			x->operands[1].size = 4;
+			x->operands[1].access = CS_AC_READ;
+		}
+	}
+}
+#endif
