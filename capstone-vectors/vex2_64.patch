index 97642338..f186e526 100644
--- a/arch/X86/X86Sse64Output.c
+++ b/arch/X86/X86Sse64Output.c
@@ -17,7 +17,8 @@
 #define X86_FIXED_VEX2 writeVex2Memory64
 #include "X86SimpleOutput.h"
 #include "X86GenSimpleOutput.inc"
-#include "X86VectorRegisterWriter.h"
+#include "X86VectorRegisterOutput.h"
+#include "X86GenVex2Register64.inc"
 #define X86_MEMORY_IMMEDIATE writeMemoryImmediate64
 #define X86_IMMEDIATE_WIDE 1
 #include "X86MemoryOutputImpl.h"
@@ -121,6 +122,19 @@ static bool writePackedMemory(const uint8_t *code, cs_insn *insn,
 static bool writeVex2Memory64(const uint8_t *code, size_t size, cs_insn *insn,
 			      uint16_t *insn_size)
 {
+	if (size >= 4 && code[3] >= 0xc0 && (code[1] & 3) != 1) {
+		const unsigned flags = code[1], ll = (flags >> 2) & 1;
+		const unsigned index =
+			vex2_register64_plans[code[2]][flags & 7];
+		if (!index)
+			return false;
+		const unsigned r = (~flags >> 5) & 4;
+		const unsigned regs[] = { ((code[3] >> 3) & 7) | (r << 1),
+					  (~flags >> 3) & 15, code[3] & 7 };
+		return writeVectorRegisters(code, insn, insn_size,
+					    &vex2_register64_rows[index], 2, ll,
