+// Emit the VEX2 register forms that the static 64-bit iterator can finish.
+void emit_vex2_registers64(Decoder &decoder)
+{
+	std::vector<std::string> rows;
+	std::array<std::array<unsigned, 8>, 256> plans{};
+	for (unsigned opcode = 0; opcode < plans.size(); ++opcode) {
+		for (unsigned flags = 0; flags < 8; ++flags) {
+			const unsigned ll = flags >> 2, pp = flags & 3;
+			if (pp == 1)
+				continue;
+			auto probe = [&](unsigned dst, unsigned src,
+					 unsigned rm) {
+				return vex_register_row(decoder, 1, opcode, 0,
+							ll, (dst & 8) >> 1,
+							dst & 7, src, rm, true,
+							false, 0, false, false,
+							pp);
+			};
+			const auto row = probe(1, 2, 3);
+			if (row.empty())
+				continue;
+			bool uniform = true;
+			for (unsigned n = 0; n < 2048 && uniform; ++n)
+				uniform = probe(n >> 7, (n >> 3) & 15, n & 7) ==
+					  row;
+			if (!uniform)
+				continue;
+			const auto it =
+				std::find(rows.begin(), rows.end(), row);
+			const unsigned id = unsigned(it - rows.begin()) + 1;
+			if (id > UINT8_MAX)
+				throw std::runtime_error(
+					"VEX2 register row exceeds byte index");
+			if (it == rows.end())
+				rows.push_back(row);
+			plans[opcode][flags] = id;
+		}
+	}
+	if (!plans[0x58][0] || !plans[0x59][4])
+		throw std::runtime_error(
+			"missing packed VADDPS or VMULPS register forms");
+	std::puts(
+		"/* Generated by suite/synctools/x86_vector_output.cpp --vex2-registers64. */");
+	std::puts(
+		"static const struct VectorOutputRow vex2_register64_rows[] = {\n\t{ 0 },");
+	for (const auto &row : rows)
+		std::printf("\t%s,\n", row.c_str());
+	std::puts("};\nstatic const uint8_t vex2_register64_plans[256][8] = {");
+	for (const auto &op : plans) {
+		std::printf("\t{ %u, %u, %u, %u, %u, %u, %u, %u },\n", op[0],
+			    op[1], op[2], op[3], op[4], op[5], op[6], op[7]);
+	}
+	std::puts("};");
+	std::fprintf(stderr,
+		     "%zu VEX2 register rows, %llu ordinary decoder probes\n",
+		     rows.size(),
+		     static_cast<unsigned long long>(decoder.probes));
+}
