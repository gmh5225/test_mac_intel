diff --git a/arch/X86/X86OutputOptions.h b/arch/X86/X86OutputOptions.h
new file mode 100644
index 00000000..28ac12db
--- /dev/null
+++ b/arch/X86/X86OutputOptions.h
@@ -0,0 +1,23 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_OUTPUT_OPTIONS_H
+#define CS_X86_OUTPUT_OPTIONS_H
+
+#include "X86Disassembler.h"
+#include "X86InstPrinter.h"
+#include "X86Mapping.h"
+
+/* Expand at each entry to preserve its branch structure; pass a local handle pointer. */
+#define X86_OUTPUT_OPTIONS_REJECT(handle) \
+	((handle)->no_text || (handle)->imm_unsigned || (handle)->mnem_list || \
+	 (handle)->doing_mem || \
+	 ((handle)->syntax != CS_OPT_SYNTAX_INTEL && \
+	  (handle)->syntax != CS_OPT_SYNTAX_DEFAULT) || \
+	 (handle)->disasm != X86_getInstruction || \
+	 (handle)->insn_id != X86_get_insn_id || \
+	 (handle)->printer != X86_Intel_printInst || \
+	 (handle)->post_printer != X86_postprinter || \
+	 cs_vsnprintf != cs_default_vsnprintf)
+
+#endif
