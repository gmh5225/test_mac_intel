diff --git a/arch/X86/X86MemoryOutputImpl.h b/arch/X86/X86MemoryOutputImpl.h
index 5dd7240d..cbd3234c 100644
--- a/arch/X86/X86MemoryOutputImpl.h
+++ b/arch/X86/X86MemoryOutputImpl.h
@@ -171,4 +171,24 @@ bool X86_writeMemoryOutput(
 	return true;
 }
 
+#ifdef X86_MEMORY_IMMEDIATE
+static bool writeCompareMemory(cs_struct *handle, const uint8_t *code,
+			       size_t size, cs_insn *insn, uint16_t *insn_size,
+			       unsigned prefix_class)
+{
+	const unsigned lead = prefix_class != 0;
+	if (size < lead + 2 || code[lead + 1] >= 0xc0 ||
+	    (code[lead + 1] & 0x38) != 0x38 ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	/* CMP r/m, reg supplies the same flags, operand widths and memory access. */
+	const unsigned row = x86_simple_plans[X86_IMMEDIATE_WIDE][prefix_class]
+					     [0x38 | (code[lead] & 1)] >>
+			     2;
+	return X86_MEMORY_IMMEDIATE(code, size, insn, insn_size,
+				    &x86_simple_outputs[row],
+				    x86_simple_registers);
+}
+#endif
+
 #endif
