+						unsigned src, unsigned rm) {
+					return observe_rounded(decoder, map,
+							       opcode, key & 3,
+							       key >> 2, rc,
+							       dst, src, rm,
+							       row);
+				};
+				if (!same(0, 3, 2, 1))
+					continue;
+				bool uniform = true;
+				for (unsigned rc = 0; rc < 4 && uniform; ++rc)
+					for (unsigned n = 0;
+					     n < 32768 && uniform; ++n)
+						uniform = same(rc, n >> 10,
+							       (n >> 5) & 31,
+							       n & 31);
+				if (!uniform)
+					continue;
