+			for (unsigned i = 0; i < sizeof(ops); ++i) {
+				const unsigned op = ops[i];
+				uint8_t bytes[] = { 0xc5,
+						    (uint8_t)flags,
+						    (uint8_t)op,
+						    (uint8_t)mr,
+						    0,
+						    0,
+						    0,
+						    0,
+						    0 };
