+bool decode_sse(Decoder &decoder, const uint8_t *code, size_t size)
+{
+	const uint8_t *cursor = code;
+	size_t left = size;
+	uint64_t ip = UINT64_MAX - 1;
+	cs_insn &insn = *decoder.insn;
+	insn.is_alias = insn.usesAliasDetails = insn.illegal = false;
