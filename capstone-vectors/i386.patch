+				if (end >= size)
+					return 0;
+				if ((code[end] & 7) == 5)
+					end += 4;
+			}
+			end += extra[mod][rm];
+		}
+	}
+	end += plan & 1;
+	if (end > size)
+		return 0;
+	return ((plan >> 3) << 8) | end;
+}
