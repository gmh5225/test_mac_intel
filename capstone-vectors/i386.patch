+void emit_vex64_packed(Decoder &decoder)
+{
+	std::vector<std::string> rows{ "{ { 0 }, false, false }" };
+	unsigned plans[8][256]{};
+	for (unsigned flags = 0; flags < 8; ++flags) {
+		for (unsigned opcode = 0; opcode < 256; ++opcode) {
+			for (bool reverse : { false, true }) {
+				std::string row;
+				if (!supports_packed_memory(decoder, opcode,
+							    reverse, int(flags),
+							    &row))
+					continue;
+				row = "{ " + row +
+				      (reverse ? ", true, true }" :
+						 ", false, true }");
+				auto found = std::find(rows.begin(), rows.end(),
+						       row);
+				plans[flags][opcode] =
+					unsigned(found - rows.begin());
+				if (found == rows.end())
+					rows.push_back(row);
+				break;
+			}
+		}
+	}
+	if (rows.size() > 256 || !plans[0][0x10] || !plans[4][0x29] ||
+	    !plans[5][0x6f])
+		throw std::runtime_error("unexpected packed VEX memory rows");
+	std::cout
+		<< "/* Generated by x86_simple_output.cpp --vex64-packed-memory. */\n"
+		<< "static const struct X86SseRegisterOutput vex64_packed_rows[] = {\n";
+	for (const auto &row : rows)
+		std::cout << '\t' << row << ",\n";
+	std::cout
+		<< "};\nstatic const uint8_t vex64_packed_plans[8][256] = {\n";
+	for (const auto &block : plans) {
+		std::cout << "\t{\n";
+		for (unsigned i = 0; i < 256; i += 16) {
+			std::cout << "\t\t";
+			for (unsigned j = 0; j < 16; ++j)
+				std::cout << (j ? " " : "") << block[i + j]
+					  << ',';
+			std::cout << '\n';
+		}
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+	std::cerr << rows.size() - 1 << " packed 64-bit VEX memory rows\n";
+}
+
+void emit_sse64_registers(Decoder &decoder)
+{
+	X86SimpleRegister regs[16]{};
+	for (unsigned i = 0; i < 16; ++i) {
+		auto &reg = regs[i];
+		reg.reg = uint16_t(X86_REG_XMM0 + i);
+		const char *name = cs_reg_name(decoder.handle, reg.reg);
+		if (!name || std::strlen(name) >= sizeof(reg.name))
+			throw std::runtime_error("invalid XMM register name");
+		std::strcpy(reg.name, name);
+	}
+	std::vector<std::string> table(256);
+	unsigned first = 256, last = 0, count = 0;
+	for (unsigned opcode = 0; opcode < table.size(); ++opcode) {
+		bool reverse = false;
+		auto row = describe_sse_pair(decoder, regs, opcode, 0, 0xd9,
+					     false);
+		if (row.empty()) {
+			reverse = true;
+			row = describe_sse_pair(decoder, regs, opcode, 0, 0xd9,
+						true);
+		}
+		if (row.empty())
+			continue;
+		bool uniform = true;
+		for (unsigned prefix = 0; prefix <= 16 && uniform; ++prefix) {
+			unsigned rex = prefix ? 0x3f + prefix : 0;
+			for (unsigned mr = 0xc0; mr <= 0xff; ++mr)
+				if (describe_sse_pair(decoder, regs, opcode,
+						      rex, mr,
+						      reverse) != row) {
+					uniform = false;
+					break;
+				}
+		}
+		if (uniform) {
+			table[opcode] = "{ " + row +
+					(reverse ? ", true" : ", false") +
+					(supports_packed_memory(decoder, opcode,
+								reverse) ?
+						 ", true }" :
+						 ", false }");
+			first = std::min(first, opcode);
+			last = opcode;
+			++count;
+		}
+	}
+	if (table[0x28].empty() || table[0x58].empty() || table[0x59].empty())
+		throw std::runtime_error("missing legacy SSE register forms");
+	std::cout
+		<< "/* Generated by x86_simple_output.cpp --sse64-registers. */\n"
+		<< "#define X86_SSE_REGISTER_FIRST " << first << "u\n"
+		<< "static const struct X86SseRegisterOutput x86_sse_register_outputs[] = {\n";
+	for (unsigned opcode = first; opcode <= last; ++opcode)
+		std::cout
+			<< "\t"
+			<< (table[opcode].empty() ? "{ { 0 }, false, false }" :
+						    table[opcode])
+			<< ",\n";
+	std::cout << "};\n";
+	std::cerr << count
+		  << " SSE opcodes verified over every REX and register pair\n";
+}
+
+void emit_indirect_memory(Decoder &decoder, const RegisterTable &regs)
+{
+	std::cout
+		<< "/* Generated by x86_simple_output.cpp --indirect-memory. */\n"
+		   "static const struct X86SimpleOutput x86_indirect_memory[2] = {\n";
+	for (unsigned group : { 2u, 4u }) {
+		const auto id = group == 2 ? X86_INS_CALL : X86_INS_JMP;
