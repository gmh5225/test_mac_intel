+void emit_bit_registers(Decoder &decoder, const RegisterTable &regs)
+{
+	std::cout
+		<< "/* Generated by x86_simple_output.cpp --bit-registers64. */\n"
+		   "static const struct X86SimpleOutput x86_bit_registers[2][4] = {\n";
+	for (unsigned wide = 0; wide < 2; ++wide) {
+		std::cout << "\t{\n";
+		for (uint8_t opcode : { 0xa3, 0xab, 0xb3, 0xbb }) {
+			CheckedRow row;
+			for (unsigned prefix = 0; prefix <= 16; ++prefix) {
+				uint8_t rex = prefix ? uint8_t(0x3f + prefix) :
+						       0;
+				if (((rex >> 3) & 1) != wide)
+					continue;
+				for (unsigned modrm = 0xc0; modrm <= 0xff;
+				     ++modrm) {
+					uint8_t mr = uint8_t(modrm);
+					const uint8_t bytes[] = { rex, 0x0f,
+								  opcode, mr };
+					unsigned offset = rex ? 0 : 1;
+					decoder.decode(bytes + offset,
+						       4 - offset, 4 - offset,
+						       0);
+					const auto &first =
+						regs[2 + wide][((rex & 1) << 3) |
+							       (mr & 7)];
+					const auto &second =
+						regs[2 + wide][((rex & 4) << 1) |
+							       ((mr >> 3) & 7)];
+					row.observe(describe(
+						*decoder.insn, opcode, rex, mr,
+						&first, &second, false, false,
+						true));
+				}
+			}
+			std::cout << "\t\t" << row.fields << ",\n";
+		}
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+}
