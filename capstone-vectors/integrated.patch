+		for (const auto v : p)
+			std::printf(" %u,", v);
+		std::puts(" },");
+	}
+	std::puts("};\nstatic const uint8_t evex_rounded_plans[3][256] = {");
+	for (const auto &p : plans) {
+		std::puts("\t{");
+		for (unsigned n = 0; n < p.size(); n += 16) {
+			std::printf("\t\t");
+			for (unsigned k = 0; k < 16; ++k)
+				std::printf("%s%u,", k ? " " : "", p[n + k]);
+			std::putchar('\n');
+		}
+		std::puts("\t},");
+	}
