diff --git a/suite/synctools/x86_simple_output.cpp b/suite/synctools/x86_simple_output.cpp
index 01c14a71..601c2b86 100644
--- a/suite/synctools/x86_simple_output.cpp
+++ b/suite/synctools/x86_simple_output.cpp
@@ -1104,10 +1104,37 @@ void emit_indirect64(Decoder &decoder, const RegisterTable &regs)
 	std::cout << "};\n";
 }
 
+// Read the suffix from the ordinary Intel printer, including spacing and
+// its decimal/hexadecimal threshold. The base register makes zero unambiguous.
+void emit_short_displacements(Decoder &decoder)
+{
+	const std::string prefix = "eax, dword ptr [eax";
+	std::cout << "/* Generated by x86_simple_output.cpp --short-displacements. */\n"
+		  << "const struct X86ShortDisplacement x86_short_displacements[256] = {\n";
+	for (unsigned byte = 0; byte != 256; ++byte) {
+		const uint8_t mov[] = { 0x8b, 0x40, static_cast<uint8_t>(byte) };
+		decoder.decode(mov, sizeof(mov), sizeof(mov), 0);
+		const std::string operands = decoder.insn->op_str;
+		if (operands.compare(0, prefix.size(), prefix) || operands.back() != ']')
+			throw std::runtime_error("unexpected base-relative MOV operands");
+		const auto text = operands.substr(prefix.size(), operands.size() - prefix.size() - 1);
+		if (byte ? text.size() < 4 || text.size() > 7 : !text.empty())
+			throw std::runtime_error("invalid short displacement token");
+		std::cout << "\t{ \"" << text << "\", " << text.size() << " },\n";
+	}
+	std::cout << "};\n";
+}
+
 } // namespace
 
 int main(int argc, char **argv)
 {
+	if (argc == 2 && std::strcmp(argv[1], "--short-displacements") == 0) {
+		Decoder decoder(CS_MODE_32);
+		emit_short_displacements(decoder);
+		return 0;
+	}
+
 	if (argc == 2 && std::strcmp(argv[1], "--vex64-packed-memory") == 0) {
 		Decoder decoder(CS_MODE_64);
 		emit_vex64_packed(decoder);
@@ -1138,7 +1165,7 @@ int main(int argc, char **argv)
