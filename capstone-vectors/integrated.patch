+static bool check_bit_registers(csh handles[2])
+{
+	for (unsigned prefix = 0; prefix <= 16; ++prefix) {
+		const unsigned offset = prefix ? 0 : 1;
+		for (unsigned opcode = 0xa3; opcode <= 0xbb; opcode += 8) {
+			for (unsigned mr = 0; mr < 256; ++mr) {
+				const uint8_t bytes[] = {
+					(uint8_t)(0x3f + prefix),
+					0x0f,
+					(uint8_t)opcode,
+					(uint8_t)mr,
+					0x24,
+					1,
+					2,
+					3,
+					4
+				};
+				if (!compare(handles, bytes + offset,
+					     sizeof(bytes) - offset, mr) ||
+				    !compare(handles, bytes + offset, mr % 5,
+					     prefix))
+					return false;
+			}
+		}
+	}
+	return true;
+}
