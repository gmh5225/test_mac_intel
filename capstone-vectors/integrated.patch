diff --git a/arch/X86/X86Mapping.c b/arch/X86/X86Mapping.c
index bc463d2b..9713cf3b 100644
--- a/arch/X86/X86Mapping.c
+++ b/arch/X86/X86Mapping.c
@@ -11979,6 +11979,18 @@ const uint8_t *X86_get_op_access(cs_struct *h, unsigned int id,
 	return NULL;
 }
 
+/* Preserve operand order while extending a caller-owned register list. */
+static inline uint16_t *append_distinct_register(uint16_t *begin, uint16_t *end,
+						 unsigned int reg)
+{
+	for (const uint16_t *p = end; p != begin;) {
+		if (*--p == reg)
+			return end;
+	}
+	*end = (uint16_t)reg;
+	return end + 1;
+}
+
 void X86_reg_access(const cs_insn *insn, cs_regs regs_read,
 		    uint8_t *regs_read_count, cs_regs regs_write,
 		    uint8_t *regs_write_count)
@@ -12002,48 +12014,35 @@ void X86_reg_access(const cs_insn *insn, cs_regs regs_read,
 		memcpy(regs_write, insn->detail->regs_write,
 		       write_count * sizeof(insn->detail->regs_write[0]));
 
-	// explicit registers
-	for (i = 0; i < x86->op_count; i++) {
-		cs_x86_op *op = &(x86->operands[i]);
+	uint16_t *read_end = regs_read + read_count;
+	uint16_t *write_end = regs_write + write_count;
+	for (i = 0; i < x86->op_count; ++i) {
+		const cs_x86_op *op = &x86->operands[i];
 		switch ((int)op->type) {
 		case X86_OP_REG:
-			if ((op->access & CS_AC_READ) &&
-			    !arr_exist_inline(regs_read, read_count, op->reg)) {
-				regs_read[read_count] = op->reg;
-				read_count++;
-			}
-			if ((op->access & CS_AC_WRITE) &&
-			    !arr_exist_inline(regs_write, write_count,
-					      op->reg)) {
-				regs_write[write_count] = op->reg;
-				write_count++;
-			}
+			if (op->access & CS_AC_READ)
+				read_end = append_distinct_register(
+					regs_read, read_end, op->reg);
+			if (op->access & CS_AC_WRITE)
+				write_end = append_distinct_register(
+					regs_write, write_end, op->reg);
 			break;
 		case X86_OP_MEM:
-			// registers appeared in memory references always being read
-			if ((op->mem.segment != X86_REG_INVALID)) {
-				regs_read[read_count] = op->mem.segment;
-				read_count++;
-			}
-			if ((op->mem.base != X86_REG_INVALID) &&
-			    !arr_exist_inline(regs_read, read_count,
-					      op->mem.base)) {
-				regs_read[read_count] = op->mem.base;
-				read_count++;
-			}
-			if ((op->mem.index != X86_REG_INVALID) &&
-			    !arr_exist_inline(regs_read, read_count,
-					      op->mem.index)) {
-				regs_read[read_count] = op->mem.index;
-				read_count++;
-			}
+			if (op->mem.segment != X86_REG_INVALID)
+				*read_end++ = (uint16_t)op->mem.segment;
+			if (op->mem.base != X86_REG_INVALID)
+				read_end = append_distinct_register(
+					regs_read, read_end, op->mem.base);
+			if (op->mem.index != X86_REG_INVALID)
+				read_end = append_distinct_register(
+					regs_read, read_end, op->mem.index);
+			break;
 		default:
 			break;
 		}
 	}
-
-	*regs_read_count = read_count;
-	*regs_write_count = write_count;
+	*regs_read_count = (uint8_t)(read_end - regs_read);
+	*regs_write_count = (uint8_t)(write_end - regs_write);
 }
 #endif
 
