+					continue;
+				for (unsigned modrm = 0xc0; modrm <= 0xff;
+				     ++modrm) {
+					const uint8_t mr = uint8_t(modrm);
+					const uint8_t bytes[] = { rex, 0x0f,
+								  opcode, mr };
+					const unsigned lead = !rex;
+					decoder.decode(bytes + lead,
+						       sizeof(bytes) - lead,
+						       sizeof(bytes) - lead, 0);
+					const auto *names = regs[2 + wide];
+					const auto &dst =
+						names[((rex & 4) << 1) |
+						      ((mr >> 3) & 7)];
+					const auto &src =
+						names[((rex & 1) << 3) |
+						      (mr & 7)];
+					row.observe(describe(*decoder.insn,
+							     opcode, rex, mr,
+							     &dst, &src, false,
+							     false, true));
+				}
+			}
+			std::cout << "\t\t" << row.fields << ",\n";
+		}
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+}
