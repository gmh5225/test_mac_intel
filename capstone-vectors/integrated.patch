+void emit_cmov(Decoder &decoder, const RegisterTable &regs)
+{
+	CheckedRow operands;
+	CheckedRow conditions[16];
+	for (unsigned wide = 0; wide < 2; ++wide) {
+		for (uint8_t opcode = 0x40; opcode <= 0x4f; ++opcode) {
+			for (unsigned prefix = 0; prefix <= 16; ++prefix) {
+				uint8_t rex = prefix ? uint8_t(0x3f + prefix) :
+						       0;
+				if (bool(rex & 8) != bool(wide))
+					continue;
+				for (unsigned modrm = 0xc0; modrm <= 0xff;
+				     ++modrm) {
+					const uint8_t mr = uint8_t(modrm);
+					const uint8_t bytes[] = { rex, 0x0f,
+								  opcode, mr };
+					const unsigned lead = !rex;
+					decoder.decode(bytes + lead,
+						       sizeof(bytes) - lead,
+						       sizeof(bytes) - lead, 0);
+					const auto *names = regs[2 + wide];
+					const auto &dst =
+						names[((rex & 4) << 1) |
+						      ((mr >> 3) & 7)];
+					const auto &src =
+						names[((rex & 1) << 3) |
+						      (mr & 7)];
+					const cs_insn &insn = *decoder.insn;
+					if (strlen(insn.mnemonic) >=
+						    sizeof(X86SimpleOutput::
+								   mnemonic) ||
+					    strpbrk(insn.mnemonic,
+						    "\n\r\t\\\"") ||
+					    insn.detail->x86.op_count != 2)
+						throw std::runtime_error(
+							"unrepresentable conditional move");
+					std::ostringstream out;
+					out << "{ " << insn.id << ", \""
+					    << insn.mnemonic << "\", UINT64_C("
+					    << insn.detail->x86.eflags << ") }";
+					conditions[opcode & 15].observe(
+						out.str());
+					// The condition and operand width are supplied by the encoding.
+					// Every remaining public field must match one template.
+					cs_insn projected = insn;
+					cs_detail detail = *insn.detail;
+					projected.detail = &detail;
+					projected.id = 0;
+					projected.mnemonic[0] = '\0';
+					detail.x86.eflags = 0;
+					for (unsigned i = 0; i < 2; ++i) {
+						if (detail.x86.operands[i].size !=
+						    (4u << wide))
+							throw std::runtime_error(
+								"unexpected CMOV operand width");
+						detail.x86.operands[i].size = 4;
+					}
+					operands.observe(
+						describe(projected, opcode, rex,
+							 mr, &dst, &src, false,
+							 false, true));
+				}
+			}
+		}
+	}
+	if (operands.encodings != 16 * 17 * 64)
+		throw std::runtime_error(
+			"incomplete conditional move coverage");
+	std::cout
+		<< "/* Generated by x86_simple_output.cpp --cmov64. */\n"
+		<< "static const struct X86SimpleOutput x86_cmov_operands = "
+		<< operands.fields << ";\n"
+		<< "struct X86CmovCondition { uint16_t id; char mnemonic[sizeof(((struct X86SimpleOutput *)0)->mnemonic)]; uint64_t flags; };\n"
+		<< "static const struct X86CmovCondition x86_cmov_conditions[16] = {\n";
+	for (const auto &condition : conditions)
+		std::cout << "\t" << condition.fields << ",\n";
+	std::cout << "};\n";
+}
