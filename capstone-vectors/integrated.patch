diff --git a/arch/X86/X86RegisterImmediateOutput.h b/arch/X86/X86RegisterImmediateOutput.h
index d9f9b5dd..f06c42e9 100644
--- a/arch/X86/X86RegisterImmediateOutput.h
+++ b/arch/X86/X86RegisterImmediateOutput.h
@@ -5,6 +5,7 @@
 #define CS_X86_REGISTER_IMMEDIATE_OUTPUT_H
 
 #include "X86SimpleOutput.h"
+#include "X86OutputOptions.h"
 #include "X86UnsignedImmediate.h"
 
 /* MOV opcode-register and TEST ModR/M-register forms have unsigned immediates.
@@ -40,4 +41,40 @@ static inline void writeUnsignedRegisterImmediate(
 	}
 }
 
+/* The accumulator opcodes and MOV r8, imm8 have no ModR/M. Their operand
+ * widths, register access and flags come from the corresponding ordinary row.
+ * A word or qword immediate has different extension and printing rules. */
+static inline bool
+writeOpcodeRegisterImmediate(cs_struct *handle, const uint8_t *code,
+			     size_t size, cs_insn *insn, uint16_t *insn_size,
+			     bool wide, const uint16_t plans[4][256],
+			     const struct X86SimpleOutput *rows,
+			     const struct X86SimpleRegister regs[4][16])
+{
+	const uint8_t rex = wide && (code[0] & 0xf0) == 0x40 ? code[0] : 0;
+	const unsigned lead = rex != 0;
+	if (size < lead + 2)
+		return false;
+	const uint8_t opcode = code[lead];
+	const bool mov = (opcode & 0xf8) == 0xb0;
+	const bool accumulator = (opcode & 0xc6) == 4;
+	if (!mov && !accumulator && (opcode & 0xfe) != 0xa8)
+		return false;
+	const bool byte = mov || !(opcode & 1);
+	if ((!byte && ((rex & 8) || size < lead + 5)) ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	const unsigned reg_opcode = mov		? 0x8a :
+				    accumulator ? opcode & 0x39 :
+						  0x84 | (opcode & 1);
+	const unsigned prefix = lead ? 1 + ((rex >> 3) & 1) : 0;
+	const unsigned number = mov ? ((rex & 1) << 3) | (opcode & 7) : 0;
+	const struct X86SimpleRegister *reg = &regs[byte ? lead : 2][number];
+	writeUnsignedRegisterImmediate(insn,
+				       &rows[plans[prefix][reg_opcode] >> 2],
+				       reg, code, rex, 0, lead + 1,
+				       byte ? 1 : 4, insn_size);
+	return true;
+}
+
 #endif
