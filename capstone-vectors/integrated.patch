+				    !same(8, 15, 0, 10, " + 0xa") ||
+				    !same(0, 1, 0, INT32_MIN,
+					  " - 0x80000000") ||
+				    !same(9, 0, 0, INT32_MAX, " + 0x7fffffff"))
+					continue;
