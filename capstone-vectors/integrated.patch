+				for (unsigned dst = 0; dst < 16 && uniform;
+				     ++dst)
+					for (unsigned src = 0;
+					     src < 16 && uniform; ++src)
+						for (unsigned xb = 0;
+						     xb < 4 && uniform; ++xb)
