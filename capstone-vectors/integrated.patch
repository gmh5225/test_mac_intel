diff --git a/arch/X86/X86Vex32Scan.c b/arch/X86/X86Vex32Scan.c
new file mode 100644
index 00000000..90ddcdb3
--- /dev/null
+++ b/arch/X86/X86Vex32Scan.c
@@ -0,0 +1,130 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "X86ScanAdapter.h"
+#include "../../cs_priv.h"
+
+#if !defined(CAPSTONE_X86_REDUCE) && !defined(CAPSTONE_X86_SCAN_ADAPTER)
+#include "../../cs_disasm_internal.h"
+#define X86_DEFINE_VEX2_PUBLIC_PLANS
+#include "X86GenVexPublicPlans.inc"
+
+/* Every admitted plan has the same public ID, reserved-vvvv rule and
+ * immediate extent as all of its canonical ModR/M outcomes. */
+static uint32_t readVex32Plan(const uint8_t *code, size_t size)
+{
+	if (size < 3)
+		return 0;
+	const unsigned payload = code[1];
+	unsigned plan = x86Vex2PublicPlans[payload & 3][code[2]];
+	if (plan & (X86_VEX2_PUBLIC_LENGTH | X86_VEX2_PUBLIC_GROUP)) {
+#if X86_HAS_VEX2_LENGTH_PLANS
+		if (plan & X86_VEX2_PUBLIC_LENGTH)
+			plan = x86Vex2LengthPlans[plan &
+						  (X86_VEX2_PUBLIC_LENGTH - 1)]
+						 [(payload >> 2) & 1];
+#endif
+#if X86_HAS_VEX2_PUBLIC_GROUPS
+		if (plan & X86_VEX2_PUBLIC_GROUP) {
+			if (size < 4)
+				return 0;
+			const unsigned modrm = code[3];
+			plan = x86Vex2PublicGroups[plan &
+						   (X86_VEX2_PUBLIC_GROUP - 1)]
+						  [((modrm >> 3) & 7) +
+						   (modrm >= 0xc0 ? 8 : 0)];
+		}
+#endif
+	}
+	if (!plan)
+		return 0;
+	if ((plan & 2) && (payload & 0x78) != 0x78)
+		return 0;
+	unsigned end = 3;
+	if (plan & 4) {
+		if (size < 4)
+			return 0;
+		const unsigned modrm = code[3];
+		end = 4;
+		if (modrm < 0xc0) {
+			const unsigned mod = modrm >> 6, rm = modrm & 7;
+			static const uint8_t extra[3][8] = {
+				{ 0, 0, 0, 0, 1, 4, 0, 0 },
+				{ 1, 1, 1, 1, 2, 1, 1, 1 },
+				{ 4, 4, 4, 4, 5, 4, 4, 4 }
+			};
+			if ((modrm & 0xc7) == 4) {
+				if (end >= size)
+					return 0;
+				if ((code[end] & 7) == 5)
+					end += 4;
+			}
+			end += extra[mod][rm];
+		}
+	}
+	end += plan & 1;
+	if (end > size)
+		return 0;
+	return ((plan >> 3) << 8) | end;
+}
+
+static X86ScanBatchResult scanVectorBatch32(csh ud, const uint8_t *code,
+					    size_t size, uint64_t address,
+					    uint32_t *output, size_t capacity)
+{
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	X86ScanBatchResult batch = { 0, 0 };
+	cs_insn insn = { 0 };
+	handle->errnum = CS_ERR_OK;
+	while (batch.count < capacity && size) {
+		uint32_t packed = 0;
+		if (code[0] == 0xc5 && size >= 3 && (code[1] & 0xc0) == 0xc0 &&
+		    handle->mode == CS_MODE_32)
+			packed = readVex32Plan(code, size);
+		insn.address = address;
+		if (packed) {
+			insn.id = packed >> 8;
+			insn.size = (uint16_t)(packed & 0xff);
+		} else {
+			X86ScanResult result;
+			if (!X86_getInstructionScanResult(ud, code, size, &insn,
+							  &result))
+				break;
+			finish_x86_scan(handle, &insn, &result, code, false,
+					false);
+			packed = (insn.id << 8) | result.length;
+		}
+		output[batch.count++] = packed;
+		batch.bytes += insn.size;
+		code += insn.size;
+		size -= insn.size;
+		address += insn.size;
+	}
+	return batch;
+}
+#endif
+
+CAPSTONE_INTERNAL
+	X86ScanBatchResult X86_scanBatch32(csh ud, const uint8_t *code,
+					   size_t size, uint64_t address,
+					   uint32_t *output, size_t capacity)
+{
+#if !defined(CAPSTONE_X86_REDUCE) && !defined(CAPSTONE_X86_SCAN_ADAPTER)
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (handle && handle->mode == CS_MODE_32 && use_x86_scan(handle) &&
+	    !handle->skipdata && code && output && capacity && size >= 3 &&
+	    handle->insn_id == X86_get_insn_id &&
+	    handle->disasm == X86_getInstruction) {
+		/* Look at at most one byte per output slot to select a batch
+		 * reader. Only instruction boundaries may produce output. */
+		const size_t lookahead = size < capacity ? size : capacity;
+		const uint8_t *p = memchr(code, 0xc5, lookahead);
+		if (p && (size_t)(p - code) < size - 1 && (p[1] & 0xc0) == 0xc0)
+			return scanVectorBatch32(ud, code, size, address,
+						 output, capacity);
+	}
+#endif
+	return X86_scanBatch(ud, code, size, address, output, capacity);
+}
+#endif
