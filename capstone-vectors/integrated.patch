 #endif
 
+struct X86ShortDisplacement {
+	char text[7];
+	uint8_t length;
+};
+
+extern CAPSTONE_INTERNAL const struct X86ShortDisplacement
+	x86_short_displacements[256];
+
 static inline char *X86_writeDisp8(char *out, int displacement)
 {
-	if (displacement) {
-		const unsigned magnitude = displacement < 0 ? -displacement :
-							      displacement;
-		memcpy(out, displacement < 0 ? " - " : " + ", 3);
-		out += 3;
-		if (magnitude <= HEX_THRESHOLD) {
-			*out++ = (char)('0' + magnitude);
-		} else {
-			static const char digits[] = "0123456789abcdef";
-			memcpy(out, "0x", 2);
-			out += 2;
-			if (magnitude >= 16)
-				*out++ = digits[magnitude >> 4];
-			*out++ = digits[magnitude & 15];
-		}
-	}
-	return out;
+	if (!displacement)
+		return out;
+	const struct X86ShortDisplacement *entry =
+		&x86_short_displacements[(uint8_t)displacement];
+	/* Nonzero spellings occupy four to seven bytes. Overlapping copies
+	 * write exactly the token, including when the destination is reused. */
+	const unsigned tail = entry->length - 4;
+	memcpy(out, entry->text, 4);
+	memcpy(out + tail, entry->text + tail, 4);
+	return out + entry->length;
 }
 
