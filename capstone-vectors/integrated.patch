@@ -0,0 +1,45 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+/* Only the fixed-width text iterators include this fallback. The primary
+ * output writer has already declined the instruction. */
+#define X86_MEMORY_IMMEDIATE writeCompareMemory
+#define X86_COMPARE_IMMEDIATE
+#include "X86MemoryOutputImpl.h"
+#undef X86_COMPARE_IMMEDIATE
+#undef X86_MEMORY_IMMEDIATE
+
+/* Preserve the hot iterator's call boundary and keep this writer off its
+ * normal instruction path. */
+#if defined(__ELF__) && defined(__clang__)
+__attribute__((noinline, section(".cs_x86_compare_fallback")))
+#elif defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static CS_PRESERVE_MOST bool
+decodeAfterOutputMiss(cs_struct *handle, const uint8_t *code, size_t size,
+		      cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+	const unsigned lead = X86_IMMEDIATE_WIDE && size &&
+			      (code[0] & 0xf0) == 0x40;
+	if (size >= lead + 2) {
+		const uint8_t opcode = code[lead], mr = code[lead + 1];
+		if ((opcode == 0x80 || opcode == 0x81 || opcode == 0x83) &&
+		    mr < 0xc0 && (mr & 0x38) == 0x38 &&
+		    !X86_OUTPUT_UNSUPPORTED(handle, false)) {
+			/* Register CMP supplies flags, widths and memory access. */
+			const unsigned prefix =
+				lead ? (1 + ((code[0] >> 3) & 1)) : 0;
+			const unsigned plan =
+				x86_simple_plans[X86_IMMEDIATE_WIDE][prefix]
+						[0x38 | (opcode & 1)];
+			if (writeCompareMemory(code, size, insn, insn_size,
+					       &x86_simple_outputs[plan >> 2],
+					       x86_simple_registers))
+				return true;
+		}
+	}
+	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
+}
