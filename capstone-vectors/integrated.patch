+/* VEX.NDS has its destination in reg and its second register in vvvv. */
+static bool writeVexMemory(const uint8_t *code, size_t size, cs_insn *insn,
+			   uint16_t *insn_size)
+{
+	const unsigned map = code[1] & 31, mr = code[4], mod = mr >> 6,
+		       rm = mr & 7;
+	if (map < 1 || map > 3 || mod == 3 || rm == 4)
+		return false;
+	const unsigned prefix = vex_memory_plans[map - 1][code[3]];
+	const unsigned key = ((code[2] >> 4) & 8) | (code[2] & 7);
+	const unsigned index = vex_memory_prefixes[prefix][key];
+	if (!index)
+		return false;
+	const bool rip = !mod && rm == 5;
+	const unsigned disp_size = mod == 2 || rip ? 4 : mod;
+	const unsigned len = 5 + disp_size;
+	if (len > size)
+		return false;
+	const struct VexMemoryRow *row = &vex_memory_rows[index - 1];
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & 7;
+	const unsigned ll = (key >> 2) & 1,
+		       dst = ((rxb & 4) << 1) | ((mr >> 3) & 7);
+	const unsigned src = (~(unsigned)code[2] >> 3) & 15;
+	const int32_t disp = disp_size == 4 ? X86_readDisp32(code + 5) :
+			     disp_size == 1 ? (int8_t)code[5] :
+					      0;
+	const struct X86SimpleRegister *base =
+		&x86_simple_registers[3][rm | ((rxb & 1) << 3)];
+	insn->id = row->output.id;
+	*insn_size = insn->size = (uint16_t)len;
+	memcpy(insn->bytes, code, len);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->output.mnemonic,
+	       sizeof(row->output.mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = writeVectorRegister(insn->op_str, ll, dst);
+	memcpy(out, ", ", 2);
+	out = writeVectorRegister(out + 2, ll, src);
+	if (row->mem_size <= 8) {
+		memcpy(out, ", dword ptr [", 13);
+		if (row->mem_size == 8)
+			out[2] = 'q';
+		out += 13;
+	} else {
+		memcpy(out, ", xmmword ptr [", 15);
+		if (row->mem_size == 32)
+			out[2] = 'y';
+		out += 15;
+	}
+	if (rip) {
+		memcpy(out, "rip", 3);
+		out += 3;
+	} else {
+		memcpy(out, base->name, sizeof(base->name));
+		out += base->length;
+	}
+	*X86_writeDisplacement(out, disp) = ']';
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		memcpy(d->groups, row->output.groups,
+		       sizeof(row->output.groups));
+		d->groups_count = row->output.group_count;
+		cs_x86 *x = &d->x86;
+		memcpy(x->opcode, code, 3);
+		x->rex = (uint8_t)(0x40 | (key & 8) | rxb);
+		x->addr_size = 8;
+		x->modrm = (uint8_t)mr;
+		x->encoding.modrm_offset = 4;
+		x->disp = disp;
+		if (disp_size) {
+			x->encoding.disp_offset = 5;
+			x->encoding.disp_size = (uint8_t)disp_size;
+		}
+		x->op_count = 3;
+		const x86_reg first = ll ? X86_REG_YMM0 : X86_REG_XMM0;
+		for (unsigned i = 0; i < 2; ++i) {
+			cs_x86_op *op = &x->operands[i];
+			op->type = X86_OP_REG;
+			op->reg = (x86_reg)(first + (i ? src : dst));
+			op->size = (uint8_t)(16u << ll);
+			op->access = (cs_ac_type)row->output.access[i];
+		}
+		cs_x86_op *op = &x->operands[2];
+		op->type = X86_OP_MEM;
+		op->size = row->mem_size;
+		op->access = (cs_ac_type)row->output.access[2];
+		op->mem.base = rip ? X86_REG_RIP : (x86_reg)base->reg;
+		op->mem.scale = 1;
+		op->mem.disp = disp;
+	}
+	return true;
+}
