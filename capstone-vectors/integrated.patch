+/* The caller has consumed a bare 0F 40..4F, optionally preceded by a REX. */
+static inline bool writeConditionalMove(const uint8_t *code, unsigned length,
+					cs_insn *insn, uint16_t *insn_size,
+					uint8_t rex, uint8_t opcode, uint8_t mr)
+{
+	if (mr < 0xc0)
+		return false;
+	const unsigned wide = (rex >> 3) & 1;
+	const struct X86SimpleRegister *regs = x86_simple_registers[2 + wide];
+	const struct X86SimpleRegister *dst =
+		&regs[((rex & 4) << 1) | ((mr >> 3) & 7)];
+	const struct X86SimpleRegister *src =
+		&regs[((rex & 1) << 3) | (mr & 7)];
+	const struct X86CmovCondition *cc = &x86_cmov_conditions[opcode & 15];
+	*insn_size = insn->size = length;
+	insn->id = cc->id;
+	memcpy(insn->bytes, code, length);
+	writeGprRegisterNames(insn, cc->mnemonic, dst, src);
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, &x86_cmov_operands, 0x0f,
+				      rex, mr, dst->reg, src->reg);
+		cs_x86 *x = &insn->detail->x86;
+		x->opcode[1] = opcode;
+		x->encoding.modrm_offset = (uint8_t)(length - 1);
+		x->eflags = cc->flags;
+		x->operands[0].size = x->operands[1].size =
+			(uint8_t)(4u << wide);
+	}
+	return true;
+}
 
