+/* Keep the AMD64-only fallback separate from the shared 32/64-bit readers. */
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_vex_rip_text" rodata = ".cs_x86_vex_rip_rodata"
+#endif
+#include "X86GenVexRipMemory.inc"
+#include "X86VectorRipMemory.h"
+
+/* The AMD64 reader checked the VEX prefix, RIP-relative ModR/M, disp32
+ * extent and output options before asking for its packed operand record. */
+bool X86_writeVexRipMemory(const uint8_t *code, unsigned prefix, cs_insn *insn,
+			   uint16_t *insn_size)
+{
+	const bool short_prefix = prefix == 2;
+	const unsigned flags = code[prefix - 1];
+	const unsigned map = short_prefix ? 1 : code[1] & 31;
+	if (map < 1 || map > 3 || (flags & 3) != 1)
+		return false;
+	const unsigned w = short_prefix ? 0 : flags >> 7;
+	const unsigned ll = (flags >> 2) & 1, wl = w * 2 + ll,
+		       opcode = code[prefix];
+	const unsigned plan = vex_register_plans[map - 1][opcode];
+	const unsigned index = vex_register_widths[plan][wl];
+	if (!(vex_rip_register_rows[index >> 3] & (1u << (index & 7))))
+		return false;
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & (short_prefix ? 4 : 7);
+	const unsigned dst = ((code[prefix + 1] >> 3) & 7) | ((rxb & 4) << 1);
+	return writeVectorRipMemory(code, insn, insn_size,
+				    &vex_register_rows[index], prefix, ll,
+				    0x40 | (w << 3) | rxb, dst,
+				    (~flags >> 3) & 15);
+}
+
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = "" rodata = ""
+#endif
+
 #endif
 #endif
diff --git a/arch/X86/X86VectorRipMemory.h b/arch/X86/X86VectorRipMemory.h
new file mode 100644
index 00000000..a13ec4a1
--- /dev/null
+++ b/arch/X86/X86VectorRipMemory.h
@@ -0,0 +1,63 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef CS_X86_VECTOR_RIP_MEMORY_H
+#define CS_X86_VECTOR_RIP_MEMORY_H
+#include "X86SimpleOutput.h"
+#include "X86VectorRegisterWriter.h"
+
+/* Two vector registers followed by a full-width RIP-relative memory source.
+ * The encoding reader has checked the full extent and the semantic row. */
+static bool writeVectorRipMemory(const uint8_t *code, cs_insn *insn,
+				 uint16_t *insn_size,
+				 const struct VectorOutputRow *row,
+				 unsigned prefix, unsigned ll, unsigned rex,
+				 unsigned dst, unsigned src)
+{
+	const int32_t displacement = X86_readDisp32(code + prefix + 2);
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)(prefix + 6);
+	memcpy(insn->bytes, code, prefix + 6);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = writeVectorRegister(insn->op_str, ll, dst);
+	memcpy(out, ", ", 2);
+	out = writeVectorRegister(out + 2, ll, src);
+	memcpy(out, ", xmmword ptr [rip", 18);
+	out[2] = "xyz"[ll];
+	*X86_writeDisplacement(out + 18, displacement) = ']';
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		d->groups_count = row->group_count;
+		memcpy(d->groups, row->groups, sizeof(row->groups));
+		cs_x86 *x = &d->x86;
+		memcpy(x->opcode, code, prefix);
+		x->rex = (uint8_t)rex;
+		x->addr_size = 8;
+		x->modrm = code[prefix + 1];
+		x->encoding.modrm_offset = (uint8_t)(prefix + 1);
+		x->encoding.disp_offset = (uint8_t)(prefix + 2);
+		x->encoding.disp_size = 4;
+		x->disp = displacement;
+		x->op_count = 3;
+		static const x86_reg bases[] = { X86_REG_XMM0, X86_REG_YMM0,
+						 X86_REG_ZMM0 };
+		for (unsigned i = 0; i < 2; ++i) {
+			cs_x86_op *op = &x->operands[i];
+			op->type = X86_OP_REG;
+			op->reg = (x86_reg)(bases[ll] + (i ? src : dst));
+			op->size = (uint8_t)(16 << ll);
+			op->access = (cs_ac_type)row->access[i];
+		}
+		cs_x86_op *mem = &x->operands[2];
+		mem->type = X86_OP_MEM;
+		mem->mem.base = X86_REG_RIP;
+		mem->mem.scale = 1;
+		mem->mem.disp = displacement;
+		mem->size = (uint8_t)(16 << ll);
+		mem->access = (cs_ac_type)row->access[2];
+	}
+	return true;
+}
+#endif
