+// VEX.NDS with two explicit vector registers and one ordinary memory operand.
+// Keep an encoding only when the complete canonical text and detail fit this layout.
+std::string vex_memory_row(Decoder &decoder, unsigned map, unsigned opcode,
+			   unsigned key, unsigned dst, unsigned src,
+			   unsigned sample)
+{
+	static const x86_reg gprs[] = { X86_REG_RAX, X86_REG_RCX, X86_REG_RDX,
+					X86_REG_RBX, X86_REG_RSP, X86_REG_RBP,
+					X86_REG_RSI, X86_REG_RDI, X86_REG_R8,
+					X86_REG_R9,  X86_REG_R10, X86_REG_R11,
+					X86_REG_R12, X86_REG_R13, X86_REG_R14,
+					X86_REG_R15 };
+	static const unsigned bases[] = { 0, 1, 2, 3, 5, 6, 7 };
+	static const int32_t disps[] = { 0, 9, -10, -128, 0x123456, INT32_MIN };
+	const unsigned mod = sample % 3, rm = bases[(sample / 3) % 7];
+	const bool rip = mod == 0 && rm == 5;
+	const unsigned disp_size = mod == 2 || rip ? 4 : mod;
+	const int32_t disp =
+		disp_size ? disps[(sample / 7) % (disp_size == 4 ? 6 : 4)] : 0;
+	const unsigned ll = (key >> 2) & 1, w = key >> 3,
+		       rxb = ((dst & 8) >> 1) | ((sample / 5) & 3);
+	const unsigned length = 5 + disp_size;
+	uint8_t bytes[9] = { 0xc4, uint8_t(((rxb ^ 7) << 5) | map),
+			     uint8_t((w << 7) | ((~src & 15) << 3) | (key & 7)),
+			     uint8_t(opcode),
+			     uint8_t((mod << 6) | ((dst & 7) << 3) | rm) };
+	for (unsigned i = 0; i < disp_size; ++i)
+		bytes[5 + i] = uint8_t(uint32_t(disp) >> (8 * i));
+	unsigned id = decoder.decode(bytes, length);
+	if (!id)
+		return {};
+	const auto &insn = *decoder.insn;
+	const auto &d = *insn.detail;
+	const auto &x = d.x86;
+	if (insn.is_alias || insn.usesAliasDetails || insn.illegal ||
+	    d.regs_read_count || d.regs_write_count || d.groups_count > 4 ||
+	    x.op_count != 3 || std::strlen(insn.mnemonic) >= 16 ||
+	    std::strcmp(cs_insn_name(decoder.handle, id), insn.mnemonic))
+		return {};
+	const unsigned mem_size = x.operands[2].size;
+	const char *qualifier = mem_size == 4  ? "dword" :
+				mem_size == 8  ? "qword" :
+				mem_size == 16 ? "xmmword" :
+				mem_size == 32 ? "ymmword" :
+						 nullptr;
+	if (!qualifier)
+		return {};
+	const auto first = ll ? X86_REG_YMM0 : X86_REG_XMM0;
+	const auto base = rip ? X86_REG_RIP : gprs[rm | ((rxb & 1) << 3)];
+	cs_x86 expected{};
+	std::memcpy(expected.opcode, bytes, 3);
+	expected.rex = uint8_t(0x40 | (w << 3) | rxb);
+	expected.addr_size = 8;
+	expected.modrm = bytes[4];
+	expected.encoding.modrm_offset = 4;
+	expected.disp = disp;
+	if (disp_size) {
+		expected.encoding.disp_offset = 5;
+		expected.encoding.disp_size = uint8_t(disp_size);
+	}
+	expected.op_count = 3;
+	Bytes4 access{}, groups{};
+	std::copy_n(d.groups, d.groups_count, groups.begin());
+	for (unsigned i = 0; i != 3; ++i) {
+		auto &op = expected.operands[i];
+		op.access = x.operands[i].access;
+		access[i] = unsigned(op.access);
+		if (i == 2) {
+			op.type = X86_OP_MEM;
+			op.size = uint8_t(mem_size);
+			op.mem.base = base;
+			op.mem.scale = 1;
+			op.mem.disp = disp;
+		} else {
+			op.type = X86_OP_REG;
+			op.size = uint8_t(16 << ll);
+			op.reg = x86_reg(first + (i ? src : dst));
+		}
+	}
+	std::string vec = ll ? "ymm" : "xmm";
+	std::string text = vec + std::to_string(dst) + ", " + vec +
+			   std::to_string(src) + ", " + qualifier + " ptr [" +
+			   cs_reg_name(decoder.handle, base);
+	if (disp) {
+		const uint32_t mag = disp < 0 ? 0u - uint32_t(disp) :
+						uint32_t(disp);
+		char digits[16];
+		std::snprintf(digits, sizeof(digits), mag <= 9 ? "%u" : "0x%x",
+			      mag);
+		text += disp < 0 ? " - " : " + ";
+		text += digits;
+	}
+	if (text + "]" != insn.op_str || std::memcmp(&expected, &x, sizeof(x)))
+		return {};
+	return "{ { " + decoder.symbol(id) + ", \"" + insn.mnemonic + "\", " +
+	       std::to_string(d.groups_count) + ", " + fields(groups) + ", " +
+	       fields(access) + ", 0 }, " + std::to_string(mem_size) + " }";
+}
+
+void emit_vex_memory(Decoder &decoder)
+{
+	using Prefix = std::array<unsigned, 16>;
+	std::vector<std::string> rows;
+	std::vector<Prefix> prefixes(1);
+	unsigned plans[3][256]{};
+	for (unsigned map = 1; map <= 3; ++map)
+		for (unsigned opcode = 0; opcode < 256; ++opcode) {
+			Prefix slots{};
+			for (unsigned key = 0; key < 16; ++key) {
+				auto row = vex_memory_row(decoder, map, opcode,
+							  key, 3, 2, 11);
+				if (row.empty())
+					continue;
+				bool valid = true;
+				for (unsigned i = 0; i < 256 && valid; ++i)
+					valid = vex_memory_row(decoder, map,
+							       opcode, key,
+							       i & 15, i >> 4,
+							       i) == row;
+				if (!valid)
+					continue;
+				auto it = std::find(rows.begin(), rows.end(),
+						    row);
+				slots[key] = unsigned(it - rows.begin()) + 1;
+				if (it == rows.end())
+					rows.push_back(row);
+			}
+			auto it = std::find(prefixes.begin(), prefixes.end(),
+					    slots);
+			plans[map - 1][opcode] =
+				unsigned(it - prefixes.begin());
+			if (it == prefixes.end())
+				prefixes.push_back(slots);
+		}
+	if (rows.size() >= UINT16_MAX || prefixes.size() > 256 ||
+	    !plans[1][0xa8])
+		throw std::runtime_error("invalid VEX memory plans");
+	std::puts(
+		"struct VexMemoryRow { struct VectorOutputRow output; uint8_t mem_size; };\nstatic const struct VexMemoryRow vex_memory_rows[] = {");
+	for (const auto &row : rows)
+		std::printf("\t%s,\n", row.c_str());
+	std::puts("};\nstatic const uint16_t vex_memory_prefixes[][16] = {");
+	for (const auto &prefix : prefixes) {
+		std::printf("\t{");
+		for (unsigned cell : prefix)
+			std::printf(" %u,", cell);
+		std::puts(" },");
+	}
+	std::puts("};\nstatic const uint8_t vex_memory_plans[3][256] = {");
+	for (const auto &map : plans) {
+		std::puts("\t{");
+		for (unsigned i = 0; i < 256; i += 16) {
+			std::printf("\t\t");
+			for (unsigned j = 0; j < 16; ++j)
+				std::printf("%s%u,", j ? " " : "", map[i + j]);
+			std::putchar('\n');
+		}
+		std::puts("\t},");
+	}
+	std::puts("};");
+	std::fprintf(
+		stderr,
+		"%zu canonical three-operand VEX memory rows, %zu prefix plans\n",
+		rows.size(), prefixes.size());
+}
