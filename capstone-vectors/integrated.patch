+static bool check_conditional_moves(csh handles[2], cs_mode mode)
+{
+	for (unsigned p = 0; p <= (mode == CS_MODE_64 ? 16u : 0u); ++p) {
+		const unsigned offset = !p;
+		for (unsigned cc = 0; cc < 16; ++cc) {
+			for (unsigned mr = 0; mr < 256; ++mr) {
+				const uint8_t code[] = { (uint8_t)(0x3f + p),
+							 0x0f,
+							 (uint8_t)(0x40 + cc),
+							 (uint8_t)mr,
+							 0x24,
+							 1,
+							 2,
+							 3,
+							 4 };
+				if (!compare(handles, code + offset,
+					     sizeof(code) - offset, mr) ||
+				    !compare(handles, code + offset, mr % 5,
+					     cc))
+					return false;
+			}
+		}
+	}
+	return true;
