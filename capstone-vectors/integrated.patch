+void emit_cmov(Decoder &decoder, const RegisterTable &regs, bool long_mode)
+{
+	std::cout << "/* Generated by x86_simple_output.cpp --cmov"
+		  << (long_mode ? "64" : "32") << ". */\n"
+		  << "static const struct X86SimpleOutput x86_cmov[][16] = {\n";
+	for (unsigned wide = 0; wide <= unsigned(long_mode); ++wide) {
+		std::cout << "\t{\n";
+		for (uint8_t opcode = 0x40; opcode <= 0x4f; ++opcode) {
+			CheckedRow row;
+			for (unsigned prefix = 0;
