-#ifdef X86_SEGMENT_LEA32
-		/* A scale-one SIB without an index names only its base. */
-		if ((!mod && base_reg == 5) ||
-		    (index_reg == 4 && (encoding >> 6) != 0))
+		if (!mod && base_reg == 5)
+			return false;
+#ifdef X86_MEMORY32_OUTPUT
+		/* Intel syntax omits EIZ. Both public scale fields still
+		 * describe the encoded SIB when there is no index register. */
+		scale_bits = encoding >> 6;
+		if (index_reg != 4)
+			index = &regs[2][index_reg];
 #else
-		if ((!mod && base_reg == 5) ||
-		    (index_reg == 4 && encoding != 0x24))
-#endif
+		if (index_reg == 4 && encoding != 0x24)
 			return false;
 		if (index_reg != 4) {
 			index = &regs[wide ? 3 : 2][index_reg];
 			scale_bits = encoding >> 6;
 		}
+#endif
 	}
 
