+/* The bare NOP and INT3 have complete, constant records. The generated
+ * row supplies the text and implicit effects used by the general writer. */
+static inline bool writeFixedEmpty32(cs_insn *insn, uint16_t *insn_size,
+				     uint8_t opcode)
+{
+	const struct X86SimpleOutput *row =
+		&x86_simple_outputs[x86_simple_plans[0][0][opcode] >> 2];
+	*insn_size = insn->size = 1;
+	insn->id = row->id;
+	insn->bytes[0] = opcode;
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, row->operands, sizeof(row->operands));
+	if (insn->detail)
+		X86_writeSimpleDetail(insn->detail, row, opcode, 0, 0,
+				      row->ops[0].reg, row->ops[1].reg);
+	return true;
+}
+
+#define X86_FIXED_EMPTY32 writeFixedEmpty32
 #define X86_FIXED_OUTPUT tryOutput32
 #define X86_FIXED_WIDE false
 #define X86_OUTPUT_MISS writeExtraOutput32
