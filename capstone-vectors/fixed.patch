+CAPSTONE_INTERNAL CS_PRESERVE_MOST bool
+X86_decodeTextRecord64(cs_struct *handle, const uint8_t *code, size_t size,
+		       cs_insn *insn, uint16_t *length)
+{
+	return decode_insn(handle, code, size, insn, length, false, false);
+}
+#endif
 #endif
