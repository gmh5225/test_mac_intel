diff --git a/suite/synctools/riscv_gpr_names.py b/suite/synctools/riscv_gpr_names.py
new file mode 100644
index 00000000..a730c4b2
--- /dev/null
+++ b/suite/synctools/riscv_gpr_names.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""Project short integer-register spellings from the RISC-V assembly writer."""
+
+import argparse
+import json
+from pathlib import Path
+import re
+
+
+def table(source, declaration):
+    match = re.search(r"\b" + declaration + r"\[\]\s*=\s*\{([^}]+)\};", source)
+    if not match:
+        raise ValueError("Missing generated register table " + declaration)
+    return match[1]
+
+
+def register_names(writer, registers, suffix):
+    pool = bytearray()
+    for position, name in re.findall(r'/\*\s*(\d+)\s*\*/\s*"([^"\\]*)\\0"', table(writer, "AsmStrs" + suffix)):
+        if int(position) != len(pool):
+            raise ValueError("Unexpected generated string offset")
+        pool.extend(name.encode("ascii") + b"\0")
+    offsets = [int(x.strip()) for x in table(writer, "RegAsmOffset" + suffix).split(",") if x.strip()]
+    result = []
+    for reg in registers:
+        start = offsets[reg - 1]
+        result.append(pool[start:pool.index(0, start)].decode("ascii"))
+    return result
+
+
+def render(writer, enums):
+    registers = dict((int(n), int(v)) for n, v in re.findall(r"\bRISCV_X(\d+)\s*=\s*(\d+),", enums))
+    ids = [registers[i] for i in range(32)]
+    if ids != list(range(ids[0], ids[0] + 32)):
+        raise ValueError("Integer register IDs must be contiguous")
+    numeric = register_names(writer, ids, "NoRegAltName")
+    abi = [s or numeric[i] for i, s in enumerate(register_names(writer, ids, "ABIRegAltName"))]
+    width = 1 + max(map(len, numeric + abi))
+    if width > 5 or not all(abi) or not all(numeric):
+        raise ValueError("Expected short nonempty integer register names")
+    lines = [
+        "/* Generated by suite/synctools/riscv_gpr_names.py. */",
+        "static const struct RISCVGPRName riscv_gpr_names[2][32] = {",
+    ]
+    for names in (abi, numeric):
+        lines.append("\t{")
+        lines.extend(f"\t\t{{ {json.dumps(name)}, {len(name)} }}," for name in names)
+        lines.append("\t},")
+    return "\n".join([*lines, "};", ""])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    directory = Path(__file__).resolve().parents[2] / "arch" / "RISCV"
+    generated = render((directory / "RISCVGenAsmWriter.inc").read_text(),
+                       (directory / "RISCVGenRegisterInfo.inc").read_text())
+    output = directory / "RISCVGenGPRNames.inc"
+    if args.check:
+        if output.read_text() != generated:
+            parser.exit(1, f"Regenerate {output.name}\n")
+    else:
+        output.write_text(generated)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/riscv_op_count_iter.c b/tests/unit/riscv_op_count_iter.c
index 79f2fe93..c8b0442b 100644
--- a/tests/unit/riscv_op_count_iter.c
+++ b/tests/unit/riscv_op_count_iter.c
@@ -87,10 +87,45 @@ static bool check_detail_syntax(cs_opt_value detail, cs_opt_value reference)
 	return ok;
 }
 
+static bool check_register_names(bool numeric)
+{
+	static const uint8_t code[] = {
+		0x13, 0x85, 0x15, 0x00, /* addi a0, a1, 1 */
+		0x72, 0xbe, /* cm.popret {ra, s0-s2}, 32 */
+	};
+	csh handle;
+	cs_insn *insn = NULL;
+	if (cs_open(CS_ARCH_RISCV, CS_MODE_RISCV64 | CS_MODE_RISCV_ZCMP_ZCMT_ZCE,
+		    &handle) != CS_ERR_OK)
+		return false;
+	cs_opt_value syntax = numeric ? CS_OPT_SYNTAX_NOREGNAME :
+					CS_OPT_SYNTAX_DEFAULT;
+	bool ok = cs_option(handle, CS_OPT_SYNTAX, syntax) == CS_ERR_OK;
+	size_t count = ok ? cs_disasm(handle, code, sizeof(code), 0, 0, &insn) : 0;
+	ok = count == 2 &&
+	     strcmp(cs_reg_name(handle, RISCV_REG_X10),
+		    numeric ? "x10" : "a0") == 0 &&
+	     strcmp(insn[0].op_str,
+		    numeric ? "x10, x11, 1" : "a0, a1, 1") == 0 &&
+	     strcmp(insn[1].op_str, numeric ? "{x1, x8-x9, x18}, 0x20" :
+					      "{ra, s0-s2}, 0x20") == 0;
+	if (!ok && count == 2)
+		fprintf(stderr, "numeric=%d: %s / %s / %s\n", numeric,
+			cs_reg_name(handle, RISCV_REG_X10), insn[0].op_str,
+			insn[1].op_str);
+	cs_free(insn, count);
+	cs_close(&handle);
+	return ok;
+}
+
 int main(void)
 {
 	bool ret = true;
 	ret &= test_riscv_op_count_no_stale();
+	if (!cs_support(CS_SUPPORT_DIET)) {
+		ret &= check_register_names(false);
+		ret &= check_register_names(true);
+	}
 	ret &= check_detail_syntax(CS_OPT_DETAIL_REAL, CS_OPT_SYNTAX_REAL);
 	ret &= check_detail_syntax(CS_OPT_DETAIL_UNCOMPRESSED_REAL,
 				   CS_OPT_SYNTAX_UNCOMPRESSED_REAL);
