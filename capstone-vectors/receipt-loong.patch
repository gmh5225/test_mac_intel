diff --git a/arch/LoongArch/LoongArchInstPrinter.c b/arch/LoongArch/LoongArchInstPrinter.c
index 50118554..8007c052 100644
--- a/arch/LoongArch/LoongArchInstPrinter.c
+++ b/arch/LoongArch/LoongArchInstPrinter.c
@@ -85,9 +85,24 @@ const char *LoongArch_LLVM_getRegisterName(unsigned RegNo, unsigned AltIdx)
 	return getRegisterName(RegNo, AltIdx);
 }
 
+#if defined(CAPSTONE_LOONGARCH_DEDICATED_MAPPING) && !defined(CAPSTONE_DIET)
+#include "LoongArchGenRegisterSpellings.inc"
+#endif
+
 static void printRegName(MCInst *MI, SStream *O, MCRegister Reg)
 {
 	int syntax_opt = MI->csh->syntax;
+#if defined(CAPSTONE_LOONGARCH_DEDICATED_MAPPING) && !defined(CAPSTONE_DIET)
+	/* Keep the two original appends for an open markup token. */
+	if (Reg && Reg <= ARR_SIZE(loongarch_register_spellings) &&
+	    !(O->markup_stream && O->prefixed_by_markup)) {
+		const unsigned skip = (syntax_opt & CS_OPT_SYNTAX_NO_DOLLAR) != 0;
+		const unsigned index = Reg - 1;
+		SStream_concat0_n(O, loongarch_register_spellings[index].text + skip,
+				 loongarch_register_spellings[index].length - skip);
+		return;
+	}
+#endif
 	if (!(syntax_opt & CS_OPT_SYNTAX_NO_DOLLAR)) {
 		SStream_concat1(O, '$');
 	}
diff --git a/suite/synctools/loongarch_register_spellings.c b/suite/synctools/loongarch_register_spellings.c
new file mode 100644
index 00000000..3831cfd0
--- /dev/null
+++ b/suite/synctools/loongarch_register_spellings.c
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/* Link with a full LoongArch static build. The original LLVM alias lookup
+ * resolves both suffix-shared strings and registers with no alternate name. */
+#include <ctype.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define GET_REGINFO_ENUM
+#include "../../arch/LoongArch/LoongArchGenRegisterInfo.inc"
+extern const char *LoongArch_LLVM_getRegisterName(unsigned reg, unsigned alt);
+
+int main(void)
+{
+	size_t longest = 0;
+	for (unsigned reg = 1; reg < NUM_TARGET_REGS; ++reg) {
+		const char *name = LoongArch_LLVM_getRegisterName(reg, LoongArch_RegAliasName);
+		if (!name || !*name)
+			return 1;
+		for (const char *p = name; *p; ++p)
+			if (!isalnum((unsigned char)*p) && *p != '_')
+				return 1;
+		const size_t length = strlen(name);
+		if (length >= UINT8_MAX)
+			return 1;
+		if (length > longest)
+			longest = length;
+	}
+	puts("/* Generated by suite/synctools/loongarch_register_spellings.c. */");
+	printf("static const struct {\n\tuint8_t length;\n\tchar text[%zu];\n} loongarch_register_spellings[] = {\n", longest + 2);
+	for (unsigned reg = 1; reg < NUM_TARGET_REGS; ++reg) {
+		const char *name = LoongArch_LLVM_getRegisterName(reg, LoongArch_RegAliasName);
+		printf("\t{ %zu, \"$%s\" },\n", strlen(name) + 1, name);
+	}
+	puts("};");
+	return 0;
+}
