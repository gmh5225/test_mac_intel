diff --git a/arch/X86/X86Mapping.c b/arch/X86/X86Mapping.c
index 461ae5e4..5a3a967d 100644
--- a/arch/X86/X86Mapping.c
+++ b/arch/X86/X86Mapping.c
@@ -11929,6 +11929,27 @@ void X86_reg_access(const cs_insn *insn, cs_regs regs_read,
 	read_count = insn->detail->regs_read_count;
 	write_count = insn->detail->regs_write_count;
 
+	// A write-only register destination starts a fresh write list.
+	// With no implicit registers, its single source starts a fresh read list.
+	if (read_count == 0 && write_count == 0 && x86->op_count == 2 &&
+	    x86->operands[0].type == X86_OP_REG &&
+	    x86->operands[0].access == CS_AC_WRITE) {
+		const cs_x86_op *source = &x86->operands[1];
+		const bool reg = source->type == X86_OP_REG &&
+				 source->access == CS_AC_READ;
+		const bool base = source->type == X86_OP_MEM &&
+				  source->mem.segment == X86_REG_INVALID &&
+				  source->mem.index == X86_REG_INVALID &&
+				  source->mem.base != X86_REG_INVALID;
+		if (reg || base) {
+			regs_write[0] = x86->operands[0].reg;
+			regs_read[0] = reg ? source->reg : source->mem.base;
+			*regs_read_count = 1;
+			*regs_write_count = 1;
+			return;
+		}
+	}
+
 	// implicit registers
 	if (read_count == 1)
 		regs_read[0] = insn->detail->regs_read[0];
