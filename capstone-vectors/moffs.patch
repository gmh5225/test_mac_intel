+/* A0..A3 encode the 32-bit address directly, without ModRM or SIB. */
+static bool writeAccumulatorMemory32(const uint8_t *code, size_t size,
+				     cs_insn *insn, uint16_t *insn_size)
+{
+	if (size < 5)
+		return false;
+	const uint8_t opcode = code[0];
+	const bool store = (opcode & 2) != 0;
+	const bool dword = (opcode & 1) != 0;
+	const uint32_t address = (uint32_t)X86_readDisp32(code + 1);
+	const struct X86SimpleRegister *acc =
+		&x86_simple_registers[dword ? 2 : 0][0];
+	/* The corresponding MOV register pair owns the access flags and widths. */
+	const unsigned mov = (store ? 0x88 : 0x8a) | (opcode & 1);
+	const struct X86SimpleOutput *row =
+		&x86_simple_outputs[x86_simple_plans[0][0][mov] >> 2];
+	insn->id = row->id;
+	insn->size = *insn_size = 5;
+	memcpy(insn->bytes, code, 5);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = insn->op_str;
+	if (!store) {
+		memcpy(out, acc->name, acc->length);
+		out += acc->length;
+		memcpy(out, ", ", 2);
+		out += 2;
+	}
+	if (dword) {
+		memcpy(out, "dword ptr [", 11);
+		out += 11;
+	} else {
+		memcpy(out, "byte ptr [", 10);
+		out += 10;
+	}
+	out = writeUnsignedImmediate(out, address);
+	*out++ = ']';
+	if (store) {
+		memcpy(out, ", ", 2);
+		memcpy(out + 2, acc->name, acc->length);
+	}
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, opcode, 0, 0,
+				      store ? 0 : acc->reg,
+				      store ? acc->reg : 0);
+		cs_x86 *x = &insn->detail->x86;
+		x->encoding.modrm_offset = 0;
+		x->encoding.disp_offset = 1;
+		x->encoding.disp_size = 4;
+		cs_x86_op *mem = &x->operands[!store];
+		mem->type = X86_OP_MEM;
+		mem->mem.scale = 1;
+		mem->mem.disp = x->disp = address;
+	}
+	return true;
+}
