+		x->op_count = (uint8_t)(reg_count + row->immediate);
+		static const x86_reg bases[] = { X86_REG_XMM0, X86_REG_YMM0,
+						 X86_REG_ZMM0 };
+		for (unsigned n = 0; n != reg_count; ++n) {
+			cs_x86_op *op = &x->operands[n];
+			op->type = X86_OP_REG;
