 #ifdef X86_MEMORY_IMMEDIATE
-#ifdef X86_COMPARE_IMMEDIATE
+#ifdef X86_ALU32_IMMEDIATE
 	const unsigned imm_size = opcode == 0x81 ? 4 : 1;
 #else
 	const unsigned imm_size = (opcode & 1) ? 4 : 1;
@@ -187,13 +187,17 @@ bool X86_writeMemoryOutput(
