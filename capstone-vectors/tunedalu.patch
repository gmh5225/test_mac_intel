 		value = (int8_t)encoded;
-	else if (imm_size == 4 && row->ops[0].size == 8)
-		value = (int32_t)encoded;
+		if (logical)
+			value = (uint32_t)value;
+	}
 	memcpy(out, ", ", 2);
 	out += 2;
 	if (value < 0)
diff --git a/tests/unit/x86_simple_output.c b/tests/unit/x86_simple_output.c
index 0c9329b4..7e3e8b69 100644
--- a/tests/unit/x86_simple_output.c
+++ b/tests/unit/x86_simple_output.c
@@ -1021,6 +1021,16 @@ static bool check_alu_immediates(csh handles[2], cs_mode mode)
 				    !compare(handles, b + !p,
 					     (mr + j) % (sizeof(b) - !p), v))
 					return false;
+				/* Exercise the memory forms with an imm8 and with
+				 * an imm8 sign-extended to the operand width. */
+				if (mode == CS_MODE_32 && mr < 0xc0) {
+					b[1] = 0x80;
+					if (!compare(handles, b + 1, sizeof(b) - 1, v))
+						return false;
+					b[1] = 0x83;
+					if (!compare(handles, b + 1, sizeof(b) - 1, v))
+						return false;
+				}
 			}
 		}
 	}
