 		imm_size == 1 ? code[imm_offset] :
 				(uint32_t)X86_readDisp32(code + imm_offset);
-#ifdef X86_COMPARE_IMMEDIATE
-	/* 83 /7 sign-extends imm8. REX.W 81 /7 sign-extends imm32. */
+#ifdef X86_ALU32_IMMEDIATE
+	/* Group 1 opcode 83 sign-extends its immediate. The Intel printer
+	 * spells logical masks as unsigned values of the destination width. */
 	int64_t value = encoded;
-	if (opcode == 0x83)
+	if (opcode == 0x83) {
+		const unsigned operation = (modrm >> 3) & 7;
