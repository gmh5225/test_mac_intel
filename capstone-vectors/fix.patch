+#ifndef CAPSTONE_DIET
+/* The mapping rows use ESI and EDI as canonical string indices. A source
+ * row reads ESI even when its segment override selects the destination segment. */
+static bool map_string_indices(uint16_t *regs, unsigned count, x86_reg si,
+			       x86_reg di)
+{
+	bool source = false;
+	for (unsigned i = 0; i < count; ++i) {
+		if (regs[i] == X86_REG_ESI) {
+			regs[i] = si;
+			source = true;
+		} else if (regs[i] == X86_REG_EDI) {
+			regs[i] = di;
+		}
+	}
+	return source;
+}
+
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static void map_string_registers(cs_detail *detail, cs_mode mode)
+{
+	unsigned width = detail->x86.addr_size;
+	x86_reg si = width == 2 ? X86_REG_SI :
+		     width == 4 ? X86_REG_ESI :
+				  X86_REG_RSI;
+	x86_reg di = width == 2 ? X86_REG_DI :
+		     width == 4 ? X86_REG_EDI :
+				  X86_REG_RDI;
+	bool source = map_string_indices(detail->regs_read,
+					 detail->regs_read_count, si, di);
+	if (width != 4)
+		map_string_indices(detail->regs_write, detail->regs_write_count,
+				   si, di);
+	if (source) {
+		uint8_t prefix = detail->x86.prefix[1];
+		x86_reg segment = prefix ? apx_segment_register(prefix) :
+					   X86_REG_DS;
+		if (mode != CS_MODE_64 || segment == X86_REG_FS ||
+		    segment == X86_REG_GS)
+			detail->regs_read[detail->regs_read_count++] = segment;
+	}
+}
+#endif
