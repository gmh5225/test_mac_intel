+/* Source and destination indices and the REP count use address size. */
+static bool check_string_registers(csh h, cs_mode mode)
+{
+	static const struct {
+		uint8_t opcode;
+		bool source;
+		bool destination;
+	} forms[] = { { 0x6c, false, true }, { 0x6e, true, false },
+		      { 0xa4, true, true },  { 0xa6, true, true },
+		      { 0xaa, false, true }, { 0xac, true, false },
+		      { 0xae, false, true }, { 0x6d, false, true },
+		      { 0xab, false, true } };
+	const uint8_t prefixes[] = { 0, 0x26, 0x2e, 0x36, 0x3e, 0x64, 0x65 };
+	const x86_reg segments[] = { X86_REG_DS, X86_REG_ES, X86_REG_CS,
+				     X86_REG_SS, X86_REG_DS, X86_REG_FS,
+				     X86_REG_GS };
+	for (unsigned addr = 0; addr < 2; ++addr) {
+		unsigned width = mode == CS_MODE_64 ? (addr ? 4 : 8) :
+				 mode == CS_MODE_32 ? (addr ? 2 : 4) :
+						      (addr ? 4 : 2);
+		x86_reg si = width == 2 ? X86_REG_SI :
+			     width == 4 ? X86_REG_ESI :
+					  X86_REG_RSI;
+		x86_reg di = width == 2 ? X86_REG_DI :
+			     width == 4 ? X86_REG_EDI :
+					  X86_REG_RDI;
+		x86_reg cx = width == 2 ? X86_REG_CX :
+			     width == 4 ? X86_REG_ECX :
+					  X86_REG_RCX;
+		for (unsigned p = 0; p < sizeof(prefixes); ++p) {
+			for (unsigned i = 0; i < sizeof(forms) / sizeof(*forms);
+			     ++i) {
+				uint8_t bytes[5];
+				unsigned len = 0;
+				if (addr)
+					bytes[len++] = 0x67;
+				if (prefixes[p])
+					bytes[len++] = prefixes[p];
+				bytes[len++] = 0xf3;
+				if (forms[i].opcode == 0xab &&
+				    mode == CS_MODE_64)
+					bytes[len++] = 0x48;
+				bytes[len++] = forms[i].opcode;
+				cs_insn *insn;
+				if (cs_disasm(h, bytes, len, 0, 1, &insn) != 1)
+					return false;
+				cs_regs reads, writes;
+				uint8_t nr = 0, nw = 0;
+				bool ok = cs_regs_access(h, insn, reads, &nr,
+							 writes,
+							 &nw) == CS_ERR_OK;
+				const x86_reg tracked[] = {
+					X86_REG_SI, X86_REG_ESI, X86_REG_RSI,
+					X86_REG_DI, X86_REG_EDI, X86_REG_RDI,
+					X86_REG_CX, X86_REG_ECX, X86_REG_RCX,
+					X86_REG_ES, X86_REG_CS,	 X86_REG_SS,
+					X86_REG_DS, X86_REG_FS,	 X86_REG_GS
+				};
+				for (unsigned j = 0;
+				     j < sizeof(tracked) / sizeof(*tracked);
+				     ++j) {
+					x86_reg reg = tracked[j];
+					bool index = (forms[i].source &&
+						      reg == si) ||
+						     (forms[i].destination &&
+						      reg == di) ||
+						     reg == cx;
+					bool segment = (forms[i].source &&
+							reg == segments[p] &&
+							(mode != CS_MODE_64 ||
+							 p >= 5)) ||
+						       (forms[i].destination &&
+							reg == X86_REG_ES &&
+							mode != CS_MODE_64);
+					unsigned r = 0, w = 0;
+					for (unsigned k = 0; k < nr; ++k)
+						r += reads[k] == reg;
+					for (unsigned k = 0; k < nw; ++k)
+						w += writes[k] == reg;
+					ok &= r == (unsigned)(index ||
+							      segment) &&
+					      w == (unsigned)index;
+				}
+				if (forms[i].destination) {
+					unsigned implicit_di = 0;
+					for (unsigned k = 0;
+					     k < insn->detail->regs_read_count;
+					     ++k)
+						implicit_di +=
+							insn->detail
+								->regs_read[k] ==
+							di;
+					ok &= implicit_di == 1;
+				}
+				cs_free(insn, 1);
+				if (!ok) {
+					fprintf(stderr,
+						"string registers mode=%u addr=%u segment=%x opcode=%x\n",
+						mode, addr, prefixes[p],
+						forms[i].opcode);
+					return false;
+				}
+			}
+		}
+	}
+	return true;
+}
