+/* An unprefixed EVEX packet has its ModR/M at byte five. Only immutable
+ * public IDs of ordinary vector register or base/index addresses are used. */
+static bool tryEvexTerminalScan(const uint8_t *code, size_t size,
+                                X86ScanResult *result)
+{
+	if (size < 6 || code[0] != 0x62 || !(code[2] & 4) ||
+	    (code[3] & 0x97) || (code[3] & 0x60) == 0x60)
+		return false;
+	unsigned key = ((code[1] & 15) << 10) | ((code[2] & 3) << 8) | code[4];
+	const struct X86EvexScanForm *form = evex_scan_form(key);
+	if (!form || (form->reserved_v && ((code[2] & 0x78) != 0x78 || !(code[3] & 8))))
+		return false;
+	bool reg = code[5] >= 0xc0;
+	unsigned id = form->ids[code[2] >> 7][code[3] >> 5][reg];
+	if (!id)
+		return false;
+	size_t length = 6;
+	if (!reg) {
+		InternalInstruction insn = { 0 };
+		initializeInstructionHeader(&insn, code, size, CS_MODE_64);
+		insn.readerCursor = 5;
+		insn.addressSize = 8;
+		if (readModRMScan(&insn))
+			return false;
+		length = insn.readerCursor;
+	}
+	length += form->immediate;
+	if (length > size)
+		return false;
+	result->opcode = 0;
+	result->opcode_pub = id;
+	result->length = (uint16_t)length;
+	result->popcode_adjust = 0;
+	return true;
+}
