 		return cs_disasm_iter_core(ud, code, size, address, insn);
 #endif
 	return X86_disasmIter(ud, code, size, address, insn);
 }
+
+CAPSTONE_INTERNAL bool X86_disasmOneText32(csh ud, const uint8_t *code,
+				     size_t size, uint64_t address, cs_insn *insn)
+{
+#ifdef CS_DECODE_TRY_OUTPUT
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (usesText32(handle))
+		return cs_disasm_iter_core(ud, &code, &size, &address, insn);
+#endif
+	return X86_disasmIter(ud, &code, &size, &address, insn);
+}
 #endif
diff --git a/tests/unit/x86_simple_output.c b/tests/unit/x86_simple_output.c
index 586b3c09..e2529234 100644
--- a/tests/unit/x86_simple_output.c
+++ b/tests/unit/x86_simple_output.c
@@ -1676,8 +1676,22 @@ done:
 	return ok;
 }
 
+static bool one_as_iter(csh h, const uint8_t **p, size_t *n, uint64_t *ip,
+			cs_insn *insn)
+{
+	if (!X86_disasmOneText(h, *p, *n, *ip, insn))
+		return false;
+	*p += insn->size;
+	*n -= insn->size;
+	*ip += insn->size;
+	return true;
+}
+
 int main(void)
 {
+	private_iter = one_as_iter;
+	if (!check_mode(CS_MODE_32) || !check_mode(CS_MODE_64))
+		return 1;
 	private_iter = X86_disasmIter32;
 	if (!check_mode(CS_MODE_32))
 		return 1;
