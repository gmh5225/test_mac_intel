+/* Long-mode alignment NOPs can repeat 66 and end their prefixes with CS.
+ * CS is recorded in the prefix group but does not name a memory segment. */
+static bool writeLongPadding64(const uint8_t *code, size_t size, cs_insn *insn,
+			       uint16_t *insn_size)
+{
+	static const uint8_t body[] = { 0x0f, 0x1f, 0x84, 0, 0, 0, 0, 0 };
+	unsigned lead = 1;
+	while (lead < 15 - sizeof(body) && code[lead] == 0x66)
+		++lead;
+	const bool cs = code[lead] == 0x2e;
+	lead += cs;
+	const unsigned length = lead + sizeof(body);
+	if (length > 15 || size < length ||
+	    memcmp(code + lead, body, sizeof(body)))
+		return false;
+	/* Row 7 already describes the one-prefix SIB NOP. */
+	const struct PaddingOutput *p = &padding_rows[1][7];
+	writePaddingRow(code, insn, insn_size, p, (uint16_t)length);
 	if (insn->detail) {
