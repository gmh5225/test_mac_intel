+	/* The extra CS prefix only names a segment in 32-bit mode. Check the
+	 * encoded offsets, the 15-byte limit, and every truncated suffix. */
+	for (unsigned prefixes = 1; prefixes <= 8; ++prefixes) {
+		for (unsigned cs = 0; cs <= 1; ++cs) {
+			uint8_t bytes[17] = { 0 };
+			memset(bytes, 0x66, prefixes);
+			if (cs)
+				bytes[prefixes] = 0x2e;
+			uint8_t *body = bytes + prefixes + cs;
+			body[0] = 0x0f;
+			body[1] = 0x1f;
+			body[2] = 0x84;
+			const unsigned length = prefixes + cs + 8;
+			for (unsigned n = 0; n <= length; ++n)
