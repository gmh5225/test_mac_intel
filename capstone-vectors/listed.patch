+#ifdef CAPSTONE_MIPS_SCAN_BY_OPTION
+/* These standard forms use every bit below the primary opcode for operands. */
+static inline unsigned standardScanOpcode(unsigned major, cs_mode mode)
+{
+	switch (major) {
+	case 4:
+		return Mips_BEQ;
+	case 5:
+		return Mips_BNE;
+	case 10:
+		return Mips_SLTi;
+	case 11:
+		return Mips_SLTiu;
+	case 32:
+		return Mips_LB;
+	case 33:
+		return Mips_LH;
+	case 36:
+		return Mips_LBu;
+	case 37:
+		return Mips_LHu;
+	case 40:
+		return Mips_SB;
+	case 41:
+		return Mips_SH;
+#define MIPS_SCAN_OP(n, id) case n: return id;
+#define MIPS_SCAN_OP64(n, id) case n: return mode == CS_MODE_MIPS64 ? id : 0;
+	MIPS_COMMON_SCAN_OPS(MIPS_SCAN_OP, MIPS_SCAN_OP64)
+#undef MIPS_SCAN_OP64
+#undef MIPS_SCAN_OP
+	}
+	return 0;
+}
+#endif
