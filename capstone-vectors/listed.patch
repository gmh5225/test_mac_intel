+#define MIPS_COMMON_SCAN_OPS(OP, OP64) \
+	OP(9, Mips_ADDiu) \
+	OP(12, Mips_ANDi) \
+	OP(13, Mips_ORi) \
+	OP(14, Mips_XORi) \
+	OP64(25, Mips_DADDiu) \
