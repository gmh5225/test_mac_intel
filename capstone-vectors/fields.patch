+static bool check_register_names(bool numeric)
+{
+	static const uint8_t code[] = {
+		0x13, 0x85, 0x15, 0x00, /* addi a0, a1, 1 */
+		0x72, 0xbe, /* cm.popret {ra, s0-s2}, 32 */
+	};
+	csh handle;
+	cs_insn *insn = NULL;
+	if (cs_open(CS_ARCH_RISCV, CS_MODE_RISCV64 | CS_MODE_RISCV_ZCMP_ZCMT_ZCE,
+		    &handle) != CS_ERR_OK)
+		return false;
+	cs_opt_value syntax = numeric ? CS_OPT_SYNTAX_NOREGNAME :
+					CS_OPT_SYNTAX_DEFAULT;
+	bool ok = cs_option(handle, CS_OPT_SYNTAX, syntax) == CS_ERR_OK;
+	size_t count = ok ? cs_disasm(handle, code, sizeof(code), 0, 0, &insn) : 0;
+	ok = count == 2 &&
+	     strcmp(cs_reg_name(handle, RISCV_REG_X10),
+		    numeric ? "x10" : "a0") == 0 &&
+	     strcmp(insn[0].op_str,
+		    numeric ? "x10, x11, 1" : "a0, a1, 1") == 0 &&
+	     strcmp(insn[1].op_str, numeric ? "{x1, x8-x9, x18}, 0x20" :
+					      "{ra, s0-s2}, 0x20") == 0;
+	if (!ok && count == 2)
+		fprintf(stderr, "numeric=%d: %s / %s / %s\n", numeric,
+			cs_reg_name(handle, RISCV_REG_X10), insn[0].op_str,
+			insn[1].op_str);
+	cs_free(insn, count);
+	cs_close(&handle);
+	return ok;
+}
