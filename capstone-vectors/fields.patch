diff --git a/suite/synctools/riscv_register_names.py b/suite/synctools/riscv_register_names.py
new file mode 100644
index 00000000..d062aca0
--- /dev/null
+++ b/suite/synctools/riscv_register_names.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Resolve missing RISC-V ABI names using the generated register offsets."""
+
+import argparse
+import ast
+from itertools import groupby
+from pathlib import Path
+import re
+
+WRITER = Path(__file__).resolve().parents[2] / "arch/RISCV/RISCVGenAsmWriter.inc"
+START = "  switch(AltIdx) {"
+END = "#else\n  return NULL;\n#endif // CAPSTONE_DIET"
+MARKER = "  /* Resolved by suite/synctools/riscv_register_names.py. */\n"
+
+
+def update(writer):
+    body = writer.index("getRegisterName(unsigned RegNo, unsigned AltIdx) {")
+    pool = re.search(r"AsmStrsABIRegAltName\[\] = \{(.*?)\};", writer[body:], re.S)
+    offsets = re.search(r"RegAsmOffsetABIRegAltName\[\] = \{([\d,\s]+)\};", writer[body:])
+    if not pool or not offsets:
+        raise ValueError("Missing RISC-V ABI name tables")
+    literals = re.sub(r"/\*.*?\*/", "", pool[1], flags=re.S)
+    pattern = r'"(?:[^"\\]|\\.)*"'
+    if not re.fullmatch(r"\s*(?:" + pattern + r"\s*)+", literals):
+        raise ValueError("Unrecognized register name pool")
+    names = b"".join(ast.literal_eval("b" + token) for token in re.findall(pattern, literals)) + b"\0"
+    indices = [int(token) for token in re.findall(r"\d+", offsets[1])]
+    if not indices or any(offset >= len(names) for offset in indices):
+        raise ValueError("Invalid register name offset")
+    first = writer.index(START, body)
+    last = writer.index(END, first)
+    original = writer[first:last]
+    if MARKER not in original and ("return getRegisterName(RegNo, RISCV_NoRegAltName);" not in original or
+                                   "return AsmStrsABIRegAltName+RegAsmOffsetABIRegAltName[RegNo-1];" not in original):
+        raise ValueError("Review new TableGen register-name selection")
+
+    registers = [reg for reg, offset in enumerate(indices, 1) if names[offset]]
+    ranges = []
+    for _, group in groupby(enumerate(registers), key=lambda item: item[1] - item[0]):
+        ids = [reg for _, reg in group]
+        ranges.append(f"(RegNo - {ids[0]}u <= {ids[-1] - ids[0]}u)")
+    predicate = " || ".join(ranges) or "false"
+    select = (
+        f"    if ({predicate})\n"
+        "      return AsmStrsABIRegAltName + RegAsmOffsetABIRegAltName[RegNo-1];\n"
+    )
+    resolved = (
+        START + "\n" + MARKER +
+        '  default: CS_ASSERT_RET_VAL(0 && "Invalid register alt name index!", NULL);\n'
+        "  case RISCV_ABIRegAltName: {\n" + select +
+        "    break;\n"
+        "  }\n"
+        "  case RISCV_NoRegAltName:\n"
+        "    break;\n"
+        "  }\n"
+        "  const char *name = AsmStrsNoRegAltName + RegAsmOffsetNoRegAltName[RegNo-1];\n"
+        '  CS_ASSERT_RET_VAL(*name && "Invalid alt name index for register!", NULL);\n'
+        "  return name;\n"
+    )
+    return writer[:first] + resolved + writer[last:]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    original = WRITER.read_text()
+    result = update(original)
+    if result != original:
+        if args.check:
+            raise SystemExit("Regenerate " + WRITER.name)
+        WRITER.write_text(result)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/riscv_op_count_iter.c b/tests/unit/riscv_op_count_iter.c
index 79f2fe93..c8b0442b 100644
--- a/tests/unit/riscv_op_count_iter.c
+++ b/tests/unit/riscv_op_count_iter.c
@@ -87,10 +87,45 @@ static bool check_detail_syntax(cs_opt_value detail, cs_opt_value reference)
 	return ok;
 }
 
+static bool check_register_names(bool numeric)
+{
+	static const uint8_t code[] = {
+		0x13, 0x85, 0x15, 0x00, /* addi a0, a1, 1 */
+		0x72, 0xbe, /* cm.popret {ra, s0-s2}, 32 */
+	};
+	csh handle;
+	cs_insn *insn = NULL;
+	if (cs_open(CS_ARCH_RISCV, CS_MODE_RISCV64 | CS_MODE_RISCV_ZCMP_ZCMT_ZCE,
+		    &handle) != CS_ERR_OK)
+		return false;
+	cs_opt_value syntax = numeric ? CS_OPT_SYNTAX_NOREGNAME :
+					CS_OPT_SYNTAX_DEFAULT;
+	bool ok = cs_option(handle, CS_OPT_SYNTAX, syntax) == CS_ERR_OK;
+	size_t count = ok ? cs_disasm(handle, code, sizeof(code), 0, 0, &insn) : 0;
+	ok = count == 2 &&
+	     strcmp(cs_reg_name(handle, RISCV_REG_X10),
+		    numeric ? "x10" : "a0") == 0 &&
+	     strcmp(insn[0].op_str,
+		    numeric ? "x10, x11, 1" : "a0, a1, 1") == 0 &&
+	     strcmp(insn[1].op_str, numeric ? "{x1, x8-x9, x18}, 0x20" :
+					      "{ra, s0-s2}, 0x20") == 0;
+	if (!ok && count == 2)
+		fprintf(stderr, "numeric=%d: %s / %s / %s\n", numeric,
+			cs_reg_name(handle, RISCV_REG_X10), insn[0].op_str,
+			insn[1].op_str);
+	cs_free(insn, count);
+	cs_close(&handle);
+	return ok;
+}
+
 int main(void)
 {
 	bool ret = true;
 	ret &= test_riscv_op_count_no_stale();
+	if (!cs_support(CS_SUPPORT_DIET)) {
+		ret &= check_register_names(false);
+		ret &= check_register_names(true);
+	}
 	ret &= check_detail_syntax(CS_OPT_DETAIL_REAL, CS_OPT_SYNTAX_REAL);
 	ret &= check_detail_syntax(CS_OPT_DETAIL_UNCOMPRESSED_REAL,
 				   CS_OPT_SYNTAX_UNCOMPRESSED_REAL);
