diff --git a/suite/synctools/riscv_register_names.py b/suite/synctools/riscv_register_names.py
new file mode 100644
index 00000000..37c01b70
--- /dev/null
+++ b/suite/synctools/riscv_register_names.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Resolve RISC-V ABI fallbacks when synchronizing the TableGen assembly writer."""
+import argparse
+import ast
+from pathlib import Path
+import re
+
+WRITER = Path(__file__).resolve().parents[2] / "arch/RISCV/RISCVGenAsmWriter.inc"
+ROWS = WRITER.with_name("RISCVGenRegisterNameOffsets.inc")
+START = "  /* Register name storage generated by riscv_register_names.py. */"
+LITERAL = r'"(?:[^"\\]|\\.)*"'
+
+def pool_bytes(literals):
+    values = re.sub(r"/\*.*?\*/", "", literals, flags=re.S)
+    if not re.fullmatch(r"\s*(?:" + LITERAL + r"\s*)+", values):
+        raise ValueError("Unrecognized register string table")
+    return b"".join(ast.literal_eval("b" + v) for v in re.findall(LITERAL, values)) + b"\0"
+
+def sources(body, existing):
+    if START in body:
+        def pool(kind):
+            match = re.search(r"/\* " + kind + r" spellings \*/\n(.*?)\n  /\* end spellings \*/", body, re.S)
+            if not match:
+                raise ValueError("Missing register spelling block")
+            return match[1]
+        entries = re.findall(r"^RISCV_NAME\((\d+), (\d+)\)$", existing, re.M)
+        return pool("numeric"), pool("ABI"), [(int(a), int(b)) for a,b in entries]
+    def original(alt):
+        table = re.search(r"AsmStrs" + alt + r"\[\] = \{\n(.*?)\n\};", body, re.S)
+        offsets = re.search(r"RegAsmOffset" + alt + r"\[\] = \{([\d,\s]+)\};", body)
+        if not table or not offsets:
+            raise ValueError("TableGen register name storage has changed")
+        return table[1], [int(x) for x in re.findall(r"\d+", offsets[1])]
+    numeric, n = original("NoRegAltName")
+    abi, a = original("ABIRegAltName")
+    if len(a) != len(n) or "return getRegisterName(RegNo, RISCV_NoRegAltName);" not in body:
+        raise ValueError("Review the TableGen register name fallback")
+    return numeric, abi, list(zip(a, n))
+
+def generate(writer, existing):
+    begin = writer.index("getRegisterName(unsigned RegNo, unsigned AltIdx) {")
+    start = writer.index("\n\n",writer.index("Invalid register number!",begin)) + 2
+    end = writer.index("#else\n  return NULL;\n#endif // CAPSTONE_DIET",start)
+    section=writer[start:end]
+    numeric, abi, rows = sources(section, existing)
+    raw, aliases = pool_bytes(numeric), pool_bytes(abi)
+    limit = int(re.search(r"RegNo < (\d+)",writer[begin:start])[1])
+    if len(rows) + 1 != limit or len(raw)+len(aliases)>65535:
+        raise ValueError("Invalid register name table dimensions")
+    for a,n in rows:
+        if not (0<=a<len(aliases) and 0<=n<len(raw) and raw[n]):
+            raise ValueError("Invalid register name offset")
+    empty = sorted({a for a,_ in rows if aliases[a]==0})
+    condition = " || ".join(f"(a) == {x}" for x in empty) or "0"
+    resolved = f"(({condition}) ? (n) : offsetof(struct RegisterNames, abi) + (a))"
+    includes='#include "RISCVGenRegisterNameOffsets.inc"\n#undef RISCV_NAME\n'
+    data = ("  static const uint16_t offsets[2][" + str(len(rows)) + "] = {\n"
+            "    {\n#define RISCV_NAME(a, n) " + resolved + ",\n" + includes +
+            "    },\n    {\n#define RISCV_NAME(a, n) (n),\n" + includes + "    },\n  };\n")
+    lookup="offsets[AltIdx == RISCV_NoRegAltName][RegNo - 1]"
+    code = (START + "\n  static const struct RegisterNames {\n"
+            f"    char numeric[{len(raw)}];\n    char abi[{len(aliases)}];\n"
+            "  } names = {\n  /* numeric spellings */\n" + numeric +
+            "\n  /* end spellings */\n  ,\n  /* ABI spellings */\n" + abi +
+            "\n  /* end spellings */\n  };\n" + data +
+            "  CS_ASSERT_RET_VAL((AltIdx == RISCV_NoRegAltName || AltIdx == RISCV_ABIRegAltName) &&\n"
+            '                    "Invalid register alt name index!", NULL);\n'
+            f"  return (const char *)&names + {lookup};\n")
+    original = ("/* Generated from the TableGen ABI and numeric register name offsets. */\n" +
+                "".join(f"RISCV_NAME({a}, {n})\n" for a,n in rows))
+    return writer[:start] + code + writer[end:], original
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    writer = WRITER.read_text()
+    original = ROWS.read_text() if ROWS.is_file() else ""
+    for path, actual, expected in zip((WRITER, ROWS), (writer, original), generate(writer, original)):
+        if actual != expected:
+            if args.check:
+                raise SystemExit("Regenerate " + path.name)
+            path.write_text(expected)
+
+if __name__ == "__main__":
+    main()
