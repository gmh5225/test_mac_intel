+/* Generated by suite/synctools/x86_evex_tables.cpp. */
+struct VectorOutputRow {
+	uint16_t id;
+	char mnemonic[16];
+	uint8_t group_count, groups[4], access[4], immediate;
+};
+static const struct VectorOutputRow evex_output_rows[] = {
+	{ X86_INS_VPXORD, "vpxord", 2, { 134, 166, 0, 0 }, { 2, 1, 1, 0 }, 0 },
+	{ X86_INS_VPXORQ, "vpxorq", 2, { 134, 166, 0, 0 }, { 2, 1, 1, 0 }, 0 },
+	{ X86_INS_VPXORD, "vpxord", 1, { 134, 0, 0, 0 }, { 2, 1, 1, 0 }, 0 },
+	{ X86_INS_VPXORQ, "vpxorq", 1, { 134, 0, 0, 0 }, { 2, 1, 1, 0 }, 0 },
+	{ X86_INS_VAESENC, "vaesenc", 0, { 0, 0, 0, 0 }, { 2, 1, 1, 0 }, 0 },
+	{ X86_INS_VAESENCLAST, "vaesenclast", 0, { 0, 0, 0, 0 }, { 2, 1, 1, 0 }, 0 },
+	{ X86_INS_VAESDEC, "vaesdec", 0, { 0, 0, 0, 0 }, { 2, 1, 1, 0 }, 0 },
+	{ X86_INS_VAESDECLAST, "vaesdeclast", 0, { 0, 0, 0, 0 }, { 2, 1, 1, 0 }, 0 },
+	{ X86_INS_VPCLMULQDQ, "vpclmulqdq", 0, { 0, 0, 0, 0 }, { 2, 1, 1, 1 }, 1 },
+	{ X86_INS_VPTERNLOGD, "vpternlogd", 0, { 0, 0, 0, 0 }, { 3, 1, 1, 0 }, 1 },
+	{ X86_INS_VPTERNLOGQ, "vpternlogq", 0, { 0, 0, 0, 0 }, { 3, 1, 1, 0 }, 1 },
+	{ X86_INS_VPSHUFB, "vpshufb", 0, { 0, 0, 0, 0 }, { 2, 1, 1, 0 }, 0 },
+	{ X86_INS_VPADDD, "vpaddd", 2, { 134, 166, 0, 0 }, { 2, 1, 1, 0 }, 0 },
+	{ X86_INS_VPADDD, "vpaddd", 1, { 134, 0, 0, 0 }, { 2, 1, 1, 0 }, 0 },
+};
+static const struct VectorOutputRow *evexOutputRow(unsigned key, unsigned w, unsigned ll)
+{
+	switch (key) {
+	case 0x1ef: {
+		static const uint8_t rows[2][3] = { { 0, 0, 2 }, { 1, 1, 3 } };
+		return rows[w][ll] == UINT8_MAX ? NULL : &evex_output_rows[rows[w][ll]];
+	}
+	case 0x1fe: {
+		static const uint8_t rows[2][3] = { { 12, 12, 13 }, { 255, 255, 255 } };
+		return rows[w][ll] == UINT8_MAX ? NULL : &evex_output_rows[rows[w][ll]];
+	}
+	case 0x200: {
+		static const uint8_t rows[2][3] = { { 11, 11, 11 }, { 11, 11, 11 } };
+		return rows[w][ll] == UINT8_MAX ? NULL : &evex_output_rows[rows[w][ll]];
+	}
+	case 0x2dc: {
+		static const uint8_t rows[2][3] = { { 4, 4, 4 }, { 4, 4, 4 } };
+		return rows[w][ll] == UINT8_MAX ? NULL : &evex_output_rows[rows[w][ll]];
+	}
+	case 0x2dd: {
+		static const uint8_t rows[2][3] = { { 5, 5, 5 }, { 5, 5, 5 } };
+		return rows[w][ll] == UINT8_MAX ? NULL : &evex_output_rows[rows[w][ll]];
+	}
+	case 0x2de: {
+		static const uint8_t rows[2][3] = { { 6, 6, 6 }, { 6, 6, 6 } };
+		return rows[w][ll] == UINT8_MAX ? NULL : &evex_output_rows[rows[w][ll]];
+	}
+	case 0x2df: {
+		static const uint8_t rows[2][3] = { { 7, 7, 7 }, { 7, 7, 7 } };
+		return rows[w][ll] == UINT8_MAX ? NULL : &evex_output_rows[rows[w][ll]];
+	}
+	case 0x325: {
+		static const uint8_t rows[2][3] = { { 9, 9, 9 }, { 10, 10, 10 } };
+		return rows[w][ll] == UINT8_MAX ? NULL : &evex_output_rows[rows[w][ll]];
+	}
+	case 0x344: {
+		static const uint8_t rows[2][3] = { { 8, 8, 8 }, { 8, 8, 8 } };
+		return rows[w][ll] == UINT8_MAX ? NULL : &evex_output_rows[rows[w][ll]];
+	}
+	default: return NULL;
+	}
+}
+static const struct VectorOutputRow vex_indexed_rows[2][2] = {
+	{
+		{ X86_INS_VMOVAPS, "vmovaps", 2, { 132, 168, 0, 0 }, { 2, 1, 0, 0 }, 0 },
+		{ X86_INS_VMOVAPS, "vmovaps", 2, { 132, 168, 0, 0 }, { 2, 1, 0, 0 }, 0 },
+	},
+	{
+		{ X86_INS_VFMADD213PS, "vfmadd213ps", 0, { 0, 0, 0, 0 }, { 3, 1, 1, 0 }, 0 },
+		{ X86_INS_VFMADD213PS, "vfmadd213ps", 0, { 0, 0, 0, 0 }, { 3, 1, 1, 0 }, 0 },
+	},
+};
