 /* Requires CAPSTONE_X86_SCAN_ADAPTER. Private static-link integration, not
  * an installed cs_* API. The callback
  * must use the handle's exact 32/64-bit profile and return (public_id << 8) |
diff --git a/arch/X86/X86SimpleOutput.h b/arch/X86/X86SimpleOutput.h
new file mode 100644
index 00000000..cc5aa9f7
--- /dev/null
+++ b/arch/X86/X86SimpleOutput.h
@@ -0,0 +1,113 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_SIMPLE_OUTPUT_H
+#define CS_X86_SIMPLE_OUTPUT_H
+
+#include <stddef.h>
+#include <string.h>
+#include <capstone/capstone.h>
+#include "../../utils.h"
+
+/* The generated records describe the same register operands and implicit
+ * effects as the ordinary Intel printer. Only the public x86 prefix of the
+ * detail allocation belongs to this decoder. */
+struct X86SimpleOperand {
+	uint16_t reg;
+	uint8_t size;
+	uint8_t access;
+};
+
+struct X86SimpleOutput {
+	unsigned int id;
+	char mnemonic[12];
+	char operands[20];
+	uint64_t flags;
+	uint16_t reads[4];
+	uint16_t writes[4];
+	uint8_t groups[4];
+	uint8_t read_count, write_count, group_count, operand_count;
+	uint8_t address_size, modrm_offset, imm_offset, imm_size;
+	struct X86SimpleOperand ops[2];
+};
+
+struct X86SimpleRegister {
+	uint16_t reg;
+	uint8_t length;
+	char name[8];
+};
+
+enum X86SimpleForm {
+	X86_SIMPLE_FIXED,
+	X86_SIMPLE_RM_REG,
+	X86_SIMPLE_REG_RM,
+	X86_SIMPLE_RELATIVE,
+};
+
+/* This plan gets its ALU row from ModR/M.reg. Its low bits select the
+ * same register-only operand check as a register pair. */
+#define X86_PLAN_GROUP1_IMM8 ((UINT16_MAX & ~3u) | X86_SIMPLE_REG_RM)
+
+/* The vector escape uses the next reserved plan and has no register-pair ModR/M. */
+#define X86_PLAN_VECTOR UINT16_MAX
+#define X86_PLAN_MOV_REG_IMM32 ((UINT16_MAX & ~3u) | X86_SIMPLE_FIXED)
+
+CAPSTONE_INTERNAL bool
+X86_writeVectorOutput(const uint8_t *code, size_t size, cs_insn *insn,
+		      uint16_t *insn_size,
+		      const struct X86SimpleRegister *regs);
+
+static inline char *X86_writeDisp8(char *out, int displacement)
+{
+	if (displacement) {
+		const unsigned magnitude = displacement < 0 ? -displacement :
+							      displacement;
+		memcpy(out, displacement < 0 ? " - " : " + ", 3);
+		out += 3;
+		if (magnitude <= HEX_THRESHOLD) {
+			*out++ = (char)('0' + magnitude);
+		} else {
+			static const char digits[] = "0123456789abcdef";
+			memcpy(out, "0x", 2);
+			out += 2;
+			if (magnitude >= 16)
+				*out++ = digits[magnitude >> 4];
+			*out++ = digits[magnitude & 15];
+		}
+	}
+	return out;
+}
+
+static inline void X86_writeSimpleDetail(cs_detail *detail,
+					 const struct X86SimpleOutput *row,
+					 uint8_t opcode, uint8_t rex,
+					 uint8_t modrm, uint16_t first,
+					 uint16_t second)
+{
+	memset(detail, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+	memcpy(detail->regs_read, row->reads, sizeof(row->reads));
+	memcpy(detail->regs_write, row->writes, sizeof(row->writes));
+	memcpy(detail->groups, row->groups, sizeof(row->groups));
+	detail->regs_read_count = row->read_count;
+	detail->regs_write_count = row->write_count;
+	detail->groups_count = row->group_count;
+	cs_x86 *x86 = &detail->x86;
+	x86->addr_size = row->address_size;
+	x86->opcode[0] = opcode;
+	x86->eflags = row->flags;
+	x86->rex = rex;
+	x86->modrm = modrm;
+	x86->encoding.modrm_offset = row->modrm_offset;
+	x86->encoding.imm_offset = row->imm_offset;
+	x86->encoding.imm_size = row->imm_size;
+	x86->op_count = row->operand_count;
+	for (unsigned i = 0; i < x86->op_count; ++i) {
+		cs_x86_op *op = &x86->operands[i];
+		op->type = X86_OP_REG;
+		op->reg = (x86_reg)(i ? second : first);
+		op->size = row->ops[i].size;
+		op->access = (cs_ac_type)row->ops[i].access;
+	}
+}
+
+#endif
diff --git a/arch/X86/X86VectorOutput.c b/arch/X86/X86VectorOutput.c
new file mode 100644
index 00000000..22c8d600
--- /dev/null
+++ b/arch/X86/X86VectorOutput.c
@@ -0,0 +1,279 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "../../cs_priv.h"
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	(defined(CAPSTONE_X86_ONLY) || \
+	 (defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	  !defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	  !defined(_WIN32_WCE)))
+#include "X86Disassembler.h"
+#include "X86GenEvexScan.inc"
+/* An unprefixed EVEX packet has its ModR/M at byte five. Only immutable
+ * public IDs of ordinary vector register or base/index addresses are used. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+CAPSTONE_INTERNAL bool X86_tryEvexScan(const uint8_t *code, size_t size,
+				       X86ScanResult *result)
+{
+	if (size < 6 || code[0] != 0x62 || !(code[2] & 4) || (code[3] & 0x97) ||
+	    (code[3] & 0x60) == 0x60)
+		return false;
+	unsigned key = ((code[1] & 15) << 10) | ((code[2] & 3) << 8) | code[4];
+	const struct X86EvexScanForm *form = evex_scan_form(key);
+	if (!form ||
+	    (form->reserved_v && ((code[2] & 0x78) != 0x78 || !(code[3] & 8))))
+		return false;
+	bool reg = code[5] >= 0xc0;
+	unsigned id = form->ids[code[2] >> 7][code[3] >> 5][reg];
+	if (!id)
+		return false;
+	/* In 64-bit address mode the ModR/M mod and r/m fields determine the
+	 * extent, except for a no-base SIB with mod=0. Only that SIB is read. */
+	static const uint8_t extra[4][8] = {
+		{ 0, 0, 0, 0, 1, 4, 0, 0 },
+		{ 1, 1, 1, 1, 2, 1, 1, 1 },
+		{ 4, 4, 4, 4, 5, 4, 4, 4 },
+		{ 0, 0, 0, 0, 0, 0, 0, 0 },
+	};
+	unsigned length =
+		6 + extra[code[5] >> 6][code[5] & 7] + form->immediate;
+	if ((code[5] & 0xc7) == 4) {
+		if (size <= 6)
+			return false;
+		if ((code[6] & 7) == 5)
+			length += 4;
+	}
+	if (length > size)
+		return false;
+	result->opcode = 0;
+	result->opcode_pub = id;
+	result->length = (uint16_t)length;
+	result->popcode_adjust = 0;
+	return true;
+}
+#endif
+
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#include "X86SimpleOutput.h"
+#include "X86GenEvexOutput.inc"
+static char *writeVectorRegister(char *out, unsigned length_code,
+				 unsigned number)
+{
+	*out++ = "xyz"[length_code];
+	*out++ = 'm';
+	*out++ = 'm';
+	if (number >= 10)
+		*out++ = (char)('0' + number / 10);
+	*out++ = (char)('0' + number % 10);
+	return out;
+}
+
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static bool writeEvexRegisterOutput(const uint8_t *code, size_t size,
+				    cs_insn *insn, uint16_t *insn_size)
+{
+	if (size < 6 || (code[2] & 7) != 5 || (code[3] & 0x97) ||
+	    (code[3] & 0x60) == 0x60 || code[5] < 0xc0)
+		return false;
+	const unsigned ll = code[3] >> 5;
+	const unsigned w = code[2] >> 7;
+	const struct VectorOutputRow *row =
+		evexOutputRow(((code[1] & 15) << 8) | code[4], w, ll);
+	if (!row || (row->immediate && size < 7))
+		return false;
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & 7;
+	const unsigned regs[] = { ((code[5] >> 3) & 7) | ((rxb & 4) << 1) |
+					  (~(unsigned)code[1] & 16),
+				  ((~(unsigned)code[2] >> 3) & 15) |
+					  ((~(unsigned)code[3] & 8) << 1),
+				  (code[5] & 7) | ((rxb & 3) << 3) };
+	const unsigned len = 6 + row->immediate;
+	*insn_size = insn->size = (uint16_t)len;
+	insn->id = row->id;
+	memcpy(insn->bytes, code, len);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = writeVectorRegister(insn->op_str, ll, regs[0]);
+	for (unsigned n = 1; n != 3; ++n) {
+		memcpy(out, ", ", 2);
+		out = writeVectorRegister(out + 2, ll, regs[n]);
+	}
+	if (row->immediate) {
+		const unsigned value = code[6];
+		memcpy(out, ", ", 2);
+		out += 2;
+		if (value <= HEX_THRESHOLD) {
+			*out = (char)('0' + value);
+		} else {
+			static const char digits[] = "0123456789abcdef";
+			memcpy(out, "0x", 2);
+			out += 2;
+			if (value >= 16)
+				*out++ = digits[value >> 4];
+			*out = digits[value & 15];
+		}
+	}
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		memcpy(d->groups, row->groups, sizeof(row->groups));
+		d->groups_count = row->group_count;
+		cs_x86 *x = &d->x86;
+		memcpy(x->opcode, code, sizeof(x->opcode));
+		x->addr_size = 8;
+		x->rex = (uint8_t)(0x40 | (w << 3) | rxb);
+		x->modrm = code[5];
+		x->encoding.modrm_offset = 5;
+		x->op_count = 3 + row->immediate;
+		static const x86_reg bases[] = { X86_REG_XMM0, X86_REG_YMM0,
+						 X86_REG_ZMM0 };
+		for (unsigned n = 0; n != 3; ++n) {
+			cs_x86_op *op = &x->operands[n];
+			op->type = X86_OP_REG;
+			op->reg = (x86_reg)(bases[ll] + regs[n]);
+			op->access = (cs_ac_type)row->access[n];
+			op->size = (uint8_t)(16 << ll);
+		}
+		if (row->immediate) {
+			x->operands[3].type = X86_OP_IMM;
+			x->operands[3].imm = code[6];
+			x->operands[3].access = (cs_ac_type)row->access[3];
+			x->operands[3].size = 1;
+			x->encoding.imm_offset = 6;
+			x->encoding.imm_size = 1;
+		}
+	}
+	return true;
+}
+
+/* VEX packed loads and FMA with an ordinary base, index and optional disp8.
+ * Prefix, ModR/M and SIB also supply all register IDs used in detail. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static bool writeVexIndexedOutput(const uint8_t *code, size_t size,
+				  cs_insn *insn, uint16_t *insn_size,
+				  const struct X86SimpleRegister *regs)
+{
+	const bool fma = code[0] == 0xc4;
+	const unsigned prefix = fma ? 3 : 2;
+	if (size < prefix + 3)
+		return false;
+	const uint8_t flags = code[prefix - 1];
+	if (fma) {
+		if ((code[1] & 0x1f) != 2 || (flags & 0x83) != 1 ||
+		    code[prefix] != 0xa8)
+			return false;
+	} else if ((flags & 0x7b) != 0x78 || code[prefix] != 0x28) {
+		return false;
+	}
+	const unsigned modrm = code[prefix + 1];
+	const unsigned sib = code[prefix + 2];
+	const bool has_disp = (modrm & 0x40) != 0;
+	const unsigned len = prefix + 3 + has_disp;
+	if ((modrm & 0x87) != 4 || len > size || (!has_disp && (sib & 7) == 5))
+		return false;
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & (fma ? 7 : 4);
+	const unsigned index = ((rxb & 2) << 2) | ((sib >> 3) & 7);
+	if (index == 4)
+		return false;
+	const unsigned base = ((rxb & 1) << 3) | (sib & 7);
+	const unsigned scale = 1u << (sib >> 6);
+	const int disp = has_disp ? (int8_t)code[len - 1] : 0;
+	const unsigned ll = (flags >> 2) & 1;
+	const unsigned dst = ((rxb & 4) << 1) | ((modrm >> 3) & 7);
+	const unsigned src = (~(unsigned)flags >> 3) & 15;
+	const struct VectorOutputRow *row = &vex_indexed_rows[fma][ll];
+	*insn_size = insn->size = (uint16_t)len;
+	insn->id = row->id;
+	memcpy(insn->bytes, code, len);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = writeVectorRegister(insn->op_str, ll, dst);
+	if (fma) {
+		memcpy(out, ", ", 2);
+		out = writeVectorRegister(out + 2, ll, src);
+	}
+	memcpy(out, ", xmmword ptr [", 15);
+	out[2] = "xy"[ll];
+	out += 15;
+	memcpy(out, regs[base].name, sizeof(regs[base].name));
+	out += regs[base].length;
+	memcpy(out, " + ", 3);
+	out += 3;
+	memcpy(out, regs[index].name, sizeof(regs[index].name));
+	out += regs[index].length;
+	if (scale != 1) {
+		*out++ = '*';
+		*out++ = (char)('0' + scale);
+	}
+	out = X86_writeDisp8(out, disp);
+	*out = ']';
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		memcpy(d->groups, row->groups, sizeof(row->groups));
+		d->groups_count = row->group_count;
+		cs_x86 *x = &d->x86;
+		memcpy(x->opcode, code, prefix);
+		x->addr_size = 8;
+		x->rex = (uint8_t)(0x40 | rxb);
+		x->modrm = (uint8_t)modrm;
+		x->sib = (uint8_t)sib;
+		x->sib_base = (x86_reg)regs[base].reg;
+		x->sib_index = (x86_reg)regs[index].reg;
+		x->sib_scale = (int8_t)scale;
+		x->disp = disp;
+		x->encoding.modrm_offset = (uint8_t)(prefix + 1);
+		if (has_disp) {
+			x->encoding.disp_offset = (uint8_t)(len - 1);
+			x->encoding.disp_size = 1;
+		}
+		x->op_count = (uint8_t)(2 + fma);
+		const x86_reg first = ll ? X86_REG_YMM0 : X86_REG_XMM0;
+		const unsigned reg_count = 1u + fma;
+		for (unsigned i = 0; i < reg_count; ++i) {
+			cs_x86_op *op = &x->operands[i];
+			op->type = X86_OP_REG;
+			op->reg = (x86_reg)(first + (i ? src : dst));
+			op->size = (uint8_t)(16u << ll);
+			op->access = (cs_ac_type)row->access[i];
+		}
+		cs_x86_op *op = &x->operands[reg_count];
+		op->type = X86_OP_MEM;
+		op->mem.base = x->sib_base;
+		op->mem.index = x->sib_index;
+		op->mem.scale = (int)scale;
+		op->mem.disp = disp;
+		op->size = (uint8_t)(16u << ll);
+		op->access = (cs_ac_type)row->access[reg_count];
+	}
+	return true;
+}
+
+bool X86_writeVectorOutput(const uint8_t *code, size_t size, cs_insn *insn,
+			   uint16_t *insn_size,
+			   const struct X86SimpleRegister *regs)
+{
+	if (code[0] == 0x62)
+		return writeEvexRegisterOutput(code, size, insn, insn_size);
+	return writeVexIndexedOutput(code, size, insn, insn_size, regs);
+}
+#endif
+#endif
