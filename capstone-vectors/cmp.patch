+/* Both group-1 dispatchers already have the opcode and ModR/M byte. */
+static bool writeGroup1Compare64(cs_struct *handle, const uint8_t *code,
+				 size_t size, cs_insn *insn, uint16_t *length,
+				 unsigned prefix, uint8_t opcode, uint8_t modrm)
+{
+	if (modrm >= 0xc0 || (modrm & 0x38) != 0x38 ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
