 #include "X86GenLegacyRegisterImmediates.inc"
 #include "X86GenLegacyMap38Registers.inc"
+#include "X86GenBareVexRegisters64.inc"
+
+static bool writeBareVexRegisters64(const uint8_t *code, size_t size,
+				    cs_insn *insn, uint16_t *insn_size,
+				    unsigned prefix)
+{
+	if (size < prefix + 2 || (prefix == 3 && (code[1] & 31) != 1))
+		return false;
+	const unsigned flags = code[prefix - 1];
+	const uint8_t modrm = code[prefix + 1];
+	if ((flags & 3) || modrm < 0xc0)
+		return false;
+	const unsigned ll = (flags >> 2) & 1;
+	const unsigned index = bare_vex_registers[code[prefix]][ll];
+	if (!index)
+		return false;
+	const struct VectorOutputRow *row = &bare_vex_rows[index];
+	if (size < prefix + 2 + row->immediate)
+		return false;
+	const unsigned w = prefix == 3 && (flags & 0x80);
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & (prefix == 2 ? 4 : 7);
+	const unsigned regs[] = { ((modrm >> 3) & 7) | ((rxb & 4) << 1),
+				  (~flags >> 3) & 15, (modrm & 7) | ((rxb & 1) << 3) };
+	return writeVectorRegisters(code, insn, insn_size, row, prefix, ll,
+				    0x40 | (w << 3) | rxb, ll, regs, 3);
+}
