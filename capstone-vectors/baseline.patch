+std::string vex32_memory_record(Decoder &decoder, unsigned opcode, unsigned pp,
+				unsigned ll, unsigned dst, unsigned src,
+				unsigned base, unsigned mod, int32_t disp)
+{
+	const unsigned disp_size = mod == 2 ? 4 : mod;
