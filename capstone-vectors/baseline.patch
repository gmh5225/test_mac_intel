+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#if defined(CAPSTONE_HAS_X86) && defined(__clang__)
+#include "../../cs_priv.h"
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#if defined(__ELF__)
+/* Keep this optional writer's constants outside the ordinary decoder tables. */
+#pragma clang section rodata=".cs_x86_vex32_rodata"
+#endif
+#include "X86SimpleOutput.h"
+
+#if defined(__ELF__)
+#define X86_VEX32_OUTPUT_CODE \
+	__attribute__((noinline, section(".cs_x86_vex32_output")))
+#elif defined(__APPLE__)
+#define X86_VEX32_OUTPUT_CODE \
+	__attribute__(( \
+		noinline, \
+		section("__TEXT,__x86_vex32,regular,pure_instructions")))
+#else
+#define X86_VEX32_OUTPUT_CODE __attribute__((noinline))
+#endif
+
+#include "X86GenVex32PairOutput.inc"
+#include "X86VectorRegisterWriter.h"
+#define X86_VECTOR_REGISTER_CODE X86_VEX32_OUTPUT_CODE
+#include "X86VectorRegisterOutput.h"
+
+X86_VEX32_OUTPUT_CODE
+static bool writeVex32PairOutput(const uint8_t *code, size_t size,
+				 cs_insn *insn, uint16_t *insn_size,
+				 unsigned prefix)
+{
+	const unsigned flags = code[prefix - 1];
+	const unsigned map = prefix == 2 ? 1 : code[1] & 31;
+	/* These rows reserve vvvv and use the 66 mandatory prefix. The
+     * caller already checked W=0, low registers and register ModR/M. */
+	if ((flags & 0x7b) != 0x79 || !map || map > 3)
+		return false;
+	const unsigned ll = (flags >> 2) & 1;
+	const unsigned plan = vex_pair32_plans[map - 1][code[prefix]][ll];
+	if (!plan)
+		return false;
+	const struct VectorOutputRow *row = &vex_pair32_rows[(plan & 0x7f) - 1];
+	if (size < prefix + 2 + row->immediate)
+		return false;
+	const unsigned modrm = code[prefix + 1];
+	unsigned regs[] = { (modrm >> 3) & 7, modrm & 7 };
+	if (plan & 0x80) {
+		const unsigned first = regs[0];
+		regs[0] = regs[1];
+		regs[1] = first;
+	}
+	return writeVectorRegisters(code, insn, insn_size, row, prefix, ll, 0,
+				    ll, regs, 2);
+}
+
+#include "X86GenVex32MemoryOutput.inc"
+
+/* Bare VEX2, ordinary 32-bit base and a generated full-width memory record. */
+X86_VEX32_OUTPUT_CODE
+static bool writeVex32Memory(const uint8_t *code, size_t size, cs_insn *insn,
+			     uint16_t *insn_size)
+{
+	const unsigned flags = code[1], modrm = code[3];
+	const unsigned mod = modrm >> 6, rm = modrm & 7;
+	if (rm == 4 || (!mod && rm == 5))
+		return false;
+	const unsigned plan = vex32_memory_plans[flags & 7][code[2]];
+	if (!plan)
+		return false;
+	const struct Vex32MemoryRow *row = &vex32_memory_rows[plan];
+	const unsigned src = (~flags >> 3) & 7;
+	if (row->form && src)
+		return false;
+	const unsigned disp_size = mod == 2 ? 4 : mod, length = 4 + disp_size;
+	if (size < length)
+		return false;
+	const int32_t disp = mod == 2 ? X86_readDisp32(code + 4) :
