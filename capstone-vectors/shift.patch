+static bool writeEvexImmediateShift(const uint8_t *code, size_t size,
+				    cs_insn *insn, uint16_t *insn_size)
+{
+	const unsigned opcode = code[4];
+	if (opcode < 0x71 || opcode > 0x73 || size < 7 ||
+	    (code[1] & 0x9f) != 0x91)
+		return false;
+	const unsigned ll = code[3] >> 5, w = code[2] >> 7;
+	const unsigned plan =
+		evex_shift_plans[opcode - 0x71][(code[5] >> 3) & 7][w * 3 + ll];
+	if (!plan)
+		return false;
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & 7;
+	const unsigned regs[] = { ((~(unsigned)code[2] >> 3) & 15) |
+					  ((~(unsigned)code[3] & 8) << 1),
+				  (code[5] & 7) | ((rxb & 3) << 3) };
+	return writeVectorRegisters(code, insn, insn_size,
+				    &evex_shift_rows[plan - 1], 4, ll,
+				    0x40 | (w << 3) | rxb, ll, regs, 2);
+}
