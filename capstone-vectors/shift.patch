+/* Group shifts already failed the common EVEX register lookup. The prefix
+ * guarantees pp=66, no masking/broadcast, a valid width and a register r/m. */
+#if defined(__ELF__) && defined(__GNUC__)
+__attribute__((noinline, section(".cs_x86_evex_output")))
+#elif defined(_MSC_VER)
