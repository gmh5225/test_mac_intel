+/* Keep the public AT&T records with this syntax's printer. Static public
+ * consumers can use them without linking the private Intel iterator. */
+#include "X86OutputOptions.h"
+#ifdef CAPSTONE_X86_ATT_RECORD_OUTPUT
+#include "X86SimpleOutput.h"
+#include "X86GenSimpleOutput.inc"
+#define X86_ATT_MEMORY X86_writeATTMemoryOutput
+#include "X86MemoryOutputImpl.h"
+#undef X86_ATT_MEMORY
+#include "X86ScalarImmediateRecord.h"
+
+static void writeATTImmediate(const uint8_t *code, cs_insn *insn,
+			      uint16_t *insn_size, uint8_t rex,
+			      const struct X86SimpleOutput *row,
+			      const struct X86SimpleRegister *reg)
+{
+	const uint8_t opcode = code[rex != 0];
+	if (opcode == 0x6a || opcode == 0x68) {
+		writePushImmediate(insn, code, row, row->address_size == 8,
+				   insn_size, true);
+		return;
+	}
+	writeRegisterImmediate(insn, row, reg, code, rex, code[1 + (rex != 0)],
+			       opcode, insn_size, true);
+}
+
+#define X86_ATT_OUTPUT
+#include "X86SimpleOutputImpl.h"
+#undef X86_ATT_OUTPUT
+#endif
+
 #endif
