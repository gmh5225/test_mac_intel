+/* Both positive immediates and branch targets use the same radix threshold.
+ * An AT&T immediate's dollar sign belongs to its number's markup token. */
+static void printUnsignedNumber(SStream *O, uint64_t value, bool dollar)
+{
+#if !defined(CAPSTONE_DIET) && defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+	if (cs_vsnprintf == cs_default_vsnprintf && !O->is_closed &&
+	    O->index < SSTREAM_BUF_LEN - 1 - (size_t)dollar) {
+		if (dollar)
+			O->buffer[O->index++] = '$';
+		printUInt64(O, value);
+		return;
+	}
+#endif
+	if (value > HEX_THRESHOLD)
+		SStream_concat(O, dollar ? "$0x%" PRIx64 : "0x%" PRIx64, value);
+	else
+		SStream_concat(O, dollar ? "$%" PRIu64 : "%" PRIu64, value);
+}
