+static bool writeRoundedFma(const uint8_t *code, size_t size, cs_insn *insn,
+			    uint16_t *insn_size)
+{
+	/* The vector writer has already handled ordinary lengths and broadcasts.
+	 * For register FMA, EVEX.b selects rounding and L'L encodes RC. */
+	if (code[0] != 0x62 || size < 6 || code[5] < 0xc0 ||
+	    (code[3] & 0x97) != 0x10)
+		return false;
+	const unsigned opcode = code[4];
+	if ((code[1] & 15) != 2 || (code[2] & 7) != 5 || opcode < 0x98 ||
+	    opcode > 0xbe || (opcode & 9) != 8)
+		return false;
+	const unsigned w = code[2] >> 7, rc = (code[3] >> 5) & 3;
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & 7;
+	unsigned regs[3];
+	evexVectorRegisters(code, rxb, regs);
+	const struct VectorOutputRow *row =
+		&evex_rounded_fma_rows[(opcode >> 4) - 9][(opcode & 6) >> 1][w];
+	writeVectorRegisters(code, insn, insn_size, row, 4, 2,
+			     0x40 | (w << 3) | rxb, 2, regs, 3);
+	static const char suffix[][11] = { ", {rn-sae}", ", {rd-sae}",
+					   ", {ru-sae}", ", {rz-sae}" };
+	static const x86_avx_rm modes[] = { X86_AVX_RM_RN, X86_AVX_RM_RD,
+					    X86_AVX_RM_RU, X86_AVX_RM_RZ };
+	/* The register writer has already terminated the operand string. */
+	memcpy(insn->op_str + strlen(insn->op_str), suffix[rc],
+	       sizeof(suffix[rc]));
+	if (insn->detail) {
+		insn->detail->x86.avx_sae = true;
+		insn->detail->x86.avx_rm = modes[rc];
+	}
+	return true;
+}
