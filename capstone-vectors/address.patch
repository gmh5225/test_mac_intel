diff --git a/arch/X86/X86IntelInstPrinter.c b/arch/X86/X86IntelInstPrinter.c
index 457485ab..ea2af3ed 100644
--- a/arch/X86/X86IntelInstPrinter.c
+++ b/arch/X86/X86IntelInstPrinter.c
@@ -44,6 +44,9 @@
 #include "../../MCRegisterInfo.h"
 
 #include "X86InstPrinter.h"
+#ifdef CAPSTONE_SSTREAM_PRECHECKED
+#include "X86SimpleOutput.h"
+#endif
 #include "X86FeatureExtension.h"
 #include "X86Mapping.h"
 #include "X86InstPrinterCommon.h"
@@ -1186,6 +1189,35 @@ static void printMemReference(MCInst *MI, unsigned Op, SStream *O)
 #endif
 	}
 
+#ifdef CAPSTONE_SSTREAM_PRECHECKED
+	/* The caller has reserved space for the complete printed instruction.
+	 * Write this base and displacement with one update to the stream. */
+	const unsigned base = MCOperand_getReg(BaseReg);
+	const unsigned index = MCOperand_getReg(IndexReg);
+	if (base && base < X86_FEATURE_MC_GPR_BASE && MCOperand_isReg(BaseReg) &&
+	    !MCOperand_getReg(SegReg) && (!index || index == X86_EIZ) &&
+	    MCOperand_isImm(DispSpec) && MI->csh->syntax != CS_OPT_SYNTAX_MASM) {
+		const int64_t disp = MCOperand_getImm(DispSpec);
+		const unsigned len = getRegisterNameLength(base);
+		if (disp == (int32_t)disp && len >= 2 && len <= 4) {
+			const char *name = getRegisterName(base);
+			char *out = O->buffer + O->index;
+			*out++ = '[';
+			memcpy(out, name, 2);
+			memcpy(out + len - 2, name + len - 2, 2);
+			out = X86_writeDisplacement(out + len, (int32_t)disp);
+			*out++ = ']';
+			*out = 0;
+			O->index = (size_t)(out - O->buffer);
+			if (MI->csh->detail_opt) {
+				cs_x86 *x = &MI->flat_insn->detail->x86;
+				x->operands[x->op_count].mem.disp = disp;
+			}
+			goto finish_memory;
+		}
+	}
+#endif
+
 	// If this has a segment register, print it.
 	reg = MCOperand_getReg(SegReg);
 	if (reg) {
@@ -1254,6 +1286,9 @@ static void printMemReference(MCInst *MI, unsigned Op, SStream *O)
 
 	SStream_concat0(O, "]");
 
+#ifdef CAPSTONE_SSTREAM_PRECHECKED
+finish_memory:
+#endif
 	if (MI->csh->detail_opt)
 		MI->flat_insn->detail->x86.op_count++;
 
