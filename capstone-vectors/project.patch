diff --git a/arch/X86/X86Vex32Output.c b/arch/X86/X86Vex32Output.c
index 443b2f86..8f68962d 100644
--- a/arch/X86/X86Vex32Output.c
+++ b/arch/X86/X86Vex32Output.c
@@ -213,4 +213,24 @@ CAPSTONE_INTERNAL bool X86_disasmIter32(csh ud, const uint8_t **code,
 #endif
 	return X86_disasmIter(ud, code, size, address, insn);
 }
+
+#ifdef CAPSTONE_X86_PUBLIC_OUTPUT
+/* The public iterator owns cursor advancement. A scan miss or an unsupported
+ * mode can tail-call the ordinary decoder using the same calling convention. */
+CS_PRESERVE_MOST bool X86_decodePublicRecord(cs_struct *handle,
+					    const uint8_t *code, size_t size,
+					    cs_insn *insn, uint16_t *length,
+					    bool batch)
+{
+	if (handle->arch == CS_ARCH_X86 && !handle->no_text) {
+		if (handle->mode == CS_MODE_32)
+			return decode_insn(handle, code, size, insn, length,
+					   false, batch);
+		if (handle->mode == CS_MODE_64)
+			return X86_decodeTextRecord64(handle, code, size, insn,
+						      length, batch);
+	}
+	return cs_decode_full_insn(handle, code, size, insn, length, batch);
+}
+#endif
 #endif
