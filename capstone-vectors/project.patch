@@ -274,4 +274,13 @@ CAPSTONE_INTERNAL bool X86_disasmIterText(csh ud, const uint8_t **code,
 #endif
 	return X86_disasmIter32(ud, code, size, address, insn);
 }
+
+#ifdef CAPSTONE_X86_PUBLIC_OUTPUT
+bool X86_decodeTextRecord64(struct cs_struct *handle, const uint8_t *code,
