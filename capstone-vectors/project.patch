@@ -350,4 +350,24 @@ X86ScanBatchResult X86_scanNativeBatch(csh ud, const uint8_t *code, size_t size,
 #endif
 	return X86_scanBatch(ud, code, size, address, output, capacity);
 }
+
+#if defined(CAPSTONE_X86_SHARED_TEXT_ITERATOR) && !defined(CAPSTONE_X86_SCAN_ADAPTER)
+/* Commit a validated public record in the reader's frame. A rejected
+ * encoding enters the ordinary iterator with untouched input and output. */
+bool X86_disasmRecordIter(csh ud, const uint8_t **code, size_t *size,
+			 uint64_t *address, cs_insn *insn, bool wide)
+{
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	const uint32_t word = wide ? readFirst64(*code, *size) :
+				     readFirst32(*code, *size);
+	if (!word)
+		return X86_disasmScanIterFallback(handle, code, size, address, insn);
+	const X86ScanResult result = { 0, word >> 8, (uint16_t)(word & 0xff), 0 };
+	handle->errnum = CS_ERR_OK;
+	insn->address = *address;
+	finish_x86_scan(handle, insn, &result, *code, false, true);
+	advance_iter(code, size, address, result.length);
+	return true;
+}
+#endif
 #endif
