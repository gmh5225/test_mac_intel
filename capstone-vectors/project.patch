+/* Keep the full decoder's stack frame off generated-output hits, while
+ * retaining the public iterator's scan code and private calling convention. */
+#if defined(CAPSTONE_X86_DEDICATED_OUTPUT) && defined(__clang__) && defined(__x86_64__)
+CS_PRESERVE_MOST bool
+cs_decode_full_insn(cs_struct *handle, const uint8_t *code, size_t size,
+		    cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+	if (size && X86_trySimpleOutput(handle, code, size, insn, insn_size))
+		return true;
+	return cs_decode_full_insn_body(handle, code, size, insn, insn_size, batch);
+}
+
+__attribute__((noinline)) CS_PRESERVE_MOST bool
+cs_decode_full_insn_body(cs_struct *handle, const uint8_t *code, size_t size,
+		    cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+#else
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+CS_PRESERVE_MOST bool
+cs_decode_full_insn(cs_struct *handle, const uint8_t *code, size_t size,
+		    cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+#ifdef CAPSTONE_X86_DEDICATED_OUTPUT
+	if (size && X86_trySimpleOutput(handle, code, size, insn, insn_size))
+		return true;
+#endif
+#endif
+	return decode_arch_record(handle, code, size, insn, insn_size, batch,
+				  false);
+}
+
+#ifdef CAPSTONE_X86_PUBLIC_OUTPUT
+CS_PRESERVE_MOST bool
+cs_decode_public_record(cs_struct *handle, const uint8_t *code, size_t size,
+			cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+	return decode_arch_record(handle, code, size, insn, insn_size, batch,
+				  true);
+}
+#endif
+
 #if defined(_MSC_VER)
 __declspec(noinline)
 #elif defined(__GNUC__)
