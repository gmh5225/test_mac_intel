+/* Legacy modes expose a different implicit write set for these opcodes.
+ * Keep the unmodified table copy on the common 64-bit path. */
+static inline void set_mode_implicit_writes(cs_detail *detail, unsigned int i,
+					    unsigned int id, cs_mode mode)
+{
+	if (mode != CS_MODE_64) {
+		switch (id) {
+		case X86_RDTSC:
+			detail->regs_write[0] = X86_REG_EAX;
+			detail->regs_write[1] = X86_REG_EDX;
+			detail->regs_write_count = 2;
+			return;
+		case X86_RDTSCP:
+			detail->regs_write[0] = X86_REG_EAX;
+			detail->regs_write[1] = X86_REG_ECX;
+			detail->regs_write[2] = X86_REG_EDX;
+			detail->regs_write_count = 3;
+			return;
+#ifndef CAPSTONE_X86_REDUCE
+		case X86_VZEROALL:
+		case X86_VZEROUPPER: {
+			/* Only YMM0..7 are accessible outside 64-bit mode. */
+			const size_t bytes = 8 * sizeof(detail->regs_write[0]);
+			memcpy(detail->regs_write, insns[i].regs_mod, bytes);
+			memset(detail->regs_write + 8, 0,
+			       sizeof(insns[i].regs_mod) - bytes);
+			detail->regs_write_count = 8;
+			return;
+		}
+#endif
+		default:
+			break;
+		}
+	}
+	memcpy(detail->regs_write, insns[i].regs_mod,
+	       sizeof(insns[i].regs_mod));
+	detail->regs_write_count = (x86_mapping_counts[i] >> 5) & 31;
+}
 #endif
 
