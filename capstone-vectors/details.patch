diff --git a/arch/X86/X86ImmediateOutput.c b/arch/X86/X86ImmediateOutput.c
index 45de9b87..ddd60ad0 100644
--- a/arch/X86/X86ImmediateOutput.c
+++ b/arch/X86/X86ImmediateOutput.c
@@ -39,10 +39,13 @@ static void writePushImmediate(cs_insn *insn, const uint8_t *code,
 	writeUnsignedImmediate(out,
 			       value < 0 ? (uint64_t)-value : (uint64_t)value);
 	if (insn->detail) {
-		X86_writeSimpleDetail(insn->detail, row, code[0], 0, 0, 0, 0);
+		X86_writeSimpleDetailRegisters(insn->detail, row, code[0], 0,
+					       0, 0, 0, 0);
 		cs_x86_op *op = &insn->detail->x86.operands[0];
 		op->type = X86_OP_IMM;
