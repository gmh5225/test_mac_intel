+static bool check_i386_vex3(csh handles[2])
+{
+	static const uint8_t prefixes[] = { 0x02, 0x42, 0x82, 0xc2, 0xc3,
+					    0xe1, 0xe2, 0xe3, 0xe4 };
+	for (unsigned i = 0; i < sizeof(prefixes); ++i) {
+		for (unsigned op = 0; op < 256; ++op) {
+			for (unsigned value = 0; value < 32; ++value) {
+				const unsigned seed = op + value + prefixes[i];
+				uint8_t bytes[] = {
+					0xc4,
+					prefixes[i],
+					(uint8_t)((value << 3) |
+						  ((op + value) & 7)),
+					(uint8_t)op,
+					(uint8_t)(0xc0 | (seed & 63)),
+					(uint8_t)seed
+				};
+				if (!compare(handles, bytes, sizeof(bytes),
+					     seed) ||
+				    !compare(handles, bytes,
+					     seed % sizeof(bytes), seed))
+					return false;
+			}
+		}
+	}
+	return true;
+}
