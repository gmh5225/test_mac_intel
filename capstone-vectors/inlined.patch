+static bool check_test_immediate(csh handles[2])
+{
+	static const uint8_t prefixes[] = { 0,	  0x40, 0x41, 0x44, 0x48,
+					    0x49, 0x4f, 0x66, 0x67, 0xf0 };
+	static const uint8_t ops[] = { 0xa8, 0xa9, 0xf6, 0xf7 };
+	static const uint32_t immediates[] = { 0,   1,		9,
+					       10,  127,	128,
+					       255, 0x80000000, 0xffffffff };
+	for (unsigned p = 0; p < sizeof(prefixes); ++p) {
+		for (unsigned op = 0; op < sizeof(ops); ++op) {
+			for (unsigned mr = 0; mr < 256; ++mr) {
+				const unsigned h = prefixes[p] != 0;
+				for (unsigned v = 0;
+				     v <
+				     sizeof(immediates) / sizeof(immediates[0]);
+				     ++v) {
+					uint8_t bytes[7] = { prefixes[p],
+							     ops[op],
+							     (uint8_t)mr,
+							     0,
+							     0,
+							     0,
+							     0 };
+					const unsigned offset =
+						(op < 2 ? 1 : 2) + h;
+					uint8_t *input = bytes + !h;
+					for (unsigned j = 0; j < 4; ++j)
+						input[offset + j] =
+							(uint8_t)(immediates[v] >>
+								  (j * 8));
+					const unsigned length = sizeof(bytes) -
+								!h,
+						       seed = p + op + mr + v;
+					if (!compare(handles, input, length,
+						     seed) ||
+					    !compare(handles, input,
+						     seed % length, seed))
+						return false;
+				}
+			}
+		}
+	}
+	return true;
+}
