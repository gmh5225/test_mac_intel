+CheckedRow check_test_immediate(Decoder &decoder, unsigned cls, unsigned opcode,
+				const RegisterTable &regs)
+{
+	CheckedRow row;
+	const bool byte = (opcode & 1) == 0, accumulator = opcode < 0xf0;
+	const unsigned start = cls == 0 ? 0 : cls == 1 ? 0x40 : 0x48;
+	const unsigned imm_size = byte ? 1 : 4;
+	for (unsigned rex = start; rex <= start + (cls ? 7 : 0); ++rex) {
+		for (unsigned rm = 0; rm < (accumulator ? 1u : 8u); ++rm) {
+			const unsigned width = byte	 ? unsigned(rex != 0) :
+					       (rex & 8) ? 3 :
+							   2;
+			const auto &reg =
+				regs[width]
+				    [accumulator ? 0 : rm | ((rex & 1) << 3)];
+			for (uint32_t raw : { 0u, 1u, 9u, 10u, 127u, 128u, 255u,
+					      0x80000000u, 0xffffffffu }) {
+				if (byte)
+					raw &= 255;
+				const uint8_t modrm =
+					accumulator ? 0 : uint8_t(0xc0 | rm);
+				uint8_t bytes[7] = { uint8_t(rex),
+						     uint8_t(opcode),
+						     modrm,
+						     0,
+						     0,
+						     0,
+						     0 };
+				const unsigned offset =
+					(accumulator ? 1 : 2) + (rex != 0);
+				uint8_t *input = bytes + !rex;
+				for (unsigned i = 0; i < imm_size; ++i)
+					input[offset + i] =
+						uint8_t(raw >> (8 * i));
+				const unsigned length = offset + imm_size;
+				decoder.decode(input, length, length, 0);
+				cs_insn projected = *decoder.insn;
+				cs_detail detail = *projected.detail;
+				auto &x = detail.x86;
+				const int64_t immediate =
+					!byte && (rex & 8) ?
+						int64_t(int32_t(raw)) :
+						raw;
+				const uint64_t printed_value = uint64_t(
+					immediate < 0 ? -immediate : immediate);
+				std::ostringstream text;
+				text << reg.name << ", ";
+				if (immediate < 0)
+					text << '-';
+				if (printed_value > HEX_THRESHOLD)
+					text << "0x" << std::hex;
+				text << printed_value;
+				if (projected.id != X86_INS_TEST ||
+				    projected.op_str != text.str() ||
+				    x.op_count != 2 ||
+				    x.operands[0].type != X86_OP_REG ||
+				    x.operands[0].reg != reg.reg ||
+				    x.operands[1].type != X86_OP_IMM ||
+				    x.operands[1].imm != immediate ||
+				    x.encoding.imm_offset != offset ||
+				    x.encoding.imm_size != imm_size)
+					throw std::runtime_error(
+						"unexpected TEST immediate record: " +
+						std::string(projected.op_str) +
+						" expected " + text.str());
+				projected.detail = &detail;
+				projected.op_str[0] = 0;
+				x.operands[0].reg = X86_REG_INVALID;
+				x.operands[1].type = X86_OP_REG;
+				x.operands[1].imm = 0;
+				row.observe(describe(projected, uint8_t(opcode),
+						     uint8_t(rex), modrm,
+						     nullptr, nullptr));
+			}
+		}
+	}
+	return row;
+}
