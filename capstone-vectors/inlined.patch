+/* TEST keeps an unsigned byte or a sign-extended imm32 bit mask. */
+void X86_writeTestImmediate(cs_insn *insn, const struct X86SimpleOutput *row,
+			    const struct X86SimpleRegister *reg,
+			    const uint8_t *code, uint8_t rex,
+			    uint16_t *insn_size)
+{
+	const unsigned opcode = code[rex != 0];
+	const bool byte = (opcode & 1) == 0, accumulator = opcode < 0xf0;
+	const unsigned offset = (accumulator ? 1 : 2) + (rex != 0);
+	const unsigned imm_size = byte ? 1 : 4;
+	const uint32_t raw = byte ? code[offset] :
+				    (uint32_t)X86_readDisp32(code + offset);
+	const int64_t immediate = !byte && (rex & 8) ? (int64_t)(int32_t)raw :
+						       (int64_t)raw;
+	*insn_size = insn->size = (uint16_t)(offset + imm_size);
+	insn->id = row->id;
+	memcpy(insn->bytes, code, insn->size);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, reg->name, sizeof(reg->name));
+	char *out = insn->op_str + reg->length;
+	memcpy(out, ", ", 2);
+	out += 2;
+	if (immediate < 0)
+		*out++ = '-';
+	X86_writeUnsignedImmediate(out, (uint64_t)(immediate < 0 ? -immediate :
+								   immediate));
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, (uint8_t)opcode, rex,
+				      accumulator ? 0 : code[1 + (rex != 0)],
+				      reg->reg, 0);
+		insn->detail->x86.operands[1].type = X86_OP_IMM;
+		insn->detail->x86.operands[1].imm = immediate;
+	}
+}
