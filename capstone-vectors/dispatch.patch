 {
 	std::vector<std::string> records;
@@ -943,6 +1044,7 @@ void emit_output(Decoder &decoder)
 	Decoder padding32(CS_MODE_32);
 	emit_padding_rows(padding32, decoder);
 	emit_legacy_registers(decoder);
+	emit_legacy_shifts(decoder);
 }
 }
 
