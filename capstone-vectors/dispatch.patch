+std::string legacy_move_row(Decoder &decoder, bool wide, unsigned mandatory,
+			    unsigned rex, unsigned opcode, unsigned modrm,
+			    unsigned sib_byte, int32_t displacement)
+{
+	const unsigned mod = modrm >> 6, rm = modrm & 7;
+	const bool sib = rm == 4, rip = !mod && rm == 5;
+	const unsigned disp_size = mod == 2 || rip ? 4 : mod;
+	std::vector<uint8_t> bytes;
+	if (mandatory)
+		bytes.push_back(mandatory == 1 ? 0x66 : 0xf3);
+	if (rex)
+		bytes.push_back(uint8_t(rex));
+	const unsigned escape = unsigned(bytes.size());
+	bytes.insert(bytes.end(), { 0x0f, uint8_t(opcode), uint8_t(modrm) });
+	if (sib)
+		bytes.push_back(uint8_t(sib_byte));
+	const unsigned offset = unsigned(bytes.size());
+	for (unsigned n = 0; n < disp_size; ++n)
+		bytes.push_back(uint8_t(uint32_t(displacement) >> (n * 8)));
+	const unsigned id =
+		decoder.decode(bytes.data(), unsigned(bytes.size()));
+	if (!id)
+		return {};
+	const cs_insn &insn = *decoder.insn;
+	const cs_detail &d = *insn.detail;
+	const cs_x86 &actual = d.x86;
+	if (insn.illegal || insn.is_alias || insn.usesAliasDetails ||
+	    std::strlen(insn.mnemonic) >= 8 || d.regs_read_count ||
+	    d.regs_write_count || d.groups_count > 4 || actual.op_count != 2)
+		return {};
+	const bool load = opcode == 0x10 || opcode == 0x28 || opcode == 0x6f;
+	unsigned base_number = rm | ((rex & 1) << 3);
+	x86_reg base = X86_REG_INVALID, index = X86_REG_INVALID;
+	unsigned scale = 1;
+	const x86_reg regs32[] = { X86_REG_EAX, X86_REG_ECX, X86_REG_EDX,
+				   X86_REG_EBX, X86_REG_ESP, X86_REG_EBP,
+				   X86_REG_ESI, X86_REG_EDI };
+	const x86_reg regs64[] = { X86_REG_RAX, X86_REG_RCX, X86_REG_RDX,
+				   X86_REG_RBX, X86_REG_RSP, X86_REG_RBP,
+				   X86_REG_RSI, X86_REG_RDI, X86_REG_R8,
+				   X86_REG_R9,	X86_REG_R10, X86_REG_R11,
+				   X86_REG_R12, X86_REG_R13, X86_REG_R14,
+				   X86_REG_R15 };
+	if (sib) {
+		base_number = (sib_byte & 7) | ((rex & 1) << 3);
+		const unsigned index_number = ((sib_byte >> 3) & 7) |
+					      ((rex & 2) << 2);
+		if (index_number != 4) {
+			index = wide ? regs64[index_number] :
+				       regs32[index_number];
+			scale = 1u << (sib_byte >> 6);
+		}
+	}
+	base = rip  ? X86_REG_RIP :
+	       wide ? regs64[base_number] :
+		      regs32[base_number];
+	cs_x86 expected{};
+	Bytes4 prefixes{}, groups{}, access{};
+	std::copy_n(actual.prefix, 4, prefixes.begin());
+	std::copy_n(actual.prefix, 4, expected.prefix);
+	std::copy_n(d.groups, d.groups_count, groups.begin());
+	expected.opcode[0] = 0x0f;
+	expected.opcode[1] = uint8_t(opcode);
+	expected.rex = uint8_t(rex);
+	expected.addr_size = wide ? 8 : 4;
+	expected.modrm = uint8_t(modrm);
+	expected.encoding.modrm_offset = uint8_t(escape + 2);
+	expected.op_count = 2;
+	if (disp_size) {
+		expected.encoding.disp_offset = uint8_t(offset);
+		expected.encoding.disp_size = uint8_t(disp_size);
+	}
+	const int32_t disp = disp_size == 1 ? int8_t(displacement) :
+			     disp_size == 4 ? displacement :
+					      0;
+	expected.disp = disp;
+	for (unsigned n = 0; n < 2; ++n) {
+		expected.operands[n].size = 16;
+		expected.operands[n].access = actual.operands[n].access;
+		access[n] = unsigned(actual.operands[n].access);
+	}
+	const unsigned number = ((modrm >> 3) & 7) | ((rex & 4) << 1);
+	auto &reg = expected.operands[load ? 0 : 1];
+	reg.type = X86_OP_REG;
+	reg.reg = x86_reg(X86_REG_XMM0 + number);
+	auto &mem = expected.operands[load ? 1 : 0];
+	mem.type = X86_OP_MEM;
+	mem.mem.base = base;
+	mem.mem.index = index;
+	mem.mem.scale = int(scale);
+	mem.mem.disp = disp;
+	if (sib) {
+		expected.sib = uint8_t(sib_byte);
+		expected.sib_base = base;
+		expected.sib_index = index;
+		expected.sib_scale = int8_t(scale);
+	}
+	std::string address = "xmmword ptr [" +
+			      std::string(cs_reg_name(decoder.handle, base));
+	if (index != X86_REG_INVALID) {
+		address +=
+			" + " + std::string(cs_reg_name(decoder.handle, index));
+		if (scale != 1)
+			address += "*" + std::to_string(scale);
+	}
+	if (disp) {
+		const uint32_t magnitude = disp < 0 ? 0u - uint32_t(disp) :
+						      uint32_t(disp);
+		char number_text[16];
+		if (magnitude <= 9)
+			std::snprintf(number_text, sizeof(number_text), "%u",
+				      magnitude);
+		else
+			std::snprintf(number_text, sizeof(number_text), "0x%x",
+				      magnitude);
