+#if X86_HAS_VEX2_PUBLIC_PLANS && !defined(CAPSTONE_X86_SCAN_ADAPTER)
+static CS_PRESERVE_MOST int
+scanVex32PublicPlan(const uint8_t *code, size_t size, X86ScanResult *result);
+#endif
+
 /* Only generic and extension decoding need an MCInst in the core scan path. */
 #if defined(_MSC_VER)
 __declspec(noinline)
@@ -3367,6 +3372,16 @@ decodeScanResultFallback(csh ud, const uint8_t *code, size_t code_len,
 			return true;
 		}
 	}
+#endif
+#if X86_HAS_VEX2_PUBLIC_PLANS && !defined(CAPSTONE_X86_SCAN_ADAPTER)
+	/* A 32-bit C5 is LDS unless the next two bits are set. Keep this
+	 * additional reader in the existing fallback, outside the iterator. */
+	if (handle->mode == CS_MODE_32 && code_len >= 2 && code[0] == 0xc5 &&
+	    (code[1] & 0xc0) == 0xc0) {
+		const int status = scanVex32PublicPlan(code, code_len, result);
+		if (status != X86_SCAN_NOT_HANDLED)
+			return status == X86_SCAN_COMPLETE;
+	}
 #endif
 	if (tryExtension && (code_len >= 4 && code[0] == 0xc4 &&
 			     !(handle->mode & (CS_MODE_16 | CS_MODE_32)) &&
@@ -3854,6 +3869,68 @@ CAPSTONE_INTERNAL uint16_t X86_scanCallTarget(csh ud, const uint8_t *code,
 	return (uint16_t)insn.length;
 }
 
+#if X86_HAS_VEX2_PUBLIC_PLANS && !defined(CAPSTONE_X86_SCAN_ADAPTER)
+/* Every admitted plan has the same public ID, reserved-vvvv rule and
+ * immediate extent as all of its canonical ModR/M outcomes. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static CS_PRESERVE_MOST int
+scanVex32PublicPlan(const uint8_t *code, size_t size, X86ScanResult *result)
+{
+	if (size < 3)
+		return X86_SCAN_INVALID;
+	const unsigned payload = code[1];
+	unsigned plan = x86Vex2PublicPlans[payload & 7][code[2]];
+#if X86_HAS_VEX2_PUBLIC_GROUPS
+	if (plan & X86_VEX2_PUBLIC_GROUP) {
+		if (size < 4)
+			return X86_SCAN_INVALID;
+		const unsigned modrm = code[3];
+		plan = x86Vex2PublicGroups[plan & (X86_VEX2_PUBLIC_GROUP - 1)]
+					  [((modrm >> 3) & 7) +
+					   (modrm >= 0xc0 ? 8 : 0)];
+	}
+#endif
+	if (!plan)
+		return X86_SCAN_NOT_HANDLED;
+	if ((plan & 2) && vvvvFromVEX2of2(payload))
+		return X86_SCAN_INVALID;
+	unsigned end = 3;
+	if (plan & 4) {
+		if (size < 4)
+			return X86_SCAN_INVALID;
+		const unsigned modrm = code[3];
+		end = 4;
+		if (modrm < 0xc0) {
+			const unsigned mod = modrm >> 6, rm = modrm & 7;
+			static const uint8_t extra[3][8] = {
+				{ 0, 0, 0, 0, 1, 4, 0, 0 },
+				{ 1, 1, 1, 1, 2, 1, 1, 1 },
+				{ 4, 4, 4, 4, 5, 4, 4, 4 }
+			};
+			if ((modrm & 0xc7) == 4) {
+				if (end >= size)
+					return X86_SCAN_INVALID;
+				if ((code[end] & 7) == 5)
+					end += 4;
+			}
+			end += extra[mod][rm];
+		}
+	}
+	end += plan & 1;
+	if (end > size)
+		return X86_SCAN_INVALID;
+	result->opcode = 0;
+	result->opcode_pub = plan >> 3;
+	result->length = (uint16_t)end;
+	result->popcode_adjust = 0;
+	return X86_SCAN_COMPLETE;
+}
+#endif
+
 #undef CS_DECODE_INLINE
 #undef CS_DECODE_LIKELY
 #undef CS_DECODE_UNLIKELY
