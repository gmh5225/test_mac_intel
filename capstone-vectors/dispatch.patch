 }
+// Legacy SSE groups 12-14 select the operation with ModR/M.reg and
+// update the r/m register. Derive all public fields with the full decoder.
+std::string legacy_shift_record(Decoder &decoder, unsigned opcode,
+				unsigned group, unsigned rex, unsigned rm,
+				unsigned value, bool wide)
+{
+	uint8_t bytes[] = { 0x66,
+			    uint8_t(rex),
+			    0x0f,
+			    uint8_t(opcode),
+			    uint8_t(0xc0 | group << 3 | rm),
+			    uint8_t(value) };
+	const unsigned length = rex ? 6 : 5;
+	if (!rex)
+		std::memmove(bytes + 1, bytes + 2, 4);
+	const unsigned id = decoder.decode(bytes, length);
+	if (!id)
+		return {};
+	const auto &insn = *decoder.insn;
+	const auto &d = *insn.detail;
+	if (insn.illegal || insn.is_alias || insn.usesAliasDetails ||
+	    std::strlen(insn.mnemonic) >= 16 || d.regs_read_count ||
+	    d.regs_write_count || d.groups_count > 4)
+		return {};
+	cs_x86 x{};
+	x.prefix[2] = 0x66;
+	x.opcode[0] = 0x0f;
+	x.opcode[1] = uint8_t(opcode);
+	x.rex = uint8_t(rex);
+	x.addr_size = wide ? 8 : 4;
+	x.modrm = bytes[length - 2];
+	x.encoding.modrm_offset = uint8_t(length - 2);
+	x.encoding.imm_offset = uint8_t(length - 1);
+	x.encoding.imm_size = 1;
+	x.op_count = 2;
+	auto &dest = x.operands[0];
+	const unsigned number = rm | ((rex & 1) << 3);
+	dest.type = X86_OP_REG;
+	dest.reg = x86_reg(X86_REG_XMM0 + number);
+	dest.size = 16;
+	dest.access = d.x86.operands[0].access;
+	auto &imm = x.operands[1];
+	imm.type = X86_OP_IMM;
+	imm.imm = value;
+	imm.size = 1;
+	imm.access = d.x86.operands[1].access;
+	char text[64];
+	std::snprintf(text, sizeof(text),
+		      value <= 9 ? "xmm%u, %u" : "xmm%u, 0x%x", number, value);
+	if (std::strcmp(text, insn.op_str) ||
+	    std::memcmp(&x, &d.x86, sizeof(x)))
+		return {};
+	Bytes4 groups{},
+		access{ unsigned(dest.access), unsigned(imm.access), 0, 0 };
+	std::copy_n(d.groups, d.groups_count, groups.begin());
+	return "{ " + decoder.symbol(id) + ", \"" + insn.mnemonic + "\", " +
+	       std::to_string(d.groups_count) + ", " + fields(groups) + ", " +
+	       fields(access) + ", 1 }";
+}
+
+void emit_legacy_shifts(Decoder &decoder)
+{
+	Decoder narrow(CS_MODE_32);
+	unsigned admitted = 0;
+	std::puts(
+		"static const struct VectorOutputRow legacy_shift_rows[3][8] = {");
+	for (unsigned opcode = 0x71; opcode <= 0x73; ++opcode) {
+		std::puts("\t{");
+		for (unsigned group = 0; group < 8; ++group) {
+			const auto row = legacy_shift_record(
+				decoder, opcode, group, 0, 0, 0, true);
+			bool valid = !row.empty();
+			for (unsigned k = 0; valid && k < 256; ++k) {
+				for (unsigned p = 0; valid && p <= 16; ++p)
+					valid = legacy_shift_record(
+							decoder, opcode, group,
+							p ? 0x3f + p : 0, k & 7,
+							k, true) == row;
+				valid = valid &&
+					legacy_shift_record(narrow, opcode,
+							    group, 0, k & 7, k,
+							    false) == row;
+			}
+			if (valid) {
+				++admitted;
+				std::printf("\t\t%s,\n", row.c_str());
+			} else {
+				std::puts("\t\t{ 0 },");
+			}
+		}
+		std::puts("\t},");
+	}
+	std::puts("};");
+	if (admitted != 10)
+		throw std::runtime_error(
+			"missing canonical SSE immediate shift rows");
+	std::fprintf(stderr,
+		     "%u SSE immediate shift rows, %llu 32-bit probes\n",
+		     admitted, static_cast<unsigned long long>(narrow.probes));
+}
+
