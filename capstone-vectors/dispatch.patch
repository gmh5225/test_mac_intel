diff --git a/arch/X86/X86Mapping.c b/arch/X86/X86Mapping.c
index 461ae5e4..b2a73041 100644
--- a/arch/X86/X86Mapping.c
+++ b/arch/X86/X86Mapping.c
@@ -11929,6 +11929,28 @@ void X86_reg_access(const cs_insn *insn, cs_regs regs_read,
 	read_count = insn->detail->regs_read_count;
 	write_count = insn->detail->regs_write_count;
 
+	/* A three-register operation with a write-only destination has at most
+     * two distinct reads. A trailing immediate adds no registers. Preserve the
+     * generic write-before-read order when the output buffers overlap. */
+	const cs_x86_op *ops = x86->operands;
+	if (!read_count && !write_count &&
+	    (x86->op_count == 3 ||
+	     (x86->op_count == 4 && ops[3].type == X86_OP_IMM)) &&
+	    ops[0].type == X86_OP_REG && ops[0].access == CS_AC_WRITE &&
+	    ops[1].type == X86_OP_REG && ops[1].access == CS_AC_READ &&
+	    ops[2].type == X86_OP_REG && ops[2].access == CS_AC_READ) {
+		regs_write[0] = (uint16_t)ops[0].reg;
+		regs_read[0] = (uint16_t)ops[1].reg;
+		read_count = 1;
+		if (regs_read[0] != (unsigned)ops[2].reg) {
+			regs_read[1] = (uint16_t)ops[2].reg;
+			++read_count;
+		}
+		*regs_read_count = read_count;
+		*regs_write_count = 1;
+		return;
+	}
+
 	// implicit registers
 	if (read_count == 1)
 		regs_read[0] = insn->detail->regs_read[0];
