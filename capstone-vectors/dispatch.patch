+static bool check_mov_memory_immediate(csh handles[2], cs_mode mode)
+{
+	static const uint32_t values[] = { 0,	      1,	  9,
+					   10,	      0x7f,	  0x80,
+					   0xff,      0x7fffffff, 0x80000000,
+					   0xffffffff };
+	for (unsigned prefix = 0; prefix <= (mode == CS_MODE_64 ? 16u : 0u);
+	     ++prefix) {
+		for (unsigned opcode = 0xc6; opcode <= 0xc7; ++opcode) {
+			for (unsigned modrm = 0; modrm < 256; ++modrm) {
+				const bool sib = modrm < 0xc0 &&
+						 (modrm & 7) == 4;
+				for (unsigned address = 0;
+				     address < (sib ? 256u : 1u); ++address) {
+					for (unsigned sample = 0;
+					     sample <
+					     sizeof(values) / sizeof(values[0]);
+					     ++sample) {
+						uint8_t bytes[15] = { 0 };
+						unsigned length = 0;
+						if (prefix)
+							bytes[length++] =
+								(uint8_t)(0x3f +
+									  prefix);
+						bytes[length++] =
+							(uint8_t)opcode;
+						bytes[length++] =
+							(uint8_t)modrm;
+						if (sib)
+							bytes[length++] =
+								(uint8_t)address;
+						const unsigned mod = modrm >> 6;
+						const bool disp32 =
+							mod == 2 ||
+							(!mod &&
+							 ((modrm & 7) == 5 ||
+							  (sib && (address &
+								   7) == 5)));
+						const unsigned disp_size =
+							disp32	 ? 4 :
+							mod == 1 ? 1 :
+								   0;
+						const uint32_t displacement = values
+							[(sample + address) %
+							 (sizeof(values) /
+							  sizeof(values[0]))];
+						for (unsigned j = 0;
+						     j < disp_size; ++j)
+							bytes[length++] =
+								(uint8_t)(displacement >>
+									  (j *
+									   8));
+						const unsigned imm_size =
+							opcode == 0xc6 ? 1 : 4;
+						for (unsigned j = 0;
+						     j < imm_size; ++j)
+							bytes[length++] =
+								(uint8_t)(values[sample] >>
+									  (j *
+									   8));
+						const unsigned seed = sample +
+								      modrm +
+								      address;
+						if (!compare(handles, bytes,
+							     length, seed) ||
+						    !compare(handles, bytes,
+							     seed % length,
+							     seed))
+							return false;
+					}
+				}
+			}
+		}
+	}
+	return true;
+}
