+// Keep only the live entries in generated source. C initializes all spare slots.
+template <typename T>
+void emit_live(std::ostream &out, const T *values, unsigned count)
+{
+	out << "{ ";
+	if (!count)
+		out << '0';
+	for (unsigned i = 0; i < count; ++i)
+		out << (i ? ", " : "") << unsigned(values[i]);
+	out << " }";
+}
+
+std::vector<std::string> effect_rows;
+uint8_t intern_effects(const X86ImplicitEffects &effects)
+{
+	std::ostringstream out;
+	out << "{ ";
+	emit_live(out, effects.reads, effects.read_count);
+	out << ", " << unsigned(effects.read_count) << ", ";
+	emit_live(out, effects.writes, effects.write_count);
+	out << ", " << unsigned(effects.write_count) << ", ";
+	emit_live(out, effects.groups, effects.group_count);
+	out << ", " << unsigned(effects.group_count) << " }";
+	const auto spelling = out.str();
+	const auto existing =
+		std::find(effect_rows.begin(), effect_rows.end(), spelling);
+	if (existing != effect_rows.end())
+		return static_cast<uint8_t>(existing - effect_rows.begin());
+	if (effect_rows.size() > UINT8_MAX)
+		throw std::runtime_error(
+			"too many implicit register and group records");
+	effect_rows.push_back(spelling);
+	return static_cast<uint8_t>(effect_rows.size() - 1);
+}
