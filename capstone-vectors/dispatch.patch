+// These unprefixed 0F register forms use a dword destination and either
+// the original byte register or a dword source. Check all ModR/M pairs.
+CheckedRow check_escaped_pair(Decoder &decoder, unsigned opcode,
+			      const RegisterTable &regs)
+{
+	CheckedRow row;
+	for (unsigned mr = 0xc0; mr <= 0xff; ++mr) {
+		uint8_t bytes[] = { 0x0f, uint8_t(opcode), uint8_t(mr) };
+		decoder.decode(bytes, sizeof(bytes), sizeof(bytes),
+			       UINT64_MAX - 1);
+		const auto &dst = regs[2][(mr >> 3) & 7];
+		const auto &src =
+			regs[opcode == 0xb6 || opcode == 0xbe ? 0 : 2][mr & 7];
+		row.observe(describe(*decoder.insn, opcode, 0, mr, &dst, &src));
+	}
+	return row;
+}
