+static bool check_escaped_pairs(csh handles[2], cs_mode mode)
+{
+	const unsigned prefixes = mode == CS_MODE_64 ? 17 : 1;
+	for (unsigned p = 0; p < prefixes; ++p) {
+		for (unsigned n = 0; n < 19; ++n) {
+			unsigned op = n < 16  ? 0x40 + n :
+				      n == 16 ? 0xaf :
+				      n == 17 ? 0xb6 :
+						0xbe;
+			for (unsigned mr = 0; mr <= 0xff; ++mr) {
+				uint8_t bytes[] = { (uint8_t)(0x3f + p),
+						    0x0f,
+						    (uint8_t)op,
+						    (uint8_t)mr,
+						    (uint8_t)(mr + n),
+						    0xff,
+						    0,
+						    0x80,
+						    0x7f };
+				if (!compare(handles, bytes + !p,
+					     sizeof(bytes) - !p, mr) ||
+				    !compare(handles, bytes + !p,
+					     (p + n + mr) % (5 - !p), n))
+					return false;
+			}
+		}
+	}
+	return true;
+}
