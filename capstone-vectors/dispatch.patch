 		      uint16_t *insn_size, const struct X86SimpleRegister *regs,
 		      bool wide);
 
+/* The formatted writers provide space for at least eighteen characters. */
+static inline char *X86_writeOutputNumber(char *out, uint64_t value)
+{
+	if (value <= HEX_THRESHOLD) {
+		*out++ = (char)('0' + value);
+		return out;
+	}
+	memcpy(out, "0x", 2);
+	const unsigned digit_count = (67u - CountLeadingZeros_64(value)) / 4u;
+	char *end = out + 2 + digit_count;
+	char *cursor = end;
+	do {
+		*--cursor = "0123456789abcdef"[value & 15];
+		value >>= 4;
+	} while (value);
+	return end;
+}
