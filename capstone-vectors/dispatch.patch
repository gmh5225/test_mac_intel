+/* Packed SSE moves share one address parse between assembly and detail. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static bool writeLegacyMoveOutput(const uint8_t *code, size_t size,
+				  cs_insn *insn, uint16_t *insn_size,
+				  const struct X86SimpleRegister *regs,
+				  bool wide)
+{
+	const unsigned mandatory = code[0] == 0x66 ? 1 :
+				   code[0] == 0xf3 ? 2 :
+						     0;
+	const unsigned lead = mandatory != 0;
+	if (size <= lead)
+		return false;
+	const uint8_t rex = wide && (code[lead] & 0xf0) == 0x40 ? code[lead] :
+								  0;
+	const unsigned escape = lead + (rex != 0);
+	if (size < escape + 3 || code[escape] != 0x0f)
+		return false;
+	const uint8_t opcode = code[escape + 1], modrm = code[escape + 2];
+	unsigned slot;
+	if ((opcode & 0xfe) == 0x10)
+		slot = opcode & 1;
+	else if ((opcode & 0xfe) == 0x28)
+		slot = 2 + (opcode & 1);
+	else if (opcode == 0x6f || opcode == 0x7f)
+		slot = 4 + (opcode == 0x7f);
+	else
+		return false;
+	const struct LegacyMoveOutputRow *row =
+		&legacy_move_rows[mandatory][slot];
+	const unsigned mod = modrm >> 6, rm = modrm & 7;
+	if (!row->id || mod == 3)
+		return false;
+	const bool sib = rm == 4, rip = !mod && rm == 5;
+	const unsigned offset = escape + 3 + sib;
+	const unsigned disp_size = mod == 2 || rip ? 4 : mod;
+	const unsigned length = offset + disp_size;
+	if (size < length || (rip && !wide))
+		return false;
+	unsigned base_reg = rm, scale = 0;
+	const struct X86SimpleRegister *index = NULL;
+	if (sib) {
+		const uint8_t encoding = code[offset - 1];
+		const unsigned index_reg = ((rex & 2) << 2) |
+					   ((encoding >> 3) & 7);
+		base_reg = encoding & 7;
+		if ((!mod && base_reg == 5) ||
+		    (index_reg == 4 && encoding != 0x24))
+			return false;
+		if (index_reg != 4) {
+			index = &regs[index_reg];
+			scale = encoding >> 6;
+		}
+	}
+	const struct X86SimpleRegister *base =
+		&regs[((rex & 1) << 3) | base_reg];
+	const unsigned number = ((modrm >> 3) & 7) | ((rex & 4) << 1);
+	const bool load = !(slot & 1);
+	const int32_t displacement =
+		disp_size == 1 ? (int8_t)code[offset] :
+		disp_size == 4 ? X86_readDisp32(code + offset) :
+				 0;
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)length;
+	memcpy(insn->bytes, code, length);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = insn->op_str;
+	if (load) {
+		out = writeVectorRegister(out, 0, number);
+		memcpy(out, ", ", 2);
+		out += 2;
+	}
+	memcpy(out, "xmmword ptr [", 13);
+	out += 13;
+	if (rip) {
+		memcpy(out, "rip", 3);
+		out += 3;
+	} else {
+		memcpy(out, base->name, sizeof(base->name));
+		out += base->length;
+	}
+	if (index) {
+		memcpy(out, " + ", 3);
+		out += 3;
+		memcpy(out, index->name, sizeof(index->name));
+		out += index->length;
+		if (scale) {
+			*out++ = '*';
+			*out++ = (char)('0' + (1u << scale));
+		}
+	}
+	out = X86_writeDisplacement(out, displacement);
+	*out++ = ']';
+	if (!load) {
+		memcpy(out, ", ", 2);
+		writeVectorRegister(out + 2, 0, number);
+	}
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		d->groups_count = row->group_count;
+		memcpy(d->groups, row->groups, sizeof(row->groups));
+		cs_x86 *x = &d->x86;
+		memcpy(x->prefix, row->prefix, sizeof(row->prefix));
+		x->opcode[0] = 0x0f;
+		x->opcode[1] = opcode;
+		x->rex = rex;
+		x->addr_size = wide ? 8 : 4;
+		x->modrm = modrm;
+		x->encoding.modrm_offset = (uint8_t)(escape + 2);
+		if (disp_size) {
+			x->encoding.disp_offset = (uint8_t)offset;
+			x->encoding.disp_size = (uint8_t)disp_size;
+		}
+		x->disp = displacement;
+		x->op_count = 2;
+		for (unsigned i = 0; i < 2; ++i) {
+			x->operands[i].size = 16;
+			x->operands[i].access = (cs_ac_type)row->access[i];
+		}
+		cs_x86_op *reg = &x->operands[load ? 0 : 1];
+		reg->type = X86_OP_REG;
+		reg->reg = (x86_reg)(X86_REG_XMM0 + number);
+		cs_x86_op *mem = &x->operands[load ? 1 : 0];
+		mem->type = X86_OP_MEM;
+		mem->mem.base = rip ? X86_REG_RIP : (x86_reg)base->reg;
+		mem->mem.scale = 1 << scale;
+		if (index)
+			mem->mem.index = (x86_reg)index->reg;
+		mem->mem.disp = displacement;
+		if (sib) {
+			x->sib = code[offset - 1];
+			x->sib_base = mem->mem.base;
+			x->sib_scale = (int8_t)mem->mem.scale;
+			x->sib_index = mem->mem.index;
+		}
+	}
+	return true;
+}
