+// The MOV pair supplies the write access and public operand widths.
+// Check the immediate projection before reusing that generated row.
+unsigned check_memory_immediate(Decoder &decoder, bool wide, unsigned cls,
+				unsigned opcode, const RegisterTable &regs)
+{
+	const unsigned start = !cls ? 0 : cls == 1 ? 0x40 : 0x48;
+	const unsigned pair = opcode == 0xc6 ? 0x88 : 0x89;
+	unsigned checked = 0;
+	for (unsigned rex = start; rex <= start + (cls ? 7 : 0); ++rex) {
+		decode_pair(decoder, rex, pair, 0xc1);
+		const cs_detail pair_detail = *decoder.insn->detail;
+		const unsigned pair_id = decoder.insn->id;
+		const std::string mnemonic = decoder.insn->mnemonic;
+		for (unsigned mod = 0; mod < 3; ++mod) {
+			for (unsigned rm = 0; rm < 8; ++rm) {
+				if (rm == 4 || (!mod && rm == 5 && !wide))
+					continue;
+				const bool rip = !mod && rm == 5;
+				const unsigned disp_size =
+					mod == 2 || rip ? 4 : mod;
+				const unsigned imm_size = opcode == 0xc6 ? 1 :
+									   4;
+				for (uint32_t bits :
+				     { 0u, 1u, 9u, 10u, 0x7fu, 0x80u, 0xffu,
+				       0x7fffffffu, 0x80000000u,
+				       0xffffffffu }) {
+					const int32_t disp =
+						disp_size == 1 ? -128 :
+						disp_size == 4 ? INT32_MIN :
+								 0;
+					const unsigned modrm = (mod << 6) | rm;
+					std::vector<uint8_t> bytes;
+					if (rex)
+						bytes.push_back(uint8_t(rex));
+					bytes.push_back(uint8_t(opcode));
+					bytes.push_back(uint8_t(modrm));
+					const unsigned disp_offset =
+						bytes.size();
+					for (unsigned i = 0; i < disp_size; ++i)
+						bytes.push_back(uint8_t(
+							uint32_t(disp) >>
+							(8 * i)));
+					const unsigned imm_offset =
+						bytes.size();
+					for (unsigned i = 0; i < imm_size; ++i)
+						bytes.push_back(uint8_t(
+							bits >> (8 * i)));
+					decoder.decode(bytes.data(),
+						       bytes.size(),
+						       bytes.size(),
+						       UINT64_MAX - 1);
+
+					const int64_t value =
+						imm_size == 1 ?
+							int64_t(uint8_t(bits)) :
+						rex & 8 ?
+							int64_t(int32_t(bits)) :
+							int64_t(bits);
+					cs_detail expected = pair_detail;
+					auto &x = expected.x86;
+					x.opcode[0] = uint8_t(opcode);
+					x.modrm = uint8_t(modrm);
+					x.disp = disp;
+					x.encoding.disp_offset =
+						disp_size ? disp_offset : 0;
+					x.encoding.disp_size = disp_size;
+					x.encoding.imm_offset = imm_offset;
+					x.encoding.imm_size = imm_size;
+					auto &mem = x.operands[0];
+					mem.type = X86_OP_MEM;
+					mem.mem = {};
+					mem.mem.base =
+						rip ? X86_REG_RIP :
+						      x86_reg(regs[wide ? 3 : 2]
+								  [rm |
+								   ((rex & 1)
+								    << 3)]
+									  .reg);
+					mem.mem.scale = 1;
+					mem.mem.disp = disp;
+					auto &imm = x.operands[1];
+					imm.type = X86_OP_IMM;
+					imm.imm = value;
+					imm.access = CS_AC_INVALID;
+					std::ostringstream text;
+					text << (mem.size == 1 ? "byte" :
+						 mem.size == 8 ? "qword" :
+								 "dword")
+					     << " ptr ["
+					     << (rip ? "rip" :
+						       regs[wide ? 3 : 2]
+							   [rm |
+							    ((rex & 1) << 3)]
+								   .name);
+					if (disp)
+						text << " - 0x" << std::hex
+						     << (uint32_t(0) -
+							 uint32_t(disp));
+					text << "], ";
+					if (uint64_t(value) > HEX_THRESHOLD)
+						text << "0x" << std::hex;
+					else
+						text << std::dec;
+					text << uint64_t(value);
+					if (decoder.insn->id != pair_id ||
+					    decoder.insn->mnemonic !=
+						    mnemonic ||
+					    decoder.insn->op_str !=
+						    text.str() ||
+					    memcmp(&expected,
+						   decoder.insn->detail,
+						   offsetof(cs_detail, x86) +
+							   sizeof(cs_x86))) {
+						std::cerr
+							<< "MOV memory immediate mismatch "
+							<< decoder.insn->op_str
+							<< " expected "
+							<< text.str() << '\n';
+						throw std::runtime_error(
+							"inconsistent MOV memory immediate row");
+					}
+					++checked;
+				}
+			}
+		}
+	}
+	return checked;
+}
