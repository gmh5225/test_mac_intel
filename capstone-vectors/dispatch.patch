+// Match ordinary NDS register operands against the complete canonical record.
+// Opcodes with aliases, exceptional register sizes or immediate-dependent text
+// keep using the general decoder.
+std::string vex_register_row(Decoder &decoder, unsigned map, unsigned opcode,
+			     unsigned w, unsigned ll, unsigned rxb,
+			     unsigned dst, unsigned src, unsigned rm,
+			     bool short_prefix, bool immediate, unsigned value,
+			     bool group_shift = false, bool wide = true)
+{
+	const unsigned prefix = short_prefix ? 2 : 3;
+	uint8_t bytes[6] = {};
+	bytes[0] = short_prefix ? 0xc5 : 0xc4;
+	bytes[1] = uint8_t((~rxb & 7) << 5 | map);
+	bytes[prefix - 1] = uint8_t((short_prefix ? (~rxb & 4) << 5 : w << 7) |
+				    (~src & 15) << 3 | ll << 2 | 1);
+	bytes[prefix] = uint8_t(opcode);
+	bytes[prefix + 1] = uint8_t(0xc0 | dst << 3 | rm);
+	bytes[prefix + 2] = uint8_t(value);
+	const unsigned numbers[] = { group_shift ? src : dst | ((rxb & 4) << 1),
+				     group_shift ? rm | ((rxb & 1) << 3) : src,
+				     rm | ((rxb & 1) << 3) };
+	return checked_vex_registers(decoder, bytes, prefix, wide,
+				     (w << 3) | rxb, ll, numbers,
+				     group_shift ? 2 : 3, immediate);
+}
+
+// Both directions of the VEX2 packed move use the same two public operands.
+// Check every encodable register pair, width and bitness before sharing a row.
+void emit_vex2_moves(Decoder &wide, Decoder &narrow)
+{
+	std::puts("static const struct VectorOutputRow vex2_move_rows[2] = {");
+	for (unsigned pp : { 1u, 2u }) {
+		std::string row;
+		for (unsigned opcode : { 0x6fu, 0x7fu }) {
+			for (bool long_mode : { false, true }) {
+				auto &decoder = long_mode ? wide : narrow;
+				for (unsigned ll : { 0u, 1u }) {
+					for (unsigned pair = 0;
+					     pair < (long_mode ? 128u : 64u);
+					     ++pair) {
+						const unsigned reg = pair >> 3,
+							       rm = pair & 7;
+						const uint8_t bytes[] = {
+							0xc5,
+							uint8_t((reg < 8 ?
+									 0xf8 :
+									 0x78) |
+								ll << 2 | pp),
+							uint8_t(opcode),
+							uint8_t(0xc0 |
+								((reg & 7)
+								 << 3) |
+								rm)
+						};
+						const unsigned operands[] = {
+							opcode == 0x6f ? reg :
+									 rm,
+							opcode == 0x6f ? rm :
+									 reg
+						};
+						const auto value =
+							checked_vex_registers(
+								decoder, bytes,
+								2, long_mode,
+								reg < 8 ? 0 : 4,
+								ll, operands, 2,
+								false);
+						if (value.empty() ||
+						    (!row.empty() &&
+						     row != value))
+							throw std::runtime_error(
+								"inconsistent VEX2 packed move register operands");
+						row = value;
+					}
+				}
+			}
+		}
+		std::printf("\t%s,\n", row.c_str());
+	}
+	std::puts("};");
+}
