diff --git a/arch/ARM/ARMMapping.c b/arch/ARM/ARMMapping.c
index 11e5e995..844ba11a 100644
--- a/arch/ARM/ARMMapping.c
+++ b/arch/ARM/ARMMapping.c
@@ -832,6 +832,11 @@ void ARM_check_updates_flags(MCInst *MI)
 #endif // CAPSTONE_DIET
 }
 
+#if defined(CAPSTONE_ARM_AARCH64_MIPS_X86) && defined(__linux__) && \
+	defined(__x86_64__) && defined(__GNUC__) && !defined(__clang__)
+#define ARM_GNU_MIXED_SCAN
+#endif
+
 void ARM_set_instr_map_data(MCInst *MI)
 {
 	/* The ARM decoder indexes this same generated map for implicit effects. */
@@ -848,6 +853,24 @@ bool ARM_getInstruction(csh handle, const uint8_t *code, size_t code_len,
 			MCInst *instr, uint16_t *size, uint64_t address,
 			void *info)
 {
+#ifdef ARM_GNU_MIXED_SCAN
+	/* Every displacement is valid for these A32 immediate branches. */
+	if (instr->csh->no_text && !instr->flat_insn->detail &&
+	    instr->csh->mode == CS_MODE_ARM &&
+	    instr->csh->disasm == ARM_getInstruction && code_len >= 4 &&
+	    (code[3] & 0x0e) == 0x0a) {
+		unsigned cond = code[3] >> 4;
+		unsigned opcode = ARM_Bcc;
+		if (cond == 15)
+			opcode = ARM_BLXi;
+		else if (code[3] & 1)
+			opcode = cond == 14 ? ARM_BL : ARM_BL_pred;
+		MCInst_setOpcode(instr, opcode);
+		ARM_set_instr_map_data(instr);
+		*size = 4;
+		return true;
+	}
+#endif
 	ARM_init_cs_detail(instr);
 	DecodeStatus Result = ARM_LLVM_getInstruction(
 		handle, code, code_len, instr, size, address, info);
@@ -941,7 +964,7 @@ void ARM_reg_access(const cs_insn *insn, cs_regs regs_read,
 }
 #endif
 
