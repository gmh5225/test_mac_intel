+/* Generated mnemonics contain their own zero padding. Only the remaining
+ * bytes of the public field need clearing when an iterator record is reused. */
+static inline void X86_writeOutputMnemonic(cs_insn *insn, const char *name,
+					   size_t extent)
+{
+	memcpy(insn->mnemonic, name, extent);
+	memset(insn->mnemonic + extent, 0, sizeof(insn->mnemonic) - extent);
+}
