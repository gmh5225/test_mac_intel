@@ -891,6 +891,30 @@ void emit_vex_registers(Decoder &decoder)
 	std::fprintf(stderr, "%zu VEX register rows, %zu opcode plans\n",
 		     rows.size(), widths.size() - 1);
 }
+void emit_immediate_suffixes(Decoder &decoder)
+{
+	std::puts("static const char vector_immediate_suffix[256][8] = {");
+	for (unsigned value = 0; value <= 255; ++value) {
+		const uint8_t bytes[] = { 0x62, 0xf3, 0x7d,	     0x48,
+					  0x25, 0xc1, uint8_t(value) };
+		if (decoder.decode(bytes, sizeof(bytes)) != X86_INS_VPTERNLOGD)
+			throw std::runtime_error(
+				"unexpected ternary logic encoding");
+		const char *suffix = std::strrchr(decoder.insn->op_str, ',');
+		constexpr char prefix[] = "zmm0, zmm0, zmm1";
+		if (!suffix ||
+		    suffix != decoder.insn->op_str + sizeof(prefix) - 1 ||
+		    std::strncmp(decoder.insn->op_str, prefix,
+				 sizeof(prefix) - 1) ||
+		    std::strlen(suffix) >= 8 ||
+		    decoder.insn->detail->x86.operands[3].imm != value)
+			throw std::runtime_error(
+				"unexpected vector immediate suffix");
+		std::printf("\t\"%s\",\n", suffix);
+	}
+	std::puts("};");
+}
+
 void emit_output(Decoder &decoder)
 {
 	std::vector<std::string> records;
@@ -951,6 +975,7 @@ int main()
 	Decoder decoder;
 	std::puts("/* Generated by suite/synctools/x86_vector_output.cpp. */");
 	emit_output(decoder);
+	emit_immediate_suffixes(decoder);
 	std::fprintf(stderr, "%llu ordinary decoder probes\n",
 		     static_cast<unsigned long long>(decoder.probes));
 }
