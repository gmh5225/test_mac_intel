diff --git a/tests/unit/mips_register_names.c b/tests/unit/mips_register_names.c
new file mode 100644
index 00000000..0d4a775a
--- /dev/null
+++ b/tests/unit/mips_register_names.c
@@ -0,0 +1,36 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include <capstone/capstone.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../arch/Mips/MipsGenShortRegisterNames.inc"
+
+int main(void)
+{
+	csh handle;
+	if (cs_open(CS_ARCH_MIPS, CS_MODE_MIPS32R2, &handle))
+		return 1;
+	for (unsigned numeric = 0; numeric < 2; ++numeric) {
+		if (cs_option(handle, CS_OPT_SYNTAX,
+			      numeric ? CS_OPT_SYNTAX_NOREGNAME :
+					CS_OPT_SYNTAX_DEFAULT))
+			return 2;
+		for (unsigned reg = 1; reg < MIPS_REG_ENDING; ++reg) {
+			const char *name = cs_reg_name(handle, reg);
+			const unsigned length =
+				(mips_short_lengths[reg - 1] >> (numeric * 4)) &
+				15;
+			const size_t actual = name ? strlen(name) : 0;
+			if (!name ||
+			    length != (actual && actual < 8 ? actual : 0)) {
+				fprintf(stderr,
+					"MIPS register name %u, numeric %u\n",
+					reg, numeric);
+				return 3;
+			}
+		}
+	}
+	cs_close(&handle);
+	return 0;
+}
