diff --git a/suite/synctools/mips_register_append.py b/suite/synctools/mips_register_append.py
new file mode 100644
index 00000000..5c3ec1dc
--- /dev/null
+++ b/suite/synctools/mips_register_append.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Preserve the MIPS short register append after translating its printer."""
+import argparse
+from pathlib import Path
+
+ORIGINAL = r"""static void printRegName(MCInst *MI, SStream *OS, MCRegister Reg)
+{
+	int syntax_opt = MI->csh->syntax;
+	if (!(syntax_opt & CS_OPT_SYNTAX_NO_DOLLAR)) {
+		SStream_concat1(OS, '$');
+	}
+	SStream_concat0(OS, Mips_LLVM_getRegisterName(
+				    Reg, syntax_opt & CS_OPT_SYNTAX_NOREGNAME));
+}
+"""
+REPLACEMENT = r"""#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static void printRegName(MCInst *MI, SStream *OS, MCRegister Reg)
+{
+	int syntax_opt = MI->csh->syntax;
+	const char *name = Mips_LLVM_getRegisterName(
+		Reg, syntax_opt & CS_OPT_SYNTAX_NOREGNAME);
+#ifndef CAPSTONE_DIET
+	if (name && !OS->is_closed && !OS->markup_stream &&
+	    !OS->prefixed_by_markup) {
+		unsigned length = 0;
+		while (length < 4 && name[length])
+			++length;
+		const unsigned prefix = !(syntax_opt & CS_OPT_SYNTAX_NO_DOLLAR);
+		if (length && !name[length] &&
+		    OS->index < SSTREAM_BUF_LEN - length - prefix) {
+			char *out = OS->buffer + OS->index;
+			if (prefix)
+				*out++ = '$';
+			if (length >= 3) {
+				memcpy(out, name, 4);
+				memcpy(out + length - 3, name + length - 3, 4);
+			} else {
+				memcpy(out, name, 2);
+				memcpy(out + length - 1, name + length - 1, 2);
+			}
+			OS->index += length + prefix;
+			return;
+		}
+	}
+#endif
+	if (!(syntax_opt & CS_OPT_SYNTAX_NO_DOLLAR))
+		SStream_concat1(OS, '$');
+	SStream_concat0(OS, name);
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    target = Path(__file__).resolve().parents[2] / "arch/Mips/MipsInstPrinter.c"
+    source = target.read_text().replace(REPLACEMENT, ORIGINAL)
+    if source.count(ORIGINAL) != 1:
+        raise ValueError("The MIPS register printer has changed")
+    result = source.replace(ORIGINAL, REPLACEMENT)
+    if args.check:
+        if target.read_text() != result:
+            raise SystemExit("Regenerate " + target.name)
+    else:
+        target.write_text(result)
+
+
+if __name__ == "__main__":
+    main()
