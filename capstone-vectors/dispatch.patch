+CheckedRow check_setcc(Decoder &decoder, unsigned opcode,
+		       const RegisterTable &regs)
+{
+	CheckedRow row;
+	for (unsigned mr = 0xc0; mr <= 0xff; ++mr) {
+		const uint8_t bytes[] = { 0x0f, uint8_t(opcode), uint8_t(mr) };
+		decoder.decode(bytes, sizeof(bytes), sizeof(bytes),
+			       UINT64_MAX - mr);
+		const auto &insn = *decoder.insn;
+		cs_detail detail = *insn.detail;
+		auto &x = detail.x86;
+		const auto &reg = regs[0][mr & 7];
+		if (x.op_count != 1 || x.operands[0].type != X86_OP_REG ||
+		    unsigned(x.operands[0].reg) != reg.reg ||
+		    strcmp(insn.op_str, reg.name) || x.opcode[0] != 0x0f ||
+		    x.opcode[1] != opcode)
+			throw std::runtime_error(
+				"unexpected byte condition register");
+		// Project the varying register and the shared escape before the
+		// full-byte detail comparison in describe().
+		cs_insn projected = insn;
+		projected.detail = &detail;
+		projected.op_str[0] = '\0';
+		x.operands[0].reg = X86_REG_INVALID;
+		x.opcode[1] = 0;
+		row.observe(describe(projected, 0x0f, 0, uint8_t(mr), nullptr,
+				     nullptr));
+	}
+	return row;
+}
