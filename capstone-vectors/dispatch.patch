+/* Formatting and scan use the same admitted EVEX register forms. */
+static const struct VectorOutputRow *evexRegisterOutputRow(const uint8_t *code,
+							   size_t size)
+{
+	if (size < 6 || code[5] < 0xc0 || (code[2] & 7) != 5 ||
+	    (code[3] & 0x97) || (code[3] & 0x60) == 0x60)
+		return NULL;
+	const unsigned key = ((code[1] & 15) << 8) | code[4];
+	const struct VectorOutputRow *row =
+		evexOutputRow(key, code[2] >> 7, code[3] >> 5);
+	if (!row || (row->immediate && size < 7))
+		return NULL;
+	if ((key & ~0x22u) == 0x319 &&
+	    ((code[2] & 0x78) != 0x78 || !(code[3] & 8)))
+		return NULL;
+	return row;
+}
+
+bool X86_scanEvexRegisterOutput(const uint8_t *code, size_t size,
+				X86ScanResult *result)
+{
+	if (!size || code[0] != 0x62)
+		return false;
+	const struct VectorOutputRow *row = evexRegisterOutputRow(code, size);
+	if (!row)
+		return false;
+	result->opcode = 0;
+	result->opcode_pub = row->id;
+	result->length = (uint16_t)(6 + row->immediate);
+	result->popcode_adjust = 0;
+	return true;
+}
