+/* Compare VEX2 registers, truncated prefixes and the overlapping LDS encoding. */
+static bool check_i386_vex2(csh handles[2])
+{
+	for (unsigned p = 0; p < 256; ++p) {
+		for (unsigned op = 0; op < 256; ++op) {
+			for (unsigned n = 0; n < 8; ++n) {
+				const unsigned seed = p + op + n;
+				uint8_t bytes[] = {
+					0xc5, (uint8_t)p, (uint8_t)op,
+					(uint8_t)(0xc0 | (n << 3) | (seed & 7)),
+					(uint8_t)seed
+				};
+				if (!compare(handles, bytes, sizeof(bytes),
+					     seed) ||
+				    !compare(handles, bytes,
+					     seed % sizeof(bytes), seed))
+					return false;
+			}
+		}
+	}
+	return true;
+}
