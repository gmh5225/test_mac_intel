+static bool check_legacy_shifts(csh handles[2], cs_mode mode)
+{
+	for (unsigned p = 0; p <= (mode == CS_MODE_64 ? 16u : 0u); ++p)
+		for (unsigned opcode = 0x71; opcode <= 0x73; ++opcode)
+			for (unsigned mr = 0; mr < 256; ++mr)
+				for (unsigned i = 0; i < 8; ++i) {
+					static const uint8_t values[] = {
+						0, 1, 9, 10, 15, 16, 128, 255
+					};
+					uint8_t bytes[] = { 0x66,
+							    (uint8_t)(p + 0x3f),
+							    0x0f,
+							    (uint8_t)opcode,
+							    (uint8_t)mr,
+							    values[i] };
+					const unsigned length = p ? 6 : 5;
+					if (!p)
+						memmove(bytes + 1, bytes + 2,
+							4);
+					if (!compare(handles, bytes, length,
+						     mr ^ values[i]) ||
+					    !compare(handles, bytes, length - 1,
+						     mr ^ values[i]))
+						return false;
+				}
+	return true;
+}
