+		x->disp = disp;
+		if (mod) {
+			x->encoding.disp_size = (uint8_t)disp_bytes;
+			x->encoding.disp_offset = 4;
+		}
+		x->op_count = 2;
+		cs_x86_op *reg = &x->operands[store],
+			  *mem = &x->operands[!store];
+		reg->type = X86_OP_REG;
+		reg->size = (uint8_t)(16 << ll);
+		reg->reg =
+			(x86_reg)((ll ? X86_REG_YMM0 : X86_REG_XMM0) + number);
+		reg->access = (cs_ac_type)row->access[store];
+		mem->type = X86_OP_MEM;
+		mem->size = reg->size;
+		mem->mem.base = (x86_reg)base->reg;
+		mem->mem.scale = 1;
+		mem->mem.disp = disp;
+		mem->access = (cs_ac_type)row->access[!store];
+	}
