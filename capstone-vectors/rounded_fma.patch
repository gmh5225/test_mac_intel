+static bool check_rounded_fma(csh handles[2])
+{
+	/* Include neighbouring scalar, masked, memory and truncated forms. */
+	for (unsigned op = 0x97; op <= 0xbf; ++op) {
+		for (unsigned rc = 0; rc < 4; ++rc) {
+			for (unsigned ext = 0; ext < 32; ++ext) {
+				for (unsigned tail = 0; tail < 8; ++tail) {
+					uint8_t code[] = {
+						0x62,
+						(uint8_t)((ext << 4) | 2),
+						(uint8_t)(((ext ^ tail) << 3) |
+							  5),
+						(uint8_t)(0x10 | (rc << 5) |
+							  ((ext >> 1) & 8)),
+						(uint8_t)op,
+						(uint8_t)(0xc0 | (tail << 3) |
+							  (ext & 7)),
+					};
+					for (unsigned kind = 0; kind < 5;
+					     ++kind) {
+						if (!compare(
+							    handles, code,
+							    kind == 0 ?
+								    5 :
+								    sizeof(code),
+							    ext + rc + op))
+							return false;
+						if (kind == 1)
+							code[3] |= 1;
+						if (kind == 2)
+							code[3] |= 0x80;
+						if (kind == 3)
+							code[5] &= 0x3f;
+					}
+				}
+			}
+		}
+	}
+	return true;
+}
