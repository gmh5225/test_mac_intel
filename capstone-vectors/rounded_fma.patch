+static inline void evexVectorRegisters(const uint8_t *code, unsigned rxb,
+				       unsigned regs[3])
+{
+	regs[0] = ((code[5] >> 3) & 7) | ((rxb & 4) << 1) |
+		  (~(unsigned)code[1] & 16);
+	regs[1] = ((~(unsigned)code[2] >> 3) & 15) |
+		  ((~(unsigned)code[3] & 8) << 1);
+	regs[2] = (code[5] & 7) | ((rxb & 3) << 3);
+}
