+// On register-only packed FMA, EVEX.b selects static rounding and L'L
+// selects RC. Verify all four renderings and the complete detail record
+// against the ordinary decoder before reusing the ZMM register row.
+void emit_rounded_fma(Decoder &decoder)
+{
+	static const char *const rc_names[] = { "{rn-sae}", "{rd-sae}",
+						"{ru-sae}", "{rz-sae}" };
+	constexpr x86_avx_rm rc_modes[] = { X86_AVX_RM_RN, X86_AVX_RM_RD,
+					    X86_AVX_RM_RU, X86_AVX_RM_RZ };
+	std::puts(
+		"static const struct VectorOutputRow evex_rounded_fma_rows[3][4][2] = {");
+	for (unsigned first : { 0x98u, 0xa8u, 0xb8u }) {
+		std::puts("\t{");
+		for (unsigned opcode = first; opcode <= first + 6;
+		     opcode += 2) {
+			std::puts("\t\t{");
+			for (unsigned w = 0; w < 2; ++w) {
+				const auto row = output_record(
+					decoder, { 2, opcode, false }, w, 2);
+				if (row.empty())
+					throw std::runtime_error(
+						"missing packed EVEX FMA");
+				const auto id = decoder.insn->id;
+				const std::string mnemonic =
+					decoder.insn->mnemonic;
+				cs_detail expected = *decoder.insn->detail;
+				for (unsigned rc = 0; rc < 4; ++rc) {
+					const uint8_t bytes[] = {
+						0x62,
+						0xf2,
+						uint8_t(w << 7 | 0x6d),
+						uint8_t(rc << 5 | 0x18),
+						uint8_t(opcode),
+						0xd9
+					};
+					expected.x86.opcode[3] = bytes[3];
+					expected.x86.avx_sae = true;
+					expected.x86.avx_rm = rc_modes[rc];
+					if (decoder.decode(bytes,
+							   sizeof(bytes)) !=
+						    id ||
+					    decoder.insn->mnemonic !=
+						    mnemonic ||
+					    decoder.insn->op_str !=
+						    std::string(
+							    "zmm3, zmm2, zmm1, ") +
+							    rc_names[rc] ||
+					    std::memcmp(&expected,
+							decoder.insn->detail,
+							offsetof(cs_detail,
+								 x86) +
+								sizeof(cs_x86)))
+						throw std::runtime_error(
+							"unexpected rounded EVEX FMA");
+				}
+				std::printf("\t\t\t%s,\n", row.c_str());
+			}
+			std::puts("\t\t},");
+		}
+		std::puts("\t},");
+	}
+	std::puts("};");
+}
