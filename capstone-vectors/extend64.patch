+void emit_extend64(Decoder &decoder, const RegisterTable &regs)
+{
+	X86SimpleRegister words[16]{};
+	std::cout
+		<< "/* Generated by x86_simple_output.cpp --extend64. */\n"
+		<< "static const struct X86SimpleRegister x86_extend64_words[16] = {\n";
+	for (unsigned i = 0; i < 16; ++i) {
+		const uint8_t code[] = { uint8_t(0x40 | (i >> 3)), 0x0f, 0xb7,
+					 uint8_t(0xc0 | (i & 7)) };
+		decoder.decode(code, sizeof(code), sizeof(code), 0);
+		const auto &src = decoder.insn->detail->x86.operands[1];
+		const char *name = cs_reg_name(decoder.handle, src.reg);
+		if (src.type != X86_OP_REG || src.size != 2 || !name ||
+		    strlen(name) >= sizeof(words[i].name))
+			throw std::runtime_error(
+				"invalid canonical word register");
+		words[i].reg = src.reg;
+		words[i].length = uint8_t(strlen(name));
+		strcpy(words[i].name, name);
+		std::cout << "\t{ " << unsigned(src.reg) << ", " << strlen(name)
+			  << ", \"" << name << "\" },\n";
+	}
+	std::cout
+		<< "};\nstatic const struct X86SimpleOutput x86_extend64[9] = {\n";
+	for (unsigned form = 0; form < 9; ++form) {
+		const bool escaped = form != 8;
+		const uint8_t opcode = escaped ? uint8_t(0xb6 + (form & 1) +
+							 ((form & 2) << 2)) :
+						 0x63;
+		CheckedRow row;
+		for (unsigned prefix = 0; prefix <= 16; ++prefix) {
+			const uint8_t rex = prefix ? uint8_t(0x3f + prefix) : 0;
+			if (bool(rex & 8) != (form >= 4))
+				continue;
+			for (unsigned reg = 0; reg < 8; ++reg) {
+				auto observe = [&](uint8_t mr,
+						   const X86SimpleRegister *src) {
+					uint8_t code[4];
+					unsigned n = 0;
+					if (rex)
+						code[n++] = rex;
+					if (escaped)
+						code[n++] = 0x0f;
+					code[n++] = opcode;
+					code[n++] = mr;
+					decoder.decode(code, n, n, 0);
+					const auto *dest =
+						src ? &regs[form >= 4 ? 3 : 2]
+							   [((rex & 4) << 1) |
+							    reg] :
+						      nullptr;
+					auto fields = describe(*decoder.insn,
+							       opcode, rex, mr,
+							       dest, src, false,
+							       !src, escaped);
+					if (fields.empty() ||
+					    (row.encodings &&
+					     fields != row.fields)) {
+						std::cerr
+							<< "unexpected widening record for form "
+							<< form << ", REX "
+							<< unsigned(rex)
+							<< ", ModRM "
+							<< unsigned(mr) << ": "
+							<< decoder.insn->mnemonic
+							<< " "
+							<< decoder.insn->op_str
+							<< " (canonical "
+							<< fields << ", prior "
+							<< row.fields << ")\n";
+					}
+					row.observe(fields);
+				};
+				for (unsigned rm = 0; rm < 8; ++rm) {
+					const unsigned i = ((rex & 1) << 3) |
+							   rm;
+					const auto *src =
+						!escaped     ? regs[2] :
+						(opcode & 1) ? words :
