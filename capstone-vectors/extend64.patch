+				}
+				observe(uint8_t(reg << 3), nullptr);
+			}
+		}
+		if (row.encodings != (form < 4 ? 9u : 8u) * 72)
+			throw std::runtime_error(
+				"incomplete amd64 widening coverage");
+		std::cout << "\t" << row.fields << ",\n";
+	}
+	std::cout << "};\n";
+}
