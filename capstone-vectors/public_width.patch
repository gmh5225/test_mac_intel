+}
+
+#if defined(__clang__) && (defined(__x86_64__) || defined(__aarch64__))
+#if __has_attribute(musttail)
+#define X86_OUTPUT_TAIL __attribute__((musttail))
+#endif
+#endif
+#ifndef X86_OUTPUT_TAIL
+#define X86_OUTPUT_TAIL
+#endif
+
+/* Keep the generated x86 writer's register saves out of foreign decodes. */
+CS_PRESERVE_MOST bool
+X86_decodeIteratorOutput(cs_struct *handle, const uint8_t *code, size_t size,
+			 cs_insn *insn, uint16_t *insn_size, unsigned int batch)
+{
+	if (handle->arch == CS_ARCH_X86 && !handle->no_text)
+		X86_OUTPUT_TAIL return X86_decodeWidthText(
+			handle, code, size, insn, insn_size, batch);
+	X86_OUTPUT_TAIL return cs_decode_full_insn(handle, code, size, insn,
+						   insn_size, batch);
+}
+#undef X86_OUTPUT_TAIL
+#endif
 #endif
