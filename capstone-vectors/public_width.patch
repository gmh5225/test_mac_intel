diff --git a/arch/X86/X86Sse64Output.c b/arch/X86/X86Sse64Output.c
index c37dd7a1..f9901c85 100644
--- a/arch/X86/X86Sse64Output.c
+++ b/arch/X86/X86Sse64Output.c
@@ -280,6 +280,28 @@ static bool writeRoundedRegisters(const uint8_t *code, cs_insn *insn,
 #undef X86_FIXED_OUTPUT
 #define CS_DECODE_TRY_OUTPUT tryOutput64
 #include "../../cs_disasm_internal.h"
+
+#ifdef CAPSTONE_X86_PUBLIC_WIDTH_OUTPUT
+/* The public iterator has checked the input extent and handled no-detail
+ * scanning. Private iterator misses go straight to the canonical decoder. */
+CS_PRESERVE_MOST bool X86_decodeIteratorOutput(cs_struct *handle,
+					       const uint8_t *code, size_t size,
+					       cs_insn *insn,
+					       uint16_t *insn_size, bool batch)
+{
+	if (!handle->no_text) {
+		if (handle->mode == CS_MODE_64) {
+			if (tryOutput64(handle, code, size, insn, insn_size))
+				return true;
+		} else if (handle->mode == CS_MODE_32 &&
+			   X86_tryIteratorOutput32(handle, code, size, insn,
+						   insn_size)) {
+			return true;
+		}
+	}
+	return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
+}
+#endif
 #endif
 
 CAPSTONE_INTERNAL bool X86_disasmIterText(csh ud, const uint8_t **code,
