@@ -3753,6 +3753,9 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 					  cs_insn *insn, uint16_t *insn_size,
 					  bool batch);
 
+#ifdef CAPSTONE_X86_PUBLIC_WIDTH_OUTPUT
