+static bool check_public_mode_changes(void)
+{
+	static const uint8_t code[][5] = { { 0x48, 0x89, 0xd8 },
+					   { 0xb8, 0x34, 0x12, 0x78, 0x56 } };
+	static const cs_mode modes[] = { CS_MODE_64, CS_MODE_16, CS_MODE_32,
+					 CS_MODE_16, CS_MODE_64, CS_MODE_32 };
+	csh handle;
+	if (cs_open(CS_ARCH_X86, CS_MODE_32, &handle) != CS_ERR_OK)
+		return false;
+	cs_insn *insn = cs_malloc(handle);
+	bool ok = false;
+	if (!insn)
+		goto done;
+	for (unsigned i = 0; i < sizeof(modes) / sizeof(modes[0]); ++i) {
+		if (cs_option(handle, CS_OPT_MODE, modes[i]) != CS_ERR_OK ||
+		    cs_option(handle, CS_OPT_MODE, CS_MODE_BIG_ENDIAN) !=
+			    CS_ERR_OPTION)
+			goto done;
+		for (unsigned text = 0; text < 2; ++text) {
+			if (cs_option(handle, CS_OPT_TEXT,
+				      text ? CS_OPT_ON : CS_OPT_OFF) !=
+			    CS_ERR_OK)
+				goto done;
+			for (unsigned k = 0; k < 2; ++k) {
+				const uint8_t *cursor = code[k];
+				size_t size = sizeof(code[k]);
+				uint64_t address = 0x1000;
+				unsigned length =
+					k ? (modes[i] == CS_MODE_16 ? 3 : 5) :
+					    (modes[i] == CS_MODE_64 ? 3 : 1);
+				unsigned id = k || modes[i] == CS_MODE_64 ?
+						      X86_INS_MOV :
+						      X86_INS_DEC;
+				if (!cs_disasm_iter(handle, &cursor, &size,
+						    &address, insn) ||
+				    insn->id != id || insn->size != length ||
+				    cursor != code[k] + length ||
+				    size != sizeof(code[k]) - length ||
+				    address != 0x1000 + length ||
+				    (insn->mnemonic[0] != '\0') != (text != 0))
+					goto done;
+			}
+		}
+	}
+	ok = true;
+done:
+	if (insn)
+		cs_free(insn, 1);
+	cs_close(&handle);
+	return ok;
+}
+
 int main(void)
 {
+	if (!check_public_mode_changes())
+		return 1;
 	private_iter = X86_disasmIter32;
 	if (!check_mode(CS_MODE_32))
 		return 1;
