+/// Removes the space characters '\t' and ' ' from the beginning of the stream buffer.
+void SStream_trimls(SStream *ss)
+{
+	assert(ss);
+	/* Only whitespace and control characters need the exact prefix check. */
+	if ((unsigned char)ss->buffer[0] <= ' ')
+		trimControlPrefix(ss);
+}
