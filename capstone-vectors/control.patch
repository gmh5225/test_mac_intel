+// EVEX.0F 6F memory loads use a full-vector tuple for compressed disp8.
+// Check the tuple at its signed extremes and the complete public x86 detail.
+void emit_evex_load_rows(Decoder &decoder)
+{
+	std::puts(
+		"static const struct VectorOutputRow evex_load_rows[3][2][3] = {");
+	const x86_reg bases[] = { X86_REG_XMM0, X86_REG_YMM0, X86_REG_ZMM0 };
+	const char *prefix[] = { "xmm", "ymm", "zmm" };
+	unsigned valid_rows = 0;
+	for (unsigned pp = 1; pp <= 3; ++pp) {
+		std::puts("\t{");
+		for (unsigned w = 0; w < 2; ++w) {
+			std::puts("\t\t{");
+			for (unsigned ll = 0; ll < 3; ++ll) {
+				std::string row;
+				const unsigned width = 16u << ll;
+				for (int disp : { 1, -128, 127 }) {
+					uint8_t bytes[] = {
+						0x62,
+						0xf1,
+						uint8_t(w << 7 | 0x7c | pp),
+						uint8_t(8 | ll << 5),
+						0x6f,
+						0x58,
+						uint8_t(disp)
+					};
+					auto id = decoder.decode(bytes,
+								 sizeof(bytes));
+					if (!id) {
+						row.clear();
+						break;
+					}
+					const auto &insn = *decoder.insn;
+					const auto &d = *insn.detail;
+					cs_x86 expect{};
+					std::copy_n(bytes, 4, expect.opcode);
+					expect.rex = uint8_t(0x40 | w << 3);
+					expect.addr_size = 8;
+					expect.modrm = bytes[5];
+					expect.disp = int(width) * disp;
+					expect.encoding.modrm_offset = 5;
+					expect.encoding.disp_offset = 6;
+					expect.encoding.disp_size = 1;
+					expect.op_count = 2;
+					auto &reg = expect.operands[0];
+					reg.type = X86_OP_REG;
+					reg.reg = x86_reg(bases[ll] + 3);
+					reg.size = width;
+					reg.access = CS_AC_WRITE;
+					auto &mem = expect.operands[1];
+					mem.type = X86_OP_MEM;
+					mem.size = width;
+					mem.mem.base = X86_REG_RAX;
+					mem.mem.scale = 1;
+					mem.mem.disp = expect.disp;
+					mem.access = CS_AC_READ;
+					char text[96];
+					std::snprintf(
+						text, sizeof(text),
+						"%s3, %sword ptr [rax %c 0x%x]",
+						prefix[ll], prefix[ll],
+						disp < 0 ? '-' : '+',
+						unsigned(disp < 0 ? -disp :
+								    disp) *
+							width);
+					if (insn.illegal || insn.is_alias ||
+					    insn.usesAliasDetails ||
+					    std::strlen(insn.mnemonic) >= 16 ||
+					    d.regs_read_count ||
+					    d.regs_write_count ||
+					    d.groups_count > 4 ||
+					    std::strcmp(text, insn.op_str) ||
+					    std::memcmp(&expect, &d.x86,
+							sizeof(expect))) {
+						row.clear();
+						break;
+					}
+					Bytes4 groups{};
+					std::copy_n(d.groups, d.groups_count,
+						    groups.begin());
+					std::string next =
+						"{ " + decoder.symbol(id) +
+						", \"" + insn.mnemonic +
+						"\", " +
+						std::to_string(d.groups_count) +
+						", " + fields(groups) +
+						", { 2, 1, 0, 0 }, 0 }";
+					if (!row.empty() && row != next) {
+						row.clear();
+						break;
+					}
+					row = next;
+				}
+				valid_rows += !row.empty();
+				std::printf("\t\t\t%s,\n", row.empty() ?
+								   "{ 0 }" :
+								   row.c_str());
+			}
+			std::puts("\t\t},");
+		}
+		std::puts("\t},");
+	}
+	if (!valid_rows)
+		throw std::runtime_error("missing EVEX vector load rows");
+	std::puts("};");
+	std::fprintf(stderr, "%u EVEX vector load rows\n", valid_rows);
+}
