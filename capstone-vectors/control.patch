+/* Both callers have selected the unprefixed 64-bit EVEX register form. */
+static inline const struct VectorOutputRow *evexRegisterRow(const uint8_t *code,
+							    size_t size)
+{
+	if (size < 6 || (code[2] & 7) != 5 || (code[3] & 0x97) ||
+	    (code[3] & 0x60) == 0x60)
+		return NULL;
+	const unsigned ll = code[3] >> 5;
+	const unsigned w = code[2] >> 7;
+	const unsigned key = ((code[1] & 15) << 8) | code[4];
+	if (key == 0x173) {
+		/* R and R' are unextended for the canonical /3 and /7 forms. */
+		if (size < 7 || (code[1] & 0x90) != 0x90 ||
+		    (code[5] & 0x18) != 0x18)
+			return NULL;
+		return &evex_byte_shifts[(code[5] >> 5) & 1][w][ll];
+	}
+	const struct VectorOutputRow *row = evexOutputRow(key, w, ll);
+	if (!row || (row->immediate && size < 7))
+		return NULL;
+	if ((key & ~0x22u) == 0x319 &&
+	    ((code[2] & 0x78) != 0x78 || !(code[3] & 8)))
+		return NULL;
+	return row;
