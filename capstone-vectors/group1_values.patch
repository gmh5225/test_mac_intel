@@ -23,4 +23,34 @@ static char *writeUnsignedImmediate(char *out, uint64_t value)
 	}
 }
 
+/* The register and memory paths expose the same immediate sign and width. */
+static inline int64_t X86_readAluImmediate(const uint8_t *bytes, bool imm32,
+					   bool wide, bool unsigned_byte)
+{
+	if (imm32) {
+		uint32_t raw = (uint32_t)X86_readDisp32(bytes);
+		return wide ? (int64_t)(int32_t)raw : (int64_t)raw;
+	}
+	return unsigned_byte ? *bytes : (int8_t)*bytes;
+}
+
+static inline bool X86_isLogicalImmediate(bool shift, uint8_t modrm)
+{
+	const unsigned group = (modrm >> 3) & 7;
+	return !shift && (group == 1 || group == 4 || group == 6);
+}
+
+static inline int64_t X86_aluDetailValue(int64_t immediate, bool logical,
+					 bool wide)
+{
+	return logical && !wide ? (int64_t)(uint32_t)immediate : immediate;
+}
+
+static inline uint64_t X86_aluMagnitude(int64_t immediate, bool logical,
+					bool wide, bool negative)
+{
+	return logical ? (wide ? (uint64_t)immediate : (uint32_t)immediate) :
+			 (uint64_t)(negative ? -immediate : immediate);
+}
+
 #endif
