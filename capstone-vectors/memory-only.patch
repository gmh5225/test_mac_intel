+					     dst < 8 && uniform; ++dst)
+						for (unsigned src = 0;
+						     src < sources && uniform;
+						     ++src)
+							for (int32_t disp :
+							     disps)
+								if (vex32_memory_record(
+									    decoder,
+									    opcode,
+									    pp,
+									    ll,
+									    dst,
+									    src,
+									    base,
+									    mod,
