+		 actual.operands[0].type == X86_OP_REG &&
+		 actual.operands[1].type == X86_OP_MEM)
+		form = 1;
+	else if (actual.op_count == 2 &&
+		 actual.operands[0].type == X86_OP_MEM &&
+		 actual.operands[1].type == X86_OP_REG)
+		form = 2;
