 }
 
+void emit_register_operands(Decoder &decoder)
+{
+	const x86_reg banks[] = { X86_REG_XMM0, X86_REG_YMM0, X86_REG_ZMM0 };
+	std::puts("CAPSTONE_INTERNAL const char X86_vectorRegisterOperands[3][32][8] = {");
+	for (auto bank : banks) {
+		std::puts("\t{");
+		for (unsigned n = 0; n < 32; ++n) {
+			const char *name = cs_reg_name(decoder.handle, bank + n);
+			if (!name || std::strlen(name) != 4 + (n >= 10))
+				throw std::runtime_error("unexpected vector register name");
+			std::printf("\t\t\", %s\",\n", name);
+		}
+		std::puts("\t},");
+	}
+	std::puts("};");
+}
+
 void emit_output(Decoder &decoder, bool scan_only)
 {
 	std::vector<std::string> records;
@@ -2355,6 +2372,7 @@ void emit_output(Decoder &decoder, bool scan_only)
 	Decoder padding32(CS_MODE_32);
 	emit_padding_rows(padding32, decoder);
 	emit_legacy_registers(decoder);
+	emit_register_operands(decoder);
 }
