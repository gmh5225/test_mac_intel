diff --git a/arch/X86/X86Vex32Output.c b/arch/X86/X86Vex32Output.c
index 443b2f86..0e57e3ea 100644
--- a/arch/X86/X86Vex32Output.c
+++ b/arch/X86/X86Vex32Output.c
@@ -188,6 +188,30 @@ static bool writeExtraOutput32(cs_struct *handle, const uint8_t *code,
 	return true;
 }
 
+#if defined(__ELF__) && defined(__clang__) && defined(__aarch64__) && \
+	defined(__ARM_NEON) && !defined(__AARCH64EB__) && \
+	!defined(__KERNEL__) && !defined(_KERNEL_MODE)
+#include <arm_neon.h>
+#include "../../MathExtras.h"
+
+/* The 32-bit iterator wraps branch targets before formatting them. Expand
+ * its eight hex digits in print order and shift away the leading zeroes. */
+static void writeRelativeHex32(char *out, uint32_t value)
+{
+	const uint8x8_t bytes = vcreate_u8(__builtin_bswap32(value));
+	const uint8x8_t nibbles = vand_u8(vzip1_u8(vshr_n_u8(bytes, 4), bytes),
+				       vdup_n_u8(15));
+	const uint8x8_t chars =
+		vqtbl1_u8(vld1q_u8((const uint8_t *)"0123456789abcdef"), nibbles);
+	const unsigned leading = CountLeadingZeros_32(value) / 4;
+	const uint64_t digits =
+		vget_lane_u64(vreinterpret_u64_u8(chars), 0) >> (leading * 8);
+	memcpy(out, "0x", 2);
+	memcpy(out + 2, &digits, sizeof(digits));
+}
+#define X86_FIXED_RELATIVE_HEX writeRelativeHex32
+#endif
+
 #define X86_FIXED_OUTPUT tryOutput32
 #define X86_FIXED_WIDE false
 #define X86_OUTPUT_MISS writeExtraOutput32
