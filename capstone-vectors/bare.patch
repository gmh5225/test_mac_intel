+static bool check_mov_imm8(csh handles[2], cs_mode mode)
+{
+	for (unsigned p = 0; p <= (mode == CS_MODE_64 ? 16u : 0u); ++p) {
+		for (unsigned opcode = 0xb0; opcode < 0xb8; ++opcode) {
+			for (unsigned imm = 0; imm < 256; ++imm) {
+				uint8_t bytes[] = { (uint8_t)(0x3f + p),
+						    (uint8_t)opcode, (uint8_t)imm };
+				const uint8_t *code = bytes + !p;
+				size_t length = sizeof(bytes) - !p;
+				if (!compare(handles, code, length, imm) ||
+				    !compare(handles, code, imm % length, p))
+					return false;
+			}
+		}
+	}
+	return true;
+}
