diff --git a/arch/X86/X86PublicEvexScan.c b/arch/X86/X86PublicEvexScan.c
new file mode 100644
index 00000000..1c8f177f
--- /dev/null
+++ b/arch/X86/X86PublicEvexScan.c
@@ -0,0 +1,39 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "X86FeatureExtension.h"
+#ifdef X86_EVEX_REGISTER_SCAN
+#include "X86Disassembler.h"
+#define X86_EVEX_BATCH_PACKED
+#define X86_EVEX_SCAN_RODATA ".cs_x86_public_evex_rodata"
+#define X86_EVEX_TRANSFER_RODATA X86_EVEX_SCAN_RODATA
+#include "X86EvexScanPlan.h"
+
+/* The generic iterator reaches this after its initial terminal lookup. The
+ * native batch reader already consumes these plans at its own primary entry. */
+__attribute__((section(".cs_x86_public_evex_text")))
+CS_PRESERVE_MOST bool
+X86_decodePublicScanExtension(csh ud, const uint8_t *code, size_t code_len,
+			      cs_insn *insn, X86ScanResult *result,
+			      uint8_t opcode, bool tryExtension)
+{
+	const cs_struct *handle = (const cs_struct *)(uintptr_t)ud;
+	unsigned id, length;
+	if (tryExtension && opcode == 0x62 && code_len >= 6 && code[0] == 0x62 &&
+	    handle->mode == CS_MODE_64 &&
+#ifdef CAPSTONE_X86_SCAN_ADAPTER
+	    !handle->x86_scan_adapter &&
+#endif
+	    X86_readEvexScanPlan(code, code_len, &id, &length)) {
+		result->opcode = 0;
+		result->opcode_pub = id;
+		result->length = (uint16_t)length;
+		result->popcode_adjust = 0;
+		return true;
+	}
+	return X86_decodeScanResultFallback(ud, code, code_len, insn, result,
+					    opcode, tryExtension);
+}
+#endif
+#endif
