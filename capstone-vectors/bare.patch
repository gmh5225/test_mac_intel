+/* A register row can describe memory only when every encoding using the
+ * row has the same admitted memory record. */
+void emit_vex_memory_register_mask(Decoder &decoder)
+{
+	const auto registers = collect_vex_registers(decoder);
+	const auto memory = collect_vex_base_memory(decoder);
+	std::vector<bool> eligible(registers.rows.size() + 1, true);
+	eligible[0] = false;
+	for (unsigned map = 0; map < registers.plans.size(); ++map) {
+		for (unsigned opcode = 0; opcode < 256; ++opcode) {
+			for (unsigned wl = 0; wl < 4; ++wl) {
+				const unsigned r = registers.row(map, opcode, wl);
+				const unsigned m = memory.row(map, opcode, wl);
