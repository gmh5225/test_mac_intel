-		return -1;
-
-	left = 0;
+	const unsigned int count = ARR_SIZE(insns);
+	const unsigned int first = insns[0].id;
+	/* The generator orders distinct IDs. If the endpoints span exactly
+	 * count entries, subtraction indexes every opcode in the table. */
+	if (insns[count - 1].id - first == count - 1) {
+		const unsigned int row = id - first;
+		return row < count ? row : (unsigned int)-1;
+	}
 
-	while (left <= right) {
