+size_t printVexMemoryTables(const std::vector<std::string> &rows,
+			    const VexMemoryForms &forms)
+{
+	// Each page covers eight consecutive opcodes at a fixed prefix.
+	// Four slots per opcode select vector length and W.
+	using Page = std::array<unsigned, 32>;
+	std::vector<Page> pages(1);
+	std::array<std::array<std::array<unsigned, 32>, 4>, 3> directory{};
+	for (size_t map = 0; map < forms.size(); ++map) {
+		for (unsigned prefix = 0; prefix < 4; ++prefix) {
+			for (unsigned block = 0; block < 32; ++block) {
+				Page page{};
+				for (unsigned lo = 0; lo < 8; ++lo)
+					for (unsigned wl = 0; wl < 4; ++wl)
+						page[4 * lo + wl] =
+							forms[map][8 * block + lo][4 * prefix + wl];
+				auto it = std::find(pages.begin(), pages.end(), page);
+				const size_t index = it - pages.begin();
+				if (it == pages.end())
+					pages.push_back(page);
+				directory[map][prefix][block] = unsigned(index);
+			}
+		}
+	}
+
+	std::puts("static const struct VectorOutputRow vex_base_rows[] = {\n\t{ 0 },");
+	for (const auto &row : rows)
+		std::printf("\t%s,\n", row.c_str());
+	std::printf("};\nstatic const %s vex_base_pages[][32] = {\n",
+		    rows.size() <= UINT8_MAX ? "uint8_t" : "uint16_t");
+	for (const auto &page : pages)
+		std::printf("\t%s,\n", fields(page).c_str());
+	std::printf("};\nstatic const %s vex_base_directory[3][4][32] = {\n",
+		    pages.size() <= UINT8_MAX + 1u ? "uint8_t" : "uint16_t");
+	for (const auto &map : directory) {
+		std::puts("\t{");
+		for (const auto &prefix : map)
+			std::printf("\t\t%s,\n", fields(prefix).c_str());
+		std::puts("\t},");
+	}
+	std::puts("};");
+	return pages.size();
+}
