--- a/arch/X86/X86VectorRegisterWriter.h
+++ b/arch/X86/X86VectorRegisterWriter.h
@@ -7,6 +7,12 @@
 static char *writeVectorRegister(char *out, unsigned length_code,
 				 unsigned number)
 {
+#ifdef X86_USE_VECTOR_REGISTER_NAMES
+	/* This writer appends to the initialized operand string. */
+	memcpy(out, vector_register_names[length_code][number],
+	       sizeof(vector_register_names[0][0]));
+	return out + 4 + (number >= 10);
+#else
 	*out++ = "xyz"[length_code];
 	*out++ = 'm';
 	*out++ = 'm';
@@ -14,6 +20,7 @@ static char *writeVectorRegister(char *out, unsigned length_code,
 		*out++ = (char)('0' + number / 10);
 	*out++ = (char)('0' + number % 10);
 	return out;
+#endif
 }
 
 #endif
diff --git a/suite/synctools/x86_vector_output.cpp b/suite/synctools/x86_vector_output.cpp
index 91426243..48836058 100644
--- a/suite/synctools/x86_vector_output.cpp
+++ b/suite/synctools/x86_vector_output.cpp
@@ -2297,6 +2297,23 @@ void emit_evex_shifts(Decoder &decoder)
 	std::puts("};");
 }
 
+void emit_register_names(Decoder &decoder)
+{
+	const x86_reg banks[] = { X86_REG_XMM0, X86_REG_YMM0, X86_REG_ZMM0 };
+	std::puts("static const char vector_register_names[3][32][6] = {");
+	for (auto bank : banks) {
+		std::puts("\t{");
+		for (unsigned n = 0; n < 32; ++n) {
+			const char *name = cs_reg_name(decoder.handle, bank + n);
+			if (!name || std::strlen(name) != 4 + (n >= 10))
+				throw std::runtime_error("unexpected vector register name");
+			std::printf("\t\t\"%s\",\n", name);
+		}
+		std::puts("\t},");
+	}
+	std::puts("};");
+}
+
 void emit_output(Decoder &decoder, bool scan_only)
 {
 	std::vector<std::string> records;
@@ -2355,6 +2372,7 @@ void emit_output(Decoder &decoder, bool scan_only)
 	Decoder padding32(CS_MODE_32);
 	emit_padding_rows(padding32, decoder);
 	emit_legacy_registers(decoder);
