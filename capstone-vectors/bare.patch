-		if (id < insns[m].id)
-			right = m - 1;
+	unsigned int lo = 0, hi = count;
+	while (lo < hi) {
+		const unsigned int mid = lo + (hi - lo) / 2;
+		if (insns[mid].id < id)
+			lo = mid + 1;
 		else
-			left = m + 1;
+			hi = mid;
 	}
-
-	// not found
