diff --git a/arch/X86/X86EvexPackedScan.c b/arch/X86/X86EvexPackedScan.c
new file mode 100644
index 00000000..5e2ed8e6
--- /dev/null
+++ b/arch/X86/X86EvexPackedScan.c
@@ -0,0 +1,37 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "X86FeatureExtension.h"
+#ifdef X86_EVEX_REGISTER_SCAN
+#define X86_EVEX_BATCH_PACKED
+#define X86_EVEX_ONLY_PACKED
+#define X86_EVEX_SCAN_RODATA ".cs_x86_evex_packed_rodata"
+#define X86_EVEX_TRANSFER_RODATA ".cs_x86_evex_packed_rodata"
+#include "X86EvexScanPlan.h"
+
+/* Entry after the ordinary register plan declines a complete EVEX prefix.
+ * Keep the native batch reader's IDs, reserved fields and SIB lengths. */
+__attribute__((section(".cs_x86_evex_packed_text")))
+x86_feature_decode_result
+X86_decodePackedScanFeature(csh ud, const uint8_t *code, size_t code_len,
+			    MCInst *instr, uint16_t *size, uint8_t opcode)
+{
+	const cs_struct *handle = (const cs_struct *)(uintptr_t)ud;
+	unsigned id, length;
+	if (handle->mode == CS_MODE_64 &&
+#ifdef CAPSTONE_X86_SCAN_ADAPTER
+	    !handle->x86_scan_adapter &&
+#endif
+	    X86_readEvexScanPlan(code, code_len, &id, &length)) {
+		instr->Opcode = 0;
+		instr->OpcodePub = id;
+		instr->popcode_adjust = 0;
+		*size = (uint16_t)length;
+		return X86_FEATURE_DECODED;
+	}
+	return X86_decodeFeatureExtension(ud, code, code_len, instr, size,
+					  opcode);
+}
+#endif
+#endif
