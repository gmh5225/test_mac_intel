+// The count byte is unsigned for these two register-only forms. The
+// remaining public fields must match a two-register record for every count.
+void emit_double_shift32(Decoder &decoder, const RegisterTable &regs)
+{
+	std::cout << "/* Generated by x86_simple_output.cpp --double-shift32. */\n"
+		  << "static const struct X86SimpleOutput double_shift32_rows[] = {\n";
+	for (uint8_t opcode : { 0xa4, 0xac }) {
+		CheckedRow row;
+		for (unsigned mr = 0xc0; mr <= 0xff; ++mr) {
+			const auto &dst = regs[2][mr & 7];
+			const auto &src = regs[2][(mr >> 3) & 7];
+			for (unsigned count = 0; count < 256; ++count) {
+				const uint8_t bytes[] = { 0x0f, opcode, uint8_t(mr), uint8_t(count) };
+				decoder.decode(bytes, sizeof(bytes), sizeof(bytes), 0);
+				cs_insn projected = *decoder.insn;
+				cs_detail detail = *projected.detail;
+				projected.detail = &detail;
+				auto &xd = detail.x86;
+				const auto &imm = xd.operands[2];
+				std::ostringstream text;
+				text << dst.name << ", " << src.name << ", ";
+				if (count > HEX_THRESHOLD)
+					text << "0x" << std::hex;
+				text << count;
+				if (text.str() != projected.op_str || xd.op_count != 3 ||
+				    imm.type != X86_OP_IMM || imm.imm != count ||
+				    imm.size != 1 || imm.access != 0 ||
+				    xd.encoding.imm_offset != 3 || xd.encoding.imm_size != 1)
+					throw std::runtime_error("unexpected double-shift count");
+				xd.op_count = 2;
+				std::memset(&xd.operands[2], 0, sizeof(xd.operands[2]));
+				char *last = std::strrchr(projected.op_str, ',');
+				*last = 0;
+				row.observe(describe(projected, opcode, 0, uint8_t(mr),
+						     &dst, &src, false, false, true));
+			}
+		}
+		std::cout << '\t' << row.fields << ",\n";
+	}
+	std::cout << "};\n";
+}
+
 } // namespace
 
