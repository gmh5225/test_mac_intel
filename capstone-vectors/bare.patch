diff --git a/arch/X86/X86VexRegisterImmediate.c b/arch/X86/X86VexRegisterImmediate.c
index 3fe8460f..4dbdf13e 100644
--- a/arch/X86/X86VexRegisterImmediate.c
+++ b/arch/X86/X86VexRegisterImmediate.c
@@ -108,5 +108,29 @@ bool X86_writeVexRegisterImmediate(cs_struct *handle, const uint8_t *code,
 	writeUnsignedImmediate(out, code[5]);
 	return true;
 }
+#ifndef CAPSTONE_X86_ONLY
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_vex3_memory_text" rodata = ".cs_x86_vex3_memory_rodata"
+#endif
+#include "X86VexBaseMemory.h"
+
+/* The AMD64 caller has identified the three-byte VEX prefix. The register
+ * writer and the memory writer consume disjoint ModR/M encodings. */
+bool X86_writeVex3Output64(cs_struct *handle, const uint8_t *code, size_t size,
+			   cs_insn *insn, uint16_t *insn_size,
+			   const struct X86SimpleRegister regs[4][16])
+{
+	if (size < 5)
+		return false;
+	if (code[4] < 0xc0) {
+		if (X86_OUTPUT_UNSUPPORTED(handle, false))
+			return false;
+		return writeVexBaseMemory(code, size, 3, insn, insn_size, regs[3]);
+	}
+	return X86_writeVexRegisterImmediate(handle, code, size, insn, insn_size,
+					     regs, true);
+}
+#endif
