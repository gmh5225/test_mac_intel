+/* Most explicit operands follow zero or one previously reported register. */
+static inline bool x86HasRegister(uint16_t *regs, uint8_t count, unsigned int reg)
+{
+	if (count <= 1)
+		return count != 0 && regs[0] == reg;
+	if (count == 2)
+		return (regs[0] == reg) | (regs[1] == reg);
+	return arr_exist_inline(regs, count, reg);
+}
