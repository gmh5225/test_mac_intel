diff --git a/arch/X86/X86VectorRegisterWriter.h b/arch/X86/X86VectorRegisterWriter.h
index 9c434eac..17f69d84 100644
--- a/arch/X86/X86VectorRegisterWriter.h
+++ b/arch/X86/X86VectorRegisterWriter.h
@@ -4,16 +4,22 @@
 #ifndef CS_X86_VECTOR_REGISTER_WRITER_H
 #define CS_X86_VECTOR_REGISTER_WRITER_H
 
-static char *writeVectorRegister(char *out, unsigned length_code,
-				 unsigned number)
+/* The generated rows contain ", " and a zero-padded register name.
+ * The validated vector writers append to a zeroed operand string. */
+extern CAPSTONE_INTERNAL const char X86_vectorRegisterOperands[3][32][8];
+
+static inline char *writeVectorRegister(char *out, unsigned bank, unsigned n)
+{
+	const char *operand = X86_vectorRegisterOperands[bank][n];
+	memcpy(out, operand + 2, sizeof(X86_vectorRegisterOperands[0][0]) - 2);
+	return out + 4 + (n >= 10);
+}
+
+static inline char *appendVectorRegister(char *out, unsigned bank, unsigned n)
 {
-	*out++ = "xyz"[length_code];
-	*out++ = 'm';
-	*out++ = 'm';
-	if (number >= 10)
-		*out++ = (char)('0' + number / 10);
-	*out++ = (char)('0' + number % 10);
-	return out;
+	const char *operand = X86_vectorRegisterOperands[bank][n];
+	memcpy(out, operand, sizeof(X86_vectorRegisterOperands[0][0]));
+	return out + 6 + (n >= 10);
 }
 
 #endif
