-// Given MCInst's id, find out if this insn is valid for NOTRACK prefix.
-// NOTRACK prefix is valid for CALL/JMP.
-static bool valid_notrack(cs_struct *h, unsigned int opcode)
-{
-	unsigned int id;
-	unsigned int i = find_insn_h(h, opcode);
-	if (i != -1) {
-		id = insns[i].mapid;
-		switch (id) {
-		default:
-			return false;
-		case X86_INS_CALL:
-		case X86_INS_JMP:
-			return true;
-		}
+	switch (insns[i].mapid) {
+	case X86_INS_CMPSB:
+	case X86_INS_CMPSW:
+	case X86_INS_CMPSQ:
+	case X86_INS_SCASB:
+	case X86_INS_SCASW:
+	case X86_INS_SCASQ:
+		return X86_PRINT_REPNE | X86_PRINT_REPE;
+	case X86_INS_CMPSD:
+		return opcode == X86_CMPSL ? X86_PRINT_REPNE | X86_PRINT_REPE : 0;
+	case X86_INS_SCASD:
+		return opcode == X86_SCASL ? X86_PRINT_REPNE | X86_PRINT_REPE : 0;
+	case X86_INS_CMPSS:
+	case X86_INS_MOVSS:
+		return X86_PRINT_REPNE;
+	case X86_INS_MOVSB:
+	case X86_INS_MOVSW:
+	case X86_INS_MOVSQ:
+	case X86_INS_LODSB:
+	case X86_INS_LODSW:
+	case X86_INS_LODSQ:
+	case X86_INS_STOSB:
+	case X86_INS_STOSW:
+	case X86_INS_STOSQ:
+	case X86_INS_INSB:
+	case X86_INS_INSW:
+	case X86_INS_INSD:
+	case X86_INS_OUTSB:
+	case X86_INS_OUTSW:
+	case X86_INS_OUTSD:
+		return X86_PRINT_REPNE | X86_PRINT_REP;
+	case X86_INS_MOVSD:
+		if (opcode == X86_MOVSL)
+			return X86_PRINT_REPNE | X86_PRINT_REP;
+		return opcode == X86_MOVSW ? X86_PRINT_REPNE : 0;
+	case X86_INS_LODSD:
+		return X86_PRINT_REPNE | (opcode == X86_LODSL ? X86_PRINT_REP : 0);
+	case X86_INS_STOSD:
+		return X86_PRINT_REPNE | (opcode == X86_STOSL ? X86_PRINT_REP : 0);
+	case X86_INS_RET:
+		return X86_PRINT_REPZ | X86_PRINT_BND;
+	case X86_INS_JMP:
+	case X86_INS_CALL:
+		return X86_PRINT_BND | X86_PRINT_NOTRACK;
+	case X86_INS_RETF:
+	case X86_INS_RETFQ:
+	case X86_INS_JAE:
+	case X86_INS_JA:
+	case X86_INS_JBE:
+	case X86_INS_JB:
+	case X86_INS_JCXZ:
+	case X86_INS_JECXZ:
+	case X86_INS_JE:
+	case X86_INS_JGE:
+	case X86_INS_JG:
+	case X86_INS_JLE:
+	case X86_INS_JL:
+	case X86_INS_JNE:
+	case X86_INS_JNO:
+	case X86_INS_JNP:
+	case X86_INS_JNS:
+	case X86_INS_JO:
+	case X86_INS_JP:
+	case X86_INS_JRCXZ:
+	case X86_INS_JS:
+		return X86_PRINT_BND;
+	default:
+		return 0;
 	}
-
-	// not found
-	return false;
 }
 
