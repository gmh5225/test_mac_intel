new file mode 100644
index 00000000..2aaa16fd
--- /dev/null
+++ b/arch/X86/X86OpcodeImmediateOutput.h
@@ -0,0 +1,36 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_OPCODE_IMMEDIATE_OUTPUT_H
+#define CS_X86_OPCODE_IMMEDIATE_OUTPUT_H
+
+#include "X86RegisterImmediateOutput.h"
+
+/* Bare accumulator CMP/TEST and opcode-register MOV use the same immediate
+ * record as a register pair, with neither a ModR/M nor a displacement. */
+static bool writeOpcodeImmediate(cs_struct *handle, const uint8_t *code,
+				 size_t size, cs_insn *insn, uint16_t *insn_size,
+				 bool wide, uint8_t rex, uint8_t op)
+{
+	const bool mov = (op & 0xf8) == 0xb0;
+	const unsigned family = op & 0xfe;
+	if (!mov && family != 0x3c && family != 0xa8)
+		return false;
+	const bool dword = !mov && (op & 1);
+	const unsigned offset = 1 + (rex != 0);
+	const unsigned imm_size = dword ? 4 : 1;
+	if (size < offset + imm_size || (dword && (rex & 8)) ||
+	    X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+	const unsigned pair = mov ? 0x88 : (family == 0xa8 ? 0x84 : 0x38) + dword;
+	const unsigned prefix = rex ? 1 + ((rex >> 3) & 1) : 0;
+	const unsigned row = x86_simple_plans[wide][prefix][pair] >> 2;
+	const unsigned reg = mov ? ((rex & 1) << 3) | (op & 7) : 0;
+	writeUnsignedRegisterImmediate(
+		insn, &x86_simple_outputs[row],
+		&x86_simple_registers[dword ? 2 : (rex != 0)][reg],
+		code, rex, 0, offset, imm_size, insn_size);
+	return true;
+}
+
+#endif
