+// Decode both operand orders through the canonical mapper and Intel printer.
+void emit_register_pairs32(Decoder &decoder)
+{
+	std::cout << "/* Generated by suite/synctools/x86_simple_output.cpp --register-pairs32. */\n"
+		  << "static const struct X86RegisterPair32 x86_register_pairs32[2][2][64] = {\n";
+	for (unsigned width = 0; width < 2; ++width) {
+		std::cout << "\t{\n";
+		for (unsigned reverse = 0; reverse < 2; ++reverse) {
+			std::cout << "\t\t{\n";
+			for (unsigned mr = 0xc0; mr <= 0xff; ++mr) {
+				decode_pair(decoder, 0, uint8_t(0x88 + width + reverse * 2), uint8_t(mr));
+				const cs_x86 &x = decoder.insn->detail->x86;
+				if (x.op_count != 2 || x.operands[0].type != X86_OP_REG ||
+				    x.operands[1].type != X86_OP_REG)
+					throw std::runtime_error("invalid i386 register pair");
+				const auto a = x.operands[0].reg, b = x.operands[1].reg;
+				const std::string text = std::string(cs_reg_name(decoder.handle, a)) +
+							 ", " + cs_reg_name(decoder.handle, b);
+				if (text != decoder.insn->op_str || text.size() >= 12)
+					throw std::runtime_error("invalid i386 register spelling");
+				std::cout << "\t\t\t{ \"" << text << "\", " << a << ", " << b << " },\n";
+			}
+			std::cout << "\t\t},\n";
+		}
+		std::cout << "\t},\n";
+	}
+	std::cout << "};\n";
+}
