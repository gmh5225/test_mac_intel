+		RegisterTable regs{};
+		describe_registers(x64, regs);
+		emit_double_shift32(x86, regs);
+		return 0;
+	}
 	if (argc == 2 && std::strcmp(argv[1], "--vex64-packed-memory") == 0) {
 		Decoder decoder(CS_MODE_64);
 		emit_packed_memory(decoder, false);
