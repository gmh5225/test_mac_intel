+#if X86_HAS_VEX2_PUBLIC_PLANS
+/* The existing VEX prefix dispatch supplies the bare C5 lead. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__ELF__) && defined(__GNUC__)
+__attribute__((noinline, section(".cs_x86_vex32_scan")))
+#elif defined(__APPLE__) && defined(__GNUC__)
+__attribute__((noinline, section("__TEXT,__cs_vex32scan")))
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static CS_PRESERVE_MOST bool
+decodeVex32ScanResult(csh ud, const uint8_t *code, size_t code_len,
+			     cs_insn *insn, X86ScanResult *result,
+			     uint8_t opcode)
+{
+	const cs_struct *handle = (const cs_struct *)(uintptr_t)ud;
+	if (handle->mode == CS_MODE_32 && code_len >= 2 && code[1] >= 0xc0
+#ifdef CAPSTONE_X86_SCAN_ADAPTER
+	    && !handle->x86_scan_adapter
+#endif
+	) {
+		const uint32_t packed = X86_readVex32PublicPlan(code, code_len);
+		if (packed) {
+			if (packed == UINT32_MAX)
+				return false;
+			result->opcode = 0;
+			result->opcode_pub = packed >> 8;
+			result->length = (uint16_t)(packed & 0xff);
+			result->popcode_adjust = 0;
+			return true;
+		}
+	}
+	return decodeScanResultFallback(ud, code, code_len, insn, result, opcode,
+					false);
+}
+#endif
