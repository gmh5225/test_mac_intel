diff --git a/CMakeLists.txt b/CMakeLists.txt
index 69c494cc..d04037ba 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -184,6 +184,11 @@ endif()
 
 if(capstone_enabled_architectures STREQUAL "RISCV")
     add_compile_definitions(CAPSTONE_RISCV_INIT_CONSTRUCTED_OPERANDS)
+    # Fixed-width implicit counts improve detailed decoding in this configuration.
+    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_C_COMPILER_ID STREQUAL "Clang"
+       AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
+        add_compile_definitions(CAPSTONE_RISCV_SHORT_IMPLICIT_LISTS)
+    endif()
 endif()
 
 if(capstone_enabled_architectures STREQUAL "SPARC")
@@ -207,8 +212,11 @@ if(use_alias_trie)
     add_compile_definitions(CAPSTONE_USE_ALIAS_TRIE)
 endif()
 
+option(CAPSTONE_MIPS_FINAL_OUTPUT_TRIM "Remove leading whitespace once at the MIPS output boundary" OFF)
+option(CAPSTONE_MIPS_PRECHECK_PRINTED_ALIAS "Check the MIPS printer alias flag before calling the isolated mnemonic lookup" OFF)
 option(CAPSTONE_X86_REDUCE "x86 with reduce instruction sets to minimize library" OFF)
 option(CAPSTONE_X86_ATT_DISABLE "Disable x86 AT&T syntax" OFF)
+option(CAPSTONE_X86_NEAR_INDIRECT_OUTPUT "Enable near CALL/JMP output in the static x86-64 iterator" OFF)
 option(CAPSTONE_X86_SCAN_ADAPTER "Build the private x86 scan adapter hook" OFF)
 option(CAPSTONE_OSXKERNEL_SUPPORT "Support to embed Capstone into OS X Kernel extensions" OFF)
 
@@ -392,6 +400,14 @@ endif()
 
 if(CAPSTONE_MIPS_SUPPORT)
     add_definitions(-DCAPSTONE_HAS_MIPS)
+    if(CAPSTONE_MIPS_FINAL_OUTPUT_TRIM)
+        set_property(SOURCE arch/Mips/MipsInstPrinter.c APPEND PROPERTY
+            COMPILE_DEFINITIONS CAPSTONE_MIPS_FINAL_OUTPUT_TRIM)
+    endif()
+    if(CAPSTONE_MIPS_PRECHECK_PRINTED_ALIAS)
+        set_property(SOURCE arch/Mips/MipsMapping.c APPEND PROPERTY
+            COMPILE_DEFINITIONS CAPSTONE_MIPS_PRECHECK_PRINTED_ALIAS)
+    endif()
     set(CSTOOL_SRC
         ${CSTOOL_SRC}
         cstool/cstool_mips.c)
@@ -1028,8 +1044,24 @@ target_include_directories(capstone PUBLIC
 )
 set_property(TARGET capstone PROPERTY POSITION_INDEPENDENT_CODE ON)
 
+# The i386 iterator is an internal static-link entry used by NeverD.
+if(CAPSTONE_X86_SUPPORT AND (CAPSTONE_BUILD_STATIC_LIBS OR CAPSTONE_BUILD_CSTEST))
+    add_library(capstone_x86_iter32 OBJECT arch/X86/X86Vex32Output.c)
+    target_link_libraries(capstone_x86_iter32 PRIVATE capstone)
+    set_target_properties(capstone_x86_iter32 PROPERTIES C_STANDARD 99 POSITION_INDEPENDENT_CODE ON)
+    add_library(capstone_x86_iter64 OBJECT arch/X86/X86Sse64Output.c)
+    target_link_libraries(capstone_x86_iter64 PRIVATE capstone)
+    if(CAPSTONE_X86_NEAR_INDIRECT_OUTPUT)
+        target_compile_definitions(capstone_x86_iter64 PRIVATE CAPSTONE_X86_NEAR_INDIRECT_OUTPUT)
+    endif()
+    set_target_properties(capstone_x86_iter64 PROPERTIES C_STANDARD 99 POSITION_INDEPENDENT_CODE ON)
+endif()
+
 if(CAPSTONE_BUILD_STATIC_LIBS)
     add_library(capstone_static STATIC $<TARGET_OBJECTS:capstone>)
+    if(TARGET capstone_x86_iter32)
+        target_sources(capstone_static PRIVATE $<TARGET_OBJECTS:capstone_x86_iter32> $<TARGET_OBJECTS:capstone_x86_iter64>)
+    endif()
     # Use normal capstone name. Otherwise we get libcapstone_static.a
     set_target_properties(capstone_static PROPERTIES OUTPUT_NAME "capstone")
     if(MSVC AND CAPSTONE_BUILD_SHARED_LIBS)
