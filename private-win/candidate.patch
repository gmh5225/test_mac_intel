+					if (vex) {
+						/* The memory encoding can have different group membership and
+						 * operand access from the same opcode's register encoding. */
+						std::memcpy(&expected,
+							    insn.detail,
+							    offsetof(cs_detail,
+								     x86));
+						expected.x86.eflags =
+							insn.detail->x86.eflags;
+						X86SimpleRegister regs[2]{};
+						for (unsigned i = 0; i < 2;
+						     ++i) {
+							expected.x86.operands[i]
+								.access =
+								insn.detail->x86
+									.operands[i]
+									.access;
+							const auto reg =
+								expected.x86
+									.operands[i]
+									.reg;
+							regs[i].reg =
+								uint16_t(reg);
+							std::strcpy(
+								regs[i].name,
+								cs_reg_name(
+									decoder.handle,
+									reg));
+						}
