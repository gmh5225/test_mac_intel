+							       X86_REG_YMM0 :
+							       X86_REG_XMM0;
+				if (unsigned(reg_op.reg) !=
+					    first + (prefix << 3) + field ||
+				    unsigned(rm_op.reg) != first ||
+				    reg_op.size != width_bytes)
+					return false;
+			}
+			const std::string reg =
+				cs_reg_name(decoder.handle, reg_op.reg);
+			for (unsigned mod = 0; mod < 3; ++mod) {
+				for (unsigned rm = 0; rm < 8; ++rm) {
