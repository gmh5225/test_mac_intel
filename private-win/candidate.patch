new file mode 100644
index 00000000..76c28656
--- /dev/null
+++ b/arch/X86/X86SimpleOutputImpl.h
@@ -0,0 +1,234 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_SIMPLE_OUTPUT_IMPL_H
+#define CS_X86_SIMPLE_OUTPUT_IMPL_H
+
+/* The register rows distinguish AH..BH from SPL..DIL when a REX prefix is
+ * present. Memory admission and bounds checks belong to the address writer. */
+#ifdef X86_MEMORY32_OUTPUT
+#include "X86GenIndirectMemory.inc"
+#endif
+#ifdef X86_FIXED_OUTPUT
+static bool X86_FIXED_OUTPUT(cs_struct *handle, const uint8_t *code,
+			     size_t size, cs_insn *insn, uint16_t *insn_size)
+#else
+#ifdef CAPSTONE_X86_DEDICATED_OUTPUT
+CAPSTONE_INTERNAL
+#else
+static
+#endif
+bool X86_trySimpleOutput(cs_struct *handle, const uint8_t *code, size_t size,
+			 cs_insn *insn, uint16_t *insn_size)
+#endif
+{
+#ifdef X86_FIXED_OUTPUT
+	const bool wide = X86_FIXED_WIDE;
+#else
+	const bool wide = handle->mode == CS_MODE_64;
+#endif
+	const bool has_rex = wide && (code[0] & 0xf0) == 0x40;
+	const uint8_t rex = has_rex ? code[0] : 0;
+	const bool escaped = code[0] == 0x0f;
+	const unsigned lead = has_rex || escaped;
+	if (size <= lead)
+		return false;
+	const uint8_t opcode = code[lead];
+	const unsigned prefix_class = escaped ? 3 :
+				      has_rex ? ((rex & 8) ? 2 : 1) :
+						0;
+	const unsigned plan = x86_simple_plans[wide][prefix_class][opcode];
+	if (!plan) {
+#ifdef X86_OUTPUT_MISS
+		return X86_OUTPUT_MISS(handle, code, size, insn, insn_size);
+#else
+		return false;
+#endif
+	}
+	const unsigned form = plan & 3;
+	uint8_t modrm = 0;
+	bool base_memory = false;
+	if (form == X86_SIMPLE_RM_REG || form == X86_SIMPLE_REG_RM) {
+		if (size < 2u + has_rex)
+			return false;
+		modrm = code[1 + has_rex];
+#ifdef X86_FIXED_INDIRECT
+		if (opcode == 0xff &&
+		    ((modrm & 0x38) == 0x10 || (modrm & 0x38) == 0x20)) {
+			if (X86_OUTPUT_UNSUPPORTED(handle, false))
+				return false;
+			return X86_FIXED_INDIRECT(code, size, insn, insn_size,
+						  rex, modrm);
+		}
+#endif
+		if (modrm < 0xc0) {
+			/* The generated ALU, TEST and MOV register rows also
+             * describe their memory forms. XCHG and immediates
+             * require different memory records. */
+			const bool alu = opcode < 0x40;
+			const bool test_or_mov = (opcode & 0xfe) == 0x84 ||
+						 (opcode & 0xfc) == 0x88;
+#ifdef X86_MEMORY32_OUTPUT
+			const unsigned group = (modrm >> 3) & 7;
+			const bool single =
+				opcode == 0xff &&
+				(group == 2 || group == 4 || group == 6);
+#else
+			const bool single = opcode == 0xff &&
+					    (modrm & 0x38) == 0x30;
+#endif
+			if (!alu && !test_or_mov && opcode != 0x8d && !single)
+				return false;
+			base_memory = true;
+		} else if (opcode == 0x8d || opcode == 0xff) {
+			return false;
+		}
+	}
+	if (X86_OUTPUT_UNSUPPORTED(handle, !wide && handle->mode != CS_MODE_32))
+		return false;
+
+	if (plan >= X86_PLAN_PUSH_IMMEDIATE) {
+		if (plan == X86_PLAN_VECTOR) {
+#ifdef X86_FIXED_VEX2
+			if (code[0] == 0xc5)
+				return X86_FIXED_VEX2(code, size, insn,
+						      insn_size);
+#endif
+			return X86_writeVectorOutput(code, size, insn,
+						     insn_size,
+						     x86_simple_registers[3],
+						     wide);
+		}
+		unsigned row;
+		const struct X86SimpleRegister *reg = NULL;
+		if (plan == X86_PLAN_PUSH_IMMEDIATE) {
+			const bool imm8 = opcode == 0x6a;
+			if (size < (imm8 ? 2u : 5u))
+				return false;
+			row = x86_push_rows[wide][imm8];
+		} else if (plan == X86_PLAN_MOV_REG_IMM32) {
+			if (size < 5u + has_rex)
+				return false;
+			row = x86_simple_plans[wide][prefix_class][0x8b] >> 2;
+			reg = &x86_simple_registers[2][((rex & 1) << 3) |
+						       (opcode & 7)];
+		} else {
+			if (size < (opcode == 0x81 ? 6u : 3u) + has_rex)
+				return false;
+			const unsigned group = (modrm >> 3) & 7;
+			row = plan == X86_PLAN_SHIFT_IMM8 ?
+				      x86_shift_rows[wide][prefix_class][group] :
+				      x86_simple_plans[wide][prefix_class]
+						      [(group << 3) | 1] >>
+					      2;
+			reg = &x86_simple_registers[(rex & 8) ? 3 : 2]
+						   [((rex & 1) << 3) |
+						    (modrm & 7)];
+		}
+		X86_writeImmediateOutput(code, insn, insn_size, rex,
+					 &x86_simple_outputs[row], reg);
+		return true;
+	}
+	const struct X86SimpleOutput *row = &x86_simple_outputs[plan >> 2];
+	if (base_memory) {
+#ifdef X86_MEMORY32_OUTPUT
+		if (opcode == 0xff && (modrm & 0x38) != 0x30)
+			row = &x86_indirect_memory[(modrm & 0x20) != 0];
+		return X86_MEMORY32_OUTPUT(code, size, insn, insn_size, row,
+					   x86_simple_registers);
+#else
+		return X86_writeMemoryOutput(code, size, insn, insn_size, row,
+					     x86_simple_registers);
+#endif
+	}
+	const bool relative = form == X86_SIMPLE_RELATIVE;
+	if (relative && size < (size_t)row->imm_offset + row->imm_size)
+		return false;
+	uint64_t target = 0;
+	uint16_t first = row->ops[0].reg, second = row->ops[1].reg;
+	insn->id = row->id;
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	insn->bytes[0] = code[0];
+	if (form == X86_SIMPLE_FIXED) {
+		if (has_rex) {
+			// REX-prefixed fixed rows describe low and extended stack registers.
+			row += rex & 1;
+			first = row->ops[0].reg;
+			insn->bytes[1] = opcode;
+		}
+		memcpy(insn->op_str, row->operands, sizeof(row->operands));
+		*insn_size = insn->size = (uint16_t)(1 + has_rex);
+	} else if (relative) {
+		const uint8_t *bytes = code + row->imm_offset;
+		int64_t delta;
+		if (row->imm_size == 1) {
+			delta = (int8_t)bytes[0];
+		} else {
+			uint32_t raw = (uint32_t)bytes[0] |
+				       ((uint32_t)bytes[1] << 8) |
+				       ((uint32_t)bytes[2] << 16) |
+				       ((uint32_t)bytes[3] << 24);
+			delta = (int32_t)raw;
+		}
+		const uint16_t length = row->imm_offset + row->imm_size;
+		target = X86_relativeBranchTarget(handle->mode, insn->address,
+						  length, delta, row->imm_size);
+		if (target <= HEX_THRESHOLD) {
+			insn->op_str[0] = (char)('0' + target);
+		} else {
+			char digits[16];
+			char *end = digits + sizeof(digits);
+			char *p = end;
+			uint64_t value = target;
+			do {
+				*--p = "0123456789abcdef"[value & 15];
+				value >>= 4;
+			} while (value);
+			insn->op_str[0] = '0';
+			insn->op_str[1] = 'x';
+			memcpy(insn->op_str + 2, p, (size_t)(end - p));
+		}
+		memcpy(insn->bytes, code, length);
+		*insn_size = insn->size = length;
+	} else {
+		const unsigned width = (opcode & 1) ? ((rex & 8) ? 3 : 2) :
+						      has_rex;
+		const unsigned reg = ((rex & 4) << 1) | ((modrm >> 3) & 7);
+		const unsigned rm = ((rex & 1) << 3) | (modrm & 7);
+		const struct X86SimpleRegister *regs =
+			x86_simple_registers[width];
+		const struct X86SimpleRegister *a =
+			&regs[form == X86_SIMPLE_REG_RM ? reg : rm];
+		const struct X86SimpleRegister *b =
+			&regs[form == X86_SIMPLE_REG_RM ? rm : reg];
+		memcpy(insn->op_str, a->name, sizeof(a->name));
+		char *separator = insn->op_str + a->length;
+		separator[0] = ',';
+		separator[1] = ' ';
+		memcpy(separator + 2, b->name, sizeof(b->name));
+		first = a->reg;
+		second = b->reg;
+		insn->bytes[1] = code[1];
+		if (has_rex)
+			insn->bytes[2] = code[2];
+		*insn_size = insn->size = 2 + has_rex;
+	}
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, opcode, rex, modrm,
+				      first, second);
+		if (relative) {
+			cs_x86 *x = &insn->detail->x86;
+			if (escaped) {
+				x->opcode[0] = 0x0f;
+				x->opcode[1] = opcode;
+			}
+			x->operands[0].type = X86_OP_IMM;
+			x->operands[0].imm = (int64_t)target;
+		}
+	}
+	return true;
+}
+
+#endif
diff --git a/arch/X86/X86Sse64Output.c b/arch/X86/X86Sse64Output.c
new file mode 100644
index 00000000..53bef3f7
--- /dev/null
+++ b/arch/X86/X86Sse64Output.c
@@ -0,0 +1,255 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+/* Keep this static text iterator in its own ELF sections. */
+#if defined(__ELF__) && defined(__clang__)
+#pragma clang section text = ".cs_x86_amd64_text" rodata = \
+	".cs_x86_amd64_rodata"
+#endif
+#include "../../cs_priv.h"
+#include "X86ScanAdapter.h"
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#include "X86OutputOptions.h"
+#define X86_FIXED_VEX2 writeVex2Memory64
+#include "X86SimpleOutput.h"
+#include "X86GenSimpleOutput.inc"
+#include "X86VectorRegisterWriter.h"
+#define X86_MEMORY_IMMEDIATE writeMemoryImmediate64
+#define X86_IMMEDIATE_WIDE 1
+#include "X86MemoryOutputImpl.h"
+#undef X86_IMMEDIATE_WIDE
+#undef X86_MEMORY_IMMEDIATE
+
+struct X86SseRegisterOutput {
+	struct X86SimpleOutput output;
+	bool reverse;
+	bool base_memory;
+};
+#include "X86GenSse64RegisterOutput.inc"
+#include "X86GenVex64PackedMemory.inc"
+
+#ifdef CAPSTONE_X86_NEAR_INDIRECT_OUTPUT
+#include "X86GenIndirect64Output.inc"
+
+/* FF /2 and /4 have one explicit 64-bit target. The register and memory
+ * forms share their generated access, implicit register and group records. */
+static bool writeIndirect64(const uint8_t *code, size_t size, cs_insn *insn,
+			    uint16_t *insn_size, uint8_t rex, uint8_t modrm)
+{
+	const struct X86SimpleOutput *row =
+		&x86_indirect64[rex != 0][(modrm & 0x20) != 0];
+	if (modrm < 0xc0)
+		return X86_writeMemoryOutput(code, size, insn, insn_size, row,
+					     x86_simple_registers);
+	const struct X86SimpleRegister *reg =
+		&x86_simple_registers[3][((rex & 1) << 3) | (modrm & 7)];
+	*insn_size = insn->size = (uint16_t)(2 + (rex != 0));
+	insn->id = row->id;
+	memcpy(insn->bytes, code, insn->size);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, reg->name, sizeof(reg->name));
+	if (insn->detail)
+		X86_writeSimpleDetail(insn->detail, row, 0xff, rex, modrm,
+				      reg->reg, 0);
+	return true;
+}
+
+#define X86_FIXED_INDIRECT writeIndirect64
+#endif
+
+static bool writePackedMemory(const uint8_t *code, cs_insn *insn,
+			      uint16_t *insn_size,
+			      const struct X86SseRegisterOutput *entry,
+			      uint8_t rex, unsigned offset, size_t size,
+			      bool vex)
+{
+	const uint8_t mr = code[offset - 1], opcode = code[offset - 2];
+	const unsigned number = ((mr >> 3) & 7) | ((rex & 4) << 1);
+	const unsigned mod = mr >> 6, rm = mr & 7;
+	const bool rip = !mod && rm == 5, sib = rm == 4;
+	const unsigned disp_size = mod == 2 || rip ? 4 : mod;
+	const unsigned disp_offset = offset + sib,
+		       length = disp_offset + disp_size;
+	if (size < length || (sib && ((rex & 2) || code[offset] != 0x24)))
+		return false;
+	const int32_t disp = disp_size == 4 ?
+				     X86_readDisp32(code + disp_offset) :
+			     disp_size == 1 ? (int8_t)code[disp_offset] :
+					      0;
+	const struct X86SimpleRegister *base =
+		&x86_simple_registers[3][((rex & 1) << 3) | rm];
+	const struct X86SimpleOutput *row = &entry->output;
+	insn->size = *insn_size = (uint16_t)length;
+	insn->id = row->id;
+	memcpy(insn->bytes, code, insn->size);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	const unsigned ll = vex && (code[1] & 4);
+	char *out = insn->op_str;
+	if (!entry->reverse) {
+		out = writeVectorRegister(out, ll, number);
+		memcpy(out, ", ", 2);
+		out += 2;
+	}
+	memcpy(out, "xmmword ptr [", 13);
+	if (ll)
+		*out = 'y';
+	out += 13;
+	if (rip) {
+		memcpy(out, "rip", 3);
+		out += 3;
+	} else {
+		memcpy(out, base->name, base->length);
+		out += base->length;
+	}
+	out = X86_writeDisplacement(out, disp);
+	*out++ = ']';
+	if (entry->reverse) {
+		memcpy(out, ", ", 2);
+		writeVectorRegister(out + 2, ll, number);
+	}
+	if (insn->detail) {
+		const uint16_t reg =
+			(uint16_t)((ll ? X86_REG_YMM0 : X86_REG_XMM0) + number);
+		X86_writeSimpleDetail(insn->detail, row, 0x0f, rex, mr,
+				      entry->reverse ? 0 : reg,
+				      entry->reverse ? reg : 0);
+		cs_x86 *x = &insn->detail->x86;
+		if (vex) {
+			memcpy(x->opcode, code, 2);
+		} else {
+			x->opcode[1] = opcode;
+		}
+		x->encoding.modrm_offset = (uint8_t)(offset - 1);
+		if (disp_size) {
+			x->encoding.disp_offset = (uint8_t)disp_offset;
+			x->encoding.disp_size = (uint8_t)disp_size;
+		}
+		if (sib) {
+			x->sib = 0x24;
+			x->sib_base = (x86_reg)base->reg;
+			x->sib_scale = 1;
+		}
+		x->disp = disp;
+		cs_x86_op *op = &x->operands[entry->reverse ? 0 : 1];
+		op->type = X86_OP_MEM;
+		op->mem.base = rip ? X86_REG_RIP : (x86_reg)base->reg;
+		op->mem.scale = 1;
+		op->mem.disp = disp;
+	}
+	return true;
+}
+
+/* Only the bare VEX2 opcode plan enters here. Packed base-relative
+ * loads and stores share their address and detail construction with SSE. */
+static bool writeVex2Memory64(const uint8_t *code, size_t size, cs_insn *insn,
+			      uint16_t *insn_size)
+{
+	if (size >= 4 && (code[1] & 0x78) == 0x78 && code[3] < 0xc0) {
+		unsigned plan = vex64_packed_plans[code[1] & 7][code[2]];
+		const uint8_t rex =
+			(uint8_t)(0x40 | ((~(unsigned)code[1] >> 5) & 4));
+		if (plan && writePackedMemory(code, insn, insn_size,
+					      &vex64_packed_rows[plan], rex, 4,
+					      size, true))
+			return true;
+	}
+	return X86_writeVectorOutput(code, size, insn, insn_size,
+				     x86_simple_registers[3], true);
+}
+
+/* The scalar plans have already declined this instruction. A single opcode
+ * lookup supplies the mnemonic, operand order and all implicit effects. */
+static bool writeExtraOutput64(cs_struct *handle, const uint8_t *code,
+			       size_t size, cs_insn *insn, uint16_t *insn_size)
+{
+	const bool has_rex = (code[0] & 0xf0) == 0x40;
+	const unsigned length = 3 + has_rex;
+	if (size < length)
+		return false;
+	const uint8_t primary = code[has_rex];
+	if (primary != 0x0f) {
+		const uint8_t mr = code[has_rex + 1];
+		if ((primary & 0xfe) != 0xc6 || mr >= 0xc0 || (mr & 0x38) ||
+		    X86_OUTPUT_UNSUPPORTED(handle, false))
+			return false;
+		const unsigned prefix_class =
+			has_rex ? ((code[0] & 8) ? 2 : 1) : 0;
+		/* The MOV store row carries its operand width and access. */
+		const unsigned row = x86_simple_plans[1][prefix_class]
+						     [0x88 | (primary & 1)] >>
+				     2;
+		return writeMemoryImmediate64(code, size, insn, insn_size,
+					      &x86_simple_outputs[row],
+					      x86_simple_registers);
+	}
+	const uint8_t opcode = code[length - 2];
+	const unsigned index = opcode - X86_SSE_REGISTER_FIRST;
+	if (index >= sizeof(x86_sse_register_outputs) /
+			     sizeof(x86_sse_register_outputs[0]))
+		return false;
+	const struct X86SseRegisterOutput *entry =
+		&x86_sse_register_outputs[index];
+	const struct X86SimpleOutput *row = &entry->output;
+	if (!row->id || X86_OUTPUT_UNSUPPORTED(handle, false))
+		return false;
+
+	const uint8_t rex = has_rex ? code[0] : 0, mr = code[length - 1];
+	if (mr < 0xc0)
+		return entry->base_memory &&
+		       writePackedMemory(code, insn, insn_size, entry, rex,
+					 length, size, false);
+	const unsigned reg = ((mr >> 3) & 7) | ((rex & 4) << 1);
+	const unsigned rm = (mr & 7) | ((rex & 1) << 3);
+	const unsigned first = entry->reverse ? rm : reg,
+		       second = entry->reverse ? reg : rm;
+	*insn_size = insn->size = (uint16_t)length;
+	insn->id = row->id;
+	memcpy(insn->bytes, code, length);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *next = writeVectorRegister(insn->op_str, 0, first);
+	memcpy(next, ", ", 2);
+	writeVectorRegister(next + 2, 0, second);
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, 0x0f, rex, mr,
+				      (uint16_t)(X86_REG_XMM0 + first),
+				      (uint16_t)(X86_REG_XMM0 + second));
+		insn->detail->x86.opcode[1] = opcode;
+		insn->detail->x86.encoding.modrm_offset = (uint8_t)(length - 1);
+	}
+	return true;
+}
+
+#define X86_FIXED_OUTPUT tryOutput64
+#define X86_FIXED_WIDE true
+#define X86_OUTPUT_MISS writeExtraOutput64
+#include "X86SimpleOutputImpl.h"
+#undef X86_OUTPUT_MISS
+#undef X86_FIXED_WIDE
+#undef X86_FIXED_OUTPUT
+#define CS_DECODE_TRY_OUTPUT tryOutput64
+#include "../../cs_disasm_internal.h"
+#endif
+
+CAPSTONE_INTERNAL bool X86_disasmIterText(csh ud, const uint8_t **code,
+					  size_t *size, uint64_t *address,
+					  cs_insn *insn)
+{
+#ifdef CS_DECODE_TRY_OUTPUT
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (handle && handle->arch == CS_ARCH_X86 &&
+	    handle->mode == CS_MODE_64 && !handle->no_text)
+		return cs_disasm_iter_core(ud, code, size, address, insn);
+#endif
+	return X86_disasmIter32(ud, code, size, address, insn);
+}
+#endif
diff --git a/arch/X86/X86UnsignedImmediate.h b/arch/X86/X86UnsignedImmediate.h
new file mode 100644
index 00000000..6f3953cc
--- /dev/null
+++ b/arch/X86/X86UnsignedImmediate.h
@@ -0,0 +1,26 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifndef CS_X86_UNSIGNED_IMMEDIATE_H
+#define CS_X86_UNSIGNED_IMMEDIATE_H
+
+static char *writeUnsignedImmediate(char *out, uint64_t value)
+{
+	if (value <= HEX_THRESHOLD) {
+		*out = (char)('0' + value);
+		return out + 1;
+	} else {
+		static const char digits[] = "0123456789abcdef";
+		char temp[16], *end = temp + sizeof(temp), *start = end;
+		uint64_t n = value;
+		do {
+			*--start = digits[n & 15];
+			n >>= 4;
+		} while (n);
+		memcpy(out, "0x", 2);
+		memcpy(out + 2, start, end - start);
+		return out + 2 + (end - start);
+	}
+}
+
+#endif
