{
  "repository": "NeverSight/NeverD",
  "url": "https://github.com/NeverSight/NeverD.git",
  "ref": "refs/heads/dev",
  "runners": [
    "macos-15",
    "macos-26",
    "xcode-27"
  ],
  "timeout_minutes": 12,
  "policy": "scripts/verify_arm64e_native.def",
  "verifier": "scripts/verify_arm64e_native.py",
  "hardware_command": [
    "/usr/sbin/sysctl",
    "-n",
    "machdep.cpu.brand_string"
  ],
  "summary": "### {hardware}\n\nNative verifier result **{status}** at `{revision}`.\n",
  "complete_summary": "\narm64e.x1 execution environment qualified `{environment}`. Full qualification including 128-bit LRCPC3 **{complete}**.\n",
  "control_command": [
    "-m", "unittest", "-v",
    "scripts.tests.test_verify_arm64e_native.Arm64eNativeQualificationTests.test_native_scalar_instruction_sites_and_results",
    "scripts.tests.test_verify_arm64e_native.Arm64eNativeQualificationTests.test_native_writeback_rejects_constant_load_and_store",
    "scripts.tests.test_verify_arm64e_native.Arm64eNativeQualificationTests.test_x1_cursor_requires_signed_subtype_and_consistent_execution",
    "scripts.tests.test_verify_arm64e_native.Arm64eNativeQualificationTests.test_native_explicit_cursor_requires_both_instruction_sites",
    "scripts.tests.test_verify_arm64e_native.Arm64eNativeQualificationTests.test_native_cursor_requires_all_samples_for_each_key",
    "scripts.tests.test_verify_arm64e_native.Arm64eNativeQualificationTests.test_ordered_q_lane_and_signal_controls_with_baseline_instructions",
    "scripts.tests.test_verify_arm64e_native.Arm64eNativeQualificationTests.test_native_projection_probe_instruction_sites_and_key_modes"
  ],
  "control_log": "native-probe-controls.log",
  "feature_rows": [
    ["ordered_probe", "qualified_key", "128-bit LRCPC3"],
    ["cursor_probe", "explicit_key", "Two-modifier PAuth_LR on arm64e"],
    ["cursor_probe", "pacm_pc_key", "PC-sensitive PACM on arm64e"],
    ["x1_cursor_probe", "explicit_key", "Two-modifier PAuth_LR on arm64e.x1"],
    ["x1_cursor_probe", "pacm_pc_key", "PC-sensitive PACM on arm64e.x1"],
    ["cursor_probe", "pacm_hint_key", "PACM HINT with active IA and IB"],
    ["cpta_probe", "scalar_qualified_key", "EL0 checked scalar arithmetic on arm64e.x1"],
    ["cpta_probe", "product_qualified_key", "EL0 checked signed-product overflow on arm64e.x1"],
    ["cpta_probe", "writeback_qualified_key", "EL0 checked writeback on arm64e.x1"]
  ],
  "feature_heading": "\n| Native observation | Result |\n| --- | --- |",
  "feature_row": "\n| {feature} | {result} |",
  "unmeasured": "unmeasured",
  "missing_heading": "\nThe runner did not qualify these features.\n",
  "inconsistent_result": "The native report, source revision and verifier exit status disagree."
}
