{
  "repository": "NeverSight/NeverD",
  "remote": "https://github.com/NeverSight/NeverD.git",
  "ref": "refs/heads/{branch}",
  "revision_command": ["git", "rev-parse", "HEAD"],
  "source_branch": "dev",
  "source_env": "SOURCE_BRANCH",
  "revision_env": "SOURCE_REVISION",
  "resolve": "resolve",
  "host_mode": "hosts",
  "host_catalog": "HostedX1.def",
  "x1_runner": "xcode-27",
  "runner_env": "PROJECTION_RUNNER",
  "x1_artifact": "signed-x1-projection-results",
  "ordered_artifact": "ordered-x1-projection-results-{runner}",
  "build": "build",
  "check": "check",
  "build_dir": "build",
  "inputs_dir": "inputs",
  "report_dir": "measurements",
  "target": "NeverDArm64eAnalysisTests",
  "verifier": "scripts/verify_arm64e_x1_projections.py",
  "package": "neverd-llvm-v23.0.0-r6",
  "package_sha256": "ffada4ba7a77b9394d02665dc1893f378a82f076af0ea057157d9cbfaab40fad",
  "dependencies": ["git", "submodule", "update", "--init", "--depth", "1", "--", "third_party/capstone", "third_party/unicorn", "signatures"],
  "configure": ["cmake", "-S", ".", "-B", "{build}", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DBUILD_TESTING=ON", "-DNEVERD_BUILD_GUI=OFF", "-DNEVERD_BUILD_AGENT=OFF", "-DNEVERD_BUILD_WORKER=OFF", "-DNEVERD_ENABLE_WEB_ANALYSIS=OFF", "-DNEVERD_LLVM_PREBUILT=ON", "-DNEVERD_LLVM_PREBUILT_TAG={package}", "-DNEVERD_LLVM_PREBUILT_SHA256={package_sha256}"],
  "compile": ["scripts/build.py", "{build}", "--target", "{target}", "--parallel", "3"],
  "export_args": ["export", "--tests", "{build}/bin/{target}", "--output", "{inputs}"],
  "check_args": ["check", "--inputs", "{inputs}", "--output", "{output}"],
  "report": "report.json",
  "summary": "Signed arm64e.x1 projections on {hardware} at {revision}. Linked and verified {images} images. Executed {executed} comparisons.",
  "cpu": ["/usr/sbin/sysctl", "-n", "machdep.cpu.brand_string"],
  "host_report": "host.json",
  "model_policy": "scripts/verify_arm64e_return_model.def",
  "native_policy": "scripts/verify_arm64e_native.def",
  "acceptance_summary": "Same-host native acceptance on {hardware} at {revision} was {status} (exit {code}). Original controls qualified: {controls}. Generated comparisons completed: {executed}/{images}.",
  "ordered_count": "ordered_routes",
  "ordered_summary": "Measured {ordered_routes} generated ordered-memory routes. GPR execution was {gpr_executed}. 128-bit LRCPC3 execution was {simd_executed}.",
  "ordered_error": "generated ordered-memory inputs, observations or native Q control disagree",
  "acceptance_error": "inconsistent native qualification reports or verifier exit status",
  "compared": "compared",
  "link_error": "projection build did not link the complete image inventory",
  "revision_error": "projection checkout does not match the resolved branch"
}
