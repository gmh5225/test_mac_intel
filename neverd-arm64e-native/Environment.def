{
  "source_repository": "NeverSight/NeverD",
  "source_revision": "3e5fb93c816902d4b9893c1a54ffb353e3e3f117",
  "runners": [
    "macos-26",
    "xcode-27"
  ],
  "revision_command": [
    "git",
    "rev-parse",
    "HEAD"
  ],
  "build_directory": "build-arm64e-native",
  "source_argument": "--source",
  "output_argument": "--output",
  "termination_code": 143,
  "report_name": "environment-report.json",
  "log_suffix": ".log",
  "qualification_report": "installation/report.json",
  "build_diagnostics_directory": "build-diagnostics",
  "build_diagnostics": [
    "CMakeCache.txt",
    "CMakeFiles/CMakeConfigureLog.yaml"
  ],
  "errors": {
    "revision": "Checked-out NeverD revision differs from the pinned native source",
    "existing_build": "Native environment build directory already exists; preserve it and use a fresh checkout",
    "qualification": "Native installation did not publish a successful qualification",
    "startup": "Native startup did not qualify the explicit userspace fixup profile",
    "executable": "Native executable publication requires successful same-source tests bound to the startup probe"
  },
  "stages": [
    {
      "name": "preflight",
      "timeout": 300,
      "argv": [
        "python3",
        "scripts/verify_arm64e_native.py",
        "probe",
        "--output",
        "{output}/probe"
      ]
    },
    {
      "name": "startup-preflight",
      "timeout": 300,
      "argv": [
        "python3",
        "scripts/verify_arm64e_native.py",
        "probe-startup",
        "--startup-fixups",
        "userspace",
        "--output",
        "{output}/startup"
      ]
    },
    {
      "name": "build-tools",
      "timeout": 900,
      "argv": [
        "brew",
        "install",
        "cmake",
        "lld",
        "ninja",
        "llvm@22"
      ]
    },
    {
      "name": "dependencies",
      "timeout": 1200,
      "argv": [
        "git",
        "submodule",
        "update",
        "--init",
        "--recursive",
        "--depth",
        "1",
        "third_party/capstone",
        "third_party/unicorn",
        "signatures",
        "third_party/highway",
        "third_party/simdutf",
        "third_party/simdjson",
        "third_party/mimalloc",
        "third_party/oneTBB"
      ]
    },
    {
      "name": "configure",
      "timeout": 900,
      "argv": [
        "cmake",
        "-S",
        "{source}",
        "-B",
        "{build}",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_TESTING=ON",
        "-DNEVERD_BUILD_GUI=OFF",
        "-DNEVERD_LLVM_PREBUILT=ON"
      ]
    },
    {
      "name": "build",
      "timeout": 3000,
      "argv": [
        "python3",
        "scripts/build.py",
        "{build}",
        "--target",
        "NeverDArm64eAnalysisTests",
        "NeverDMachOSignerTests",
        "NeverDMachOSignaturePolicyTests",
        "--parallel",
        "4"
      ]
    },
    {
      "name": "signing",
      "timeout": 300,
      "argv": [
        "ctest",
        "--test-dir",
        "{build}",
        "--build-config",
        "Release",
        "-L",
        "^NeverDMachO(Signer|SignaturePolicy)Tests$",
        "--output-on-failure",
        "--output-junit",
        "{output}/signing.xml",
        "--parallel",
        "4"
      ]
    },
    {
      "name": "installation",
      "timeout": 1800,
      "argv": [
        "python3",
        "scripts/verify_arm64e_native.py",
        "run",
        "--build-dir",
        "{build}",
        "--probe-report",
        "{output}/probe/report.json",
        "--output",
        "{output}/installation",
        "--legacy-fixtures",
        "{source}/../legacy-fixtures"
      ]
    },
    {
      "name": "executable-publication",
      "timeout": 900,
      "argv": [
        "python3",
        "scripts/verify_arm64e_native.py",
        "run-executable",
        "--build-dir",
        "{build}",
        "--probe-report",
        "{output}/startup/report.json",
        "--output",
        "{output}/executable"
      ]
    }
  ],
  "legacy_runner": "macos-15",
  "startup_report": "startup/report.json",
  "startup_qualification_key": "compiler_original_startup_qualified",
  "publication_qualification_key": "native_object_publication_qualified",
  "startup_fixup_loader": "userspace",
  "startup_fixup_loader_key": "startup_fixup_loader",
  "startup_qualification_hash_key": "startup_qualification_sha256",
  "native_timeout_minutes": 75,
  "executable_report": "executable/report.json",
  "executable_qualification_key": "native_executable_publication_qualified",
  "executable_qualification_hash_key": "executable_qualification_sha256"
}
