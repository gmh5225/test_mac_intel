{
  "source_repository": "NeverSight/NeverD",
  "source_revision": "eabb96c44b7abaac2f628851968c05a090de5b5d",
  "runners": [
    "macos-26",
    "xcode-27"
  ],
  "revision_command": [
    "git",
    "rev-parse",
    "HEAD"
  ],
  "build_directory": "build-arm64e-native",
  "source_argument": "--source",
  "output_argument": "--output",
  "termination_code": 143,
  "report_name": "environment-report.json",
  "log_suffix": ".log",
  "qualification_report": "installation/report.json",
  "build_diagnostics_directory": "build-diagnostics",
  "build_diagnostics": [
    "CMakeCache.txt",
    "CMakeFiles/CMakeConfigureLog.yaml"
  ],
  "errors": {
    "revision": "Checked-out NeverD revision differs from the pinned native source",
    "existing_build": "Native environment build directory already exists; preserve it and use a fresh checkout",
    "qualification": "Native installation did not publish a successful qualification",
    "startup": "Native startup did not qualify the explicit userspace fixup profile",
    "executable": "Native executable publication requires successful same-source tests bound to the startup probe",
    "default_executable": "Default system executable publication requires same-source PAC/unwind controls and a complete unsandboxed publication result",
    "generated": "Generated native publication requires exact source and system preflight identities, compiler provenance and a complete runtime matrix",
    "llvm_revision": "LLVM source does not match the pinned Darwin signed-return CFI producer"
  },
  "stages": [
    {
      "name": "preflight",
      "timeout": 300,
      "argv": [
        "python3",
        "scripts/verify_arm64e_native.py",
        "probe",
        "--output",
        "{output}/probe"
      ]
    },
    {
      "name": "startup-preflight",
      "timeout": 300,
      "argv": [
        "python3",
        "scripts/verify_arm64e_native.py",
        "probe-startup",
        "--startup-fixups",
        "userspace",
        "--output",
        "{output}/startup"
      ]
    },
    {
      "name": "build-tools",
      "timeout": 900,
      "argv": [
        "brew",
        "install",
        "cmake",
        "lld",
        "ninja",
        "llvm@22"
      ]
    },
    {
      "name": "dependencies",
      "timeout": 1200,
      "argv": [
        "git",
        "submodule",
        "update",
        "--init",
        "--recursive",
        "--depth",
        "1",
        "third_party/capstone",
        "third_party/unicorn",
        "signatures",
        "third_party/highway",
        "third_party/simdutf",
        "third_party/simdjson",
        "third_party/mimalloc",
        "third_party/oneTBB",
        "third_party/llvm-project"
      ]
    },
    {
      "name": "llvm-fetch",
      "timeout": 1200,
      "argv": [
        "git",
        "-C",
        "third_party/llvm-project",
        "fetch",
        "--depth",
        "1",
        "origin",
        "{llvm_revision}"
      ]
    },
    {
      "name": "llvm-source",
      "timeout": 300,
      "argv": [
        "git",
        "-C",
        "third_party/llvm-project",
        "checkout",
        "--detach",
        "{llvm_revision}"
      ]
    },
    {
      "name": "configure",
      "timeout": 900,
      "argv": [
        "cmake",
        "-S",
        "{source}",
        "-B",
        "{build}",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_TESTING=ON",
        "-DNEVERD_BUILD_GUI=OFF",
        "-DNEVERD_LLVM_PREBUILT=OFF"
      ]
    },
    {
      "name": "build",
      "timeout": 9000,
      "argv": [
        "python3",
        "scripts/build.py",
        "{build}",
        "--target",
        "NeverDArm64eAnalysisTests",
        "NeverDMachOSignerTests",
        "NeverDMachOSignaturePolicyTests",
        "--parallel",
        "4"
      ]
    },
    {
      "name": "signing",
      "timeout": 300,
      "argv": [
        "ctest",
        "--test-dir",
        "{build}",
        "--build-config",
        "Release",
        "-L",
        "^NeverDMachO(Signer|SignaturePolicy)Tests$",
        "--output-on-failure",
        "--output-junit",
        "{output}/signing.xml",
        "--parallel",
        "4"
      ]
    },
    {
      "name": "installation",
      "timeout": 1800,
      "argv": [
        "python3",
        "scripts/verify_arm64e_native.py",
        "run",
        "--build-dir",
        "{build}",
        "--probe-report",
        "{output}/probe/report.json",
        "--output",
        "{output}/installation",
        "--legacy-fixtures",
        "{source}/../legacy-fixtures"
      ]
    },
    {
      "name": "executable-publication",
      "timeout": 900,
      "argv": [
        "python3",
        "scripts/verify_arm64e_native.py",
        "run-executable",
        "--build-dir",
        "{build}",
        "--probe-report",
        "{output}/startup/report.json",
        "--output",
        "{output}/executable"
      ]
    },
    {
      "name": "default-executable-publication",
      "timeout": 900,
      "argv": [
        "python3",
        "scripts/verify_arm64e_native.py",
        "run-default-executable",
        "--build-dir",
        "{build}",
        "--probe-report",
        "{output}/probe/report.json",
        "--output",
        "{output}/default-executable"
      ]
    },
    {
      "name": "generated-publication",
      "timeout": 900,
      "argv": [
        "python3",
        "scripts/verify_arm64e_native.py",
        "run-generated",
        "--build-dir",
        "{build}",
        "--probe-report",
        "{output}/probe/report.json",
        "--ir-compiler",
        "{ir_compiler}",
        "--output",
        "{output}/generated"
      ]
    },
    {
      "name": "generated-executable-publication",
      "timeout": 900,
      "argv": [
        "python3",
        "scripts/verify_arm64e_native.py",
        "run-generated-executable",
        "--build-dir",
        "{build}",
        "--probe-report",
        "{output}/probe/report.json",
        "--ir-compiler",
        "{ir_compiler}",
        "--output",
        "{output}/generated-executable"
      ]
    }
  ],
  "legacy_runner": "macos-15",
  "startup_report": "startup/report.json",
  "startup_qualification_key": "compiler_original_startup_qualified",
  "publication_qualification_key": "native_object_publication_qualified",
  "startup_fixup_loader": "userspace",
  "startup_fixup_loader_key": "startup_fixup_loader",
  "startup_qualification_hash_key": "startup_qualification_sha256",
  "native_timeout_minutes": 180,
  "executable_report": "executable/report.json",
  "executable_qualification_key": "native_executable_publication_qualified",
  "executable_qualification_hash_key": "executable_qualification_sha256",
  "default_executable_report": "default-executable/report.json",
  "default_executable_qualification_key": "native_default_executable_publication_qualified",
  "default_executable_qualification_hash_key": "default_executable_qualification_sha256",
  "default_fixup_loader": "system",
  "probe_report": "probe/report.json",
  "ir_compiler_prefix_command": [
    "brew",
    "--prefix",
    "llvm@22"
  ],
  "ir_compiler_suffix": "bin/clang++",
  "ir_compiler_timeout": 30,
  "generated_reports": [
    {
      "path": "generated/report.json",
      "key": "native_generated_ir_publication_qualified"
    },
    {
      "path": "generated-executable/report.json",
      "key": "native_generated_executable_publication_qualified"
    }
  ],
  "llvm_revision": "5676029e378c9e37adc16c8216a8e8453ffafcae",
  "llvm_directory": "third_party/llvm-project",
  "llvm_source_stage": "llvm-source"
}
