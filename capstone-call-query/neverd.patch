+va_t Decoder::directX86CallTarget(llvm::ArrayRef<uint8_t> Bytes,
+                                 va_t Addr) const {
+  va_t Target;
+  const uint16_t Length =
+      X86_scanCallTarget(Handle, Bytes.data(), Bytes.size(), Addr, &Target);
+  return Length && Length == Bytes.size() ? Target : InvalidVA;
+}
