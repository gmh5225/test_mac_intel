+  const BinaryImage &Img;
+  Decoder &Dec;
+  const Segment &Seg;
+  va_t End;
+  CodeInterval Known;
+  // Only the entries in [Index, Count) starting at Next are reusable.
+  std::array<uint32_t, 64> Instructions;
+  size_t Index = 0;
+  size_t Count = 0;
+  va_t Next = 0;
+};
 
