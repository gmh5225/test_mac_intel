diff --git a/docs/ARCHITECTURE.md b/docs/ARCHITECTURE.md
index 1aebfa2d..b62d9c02 100644
--- a/docs/ARCHITECTURE.md
+++ b/docs/ARCHITECTURE.md
@@ -780,6 +780,11 @@ custom formatter can observe partial detail or change options, so it retains
 the earlier assignments as well; kernel and custom-runtime builds retain that
 path too. AT&T keeps its separate ordering and mask handling.
 
+For VEX/EVEX floating-point and integer comparisons, the opcode mapping
+supplies the instruction ID for the operand family. The predicate can change
+the printed mnemonic or appear as an immediate. Scan, formatted and batch
+records carry the same instruction ID.
+
 The x86 postprinter finds the first memory operand and presence of mask
 registers in one pass. Broadcast and mask-only repairs reuse these facts, while
 narrowing, x87 and RCL repairs retain their original order and conditions.
diff --git a/include/capstone/capstone.h b/include/capstone/capstone.h
index 80f8ce9e..a95df08f 100644
--- a/include/capstone/capstone.h
+++ b/include/capstone/capstone.h
@@ -395,9 +395,8 @@ typedef enum cs_opt_type {
 	CS_OPT_LITBASE, ///< Xtensa, set the LITBASE value. LITBASE is set to 0 by default.
 	CS_OPT_TEXT, ///< Print instructions into mnemonic and op_str (default on).
 	///< With CS_OPT_OFF the printer does not run: mnemonic and op_str are
-	///< empty, operand detail is not filled, and an ID the printer adjusts
-	///< (an x86 compare with a predicate, say) is left unadjusted.  For a
-	///< caller that reads only an instruction's size, bytes and ID.
+	///< empty and operand detail is not filled. Instruction size, bytes
+	///< and the decoded instruction ID remain available.
 } cs_opt_type;
 
 /// Runtime option value (associated with option type above)
diff --git a/tests/unit/x86_evex_vpcmp_id.c b/tests/unit/x86_evex_vpcmp_id.c
index 1a30e853..ff35c5b8 100644
--- a/tests/unit/x86_evex_vpcmp_id.c
+++ b/tests/unit/x86_evex_vpcmp_id.c
@@ -49,6 +49,56 @@ static bool test_vpcmp(csh handle, bool expect_detail)
 	return success;
 }
 
+/* The printed predicate may vary while the operation remains scalar or
+ * packed, single or double precision. Both public decoding APIs expose it. */
+static bool test_float_compare_ids(csh handle, bool restore_detail)
+{
+	static const unsigned ids[] = { X86_INS_VCMPPS, X86_INS_VCMPPD,
+					X86_INS_VCMPSS, X86_INS_VCMPSD };
+	static const uint8_t predicates[] = { 0, 1, 6, 7, 15, 31, 32, 255 };
+	bool success = true;
+	for (unsigned int flags = 0; flags < 4; ++flags) {
+		if (cs_option(handle, CS_OPT_TEXT,
+			      flags & 1 ? CS_OPT_ON : CS_OPT_OFF) ||
+		    cs_option(handle, CS_OPT_DETAIL,
+			      flags & 2 ? CS_OPT_ON : CS_OPT_OFF))
+			return false;
+		cs_insn *slot = cs_malloc(handle);
+		if (!slot)
+			return false;
+		for (unsigned int form = 0; form < 4; ++form) {
+			uint8_t code[] = { 0xc5, (uint8_t)(0xe8 | form), 0xc2,
+					   0xc1, 0 };
+			for (size_t p = 0; p < sizeof(predicates); ++p) {
+				cs_insn *list = NULL;
+				const uint8_t *cursor = code;
+				size_t left = sizeof(code);
+				uint64_t address = 0;
+				code[4] = predicates[p];
+				size_t n = cs_disasm(handle, code, sizeof(code),
+						     0, 1, &list);
+				success &= check(
+					n == 1 && list->id == ids[form],
+					"allocated floating compare family");
+				cs_free(list, n);
+				success &= check(
+					cs_disasm_iter(handle, &cursor, &left,
+						       &address, slot) &&
+						slot->id == ids[form] &&
+						left == 0 &&
+						address == sizeof(code),
+					"iterator floating compare family");
+			}
+		}
+		cs_free(slot, 1);
+	}
+	return cs_option(handle, CS_OPT_TEXT, CS_OPT_ON) == CS_ERR_OK &&
+	       cs_option(handle, CS_OPT_DETAIL,
+			 restore_detail ? CS_OPT_ON | CS_OPT_DETAIL_REAL :
+					  CS_OPT_OFF) == CS_ERR_OK &&
+	       success;
+}
+
 int main(void)
 {
 	csh handle = 0;
@@ -57,6 +107,7 @@ int main(void)
 	if (!check(cs_open(CS_ARCH_X86, CS_MODE_64, &handle) == CS_ERR_OK,
 		   "open 64-bit mode"))
 		return 1;
+	success &= test_float_compare_ids(handle, false);
 	success &= test_vpcmp(handle, false);
 	if (!check(cs_option(handle, CS_OPT_DETAIL,
 			    CS_OPT_ON | CS_OPT_DETAIL_REAL) == CS_ERR_OK,
@@ -69,6 +120,7 @@ int main(void)
 	success &= check(cs_option(handle, CS_OPT_SYNTAX, CS_OPT_SYNTAX_ATT) ==
 				 CS_ERR_OK,
 			 "select AT&T syntax");
+	success &= test_float_compare_ids(handle, true);
 	success &= test_vpcmp(handle, true);
 #endif
 	cs_close(&handle);
diff --git a/tests/unit/x86_evex_vpcmp_mask_size.c b/tests/unit/x86_evex_vpcmp_mask_size.c
index 8942d52c..fb5c3fd9 100644
--- a/tests/unit/x86_evex_vpcmp_mask_size.c
+++ b/tests/unit/x86_evex_vpcmp_mask_size.c
@@ -151,6 +151,59 @@ static bool test_case(csh handle, const compare_family *family,
 	return success;
 }
 
+/* Predicate aliases and explicit immediates have the same family ID in
+ * the allocating API and in iterator records with printing disabled. */
+static bool test_family_ids(csh handle, const compare_family *family)
+{
+	uint8_t code[] = { 0x62, 0xf3, 0x6d, 0x28, 0x1f, 0xcb, 0 };
+	static const uint8_t predicates[] = { 0, 1, 2, 3,  4,  5,
+					      6, 7, 8, 31, 32, 255 };
+	bool success = true;
+	code[2] |= family->w ? 0x80 : 0;
+	code[4] = family->opcode;
+	for (unsigned flags = 0; flags < 4; ++flags) {
+		if (!check(cs_option(handle, CS_OPT_TEXT,
+				     flags & 1 ? CS_OPT_ON : CS_OPT_OFF) ==
+					   CS_ERR_OK &&
