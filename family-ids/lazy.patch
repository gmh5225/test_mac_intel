diff --git a/tests/unit/riscv_scan_options.c b/tests/unit/riscv_scan_options.c
index 44a891a2..49621bf8 100644
--- a/tests/unit/riscv_scan_options.c
+++ b/tests/unit/riscv_scan_options.c
@@ -3,6 +3,34 @@
 #include <capstone/capstone.h>
 #include <string.h>
 
+/* Every operand and displacement in these compressed classes is valid. */
+static bool checkCompressed(csh handle, cs_insn *insn)
+{
+	static const struct {
+		uint8_t quadrant, funct3;
+		unsigned int id;
+	} forms[] = {
+		{ 1, 5, RISCV_INS_C_J }, { 1, 6, RISCV_INS_C_BEQZ },
+		{ 1, 7, RISCV_INS_C_BNEZ },
+	};
+	for (unsigned i = 0; i < sizeof(forms) / sizeof(forms[0]); ++i) {
+		for (unsigned payload = 0; payload < 2048; ++payload) {
+			uint16_t bits = (forms[i].funct3 << 13) |
+					(payload << 2) | forms[i].quadrant;
+			uint8_t bytes[] = { (uint8_t)bits, (uint8_t)(bits >> 8) };
+			const uint8_t *code = bytes;
+			size_t remaining = sizeof(bytes);
+			uint64_t pc = 0xfffe;
+			if (!cs_disasm_iter(handle, &code, &remaining, &pc, insn) ||
+			    insn->id != forms[i].id || insn->size != 2 ||
+			    code != bytes + 2 || remaining || pc != 0x10000 ||
+			    memcmp(insn->bytes, bytes, 2))
+				return false;
+		}
+	}
+	return true;
+}
