+X86_DECODE_ALIGN
+CAPSTONE_INTERNAL X86ScanBatchResult X86_scanBatch(csh ud, const uint8_t *code,
+						   size_t size,
+						   uint64_t address,
+						   uint32_t *output,
+						   size_t capacity)
+{
+	X86ScanBatchResult batch = { 0, 0 };
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	if (!handle || !code || !size || !output || !capacity ||
+	    !use_x86_scan(handle) || handle->skipdata)
+		return batch;
+	handle->errnum = CS_ERR_OK;
+	if (handle->mode == CS_MODE_32)
+		return scanBatch32(ud, code, size, address, output, capacity);
+	return scanBatchOtherModes(ud, code, size, address, output, capacity);
+}
