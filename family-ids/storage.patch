diff --git a/arch/Mips/MipsMapping.c b/arch/Mips/MipsMapping.c
index a3561eb8..9f78fd0d 100644
--- a/arch/Mips/MipsMapping.c
+++ b/arch/Mips/MipsMapping.c
@@ -313,17 +313,56 @@ bool Mips_getInstruction(csh handle, const uint8_t *code, size_t code_len,
 {
 	uint64_t size64;
 	Mips_init_cs_detail(instr);
-/* These standard encodings have no extra operands to validate in a scan. */
-#ifdef MIPS_DIRECT_MAPPING
+/* Each bit below the primary opcode of these standard forms is an
+ * operand. The ordinary decoder handles all text, details and callbacks. */
+#if defined(CAPSTONE_MIPS_ONLY) && !defined(CAPSTONE_DIET)
+#define MIPS_STANDARD_SCAN
+#endif
+#if defined(MIPS_DIRECT_MAPPING) || defined(MIPS_STANDARD_SCAN)
 	const cs_mode mode = instr->csh->mode & ~CS_MODE_BIG_ENDIAN;
 	if (code_len >= 4 && instr->csh->no_text && !instr->flat_insn->detail &&
 	    instr->csh->disasm == Mips_getInstruction &&
+#ifdef MIPS_STANDARD_SCAN
+	    instr->csh->insn_id == Mips_get_insn_id &&
+#endif
 	    (mode == CS_MODE_MIPS32 || mode == CS_MODE_MIPS64)) {
 		/* For these standard immediate and load/store encodings all
 		 * register and immediate bits are operands. */
 		const unsigned major = readBytes32(instr, code) >> 26;
 		unsigned opcode = 0;
 		switch (major) {
+#ifdef MIPS_STANDARD_SCAN
+		case 4:
+			opcode = Mips_BEQ;
+			break;
+		case 5:
+			opcode = Mips_BNE;
+			break;
+		case 10:
+			opcode = Mips_SLTi;
+			break;
+		case 11:
+			opcode = Mips_SLTiu;
+			break;
+		case 32:
+			opcode = Mips_LB;
+			break;
+		case 33:
+			opcode = Mips_LH;
+			break;
+		case 36:
+			opcode = Mips_LBu;
+			break;
+		case 37:
+			opcode = Mips_LHu;
+			break;
+		case 40:
+			opcode = Mips_SB;
+			break;
+		case 41:
+			opcode = Mips_SH;
+			break;
+#endif
 		case 9:
 			opcode = Mips_ADDiu;
 			break;
