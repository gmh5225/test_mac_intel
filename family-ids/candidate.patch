+#ifdef CAPSTONE_PUBLIC_ITERATOR_DISPATCH
+/* Reuse the fixed readers' iterator contracts. Select once when the handle's
+ * architecture, mode or text option is set. Other options are read by the
+ * decoder on each call, including mnemonic overrides and skipdata callbacks. */
+static void select_public_iterator(cs_struct *handle)
+{
+	handle->public_iterator = cs_disasm_default_iter;
+	if (handle->arch == CS_ARCH_X86 && !handle->no_text) {
+		if (handle->mode == CS_MODE_32)
+			handle->public_iterator = X86_disasmIter32;
+		else if (handle->mode == CS_MODE_64)
+			handle->public_iterator = X86_disasmIterText;
+	}
+}
+#endif
