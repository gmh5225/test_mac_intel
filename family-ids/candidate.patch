diff --git a/suite/synctools/riscv_public_mapping.py b/suite/synctools/riscv_public_mapping.py
new file mode 100644
index 00000000..58019665
--- /dev/null
+++ b/suite/synctools/riscv_public_mapping.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Project the public RISC-V instruction ID and implicit effects from TableGen."""
+
+import argparse
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+RISCV = ROOT / "arch" / "RISCV"
+BLOCK_SIZE = 32
+ROW = re.compile(
+    r"\{\s*(RISCV_\w+)\s*,\s*(RISCV_INS_\w+)\s*,\s*#ifndef CAPSTONE_DIET\s*"
+    r"\{([^}]*)\},\s*\{([^}]*)\},\s*\{([^}]*)\},\s*([01]),\s*([01]),"
+    r"\s*\{\{\s*0\s*\}\}\s*#endif\s*\},"
+)
+
+
+def list_values(field):
+    tokens = tuple(token.strip() for token in field.split(","))
+    if tokens[-1] != "0" or any(
+        not re.fullmatch(r"RISCV_\w+", token) for token in tokens[:-1]
+    ):
+        raise ValueError(f"Unexpected implicit mapping list {field}")
+    return tokens[:-1]
+
+
+def intern(values, value):
+    return values.setdefault(value, len(values))
+
+
+def array(tokens):
+    return "{ " + (", ".join(tokens) if tokens else "0") + " }"
+
+
+def generate():
+    text = (RISCV / "RISCVGenCSMappingInsn.inc").read_text()
+    text = re.sub(r"/\*.*?\*/|//[^\n]*", "", text, flags=re.S)
+    matches = list(ROW.finditer(text))
+    if not matches or ROW.sub("", text).strip():
+        raise ValueError("Unexpected RISC-V instruction mapping syntax")
+    opcodes = dict(
+        re.findall(
+            r"\b(RISCV_\w+)\s*=\s*(\d+)\s*,",
+            (RISCV / "RISCVGenInstrInfo.inc").read_text(),
+        )
+    )
+    effects = {}
+    entries = []
+    for index, match in enumerate(matches):
+        opcode, public_id, reads, writes, groups, branch, indirect = match.groups()
+        if opcodes.get(opcode) != str(index):
+            raise ValueError(f"Non-dense instruction mapping at {opcode}")
+        groups = list_values(groups)
+        if branch == "1" or indirect == "1":
+            groups += ("RISCV_GRP_JUMP",)
+        effect = intern(effects, (list_values(reads), list_values(writes), groups))
+        entries.append((public_id, effect))
+    zero = ("RISCV_INS_INVALID", intern(effects, ((), (), ())))
+    blocks = {}
+    directory = []
+    for start in range(0, len(entries), BLOCK_SIZE):
+        block = entries[start : start + BLOCK_SIZE]
+        block.extend([zero] * (BLOCK_SIZE - len(block)))
+        directory.append(intern(blocks, tuple(block)))
+    if max(len(blocks), len(effects)) > 256:
+        raise ValueError("A RISC-V block or effect index exceeds one byte")
+    lines = [
+        "/* Generated by suite/synctools/riscv_public_mapping.py. */",
+        f"enum {{ RISCV_PUBLIC_BLOCK_SIZE = {BLOCK_SIZE} }};",
+        "static const uint8_t riscv_public_blocks[] = {",
+    ]
+    for start in range(0, len(directory), 20):
+        lines.append("\t" + ", ".join(map(str, directory[start : start + 20])) + ",")
+    lines.extend(["};", "", f"static const struct RISCVPublicEntry riscv_public_rows[][{BLOCK_SIZE}] = {{"])
+    for block in blocks:
+        lines.append("\t{")
+        for public_id, effect in block:
+            lines.append(f"\t\t{{ {public_id}, {effect} }},")
+        lines.append("\t},")
+    lines.extend(["};", "", "static const struct RISCVPublicEffects riscv_public_effects[] = {"])
+    for reads, writes, groups in effects:
+        fields = [array(reads), array(writes), array(groups)]
+        fields.extend(str(len(items)) for items in (reads, writes, groups))
+        lines.append("\t{ " + ", ".join(fields) + " },")
+    lines.append("};")
+    return "\n".join(lines) + "\n"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    output = RISCV / "RISCVGenPublicMapping.inc"
+    data = generate()
+    if args.check:
+        if output.read_text() != data:
+            parser.error(f"{output.name} needs regeneration")
+    else:
+        output.write_text(data)
+
+
+if __name__ == "__main__":
+    main()
