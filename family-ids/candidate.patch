+	const uint8_t rex = has_rex ? code[0] : 0, mr = code[length - 1];
+	const unsigned reg = ((mr >> 3) & 7) | ((rex & 4) << 1);
+	const unsigned rm = (mr & 7) | ((rex & 1) << 3);
+	const unsigned first = entry->reverse ? rm : reg,
+		       second = entry->reverse ? reg : rm;
