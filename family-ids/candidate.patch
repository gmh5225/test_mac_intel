diff --git a/suite/synctools/x86_operand_access.py b/suite/synctools/x86_operand_access.py
new file mode 100644
index 00000000..db519212
--- /dev/null
+++ b/suite/synctools/x86_operand_access.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Build the x86 operand-access index from each configuration's opcode mappings."""
+
+import argparse
+from pathlib import Path
+import re
+
+from x86_mapping_counts import entries, require
+
+ROOT = Path(__file__).resolve().parents[2]
+ACCESS_ROW = re.compile(r"\{\s*([^,{}]+),\s*\{([^{}]*)\}\s*\},")
+ENUM = re.compile(r"^\s*(X86_\w+)\s*=\s*(\d+),?\s*$", re.M)
+
+
+def projection(directory, suffix):
+    enums = (directory / f"X86GenInstrInfo{suffix}.inc").read_text()
+    ids = {name: int(value) for name, value in ENUM.findall(enums)}
+    index = [0] * ids["X86_INSTRUCTION_LIST_END"]
+    mapping = entries((directory / f"X86MappingInsn{suffix}.inc").read_text())
+    source = (directory / f"X86MappingInsnOp{suffix}.inc").read_text()
+    source = re.sub(r"/\*.*?\*/|//[^\n]*", "", source, flags=re.S)
+    rows = list(ACCESS_ROW.finditer(source))
+    require(not ACCESS_ROW.sub("", source).strip(), "Unexpected operand access initializer")
+    require(len(rows) == len(mapping), "Mismatched instruction and access row counts")
+
+    # Zero is reserved for an absent opcode. A mapped instruction can have
+    # no flag effects and no operands, and still returns a valid access array.
+    descriptors = {}
+    for opcode, row in zip(mapping, rows):
+        private_id = ids[opcode.group(1)]
+        require(index[private_id] == 0, f"Duplicate opcode {opcode.group(1)}")
+        flag_text, operand_text = row.groups()
+        flags = " | ".join(sorted(term.strip() for term in flag_text.split("|")))
+        access = [term.strip() for term in operand_text.split(",")]
+        require(1 <= len(access) <= 6 and all(access), "Invalid access array size")
+        while len(access) > 1 and access[-1] == "0":
+            access.pop()
+        record = flags, ", ".join(access)
+        index[private_id] = descriptors.setdefault(record, len(descriptors) + 1)
+
+    require(len(descriptors) <= 255, "Operand access descriptor index exceeds one byte")
+    lines = ["static const insn_op x86_access_descriptors[] = {", "\t{ 0, { 0 } },"]
+    for flags, access in descriptors:
+        lines.append(f"\t{{ {flags}, {{ {access} }} }},")
+    lines.extend(["};", "", "static const uint8_t x86_access_index[X86_INSTRUCTION_LIST_END] = {"])
+    for start in range(0, len(index), 16):
+        lines.append("\t" + ", ".join(str(value) for value in index[start:start + 16]) + ",")
+    lines.append("};")
+    return lines
+
+
+def generate(directory):
+    lines = ["/* Generated by suite/synctools/x86_operand_access.py. */",
+             "#ifdef CAPSTONE_X86_REDUCE", *projection(directory, "_reduce"),
+             "#else", *projection(directory, ""), "#endif", ""]
+    return "\n".join(lines)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    directory = ROOT / "arch" / "X86"
+    dest = directory / "X86GenOperandAccess.inc"
+    expected = generate(directory)
+    if args.check:
+        if not dest.exists() or dest.read_text() != expected:
+            parser.exit(1, f"{dest.name} needs regeneration\n")
+    else:
+        dest.write_text(expected)
