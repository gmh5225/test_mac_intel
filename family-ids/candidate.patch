+#ifndef CAPSTONE_DIET
+/* Generated register rows either end in zero or use every slot. */
+static inline bool append_implicit_regs(uint16_t *dst, uint8_t *count,
+					const uint16_t *src, unsigned capacity)
+{
+	const unsigned start = *count;
+	unsigned n = start;
+	while (n < capacity) {
+		uint16_t reg = src[n - start];
+		if (!reg)
+			break;
+		dst[n++] = reg;
+	}
+	*count = (uint8_t)n;
+	return n < capacity || n - start == capacity || !src[n - start];
+}
+#endif
