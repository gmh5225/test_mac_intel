diff --git a/cs.c b/cs.c
index c87f3f47..a79ed83a 100644
--- a/cs.c
+++ b/cs.c
@@ -819,6 +819,21 @@ const char *CAPSTONE_API cs_strerror(cs_err code)
 	}
 }
 
+#ifdef CAPSTONE_X86_DIRECT_PUBLIC_TEXT
+static inline bool use_x86_scan(const cs_struct *handle);
+
+static void select_x86_public_iterator(cs_struct *handle)
+{
+	if (use_x86_scan(handle))
+		handle->x86_iter_kind = X86_ITER_SCAN;
+	else if (handle->arch == CS_ARCH_X86 && !handle->no_text &&
+		 (handle->mode == CS_MODE_32 || handle->mode == CS_MODE_64))
+		handle->x86_iter_kind = X86_ITER_TEXT;
+	else
+		handle->x86_iter_kind = X86_ITER_GENERAL;
+}
+#endif
+
 CAPSTONE_EXPORT
 cs_err CAPSTONE_API cs_open(cs_arch arch, cs_mode mode, csh *handle)
 {
@@ -865,6 +880,9 @@ cs_err CAPSTONE_API cs_open(cs_arch arch, cs_mode mode, csh *handle)
 	if ((err = populate_insn_map_cache(ud)))
 		goto fail;
 
+#ifdef CAPSTONE_X86_DIRECT_PUBLIC_TEXT
+	select_x86_public_iterator(ud);
+#endif
 	*handle = (uintptr_t)ud;
 	return CS_ERR_OK;
 
@@ -1310,6 +1328,9 @@ cs_err CAPSTONE_API cs_option(csh ud, cs_opt_type type, uintptr_t value)
 
 	case CS_OPT_TEXT:
 		handle->no_text = value == CS_OPT_OFF;
+#ifdef CAPSTONE_X86_DIRECT_PUBLIC_TEXT
+		select_x86_public_iterator(handle);
+#endif
 		return CS_ERR_OK;
 
 	case CS_OPT_DETAIL:
@@ -1319,6 +1340,9 @@ cs_err CAPSTONE_API cs_option(csh ud, cs_opt_type type, uintptr_t value)
 			handle->detail_opt = CS_OPT_OFF;
 		else
 			handle->detail_opt |= (cs_opt_value)value;
+#ifdef CAPSTONE_X86_DIRECT_PUBLIC_TEXT
+		select_x86_public_iterator(handle);
+#endif
 		return CS_ERR_OK;
 
 	case CS_OPT_SKIPDATA:
@@ -1429,6 +1453,13 @@ cs_err CAPSTONE_API cs_option(csh ud, cs_opt_type type, uintptr_t value)
 	if (!arch_configs[handle->arch].arch_option)
 		return CS_ERR_ARCH;
 
+#ifdef CAPSTONE_X86_DIRECT_PUBLIC_TEXT
+	if (type == CS_OPT_MODE) {
+		cs_err result = arch_configs[handle->arch].arch_option(handle, type, value);
+		select_x86_public_iterator(handle);
+		return result;
+	}
+#endif
 	return arch_configs[handle->arch].arch_option(handle, type, value);
 }
 
