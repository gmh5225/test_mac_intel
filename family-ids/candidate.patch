diff --git a/suite/synctools/alias_pattern_opcodes.py b/suite/synctools/alias_pattern_opcodes.py
new file mode 100755
index 00000000..561e488d
--- /dev/null
+++ b/suite/synctools/alias_pattern_opcodes.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Generate opcode membership masks for the AArch64 and MIPS alias printers."""
+
+import argparse
+from pathlib import Path
+import re
+
+
+def generate(directory):
+    arch = directory.name
+    writer = (directory / f"{arch}GenAsmWriter.inc").read_text()
+    enum = (directory / f"{arch}GenInstrInfo.inc").read_text()
+    table, = re.findall(
+        r"static const PatternsForOpcode OpToPatterns\[\] = \{([^;]*)\};", writer
+    )
+    entry = re.compile(r"\{\s*(\w+)\s*,\s*\d+\s*,\s*\d+\s*\}\s*,")
+    if not re.fullmatch(r"\s*\{\s*0\s*\}\s*,?\s*", entry.sub("", table)):
+        raise ValueError(f"Unexpected {arch} OpToPatterns sentinel or entry")
+
+    values = dict(re.findall(r"\b(" + arch + r"_\w+)\s*=\s*(\d+)\s*,", enum))
+    opcodes = [int(values[name]) for name in entry.findall(table)]
+    if not opcodes or opcodes != sorted(set(opcodes)):
+        raise ValueError(f"{arch} alias opcodes must be distinct and sorted")
+
+    first_word = opcodes[0] // 32
+    words = [0] * (opcodes[-1] // 32 - first_word + 1)
+    for opcode in opcodes:
+        words[opcode // 32 - first_word] |= 1 << (opcode % 32)
+    lines = [
+        "/* Generated by suite/synctools/alias_pattern_opcodes.py. */",
+        f"static inline bool {arch}_has_alias_pattern(unsigned int opcode)",
+        "{",
+        "#ifdef CAPSTONE_DIET",
+        "\t(void)opcode;",
+        "\treturn false;",
+        "#else",
+        "\tstatic const uint32_t words[] = {",
+    ]
+    for start in range(0, len(words), 4):
+        lines.append("\t\t" + " ".join(f"0x{word:08x}u," for word in words[start:start+4]))
+    lines.extend([
+        "\t};",
+        f"\tconst unsigned int word = (opcode >> 5) - {first_word}u;",
+        "\treturn word < sizeof(words) / sizeof(words[0]) &&",
+        "\t       (words[word] & (UINT32_C(1) << (opcode & 31)));",
+        "#endif",
+        "}",
+        "",
+    ])
+    return "\n".join(lines)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2] / "arch"
+    for arch in ("AArch64", "Mips"):
+        target = root / arch / f"{arch}GenAliasPatternOpcodes.inc"
+        output = generate(target.parent)
+        if args.check:
+            if not target.exists() or target.read_text() != output:
+                raise SystemExit(f"Stale {target}; rerun {Path(__file__).name}")
+        else:
+            target.write_text(output)
+
+
+if __name__ == "__main__":
+    main()
