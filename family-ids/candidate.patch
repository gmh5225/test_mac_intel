diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 0d9b1a76..6fed41c3 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3793,12 +3793,33 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 	return true;
 }
 
+#if defined(CAPSTONE_X86_MIXED_OUTPUT) && defined(CAPSTONE_X86_PUBLIC_OUTPUT)
+/* Keep the x86 scan frame out of the ordinary multi-architecture iterator. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static bool disasmMixedX86(csh ud, const uint8_t **code, size_t *size,
+			   uint64_t *address, cs_insn *insn)
+{
+	return cs_disasm_iter_core(ud, code, size, address, insn);
+}
+#endif
+
 CAPSTONE_EXPORT
 X86_DECODE_ALIGN
 bool CAPSTONE_API cs_disasm_iter(csh ud, const uint8_t **code, size_t *size,
 				 uint64_t *address, cs_insn *insn)
 {
+#if defined(CAPSTONE_X86_MIXED_OUTPUT) && defined(CAPSTONE_X86_PUBLIC_OUTPUT)
+	const cs_struct *handle = (const cs_struct *)(uintptr_t)ud;
+	if (*size && handle && handle->arch == CS_ARCH_X86)
+		return disasmMixedX86(ud, code, size, address, insn);
+	return cs_disasm_iter_core_arch(ud, code, size, address, insn, false);
+#else
 	return cs_disasm_iter_core(ud, code, size, address, insn);
+#endif
 }
 
 X86_DECODE_ALIGN
diff --git a/arch/X86/X86VectorFallback64.c b/arch/X86/X86VectorFallback64.c
