diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 0d9b1a76..ae18aa12 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3753,7 +3753,9 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 					  cs_insn *insn, uint16_t *insn_size,
 					  bool batch);
 
-#ifdef CAPSTONE_X86_PUBLIC_OUTPUT
+#if defined(CAPSTONE_X86_PUBLIC_OUTPUT) && defined(CAPSTONE_X86_LINKED_PUBLIC_RECORD)
+#define CS_DECODE_OUTPUT_MISS cs_decode_public_insn
+#elif defined(CAPSTONE_X86_PUBLIC_OUTPUT)
 #define CS_DECODE_OUTPUT_MISS X86_decodePublicRecord
 #endif
 #define CS_DECODE_SCAN_IMPL decodeIteratorScan
diff --git a/arch/X86/X86PublicOutput.c b/arch/X86/X86PublicOutput.c
index 732c4004..47cfa674 100644
--- a/arch/X86/X86PublicOutput.c
+++ b/arch/X86/X86PublicOutput.c
@@ -26,4 +26,22 @@ CS_PRESERVE_MOST bool X86_decodePublicRecord(cs_struct *handle,
 	}
 	return cs_decode_full_insn(handle, code, size, insn, length, batch);
 }
+#ifdef CAPSTONE_X86_LINKED_PUBLIC_RECORD
+/* Public scan misses enter here. Both choices keep the full decoder off
+ * the public iterator's stack. Other architectures use the same decoder
+ * as the private x86 reader's fallback. */
+CS_PRESERVE_MOST bool
+cs_decode_public_insn(cs_struct *handle, const uint8_t *code, size_t size,
+		      cs_insn *insn, uint16_t *length, bool batch)
+{
+	typedef CS_PRESERVE_MOST bool record_reader(cs_struct *, const uint8_t *,
+						    size_t, cs_insn *, uint16_t *,
+						    bool);
+	static record_reader *const readers[] = {
+		cs_decode_full_insn, X86_decodePublicRecord
+	};
+	return readers[handle->arch == CS_ARCH_X86](handle, code, size, insn,
+						   length, batch);
+}
+#endif
 #endif
