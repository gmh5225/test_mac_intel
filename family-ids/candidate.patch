diff --git a/suite/synctools/systemz_register_names.py b/suite/synctools/systemz_register_names.py
new file mode 100644
index 00000000..220760cd
--- /dev/null
+++ b/suite/synctools/systemz_register_names.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Derive GNU register spellings and public names from the SystemZ asm writer."""
+
+import argparse
+import re
+from pathlib import Path
+
+
+def render(writer):
+    names = re.search(r"static const char AsmStrs\[\] = \{(.*?)\};", writer, re.S)
+    offsets = re.search(r"static const uint16_t RegAsmOffset\[\] = \{(.*?)\};", writer, re.S)
+    if names is None or offsets is None:
+        raise ValueError("Missing register name table in SystemZ asm writer")
+
+    pattern = re.compile(r'/\*\s*(\d+)\s*\*/\s*"([a-zA-Z0-9_]+)\\0"')
+    pool = bytearray()
+    for entry in pattern.finditer(names[1]):
+        if int(entry[1]) != len(pool):
+            raise ValueError("Unexpected register name offset")
+        pool.extend(entry[2].encode("ascii") + b"\0")
+    if not pool or pattern.sub("", names[1]).strip():
+        raise ValueError("Unrecognized register name spelling")
+
+    rows = []
+    distinct = {}
+    for field in offsets[1].rstrip().removesuffix(",").split(","):
+        start = int(field)
+        if not 0 <= start < len(pool) or not pool[start]:
+            raise ValueError("Invalid offset for SystemZ register name")
+        name = pool[start:pool.index(0, start)].decode("ascii")
+        rows.append(distinct.setdefault(name, len(distinct)))
+
+    width = max(5, max(map(len, distinct)) + 2)
+    index_type = "uint8_t" if len(distinct) <= 256 else "uint16_t"
+    result = [
+        "/* Generated by suite/synctools/systemz_register_names.py. */",
+        f"static const char systemz_register_spellings[][{width}] = {{",
+        *(f'\t"%{name}",' for name in distinct),
+        "};",
+        f"static const {index_type} systemz_register_spelling_ids[] = {{",
+    ]
+    for pos in range(0, len(rows), 16):
+        result.append("\t" + ", ".join(map(str, rows[pos:pos + 16])) + ",")
+    return "\n".join([*result, "};", ""])
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    arch = Path(__file__).resolve().parents[2] / "arch" / "SystemZ"
+    writer = (arch / "SystemZGenAsmWriter.inc").read_text()
+    # The asm writer also contains instruction spelling tables.
+    start = writer.index("static const char *getRegisterName(unsigned RegNo)")
+    end = writer.index("#endif // CAPSTONE_DIET", start)
+    table = render(writer[start:end])
+    output = arch / "SystemZGenRegisterSpellings.inc"
+    if args.check:
+        if output.read_text() != table:
+            parser.exit(1, "SystemZ register spellings need regeneration\n")
+    else:
+        output.write_text(table)
