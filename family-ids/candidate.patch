 /* Private x86 decode state constructs operands before reading them. It does
diff --git a/arch/SystemZ/SystemZInstPrinter.c b/arch/SystemZ/SystemZInstPrinter.c
index ee9eb18e..33ef9e6c 100644
--- a/arch/SystemZ/SystemZInstPrinter.c
+++ b/arch/SystemZ/SystemZInstPrinter.c
@@ -149,12 +149,31 @@ static void printMCOperand(const MCInst *MI, const MCOperand *MO, SStream *O)
 void printFormattedRegName(const MCAsmInfo *MAI, MCRegister Reg, SStream *O)
 {
 	const char *RegName = getRegisterName(Reg);
-	if (MAI->assemblerDialect == SYSTEMZASMDIALECT_AD_ATT) {
-		// Skip register prefix so that only register number is left
-		CS_ASSERT((isalpha(RegName[0]) && isdigit(RegName[1])));
-		SStream_concat0(markup_OS(O, Markup_Register), (RegName + 1));
-	} else
+	if (MAI->assemblerDialect == SYSTEMZASMDIALECT_AD_HLASM) {
+#ifndef CAPSTONE_DIET
+		/* HLASM prints the number without its register class. */
+		CS_ASSERT(isalpha((unsigned char)RegName[0]) &&
+			  isdigit((unsigned char)RegName[1]));
+		++RegName;
+#endif
+	} else {
+#if defined(CAPSTONE_SYSTEMZ_DEDICATED_MAPPING) && !defined(CAPSTONE_DIET)
+		/* The ordinary GNU spelling is a percent sign and a short register
+		 * name. Keep markup and partial appends at capacity on the stream path. */
+		if (!O->is_closed && !O->markup_stream && !O->prefixed_by_markup &&
+		    O->index < SSTREAM_BUF_LEN - 4 && RegName && RegName[0] &&
+		    RegName[1] && (!RegName[2] || !RegName[3])) {
+			char *out = O->buffer + O->index;
+			const unsigned length = 3 + (RegName[2] != 0);
+			out[0] = '%';
+			memcpy(out + 1, RegName, 3);
+			out[length] = '\0';
+			O->index += length;
+			return;
+		}
+#endif
 		SStream_concat1(markup_OS(O, Markup_Register), '%');
+	}
 	SStream_concat0(markup_OS(O, Markup_Register), RegName);
 }
 
