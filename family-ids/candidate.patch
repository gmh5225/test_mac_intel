diff --git a/arch/RISCV/RISCVDisassembler.c b/arch/RISCV/RISCVDisassembler.c
index 4190862e..77d5f89f 100644
--- a/arch/RISCV/RISCVDisassembler.c
+++ b/arch/RISCV/RISCVDisassembler.c
@@ -752,6 +752,10 @@ DecodeStatus RISCV_getInstruction(MCInst *MI, uint16_t *Size,
 		2, !RISCV_getFeatureBits(MI->csh->mode, RISCV_Feature64Bit),
 		DecoderTableRISCV32Only_16,
 		"RISCV32Only_16 table (16-bit Instruction)");
+	/* The 32-bit-only table above retains first chance. For other
+	 * compressed extensions the top six bits can exclude every table. */
+	if (!(RISCV_COMPRESSED_EXTENSIONS & (UINT64_C(1) << (Insn >> 10))))
+		goto base16;
 	TRY_TO_DECODE_FEATURE(2, RISCV_FeatureStdExtZicfiss,
 			      DecoderTableZicfiss16,
 			      "RVZicfiss table (Shadow Stack)");
@@ -760,6 +764,7 @@ DecodeStatus RISCV_getInstruction(MCInst *MI, uint16_t *Size,
 	TRY_TO_DECODE_FEATURE(
 		2, RISCV_FeatureStdExtZcmp, DecoderTableRVZcmp16,
 		"Zcmp table (16-bit Push/Pop & Double Move Instructions)");
+base16:
 	TRY_TO_DECODE_AND_ADD_SP(2, true, DecoderTable16,
 				 "RISCV_C table (16-bit Instruction)");
 
