+/* SPDX-License-Identifier: BSD-3-Clause */
+#include <stdio.h>
+#include "../../Mapping.h"
+
+#define GET_INSTRINFO_ENUM
+#include "../../arch/PowerPC/PPCGenInstrInfo.inc"
+
+extern const insn_map ppc_insns[];
+
+int main(void)
+{
+	for (unsigned i = 0; i < INSTRUCTION_LIST_END; ++i) {
+		if (ppc_insns[i].id != i) {
+			fprintf(stderr, "unexpected PowerPC opcode at row %u\n", i);
+			return 1;
+		}
+	}
+	return 0;
+}
