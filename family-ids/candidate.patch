diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 0d9b1a76..672f9d9a 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -3754,8 +3754,16 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 					  bool batch);
 
 #ifdef CAPSTONE_X86_PUBLIC_OUTPUT
+#ifdef CAPSTONE_X86_MIXED_OUTPUT
+X86_DECODE_INLINE bool decodeIteratorOutput(cs_struct *handle,
+					    const uint8_t *code, size_t size,
+					    cs_insn *insn, uint16_t *length,
+					    bool batch);
+#define CS_DECODE_OUTPUT_MISS decodeIteratorOutput
+#else
 #define CS_DECODE_OUTPUT_MISS X86_decodePublicRecord
 #endif
+#endif
 #define CS_DECODE_SCAN_IMPL decodeIteratorScan
 #include "../../cs_disasm_internal.h"
 #undef CS_DECODE_SCAN_IMPL
@@ -3763,6 +3771,19 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 #undef CS_DECODE_OUTPUT_MISS
 #endif
 
+#if defined(CAPSTONE_X86_PUBLIC_OUTPUT) && defined(CAPSTONE_X86_MIXED_OUTPUT)
+X86_DECODE_INLINE bool decodeIteratorOutput(cs_struct *handle,
+					    const uint8_t *code, size_t size,
+					    cs_insn *insn, uint16_t *length,
+					    bool batch)
+{
+	if (handle->arch == CS_ARCH_X86)
+		return X86_decodePublicRecord(handle, code, size, insn, length,
+					      batch);
+	return cs_decode_full_insn(handle, code, size, insn, length, batch);
+}
+#endif
+
 /* Keep the admitted terminal's public ID and zero alias adjustment visible
  * through output completion. Cold helpers can take the fallback result's
  * address without forcing terminal output through that escaped object. */
