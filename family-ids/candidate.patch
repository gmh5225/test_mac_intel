+/* The width-specific entry still reads syntax, detail and formatter options
+ * from the handle. Only architecture, mode and text select the entry. */
+static void select_iterator(cs_struct *handle)
+{
+	if (handle->arch != CS_ARCH_X86)
+		handle->iterator = disasm_iter_foreign;
+	else if (!handle->no_text && handle->mode == CS_MODE_32)
+		handle->iterator = X86_disasmIter32;
+	else if (!handle->no_text && handle->mode == CS_MODE_64)
+		handle->iterator = X86_disasmIterText;
+	else
+		handle->iterator = X86_disasmIterCanonical;
+}
+#endif
