diff --git a/suite/synctools/x86_float_compare_families.py b/suite/synctools/x86_float_compare_families.py
new file mode 100644
index 00000000..467c22d0
--- /dev/null
+++ b/suite/synctools/x86_float_compare_families.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Restore the public operation family on x86 floating-point compare aliases."""
+
+import argparse
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2] / "arch" / "X86"
+COMPARE = re.compile(r"X86_(VCMP(?:PS|PD|SS|SD))[A-Za-z0-9_]*")
+MAPPING = re.compile(r"\b(X86_\w+), (X86_INS_\w+), ([01]),")
+ACCESS = re.compile(r"/\* (X86_\w+), (X86_INS_\w+): (\w+)(?= \*/)")
+
+
+def project(mapping, access):
+    families = {}
+
+    def mapping_id(match):
+        opcode, public, wide = match.groups()
+        family = COMPARE.fullmatch(opcode)
+        if family is None:
+            if public == "X86_INS_VCMP":
+                raise ValueError(f"Unknown generic compare opcode {opcode}")
+            return match[0]
+        expected = "X86_INS_" + family[1]
+        if public not in (expected, "X86_INS_VCMP"):
+            raise ValueError(f"Unexpected public ID {public} for {opcode}")
+        families[opcode] = expected
+        return f"{opcode}, {expected}, {wide},"
+
+    def access_label(match):
+        opcode, current, mnemonic = match.groups()
+        expected = families.get(opcode)
+        if expected is None:
+            return match[0]
+        if current not in (expected, "X86_INS_VCMP"):
+            raise ValueError(f"Unexpected access-table ID {current} for {opcode}")
+        # Explicit-immediate rows already have their own mnemonic spelling.
+        if current == expected:
+            return match[0]
+        return f"/* {opcode}, {expected}: {expected[len('X86_INS_'):].lower()}"
+
+    mapping = MAPPING.sub(mapping_id, mapping)
+    return mapping, ACCESS.sub(access_label, access)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    for suffix in ("", "_reduce"):
+        files = [ROOT / f"X86MappingInsn{part}{suffix}.inc" for part in ("", "Op")]
+        original = [path.read_text() for path in files]
+        for path, before, after in zip(files, original, project(*original)):
+            if after == before:
+                continue
+            if args.check:
+                parser.exit(1, f"Compare family projection is stale in {path.name}\n")
+            path.write_text(after)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/x86_evex_vpcmp_id.c b/tests/unit/x86_evex_vpcmp_id.c
index 1a30e853..ff35c5b8 100644
--- a/tests/unit/x86_evex_vpcmp_id.c
+++ b/tests/unit/x86_evex_vpcmp_id.c
@@ -49,6 +49,56 @@ static bool test_vpcmp(csh handle, bool expect_detail)
 	return success;
 }
 
+/* The printed predicate may vary while the operation remains scalar or
+ * packed, single or double precision. Both public decoding APIs expose it. */
+static bool test_float_compare_ids(csh handle, bool restore_detail)
+{
+	static const unsigned ids[] = { X86_INS_VCMPPS, X86_INS_VCMPPD,
+					X86_INS_VCMPSS, X86_INS_VCMPSD };
+	static const uint8_t predicates[] = { 0, 1, 6, 7, 15, 31, 32, 255 };
+	bool success = true;
+	for (unsigned int flags = 0; flags < 4; ++flags) {
+		if (cs_option(handle, CS_OPT_TEXT,
+			      flags & 1 ? CS_OPT_ON : CS_OPT_OFF) ||
+		    cs_option(handle, CS_OPT_DETAIL,
+			      flags & 2 ? CS_OPT_ON : CS_OPT_OFF))
+			return false;
+		cs_insn *slot = cs_malloc(handle);
+		if (!slot)
+			return false;
+		for (unsigned int form = 0; form < 4; ++form) {
+			uint8_t code[] = { 0xc5, (uint8_t)(0xe8 | form), 0xc2,
+					   0xc1, 0 };
+			for (size_t p = 0; p < sizeof(predicates); ++p) {
+				cs_insn *list = NULL;
+				const uint8_t *cursor = code;
+				size_t left = sizeof(code);
+				uint64_t address = 0;
+				code[4] = predicates[p];
+				size_t n = cs_disasm(handle, code, sizeof(code),
+						     0, 1, &list);
+				success &= check(
+					n == 1 && list->id == ids[form],
+					"allocated floating compare family");
