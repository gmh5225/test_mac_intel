+static bool test_full_implicit_register_rows(void)
+{
+#ifndef CAPSTONE_DIET
+	insn_map row = { 0 };
+	cs_detail detail = { 0 };
+	cs_insn insn = { 0 };
+	MCInst mi = { 0 };
+	mi.flat_insn = &insn;
+	insn.detail = &detail;
+	for (unsigned i = 0; i < MAX_IMPL_R_REGS; ++i)
+		row.regs_use[i] = (uint16_t)(i + 1);
+	for (unsigned i = 0; i < MAX_IMPL_W_REGS; ++i)
+		row.regs_mod[i] = (uint16_t)(i + 100);
+	map_implicit_reads(&mi, &row);
+	map_implicit_writes(&mi, &row);
+	if (detail.regs_read_count != MAX_IMPL_R_REGS ||
+	    detail.regs_write_count != MAX_IMPL_W_REGS ||
+	    memcmp(detail.regs_read, row.regs_use, sizeof(row.regs_use)) ||
+	    memcmp(detail.regs_write, row.regs_mod, sizeof(row.regs_mod)))
+		return false;
+
+	/* A terminated row can also fill the remaining capacity exactly. */
+	detail.regs_read_count = 1;
+	detail.regs_write_count = 1;
+	detail.regs_read[0] = 97;
+	detail.regs_write[0] = 98;
+	row.regs_use[MAX_IMPL_R_REGS - 1] = 0;
+	row.regs_mod[MAX_IMPL_W_REGS - 1] = 0;
+	map_implicit_reads(&mi, &row);
+	map_implicit_writes(&mi, &row);
+	if (detail.regs_read_count != MAX_IMPL_R_REGS ||
+	    detail.regs_write_count != MAX_IMPL_W_REGS ||
+	    detail.regs_read[0] != 97 || detail.regs_write[0] != 98 ||
+	    memcmp(detail.regs_read + 1, row.regs_use,
+		   sizeof(row.regs_use) - sizeof(row.regs_use[0])) ||
+	    memcmp(detail.regs_write + 1, row.regs_mod,
+		   sizeof(row.regs_mod) - sizeof(row.regs_mod[0])))
+		return false;
+#endif
+	return true;
+}
