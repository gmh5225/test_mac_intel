diff --git a/cs.c b/cs.c
index 0a820fbe..be1b66ce 100644
--- a/cs.c
+++ b/cs.c
@@ -1046,7 +1046,13 @@ static inline void fill_insn(struct cs_struct *handle, cs_insn *insn,
 
 /* Keep the full decoder's stack frame off generated-output hits, while
  * retaining the public iterator's scan code and private calling convention. */
-#if defined(CAPSTONE_X86_DEDICATED_OUTPUT) && defined(__clang__) && defined(__x86_64__)
+#if defined(CAPSTONE_X86_PUBLIC_OUTPUT) && defined(CAPSTONE_X86_LINKED_PUBLIC_RECORD)
+CS_DECODE_INLINE bool decode_full_record(cs_struct *handle, const uint8_t *code,
+					size_t size, cs_insn *insn,
+					uint16_t *insn_size, bool batch,
+					bool public_reader)
+{
+#elif defined(CAPSTONE_X86_DEDICATED_OUTPUT) && defined(__clang__) && defined(__x86_64__)
 CS_PRESERVE_MOST bool
 cs_decode_full_insn(cs_struct *handle, const uint8_t *code, size_t size,
 		    cs_insn *insn, uint16_t *insn_size, bool batch)
@@ -1077,9 +1083,16 @@ cs_decode_full_insn(cs_struct *handle, const uint8_t *code, size_t size,
 #endif
 	MCInst mci;
 #ifdef CAPSTONE_HAS_X86
-	if (handle->arch == CS_ARCH_X86)
+	if (handle->arch == CS_ARCH_X86) {
+#if defined(CAPSTONE_X86_PUBLIC_OUTPUT) && defined(CAPSTONE_X86_LINKED_PUBLIC_RECORD)
+		/* The fixed reader already tried its own public record. Its
+		 * misses enter the canonical decoder through the other entry. */
+		if (public_reader)
+			return X86_decodePublicRecord(handle, code, size, insn,
+						      insn_size, batch);
+#endif
 		MCInst_InitX86(&mci);
-	else
+	} else
 #endif
 #ifdef CAPSTONE_HAS_MIPS
 	if (handle->arch == CS_ARCH_MIPS)
@@ -1180,6 +1193,37 @@ cs_decode_full_insn(cs_struct *handle, const uint8_t *code, size_t size,
 	return true;
 }
 
+#if defined(CAPSTONE_X86_PUBLIC_OUTPUT) && defined(CAPSTONE_X86_LINKED_PUBLIC_RECORD)
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+CS_PRESERVE_MOST bool
+cs_decode_full_insn(cs_struct *handle, const uint8_t *code, size_t size,
+		    cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+	return decode_full_record(handle, code, size, insn, insn_size, batch, false);
+}
+
+/* Mixed static builds keep the scan loop intact. Only its ordinary
+ * full-record call selects the public x86 formatter. */
+#if defined(__ELF__) && defined(__GNUC__)
+__attribute__((section(".cs_x86_public_full_text")))
+#endif
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+CS_PRESERVE_MOST bool
+cs_decode_public_insn(cs_struct *handle, const uint8_t *code, size_t size,
+		    cs_insn *insn, uint16_t *insn_size, bool batch)
+{
+	return decode_full_record(handle, code, size, insn, insn_size, batch, true);
+}
+#endif
+
 #if defined(_MSC_VER)
 __declspec(noinline)
 #elif defined(__GNUC__)
