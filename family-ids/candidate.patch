diff --git a/tests/unit/systemz_register_dialects.c b/tests/unit/systemz_register_dialects.c
new file mode 100644
index 00000000..3a4e8176
--- /dev/null
+++ b/tests/unit/systemz_register_dialects.c
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "../../arch/SystemZ/SystemZInstPrinter.h"
+
+#define GET_REGINFO_ENUM
+#include "../../arch/SystemZ/SystemZGenRegisterInfo.inc"
+
+int main(void)
+{
+	const struct {
+		MCRegister reg;
+		const char *gnu;
+		const char *hlasm;
+	} cases[] = {
+		{ SystemZ_R2D, "%r2", "2" },
+		{ SystemZ_R10D, "%r10", "10" },
+		{ SystemZ_F12D, "%f12", "12" },
+		{ SystemZ_V31, "%v31", "31" },
+	};
+	MCInst mi;
+	MCInst_Init(&mi, CS_ARCH_SYSTEMZ);
+	for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i) {
+		for (unsigned mode = 0; mode < 4; ++mode) {
+			MCAsmInfo info = mi.MAI;
+			if (mode == 1)
+				info.assemblerDialect =
+					SYSTEMZASMDIALECT_AD_ATT;
+			else if (mode == 2)
+				info.assemblerDialect =
+					SYSTEMZASMDIALECT_AD_HLASM;
+			else if (mode == 3)
+				info = (MCAsmInfo){ 0 };
+			SStream stream;
+			SStream_Init(&stream);
+			printFormattedRegName(&info, cases[i].reg, &stream);
+			const char *wanted = mode == 2 ? cases[i].hlasm :
+							 cases[i].gnu;
+			if (strcmp(stream.buffer, wanted)) {
+				fprintf(stderr, "mode %u expected %s, got %s\n",
+					mode, wanted, stream.buffer);
+				return 1;
+			}
+		}
+	}
+	return 0;
+}
