+VECTOR_CLEAR = ("X86_VZEROALL", "X86_VZEROUPPER")
+
+
+def legacy_vector_rows(directory):
+    mapping = entries((directory / "X86MappingInsn.inc").read_text())
+    access = (directory / "X86MappingInsnOp.inc").read_text()
+    lines = [
+        "/* SPDX-License-Identifier: BSD-3-Clause */",
+        "/* Generated by suite/synctools/x86_mapping_counts.py; do not edit. */",
+        "#if defined(X86_LEGACY_VECTOR_MAPPING)",
+    ]
+    operands = []
+    names = []
+    for ordinal, name in enumerate(VECTOR_CLEAR):
+        matches = [(index, row) for index, row in enumerate(mapping) if row[1] == name]
+        require(len(matches) == 1, f"Missing unique canonical mapping for {name}")
+        index, row = matches[0]
+        writes = [reg.strip() for reg in row[4].split(",")]
+        require(writes == [f"X86_REG_YMM{i}" for i in range(16)] + ["0"],
+                f"Unexpected 64-bit write set for {name}")
+        # Both public groups and all other implicit effects follow the canonical row.
+        original = row.group()
+        start = row.start(4) - row.start()
+        end = row.end(4) - row.start()
+        lines.append(original[:start] + " " + ", ".join(writes[:8] + ["0"]) + " " + original[end:])
+        found = re.findall(r"\{\s*/\*\s*" + name + r",[^*]*\*/\s*([^{}]*\{[^{}]*\})\s*\},", access)
+        require(len(found) == 1, f"Missing operand access for {name}")
+        operands.append("{ " + " ".join(found[0].split()) + " },")
+        stem = name.removeprefix("X86_")
+        names.extend([f"\tX86_MAP_{stem} = {index},",
+                      f"\tX86_LEGACY_MAP_{stem} = {len(mapping) + ordinal},"])
+    lines.extend(["#elif defined(X86_LEGACY_VECTOR_ACCESS)", *operands, "#else", "enum {"])
+    lines.extend([f"\tX86_CANONICAL_MAP_COUNT = {len(mapping)},", *names, "};", "#endif", ""])
+    return "\n".join(lines)
+
+
