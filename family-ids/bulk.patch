diff --git a/tests/unit/batch_detail_alloc.c b/tests/unit/batch_detail_alloc.c
new file mode 100644
index 00000000..82943142
--- /dev/null
+++ b/tests/unit/batch_detail_alloc.c
@@ -0,0 +1,87 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include <capstone/capstone.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static csh active_handle;
+static void *detail;
+static bool fail_resize;
+static unsigned int detail_allocations, detail_frees, resize_failures;
+
+static void *CAPSTONE_API disable_detail_on_allocation(size_t count, size_t size)
+{
+	void *p = calloc(count, size);
+	if (active_handle && p && count == 1 && size == sizeof(cs_detail)) {
+		detail = p;
+		++detail_allocations;
+		cs_option(active_handle, CS_OPT_DETAIL, CS_OPT_OFF);
+	}
+	return p;
+}
+
+static void *CAPSTONE_API resize_batch(void *p, size_t size)
+{
+	if (active_handle && fail_resize) {
+		++resize_failures;
+		return NULL;
+	}
+	return realloc(p, size);
+}
+
+static void CAPSTONE_API release(void *p)
+{
+	if (p && p == detail) {
+		detail = NULL;
+		++detail_frees;
+	}
+	free(p);
+}
+
+static bool check_batch(const uint8_t *code, size_t length, bool resize)
+{
+	csh handle = 0;
+	cs_insn *out = NULL;
+	if (cs_open(CS_ARCH_X86, CS_MODE_32, &handle) != CS_ERR_OK)
+		return false;
+	if (cs_option(handle, CS_OPT_DETAIL, CS_OPT_ON) != CS_ERR_OK) {
+		cs_close(&handle);
+		return false;
+	}
+	detail_allocations = detail_frees = resize_failures = 0;
+	fail_resize = resize;
+	active_handle = handle;
+	const size_t n = cs_disasm(handle, code, length, 0x1000, 0, &out);
+	active_handle = 0;
+	const bool ok = n == 0 && out == NULL &&
+			cs_errno(handle) == (resize ? CS_ERR_MEM : CS_ERR_OK) &&
+			detail_allocations == 1 && detail_frees == 1 &&
+			resize_failures == (resize ? 1U : 0U);
+	if (!ok)
+		fprintf(stderr, "batch of %zu bytes: %u detail allocations, "
+				"%u frees, %u failed resizes\n",
+			length, detail_allocations, detail_frees, resize_failures);
+	if (out)
+		cs_free(out, n);
+	cs_close(&handle);
+	free(detail);
+	detail = NULL;
+	return ok;
+}
+
+int main(void)
+{
+	cs_opt_mem hooks = { malloc, disable_detail_on_allocation, resize_batch,
+			     release, vsnprintf };
+	if (cs_option(0, CS_OPT_MEM, (size_t)&hooks) != CS_ERR_OK)
+		return 1;
+	const uint8_t truncated[] = { 0x0f };
+	uint8_t nops[128];
+	memset(nops, 0x90, sizeof(nops));
+	bool ok = check_batch(truncated, sizeof(truncated), false);
+	ok &= check_batch(nops, 1, true); /* shrink */
+	ok &= check_batch(nops, sizeof(nops), true); /* grow */
+	return ok ? 0 : 1;
+}
