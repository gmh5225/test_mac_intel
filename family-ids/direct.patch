+++ b/arch/X86/X86OutputIterator.c
@@ -32,4 +32,19 @@ CAPSTONE_INTERNAL bool X86_disasmIter(csh ud, const uint8_t **code,
 #endif
 	return cs_disasm_iter(ud, code, size, address, insn);
 }
+
+#if defined(CAPSTONE_X86_PUBLIC_RECORD) && !defined(CAPSTONE_X86_ONLY)
+CS_PRESERVE_MOST bool X86_decodePublicRecord(cs_struct *handle,
+					    const uint8_t *code, size_t size,
+					    cs_insn *insn, uint16_t *length,
+					    bool batch)
+{
+	/* The public iterator has checked the input extent and hidden any
+	 * inactive detail storage before calling the formatted-record path. */
+	if (!handle->no_text &&
+	    X86_trySimpleOutput(handle, code, size, insn, length))
+		return true;
+	return cs_decode_full_insn(handle, code, size, insn, length, batch);
+}
+#endif
 #endif
diff --git a/cs_disasm_internal.h b/cs_disasm_internal.h
