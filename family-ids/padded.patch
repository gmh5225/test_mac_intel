diff --git a/arch/X86/X86OutputIterator.c b/arch/X86/X86OutputIterator.c
index cec4bec6..4b601820 100644
--- a/arch/X86/X86OutputIterator.c
+++ b/arch/X86/X86OutputIterator.c
@@ -15,6 +15,20 @@
 
 #include "X86SimpleOutputImpl.h"
 
+#ifdef CAPSTONE_X86_BULK_OUTPUT
+bool X86_tryBulkOutput(cs_struct *handle, const uint8_t *code, size_t size,
+		       cs_insn *insn, uint16_t *insn_size)
+{
+	/* A custom detail allocator may change the option mid-record. */
+	if (insn->detail && !handle->detail_opt)
+		return false;
+	if (handle->mode == CS_MODE_64)
+		return X86_tryRecord64(handle, code, size, insn, insn_size);
+	return handle->mode == CS_MODE_32 &&
+	       X86_tryRecord32(handle, code, size, insn, insn_size);
+}
+#endif
+
