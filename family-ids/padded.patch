+/* Dedicated Linux builds already try this writer in the common decoder. */
+#define CAPSTONE_X86_BULK_OUTPUT
+CAPSTONE_INTERNAL bool X86_tryRecord32(cs_struct *handle, const uint8_t *code,
+					 size_t size, cs_insn *insn,
+					 uint16_t *insn_size);
+CAPSTONE_INTERNAL bool X86_tryRecord64(cs_struct *handle, const uint8_t *code,
