+/* The scan path has already been considered. Public array ownership and
+ * skip-data semantics stay in the caller when a fixed writer declines. */
+static inline bool X86_tryPublicOutput(cs_struct *handle, const uint8_t *code,
+				      size_t size, cs_insn *insn,
+				      uint16_t *insn_size)
+{
+	return handle->arch == CS_ARCH_X86 && size && !handle->no_text &&
