+/* Keep the expanded MCInst out of the full-width printer's stack frame. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static void printCompressedOperandForms(MCInst *MI, SStream *O)
+{
+	MCInst expanded;
+	MCInst_InitStorage(&expanded, MI->csh->arch, false);
+	if (!uncompressInst(&expanded, MI)) {
+		printOperandForms(MI, MI, O);
+		return;
+	}
+	expanded.address = MI->address;
+	expanded.MRI = MI->MRI;
+	expanded.csh = MI->csh;
+	expanded.flat_insn = MI->flat_insn;
+	printOperandForms(MI, &expanded, O);
+}
+
+void RISCV_LLVM_printInstruction(MCInst *MI, SStream *O,
+				 void * /* MCRegisterInfo* */ info)
+{
+	MI->MRI = (MCRegisterInfo *)info;
+
+	MCInst_setIsAlias(MI, false);
+	bool usesAliasDetails = detail_is_set(MI) && isAliasDetail(MI) &&
+				!isRealDetail(MI);
+	MI->flat_insn->usesAliasDetails = usesAliasDetails;
+
+	/* Only the two-byte decoder produces opcodes in the uncompression table. */
+	if (MI->flat_insn->size == 2 &&
+	    (!isRealSyntax(MI) || (detail_is_set(MI) && !isRealDetail(MI))))
+		printCompressedOperandForms(MI, O);
+	else
+		printOperandForms(MI, MI, O);
+}
