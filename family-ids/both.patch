+CAPSTONE_INTERNAL const char *
+matchMipsAliasPatterns(MCInst *MI, const AliasMatchingData *data);
+CAPSTONE_INTERNAL const char *
+matchARMAliasPatterns(MCInst *MI, const AliasMatchingData *data);
+CAPSTONE_INTERNAL const char *
