diff --git a/arch/AArch64/AArch64InstPrinter.c b/arch/AArch64/AArch64InstPrinter.c
index 7537d3f9..5026e15e 100644
--- a/arch/AArch64/AArch64InstPrinter.c
+++ b/arch/AArch64/AArch64InstPrinter.c
@@ -629,7 +629,14 @@ add_real_detail:
 		map_set_fill_detail_ops(MI, !(isAlias && useAliasDetails));
 		if (isAlias)
 			SStream_Close(O);
-		printInstruction(MI, Address, O);
+		/* Some operand printers format a temporary suffix even when the
+		 * output stream is closed. Preserve custom formatter calls. */
+#if defined(CAPSTONE_USE_SYS_DYN_MEM) && !defined(CAPSTONE_HAS_OSXKERNEL) && \
+	!defined(_KERNEL_MODE) && !defined(_WIN32_WCE)
+		if (!isAlias || detail_is_set(MI) ||
+		    cs_vsnprintf != cs_default_vsnprintf)
+#endif
+			printInstruction(MI, Address, O);
 		if (isAlias)
 			SStream_Open(O);
 	}
diff --git a/arch/Mips/MipsInstPrinter.c b/arch/Mips/MipsInstPrinter.c
index 77ae0309..864621d1 100644
--- a/arch/Mips/MipsInstPrinter.c
+++ b/arch/Mips/MipsInstPrinter.c
@@ -271,7 +271,9 @@ void Mips_LLVM_printInst(MCInst *MI, uint64_t Address, SStream *O)
 	bool useAliasDetails = map_use_alias_details(MI);
 	if (!useAliasDetails) {
 		SStream_Close(O);
-		printInstruction(MI, Address, O);
+		/* This pass only collects operands of the real instruction. */
+		if (detail_is_set(MI))
+			printInstruction(MI, Address, O);
 		SStream_Open(O);
 		map_set_fill_detail_ops(MI, false);
 	}
