+++ b/cs.c
@@ -969,7 +969,9 @@ static int str_replace(char *result, char *target, const char *str1, char *str2)
 }
 #endif
 
+#define CS_DECODE_PUBLIC_X86
 #include "cs_disasm_internal.h"
