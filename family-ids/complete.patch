 /* Keep the generic copy specialized without the private x86 length checks. */
 #if defined(__GNUC__)
diff --git a/cs_disasm_internal.h b/cs_disasm_internal.h
index b0f4a6ce..cee65f44 100644
--- a/cs_disasm_internal.h
+++ b/cs_disasm_internal.h
@@ -170,6 +170,19 @@ CS_DECODE_INLINE bool decode_insn(cs_struct *handle, const uint8_t *code,
 #endif
 	}
 #endif
+#if defined(CS_DECODE_PUBLIC_X86) && defined(CAPSTONE_X86_MIXED_OUTPUT)
+	/* The array allocator may change detail mode after creating the record.
+	 * Pass the original batch policy through every fallback. */
+	if (handle->arch == CS_ARCH_X86 && size && !handle->no_text &&
+	    (!insn->detail || handle->detail_opt)) {
+		if (handle->mode == CS_MODE_64)
+			return X86_decodeRecord64(handle, code, size, insn,
+						  insn_size, batch);
+		if (handle->mode == CS_MODE_32)
+			return X86_decodeRecord32(handle, code, size, insn,
+						  insn_size, batch);
+	}
+#endif
 #ifdef CS_DECODE_TRY_OUTPUT
 	if (CS_DECODE_TRY_OUTPUT(handle, code, size, insn, insn_size))
 		return true;
