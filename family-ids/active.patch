diff --git a/cs.c b/cs.c
index c87f3f47..8984b895 100644
--- a/cs.c
+++ b/cs.c
@@ -819,6 +819,24 @@ const char *CAPSTONE_API cs_strerror(cs_err code)
 	}
 }
 
+#ifdef CAPSTONE_PUBLIC_ITERATOR_DISPATCH
+#include "arch/X86/X86ScanAdapter.h"
+
+/* Reuse the fixed readers' iterator contracts. Select once when the handle's
+ * architecture, mode or text option is set. Other options are read by the
+ * decoder on each call, including mnemonic overrides and skipdata callbacks. */
+static void select_public_iterator(cs_struct *handle)
+{
+	handle->public_iterator = cs_disasm_default_iter;
+	if (handle->arch == CS_ARCH_X86 && !handle->no_text) {
+		if (handle->mode == CS_MODE_32)
+			handle->public_iterator = X86_disasmIter32;
+		else if (handle->mode == CS_MODE_64)
+			handle->public_iterator = X86_disasmIterText;
+	}
+}
+#endif
+
 CAPSTONE_EXPORT
 cs_err CAPSTONE_API cs_open(cs_arch arch, cs_mode mode, csh *handle)
 {
@@ -865,6 +883,9 @@ cs_err CAPSTONE_API cs_open(cs_arch arch, cs_mode mode, csh *handle)
 	if ((err = populate_insn_map_cache(ud)))
 		goto fail;
 
+#ifdef CAPSTONE_PUBLIC_ITERATOR_DISPATCH
+	select_public_iterator(ud);
+#endif
 	*handle = (uintptr_t)ud;
 	return CS_ERR_OK;
 
@@ -1310,6 +1331,9 @@ cs_err CAPSTONE_API cs_option(csh ud, cs_opt_type type, uintptr_t value)
 
 	case CS_OPT_TEXT:
 		handle->no_text = value == CS_OPT_OFF;
+#ifdef CAPSTONE_PUBLIC_ITERATOR_DISPATCH
+		select_public_iterator(handle);
+#endif
 		return CS_ERR_OK;
 
 	case CS_OPT_DETAIL:
@@ -1429,7 +1453,12 @@ cs_err CAPSTONE_API cs_option(csh ud, cs_opt_type type, uintptr_t value)
 	if (!arch_configs[handle->arch].arch_option)
 		return CS_ERR_ARCH;
 
-	return arch_configs[handle->arch].arch_option(handle, type, value);
+	cs_err result = arch_configs[handle->arch].arch_option(handle, type, value);
+#ifdef CAPSTONE_PUBLIC_ITERATOR_DISPATCH
+	if (result == CS_ERR_OK && type == CS_OPT_MODE)
+		select_public_iterator(handle);
+#endif
+	return result;
 }
 
 // generate @op_str for data instruction of SKIPDATA
@@ -1731,12 +1760,19 @@ cs_insn *CAPSTONE_API cs_malloc(csh ud)
 	return insn;
 }
 
-#ifndef CAPSTONE_HAS_X86
+#if !defined(CAPSTONE_HAS_X86) || defined(CAPSTONE_PUBLIC_ITERATOR_DISPATCH)
 CAPSTONE_EXPORT
 bool CAPSTONE_API cs_disasm_iter(csh ud, const uint8_t **code, size_t *size,
 				 uint64_t *address, cs_insn *insn)
 {
+#ifdef CAPSTONE_PUBLIC_ITERATOR_DISPATCH
+	if (!*size || !ud)
+		return false;
+	cs_struct *handle = (cs_struct *)(uintptr_t)ud;
+	return handle->public_iterator(ud, code, size, address, insn);
+#else
 	return cs_disasm_iter_core(ud, code, size, address, insn);
+#endif
 }
 #endif
 
