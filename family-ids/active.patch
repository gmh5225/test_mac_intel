diff --git a/arch/SystemZ/SystemZInstPrinter.c b/arch/SystemZ/SystemZInstPrinter.c
index ee9eb18e..2076bd60 100644
--- a/arch/SystemZ/SystemZInstPrinter.c
+++ b/arch/SystemZ/SystemZInstPrinter.c
@@ -146,15 +146,40 @@ static void printMCOperand(const MCInst *MI, const MCOperand *MO, SStream *O)
 		CS_ASSERT_RET(0 && "Invalid operand");
 }
 
+#ifndef CAPSTONE_DIET
+#include "../../utils.h"
+#include "SystemZGenRegisterOutput.inc"
+#endif
+
 void printFormattedRegName(const MCAsmInfo *MAI, MCRegister Reg, SStream *O)
 {
+#ifndef CAPSTONE_DIET
+	/* The four bytes hold either a complete shorter spelling and its NUL,
+	 * or all four characters of the longer one. Keep the two separate
+	 * register spans for markup and preserve partial appends at capacity. */
+	if (MAI->assemblerDialect == SYSTEMZASMDIALECT_AD_ATT &&
+	    !O->is_closed && !O->markup_stream && !O->prefixed_by_markup &&
+	    O->index < SSTREAM_BUF_LEN - 4 &&
+	    (unsigned)(Reg - 1) < ARR_SIZE(systemz_gnu_registers)) {
+		const char *text = systemz_gnu_registers[Reg - 1];
+		if (text[0]) {
+			char *out = O->buffer + O->index;
+			const unsigned length = 3 + (text[3] != 0);
+			memcpy(out, text, 4);
+			out[length] = '\0';
+			O->index += length;
+			return;
+		}
+	}
+#endif
 	const char *RegName = getRegisterName(Reg);
-	if (MAI->assemblerDialect == SYSTEMZASMDIALECT_AD_ATT) {
+	if (MAI->assemblerDialect == SYSTEMZASMDIALECT_AD_HLASM) {
 		// Skip register prefix so that only register number is left
 		CS_ASSERT((isalpha(RegName[0]) && isdigit(RegName[1])));
 		SStream_concat0(markup_OS(O, Markup_Register), (RegName + 1));
-	} else
-		SStream_concat1(markup_OS(O, Markup_Register), '%');
+		return;
+	}
+	SStream_concat1(markup_OS(O, Markup_Register), '%');
 	SStream_concat0(markup_OS(O, Markup_Register), RegName);
 }
 
diff --git a/suite/synctools/systemz_register_output.c b/suite/synctools/systemz_register_output.c
new file mode 100644
index 00000000..9816dfa0
--- /dev/null
+++ b/suite/synctools/systemz_register_output.c
@@ -0,0 +1,35 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+/* Generate fixed-size GNU spelling records from the public register names.
+ * Build with a full SystemZ library and redirect stdout to the include file. */
+#include <capstone/capstone.h>
+#include <stdio.h>
+#include <string.h>
+
+int main(void)
+{
+	csh handle;
+	if (cs_open(CS_ARCH_SYSTEMZ, CS_MODE_BIG_ENDIAN, &handle) != CS_ERR_OK)
+		return 1;
+	puts("/* Generated by suite/synctools/systemz_register_output.c. */");
+	puts("static const char systemz_gnu_registers[][5] = {");
+	for (unsigned reg = 1; reg < SYSTEMZ_REG_ENDING; ++reg) {
+		const char *name = cs_reg_name(handle, reg);
+		if (!name) {
+			fprintf(stderr,
+				"missing SystemZ name for register %u\n", reg);
+			cs_close(&handle);
+			return 1;
+		}
+		const size_t n = strlen(name);
+		if ((n == 2 || n == 3) &&
+		    strspn(name, "abcdefghijklmnopqrstuvwxyz0123456789") == n)
+			printf("\t\"%%%s\",\n", name);
+		else
+			puts("\t\"\",");
+	}
+	puts("};");
+	cs_close(&handle);
+	return 0;
+}
