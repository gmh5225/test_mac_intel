+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE)
+void X86_get_insn_id(cs_struct *h, cs_insn *insn, unsigned int id)
+{
+	if ((id == X86_VZEROALL || id == X86_VZEROUPPER) && h->detail_opt &&
+	    x86_get_bit_mode(h->mode) != CS_MODE_64) {
+		X86_map_full_register_bank(h, insn, id);
+		/* The legacy register file ends at YMM7. Clear only the eight
+		 * unavailable entries written by the full mapping row. */
+		cs_detail *detail = insn->detail;
+		memset(detail->regs_write + 8, 0, 8 * sizeof(detail->regs_write[0]));
+		detail->regs_write_count = 8;
+		return;
+	}
+	X86_map_full_register_bank(h, insn, id);
+}
