-            f"Stale {target}; rerun {Path(__file__).name}",
-        )
-    else:
-        target.write_text(text)
+    operands = (
+        "/* SPDX-License-Identifier: BSD-3-Clause */\n"
+        "/* Generated by suite/synctools/x86_mapping_counts.py. */\n"
+        "#ifdef CAPSTONE_X86_REDUCE\n"
+        + generate_operand_access(directory, "_reduce")
+        + "#else\n"
+        + generate_operand_access(directory, "")
+        + "#endif\n"
+    )
+    for filename, contents in (("X86GenMappingCounts.inc", text),
+                               ("X86GenOperandAccess.inc", operands)):
+        target = directory / filename
+        if args.check:
+            require(target.exists() and target.read_text() == contents,
+                    f"Stale {target}; rerun {Path(__file__).name}")
+        else:
+            target.write_text(contents)
 
 
