+static inline void copy_implicit_writes(cs_detail *detail, const insn_map_x86 *row)
+{
+	/* The public mapper replaces the first twenty slots even if the caller
+	 * reuses nonzero detail storage. The compact row supplies the first twelve. */
+	memcpy(detail->regs_write, row->regs_mod, sizeof(row->regs_mod));
+	memset(detail->regs_write + ARR_SIZE(row->regs_mod), 0,
+	       (20 - ARR_SIZE(row->regs_mod)) * sizeof(detail->regs_write[0]));
+}
