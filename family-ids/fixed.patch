 #!/usr/bin/env python3
 # SPDX-License-Identifier: BSD-3-Clause
-"""Project implicit register and group counts from the x86 mapping tables."""
+"""Project x86 implicit counts and explicit operand access from the mapping tables."""
 
 import argparse
 from pathlib import Path
@@ -173,6 +173,40 @@ def generate(directory, suffix):
     return "\n".join(lines + ["};", ""])
 
 
+def generate_operand_access(directory, suffix):
+    """Share identical flag and explicit-access records in canonical opcode order."""
+    source = (directory / f"X86MappingInsnOp{suffix}.inc").read_text()
+    pattern = re.compile(
+        r"\{\s*/\*\s*(X86_\w+),[^\n]*?\*/\s*([^,{}]+),\s*\{([^{}]+)\}\s*\},"
+    )
+    rows = list(pattern.finditer(source))
+    remainder = re.sub(r"/\*.*?\*/", "", pattern.sub("", source), flags=re.S)
+    require(not remainder.strip(), "Unexpected operand-access table syntax")
+    mapped = entries((directory / f"X86MappingInsn{suffix}.inc").read_text())
+    require([row[1] for row in rows] == [row[1] for row in mapped],
+            "Operand-access rows must match the opcode mapping order")
+
+    classes = {}
+    indices = []
+    for row in rows:
+        flags = " | ".join(sorted(token.strip() for token in row[2].split("|")))
+        access = tuple(token.strip() for token in row[3].split(","))
+        require(access[-1] == "0" and "0" not in access[:-1],
+                f"Unterminated access for {row[1]}")
+        key = (flags, access)
+        indices.append(classes.setdefault(key, len(classes)))
+
+    index_type = "uint8_t" if len(classes) <= 256 else "uint16_t"
+    lines = [f"static const {index_type} x86_operand_indices[] = {{"]
+    for i in range(0, len(indices), 16):
+        lines.append("\t" + ", ".join(str(v) for v in indices[i : i + 16]) + ",")
+    lines.extend(["};", "", "static const insn_op x86_operand_classes[] = {"])
+    for flags, access in classes:
+        lines.append("\t{ " + flags + ", { " + ", ".join(access) + " } },")
+    lines.extend(["};", ""])
+    return "\n".join(lines)
+
+
 def main():
     parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--check", action="store_true")
@@ -189,14 +223,23 @@ def main():
