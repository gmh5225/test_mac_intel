+#if defined(CAPSTONE_X86_PUBLIC_RECORD) && !defined(CAPSTONE_X86_ONLY)
+static void select_x86_iterator(cs_struct *handle)
+{
+	if (handle->arch != CS_ARCH_X86)
+		handle->x86_iterator_kind = CS_X86_ITER_FULL;
+	else if (!handle->no_text)
+		handle->x86_iterator_kind = CS_X86_ITER_OUTPUT;
+	else
+		handle->x86_iterator_kind = handle->detail_opt ?
+						    CS_X86_ITER_FULL :
+						    CS_X86_ITER_SCAN;
+}
+#endif
