diff --git a/arch/X86/X86Sse64Output.c b/arch/X86/X86Sse64Output.c
index 96ce9f72..33aea0f9 100644
--- a/arch/X86/X86Sse64Output.c
+++ b/arch/X86/X86Sse64Output.c
@@ -257,6 +257,22 @@ static bool writeRoundedRegisters(const uint8_t *code, cs_insn *insn,
 #undef X86_FIXED_WIDE
 #undef X86_FIXED_OUTPUT
 #define CS_DECODE_OUTPUT_MISS X86_decodeOutputMiss64
+#ifdef CAPSTONE_X86_MIXED_OUTPUT
+CS_PRESERVE_MOST bool X86_decodeRecord64(cs_struct *handle,
+				       const uint8_t *code, size_t size,
+				       cs_insn *insn, uint16_t *insn_size,
+				       bool batch)
+{
+	/* The array allocator may change detail mode after allocating this record. */
+	if (!size || handle->no_text || (insn->detail && !handle->detail_opt))
+		return cs_decode_full_insn(handle, code, size, insn, insn_size, batch);
+	if (tryOutput64(handle, code, size, insn, insn_size))
+		return true;
+	return X86_decodeOutputMiss64(handle, code, size, insn, insn_size,
+				      batch);
+}
+#endif
+
 #define CS_DECODE_TRY_OUTPUT tryOutput64
 #include "../../cs_disasm_internal.h"
 #undef CS_DECODE_OUTPUT_MISS
