+static bool check_vector_clear_writes(void)
+{
+	if (cs_support(CS_SUPPORT_X86_REDUCE))
+		return true;
+
+	const cs_mode modes[] = { CS_MODE_64, CS_MODE_32 | CS_MODE_X86_INTEL,
+				  CS_MODE_16, CS_MODE_64 | CS_MODE_X86_AMD };
+	const uint8_t bytes[][4] = { { 0xc5, 0xf8, 0x77 },
+				     { 0xc5, 0xfc, 0x77 },
+				     { 0xc4, 0xe1, 0x78, 0x77 },
+				     { 0xc4, 0xe1, 0x7c, 0x77 } };
+	csh h = 0;
+	if (cs_open(CS_ARCH_X86, modes[0], &h) != CS_ERR_OK)
+		return false;
+	bool ok = cs_option(h, CS_OPT_DETAIL, CS_OPT_ON) == CS_ERR_OK;
+	for (unsigned m = 0; m < sizeof(modes) / sizeof(modes[0]) && ok; ++m) {
+		const unsigned expected = modes[m] & CS_MODE_64 ? 16 : 8;
+		ok = cs_option(h, CS_OPT_MODE, modes[m]) == CS_ERR_OK;
+		for (unsigned n = 0; n < sizeof(bytes) / sizeof(bytes[0]) && ok;
+		     ++n) {
+			cs_insn *insn = NULL;
+			size_t size = n < 2 ? 3 : 4;
+			size_t count =
+				cs_disasm(h, bytes[n], size, 0, 1, &insn);
+			cs_regs reads, writes;
+			uint8_t nr, nw;
+			ok = count == 1 && insn->size == size &&
+			     insn->id == (n % 2 ? X86_INS_VZEROALL :
+						  X86_INS_VZEROUPPER) &&
+			     insn->detail->regs_write_count == expected &&
+			     cs_regs_access(h, insn, reads, &nr, writes, &nw) ==
+				     CS_ERR_OK &&
+			     nw == expected;
+			for (unsigned i = 0; ok && i < expected; ++i)
+				ok = insn->detail->regs_write[i] ==
+					     X86_REG_YMM0 + i &&
+				     writes[i] == X86_REG_YMM0 + i;
+			cs_free(insn, count);
+			if (!ok)
+				fprintf(stderr,
+					"vector clear writes: mode=%u encoding=%u\n",
+					(unsigned)modes[m], n);
+		}
+	}
+	cs_close(&h);
+	return ok;
+}
+
 static bool check_test_operands(void)
 {
 	static const unsigned widths[] = { 1, 2, 4, 8 };
