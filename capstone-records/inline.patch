--- a/arch/AArch64/AArch64Disassembler.c
+++ b/arch/AArch64/AArch64Disassembler.c
@@ -333,6 +333,31 @@
 #define Fail MCDisassembler_Fail
 #define SoftFail MCDisassembler_SoftFail
 
+/* These A64 classes have no reserved operand encodings. For a text-free
+ * scan, the table's internal opcode suffices for the normal public mapper. */
+static unsigned scanImmediateOpcode(uint32_t word)
+{
+	if ((word & 0x7c000000) == 0x14000000)
+		return word >> 31 ? AArch64_BL : AArch64_B;
+	if ((word & 0x1f000000) == 0x10000000)
+		return word >> 31 ? AArch64_ADRP : AArch64_ADR;
+	if ((word & 0x7e000000) == 0x34000000) {
+		static const unsigned opcodes[2][2] = {
+			{ AArch64_CBZW, AArch64_CBNZW },
+			{ AArch64_CBZX, AArch64_CBNZX },
+		};
+		return opcodes[word >> 31][(word >> 24) & 1];
+	}
+	if ((word & 0x1f800000) == 0x11000000) {
+		static const unsigned opcodes[8] = {
+			AArch64_ADDWri, AArch64_ADDSWri, AArch64_SUBWri, AArch64_SUBSWri,
+			AArch64_ADDXri, AArch64_ADDSXri, AArch64_SUBXri, AArch64_SUBSXri,
+		};
+		return opcodes[word >> 29];
+	}
+	return 0;
+}
+
 static DecodeStatus getInstruction(csh handle, const uint8_t *Bytes,
 				   size_t ByteLen, MCInst *MI, uint16_t *Size,
 				   uint64_t Address, void *Info)
@@ -345,6 +370,13 @@
 
 	// Encoded as a small-endian 32-bit word in the stream.
 	uint32_t Insn = readBytes32(MI, Bytes);
+	if (MI->csh->no_text && !MI->flat_insn->detail && MI->csh->disasm == AArch64_getInstruction) {
+		unsigned opcode = scanImmediateOpcode(Insn);
+		if (opcode) {
+			MCInst_setOpcode(MI, opcode);
+			return MCDisassembler_Success;
+		}
+	}
 
 	const uint8_t *Tables[] = { DecoderTable32, DecoderTableFallback32 };
 
