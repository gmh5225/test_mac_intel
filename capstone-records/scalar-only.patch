+/* 32- and 64-bit memory operands have the same SIB and displacement
+ * extents. The caller checks the final end against the architectural limit. */
+X86_DECODE_INLINE unsigned scanMemoryEnd(const uint8_t *code, size_t size,
+					 unsigned end, uint8_t modrm)
+{
+	const unsigned mod = modrm >> 6, rm = modrm & 7;
+	static const uint8_t extra[3][8] = { { 0, 0, 0, 0, 1, 4, 0, 0 },
+					     { 1, 1, 1, 1, 2, 1, 1, 1 },
+					     { 4, 4, 4, 4, 5, 4, 4, 4 } };
+	if ((modrm & 0xc7) == 4) {
+		if (end >= size)
+			return 16;
+		if ((code[end] & 7) == 5)
+			end += 4;
+	}
+	return end + extra[mod][rm];
+}
