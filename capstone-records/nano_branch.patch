+static bool check_mode_changes(void)
+{
+	static const cs_mode modes[] = {
+		CS_MODE_MIPS64R6 | CS_MODE_MIPS_PTR64, CS_MODE_MICRO,
+		CS_MODE_NMS1, CS_MODE_MIPS16, CS_MODE_I7200,
+		CS_MODE_MIPS32 | CS_MODE_BIG_ENDIAN, CS_MODE_NANOMIPS,
+		CS_MODE_MIPS64R2, CS_MODE_OCTEONP, CS_MODE_MIPS32,
+	};
+	csh handles[2] = { 0 };
+	bool ok = false;
+	if (cs_open(CS_ARCH_MIPS, CS_MODE_MIPS32, &handles[0]))
+		return false;
+	for (unsigned i = 0; i < sizeof(modes) / sizeof(modes[0]); ++i) {
+		const cs_mode mode = modes[i];
+		if (cs_option(handles[0], CS_OPT_MODE, mode) ||
+		    cs_open(CS_ARCH_MIPS, mode, &handles[1]))
+			goto done;
+		for (unsigned k = 0; k < 2; ++k)
+			if (cs_option(handles[k], CS_OPT_DETAIL, CS_OPT_ON))
+				goto done;
+		for (unsigned major = 0; major < 64; ++major)
+			for (unsigned reg = 0; reg < 32; ++reg) {
+				const uint32_t word = (major << 26) |
+					(reg << 16) | (reg << 11) | reg;
+				if (!compare(handles, word,
+					     (mode & CS_MODE_BIG_ENDIAN) != 0,
+					     4, false))
+					goto done;
+			}
+		cs_close(&handles[1]);
+	}
+	ok = true;
+done:
+	if (handles[1])
+		cs_close(&handles[1]);
+	cs_close(&handles[0]);
+	return ok;
+}
+
 int main(void)
 {
+	if (!check_mode_changes())
+		return 1;
 	const cs_mode modes[] = { CS_MODE_MIPS32, CS_MODE_MIPS64,
 				  CS_MODE_MIPS32 | CS_MODE_BIG_ENDIAN,
 				  CS_MODE_MIPS64 | CS_MODE_BIG_ENDIAN };
