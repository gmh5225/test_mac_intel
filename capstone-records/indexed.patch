+/* Intel syntax suppresses the absent SIB index in 32-bit mode. The
+ * encoded scale and any segment override remain visible in detail. */
+bool X86_writeLea32(const uint8_t *code, size_t size, cs_insn *insn,
+		    uint16_t *insn_size, const struct X86SimpleOutput *row,
+		    const struct X86SimpleRegister regs[4][16])
+{
+	const bool cs = code[0] == 0x2e;
+	const unsigned offset = cs + 3;
+	if (size < offset || code[cs] != 0x8d)
+		return false;
+	const uint8_t modrm = code[cs + 1], sib = code[cs + 2];
+	const unsigned mod = modrm >> 6, base = sib & 7;
+	if (mod == 3 || (modrm & 7) != 4 || ((sib >> 3) & 7) != 4 ||
+	    (!mod && base == 5))
+		return false;
+	const unsigned disp_size = mod == 2 ? 4 : mod;
+	const unsigned length = offset + disp_size;
+	if (size < length)
+		return false;
+	int32_t disp = 0;
+	if (disp_size == 1)
+		disp = (int8_t)code[offset];
+	else if (disp_size == 4)
+		disp = X86_readDisp32(code + offset);
+
+	const struct X86SimpleRegister *dst = &regs[2][(modrm >> 3) & 7];
+	const struct X86SimpleRegister *addr = &regs[2][base];
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)length;
+	memcpy(insn->bytes, code, length);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, dst->name, dst->length);
+	char *out = insn->op_str + dst->length;
+	if (cs) {
+		memcpy(out, ", cs:[", 6);
+		out += 6;
+	} else {
+		memcpy(out, ", [", 3);
+		out += 3;
+	}
+	memcpy(out, addr->name, addr->length);
+	out = X86_writeDisplacement(out + addr->length, disp);
+	*out = ']';
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, 0x8d, 0, modrm,
+				      dst->reg, 0);
+		cs_x86 *x = &insn->detail->x86;
+		x->encoding.modrm_offset += cs;
+		x->sib = sib;
+		x->sib_base = (x86_reg)addr->reg;
+		x->sib_scale = (int8_t)(1 << (sib >> 6));
+		x->disp = disp;
+		if (disp_size) {
+			x->encoding.disp_offset = (uint8_t)offset;
+			x->encoding.disp_size = (uint8_t)disp_size;
+		}
+		cs_x86_op *op = &x->operands[1];
+		op->type = X86_OP_MEM;
+		op->mem.base = x->sib_base;
+		op->mem.scale = x->sib_scale;
+		op->mem.disp = disp;
+		if (cs) {
+			op->mem.segment = X86_REG_CS;
+			x->prefix[1] = 0x2e;
+		}
+	}
+	return true;
+}
