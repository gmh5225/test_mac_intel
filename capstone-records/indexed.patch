 	!defined(_WIN32_WCE)
 #include "X86SimpleOutput.h"
 
+/* In 32-bit addressing, an unprefixed mod=0, r/m=5 displacement is the
+ * entire address. The Intel printer renders its unsigned 32-bit value. */
+static char *writeAbsoluteAddress(char *out, uint32_t address)
+{
+	if (address <= HEX_THRESHOLD) {
+		*out++ = (char)('0' + address);
+		return out;
+	}
+	char digits[8], *p = digits + sizeof(digits);
+	do {
+		*--p = "0123456789abcdef"[address & 15];
+		address >>= 4;
+	} while (address);
+	memcpy(out, "0x", 2);
+	const size_t length = (size_t)(digits + sizeof(digits) - p);
+	memcpy(out + 2, p, length);
+	return out + 2 + length;
+}
+
 /* No-base SIB and encodings exposing EIZ/RIZ retain the general printer. */
 bool X86_writeMemoryOutput(const uint8_t *code, size_t size, cs_insn *insn,
 			   uint16_t *insn_size,
@@ -20,11 +39,11 @@ bool X86_writeMemoryOutput(const uint8_t *code, size_t size, cs_insn *insn,
