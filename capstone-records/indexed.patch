+	[ARR_SIZE(arm_empty_operands) == NUM_ARM_OPS ? 1 : -1];
+typedef char ARMOperandDefaultsCoverTail
+	[offsetof(cs_arm, operands) + sizeof(arm_empty_operands) ==
