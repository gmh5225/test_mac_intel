         set_property(SOURCE arch/X86/X86ImmediateOutput.c arch/X86/X86MemoryOutput.c arch/X86/X86OutputIterator.c arch/X86/X86VectorOutput.c
diff --git a/Makefile b/Makefile
index 80398b9b..d5084a3a 100644
--- a/Makefile
+++ b/Makefile
@@ -657,8 +657,8 @@ else
 	@echo "Skipping tests on whole corpus"
 endif
 
-# Match the Release x86-only formatter tuning for the compiler's target.
-ifeq ($(sort $(CAPSTONE_ARCHS)),x86)
+# Match the Release x86 formatter tuning for the compiler's target.
+ifneq (,$(filter x86,$(CAPSTONE_ARCHS)))
 ifneq (,$(filter -O2 -O3,$(CFLAGS)))
 X86_OUTPUT_STORE_FLAG := $(shell $(CC) $(CFLAGS) -dM -E -x c - < /dev/null 2>/dev/null | \
     awk '$$2 == "__linux__" { linux_target=1 } $$2 == "__x86_64__" { x64=1 } \
diff --git a/arch/X86/X86DisassemblerDecoder.c b/arch/X86/X86DisassemblerDecoder.c
index 76fdbcb7..67cf202a 100644
--- a/arch/X86/X86DisassemblerDecoder.c
+++ b/arch/X86/X86DisassemblerDecoder.c
@@ -2944,7 +2944,7 @@ X86_DECODE_INLINE int finishDecodedInstruction(struct InternalInstruction *insn,
 
 /* GCC materializes the general legacy reader state on these Linux hosts.
  * The generated terminal row already provides the public ID and extent. */
-#if defined(CAPSTONE_X86_ONLY) && defined(__linux__) && defined(__GNUC__) && \
+#if defined(__linux__) && defined(__GNUC__) && \
     !defined(__clang__) && (defined(__x86_64__) || defined(__aarch64__))
 #define X86_COMPACT_PUBLIC_HEADER
 #endif
@@ -3773,11 +3773,27 @@ X86_DECODE_INLINE bool decodeIteratorScan(cs_struct *handle,
 	return true;
 }
 
+#if defined(X86_COMPACT_PUBLIC_HEADER) && !defined(CAPSTONE_X86_ONLY)
+/* Other architectures never enter the x86 scanner. Keep their per-instruction
+ * stack frame independent of the compiled legacy and vector scan tables. */
+static __attribute__((noinline)) bool
+decodeFullIterator(csh handle, const uint8_t **code, size_t *size,
+		   uint64_t *address, cs_insn *insn)
+{
+	return cs_disasm_iter_core_mode(handle, code, size, address, insn,
+					false);
+}
+#endif
+
 CAPSTONE_EXPORT
 X86_DECODE_ALIGN
 bool CAPSTONE_API cs_disasm_iter(csh ud, const uint8_t **code, size_t *size,
 				 uint64_t *address, cs_insn *insn)
 {
+#if defined(X86_COMPACT_PUBLIC_HEADER) && !defined(CAPSTONE_X86_ONLY)
+	if (ud && ((cs_struct *)(uintptr_t)ud)->arch != CS_ARCH_X86)
+		return decodeFullIterator(ud, code, size, address, insn);
+#endif
 	return cs_disasm_iter_core(ud, code, size, address, insn);
 }
 
diff --git a/cs_disasm_internal.h b/cs_disasm_internal.h
