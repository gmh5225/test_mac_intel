@@ -3780,6 +3780,11 @@ X86_DECODE_ALIGN
 bool CAPSTONE_API cs_disasm_iter(csh ud, const uint8_t **code, size_t *size,
 				 uint64_t *address, cs_insn *insn)
 {
+#ifdef CAPSTONE_ARM_AARCH64_MIPS_X86
+	const cs_struct *handle = (const cs_struct *)(uintptr_t)ud;
+	if (handle && handle->arch != CS_ARCH_X86)
+		return cs_disasm_iter_full(ud, code, size, address, insn);
+#endif
 	return cs_disasm_iter_core(ud, code, size, address, insn);
 }
 
