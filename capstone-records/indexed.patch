+static bool check_absent_sib_index(csh handles[2])
+{
+	const uint8_t opcodes[] = { 0x01, 0x03, 0x29, 0x2b, 0x39, 0x3b, 0x84,
+				    0x85, 0x88, 0x89, 0x8a, 0x8b, 0x8d, 0xff };
+	for (unsigned op = 0; op < sizeof(opcodes); ++op)
+		for (unsigned mod = 0; mod < 4; ++mod)
+			for (unsigned base = 0; base < 8; ++base)
+				for (unsigned scale = 0; scale < 4; ++scale) {
+					uint8_t code[] = {
+						opcodes[op],
+						(uint8_t)((mod << 6) | 0x34),
+						(uint8_t)((scale << 6) | 0x20 |
+							  base),
+						0x80,
+						0xff,
+						0xff,
+						0xff
+					};
+					for (unsigned length = 0;
+					     length <= sizeof(code); ++length)
+						if (!compare(handles, code,
+							     length,
+							     op + mod + base +
+								     scale))
+							return false;
+				}
+	return true;
+}
