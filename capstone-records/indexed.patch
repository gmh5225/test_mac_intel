 CS_DECODE_INLINE bool cs_disasm_iter_body(struct cs_struct *handle,
 					  const uint8_t **code, size_t *size,
-					  uint64_t *address, cs_insn *insn)
+					  uint64_t *address, cs_insn *insn,
+					  bool scan)
 {
 	uint16_t insn_size;
 	bool r;
 
 	handle->errnum = CS_ERR_OK;
 
-	const bool scan = use_x86_scan(handle);
 	insn->address = *address;
 #ifdef CAPSTONE_DIET
 	// zero out mnemonic & op_str
@@ -197,9 +197,9 @@ CS_DECODE_INLINE bool cs_disasm_iter_body(struct cs_struct *handle,
 	return true;
 }
 
-CS_DECODE_INLINE bool cs_disasm_iter_core(csh ud, const uint8_t **code,
-					  size_t *size, uint64_t *address,
-					  cs_insn *insn)
+CS_DECODE_INLINE bool cs_disasm_iter_core_mode(csh ud, const uint8_t **code,
+					       size_t *size, uint64_t *address,
+					       cs_insn *insn, bool allow_scan)
 {
 	struct cs_struct *handle = (struct cs_struct *)(uintptr_t)ud;
 	cs_detail *detail;
@@ -215,9 +215,17 @@ CS_DECODE_INLINE bool cs_disasm_iter_core(csh ud, const uint8_t **code,
 	detail = insn->detail;
 	if (CS_DECODE_LIKELY(!handle->detail_opt))
 		insn->detail = NULL;
-	r = cs_disasm_iter_body(handle, code, size, address, insn);
+	r = cs_disasm_iter_body(handle, code, size, address, insn,
+				allow_scan && use_x86_scan(handle));
 	insn->detail = detail;
 	return r;
 }
 
+CS_DECODE_INLINE bool cs_disasm_iter_core(csh ud, const uint8_t **code,
+					  size_t *size, uint64_t *address,
+					  cs_insn *insn)
+{
+	return cs_disasm_iter_core_mode(ud, code, size, address, insn, true);
+}
+
 #endif
