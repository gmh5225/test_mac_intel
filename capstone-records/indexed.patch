+	memcpy(insn->bytes, code, length);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = writeVectorRegister(insn->op_str, 0, number);
+	memcpy(out, ", ", 2);
+	out += 2;
+	if (value <= HEX_THRESHOLD) {
+		*out = (char)('0' + value);
+	} else {
+		static const char digits[] = "0123456789abcdef";
+		memcpy(out, "0x", 2);
+		out += 2;
+		if (value >= 16)
+			*out++ = digits[value >> 4];
+		*out = digits[value & 15];
+	}
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		memcpy(d->groups, row->groups, sizeof(row->groups));
+		d->groups_count = row->group_count;
+		cs_x86 *x = &d->x86;
+		x->prefix[2] = 0x66;
+		x->opcode[0] = 0x0f;
+		x->opcode[1] = (uint8_t)opcode;
+		x->rex = (uint8_t)rex;
+		x->addr_size = wide ? 8 : 4;
+		x->modrm = (uint8_t)modrm;
+		x->encoding.modrm_offset = (uint8_t)(length - 2);
+		x->encoding.imm_offset = (uint8_t)(length - 1);
+		x->encoding.imm_size = 1;
+		x->op_count = 2;
+		cs_x86_op *op = &x->operands[0];
+		op->type = X86_OP_REG;
+		op->reg = (x86_reg)(X86_REG_XMM0 + number);
+		op->size = 16;
+		op->access = (cs_ac_type)row->access[0];
+		op = &x->operands[1];
+		op->type = X86_OP_IMM;
+		op->imm = value;
+		op->size = 1;
+		op->access = (cs_ac_type)row->access[1];
+	}
+	return true;
