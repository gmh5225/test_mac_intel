+X86_DECODE_INLINE unsigned vexMemoryEnd(const uint8_t *code, size_t size,
+					unsigned end, uint8_t modrm)
+{
+	const unsigned mod = modFromModRM(modrm);
+	const unsigned rm = rmFromModRM(modrm);
+	if (rm == 4) {
+		if (end >= size)
+			return 16;
+		const uint8_t sib = code[end++];
+		if (mod == 0 && baseFromSIB(sib) == 5)
+			return end + 4;
+	} else if (mod == 0 && rm == 5) {
+		return end + 4;
+	}
+	return end + (mod == 1 ? 1 : mod == 2 ? 4 : 0);
+}
