index 00000000..d18108ee
--- /dev/null
+++ b/suite/synctools/test_ppc_alias_hints.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+import ast
+import importlib.util
+from pathlib import Path
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+SPEC = importlib.util.spec_from_file_location("ppc_alias_hints", ROOT / "suite/synctools/ppc_alias_hints.py")
+GEN = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(GEN)
+
+
+def writer(strings):
+    offset, patterns, records = 0, [], []
+    for raw in strings:
+        patterns.append("{%d, 0, 0, 0 }" % offset)
+        records.append('/* %d */ "%s"' % (offset, raw))
+        offset += len(ast.literal_eval('b"' + raw + '"'))
+    return ("static bool printAliasInstr(MCInst *MI) {\n#ifndef CAPSTONE_DIET\n"
+            "static const AliasPattern Patterns[] = {" + ",".join(patterns) + "};\n"
+            "static const char AsmStrings[] =\n" + "\n".join(records) + ";\n"
+            "const char *AsmString = matchAliasPatterns(MI, &M);\n"
+            "if (!AsmString) return false;\n"
+            "  return true;\n#else\n  return false;\n#endif // CAPSTONE_DIET\n}")
+
+
+def records(text):
+    start = text.index("static const char AsmStrings[] =")
+    return GEN.string_records(text[start:text.index(";", start)])
+
+
+class AliasStringMetadata(unittest.TestCase):
+    def test_first_row_dynamic_unknown_and_width(self):
+        raw = [r"move $\x01\0", r"move$\x01\0", r"unknown\0", r"123456789abcdef\0", r"123456789abcdefg\0", r"wide\0"]
+        names = ["move", "move", "123456789abcdef", "123456789abcdefg"] + ["unused"] * 252 + ["wide"]
+        mapping = "\n".join('{ PPC_INS_ALIAS_A, "%s" }' % name for name in names)
+        generated = GEN.project_writer(writer(raw), mapping)
+        entries = records(generated)
+        hints = [int.from_bytes(ast.literal_eval('b"' + row[0][2] + '"'), "little") for row in entries]
+        self.assertEqual(hints, [1, 0, 0, 3, 0, 257])
+        self.assertEqual([row[2] for row in entries], [row[2] for row in records(writer(raw))])
+        self.assertEqual(GEN.project_writer(generated, mapping), generated)
+
+    def test_bad_extent_and_unknown_syntax(self):
+        source = writer([r"move\0"])
+        mapping = '{ PPC_INS_ALIAS_MOVE, "move" }'
+        for broken in [source.replace("/* 0 */", "/* 1 */"), source.replace("{0, 0", "{999, 0"), source.replace(r"move\0", r"mo\0ve\0"), source.replace(r'"move\0"', r'"move\0" "hidden\0"')]:
+            with self.subTest(broken=broken), self.assertRaises(ValueError):
+                GEN.project_writer(broken, mapping)
+
+    def test_checkout_projection_is_stable(self):
+        arch = ROOT / "arch/PowerPC"
+        source = (arch / "PPCGenAsmWriter.inc").read_text()
+        mapping = (arch / "PPCGenCSAliasMnemMap.inc").read_text()
+        self.assertEqual(GEN.project_writer(source, mapping), source)
+        printer = (arch / "PPCInstPrinter.c").read_text()
+        self.assertEqual(GEN.project_printer(printer), printer)
+
+
+if __name__ == "__main__":
+    unittest.main()
