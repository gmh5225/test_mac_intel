+def primary_opcode_entries(nodes, width):
+    """Resume only where the initial CurFieldValue is dead on every path."""
+    root = nodes[0]
+    fields = {(0, 6)} if width == 16 else {(0, 7), (0, 8)}
+    require(root.op == "ExtractField" and root.args in fields,
+            "Review TriCore primary opcode field")
+    dead = {}
+
+    def field_is_dead(position):
+        if position not in dead:
+            node = nodes[position]
+            if node.op in ("ExtractField", "Decode", "Fail"):
+                dead[position] = True
+            elif node.op == "FilterValue":
+                dead[position] = False
+            else:
+                dead[position] = all(field_is_dead(p) for p in successors(node))
+        return dead[position]
+
+    branches = {}
+    position = root.end
+    while nodes[position].op == "FilterValue":
+        node = nodes[position]
+        value = node.args[0]
+        require(0 <= value < 1 << root.args[1] and value not in branches,
+                "Invalid primary opcode filter")
+        # The skipped ExtractField/FilterValue prefix neither changes MI nor
+        # the decode status. A live field requires the original root instead.
+        branches[value] = node.end if field_is_dead(node.end) else 0
+        position = node.target
+    require(nodes[position].op == "Fail", "Review primary opcode fallback")
+    entries = [branches.get(v, position) for v in range(1 << root.args[1])]
+    require(max(entries) < 1 << 16, "Review primary opcode offset width")
+    return root.args, entries
+
+
+def emit_primary(name, nodes, width, w):
+    (start, length), entries = primary_opcode_entries(nodes, width)
+    out = [
+        f"static DecodeStatus direct_{name}(MCInst *MI, uint{width}_t insn, uint64_t Address, const void *Decoder)",
+        "{",
+        "\tstatic const uint16_t entries[] = {",
+    ]
+    for i in range(0, len(entries), 8):
+        out.append("\t\t" + ", ".join(str(v) for v in entries[i:i + 8]) + ",")
+    out += [
+        "\t};",
+        f"\tconst unsigned offset = entries[fieldFromInstruction_{w}(insn, {start}, {length})];",
+        f"\treturn decodeInstruction_{w}({name} + offset, MI, insn, Address, Decoder);",
+        "}",
+    ]
+    return "\n".join(out)
+
