+#if !defined(CAPSTONE_USE_ALIAS_TRIE) && \
+	(defined(CAPSTONE_HAS_AARCH64) || defined(CAPSTONE_HAS_MIPS))
+static bool test_grouped_alias_lookup(void)
+{
+	static const name_map grouped[] = {
+		{ 17, "move" },	    { 0, "zero" },
+		{ 37, "\200" },	    { 31, "123456789abcdef" },
+		{ -1, "negative" }, { 99, "move" },
+		{ 23, "move.w" },
+	};
+	static const uint16_t indices[] = { 3, 0, 5, 6, 4, 1, 2 };
+	uint16_t offsets[257];
+	for (unsigned i = 0; i < ARR_SIZE(offsets); ++i)
+		offsets[i] = (i > '1') + 3 * (i > 'm') + (i > 'n') + (i > 'z') +
+			     (i > 128);
+	static const struct {
+		cs_arch arch;
+		const char *text;
+		unsigned expected;
+	} cases[] = {
+		{ CS_ARCH_AARCH64, " \tmove.w x0", 17 },
+		{ CS_ARCH_MIPS, "move\tr0", 17 },
+		{ CS_ARCH_PPC, "move.w r0", 23 },
+		{ CS_ARCH_AARCH64, "123456789abcdef_suffix", 31 },
+		{ CS_ARCH_MIPS, "123456789abcde", 0 },
+		{ CS_ARCH_AARCH64, "\200 r0", 37 },
+		{ CS_ARCH_MIPS, "negative", 0 },
+		{ CS_ARCH_MIPS, "zero", 0 },
+		{ CS_ARCH_MIPS, "missing", 0 },
+		{ CS_ARCH_MIPS, " \t", 0 },
+	};
+	cs_struct handle = { 0 };
+	cs_insn insn = { 0 };
+	MCInst mi = { 0 };
+	SStream stream = { 0 };
+	mi.csh = &handle;
+	mi.flat_insn = &insn;
+	mi.isAliasInstr = true;
+	for (unsigned i = 0; i < ARR_SIZE(cases); ++i) {
+		handle.arch = cases[i].arch;
+		strcpy(stream.buffer, cases[i].text);
+		map_set_alias_id_grouped(&mi, &stream, grouped, indices,
+					 offsets);
+		if (insn.alias_id != cases[i].expected)
+			return false;
+	}
+	mi.isAliasInstr = false;
+	mi.csh = NULL;
+	insn.alias_id = 99;
+	map_set_alias_id_grouped(&mi, NULL, NULL, NULL, NULL);
+	return insn.alias_id == 0;
+}
+#endif
+
 int main(void)
 {
+#if !defined(CAPSTONE_USE_ALIAS_TRIE) && \
+	(defined(CAPSTONE_HAS_AARCH64) || defined(CAPSTONE_HAS_MIPS))
+	if (!test_grouped_alias_lookup())
+		return 1;
+#endif
 #ifdef CAPSTONE_USE_ALIAS_TRIE
 	if (!test_generated_alias_lookup())
 		return 1;
