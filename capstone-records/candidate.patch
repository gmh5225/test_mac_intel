+class PrimaryOpcodeRestart(unittest.TestCase):
+    def test_primary_misses_use_the_existing_fail(self):
+        node = DECODER.Node
+        nodes = {
+            0: node("ExtractField", (0, 6), 1),
+            1: node("FilterValue", (3,), 2, 5),
+            2: node("Decode", (11, 2), 3),
+            5: node("Fail", (), 6),
+        }
+        field, entries = DECODER.primary_opcode_entries(nodes, 16)
+        self.assertEqual(field, (0, 6))
+        self.assertEqual(len(entries), 64)
+        self.assertEqual(entries[3], 2)
+        self.assertTrue(all(v == 5 for i, v in enumerate(entries) if i != 3))
+
+    def test_live_field_on_either_predicate_path_restarts_at_root(self):
+        node = DECODER.Node
+        for fallthrough, target in ((3, 4), (4, 3)):
+            with self.subTest(fallthrough=fallthrough):
+                nodes = {
+                    0: node("ExtractField", (0, 6), 1),
+                    1: node("FilterValue", (3,), 2, 5),
+                    2: node("CheckPredicate", (0,), fallthrough, target),
+                    3: node("Decode", (11, 2), 5),
+                    4: node("FilterValue", (3,), 5, 5),
+                    5: node("Fail", (), 6),
+                }
+                _, entries = DECODER.primary_opcode_entries(nodes, 16)
+                self.assertEqual(entries[3], 0)
+
+    def test_extract_overwrites_the_live_field_before_use(self):
+        node = DECODER.Node
+        nodes = {
+            0: node("ExtractField", (0, 6), 1),
+            1: node("FilterValue", (3,), 2, 5),
+            2: node("ExtractField", (6, 2), 3),
+            3: node("FilterValue", (1,), 4, 5),
+            4: node("Decode", (11, 2), 5),
+            5: node("Fail", (), 6),
+        }
+        _, entries = DECODER.primary_opcode_entries(nodes, 16)
+        self.assertEqual(entries[3], 2)
+
+    def test_try_decode_failure_still_observes_field_liveness(self):
+        node = DECODER.Node
+        nodes = {
+            0: node("ExtractField", (0, 6), 1),
+            1: node("FilterValue", (3,), 2, 5),
+            2: node("TryDecode", (11, 2), 3, 4),
+            4: node("FilterValue", (3,), 5, 5),
+            5: node("Fail", (), 6),
