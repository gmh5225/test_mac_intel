diff --git a/Mapping.h b/Mapping.h
index 6f7281cd..40ac443e 100644
--- a/Mapping.h
+++ b/Mapping.h
@@ -12,6 +12,7 @@
 #include <stddef.h>
 #endif
 #include "cs_priv.h"
+#include "utils.h"
 #include <assert.h>
 #include <string.h>
 
@@ -293,6 +294,21 @@ void map_set_is_alias_insn(MCInst *MI, bool Val, uint64_t Alias);
 
 bool map_use_alias_details(const MCInst *MI);
 
+enum { MAX_ALIAS_MNEMONIC_LENGTH = 15 };
+
+static inline bool char_ends_mnem(const char c, cs_arch arch)
+{
+	switch (arch) {
+	default:
+		return (!c || c == ' ' || c == '\t' || c == '.');
+	case CS_ARCH_PPC:
+	case CS_ARCH_RISCV:
+		return (!c || c == ' ' || c == '\t');
+	case CS_ARCH_SPARC:
+		return (!c || c == ' ' || c == '\t' || c == ',');
+	}
+}
+
 void map_set_alias_id(MCInst *MI, const SStream *O,
 		      const name_map *alias_mnem_id_map, int map_size);
 
@@ -336,4 +352,27 @@ typedef struct {
 uint64_t enum_map_bin_search(const cs_enum_id_map *map, size_t map_len,
 			     const char *id, bool *found);
 
+/* Validate the producer's row against the completed stream, including callbacks. */
+static inline bool map_try_alias_id_hint(MCInst *MI, const SStream *O,
+					 const name_map *map, unsigned hint)
+{
+	if (!hint || !MCInst_isAlias(MI))
+		return false;
+	const name_map *entry = &map[hint - 1];
+	const char *text = O->buffer;
+	while (is_blank_char(*text))
+		++text;
+	unsigned i = 0;
+	while (entry->name[i] && entry->name[i] == text[i] &&
+	       !char_ends_mnem(text[i], MI->csh->arch))
+		++i;
+	if (i > MAX_ALIAS_MNEMONIC_LENGTH || entry->name[i] ||
+	    (i != MAX_ALIAS_MNEMONIC_LENGTH &&
+	     !char_ends_mnem(text[i], MI->csh->arch)))
+		return false;
+	int alias_id = entry->id;
+	MI->flat_insn->alias_id = alias_id < 0 ? 0 : alias_id;
+	return true;
+}
+
 #endif // CS_MAPPING_H
