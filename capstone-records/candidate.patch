+static bool check_operand_access(MCInst *mi, unsigned tied)
+{
+	static const struct {
+		cs_ac_type base;
+		cs_ac_type tied;
+	} accesses[] = {
+		{ CS_AC_INVALID, CS_AC_READ },
+		{ CS_AC_READ, CS_AC_READ | CS_AC_WRITE },
+		{ CS_AC_WRITE, CS_AC_READ | CS_AC_WRITE },
+		{ CS_AC_READ | CS_AC_WRITE, CS_AC_READ | CS_AC_WRITE },
+	};
+	map_insn_ops table = { 0 };
+	for (unsigned a = 0; a < sizeof(accesses) / sizeof(accesses[0]); ++a) {
+		for (unsigned op = 0; op < MAX_NO_INSN_MAP_OPS; ++op) {
+			table.ops[op].access = accesses[a].base;
+			cs_ac_type expected = (tied & (1u << op)) ?
+						      accesses[a].tied :
+						      accesses[a].base;
+			cs_ac_type actual =
+				mapping_get_op_access(mi, op, &table, 1);
+			cs_ac_type inlined =
+				mapping_get_op_access_inline(mi, op, &table, 1);
+			if (actual != expected || inlined != expected) {
+				fprintf(stderr,
+					"Operand %u: access %u with ties %#x: expected %u, got %u\n",
+					op, (unsigned)accesses[a].base, tied,
+					(unsigned)expected, (unsigned)actual);
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+static bool test_operand_access(void)
+{
+	MCInst mi;
+	MCOperandInfo ops[MAX_MC_OPS] = { 0 };
+	MCInstrDesc desc = { 0 };
+	cs_insn insn = { 0 };
+	MCInst_Init(&mi, CS_ARCH_ARM);
+	mi.flat_insn = &insn;
+	desc.NumOperands = MAX_MC_OPS;
+	desc.OpInfo = ops;
+	MCInst_handleWriteback(&mi, &desc, 1);
+	if (!check_operand_access(&mi, 0))
+		return false;
+
+	// Include duplicate destinations, a self-tie and the final MC operand.
+	ops[3].Constraints = CONSTRAINT_MCOI_TIED_TO(0);
+	ops[5].Constraints = CONSTRAINT_MCOI_TIED_TO(0);
+	ops[7].Constraints = CONSTRAINT_MCOI_TIED_TO(7);
+	ops[MAX_MC_OPS - 1].Constraints = CONSTRAINT_MCOI_TIED_TO(15);
+	MCInst_handleWriteback(&mi, &desc, 1);
+	const unsigned tied = 1u | (1u << 3) | (1u << 5) | (1u << 7) |
+			      (1u << 15);
+	if (!check_operand_access(&mi, tied))
+		return false;
+
+	// Clearing operands and replacing a shorter descriptor retain old ties.
+	MCInst_clear(&mi);
+	if (!check_operand_access(&mi, tied))
+		return false;
+	desc.NumOperands = 4;
+	ops[3].Constraints = CONSTRAINT_MCOI_TIED_TO(1);
+	MCInst_handleWriteback(&mi, &desc, 1);
+	if (!check_operand_access(&mi, tied | (1u << 1)))
+		return false;
+
+	MCInst_Init(&mi, CS_ARCH_ARM);
+	return check_operand_access(&mi, 0);
+}
