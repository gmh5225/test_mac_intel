new file mode 100644
index 00000000..cb3eb37e
--- /dev/null
+++ b/suite/synctools/mapping_pooled_ops.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Pool complete runtime type/access rows from canonical operand mappings."""
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+
+from mapping_diet_types import (
+    ARCHITECTURES as DIET_ARCHITECTURES,
+    ROOT,
+    enum_values,
+    instruction_enum,
+    read_mapping,
+    require,
+)
+
+ARCHITECTURES = DIET_ARCHITECTURES + (
+    ("SystemZ", "SystemZ"),
+    ("TriCore", "TriCore"),
+    ("Xtensa", "Xtensa"),
+)
+
+
+def project(root, arch, folder):
+    header = (root / "Mapping.h").read_text()
+    capacity = int(re.search(r"#define MAX_NO_INSN_MAP_OPS (\d+)", header)[1])
+    dtype_capacity = int(re.search(r"#define MAX_NO_DATA_TYPES (\d+)", header)[1])
+    constants = (root / "include/capstone/cs_operand.h").read_text()
+    directory = root / "arch" / folder
+    source = (directory / (arch + "GenCSMappingInsnOp.inc")).read_text()
+    enumeration = (directory / (arch + "GenInstrInfo.inc")).read_text()
+    rows = read_mapping(
+        source,
+        instruction_enum(enumeration, arch),
+        arch,
+        enum_values(constants, "cs_op_type"),
+        enum_values(constants, "cs_ac_type"),
+        capacity,
+        dtype_capacity,
+        include_access=True,
+    )
+    digest = hashlib.sha256(
+        (source + "\0" + enumeration + "\0" + constants + "\0" + str(capacity)).encode()
+    ).hexdigest()
+    unique, indices, positions = [], [], {}
+    for row in rows:
+        if row not in positions:
+            positions[row] = len(unique)
+            unique.append(row)
+        indices.append(positions[row])
+    require(len(unique) <= 65536, arch + ": operand row index exceeds uint16_t")
+    lines = [
+        "/* Capstone Disassembly Engine */",
+        "/* SPDX-License-Identifier: BSD-3-Clause */",
+        "/* Generated by suite/synctools/mapping_pooled_ops.py; do not edit. */",
+        "/* Source SHA256: " + digest + " */",
+        "",
+    ]
+    lines.append("static const map_insn_ops insn_operands[] = {")
+    for ordinal, row in enumerate(unique):
+        operands = ", ".join("{ %d, %d }" % pair for pair in row)
+        lines.append("\t{ { " + operands + " } }, /* %d */" % ordinal)
+    lines += ["};", "", "static const uint16_t insn_operand_indices[] = {"]
+    for start in range(0, len(indices), 16):
+        lines.append("\t" + ", ".join(map(str, indices[start : start + 16])) + ",")
+    lines.append("};")
+    stats = dict(
+        architecture=arch,
+        opcodes=len(rows),
+        full_mapping_bytes=len(rows) * capacity * (2 + dtype_capacity),
+        unique_rows=len(unique),
+        direct_compact_mapping_bytes=len(rows) * capacity * 2,
+        pooled_mapping_bytes=len(rows) * 2 + len(unique) * capacity * 2,
+    )
+    return "\n".join(lines) + "\n", stats
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, default=ROOT)
+    parser.add_argument("--output-root", type=Path)
+    parser.add_argument("--check", action="store_true")
+    parser.add_argument("--report", type=Path)
+    args = parser.parse_args()
+    output_root = args.output_root or args.root
+    pending, reports = [], []
+    for arch, folder in ARCHITECTURES:
+        generated, stats = project(args.root, arch, folder)
+        output = output_root / "arch" / folder / (arch + "GenCSMappingInsnOpPooled.inc")
+        if args.check:
+            require(
+                output.is_file() and output.read_text() == generated,
+                "Stale pooled operand projection: " + str(output),
+            )
+        else:
+            pending.append((output, generated))
+        reports.append(stats)
+    # Validate all canonical owners before replacing generated artifacts.
+    for path, generated in pending:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(generated)
+    if args.report:
+        args.report.write_text(json.dumps(reports, indent=2) + "\n")
+    print(json.dumps(reports, indent=2))
+
+
+if __name__ == "__main__":
+    main()
