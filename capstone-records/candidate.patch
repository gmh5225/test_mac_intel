+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include "../../Mapping.h"
+#include "../../cs_simple_types.h"
+#include <stdio.h>
+
+typedef struct {
+	uint8_t type, access, dtypes[MAX_NO_DATA_TYPES];
+} full_mapping_op;
+typedef struct {
+	full_mapping_op ops[MAX_NO_INSN_MAP_OPS];
+} full_map_insn_ops;
+
+static bool check(const char *arch, const full_map_insn_ops *full,
+		  size_t full_count, const map_insn_ops *pool,
+		  size_t pool_count, const uint16_t *indices,
+		  size_t index_count)
+{
+	if (full_count != index_count)
+		return false;
+	for (size_t insn = 0; insn < full_count; ++insn) {
+		if (indices[insn] >= pool_count)
+			return false;
+		for (size_t op = 0; op < MAX_NO_INSN_MAP_OPS; ++op) {
+			if (full[insn].ops[op].type !=
+				    pool[indices[insn]].ops[op].type ||
+			    full[insn].ops[op].access !=
+				    pool[indices[insn]].ops[op].access) {
+				fprintf(stderr,
+					"%s opcode %zu operand %zu differs\n",
+					arch, insn, op);
+				return false;
+			}
+		}
+	}
+	return true;
+}
