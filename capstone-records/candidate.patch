                     f"\tif (Table == {name}) return direct_{name}(MI, insn, Address, Decoder);"
diff --git a/tests/unit/test_fixed_len_decoder.py b/tests/unit/test_fixed_len_decoder.py
index f3677119..5561705a 100644
--- a/tests/unit/test_fixed_len_decoder.py
+++ b/tests/unit/test_fixed_len_decoder.py
@@ -91,5 +91,65 @@ class CheckoutNewlines(unittest.TestCase):
                         self.check(root)
 
 
+class ObservablePrefixes(unittest.TestCase):
+    def test_rejected_prefix_cannot_mutate_instruction(self):
+        n = DECODER.Node
+        nodes = {
+            0: n("CheckField", (0, 7, 11), 1, 2),
+            1: n("Decode", (1, 0), 2),
+            2: n("Fail", (), 3),
+        }
+        self.assertEqual(DECODER.observable_prefixes(nodes), {11})
+
+    def test_unknown_high_bits_keep_both_branches(self):
+        n = DECODER.Node
+        nodes = {
+            0: n("ExtractField", (7, 1), 1),
+            1: n("FilterValue", (0,), 2, 4),
+            2: n("CheckField", (0, 7, 11), 3, 6),
+            3: n("Decode", (1, 0), 4),
+            4: n("CheckField", (0, 7, 43), 5, 6),
+            5: n("Decode", (2, 0), 6),
+            6: n("Fail", (), 7),
+        }
+        self.assertEqual(DECODER.observable_prefixes(nodes), {11, 43})
+
+    def test_failed_try_decode_is_still_observable(self):
+        n = DECODER.Node
+        nodes = {
+            0: n("CheckField", (0, 7, 91), 1, 2),
+            1: n("TryDecode", (1, 0), 2, 2),
+            2: n("Fail", (), 3),
+        }
+        self.assertEqual(DECODER.observable_prefixes(nodes), {91})
+
+    def test_predicate_outcomes_and_merged_fields_are_preserved(self):
+        n = DECODER.Node
+        nodes = {
+            0: n("CheckPredicate", (0,), 1, 2),
+            1: n("ExtractField", (0, 7), 3),
+            2: n("ExtractField", (1, 6), 3),
+            3: n("FilterValue", (5,), 4, 5),
+            4: n("Decode", (1, 0), 5),
+            5: n("Fail", (), 6),
+        }
+        self.assertEqual(DECODER.observable_prefixes(nodes), {5, 10, 11})
+
+    def test_initial_field_and_unknown_field_cannot_create_false_rejection(self):
+        n = DECODER.Node
+        initial = {
+            0: n("FilterValue", (0,), 1, 2),
+            1: n("Decode", (1, 0), 2),
+            2: n("Fail", (), 3),
+        }
+        unknown = {
+            0: n("ExtractField", (7, 3), 1),
+            1: n("FilterValue", (3,), 2, 3),
+            2: n("Decode", (1, 0), 3),
+            3: n("Fail", (), 4),
+        }
+        for nodes in (initial, unknown):
+            self.assertEqual(DECODER.observable_prefixes(nodes), set(range(128)))
+
 if __name__ == "__main__":
     unittest.main()
