@@ -841,3 +841,16 @@ to populate the `cs_insn` with the operand information and details.
 
 Again the `InstPrinter` and `AsmWriter` are translated code from LLVM,
 so they mirror the behavior of `llvm-objdump`.
+
+PowerPC's generated alias strings carry a two-byte first-alias-name row directly
+before each mnemonic, in low-byte-first order. Generated pattern offsets still
+address the original mnemonic bytes, and the shared alias matcher is unchanged.
+The printer returns its selected string locally until operand printing completes,
+then reads the row and validates the completed mnemonic with the shared delimiter
+and 15-byte policy. Unknown or modified text uses the existing alias mapper.
+Formatter callbacks therefore observe the same public instruction state.
+
+Run `python3 suite/synctools/ppc_alias_hints.py` after updating the PowerPC alias
+name map, generated assembly writer, or translated printer. Its `--check` mode
+validates the complete projection and rejects stale output; the projection tests
+cover offset integrity, first-name selection, unknown names and byte order.
diff --git a/suite/synctools/ppc_alias_hints.py b/suite/synctools/ppc_alias_hints.py
new file mode 100644
index 00000000..c686eff7
--- /dev/null
+++ b/suite/synctools/ppc_alias_hints.py
@@ -0,0 +1,193 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Project PowerPC alias-name rows into private string metadata."""
+
+import argparse
+import ast
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+STRING = re.compile(r'/\* (\d+) \*/ (?:"((?:\\[0-7]{3}){2})" )?"((?:\\.|[^"\\])*)"')
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def string_records(region):
+    rows = list(STRING.finditer(region))
+    require(rows, "Missing PowerPC alias strings")
+    require(
+        STRING.sub("", region).strip() == "static const char AsmStrings[] =",
+        "Unknown alias string syntax",
+    )
+    require(
+        all(bool(row[2]) == bool(rows[0][2]) for row in rows),
+        "Mixed alias string representations",
+    )
+    records, expected = [], 0
+    for row in rows:
+        offset, prefix, raw = int(row[1]), row[2], row[3]
+        value = ast.literal_eval('b"' + raw + '"')
+        require(
+            value.endswith(b"\0") and b"\0" not in value[:-1],
+            "Invalid alias string extent",
+        )
+        require(
+            offset == expected + (2 if prefix else 0), "Non-contiguous alias strings"
+        )
+        expected = offset + len(value)
+        records.append((row, offset, value, raw))
+    return records
+
+
+def project_writer(text, mapping):
+    signature = (
+        "static const char *printAliasInstr("
+        if "static const char *printAliasInstr(" in text
+        else "static bool printAliasInstr("
+    )
+    begin = text.index(signature)
+    end = text.index("\n#endif // CAPSTONE_DIET\n}", begin) + len(
+        "\n#endif // CAPSTONE_DIET\n}"
+    )
+    body = text[begin:end]
+    start = body.index("static const char AsmStrings[] =")
+    stop = body.index(";", start)
+    region = body[start:stop]
+    records = string_records(region)
+    entries = re.findall(r'\{ (PPC_INS_ALIAS_\w+), "([^"\n]+)" \}', mapping)
+    meaningful = re.sub(r"/\*.*?\*/|//[^\n]*", "", mapping, flags=re.S)
+    require(len(entries) == meaningful.count("{"), "Unknown alias map row")
+    first = {}
+    for index, (_, name) in enumerate(entries, 1):
+        require(index < 65536, "PowerPC alias map exceeds uint16_t")
+        first.setdefault(name.encode("ascii"), index)
+    offsets, replacements, cursor = {}, {}, 0
+    for row, offset, value, raw in records:
+        name = re.split(rb"[ \t$\x00]", value, maxsplit=1)[0]
+        hint = (
+            first.get(name, 0)
+            if len(name) <= 15 and value[len(name) : len(name) + 1] != b"$"
+            else 0
+        )
+        cursor += 2
+        offsets[offset] = cursor
+        prefix = "\\%03o\\%03o" % (hint & 255, hint >> 8)
+        replacements[row.start()] = '/* %d */ "%s" "%s"' % (cursor, prefix, raw)
+        cursor += len(value)
+    region = STRING.sub(lambda row: replacements[row.start()], region)
+    body = body[:start] + region + body[stop:]
+    start = body.index("static const AliasPattern Patterns[] = {")
+    stop = body.index("};", start)
+    region = body[start:stop]
+    pattern = re.compile(r"\{(\d+),\s*(\d+),\s*(\d+),\s*(\d+)\s*\}")
+    rows = list(pattern.finditer(region))
+    require(
+        rows and len(rows) + len(re.findall(r"\{0\}", region)) == region.count("{") - 1,
+        "Unknown PowerPC alias pattern",
+    )
+    require(
+        all(int(row[1]) in offsets for row in rows),
+        "Pattern does not start at an alias string",
+    )
+    region = pattern.sub(
+        lambda row: "{"
+        + ", ".join([str(offsets[int(row[1])]), *row.groups()[1:]])
+        + " }",
+        region,
+    )
+    body = body[:start] + region + body[stop:]
+    body = body.replace(
+        "static bool printAliasInstr(", "static const char *printAliasInstr("
+    )
+    body = body.replace("if (!AsmString) return false;", "if (!AsmString) return NULL;")
+    body = body.replace(
+        "  return true;\n#else\n  return false;",
+        "  return AsmString;\n#else\n  return NULL;",
+    )
+    require(
+        "return true" not in body and "return false" not in body,
+        "Unexpected alias return",
+    )
+    require(
+        body.count("const char *AsmString = matchAliasPatterns(MI, &M);") == 1,
+        "Changed shared matcher boundary",
+    )
+    return text[:begin] + body + text[end:]
+
+
+def project_printer(text):
+    start = (
+        text.index("static unsigned printInst(")
+        if "static unsigned printInst(" in text
+        else text.index("static void printInst(")
+    )
+    end = text.index("\nconst char *PPC_LLVM_getRegisterName", start)
+    body = text[start:end]
+    old = "\tisAlias |= printAliasInstr(MI, Address, O);"
+    new = "\tconst char *aliasString = printAliasInstr(MI, Address, O);\n\tisAlias |= aliasString != NULL;"
+    if old in body:
+        body = body.replace(old, new)
+    require(body.count(new) == 1, "Changed PowerPC alias selection")
+    body = body.replace("static void printInst(", "static unsigned printInst(")
+    body = body.replace("\treturn;", "\treturn 0;")
+    body = body.replace(
+        'CS_ASSERT_RET(0 && "Expressions not supported.");',
+        'CS_ASSERT_RET_VAL(0 && "Expressions not supported.", 0);',
+    )
+    require("CS_ASSERT_RET(" not in body, "Void assertion in PowerPC alias return")
+    result = "\t/* The selected string owns two preceding bytes in low-byte-first order. */\n\treturn aliasString ? (uint8_t)aliasString[-2] |\n\t\t\t     ((unsigned)(uint8_t)aliasString[-1] << 8) :\n\t\t\t   0;\n"
+    require(body.endswith("}\n"), "Changed PowerPC printer end")
+    if "The selected string owns two preceding bytes" in body:
+        require(
+            re.sub(r"\s", "", result) in re.sub(r"\s", "", body),
+            "Changed alias metadata read",
+        )
+    else:
+        body = body[:-2] + result + "}\n"
+    text = text[:start] + body + text[end:]
+    text = text.replace("void PPC_LLVM_printInst(", "unsigned PPC_LLVM_printInst(")
+    return text.replace(
+        "\tprintInst(MI, Address, Annot, O);",
+        "\treturn printInst(MI, Address, Annot, O);",
+    )
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, default=ROOT)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    arch = args.root / "arch/PowerPC"
+    writer, printer, linkage = [
+        arch / name
+        for name in ("PPCGenAsmWriter.inc", "PPCInstPrinter.c", "PPCLinkage.h")
+    ]
+    mapping = (arch / "PPCGenCSAliasMnemMap.inc").read_text()
+    outputs = {
+        writer: project_writer(writer.read_text(), mapping),
+        printer: project_printer(printer.read_text()),
+        linkage: linkage.read_text().replace(
+            "void PPC_LLVM_printInst(", "unsigned PPC_LLVM_printInst("
+        ),
+    }
+    require(
+        project_writer(outputs[writer], mapping) == outputs[writer],
+        "Non-idempotent string projection",
+    )
+    require(
+        project_printer(outputs[printer]) == outputs[printer],
+        "Non-idempotent printer projection",
+    )
+    for path, generated in outputs.items():
+        if args.check:
+            require(path.read_text() == generated, "Regenerate " + str(path))
+        elif path.read_text() != generated:
+            path.write_text(generated)
+
+
+if __name__ == "__main__":
+    main()
