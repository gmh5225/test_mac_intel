diff --git a/suite/synctools/fixed_len_decoder.py b/suite/synctools/fixed_len_decoder.py
index 29a72009..14122a16 100644
--- a/suite/synctools/fixed_len_decoder.py
+++ b/suite/synctools/fixed_len_decoder.py
@@ -144,6 +144,54 @@ def successors(n):
     return [n.end] + ([] if n.target is None else [n.target])
 
 
+def observable_prefixes(nodes, bits=7):
+    """Conservatively admit any prefix that could reach an MCInst mutation."""
+    result = set()
+    for prefix in range(1 << bits):
+        pending = [(0, None)]
+        seen = set()
+        while pending:
+            position, field = pending.pop()
+            state = (position, field)
+            if state in seen:
+                continue
+            seen.add(state)
+            node = nodes[position]
+            if node.op in ("Decode", "TryDecode"):
+                result.add(prefix)
+                break
+            if node.op == "Fail":
+                continue
+            if node.op == "ExtractField":
+                pending.append((node.end, node.args))
+                continue
+            if node.op in ("FilterValue", "CheckField"):
+                if node.op == "FilterValue":
+                    compared, expected = field, node.args[0]
+                else:
+                    compared, expected = node.args[:2], node.args[2]
+                if compared is None:
+                    match, mismatch = expected == 0, expected != 0
+                else:
+                    start, length = compared
+                    known = max(0, min(length, bits - start))
+                    mask = (1 << known) - 1
+                    match = expected < (1 << length) and (expected & mask) == (
+                        (prefix >> start) & mask
+                    )
+                    mismatch = not match or known < length
+                if match:
+                    pending.append((node.end, field))
+                if mismatch:
+                    pending.append((node.target, field))
+                continue
+            # Predicates are pure queries; either answer remains possible.
+            assert node.op in ("CheckPredicate", "SoftFail"), node.op
+            pending.append((node.end, field))
+            if node.target is not None:
+                pending.append((node.target, field))
+    return result
+
 def primary_opcode_mask(nodes):
     """A top-level miss must reach Fail without modifying the instruction."""
     root = nodes[0]
@@ -305,6 +353,24 @@ def main():
                 f"static DecodeStatus directInstruction_{w}(const uint8_t *Table, MCInst *MI, uint{width}_t insn, uint64_t Address, const void *Decoder)",
                 "{",
             ]
+            if arch == "RISCV" and w == 4:
+                corev = [n for n in selected if n.startswith("DecoderTableXCV")]
+                prefixes = set()
+                for name, body in tables:
+                    if name in corev:
+                        prefixes.update(observable_prefixes(parse(body)))
+                require(bool(prefixes), "No observable CORE-V decoder paths")
+                first = min(prefixes)
+                mask = 127
+                for value in prefixes:
+                    mask &= ~(first ^ value)
+                if mask:
+                    output += [
+                        "\t/* A rejected prefix cannot reach Decode or TryDecode. */",
+                        f"\tif ((insn & UINT32_C(0x{mask:x})) != UINT32_C(0x{first & mask:x}) &&",
+                        "\t    (" + " || ".join(f"Table == {n}" for n in corev) + "))",
+                        "\t\treturn MCDisassembler_Fail;",
+                    ]
             for name in selected:
