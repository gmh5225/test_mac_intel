--- a/MCInstPrinter.c
+++ b/MCInstPrinter.c
@@ -198,9 +198,9 @@ const char *matchAliasPatterns(MCInst *MI, const AliasMatchingData *M)
 	if (AsmStrOffset == ~0U)
 		return NULL;
 
-	// Go to offset AsmStrOffset and use the null terminated string there. The
-	// offset should point to the beginning of an alias string, so it should
-	// either be zero or be preceded by a null byte.
+	// Return the selected null-terminated assembly string. Generated offsets
+	// address the first character; private tables may place metadata before
+	// that character, so its preceding byte need not be a string terminator.
 	return M->AsmStrings + AsmStrOffset;
 }
 
