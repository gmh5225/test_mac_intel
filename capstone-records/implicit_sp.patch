diff --git a/arch/RISCV/RISCVDisassembler.c b/arch/RISCV/RISCVDisassembler.c
index 5c59283f..7457b0a1 100644
--- a/arch/RISCV/RISCVDisassembler.c
+++ b/arch/RISCV/RISCVDisassembler.c
@@ -581,6 +581,8 @@ static DecodeStatus decodeZcmpSpimm(MCInst *Inst, unsigned Imm,
 // isn't explicitly encoded in the instruction.
 void addSPOperands(MCInst *MI)
 {
+	if (!RISCV_hasImplicitSP(MCInst_getOpcode(MI)))
+		return;
 	const MCInstrDesc *MCID = MCInstrDesc_get(MCInst_getOpcode(MI),
