@@ -55,6 +56,17 @@ int main(void)
 	if (!check(RISCVDescs.Insts, RISCVWritebackFlags,
 		   ARR_SIZE(RISCVDescs.Insts), "RISCV"))
 		return 1;
+	for (unsigned i = 0; i < ARR_SIZE(RISCVDescs.Insts); ++i) {
