+#if X86_HAS_VEX2_PUBLIC_PLANS
+/* The caller has recognized a bare C5 VEX prefix. These generated plans
+ * have one public ID and one validation result for every ModR/M byte. */
+X86_DECODE_INLINE int tryVex2PublicPlan(const uint8_t *code, size_t size,
+					X86ScanResult *result)
+{
+	if (size < 3)
+		return X86_SCAN_INVALID;
+	const unsigned payload = code[1];
+	const unsigned plan = x86Vex2PublicPlans[payload & 7][code[2]];
+	if (!plan)
+		return X86_SCAN_NOT_HANDLED;
+	if ((plan & 2) && vvvvFromVEX2of2(payload))
+		return X86_SCAN_INVALID;
+	unsigned end = 3;
+	if (plan & 4) {
+		if (size == 3)
+			return X86_SCAN_INVALID;
+		const unsigned modrm = code[3];
+		end = 4;
+		if (modrm < 0xc0)
+			end = scanMemoryEnd(code, size, end, modrm);
+	}
+	end += plan & 1;
+	if (end > size)
+		return X86_SCAN_INVALID;
+	result->opcode = 0;
+	result->opcode_pub = plan >> 3;
+	result->length = (uint16_t)end;
+	result->popcode_adjust = 0;
+	return X86_SCAN_COMPLETE;
+}
+#endif
