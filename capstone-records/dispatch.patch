diff --git a/suite/synctools/x86_simple_output.cpp b/suite/synctools/x86_simple_output.cpp
index ccc4f0de..4def0241 100644
--- a/suite/synctools/x86_simple_output.cpp
+++ b/suite/synctools/x86_simple_output.cpp
@@ -294,6 +294,72 @@ CheckedRow check_pair(Decoder &decoder, unsigned opcode, unsigned prefix_class,
 
 // The register/imm8 form reuses the register row builder. Reconstruct the
 // one varying immediate separately after checking its public value and text.
+// The memory-immediate form retains the canonical MOV effects and widths.
+// Only its explicit operand kinds, address and immediate fields differ.
+void check_memory_immediate_projection(Decoder &decoder, unsigned cls)
+{
+	const unsigned start = cls == 0 ? 0 : cls == 1 ? 0x40 : 0x48;
+	for (unsigned rex = start; rex <= start + (cls ? 7 : 0); ++rex) {
+		for (unsigned opcode : { 0xc6u, 0xc7u }) {
+			decode_pair(decoder, rex, 0x88 | (opcode & 1), 0xc0);
+			const cs_detail reg_detail = *decoder.insn->detail;
+			for (uint32_t raw :
+			     { 0u, 1u, 9u, 10u, 0x7fu, 0x80u, 0xffu, 0x100u,
+			       0x7fffffffu, 0x80000000u, 0xffffffffu }) {
+				const unsigned width = opcode == 0xc6 ? 1 : 4;
+				const unsigned lead = rex != 0;
+				uint8_t bytes[] = { uint8_t(rex),
+						    uint8_t(opcode),
+						    0,
+						    uint8_t(raw),
+						    uint8_t(raw >> 8),
+						    uint8_t(raw >> 16),
+						    uint8_t(raw >> 24) };
+				decoder.decode(bytes + !rex, lead + 2 + width,
+					       lead + 2 + width, 0);
+				const auto &actual = *decoder.insn->detail;
+				cs_detail expected = reg_detail;
+				auto &x = expected.x86;
+				const int64_t immediate =
+					width == 1 ? (int64_t)(raw & 0xff) :
+					(rex & 8)  ? (int64_t)(int32_t)raw :
+						     (int64_t)raw;
+				x.opcode[0] = uint8_t(opcode);
+				x.modrm = 0;
+				x.encoding.imm_offset = uint8_t(lead + 2);
+				x.encoding.imm_size = uint8_t(width);
+				const auto first = x.operands[0],
+					   second = x.operands[1];
+				x.operands[0] = {};
+				x.operands[0].type = X86_OP_MEM;
+				x.operands[0].size = first.size;
+				x.operands[0].access = first.access;
+				x.operands[0].mem = actual.x86.operands[0].mem;
+				x.operands[1] = {};
+				x.operands[1].type = X86_OP_IMM;
+				x.operands[1].size = second.size;
+				x.operands[1].imm = immediate;
+				std::ostringstream number;
+				if ((uint64_t)immediate > HEX_THRESHOLD)
+					number << "0x" << std::hex;
+				number << (uint64_t)immediate;
+				const std::string operands =
+					decoder.insn->op_str;
+				const auto comma = operands.rfind(", ");
+				if (decoder.insn->id != X86_INS_MOV ||
+				    comma == std::string::npos ||
+				    operands.substr(comma + 2) !=
+					    number.str() ||
+				    std::memcmp(&expected, &actual,
+						offsetof(cs_detail, x86) +
+							sizeof(cs_x86)))
+					throw std::runtime_error(
+						"memory-immediate MOV projection changed");
+			}
+		}
+	}
+}
