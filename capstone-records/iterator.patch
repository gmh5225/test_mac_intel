+		/* A bare C5 cannot be LDS when the next byte selects
+		 * register addressing. Its W=0 opcode rows are shared with
+		 * 64-bit mode, but address and operand sizes follow the handle. */
+		if (handle->mode == CS_MODE_32 && code_len >= 2 &&
