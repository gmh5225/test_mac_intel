+		return writeMemoryOutput(code, size, insn, insn_size, row, regs, true);
+	const struct X86SimpleRegister *dst = &regs[2][(modrm >> 3) & 7];
+	const struct X86SimpleRegister *src = &regs[0][modrm & 7];
+	insn->id = row->id;
+	*insn_size = insn->size = 3;
+	memcpy(insn->bytes, code, 3);
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	memcpy(insn->op_str, dst->name, sizeof(dst->name));
+	char *out = insn->op_str + dst->length;
+	memcpy(out, ", ", 2);
+	memcpy(out + 2, src->name, sizeof(src->name));
+	if (insn->detail) {
+		X86_writeSimpleDetail(insn->detail, row, 0x0f, 0, modrm,
+				      dst->reg, src->reg);
+		insn->detail->x86.opcode[1] = code[1];
+	}
+	return true;
+}
