+static bool check_byte_extensions(csh handles[2])
+{
+	for (unsigned opcode = 0xb6; opcode <= 0xbe; opcode += 8) {
+		for (unsigned modrm = 0; modrm < 256; ++modrm) {
+			const unsigned sib_count =
+				(modrm & 7) == 4 && modrm < 0xc0 ? 256 : 1;
+			for (unsigned sib = 0; sib < sib_count; ++sib) {
+				uint8_t bytes[] = { 0x0f, opcode, modrm, sib,
+						    0x80, 0x01, 0xff, 0x81 };
+				for (size_t size = 1; size <= sizeof(bytes); ++size)
+					if (!compare(handles, bytes, size, sib ^ modrm))
+						return false;
+			}
+		}
+	}
+	return true;
+}
