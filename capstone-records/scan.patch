 	op->ImmVal = Val;
 }
 
+/* Preserve sequential append behavior when only one slot remains. */
+static inline void MCOperand_CreateImmReg0(MCInst *mcInst, int64_t Val,
+					   unsigned Reg)
+{
+	if (mcInst->size > MAX_MC_OPS - 2) {
+		MCOperand_CreateImm0(mcInst, Val);
+		MCOperand_CreateReg0(mcInst, Reg);
+		return;
+	}
+	MCOperand *op = &mcInst->Operands[mcInst->size];
+	mcInst->size += 2;
+#ifdef __cplusplus
+	op[0].MachineOperandType = MCOperand::kImmediate;
+	op[1].MachineOperandType = MCOperand::kRegister;
+#else
+	op[0].MachineOperandType = kImmediate;
+	op[1].MachineOperandType = kRegister;
+#endif
+	op[0].Kind = op[0].MachineOperandType;
+	op[0].ImmVal = Val;
+	op[1].Kind = op[1].MachineOperandType;
+	op[1].RegVal = Reg;
+}
