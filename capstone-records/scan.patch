+static const uint16_t evex_transfer_scan_ids[4][2][3]
+	__attribute__((section(".cs_x86_evex_transfer_rodata"))) = {
+	{
+		{ 0, X86_INS_VBROADCASTF32X4, X86_INS_VBROADCASTF32X4 },
+		{ 0, X86_INS_VBROADCASTF64X2, X86_INS_VBROADCASTF64X2 },
+	},
+	{
+		{ X86_INS_VMOVDQA32, X86_INS_VMOVDQA32, X86_INS_VMOVDQA32 },
+		{ X86_INS_VMOVDQA64, X86_INS_VMOVDQA64, X86_INS_VMOVDQA64 },
+	},
+	{
+		{ X86_INS_VMOVDQU32, X86_INS_VMOVDQU32, X86_INS_VMOVDQU32 },
+		{ X86_INS_VMOVDQU64, X86_INS_VMOVDQU64, X86_INS_VMOVDQU64 },
+	},
+	{
+		{ X86_INS_VMOVDQU8, X86_INS_VMOVDQU8, X86_INS_VMOVDQU8 },
+		{ X86_INS_VMOVDQU16, X86_INS_VMOVDQU16, X86_INS_VMOVDQU16 },
+	},
+};
