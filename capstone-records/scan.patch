diff --git a/CMakeLists.txt b/CMakeLists.txt
index 60eda54e..1cdf6212 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -467,8 +467,19 @@ if(CAPSTONE_X86_SUPPORT)
         arch/X86/X86ImmediateOutput.c
         arch/X86/X86MemoryOutput.c
         arch/X86/X86OutputIterator.c
+        arch/X86/X86Vex32Output.c
         arch/X86/X86VectorOutput.c
     )
+    # Keep compiler-created switch tables out of the existing ELF rodata.
+    if(CMAKE_EXECUTABLE_FORMAT STREQUAL "ELF" AND CMAKE_C_COMPILER_ID MATCHES "^(GNU|Clang)$")
+        set_property(SOURCE arch/X86/X86Vex32Output.c APPEND PROPERTY COMPILE_OPTIONS -fno-jump-tables)
+    endif()
+    # Keep reserved output plans as branches. Clang otherwise adds an
+    # indirect jump-table lookup to the common vector output path.
+    if(CMAKE_EXECUTABLE_FORMAT STREQUAL "ELF" AND CMAKE_C_COMPILER_ID STREQUAL "Clang"
+       AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
+        set_property(SOURCE arch/X86/X86OutputIterator.c APPEND PROPERTY COMPILE_OPTIONS -fno-jump-tables)
+    endif()
     # Use scalar/vector stores or libc for the fixed public output buffers.
     # Generic x64 GCC otherwise emits REP STOS even for the short clears.
     if((capstone_enabled_architectures STREQUAL "X86" OR capstone_enabled_architectures STREQUAL "MIPS;X86"
@@ -476,7 +487,7 @@ if(CAPSTONE_X86_SUPPORT)
        AND CMAKE_C_COMPILER_ID STREQUAL "GNU"
        AND CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SIZEOF_VOID_P EQUAL 8
        AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
-        set_property(SOURCE arch/X86/X86ImmediateOutput.c arch/X86/X86MemoryOutput.c arch/X86/X86OutputIterator.c arch/X86/X86VectorOutput.c
+        set_property(SOURCE arch/X86/X86ImmediateOutput.c arch/X86/X86MemoryOutput.c arch/X86/X86OutputIterator.c arch/X86/X86VectorOutput.c arch/X86/X86Vex32Output.c
             APPEND PROPERTY COMPILE_OPTIONS "$<$<CONFIG:Release>:-mstringop-strategy=libcall>")
     endif()
     # MSVC can inline the decoder into the public iterator under LTCG, giving
@@ -500,6 +511,7 @@ if(CAPSTONE_X86_SUPPORT)
         arch/X86/X86BaseInfo.h
         arch/X86/X86Disassembler.h
         arch/X86/X86DisassemblerDecoder.h
+        arch/X86/X86GenVex32MemoryOutput.inc
         arch/X86/X86DisassemblerDecoderCommon.h
         arch/X86/X86FeatureExtension.h
         arch/X86/X86GenAsmWriter.inc
@@ -522,6 +534,7 @@ if(CAPSTONE_X86_SUPPORT)
         arch/X86/X86BaseInfo.h
         arch/X86/X86Disassembler.h
         arch/X86/X86DisassemblerDecoder.h
+        arch/X86/X86GenVex32MemoryOutput.inc
         arch/X86/X86DisassemblerDecoderCommon.h
         arch/X86/X86FeatureExtension.h
         arch/X86/X86GenAsmWriter.inc
diff --git a/Makefile b/Makefile
index 74790c01..892b6d13 100644
--- a/Makefile
+++ b/Makefile
@@ -271,6 +271,7 @@ endif
 	LIBOBJ_X86 += $(OBJDIR)/arch/X86/X86ImmediateOutput.o
 	LIBOBJ_X86 += $(OBJDIR)/arch/X86/X86MemoryOutput.o
 	LIBOBJ_X86 += $(OBJDIR)/arch/X86/X86OutputIterator.o
+	LIBOBJ_X86 += $(OBJDIR)/arch/X86/X86Vex32Output.o
 	LIBOBJ_X86 += $(OBJDIR)/arch/X86/X86VectorOutput.o
 	LIBOBJ_X86_NUMBERS += $(OBJDIR)/arch/X86/X86IntelInstPrinterNumbers.o
 endif
@@ -670,6 +671,23 @@ ifeq ($(sort $(CAPSTONE_ARCHS)),tricore)
 $(OBJDIR)/arch/TriCore/TriCoreDisassembler.o: CFLAGS += -DCAPSTONE_TRICORE_DIRECT_DECODER
 endif
 
+# Keep compiler-created switch tables out of the existing ELF rodata.
+ifneq (,$(filter x86,$(CAPSTONE_ARCHS)))
+X86_VEX32_OUTPUT_FLAGS := $(shell $(CC) $(CFLAGS) -dM -E -x c - < /dev/null 2>/dev/null | \
+    awk '$$2 == "__ELF__" { elf=1 } $$2 == "__GNUC__" { gcc=1 } \
+         END { if (elf && gcc) print "-fno-jump-tables" }')
+$(OBJDIR)/arch/X86/X86Vex32Output.o: CFLAGS += $(X86_VEX32_OUTPUT_FLAGS)
+endif
+
+# Match the small reserved-plan dispatch policy for ELF Clang.
+ifneq (,$(filter x86,$(CAPSTONE_ARCHS)))
+X86_OUTPUT_PLAN_FLAGS := $(shell $(CC) $(CFLAGS) -dM -E -x c - < /dev/null 2>/dev/null | \
+    awk '$$2 == "__ELF__" { elf=1 } $$2 == "__clang__" { clang_cc=1 } \
+         $$2 == "__x86_64__" { x64=1 } \
+         END { if (elf && clang_cc && x64) print "-fno-jump-tables" }')
+$(OBJDIR)/arch/X86/X86OutputIterator.o: CFLAGS += $(X86_OUTPUT_PLAN_FLAGS)
+endif
+
 # Match the Release x86 formatter tuning for the compiler's target.
 ifneq (,$(filter -DCAPSTONE_X86_ONLY -DCAPSTONE_X86_MIPS_ONLY -DCAPSTONE_ARM_AARCH64_MIPS_X86,$(CFLAGS)))
 ifneq (,$(filter -O2 -O3,$(CFLAGS)))
@@ -678,7 +696,7 @@ X86_OUTPUT_STORE_FLAG := $(shell $(CC) $(CFLAGS) -dM -E -x c - < /dev/null 2>/de
          $$2 == "__GNUC__" { gcc=1 } $$2 == "__clang__" { clang_cc=1 } \
          $$2 == "__SIZEOF_POINTER__" { ptr=$$3 } \
          END { if (linux_target && x64 && gcc && !clang_cc && ptr==8) print "-mstringop-strategy=libcall" }')
-$(OBJDIR)/arch/X86/X86ImmediateOutput.o $(OBJDIR)/arch/X86/X86MemoryOutput.o $(OBJDIR)/arch/X86/X86OutputIterator.o $(OBJDIR)/arch/X86/X86VectorOutput.o: CFLAGS += $(X86_OUTPUT_STORE_FLAG)
+$(OBJDIR)/arch/X86/X86ImmediateOutput.o $(OBJDIR)/arch/X86/X86MemoryOutput.o $(OBJDIR)/arch/X86/X86OutputIterator.o $(OBJDIR)/arch/X86/X86VectorOutput.o $(OBJDIR)/arch/X86/X86Vex32Output.o: CFLAGS += $(X86_OUTPUT_STORE_FLAG)
 endif
 endif
 
