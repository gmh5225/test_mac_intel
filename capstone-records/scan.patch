+/* Pair construction must also preserve partial appends and untouched bytes. */
+static bool check_operand_pair(void)
+{
+	static const struct {
+		int64_t imm;
+		unsigned reg;
+	} values[] = {
+		{ 0, 0 },
+		{ INT64_MIN, UINT_MAX },
+		{ INT64_MAX, 1 },
+		{ -1, UINT_MAX - 1 },
+		{ INT64_C(0x123456789abcdef), 255 },
+	};
+#ifdef CAPSTONE_DEBUG
+	const unsigned limit = MAX_MC_OPS - 1;
+#else
+	const unsigned limit = UINT8_MAX + 1u;
+#endif
+	for (unsigned poison = 0; poison <= UINT8_MAX; ++poison) {
+		for (unsigned size = 0; size < limit; ++size) {
+			for (unsigned v = 0;
+			     v < sizeof(values) / sizeof(values[0]); ++v) {
+				MCInst sequential, pair;
+				memset(&sequential, poison, sizeof(sequential));
+				sequential.size = size;
+				memcpy(&pair, &sequential, sizeof(pair));
+				MCOperand_CreateImm0(&sequential,
+						     values[v].imm);
+				MCOperand_CreateReg0(&sequential,
+						     values[v].reg);
+				MCOperand_CreateImmReg0(&pair, values[v].imm,
+							values[v].reg);
+				if (memcmp(&sequential, &pair, sizeof(pair)) !=
+				    0) {
+					fprintf(stderr,
+						"Operand pair differs: size=%u poison=%u value=%u\n",
+						size, poison, v);
+					return false;
+				}
+			}
+		}
+	}
+	return true;
+}
