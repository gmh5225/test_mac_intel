diff --git a/arch/X86/X86EvexTransferScan.c b/arch/X86/X86EvexTransferScan.c
new file mode 100644
index 00000000..791a9145
--- /dev/null
+++ b/arch/X86/X86EvexTransferScan.c
@@ -0,0 +1,61 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "X86FeatureExtension.h"
+#ifdef X86_EVEX_REGISTER_SCAN
+#include "X86GenEvexTransferScan.inc"
+
+/* The register-plan entry already established a complete bare EVEX header.
+ * These ordinary moves and broadcasts have no immediate or VSIB operand. */
+__attribute__((noinline, section(".cs_x86_evex_transfer_text")))
+CAPSTONE_INTERNAL x86_feature_decode_result
+X86_decodeEvexTransferScan(csh ud, const uint8_t *code, size_t code_len,
+			   MCInst *instr, uint16_t *size, uint8_t opcode)
+{
+	const cs_struct *handle = (const cs_struct *)(uintptr_t)ud;
+	if (handle->mode == CS_MODE_64 && (code[2] & 0x7c) == 0x7c &&
+	    (code[3] & 0x9f) == 8 && (code[3] & 0x60) != 0x60
+#ifdef CAPSTONE_X86_SCAN_ADAPTER
+	    && !handle->x86_scan_adapter
+#endif
+	) {
+		const unsigned map = code[1] & 15, pp = code[2] & 3;
+		unsigned kind;
+		if (map == 1 && (code[4] | 0x10) == 0x7f && pp)
+			kind = pp;
+		else if (map == 2 && code[4] == 0x1a && pp == 1 &&
+			 code[5] < 0xc0)
+			kind = 0;
+		else
+			goto fallback;
+		const unsigned id =
+			evex_transfer_scan_ids[kind][code[2] >> 7][code[3] >> 5];
+		if (!id)
+			goto fallback;
+		unsigned length = 6;
+		if (code[5] < 0xc0) {
+			const unsigned mod = code[5] >> 6;
+			unsigned base = code[5] & 7;
+			if (base == 4) {
+				if (code_len < 7)
+					goto fallback;
+				base = code[6] & 7;
+				++length;
+			}
+			length += mod == 1 ? 1 : mod == 2 || base == 5 ? 4 : 0;
+		}
+		if (code_len >= length) {
+			instr->Opcode = 0;
+			instr->OpcodePub = id;
+			instr->popcode_adjust = 0;
+			*size = (uint16_t)length;
+			return X86_FEATURE_DECODED;
+		}
+	}
+fallback:
+	return X86_decodeFeatureExtension(ud, code, code_len, instr, size,
+					  opcode);
+}
+#endif
+#endif
