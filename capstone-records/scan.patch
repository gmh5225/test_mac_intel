+/* Bare VEX2 register forms use the same canonical operand rows in both
+ * modes. The generator checks the complete 32-bit record before admitting
+ * this route. Only the address-size and synthetic REX fields differ. */
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static bool writeVex32RegisterOutput(const uint8_t *code, size_t size,
+				     cs_insn *insn, uint16_t *insn_size)
+{
+	if (size < 4 || (code[1] & 0xc0) != 0xc0 || code[3] < 0xc0)
+		return false;
+	if (!writeVexRegisterOutput(code, size, insn, insn_size, 2))
+		return false;
+	if (insn->detail) {
+		insn->detail->x86.addr_size = 4;
+		insn->detail->x86.rex = 0;
+	}
+	return true;
+}
+
 #endif
 #endif
