+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+static X86_VECTOR_REGISTER_TEXT bool
+writeVexRegisterOutput(const uint8_t *code, size_t size, cs_insn *insn,
+		       uint16_t *insn_size, unsigned prefix)
+{
+	const unsigned flags = code[prefix - 1];
+	const unsigned map = prefix == 2 ? 1 : code[1] & 31;
+	if ((flags & 3) != 1 || !map || map > 3)
+		return false;
+	const unsigned ll = (flags >> 2) & 1;
+	const unsigned w = prefix == 3 && (flags & 0x80);
+	const unsigned rxb = (~(unsigned)code[1] >> 5) & (prefix == 2 ? 4 : 7);
+	const unsigned modrm = code[prefix + 1];
+	const unsigned opcode = code[prefix];
+	if (map == 1 && opcode >= 0x71 && opcode <= 0x73) {
+		unsigned index = vex_shift_plans[opcode - 0x71]
+						[(modrm >> 3) & 7][w * 2 + ll];
+		if (!index || size < prefix + 3)
+			return false;
+		const unsigned regs[] = { (~flags >> 3) & 15,
+					  (modrm & 7) | ((rxb & 1) << 3) };
+		return writeVectorRegisters(
+			code, insn, insn_size, &vex_shift_rows[index], prefix,
+			ll, X86_VECTOR_REGISTER_REX(0x40 | (w << 3) | rxb), ll,
+			regs, 2);
+	}
+#ifdef X86_VEX_REGISTER_ONLY
+	const unsigned plan = vex32_register_plans[ll][code[prefix]];
+	const unsigned offset = plan & X86_VEX32_OFFSET_MASK;
+	if (!offset)
+		return false;
+	const struct VectorOutputRow *row =
+		(const struct VectorOutputRow
+			 *)((const char *)&X86_vexRegisterRows + offset);
+#else
+	const unsigned plan = vex_register_plans[map - 1][code[prefix]];
+	const unsigned index = vex_register_widths[plan][w * 2 + ll];
+	if (!index)
+		return false;
+	const struct VectorOutputRow *row = &vex_register_rows[index];
+#endif
+	if (size < prefix + 2 + row->immediate)
+		return false;
+#ifdef X86_VEX_REGISTER_ONLY
+	if (plan & X86_VEX32_PAIR) {
+		if ((flags & 0x78) != 0x78)
+			return false;
+		const unsigned reg = (modrm >> 3) & 7, rm = modrm & 7;
+		const bool reverse = (plan & X86_VEX32_REVERSE) != 0;
+		const unsigned pair[] = { reverse ? rm : reg,
+					  reverse ? reg : rm };
+		return writeVectorRegisters(code, insn, insn_size, row, prefix,
+					    ll, X86_VECTOR_REGISTER_REX(0), ll,
+					    pair, 2);
+	}
+#endif
+	const unsigned regs[] = { ((modrm >> 3) & 7) | ((rxb & 4) << 1),
+				  (~flags >> 3) & 15,
+				  (modrm & 7) | ((rxb & 1) << 3) };
+	return writeVectorRegisters(
+		code, insn, insn_size, row, prefix, ll,
+		X86_VECTOR_REGISTER_REX(0x40 | (w << 3) | rxb), ll, regs, 3);
+}
