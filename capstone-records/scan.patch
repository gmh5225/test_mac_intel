+static bool test_detail_operand_boundaries(void)
+{
+	cs_detail detail = { 0 };
+	cs_insn insn = { 0 };
+	MCInst mi = { 0 };
+	mi.flat_insn = &insn;
+#define CHECK_OPERAND_READERS(arch, ARCH, LIMIT) \
+	do { \
+		insn.detail = NULL; \
+		if (ARCH##_get_detail_op(&mi, INT_MAX) || \
+		    ARCH##_get_detail_op_at(&mi, INT_MIN)) \
+			return false; \
+		insn.detail = &detail; \
+		for (int count = 0; count <= UCHAR_MAX; ++count) { \
+			detail.arch.op_count = count; \
+			const int offsets[] = { INT_MIN, \
+						INT_MIN + 1, \
+						-256, \
+						-255, \
+						-count - 1, \
+						-count, \
+						1 - count, \
+						-1, \
+						0, \
+						1, \
+						LIMIT - count - 1, \
+						LIMIT - count, \
+						LIMIT - count + 1, \
+						LIMIT, \
+						255, \
+						256, \
+						INT_MAX - 255, \
+						INT_MAX - 254, \
+						INT_MAX - 1, \
+						INT_MAX }; \
+			for (unsigned i = 0; i < ARR_SIZE(offsets); ++i) { \
+				const int64_t index = \
+					(int64_t)count + offsets[i]; \
+				cs_##arch##_op *expected = \
+					index >= 0 && index < LIMIT ? \
+						&detail.arch.operands[index] : \
+						NULL; \
+				if (ARCH##_get_detail_op(&mi, offsets[i]) != \
+				    expected) \
+					return false; \
+			} \
+		} \
+		for (int index = -1; index <= LIMIT; ++index) { \
+			cs_##arch##_op *expected = \
+				index >= 0 && index < LIMIT ? \
+					&detail.arch.operands[index] : \
+					NULL; \
+			if (ARCH##_get_detail_op_at(&mi, index) != expected) \
+				return false; \
+		} \
+		if (ARCH##_get_detail_op_at(&mi, INT_MIN) || \
+		    ARCH##_get_detail_op_at(&mi, INT_MAX)) \
+			return false; \
+	} while (0)
+	CHECK_OPERAND_READERS(arm, ARM, NUM_ARM_OPS);
+	CHECK_OPERAND_READERS(ppc, PPC, NUM_PPC_OPS);
+	CHECK_OPERAND_READERS(tricore, TriCore, NUM_TRICORE_OPS);
+	CHECK_OPERAND_READERS(aarch64, AArch64, NUM_AARCH64_OPS);
+	CHECK_OPERAND_READERS(alpha, Alpha, NUM_ALPHA_OPS);
+	CHECK_OPERAND_READERS(hppa, HPPA, NUM_HPPA_OPS);
+	CHECK_OPERAND_READERS(loongarch, LoongArch, NUM_LOONGARCH_OPS);
+	CHECK_OPERAND_READERS(mips, Mips, NUM_MIPS_OPS);
+	CHECK_OPERAND_READERS(riscv, RISCV, NUM_RISCV_OPS);
+	CHECK_OPERAND_READERS(systemz, SystemZ, NUM_SYSTEMZ_OPS);
+	CHECK_OPERAND_READERS(xtensa, Xtensa, NUM_XTENSA_OPS);
+	CHECK_OPERAND_READERS(bpf, BPF, NUM_BPF_OPS);
+	CHECK_OPERAND_READERS(arc, ARC, NUM_ARC_OPS);
+	CHECK_OPERAND_READERS(sparc, Sparc, NUM_SPARC_OPS);
+#undef CHECK_OPERAND_READERS
+	return true;
+}
+
 int main(void)
 {
