diff --git a/arch/X86/X86VectorRegisterOutput.inc b/arch/X86/X86VectorRegisterOutput.inc
new file mode 100644
index 00000000..b265b7b3
--- /dev/null
+++ b/arch/X86/X86VectorRegisterOutput.inc
@@ -0,0 +1,96 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+static X86_VECTOR_REGISTER_TEXT char *
+writeVectorRegister(char *out, unsigned length_code, unsigned number)
+{
+	*out++ = "xyz"[length_code];
+	*out++ = 'm';
+	*out++ = 'm';
+#ifdef X86_VEX_REGISTER_ONLY
+	/* The C5/32 entry bounds ModR/M and vvvv register numbers to 0..7. */
+	*out++ = (char)('0' + number);
+#else
+	if (number >= 10)
+		*out++ = (char)('0' + number / 10);
+	*out++ = (char)('0' + number % 10);
+#endif
+	return out;
+}
+
+static X86_VECTOR_REGISTER_TEXT bool
+writeVectorRegisters(const uint8_t *code, cs_insn *insn, uint16_t *insn_size,
+		     const struct VectorOutputRow *row, unsigned prefix,
+		     unsigned ll, unsigned rex, unsigned first_ll,
+		     const unsigned *regs, unsigned reg_count)
+{
+	const unsigned len = prefix + 2 + row->immediate;
+	*insn_size = insn->size = (uint16_t)len;
+	insn->id = row->id;
+#ifdef X86_VEX_REGISTER_ONLY
+	/* The C5 entry has admitted four bytes and any optional immediate. */
+	memcpy(insn->bytes, code, 4);
+	if (row->immediate)
+		insn->bytes[4] = code[4];
+#else
+	memcpy(insn->bytes, code, len);
+#endif
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = writeVectorRegister(insn->op_str, first_ll, regs[0]);
+	for (unsigned n = 1; n != reg_count; ++n) {
+		memcpy(out, ", ", 2);
+		out = writeVectorRegister(out + 2, ll, regs[n]);
+	}
+	if (row->immediate) {
+		const unsigned value = code[prefix + 2];
+		memcpy(out, ", ", 2);
+		out += 2;
+		if (value <= HEX_THRESHOLD) {
+			*out = (char)('0' + value);
+		} else {
+			static const char digits[] X86_VECTOR_REGISTER_DATA =
+				"0123456789abcdef";
+			memcpy(out, "0x", 2);
+			out += 2;
+			if (value >= 16)
+				*out++ = digits[value >> 4];
+			*out = digits[value & 15];
+		}
+	}
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		memcpy(d->groups, row->groups, sizeof(row->groups));
+		d->groups_count = row->group_count;
+		cs_x86 *x = &d->x86;
+		memcpy(x->opcode, code, prefix);
+		x->addr_size = X86_VECTOR_REGISTER_ADDRESS_SIZE;
+		x->rex = (uint8_t)rex;
+		x->modrm = code[prefix + 1];
+		x->encoding.modrm_offset = (uint8_t)(prefix + 1);
+		x->op_count = (uint8_t)(reg_count + row->immediate);
+		static const x86_reg bases[] X86_VECTOR_REGISTER_DATA = {
+			X86_REG_XMM0, X86_REG_YMM0, X86_REG_ZMM0
+		};
+		for (unsigned n = 0; n != reg_count; ++n) {
+			cs_x86_op *op = &x->operands[n];
+			op->type = X86_OP_REG;
+			const unsigned width = n == 0 ? first_ll : ll;
+			op->reg = (x86_reg)(bases[width] + regs[n]);
+			op->access = (cs_ac_type)row->access[n];
+			op->size = (uint8_t)(16 << width);
+		}
+		if (row->immediate) {
+			x->operands[reg_count].type = X86_OP_IMM;
+			x->operands[reg_count].imm = code[prefix + 2];
+			x->operands[reg_count].access =
+				(cs_ac_type)row->access[reg_count];
+			x->operands[reg_count].size = 1;
+			x->encoding.imm_offset = (uint8_t)(prefix + 2);
+			x->encoding.imm_size = 1;
+		}
+	}
+	return true;
+}
diff --git a/arch/X86/X86Vex32Output.c b/arch/X86/X86Vex32Output.c
new file mode 100644
index 00000000..b8f9dd42
--- /dev/null
+++ b/arch/X86/X86Vex32Output.c
@@ -0,0 +1,170 @@
+/* Capstone Disassembly Engine */
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#ifdef CAPSTONE_HAS_X86
+#include "../../cs_priv.h"
+#if !defined(CAPSTONE_DIET) && !defined(CAPSTONE_X86_REDUCE) && \
+	defined(CAPSTONE_USE_SYS_DYN_MEM) && \
+	!defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE) && \
+	!defined(_WIN32_WCE)
+#include "X86SimpleOutput.h"
+
+#ifdef CAPSTONE_X86_VEX32_OUTPUT
+
+#if defined(__ELF__) && defined(__GNUC__)
+#define X86_VECTOR_REGISTER_TEXT __attribute__((section(".cs_x86_vex32_text")))
+#define X86_VECTOR_REGISTER_DATA \
+	__attribute__((section(".cs_x86_vex32_rodata")))
+#else
+#define X86_VECTOR_REGISTER_TEXT
+#define X86_VECTOR_REGISTER_DATA
+#endif
+#define X86_VEX_REGISTER_ONLY
+#define X86_VECTOR_REGISTER_ADDRESS_SIZE 4
+#define X86_VECTOR_REGISTER_REX(value) 0
+#include "X86GenVectorOutput.inc"
+#include "X86VectorRegisterOutput.inc"
+#include "X86VexRegisterOutput.inc"
+
+#include "X86GenVex32MemoryOutput.inc"
+
+static const struct X86SimpleRegister
+	vex32_base_registers[] X86_VECTOR_REGISTER_DATA = {
+		{ X86_REG_EAX, 3, "eax" }, { X86_REG_ECX, 3, "ecx" },
+		{ X86_REG_EDX, 3, "edx" }, { X86_REG_EBX, 3, "ebx" },
+		{ X86_REG_ESP, 3, "esp" }, { X86_REG_EBP, 3, "ebp" },
+		{ X86_REG_ESI, 3, "esi" }, { X86_REG_EDI, 3, "edi" },
+	};
+
+static inline char *writeVex32Register(char *out, unsigned ll, unsigned number)
+{
+	out[0] = ll ? 'y' : 'x';
+	out[1] = out[2] = 'm';
+	out[3] = (char)('0' + number);
+	return out + 4;
+}
+
+/* Bare VEX2, ordinary 32-bit base and a generated full-width memory record. */
+static X86_VECTOR_REGISTER_TEXT bool writeVex32Memory(const uint8_t *code,
+						      size_t size,
+						      cs_insn *insn,
+						      uint16_t *insn_size)
+{
+	const unsigned flags = code[1], modrm = code[3];
+	const unsigned mod = modrm >> 6, rm = modrm & 7;
+	if (rm == 4 || (!mod && rm == 5))
+		return false;
+	const unsigned plan = vex32_memory_plans[flags & 7][code[2]];
+	if (!plan)
+		return false;
+	const unsigned reference = vex32_memory_references[plan];
+	const unsigned offset = reference & X86_VEX32_OFFSET_MASK;
+	const unsigned form = reference >> X86_VEX32_OFFSET_BITS;
+	const struct VectorOutputRow *row =
+		(const struct VectorOutputRow
+			 *)((const char *)&X86_vexRegisterRows + offset);
+	const unsigned src = (~flags >> 3) & 7;
+	if (form && src)
+		return false;
+	const unsigned disp_size = mod == 2 ? 4 : mod, length = 4 + disp_size;
+	if (size < length)
+		return false;
+	const int32_t disp = mod == 2 ? X86_readDisp32(code + 4) :
+			     mod      ? (int8_t)code[4] :
+					0;
+	const unsigned ll = (flags >> 2) & 1, number = (modrm >> 3) & 7;
+	const bool store = form == 2;
+	const unsigned memory = form == 0 ? 2 : !store;
+	const struct X86SimpleRegister *base = &vex32_base_registers[rm];
+	insn->id = row->id;
+	*insn_size = insn->size = (uint16_t)length;
+	memcpy(insn->bytes, code, 4);
+	if (disp_size == 4)
+		memcpy(insn->bytes + 4, code + 4, 4);
+	else if (disp_size)
+		insn->bytes[4] = code[4];
+	memset(insn->mnemonic, 0, sizeof(insn->mnemonic));
+	memcpy(insn->mnemonic, row->mnemonic, sizeof(row->mnemonic));
+	memset(insn->op_str, 0, sizeof(insn->op_str));
+	char *out = insn->op_str;
+	if (!store) {
+		out = writeVex32Register(out, ll, number);
+		memcpy(out, ", ", 2);
+		out += 2;
+		if (!form) {
+			out = writeVex32Register(out, ll, src);
+			memcpy(out, ", ", 2);
+			out += 2;
+		}
+	}
+	memcpy(out, "xmmword ptr [", 13);
+	out[0] = ll ? 'y' : 'x';
+	out += 13;
+	memcpy(out, base->name, sizeof(base->name));
+	out += base->length;
+	out = X86_writeDisplacement(out, disp);
+	*out++ = ']';
+	if (store) {
+		memcpy(out, ", ", 2);
+		writeVex32Register(out + 2, ll, number);
+	}
+	if (insn->detail) {
+		cs_detail *d = insn->detail;
+		memset(d, 0, offsetof(cs_detail, x86) + sizeof(cs_x86));
+		memcpy(d->groups, row->groups, sizeof(row->groups));
+		d->groups_count = row->group_count;
+		cs_x86 *x = &d->x86;
+		x->opcode[0] = 0xc5;
+		x->opcode[1] = (uint8_t)flags;
+		x->addr_size = 4;
+		x->modrm = (uint8_t)modrm;
+		x->encoding.modrm_offset = 3;
+		x->disp = disp;
+		if (disp_size) {
+			x->encoding.disp_offset = 4;
+			x->encoding.disp_size = (uint8_t)disp_size;
+		}
+		x->op_count = (uint8_t)(2 + !form);
+		for (unsigned i = 0; i < x->op_count; ++i) {
+			cs_x86_op *op = &x->operands[i];
+			op->size = (uint8_t)(16u << ll);
+			op->access = (cs_ac_type)row->access[i];
