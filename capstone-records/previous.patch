--- a/arch/X86/X86FeatureExtension.h
+++ b/arch/X86/X86FeatureExtension.h
@@ -253,6 +253,8 @@ static inline x86_vex_feature_family X86_vexFeatureFamily(uint8_t map,
 	}
 }
 
+CAPSTONE_INTERNAL extern const uint8_t X86_evexFeatureMaps[256];
+
 /* Classify prefixes and escapes in one lookup. In 16/32-bit modes the
  * 40..4f opcodes end the scan; subsequent instructions cannot be extensions
  * of the current INC/DEC. opcode receives the first non-prefix byte, or zero
@@ -284,6 +286,14 @@ static inline bool X86_mayDecodeFeatureExtensionImpl(const uint8_t *code,
 							   code_len - offset);
 		if (flags != FEATURE_ESCAPE)
 			return false;
+		/* Only an unprefixed, complete header can bypass the ordered
+		 * extension validators before their duplicate-prefix checks. */
+		if (byte == 0x62 && is_64_bit && offset == 1 && code_len >= 6) {
+			const unsigned map = code[1] & 7;
+			if (map >= 1 && map <= 3)
+				return (X86_evexFeatureMaps[code[4]] &
+					(1u << map)) != 0;
+		}
 		/* VEX map 1 is entirely handled by the generated decoder. */
 		return byte != 0xc4 || offset == code_len ||
 		       (code[offset] & 0x1f) != 1;
