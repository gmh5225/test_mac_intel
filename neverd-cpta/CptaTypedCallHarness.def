#include "CptaAuthenticatedCallProbe.def"

@DECLARATIONS@
static const struct {
  ProbeFunction Projected, Original;
  uint64_t Target;
  unsigned Key, Zero, Raw;
  uint64_t Expected;
} Cases[] = {
@CASES@
};

static uint64_t expectedCall(unsigned C) { return Cases[C].Expected; }

