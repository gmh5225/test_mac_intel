#include "CptaAuthenticatedCallProbe.def"

@DECLARATIONS@
static const struct {
  ProbeFunction Projected, Original;
  uint64_t Target;
  unsigned Key, Zero, Raw;
  unsigned __int128 Expected;
} Cases[] = {
@CASES@
};

static unsigned __int128 expectedCall(unsigned C) { return Cases[C].Expected; }

