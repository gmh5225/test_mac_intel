//===- CptaResultStorageCallOriginal.def - Independent x8 calls -*- C -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//

.text
.p2align 2
.global storage_target
storage_target:
  // A read after the aliased result write distinguishes the original buffer
  // from a compiler-created result temporary. The third word observes x8.
  ldr x9, [x0, #8]
  mov x10, #11
  str x10, [x8]
  ldr x10, [x0]
  add x9, x9, x10
  str x9, [x8, #8]
  str x8, [x8, #16]
  mov x8, #0
  adrp x9, Called
  add x9, x9, :lo12:Called
  ldr x10, [x9]
  add x10, x10, #1
  str x10, [x9]
  ret

@ORIGINALS@
