  "harness_template": "CptaTypedCallHarness.def",
  "original_template": "CptaTypedCallOriginal.def",
  "templates": {
    "argument": "uint64_t",
    "argument_value": "{value}ULL",
    "declaration": "extern uint64_t {name}({parameters});\nstatic unsigned __int128 {name}_outer(uint64_t Unused) {{\n  (void)Unused;\n  return {name}(Pointer, Modifier, {values});\n}}\n",
    "callback_declaration": "extern void {name}(void);\n",
    "case": "  {{{projected}_outer, {original}_outer, (uint64_t){callback}, {key}, {zero}, {raw}, {expected}ULL}},\n",
    "symbol": ".global {name}\n.type {name},%function\n{name}:\n",
    "frame_open": "  sub sp,sp,#{frame}\n  stp x29,x30,[sp,#{saved}]\n  mov x16,x0\n  mov x17,x1\n",
    "stage_register": "  str x{reg},[sp,#{offset}]\n",
    "stage_stack": "  ldr x9,[sp,#{incoming}]\n  str x9,[sp,#{offset}]\n",
    "load_gp": "  ldr {gp}{reg},[sp,#{offset}]\n",
    "load_fp": "  ldr {fp}{reg},[sp,#{offset}]\n",
    "load_stack": "  ldr {gp}9,[sp,#{stage}]\n  str{memory} {gp}9,[sp,#{offset}]\n",
    "calls": [
      "  blraa x16,x17\n",
      "  blrab x16,x17\n"
    ],
    "zero_calls": [
      "  blraaz x16\n",
