  "callback": "typed_target_{shape_index}",
  "original": "original_{index}",
  "text_file": "projected-{index}.bin",
  "assembly_file": "projected-{index}.S",
  "fixtures": [
    {
      "file": "typed-harness.c",
      "language": "c",
      "generated": true
    },
    {
      "file": "typed-original.S",
      "language": "assembler-with-cpp",
      "generated": true
    }
  ],
  "harness_template": "CptaTypedCallHarness.def",
  "original_template": "CptaTypedCallOriginal.def",
  "templates": {
    "argument": "uint64_t",
    "argument_value": "{value}ULL",
    "declaration": "extern uint64_t {name}({parameters});\nstatic unsigned __int128 {name}_outer(uint64_t Unused) {{\n  (void)Unused;\n  return {name}(Pointer, Modifier, {values});\n}}\n",
    "callback_declaration": "extern void {name}(void);\n",
    "case": "  {{{projected}_outer, {original}_outer, (uint64_t){callback}, {key}, {zero}, {raw}, {expected}ULL}},\n",
    "symbol": ".global {name}\n.type {name},%function\n{name}:\n",
    "frame_open": "  sub sp,sp,#{frame}\n  stp x29,x30,[sp,#{saved}]\n  mov x16,x0\n  mov x17,x1\n",
    "stage_register": "  str x{reg},[sp,#{offset}]\n",
    "stage_stack": "  ldr x9,[sp,#{incoming}]\n  str x9,[sp,#{offset}]\n",
    "load_gp": "  ldr {gp}{reg},[sp,#{offset}]\n",
    "load_fp": "  ldr {fp}{reg},[sp,#{offset}]\n",
    "load_stack": "  ldr {gp}9,[sp,#{stage}]\n  str {gp}9,[sp,#{offset}]\n",
    "calls": [
      "  blraa x16,x17\n",
      "  blrab x16,x17\n"
    ],
    "zero_calls": [
      "  blraaz x16\n",
      "  blrabz x16\n"
    ],
    "raw_call": "  blr x16\n",
    "frame_close": "  fmov {gp}0,{fp}0\n  ldp x29,x30,[sp,#{saved}]\n  add sp,sp,#{frame}\n  ret\n",
    "callback_start": "  adrp x14,Called\n  add x14,x14,:lo12:Called\n  ldr x15,[x14]\n  add x15,x15,#1\n  str x15,[x14]\n  mov x14,sp\n  and x14,x14,#{alignment_mask}\n",
    "read_gp": "  mov {gp}10,{gp}{reg}\n",
    "read_fp": "  fmov {gp}10,{fp}{reg}\n",
    "read_stack": "  ldr {gp}10,[sp,#{offset}]\n",
    "check": "  ldr {gp}11,={value}\n  cmp {gp}10,{gp}11\n  cset x12,ne\n  orr x14,x14,x12\n",
    "callback_end": "  ldr {gp}10,={expected}\n  cmp x14,#0\n  csel {gp}10,{gp}10,{gp}zr,eq\n  fmov {fp}0,{gp}10\n  ret\n"
  },
  "input_error": "The complete typed-call test and its single artifact export must complete",
  "sample_flag": "-DCPA_AUTHENTICATED_CALL_SAMPLE_COUNT={count}"
}
