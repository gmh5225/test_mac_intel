{
  "payload": "retained test data",
  "preserved": [
    "guest.elf",
    "evidence/report.json",
    "input/projected.o",
    "external/model"
  ],
  "iterations": 4,
  "scratch_file": "temporary.o",
  "input_file": "input.o",
  "diagnostic_file": "diagnostic.log",
  "ready": "ready",
  "child_timeout": 10,
  "child": "import sys,time\nfrom pathlib import Path\nimport run\nroot=Path(sys.argv[1])\nwith run.artifact_session(root) as scratch:\n (scratch / \"temporary.o\").write_bytes(b\"disposable\")\n (root / \"diagnostic.log\").write_bytes(b\"diagnostic\")\n print(\"ready\",flush=True)\n time.sleep(30)\n",
  "consumer": "import sys,time\nfrom pathlib import Path\nroot=Path(sys.argv[1])\n(root/\"projected.o\").write_text(\"pending consumer\")\n(root/\"ready\").write_text(\"ready\")\nend=time.monotonic()+10\nwhile not (root/\"release\").exists() and time.monotonic()<end: time.sleep(0.01)\n",
  "consumer_ready": "ready",
  "consumer_release": "release",
  "consumer_wait_seconds": 10,
  "producer": "import sys\nfrom pathlib import Path\nimport run\nroot=Path(sys.argv[1])\nwith run.artifact_session(root) as scratch:\n run.execute([sys.executable,\"-c\",sys.argv[2],str(scratch)],root,\"consumer\",10)\n"
}
