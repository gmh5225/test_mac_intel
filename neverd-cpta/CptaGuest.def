//===- CptaGuest.def - CPA2 guest definitions --------------------*- C -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Architectural encodings and fields follow Arm A-profile 2025-09 and
// Linux arch/arm64/tools/sysreg. No model feature register is overridden.
//===----------------------------------------------------------------------===//

#define CPA_GUEST_BASE 0x80000000
#define CPA_GUEST_STACK_BYTES 0x10000
#define CPA_GUEST_VECTOR_ALIGNMENT 11
#define CPA_GUEST_VECTOR_SLOT_BYTES 128
#define CPA_GUEST_VECTOR_COUNT 16
#define CPA_EL1 4
#define CPA_EL_FIELD_MASK 15
#define CPA_EL2_SHIFT 8
#define CPA_EL3_SHIFT 12
#define CPA_FEATURE_LEVEL 2
#define CPA_CPTA (1UL << 9)
#define CPA_CPTA0 (1UL << 10)
#define CPA_SA (1UL << 3)
#define CPA_FP_ENABLE (3UL << 20)
#define CPA_SP_ALIGNMENT 16
#define CPA_SP_ALIGNMENT_EC 0x26
#define CPA_ESR_EC_SHIFT 26
#define CPA_MEMORY_BYTES 32
#define CPA_SEMIHOST_WRITE0 4
#define CPA_SEMIHOST_EXIT_EXTENDED 0x20
#define CPA_SEMIHOST_APPLICATION_EXIT 0x20026
#define CPA_SEMIHOST_TRAP "hlt #0xf000"
#define CPA_OPERATION_REGISTER "x0"
#define CPA_PARAMETER_REGISTER "x1"
#define CPA_REGISTER_INPUT "r"
#define CPA_REGISTER_OUTPUT "=r"
#define CPA_REGISTER_INOUT "+r"
#define CPA_MEMORY_CLOBBER "memory"
#define CPA_WAIT "wfi"
#define CPA_SEMIHOST_IMMEDIATE 0xf000
#define CPA_INSTRUCTION_BYTES 4
#define CPA_MACHINE_WORD_BYTES 8
#define CPA_UNEXPECTED_TEXT "CPA2_UNEXPECTED_EXCEPTION\n"
#define CPA_ROW_PREFIX "{\"name\":\""
#define CPA_ROW_VALUE "\",\"value\":\"0x"
#define CPA_ROW_END "\"}\n"
#define CPA_HEX_DIGITS "0123456789abcdef"
#define CPA_EL_NAME "current-el"
#define CPA_PFR_NAME "id-aa64pfr0-el1"
#define CPA_ISAR_NAME "id-aa64isar3-el1"
#define CPA_SCTLR_OFF_NAME "sctlr2-el1-off"
#define CPA_SCTLR_ON_NAME "sctlr2-el1-on"
#define CPA_TESTS_NAME "passed-cases"
#define CPA_FAILURES_NAME "failed-cases"
#define CPA_FAILURE_INDEX_NAME "failed-case-index"
#define CPA_COMPLETE_NAME "guest-complete"
#define CPA_READ_EL "mrs %0, CurrentEL"
#define CPA_READ_PFR "mrs %0, ID_AA64PFR0_EL1"
#define CPA_READ_ISAR3 "mrs %0, S3_0_C0_C6_3"
#define CPA_READ_SCTLR2 "mrs %0, S3_0_C1_C0_3"
#define CPA_WRITE_SCTLR2 "msr S3_0_C1_C0_3, %0\n\tisb"
#define CPA_READ_SCTLR "mrs %0, SCTLR_EL1"
#define CPA_WRITE_SCTLR "msr SCTLR_EL1, %0\n\tisb"
#define CPA_WRITE_CPACR "msr CPACR_EL1, %0\n\tisb"
// llvm-mc 22.1.6 independently encodes: addpt x0, x1, x2.
#define CPA_ADDPT ".inst 0x9a022020"
#define CPA_RESULT_REGISTER "x0"
#define CPA_BASE_REGISTER "x1"
#define CPA_OFFSET_REGISTER "x2"
#define CPA_LOAD_GPR "ldr %0, [%1, %2]"
#define CPA_MEMORY_PATTERN 0xa5

// Four-KiB stage-1 pages cover the guest's first two MiB. EL0-writable
// pages cannot execute at EL1, so code and data use separate descriptors.
#define CPA_PAGE_BYTES 4096
#define CPA_TABLE_ENTRIES 512
#define CPA_ROOT_INDEX 2
#define CPA_L2_INDEX 0
#define CPA_TABLE_DESCRIPTOR 3
#define CPA_CODE_PAGE 0x40000000000703ULL
#define CPA_SHARED_CODE_PAGE 0x7c3ULL
#define CPA_DATA_PAGE 0x60000000000743ULL
#define CPA_GUEST_MAP_BYTES 0x200000
#define CPA_NORMAL_MAIR 0xff
#define CPA_NORMAL_TCR 0x80a03520
#define CPA_MEMORY_SCTLR_SET 0x1005
#define CPA_MEMORY_SCTLR_CLEAR 0x80002ULL
#define CPA_MEMORY_SCTLR_MASK (CPA_MEMORY_SCTLR_SET | CPA_MEMORY_SCTLR_CLEAR)
#define CPA_MAP_LIMIT_MESSAGE "CPA guest exceeds mapped Normal memory"
#define CPA_READ_MAIR "mrs %0, MAIR_EL1"
#define CPA_READ_TCR "mrs %0, TCR_EL1"
#define CPA_READ_TTBR "mrs %0, TTBR0_EL1"
#define CPA_READ_PAN "mrs %0, S3_0_C4_C2_3"
#define CPA_READ_UAO "mrs %0, S3_0_C4_C2_4"
#define CPA_CONFIGURE_TRANSLATION                                              \
  "dsb sy\n\tmsr MAIR_EL1, %0\n\tmsr TCR_EL1, %1\n\t"                          \
  "msr TTBR0_EL1, %2\n\tisb\n\ttlbi vmalle1\n\tdsb sy\n\tisb"
#define CPA_NORMAL_MAIR_NAME "normal-mair"
#define CPA_NORMAL_TCR_NAME "normal-tcr"
#define CPA_NORMAL_TTBR_NAME "normal-ttbr-matches"
#define CPA_NORMAL_SCTLR_NAME "normal-sctlr-masked"
#define CPA_NORMAL_PAN_NAME "normal-pan"
#define CPA_NORMAL_UAO_NAME "normal-uao"
#define CPA_UNEXPECTED_ESR_NAME "unexpected-esr"
#define CPA_UNEXPECTED_ELR_NAME "unexpected-elr"
#define CPA_UNEXPECTED_FAR_NAME "unexpected-far"
#define CPA_UNEXPECTED_SP_NAME "unexpected-sp"
#define CPA_GENERATED_ENTRY neverdMemoryMain
#define CPA_GENERATED_SAMPLES neverdMemorySampleCount
#define CPA_GENERATED_SAMPLES_NAME "neverd-memory-samples"
// The controlled EL0 profile shares read-only code with EL1. Returning from
// EL0 requires this exact SVC site and the hardware-saved EL0t mode.
#define CPA_SPSR_EL0T_MASKED 0x3c0
#define CPA_SPSR_EL1H_MASKED 0x3c5
#define CPA_SPSR_MODE_MASK 0x1f
#define CPA_SVC64_EC 0x15
#define CPA_SVC_IMMEDIATE 0
#define CPA_SVC_ISS_MASK 0xffff
#define CPA_EL0_ORIGIN 0
#define CPA_EL0_CONTROL_COUNT_MESSAGE "EL0 origins must cover every CPTA mode"
#define CPA_MEMORY_EL0_OFF_NAME "neverd-memory-off-el0-origin"
#define CPA_MEMORY_EL0_ON_NAME "neverd-memory-on-el0-origin"
#define CPA_MEMORY_EL0_CPTA0_NAME "neverd-memory-cpta0-only-el0-origin"
#define CPA_MEMORY_EL0_BOTH_NAME "neverd-memory-both-el0-origin"
#if defined(CPA_GENERATED_PAIR_MEMORY)
#define CPA_GENERATED_SAMPLE_COUNT 215
#elif defined(CPA_GENERATED_VECTOR_WRITEBACK_MEMORY)
#define CPA_GENERATED_SAMPLE_COUNT 100
#elif defined(CPA_GENERATED_WRITEBACK_MEMORY)
#define CPA_GENERATED_SAMPLE_COUNT 130
#elif defined(CPA_GENERATED_REGISTER_MEMORY)
#define CPA_GENERATED_SAMPLE_COUNT 184
#else
#define CPA_GENERATED_SAMPLE_COUNT 177
#endif

#ifdef CPA_EL0_ORIGIN_CASE
CPA_EL0_ORIGIN_CASE(CPA_MEMORY_EL0_OFF_NAME)
CPA_EL0_ORIGIN_CASE(CPA_MEMORY_EL0_ON_NAME)
CPA_EL0_ORIGIN_CASE(CPA_MEMORY_EL0_CPTA0_NAME)
CPA_EL0_ORIGIN_CASE(CPA_MEMORY_EL0_BOTH_NAME)
#undef CPA_EL0_ORIGIN_CASE
#endif

#ifdef CPA_CONTROL_CASE
CPA_CONTROL_CASE(0, "sctlr2-el1-off", "neverd-memory-off",
                 "neverd-memory-off-sa")
CPA_CONTROL_CASE(CPA_CPTA, "sctlr2-el1-on", "neverd-memory-on",
                 "neverd-memory-on-sa")
CPA_CONTROL_CASE(CPA_CPTA0, "sctlr2-el1-cpta0-only", "neverd-memory-cpta0-only",
                 "neverd-memory-cpta0-only-sa")
CPA_CONTROL_CASE(CPA_CPTA | CPA_CPTA0, "sctlr2-el1-both", "neverd-memory-both",
                 "neverd-memory-both-sa")
#undef CPA_CONTROL_CASE
#endif

// Base, offset, unchecked result, checked result. These are concrete oracle
// inputs, not an implementation of PointerCheckAtEL in the guest.
#ifdef CPA_ARITHMETIC_CASE
CPA_ARITHMETIC_CASE(0x1200000000000100ULL, 8, 0x1200000000000108ULL,
                    0x1200000000000108ULL)
CPA_ARITHMETIC_CASE(0x00ffffffffffffffULL, 1, 0x0100000000000000ULL,
                    0x0080000000000000ULL)
CPA_ARITHMETIC_CASE(0x1200000000000000ULL, -1, 0x11ffffffffffffffULL,
                    0x127fffffffffffffULL)
CPA_ARITHMETIC_CASE(0x1240000000000000ULL, -0x0040000000000000LL,
                    0x1200000000000000ULL, 0x1240000000000000ULL)
#undef CPA_ARITHMETIC_CASE
#endif
