#include "CptaFaultProbe.def"
#include <stdint.h>
struct Observation {
  uint64_t Low, High, Completed, ESR, SP, Origin, Word, Faulted;
};
_Static_assert(sizeof(struct Observation) == CPA_FAULT_OBSERVATION_BYTES,
               "Authenticated call probe layout changed");
typedef unsigned __int128 (*ProbeFunction)(uint64_t);
extern void probeGeneratedPAuth(ProbeFunction, uint64_t, struct Observation *);
static volatile uint64_t Called;
static uint64_t Pointer, Modifier;
static const uint64_t Arguments[10] = {0x8123456789abcdefULL,
                                       0xfeedbabe12345678ULL,
                                       0x7fffffffffffffffULL,
                                       0x1000000000000001ULL,
                                       0xfedcba9876543210ULL,
                                       0,
                                       1,
                                       0xffffffffffffffffULL,
                                       0x0011223344556677ULL,
                                       0xdeadbeefcafef00dULL};
__attribute__((noinline)) static uint64_t target1(uint64_t A) {
  ++Called;
  return A * 3 + 7;
}
__attribute__((noinline)) static uint64_t
target10(uint64_t A, uint64_t B, uint64_t C, uint64_t D, uint64_t E, uint64_t F,
         uint64_t G, uint64_t H, uint64_t I, uint64_t J) {
  ++Called;
  return A + 3 * B + 5 * C + 7 * D + 11 * E + 13 * F + 17 * G + 19 * H +
         23 * I + 29 * J;
}
static uint64_t signPointer(uint64_t Value, uint64_t Modifier, unsigned B) {
  if (B)
    __asm__ volatile("pacib %0,%1" : "+r"(Value) : "r"(Modifier));
  else
    __asm__ volatile("pacia %0,%1" : "+r"(Value) : "r"(Modifier));
  return Value;
}
